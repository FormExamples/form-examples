#!/bin/sh
set -euf

form_kebab_case=medical-information-form-for-air-travel
form_snake_case=medical_information_form_for_air_travel

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:text! \
    birth_date:date \
    sex_at_birth:string! \
    nationality_as_iso_3166_1_alpha_2:string \
    passport_number:text! \
    united_kingdom_nhs_number:string^ \
    national_health_id:text! \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text! \
    emergency_contact_name:text! \
    emergency_contact_relationship:text! \
    emergency_contact_phone:text! \
    weight_as_kg:double \
    height_as_cm:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    specialty:text! \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    clinic_name:text! \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text! \
    --api

cargo loco generate scaffold medical_information_form_for_air_travel \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    submitter_name:text! \
    submitter_role:string! \
    submitter_email:text! \
    submitter_phone:text! \
    submitter_organisation:text! \
    airline_booking_reference:string! \
    airline_iata_code:string! \
    airline_name:text! \
    outbound_flight_number:string! \
    outbound_date:date \
    outbound_origin_iata:string! \
    outbound_destination_iata:string! \
    return_flight_number:string! \
    return_date:date \
    cabin_class:string! \
    sector_duration_minutes:int \
    transit_airports_iata:text! \
    special_assistance_codes:text! \
    reason_equipment:string! \
    reason_recent_acute_event:string! \
    reason_unstable_condition:string! \
    reason_communicable_disease:string! \
    reason_pregnancy:string! \
    reason_mobility_escort:string! \
    reason_psychiatric:string! \
    primary_diagnosis:text! \
    icd10_codes:text! \
    diagnosis_date:date \
    current_treatment:text! \
    last_admission_date:date \
    last_discharge_date:date \
    last_specialist_review_date:date \
    resting_systolic_bp:int \
    resting_diastolic_bp:int \
    resting_heart_rate:int \
    nyha_class:string! \
    recent_mi_date:date \
    recent_stent_date:date \
    on_anticoagulant:string! \
    pacemaker_or_icd:string! \
    exercise_tolerance_metres:int \
    unstable_angina:string! \
    resting_spo2_percent:double \
    predicted_inflight_spo2_percent:double \
    hypoxic_challenge_result:string! \
    recent_pneumothorax_date:date \
