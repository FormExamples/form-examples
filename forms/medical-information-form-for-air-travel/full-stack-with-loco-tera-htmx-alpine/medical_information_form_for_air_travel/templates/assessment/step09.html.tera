<section class="card" id="step-09">
  <h2 class="text-xl font-semibold mb-2">Step 9 — Recent events and surgery</h2>
  <p class="text-sm text-slate-600 mb-4">
    Recent surgery, trapped-gas risk for cabin pressure, plaster cast, DVT,
    scuba diving and stroke.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="last_surgery_date" class="field-label">Last surgery date</label>
      <input type="date" id="last_surgery_date" name="last_surgery_date" class="field-input">
    </div>
    <div>
      <label for="last_surgery_site" class="field-label">Last surgery site</label>
      <input type="text" id="last_surgery_site" name="last_surgery_site" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="cabin_gas_risk" class="field-label">Trapped-gas risk for cabin pressure</label>
      <select id="cabin_gas_risk" name="cabin_gas_risk" class="field-input">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="intra-ocular-gas">Intra-ocular gas</option>
        <option value="intra-cranial-gas">Intra-cranial gas</option>
        <option value="intra-abdominal-gas">Intra-abdominal gas</option>
        <option value="plaster-cast">Plaster cast</option>
        <option value="pneumothorax">Pneumothorax</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div>
      <label for="recent_fracture_cast" class="field-label">Recent fracture with cast?</label>
      <select id="recent_fracture_cast" name="recent_fracture_cast" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="recent_dvt_date" class="field-label">Recent DVT date</label>
      <input type="date" id="recent_dvt_date" name="recent_dvt_date" class="field-input">
    </div>
    <div>
      <label for="scuba_diving_within_24h" class="field-label">Scuba diving within 24 h?</label>
      <select id="scuba_diving_within_24h" name="scuba_diving_within_24h" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="recent_stroke_date" class="field-label">Recent stroke date</label>
      <input type="date" id="recent_stroke_date" name="recent_stroke_date" class="field-input">
    </div>
  </div>
</section>
