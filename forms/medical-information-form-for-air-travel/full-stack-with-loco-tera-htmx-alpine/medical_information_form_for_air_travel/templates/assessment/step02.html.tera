<section class="card" id="step-02">
  <h2 class="text-xl font-semibold mb-2">Step 2 — Passenger identity</h2>
  <p class="text-sm text-slate-600 mb-4">
    Passenger demographic and identity information as on the travel document.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="patient_name" class="field-label">Full legal name</label>
      <input type="text" id="patient_name" name="patient[name]" class="field-input">
    </div>
    <div>
      <label for="patient_birth_date" class="field-label">Date of birth</label>
      <input type="date" id="patient_birth_date" name="patient[birth_date]" class="field-input">
    </div>
    <div>
      <label for="patient_sex_at_birth" class="field-label">Sex at birth</label>
      <select id="patient_sex_at_birth" name="patient[sex_at_birth]" class="field-input">
        <option value="">—</option>
        <option value="female">Female</option>
        <option value="male">Male</option>
        <option value="intersex">Intersex</option>
        <option value="unknown">Unknown</option>
      </select>
    </div>
    <div>
      <label for="patient_passport_number" class="field-label">Passport number</label>
      <input type="text" id="patient_passport_number" name="patient[passport_number]" class="field-input">
    </div>
    <div>
      <label for="patient_nationality" class="field-label">Nationality (ISO 3166-1 alpha-2)</label>
      <input type="text" id="patient_nationality" name="patient[nationality_as_iso_3166_1_alpha_2]" maxlength="2" class="field-input">
    </div>
    <div>
      <label for="patient_nhs" class="field-label">UK NHS number (if applicable)</label>
      <input type="text" id="patient_nhs" name="patient[united_kingdom_nhs_number]" maxlength="12" class="field-input">
    </div>
    <div>
      <label for="patient_email" class="field-label">Email</label>
      <input type="email" id="patient_email" name="patient[email]" class="field-input">
    </div>
    <div>
      <label for="patient_phone" class="field-label">Phone</label>
      <input type="tel" id="patient_phone" name="patient[phone]" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="patient_address" class="field-label">Postal address</label>
      <textarea id="patient_address" name="patient[postal_address_as_full_text]" class="field-input" rows="2"></textarea>
    </div>
    <div>
      <label for="patient_country" class="field-label">Country of residence</label>
      <input type="text" id="patient_country" name="patient[country_as_iso_3166_1_alpha_2]" maxlength="2" class="field-input">
    </div>
    <div>
      <label for="patient_postcode" class="field-label">Postcode</label>
      <input type="text" id="patient_postcode" name="patient[postcode]" class="field-input">
    </div>
    <div>
      <label for="patient_weight" class="field-label">Weight (kg)</label>
      <input type="number" step="0.1" id="patient_weight" name="patient[weight_as_kg]" class="field-input">
    </div>
    <div>
      <label for="patient_height" class="field-label">Height (cm)</label>
      <input type="number" step="0.1" id="patient_height" name="patient[height_as_cm]" class="field-input">
    </div>
  </div>
</section>
