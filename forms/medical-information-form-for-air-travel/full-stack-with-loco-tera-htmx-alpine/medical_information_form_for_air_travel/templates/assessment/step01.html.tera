<section class="card" id="step-01">
  <h2 class="text-xl font-semibold mb-2">Step 1 — Submitting agent</h2>
  <p class="text-sm text-slate-600 mb-4">
    Who is submitting Part 1 of this MEDIF: the passenger, an accessible-travel
    agent, the attending clinician, or a family member.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="submitter_name" class="field-label">Submitter name</label>
      <input type="text" id="submitter_name" name="submitter_name" class="field-input">
    </div>
    <div>
      <label for="submitter_role" class="field-label">Submitter role</label>
      <select id="submitter_role" name="submitter_role" class="field-input">
        <option value="">—</option>
        <option value="passenger">Passenger</option>
        <option value="agent">Accessible-travel agent</option>
        <option value="clinician">Clinician</option>
        <option value="family-member">Family member</option>
      </select>
    </div>
    <div>
      <label for="submitter_email" class="field-label">Submitter email</label>
      <input type="email" id="submitter_email" name="submitter_email" class="field-input">
    </div>
    <div>
      <label for="submitter_phone" class="field-label">Submitter phone</label>
      <input type="tel" id="submitter_phone" name="submitter_phone" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="submitter_organisation" class="field-label">Submitter organisation</label>
      <input type="text" id="submitter_organisation" name="submitter_organisation" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="airline_booking_reference" class="field-label">Airline booking reference (PNR)</label>
      <input type="text" id="airline_booking_reference" name="airline_booking_reference" class="field-input">
    </div>
  </div>
</section>
