<section class="card" id="step-07">
  <h2 class="text-xl font-semibold mb-2">Step 7 — Cardiovascular</h2>
  <p class="text-sm text-slate-600 mb-4">
    Resting observations, NYHA class, recent MI / stent dates, anticoagulant
    status and exercise tolerance.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <label for="resting_systolic_bp" class="field-label">Resting systolic BP (mmHg)</label>
      <input type="number" id="resting_systolic_bp" name="resting_systolic_bp" class="field-input">
    </div>
    <div>
      <label for="resting_diastolic_bp" class="field-label">Resting diastolic BP (mmHg)</label>
      <input type="number" id="resting_diastolic_bp" name="resting_diastolic_bp" class="field-input">
    </div>
    <div>
      <label for="resting_heart_rate" class="field-label">Resting heart rate (bpm)</label>
      <input type="number" id="resting_heart_rate" name="resting_heart_rate" class="field-input">
    </div>
    <div>
      <label for="nyha_class" class="field-label">NYHA class</label>
      <select id="nyha_class" name="nyha_class" class="field-input">
        <option value="">—</option>
        <option value="I">I</option>
        <option value="II">II</option>
        <option value="III">III</option>
        <option value="IV">IV</option>
      </select>
    </div>
    <div>
      <label for="recent_mi_date" class="field-label">Recent MI date</label>
      <input type="date" id="recent_mi_date" name="recent_mi_date" class="field-input">
    </div>
    <div>
      <label for="recent_stent_date" class="field-label">Recent stent date</label>
      <input type="date" id="recent_stent_date" name="recent_stent_date" class="field-input">
    </div>
    <div>
      <label for="on_anticoagulant" class="field-label">On anticoagulant?</label>
      <select id="on_anticoagulant" name="on_anticoagulant" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="pacemaker_or_icd" class="field-label">Pacemaker or ICD?</label>
      <select id="pacemaker_or_icd" name="pacemaker_or_icd" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="exercise_tolerance_metres" class="field-label">Exercise tolerance (metres on flat ground)</label>
      <input type="number" id="exercise_tolerance_metres" name="exercise_tolerance_metres" class="field-input">
    </div>
    <div>
      <label for="unstable_angina" class="field-label">Current unstable angina?</label>
      <select id="unstable_angina" name="unstable_angina" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
  </div>
</section>
