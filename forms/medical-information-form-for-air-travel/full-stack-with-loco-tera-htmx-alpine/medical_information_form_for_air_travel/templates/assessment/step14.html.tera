<section class="card" id="step-14">
  <h2 class="text-xl font-semibold mb-2">Step 14 — Sign-off</h2>
  <p class="text-sm text-slate-600 mb-4">
    Physician declaration (fit / fit-with-conditions / unfit /
    unable-to-determine), signature, signature date, validity expiry and any
    additional notes for the airline medical desk.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="physician_declaration" class="field-label">Physician declaration</label>
      <select id="physician_declaration" name="physician_declaration" class="field-input">
        <option value="">—</option>
        <option value="fit">Fit to fly</option>
        <option value="fit-with-conditions">Fit with conditions</option>
        <option value="unfit">Unfit to fly</option>
        <option value="unable-to-determine">Unable to determine</option>
      </select>
    </div>
    <div>
      <label for="physician_signature_name" class="field-label">Physician name as signature</label>
      <input type="text" id="physician_signature_name" name="physician_signature_name" class="field-input">
    </div>
    <div>
      <label for="physician_signature_date" class="field-label">Signature date</label>
      <input type="date" id="physician_signature_date" name="physician_signature_date" class="field-input">
    </div>
    <div>
      <label for="valid_until_date" class="field-label">Valid until</label>
      <input type="date" id="valid_until_date" name="valid_until_date" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="additional_notes" class="field-label">Additional notes for the airline medical desk</label>
      <textarea id="additional_notes" name="additional_notes" class="field-input" rows="3"></textarea>
    </div>
  </div>
</section>
