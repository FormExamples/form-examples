<section class="card" id="step-12">
  <h2 class="text-xl font-semibold mb-2">Step 12 — In-flight requirements</h2>
  <p class="text-sm text-slate-600 mb-4">
    Oxygen, portable oxygen concentrator (POC), stretcher / incubator, IV pump,
    medical escort, accessible lavatory, wheelchair type and carer.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="requires_supplemental_oxygen" class="field-label">Supplemental oxygen required?</label>
      <select id="requires_supplemental_oxygen" name="requires_supplemental_oxygen" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="oxygen_flow_rate_lpm" class="field-label">Oxygen flow rate (L/min)</label>
      <input type="number" step="0.1" id="oxygen_flow_rate_lpm" name="oxygen_flow_rate_lpm" class="field-input">
    </div>
    <div>
      <label for="oxygen_duration" class="field-label">Oxygen duration</label>
      <select id="oxygen_duration" name="oxygen_duration" class="field-input">
        <option value="">—</option>
        <option value="continuous">Continuous</option>
        <option value="as-required">As required</option>
        <option value="on-exertion">On exertion</option>
        <option value="sleep-only">Sleep only</option>
      </select>
    </div>
    <div>
      <label for="requires_poc" class="field-label">POC required?</label>
      <select id="requires_poc" name="requires_poc" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="poc_make_model" class="field-label">POC make / model</label>
      <input type="text" id="poc_make_model" name="poc_make_model" class="field-input">
    </div>
    <div>
      <label for="poc_battery_hours" class="field-label">POC total battery (hours)</label>
      <input type="number" step="0.1" id="poc_battery_hours" name="poc_battery_hours" class="field-input">
    </div>
    <div>
      <label for="requires_stretcher" class="field-label">Stretcher required?</label>
      <select id="requires_stretcher" name="requires_stretcher" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="requires_incubator" class="field-label">Incubator required?</label>
      <select id="requires_incubator" name="requires_incubator" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="requires_iv_pump" class="field-label">IV pump required?</label>
      <select id="requires_iv_pump" name="requires_iv_pump" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="requires_medical_escort" class="field-label">Medical escort?</label>
      <select id="requires_medical_escort" name="requires_medical_escort" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="requires_extra_seat" class="field-label">Extra seat required?</label>
      <select id="requires_extra_seat" name="requires_extra_seat" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="requires_accessible_lavatory" class="field-label">Accessible lavatory?</label>
      <select id="requires_accessible_lavatory" name="requires_accessible_lavatory" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="wheelchair_type" class="field-label">Wheelchair type</label>
      <select id="wheelchair_type" name="wheelchair_type" class="field-input">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="WCHR">WCHR (ramp)</option>
        <option value="WCHS">WCHS (steps)</option>
        <option value="WCHC">WCHC (cabin)</option>
      </select>
    </div>
    <div>
      <label for="accompanying_carer" class="field-label">Non-medical carer?</label>
      <select id="accompanying_carer" name="accompanying_carer" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
  </div>
</section>
