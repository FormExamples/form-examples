<section class="card" id="step-13">
  <h2 class="text-xl font-semibold mb-2">Step 13 — Cabin medications and equipment</h2>
  <p class="text-sm text-slate-600 mb-4">
    Regular medications, controlled drugs, dangerous-goods battery
    declarations, sharps and refrigerated medication. Drives IATA DGR clearance.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="md:col-span-2">
      <label for="regular_medications" class="field-label">Regular medications</label>
      <textarea id="regular_medications" name="regular_medications" class="field-input" rows="3"></textarea>
    </div>
    <div class="md:col-span-2">
      <label for="controlled_drugs" class="field-label">Controlled drugs in cabin</label>
      <textarea id="controlled_drugs" name="controlled_drugs" class="field-input" rows="2"></textarea>
    </div>
    <div>
      <label for="dangerous_goods_battery_declaration" class="field-label">Battery DGR declaration?</label>
      <select id="dangerous_goods_battery_declaration" name="dangerous_goods_battery_declaration" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="sharps_in_cabin" class="field-label">Sharps in cabin?</label>
      <select id="sharps_in_cabin" name="sharps_in_cabin" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="refrigerated_medication" class="field-label">Refrigerated medication?</label>
      <select id="refrigerated_medication" name="refrigerated_medication" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="customs_documentation_available" class="field-label">Customs documentation available?</label>
      <select id="customs_documentation_available" name="customs_documentation_available" class="field-input">
        <option value="">—</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div>
      <label for="haemoglobin_g_per_l" class="field-label">Haemoglobin (g/L)</label>
      <input type="number" id="haemoglobin_g_per_l" name="haemoglobin_g_per_l" class="field-input">
    </div>
  </div>
</section>
