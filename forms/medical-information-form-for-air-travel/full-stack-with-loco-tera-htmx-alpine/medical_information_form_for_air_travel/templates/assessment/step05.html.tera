<section class="card" id="step-05">
  <h2 class="text-xl font-semibold mb-2">Step 5 — Attending physician</h2>
  <p class="text-sm text-slate-600 mb-4">
    Clinician completing Part 2 of the MEDIF (registration body, registration
    number and clinic).
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="clinician_name" class="field-label">Name</label>
      <input type="text" id="clinician_name" name="clinician[name]" class="field-input">
    </div>
    <div>
      <label for="clinician_role" class="field-label">Role</label>
      <select id="clinician_role" name="clinician[role]" class="field-input">
        <option value="">—</option>
        <option value="general-practitioner">General practitioner</option>
        <option value="cardiologist">Cardiologist</option>
        <option value="respirologist">Respirologist</option>
        <option value="obstetrician">Obstetrician</option>
        <option value="oncologist">Oncologist</option>
        <option value="travel-medicine-physician">Travel-medicine physician</option>
        <option value="aeromedical-physician">Aeromedical physician</option>
        <option value="discharge-coordinator">Discharge coordinator</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div>
      <label for="clinician_specialty" class="field-label">Specialty (free text)</label>
      <input type="text" id="clinician_specialty" name="clinician[specialty]" class="field-input">
    </div>
    <div>
      <label for="clinician_registration_body" class="field-label">Registration body</label>
      <select id="clinician_registration_body" name="clinician[registration_body]" class="field-input">
        <option value="">—</option>
        <option value="GMC">GMC</option>
        <option value="NMC">NMC</option>
        <option value="HCPC">HCPC</option>
        <option value="GPhC">GPhC</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div>
      <label for="clinician_registration_number" class="field-label">Registration number</label>
      <input type="text" id="clinician_registration_number" name="clinician[registration_number]" class="field-input">
    </div>
    <div>
      <label for="clinician_clinic_name" class="field-label">Clinic / hospital</label>
      <input type="text" id="clinician_clinic_name" name="clinician[clinic_name]" class="field-input">
    </div>
    <div>
      <label for="clinician_email" class="field-label">Email</label>
      <input type="email" id="clinician_email" name="clinician[email]" class="field-input">
    </div>
    <div>
      <label for="clinician_phone" class="field-label">Phone</label>
      <input type="tel" id="clinician_phone" name="clinician[phone]" class="field-input">
    </div>
  </div>
</section>
