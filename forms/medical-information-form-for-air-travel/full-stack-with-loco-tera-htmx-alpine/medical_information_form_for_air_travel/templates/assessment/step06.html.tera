<section class="card" id="step-06">
  <h2 class="text-xl font-semibold mb-2">Step 6 — Diagnosis</h2>
  <p class="text-sm text-slate-600 mb-4">
    Primary diagnosis, ICD-10 codes, key clinical dates and current treatment.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="md:col-span-2">
      <label for="primary_diagnosis" class="field-label">Primary diagnosis</label>
      <input type="text" id="primary_diagnosis" name="primary_diagnosis" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="icd10_codes" class="field-label">ICD-10 codes (comma-separated)</label>
      <input type="text" id="icd10_codes" name="icd10_codes" class="field-input">
    </div>
    <div>
      <label for="diagnosis_date" class="field-label">Diagnosis date</label>
      <input type="date" id="diagnosis_date" name="diagnosis_date" class="field-input">
    </div>
    <div>
      <label for="last_admission_date" class="field-label">Last admission date</label>
      <input type="date" id="last_admission_date" name="last_admission_date" class="field-input">
    </div>
    <div>
      <label for="last_discharge_date" class="field-label">Last discharge date</label>
      <input type="date" id="last_discharge_date" name="last_discharge_date" class="field-input">
    </div>
    <div>
      <label for="last_specialist_review_date" class="field-label">Last specialist review</label>
      <input type="date" id="last_specialist_review_date" name="last_specialist_review_date" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="current_treatment" class="field-label">Current treatment</label>
      <textarea id="current_treatment" name="current_treatment" class="field-input" rows="3"></textarea>
    </div>
  </div>
</section>
