<section class="card" id="step-03">
  <h2 class="text-xl font-semibold mb-2">Step 3 — Trip details</h2>
  <p class="text-sm text-slate-600 mb-4">
    Airline, flight numbers, dates, sector duration and any transit stops.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="airline_iata_code" class="field-label">Airline IATA code</label>
      <input type="text" id="airline_iata_code" name="airline_iata_code" maxlength="2" class="field-input">
    </div>
    <div>
      <label for="airline_name" class="field-label">Airline name</label>
      <input type="text" id="airline_name" name="airline_name" class="field-input">
    </div>
    <div>
      <label for="outbound_flight_number" class="field-label">Outbound flight number</label>
      <input type="text" id="outbound_flight_number" name="outbound_flight_number" class="field-input">
    </div>
    <div>
      <label for="outbound_date" class="field-label">Outbound date</label>
      <input type="date" id="outbound_date" name="outbound_date" class="field-input">
    </div>
    <div>
      <label for="outbound_origin_iata" class="field-label">Outbound origin (IATA)</label>
      <input type="text" id="outbound_origin_iata" name="outbound_origin_iata" maxlength="3" class="field-input">
    </div>
    <div>
      <label for="outbound_destination_iata" class="field-label">Outbound destination (IATA)</label>
      <input type="text" id="outbound_destination_iata" name="outbound_destination_iata" maxlength="3" class="field-input">
    </div>
    <div>
      <label for="return_flight_number" class="field-label">Return flight number</label>
      <input type="text" id="return_flight_number" name="return_flight_number" class="field-input">
    </div>
    <div>
      <label for="return_date" class="field-label">Return date</label>
      <input type="date" id="return_date" name="return_date" class="field-input">
    </div>
    <div>
      <label for="cabin_class" class="field-label">Cabin class</label>
      <select id="cabin_class" name="cabin_class" class="field-input">
        <option value="">—</option>
        <option value="economy">Economy</option>
        <option value="premium-economy">Premium economy</option>
        <option value="business">Business</option>
        <option value="first">First</option>
      </select>
    </div>
    <div>
      <label for="sector_duration_minutes" class="field-label">Longest sector duration (minutes)</label>
      <input type="number" id="sector_duration_minutes" name="sector_duration_minutes" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="transit_airports_iata" class="field-label">Transit airports (comma-separated IATA)</label>
      <input type="text" id="transit_airports_iata" name="transit_airports_iata" class="field-input">
    </div>
    <div class="md:col-span-2">
      <label for="special_assistance_codes" class="field-label">Special assistance codes (IATA SSR, comma-separated)</label>
      <input type="text" id="special_assistance_codes" name="special_assistance_codes" class="field-input">
    </div>
  </div>
</section>
