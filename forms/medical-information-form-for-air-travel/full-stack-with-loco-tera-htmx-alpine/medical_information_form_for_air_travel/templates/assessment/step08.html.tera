<section class="card" id="step-08">
  <h2 class="text-xl font-semibold mb-2">Step 8 — Respiratory</h2>
  <p class="text-sm text-slate-600 mb-4">
    Resting SpO₂, predicted in-flight SpO₂, hypoxic-challenge result, asthma /
    COPD severity, CPAP/BiPAP use, and recent pneumothorax / PE dates.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <label for="resting_spo2_percent" class="field-label">Resting SpO₂ on room air (%)</label>
      <input type="number" step="0.1" id="resting_spo2_percent" name="resting_spo2_percent" class="field-input">
    </div>
    <div>
      <label for="predicted_inflight_spo2_percent" class="field-label">Predicted in-flight SpO₂ (%)</label>
      <input type="number" step="0.1" id="predicted_inflight_spo2_percent" name="predicted_inflight_spo2_percent" class="field-input">
    </div>
    <div>
      <label for="hypoxic_challenge_result" class="field-label">Hypoxic challenge result</label>
      <select id="hypoxic_challenge_result" name="hypoxic_challenge_result" class="field-input">
        <option value="">—</option>
        <option value="pass">Pass</option>
        <option value="borderline">Borderline</option>
        <option value="fail">Fail</option>
        <option value="not-performed">Not performed</option>
      </select>
    </div>
    <div>
      <label for="recent_pneumothorax_date" class="field-label">Recent pneumothorax date</label>
      <input type="date" id="recent_pneumothorax_date" name="recent_pneumothorax_date" class="field-input">
    </div>
    <div>
      <label for="asthma_severity" class="field-label">Asthma severity</label>
      <select id="asthma_severity" name="asthma_severity" class="field-input">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="mild-controlled">Mild controlled</option>
        <option value="moderate">Moderate</option>
        <option value="severe-uncontrolled">Severe uncontrolled</option>
      </select>
    </div>
    <div>
      <label for="copd_severity" class="field-label">COPD severity</label>
      <select id="copd_severity" name="copd_severity" class="field-input">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="mild">Mild</option>
        <option value="moderate">Moderate</option>
        <option value="severe">Severe</option>
      </select>
    </div>
    <div>
      <label for="cpap_or_bipap_use" class="field-label">CPAP / BiPAP use</label>
      <select id="cpap_or_bipap_use" name="cpap_or_bipap_use" class="field-input">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="cpap">CPAP</option>
        <option value="bipap">BiPAP</option>
        <option value="both">Both</option>
      </select>
    </div>
    <div>
      <label for="recent_pulmonary_embolism_date" class="field-label">Recent pulmonary embolism date</label>
      <input type="date" id="recent_pulmonary_embolism_date" name="recent_pulmonary_embolism_date" class="field-input">
    </div>
  </div>
</section>
