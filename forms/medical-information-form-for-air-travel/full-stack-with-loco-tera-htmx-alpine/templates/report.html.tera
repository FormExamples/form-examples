{% extends "base.html.tera" %}

{% block title %}MEDIF Report - {{ fitness_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>MEDIF Fitness-to-Fly Report</h1>
    <div class="band-badge band-{{ fitness_band }}">{{ fitness_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}<br>
        Valid until: {{ valid_until }}
    </p>
    <p class="desk-recommendation"><strong>Airline medical desk:</strong> {{ desk_recommendation }}</p>
</div>

<!-- Passenger / Trip -->
<div class="card">
    <h2>Passenger and Trip</h2>
    <div class="form-row">
        <div>
            <strong>Passenger:</strong> {{ data.passenger.passengerName }}<br>
            <strong>Date of Birth:</strong> {{ data.passenger.passengerDateOfBirth }}<br>
            <strong>Passport:</strong> {{ data.passenger.passengerPassportNumber }}
        </div>
        <div>
            <strong>Airline:</strong> {{ data.trip.airlineIataCode }} {{ data.trip.airlineName }}<br>
            <strong>Flight:</strong> {{ data.trip.outboundFlightNumber }} on {{ data.trip.outboundDate }}<br>
            <strong>Route:</strong> {{ data.trip.outboundOriginIata }} &rarr; {{ data.trip.outboundDestinationIata }}
        </div>
    </div>
</div>

<!-- Physician -->
<div class="card">
    <h2>Attending Physician</h2>
    <p>
        <strong>{{ data.physician.physicianName }}</strong>
        ({{ data.physician.physicianSpecialty }})<br>
        Registration: {{ data.physician.physicianRegistrationNumber }}<br>
        Clinic: {{ data.physician.physicianClinic }}<br>
        Primary diagnosis: {{ data.diagnosis.primaryDiagnosis }}
    </p>
</div>

<!-- Safety Flags -->
{% if safety_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ safety_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in safety_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <code class="flag-id">{{ flag.id }}</code>
            <span class="flag-priority">{{ flag.priority }}</span>
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Band</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td><span class="band-badge band-{{ rule.band }}">{{ rule.band }}</span></td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="card">
    <h2>Fired Rules</h2>
    <p class="muted">No fitness-band rules fired. Default band: fit to fly.</p>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New MEDIF</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
