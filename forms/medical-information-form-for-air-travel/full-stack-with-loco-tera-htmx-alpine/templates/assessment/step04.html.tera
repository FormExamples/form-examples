<div class="card">
    <h2>Step 4: Reason MEDIF is Required</h2>
    <p class="form-hint">Tick all that apply. Triggers a MEDIF per IATA Medical Manual.</p>

    {% set reasons = [
        ["reason_equipment", "reasonEquipment", "In-flight medical equipment (oxygen, POC, CPAP, ventilator, incubator, stretcher, IV pump, battery device)"],
        ["reason_recent_acute_event", "reasonRecentAcuteEvent", "Recent acute event (surgery, MI, stroke, PE, pneumothorax, fracture, scuba)"],
        ["reason_unstable_condition", "reasonUnstableCondition", "Unstable or potentially decompensating condition"],
        ["reason_communicable_disease", "reasonCommunicableDisease", "Communicable disease"],
        ["reason_pregnancy", "reasonPregnancy", "Late-stage or complicated pregnancy"],
        ["reason_mobility_escort", "reasonMobilityEscort", "Mobility or escort requirements"],
        ["reason_psychiatric", "reasonPsychiatric", "Psychiatric clearance"]
    ] %}

    {% for entry in reasons %}
    {% set field = entry.0 %}
    {% set json_field = entry.1 %}
    {% set label = entry.2 %}
    <div class="form-group">
        <label for="{{ field }}">{{ label }}</label>
        <select id="{{ field }}" name="reason.{{ field }}">
            {% set v = reason[json_field] %}
            <option value="" {% if v == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    {% endfor %}
</div>
