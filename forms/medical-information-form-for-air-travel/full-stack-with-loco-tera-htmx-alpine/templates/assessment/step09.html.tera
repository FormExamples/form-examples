<div class="card">
    <h2>Step 9: Recent Events and Surgery</h2>
    <p class="form-hint">Surgical history, cabin gas-expansion risks, DVT, and scuba diving exposure.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="last_surgery_date">Last Surgery Date</label>
            <input type="date" id="last_surgery_date" name="recent_events.last_surgery_date"
                   value="{{ recent_events.lastSurgeryDate }}">
        </div>
        <div class="form-group">
            <label for="last_surgery_site">Surgical Site</label>
            <input type="text" id="last_surgery_site" name="recent_events.last_surgery_site"
                   value="{{ recent_events.lastSurgerySite }}">
        </div>
    </div>

    <div class="form-group">
        <label for="cabin_gas_risk">Cabin Gas Expansion Risk</label>
        <select id="cabin_gas_risk" name="recent_events.cabin_gas_risk">
            <option value="" {% if recent_events.cabinGasRisk == "" %}selected{% endif %}>&mdash;</option>
            <option value="none" {% if recent_events.cabinGasRisk == "none" %}selected{% endif %}>None</option>
            <option value="intra-ocular-gas" {% if recent_events.cabinGasRisk == "intra-ocular-gas" %}selected{% endif %}>Intra-ocular gas</option>
            <option value="intra-cranial-gas" {% if recent_events.cabinGasRisk == "intra-cranial-gas" %}selected{% endif %}>Intra-cranial gas</option>
            <option value="intra-abdominal-gas" {% if recent_events.cabinGasRisk == "intra-abdominal-gas" %}selected{% endif %}>Intra-abdominal gas</option>
            <option value="plaster-cast" {% if recent_events.cabinGasRisk == "plaster-cast" %}selected{% endif %}>Plaster cast</option>
            <option value="pneumothorax" {% if recent_events.cabinGasRisk == "pneumothorax" %}selected{% endif %}>Pneumothorax</option>
            <option value="other" {% if recent_events.cabinGasRisk == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recent_fracture_cast">Recent Fracture with Cast?</label>
            <select id="recent_fracture_cast" name="recent_events.recent_fracture_cast">
                <option value="" {% if recent_events.recentFractureCast == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recent_events.recentFractureCast == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recent_events.recentFractureCast == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="scuba_diving_within24h">Scuba Diving within 24h?</label>
            <select id="scuba_diving_within24h" name="recent_events.scuba_diving_within24h">
                <option value="" {% if recent_events.scubaDivingWithin24h == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recent_events.scubaDivingWithin24h == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recent_events.scubaDivingWithin24h == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recent_dvt_date">Recent DVT Date</label>
            <input type="date" id="recent_dvt_date" name="recent_events.recent_dvt_date"
                   value="{{ recent_events.recentDvtDate }}">
        </div>
        <div class="form-group">
            <label for="recent_stroke_date">Recent Stroke Date</label>
            <input type="date" id="recent_stroke_date" name="recent_events.recent_stroke_date"
                   value="{{ recent_events.recentStrokeDate }}">
        </div>
    </div>
</div>
