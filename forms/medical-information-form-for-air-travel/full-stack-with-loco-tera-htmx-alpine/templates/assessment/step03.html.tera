<div class="card">
    <h2>Step 3: Trip Details</h2>
    <p class="form-hint">Airline, route, and special-assistance codes for the planned itinerary.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="airline_iata_code">Airline IATA Code</label>
            <input type="text" id="airline_iata_code" name="trip.airline_iata_code"
                   value="{{ trip.airlineIataCode }}" maxlength="2" placeholder="EK, BA, QR...">
        </div>
        <div class="form-group">
            <label for="airline_name">Airline Name</label>
            <input type="text" id="airline_name" name="trip.airline_name"
                   value="{{ trip.airlineName }}">
        </div>
    </div>

    <h3>Outbound</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="outbound_flight_number">Outbound Flight Number</label>
            <input type="text" id="outbound_flight_number" name="trip.outbound_flight_number"
                   value="{{ trip.outboundFlightNumber }}" maxlength="10">
        </div>
        <div class="form-group">
            <label for="outbound_date">Outbound Date</label>
            <input type="date" id="outbound_date" name="trip.outbound_date"
                   value="{{ trip.outboundDate }}">
        </div>
        <div class="form-group">
            <label for="outbound_origin_iata">Origin IATA</label>
            <input type="text" id="outbound_origin_iata" name="trip.outbound_origin_iata"
                   value="{{ trip.outboundOriginIata }}" maxlength="3">
        </div>
        <div class="form-group">
            <label for="outbound_destination_iata">Destination IATA</label>
            <input type="text" id="outbound_destination_iata" name="trip.outbound_destination_iata"
                   value="{{ trip.outboundDestinationIata }}" maxlength="3">
        </div>
    </div>

    <h3>Return</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="return_flight_number">Return Flight Number</label>
            <input type="text" id="return_flight_number" name="trip.return_flight_number"
                   value="{{ trip.returnFlightNumber }}" maxlength="10">
        </div>
        <div class="form-group">
            <label for="return_date">Return Date</label>
            <input type="date" id="return_date" name="trip.return_date"
                   value="{{ trip.returnDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cabin_class">Cabin Class</label>
            <select id="cabin_class" name="trip.cabin_class">
                <option value="" {% if trip.cabinClass == "" %}selected{% endif %}>&mdash;</option>
                <option value="economy" {% if trip.cabinClass == "economy" %}selected{% endif %}>Economy</option>
                <option value="premium-economy" {% if trip.cabinClass == "premium-economy" %}selected{% endif %}>Premium economy</option>
                <option value="business" {% if trip.cabinClass == "business" %}selected{% endif %}>Business</option>
                <option value="first" {% if trip.cabinClass == "first" %}selected{% endif %}>First</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sector_duration_minutes">Longest Sector Duration (minutes)</label>
            <input type="number" min="0" id="sector_duration_minutes" name="trip.sector_duration_minutes"
                   value="{{ trip.sectorDurationMinutes }}">
        </div>
    </div>

    <div class="form-group">
        <label for="transit_airports_iata">Transit Airports (comma-separated IATA codes)</label>
        <input type="text" id="transit_airports_iata" name="trip.transit_airports_iata"
               value="{{ trip.transitAirportsIata }}" placeholder="e.g. DXB,IST">
    </div>

    <div class="form-group">
        <label for="special_assistance_codes">Special Assistance Codes (comma-separated)</label>
        <input type="text" id="special_assistance_codes" name="trip.special_assistance_codes"
               value="{{ trip.specialAssistanceCodes }}" placeholder="WCHR,OXYG,MEDA,STCR,POC">
    </div>
</div>
