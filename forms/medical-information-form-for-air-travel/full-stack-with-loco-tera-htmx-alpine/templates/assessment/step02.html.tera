<div class="card">
    <h2>Step 2: Passenger Identification</h2>
    <p class="form-hint">Passenger demographics and emergency contact.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="passenger_name">Passenger Name</label>
            <input type="text" id="passenger_name" name="passenger.passenger_name"
                   value="{{ passenger.passengerName }}">
        </div>
        <div class="form-group">
            <label for="passenger_date_of_birth">Date of Birth</label>
            <input type="date" id="passenger_date_of_birth" name="passenger.passenger_date_of_birth"
                   value="{{ passenger.passengerDateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="passenger_sex">Sex</label>
            <select id="passenger_sex" name="passenger.passenger_sex">
                <option value="" {% if passenger.passengerSex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if passenger.passengerSex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if passenger.passengerSex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if passenger.passengerSex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="passenger_nationality">Nationality</label>
            <input type="text" id="passenger_nationality" name="passenger.passenger_nationality"
                   value="{{ passenger.passengerNationality }}">
        </div>
        <div class="form-group">
            <label for="passenger_passport_number">Passport Number</label>
            <input type="text" id="passenger_passport_number" name="passenger.passenger_passport_number"
                   value="{{ passenger.passengerPassportNumber }}">
        </div>
        <div class="form-group">
            <label for="passenger_national_health_id">National Health ID (NHS / equivalent)</label>
            <input type="text" id="passenger_national_health_id" name="passenger.passenger_national_health_id"
                   value="{{ passenger.passengerNationalHealthId }}">
        </div>
    </div>

    <div class="form-group">
        <label for="passenger_address">Address</label>
        <textarea id="passenger_address" name="passenger.passenger_address">{{ passenger.passengerAddress }}</textarea>
    </div>

    <div class="form-group">
        <label for="emergency_contact">Emergency Contact</label>
        <input type="text" id="emergency_contact" name="passenger.emergency_contact"
               value="{{ passenger.emergencyContact }}" placeholder="Name, relationship, phone">
    </div>
</div>
