<div class="card">
    <h2>Step 8: Respiratory Fitness</h2>
    <p class="form-hint">SpO2 on room air, hypoxic challenge result, and pulmonary risk history.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="resting_spo2_percent">Resting SpO2 on Room Air (%)</label>
            <input type="number" step="0.1" min="0" max="100" id="resting_spo2_percent" name="respiratory.resting_spo2_percent"
                   value="{{ respiratory.restingSpo2Percent }}">
        </div>
        <div class="form-group">
            <label for="predicted_inflight_spo2_percent">Predicted In-Flight SpO2 (%)</label>
            <input type="number" step="0.1" min="0" max="100" id="predicted_inflight_spo2_percent" name="respiratory.predicted_inflight_spo2_percent"
                   value="{{ respiratory.predictedInflightSpo2Percent }}">
        </div>
        <div class="form-group">
            <label for="hypoxic_challenge_result">Hypoxic Challenge Test</label>
            <select id="hypoxic_challenge_result" name="respiratory.hypoxic_challenge_result">
                <option value="" {% if respiratory.hypoxicChallengeResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="pass" {% if respiratory.hypoxicChallengeResult == "pass" %}selected{% endif %}>Pass</option>
                <option value="borderline" {% if respiratory.hypoxicChallengeResult == "borderline" %}selected{% endif %}>Borderline</option>
                <option value="fail" {% if respiratory.hypoxicChallengeResult == "fail" %}selected{% endif %}>Fail</option>
                <option value="not-performed" {% if respiratory.hypoxicChallengeResult == "not-performed" %}selected{% endif %}>Not performed</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recent_pneumothorax_date">Recent Pneumothorax Date</label>
            <input type="date" id="recent_pneumothorax_date" name="respiratory.recent_pneumothorax_date"
                   value="{{ respiratory.recentPneumothoraxDate }}">
        </div>
        <div class="form-group">
            <label for="recent_pulmonary_embolism_date">Recent PE Date</label>
            <input type="date" id="recent_pulmonary_embolism_date" name="respiratory.recent_pulmonary_embolism_date"
                   value="{{ respiratory.recentPulmonaryEmbolismDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="asthma_severity">Asthma Severity</label>
            <select id="asthma_severity" name="respiratory.asthma_severity">
                <option value="" {% if respiratory.asthmaSeverity == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if respiratory.asthmaSeverity == "none" %}selected{% endif %}>None</option>
                <option value="mild-controlled" {% if respiratory.asthmaSeverity == "mild-controlled" %}selected{% endif %}>Mild controlled</option>
                <option value="moderate" {% if respiratory.asthmaSeverity == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe-uncontrolled" {% if respiratory.asthmaSeverity == "severe-uncontrolled" %}selected{% endif %}>Severe uncontrolled</option>
            </select>
        </div>
        <div class="form-group">
            <label for="copd_severity">COPD Severity</label>
            <select id="copd_severity" name="respiratory.copd_severity">
                <option value="" {% if respiratory.copdSeverity == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if respiratory.copdSeverity == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if respiratory.copdSeverity == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if respiratory.copdSeverity == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if respiratory.copdSeverity == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cpap_or_bipap_use">CPAP / BiPAP Use</label>
            <select id="cpap_or_bipap_use" name="respiratory.cpap_or_bipap_use">
                <option value="" {% if respiratory.cpapOrBipapUse == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if respiratory.cpapOrBipapUse == "none" %}selected{% endif %}>None</option>
                <option value="cpap" {% if respiratory.cpapOrBipapUse == "cpap" %}selected{% endif %}>CPAP</option>
                <option value="bipap" {% if respiratory.cpapOrBipapUse == "bipap" %}selected{% endif %}>BiPAP</option>
                <option value="both" {% if respiratory.cpapOrBipapUse == "both" %}selected{% endif %}>Both</option>
            </select>
        </div>
    </div>
</div>
