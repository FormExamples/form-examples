<div class="card">
    <h2>Step 14: Summary and Physician Sign-Off</h2>
    <p class="form-hint">Attending physician declaration; the airline medical desk receives this for clearance.</p>

    <div class="form-group">
        <label for="physician_declaration">Physician Declaration of Fitness</label>
        <select id="physician_declaration" name="sign_off.physician_declaration">
            <option value="" {% if sign_off.physicianDeclaration == "" %}selected{% endif %}>&mdash;</option>
            <option value="fit" {% if sign_off.physicianDeclaration == "fit" %}selected{% endif %}>Fit to fly</option>
            <option value="fit-with-conditions" {% if sign_off.physicianDeclaration == "fit-with-conditions" %}selected{% endif %}>Fit with conditions</option>
            <option value="unfit" {% if sign_off.physicianDeclaration == "unfit" %}selected{% endif %}>Unfit to fly</option>
            <option value="unable-to-determine" {% if sign_off.physicianDeclaration == "unable-to-determine" %}selected{% endif %}>Unable to determine</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="physician_signature_name">Physician Signature Name</label>
            <input type="text" id="physician_signature_name" name="sign_off.physician_signature_name"
                   value="{{ sign_off.physicianSignatureName }}">
        </div>
        <div class="form-group">
            <label for="physician_signature_date">Signature Date</label>
            <input type="date" id="physician_signature_date" name="sign_off.physician_signature_date"
                   value="{{ sign_off.physicianSignatureDate }}">
        </div>
        <div class="form-group">
            <label for="valid_until_date">Valid Until</label>
            <input type="date" id="valid_until_date" name="sign_off.valid_until_date"
                   value="{{ sign_off.validUntilDate }}" placeholder="Typically signature date + 10 to 14 days">
        </div>
    </div>

    <div class="form-group">
        <label for="additional_notes">Additional Notes for the Airline Medical Desk</label>
        <textarea id="additional_notes" name="sign_off.additional_notes">{{ sign_off.additionalNotes }}</textarea>
    </div>
</div>
