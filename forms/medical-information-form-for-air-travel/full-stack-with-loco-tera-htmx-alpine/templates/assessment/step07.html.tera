<div class="card">
    <h2>Step 7: Cardiovascular Fitness</h2>
    <p class="form-hint">Resting vitals, NYHA class, recent cardiac events, and exercise tolerance.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="resting_systolic_bp">Resting Systolic BP (mmHg)</label>
            <input type="number" min="0" id="resting_systolic_bp" name="cardiovascular.resting_systolic_bp"
                   value="{{ cardiovascular.restingSystolicBp }}">
        </div>
        <div class="form-group">
            <label for="resting_diastolic_bp">Resting Diastolic BP (mmHg)</label>
            <input type="number" min="0" id="resting_diastolic_bp" name="cardiovascular.resting_diastolic_bp"
                   value="{{ cardiovascular.restingDiastolicBp }}">
        </div>
        <div class="form-group">
            <label for="resting_heart_rate">Resting Heart Rate (bpm)</label>
            <input type="number" min="0" id="resting_heart_rate" name="cardiovascular.resting_heart_rate"
                   value="{{ cardiovascular.restingHeartRate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="nyha_class">NYHA Functional Class</label>
            <select id="nyha_class" name="cardiovascular.nyha_class">
                <option value="" {% if cardiovascular.nyhaClass == "" %}selected{% endif %}>&mdash;</option>
                <option value="I" {% if cardiovascular.nyhaClass == "I" %}selected{% endif %}>I</option>
                <option value="II" {% if cardiovascular.nyhaClass == "II" %}selected{% endif %}>II</option>
                <option value="III" {% if cardiovascular.nyhaClass == "III" %}selected{% endif %}>III</option>
                <option value="IV" {% if cardiovascular.nyhaClass == "IV" %}selected{% endif %}>IV</option>
            </select>
        </div>
        <div class="form-group">
            <label for="exercise_tolerance_metres">Exercise Tolerance (metres on flat)</label>
            <input type="number" min="0" id="exercise_tolerance_metres" name="cardiovascular.exercise_tolerance_metres"
                   value="{{ cardiovascular.exerciseToleranceMetres }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recent_mi_date">Recent MI Date</label>
            <input type="date" id="recent_mi_date" name="cardiovascular.recent_mi_date"
                   value="{{ cardiovascular.recentMiDate }}">
        </div>
        <div class="form-group">
            <label for="recent_stent_date">Recent Coronary Stent Date</label>
            <input type="date" id="recent_stent_date" name="cardiovascular.recent_stent_date"
                   value="{{ cardiovascular.recentStentDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="on_anticoagulant">On Anticoagulant?</label>
            <select id="on_anticoagulant" name="cardiovascular.on_anticoagulant">
                <option value="" {% if cardiovascular.onAnticoagulant == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular.onAnticoagulant == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular.onAnticoagulant == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pacemaker_or_icd">Pacemaker or ICD?</label>
            <select id="pacemaker_or_icd" name="cardiovascular.pacemaker_or_icd">
                <option value="" {% if cardiovascular.pacemakerOrIcd == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular.pacemakerOrIcd == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular.pacemakerOrIcd == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="unstable_angina">Unstable Angina?</label>
            <select id="unstable_angina" name="cardiovascular.unstable_angina">
                <option value="" {% if cardiovascular.unstableAngina == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular.unstableAngina == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular.unstableAngina == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
