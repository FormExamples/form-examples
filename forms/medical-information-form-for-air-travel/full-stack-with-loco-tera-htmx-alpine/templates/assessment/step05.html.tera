<div class="card">
    <h2>Step 5: Attending Physician</h2>
    <p class="form-hint">Identity and contact details for the physician signing Part 2.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="physician_name">Physician Name</label>
            <input type="text" id="physician_name" name="physician.physician_name"
                   value="{{ physician.physicianName }}">
        </div>
        <div class="form-group">
            <label for="physician_specialty">Specialty</label>
            <input type="text" id="physician_specialty" name="physician.physician_specialty"
                   value="{{ physician.physicianSpecialty }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="physician_registration_number">Registration Number (GMC / NMC / equivalent)</label>
            <input type="text" id="physician_registration_number" name="physician.physician_registration_number"
                   value="{{ physician.physicianRegistrationNumber }}">
        </div>
        <div class="form-group">
            <label for="physician_clinic">Clinic</label>
            <input type="text" id="physician_clinic" name="physician.physician_clinic"
                   value="{{ physician.physicianClinic }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="physician_email">Email</label>
            <input type="email" id="physician_email" name="physician.physician_email"
                   value="{{ physician.physicianEmail }}">
        </div>
        <div class="form-group">
            <label for="physician_phone">Phone</label>
            <input type="text" id="physician_phone" name="physician.physician_phone"
                   value="{{ physician.physicianPhone }}">
        </div>
    </div>

    <div class="form-group">
        <label for="physician_address">Clinic Address</label>
        <textarea id="physician_address" name="physician.physician_address">{{ physician.physicianAddress }}</textarea>
    </div>
</div>
