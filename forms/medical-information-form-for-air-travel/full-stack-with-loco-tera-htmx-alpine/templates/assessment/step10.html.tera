<div class="card" x-data="{ pregnant: '{{ pregnancy.isPregnant }}' }">
    <h2>Step 10: Pregnancy and Obstetric History</h2>
    <p class="form-hint">Late-stage pregnancy and complications drive airline-specific thresholds.</p>

    <div class="form-group">
        <label for="is_pregnant">Currently Pregnant?</label>
        <select id="is_pregnant" name="pregnancy.is_pregnant" x-model="pregnant">
            <option value="" {% if pregnancy.isPregnant == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if pregnancy.isPregnant == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if pregnancy.isPregnant == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div x-show="pregnant === 'yes'">
        <div class="form-row">
            <div class="form-group">
                <label for="gestation_weeks">Gestation (weeks)</label>
                <input type="number" min="0" max="45" id="gestation_weeks" name="pregnancy.gestation_weeks"
                       value="{{ pregnancy.gestationWeeks }}">
            </div>
            <div class="form-group">
                <label for="pregnancy_type">Pregnancy Type</label>
                <select id="pregnancy_type" name="pregnancy.pregnancy_type">
                    <option value="" {% if pregnancy.pregnancyType == "" %}selected{% endif %}>&mdash;</option>
                    <option value="singleton" {% if pregnancy.pregnancyType == "singleton" %}selected{% endif %}>Singleton</option>
                    <option value="twins" {% if pregnancy.pregnancyType == "twins" %}selected{% endif %}>Twins</option>
                    <option value="multiple" {% if pregnancy.pregnancyType == "multiple" %}selected{% endif %}>Multiple</option>
                </select>
            </div>
            <div class="form-group">
                <label for="expected_delivery_date">Expected Delivery Date</label>
                <input type="date" id="expected_delivery_date" name="pregnancy.expected_delivery_date"
                       value="{{ pregnancy.expectedDeliveryDate }}">
            </div>
        </div>

        <div class="form-group">
            <label for="pregnancy_complications">Complications</label>
            <textarea id="pregnancy_complications" name="pregnancy.pregnancy_complications">{{ pregnancy.pregnancyComplications }}</textarea>
        </div>

        <div class="form-group">
            <label for="obstetrician_contact">Obstetrician Contact</label>
            <input type="text" id="obstetrician_contact" name="pregnancy.obstetrician_contact"
                   value="{{ pregnancy.obstetricianContact }}" placeholder="Name and phone">
        </div>
    </div>
</div>
