<div class="card">
    <h2>Step 1: Submitting Agent</h2>
    <p class="form-hint">Person or organisation submitting Part 1 of the MEDIF on behalf of the passenger.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="submitter_name">Submitter Name</label>
            <input type="text" id="submitter_name" name="submitter.submitter_name"
                   value="{{ submitter.submitterName }}">
        </div>
        <div class="form-group">
            <label for="submitter_role">Submitter Role</label>
            <select id="submitter_role" name="submitter.submitter_role">
                <option value="" {% if submitter.submitterRole == "" %}selected{% endif %}>&mdash;</option>
                <option value="passenger" {% if submitter.submitterRole == "passenger" %}selected{% endif %}>Passenger</option>
                <option value="agent" {% if submitter.submitterRole == "agent" %}selected{% endif %}>Travel agent</option>
                <option value="clinician" {% if submitter.submitterRole == "clinician" %}selected{% endif %}>Clinician</option>
                <option value="family-member" {% if submitter.submitterRole == "family-member" %}selected{% endif %}>Family member</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="submitter_email">Email</label>
            <input type="email" id="submitter_email" name="submitter.submitter_email"
                   value="{{ submitter.submitterEmail }}">
        </div>
        <div class="form-group">
            <label for="submitter_phone">Phone</label>
            <input type="text" id="submitter_phone" name="submitter.submitter_phone"
                   value="{{ submitter.submitterPhone }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="submitter_organisation">Organisation</label>
            <input type="text" id="submitter_organisation" name="submitter.submitter_organisation"
                   value="{{ submitter.submitterOrganisation }}">
        </div>
        <div class="form-group">
            <label for="airline_booking_reference">Airline Booking Reference (PNR)</label>
            <input type="text" id="airline_booking_reference" name="submitter.airline_booking_reference"
                   value="{{ submitter.airlineBookingReference }}" maxlength="20">
        </div>
    </div>
</div>
