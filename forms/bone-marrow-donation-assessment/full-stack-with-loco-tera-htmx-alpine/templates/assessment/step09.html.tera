<div class="card">
    <h2>Step 9: Psychological Readiness</h2>
    <p class="form-hint">Voluntariness, understanding, coercion screening, and donor support.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="understands_procedure">Understands procedure?</label>
            <select id="understands_procedure" name="psychological_readiness.understands_procedure">
                <option value="" {% if psychological_readiness.understandsProcedure == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.understandsProcedure == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.understandsProcedure == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="understands_risks">Understands risks?</label>
            <select id="understands_risks" name="psychological_readiness.understands_risks">
                <option value="" {% if psychological_readiness.understandsRisks == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.understandsRisks == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.understandsRisks == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="voluntary_decision">Voluntary decision?</label>
            <select id="voluntary_decision" name="psychological_readiness.voluntary_decision">
                <option value="" {% if psychological_readiness.voluntaryDecision == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.voluntaryDecision == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.voluntaryDecision == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="coercion_concerns">Coercion concerns?</label>
            <select id="coercion_concerns" name="psychological_readiness.coercion_concerns">
                <option value="" {% if psychological_readiness.coercionConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if psychological_readiness.coercionConcerns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if psychological_readiness.coercionConcerns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="anxiety_about_procedure">Anxiety about procedure</label>
            <select id="anxiety_about_procedure" name="psychological_readiness.anxiety_about_procedure">
                <option value="" {% if psychological_readiness.anxietyAboutProcedure == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if psychological_readiness.anxietyAboutProcedure == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if psychological_readiness.anxietyAboutProcedure == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if psychological_readiness.anxietyAboutProcedure == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if psychological_readiness.anxietyAboutProcedure == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_psychological_issues">Previous psychological issues?</label>
            <select id="previous_psychological_issues" name="psychological_readiness.previous_psychological_issues">
                <option value="" {% if psychological_readiness.previousPsychologicalIssues == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if psychological_readiness.previousPsychologicalIssues == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if psychological_readiness.previousPsychologicalIssues == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="coercion_details">Coercion Details</label>
        <textarea id="coercion_details" name="psychological_readiness.coercion_details">{{ psychological_readiness.coercionDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="psychological_issue_details">Psychological Issue Details</label>
        <textarea id="psychological_issue_details" name="psychological_readiness.psychological_issue_details">{{ psychological_readiness.psychologicalIssueDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="support_network">Support network?</label>
            <select id="support_network" name="psychological_readiness.support_network">
                <option value="" {% if psychological_readiness.supportNetwork == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.supportNetwork == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.supportNetwork == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="time_off_work_arranged">Time off work arranged?</label>
            <select id="time_off_work_arranged" name="psychological_readiness.time_off_work_arranged">
                <option value="" {% if psychological_readiness.timeOffWorkArranged == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.timeOffWorkArranged == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.timeOffWorkArranged == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="donor_advocate_consulted">Donor advocate consulted?</label>
            <select id="donor_advocate_consulted" name="psychological_readiness.donor_advocate_consulted">
                <option value="" {% if psychological_readiness.donorAdvocateConsulted == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.donorAdvocateConsulted == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.donorAdvocateConsulted == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="willing_to_proceed">Willing to proceed?</label>
        <select id="willing_to_proceed" name="psychological_readiness.willing_to_proceed">
            <option value="" {% if psychological_readiness.willingToProceed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if psychological_readiness.willingToProceed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if psychological_readiness.willingToProceed == "no" %}selected{% endif %}>No</option>
            <option value="undecided" {% if psychological_readiness.willingToProceed == "undecided" %}selected{% endif %}>Undecided</option>
        </select>
    </div>
</div>
