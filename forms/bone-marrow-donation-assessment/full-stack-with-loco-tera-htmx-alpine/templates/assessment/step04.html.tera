<div class="card">
    <h2>Step 4: Physical Examination</h2>
    <p class="form-hint">Vital signs and system-by-system clinical examination.</p>

    <h3>Vital Signs</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="bp_systolic">BP Systolic (mmHg)</label>
            <input type="number" id="bp_systolic" name="physical_examination.bp_systolic"
                   value="{{ physical_examination.bpSystolic }}">
        </div>
        <div class="form-group">
            <label for="bp_diastolic">BP Diastolic (mmHg)</label>
            <input type="number" id="bp_diastolic" name="physical_examination.bp_diastolic"
                   value="{{ physical_examination.bpDiastolic }}">
        </div>
        <div class="form-group">
            <label for="heart_rate">Heart Rate (bpm)</label>
            <input type="number" id="heart_rate" name="physical_examination.heart_rate"
                   value="{{ physical_examination.heartRate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="temperature">Temperature (&deg;C)</label>
            <input type="number" step="0.1" id="temperature" name="physical_examination.temperature"
                   value="{{ physical_examination.temperature }}">
        </div>
        <div class="form-group">
            <label for="respiratory_rate">Respiratory Rate</label>
            <input type="number" id="respiratory_rate" name="physical_examination.respiratory_rate"
                   value="{{ physical_examination.respiratoryRate }}">
        </div>
        <div class="form-group">
            <label for="oxygen_saturation">SpO2 (%)</label>
            <input type="number" id="oxygen_saturation" name="physical_examination.oxygen_saturation"
                   value="{{ physical_examination.oxygenSaturation }}">
        </div>
    </div>

    <h3>Examination</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="general_appearance">General Appearance</label>
            <select id="general_appearance" name="physical_examination.general_appearance">
                <option value="" {% if physical_examination.generalAppearance == "" %}selected{% endif %}>&mdash;</option>
                <option value="well" {% if physical_examination.generalAppearance == "well" %}selected{% endif %}>Well</option>
                <option value="acutely-unwell" {% if physical_examination.generalAppearance == "acutely-unwell" %}selected{% endif %}>Acutely Unwell</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cardiovascular_examination">Cardiovascular Examination</label>
            <select id="cardiovascular_examination" name="physical_examination.cardiovascular_examination">
                <option value="" {% if physical_examination.cardiovascularExamination == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if physical_examination.cardiovascularExamination == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if physical_examination.cardiovascularExamination == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
        <div class="form-group">
            <label for="respiratory_examination">Respiratory Examination</label>
            <select id="respiratory_examination" name="physical_examination.respiratory_examination">
                <option value="" {% if physical_examination.respiratoryExamination == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if physical_examination.respiratoryExamination == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if physical_examination.respiratoryExamination == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="abdominal_examination">Abdominal Examination</label>
            <select id="abdominal_examination" name="physical_examination.abdominal_examination">
                <option value="" {% if physical_examination.abdominalExamination == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if physical_examination.abdominalExamination == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if physical_examination.abdominalExamination == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
        <div class="form-group">
            <label for="venous_access_assessment">Venous Access Assessment</label>
            <select id="venous_access_assessment" name="physical_examination.venous_access_assessment">
                <option value="" {% if physical_examination.venousAccessAssessment == "" %}selected{% endif %}>&mdash;</option>
                <option value="good" {% if physical_examination.venousAccessAssessment == "good" %}selected{% endif %}>Good</option>
                <option value="adequate" {% if physical_examination.venousAccessAssessment == "adequate" %}selected{% endif %}>Adequate</option>
                <option value="poor" {% if physical_examination.venousAccessAssessment == "poor" %}selected{% endif %}>Poor</option>
            </select>
        </div>
        <div class="form-group">
            <label for="posterior_iliac_crest_assessment">Posterior Iliac Crest</label>
            <select id="posterior_iliac_crest_assessment" name="physical_examination.posterior_iliac_crest_assessment">
                <option value="" {% if physical_examination.posteriorIliacCrestAssessment == "" %}selected{% endif %}>&mdash;</option>
                <option value="suitable" {% if physical_examination.posteriorIliacCrestAssessment == "suitable" %}selected{% endif %}>Suitable for harvest</option>
                <option value="unsuitable" {% if physical_examination.posteriorIliacCrestAssessment == "unsuitable" %}selected{% endif %}>Unsuitable for harvest</option>
            </select>
        </div>
    </div>
</div>
