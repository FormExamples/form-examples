<div class="card">
    <h2>Step 3: Medical History</h2>
    <p class="form-hint">Significant medical conditions and current medications.</p>

    {% set yn_fields = [
        ["has_autoimmune_disease", "Autoimmune disease", "autoimmune_details", "Autoimmune details", donor_registration_hla_typing.donorRegistry]
    ] %}

    <div class="form-row">
        <div class="form-group">
            <label for="has_autoimmune_disease">Autoimmune disease?</label>
            <select id="has_autoimmune_disease" name="medical_history.has_autoimmune_disease">
                <option value="" {% if medical_history.hasAutoimmuneDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasAutoimmuneDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasAutoimmuneDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="has_malignancy">History of malignancy?</label>
            <select id="has_malignancy" name="medical_history.has_malignancy">
                <option value="" {% if medical_history.hasMalignancy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasMalignancy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasMalignancy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="has_cardiovascular_disease">Cardiovascular disease?</label>
            <select id="has_cardiovascular_disease" name="medical_history.has_cardiovascular_disease">
                <option value="" {% if medical_history.hasCardiovascularDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasCardiovascularDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasCardiovascularDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="has_respiratory_disease">Respiratory disease?</label>
            <select id="has_respiratory_disease" name="medical_history.has_respiratory_disease">
                <option value="" {% if medical_history.hasRespiratoryDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasRespiratoryDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasRespiratoryDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="has_renal_disease">Renal disease?</label>
            <select id="has_renal_disease" name="medical_history.has_renal_disease">
                <option value="" {% if medical_history.hasRenalDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasRenalDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasRenalDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="has_hepatic_disease">Hepatic disease?</label>
            <select id="has_hepatic_disease" name="medical_history.has_hepatic_disease">
                <option value="" {% if medical_history.hasHepaticDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasHepaticDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasHepaticDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="has_bleeding_disorder">Bleeding disorder?</label>
            <select id="has_bleeding_disorder" name="medical_history.has_bleeding_disorder">
                <option value="" {% if medical_history.hasBleedingDisorder == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasBleedingDisorder == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasBleedingDisorder == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="has_neurological_condition">Neurological condition?</label>
            <select id="has_neurological_condition" name="medical_history.has_neurological_condition">
                <option value="" {% if medical_history.hasNeurologicalCondition == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hasNeurologicalCondition == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hasNeurologicalCondition == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_surgery">Previous Surgery?</label>
            <select id="previous_surgery" name="medical_history.previous_surgery">
                <option value="" {% if medical_history.previousSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.previousSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.previousSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="current_medications">Current Medications</label>
        <textarea id="current_medications" name="medical_history.current_medications">{{ medical_history.currentMedications }}</textarea>
    </div>

    <div class="form-group">
        <label for="drug_allergies">Drug Allergies</label>
        <textarea id="drug_allergies" name="medical_history.drug_allergies">{{ medical_history.drugAllergies }}</textarea>
    </div>
</div>
