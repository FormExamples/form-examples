<div class="card">
    <h2>Step 10: Consent &amp; Eligibility Decision</h2>
    <p class="form-hint">Final informed-consent capture and assessor eligibility decision.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="informed_consent_given">Informed consent given?</label>
            <select id="informed_consent_given" name="consent_eligibility.informed_consent_given">
                <option value="" {% if consent_eligibility.informedConsentGiven == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if consent_eligibility.informedConsentGiven == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if consent_eligibility.informedConsentGiven == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="consent_form_signed">Consent form signed?</label>
            <select id="consent_form_signed" name="consent_eligibility.consent_form_signed">
                <option value="" {% if consent_eligibility.consentFormSigned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if consent_eligibility.consentFormSigned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if consent_eligibility.consentFormSigned == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="consent_date">Consent Date</label>
            <input type="date" id="consent_date" name="consent_eligibility.consent_date"
                   value="{{ consent_eligibility.consentDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="witness_name">Witness Name</label>
            <input type="text" id="witness_name" name="consent_eligibility.witness_name"
                   value="{{ consent_eligibility.witnessName }}">
        </div>
        <div class="form-group">
            <label for="witness_role">Witness Role</label>
            <input type="text" id="witness_role" name="consent_eligibility.witness_role"
                   value="{{ consent_eligibility.witnessRole }}">
        </div>
        <div class="form-group">
            <label for="information_leaflet_provided">Information leaflet provided?</label>
            <select id="information_leaflet_provided" name="consent_eligibility.information_leaflet_provided">
                <option value="" {% if consent_eligibility.informationLeafletProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if consent_eligibility.informationLeafletProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if consent_eligibility.informationLeafletProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="questions_answered">Questions answered?</label>
            <select id="questions_answered" name="consent_eligibility.questions_answered">
                <option value="" {% if consent_eligibility.questionsAnswered == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if consent_eligibility.questionsAnswered == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if consent_eligibility.questionsAnswered == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="eligibility_decision">Eligibility Decision</label>
            <select id="eligibility_decision" name="consent_eligibility.eligibility_decision">
                <option value="" {% if consent_eligibility.eligibilityDecision == "" %}selected{% endif %}>&mdash; (use engine suggestion)</option>
                <option value="suitable" {% if consent_eligibility.eligibilityDecision == "suitable" %}selected{% endif %}>Suitable</option>
                <option value="conditionally-suitable" {% if consent_eligibility.eligibilityDecision == "conditionally-suitable" %}selected{% endif %}>Conditionally Suitable</option>
                <option value="unsuitable" {% if consent_eligibility.eligibilityDecision == "unsuitable" %}selected{% endif %}>Unsuitable</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="eligibility_conditions">Eligibility Conditions</label>
        <textarea id="eligibility_conditions" name="consent_eligibility.eligibility_conditions">{{ consent_eligibility.eligibilityConditions }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="deferral_reason">Deferral Reason</label>
            <input type="text" id="deferral_reason" name="consent_eligibility.deferral_reason"
                   value="{{ consent_eligibility.deferralReason }}">
        </div>
        <div class="form-group">
            <label for="deferral_duration">Deferral Duration</label>
            <input type="text" id="deferral_duration" name="consent_eligibility.deferral_duration"
                   value="{{ consent_eligibility.deferralDuration }}">
        </div>
    </div>

    <h3>Assessor</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="assessor_name">Assessor Name</label>
            <input type="text" id="assessor_name" name="consent_eligibility.assessor_name"
                   value="{{ consent_eligibility.assessorName }}">
        </div>
        <div class="form-group">
            <label for="assessor_role">Assessor Role</label>
            <input type="text" id="assessor_role" name="consent_eligibility.assessor_role"
                   value="{{ consent_eligibility.assessorRole }}">
        </div>
        <div class="form-group">
            <label for="assessment_date">Assessment Date</label>
            <input type="date" id="assessment_date" name="consent_eligibility.assessment_date"
                   value="{{ consent_eligibility.assessmentDate }}">
        </div>
    </div>
</div>
