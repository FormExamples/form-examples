{% extends "base.html.tera" %}

{% block title %}Bone Marrow Donation Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Donor Assessment Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Donor name, registry, or registry ID...">
    </div>
    <div class="form-group">
        <label for="eligibility">Eligibility</label>
        <select id="eligibility" name="eligibility">
            <option value="">All</option>
            <option value="suitable" {% if eligibility == "suitable" %}selected{% endif %}>Suitable</option>
            <option value="conditionally-suitable" {% if eligibility == "conditionally-suitable" %}selected{% endif %}>Conditionally Suitable</option>
            <option value="unsuitable" {% if eligibility == "unsuitable" %}selected{% endif %}>Unsuitable</option>
        </select>
    </div>
    <div class="form-group">
        <label for="overall_risk">Risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if overall_risk == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="donation_type">Donation Type</label>
        <select id="donation_type" name="donation_type">
            <option value="">All</option>
            <option value="related" {% if donation_type == "related" %}selected{% endif %}>Related</option>
            <option value="unrelated" {% if donation_type == "unrelated" %}selected{% endif %}>Unrelated</option>
            <option value="autologous" {% if donation_type == "autologous" %}selected{% endif %}>Autologous</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Assessment Date</th>
            <th>Donor</th>
            <th>Registry</th>
            <th>Donation Type</th>
            <th>HLA Match</th>
            <th>Eligibility</th>
            <th>Risk</th>
            <th>Collection Method</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.assessmentDate }}</a></td>
            <td>{{ c.donorName }}</td>
            <td>{{ c.donorRegistry }}<br><small>{{ c.donorRegistryId }}</small></td>
            <td>{{ c.donationType }}</td>
            <td>{{ c.hlaMatchLevel }}</td>
            <td><span class="checklist-badge checklist-{{ c.eligibility }}">{{ c.eligibility }}</span></td>
            <td><span class="severity-badge severity-{{ c.overallRisk }}">{{ c.overallRisk }}</span></td>
            <td>{{ c.collectionMethod }}</td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
