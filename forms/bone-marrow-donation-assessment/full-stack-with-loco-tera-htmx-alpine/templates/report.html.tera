{% extends "base.html.tera" %}

{% block title %}Donor Assessment Report - {{ eligibility_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Bone Marrow Donation Assessment &mdash; Donor Report</h1>
    <div class="checklist-badge checklist-{{ eligibility }}">{{ eligibility_label }}</div>
    <div class="checklist-label">Overall risk: {{ risk_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Donor Summary -->
<div class="card">
    <h2>Donor Summary</h2>
    <div class="form-row">
        <div>
            <strong>Donor:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Registry:</strong> {{ data.donorRegistrationHlaTyping.donorRegistry }}<br>
            <strong>Registry ID:</strong> {{ data.donorRegistrationHlaTyping.donorRegistryId }}
        </div>
        <div>
            <strong>Donation Type:</strong> {{ data.donorRegistrationHlaTyping.donationType }}<br>
            <strong>Recipient Relationship:</strong> {{ data.donorRegistrationHlaTyping.recipientRelationship }}<br>
            <strong>HLA Match:</strong> {{ hla_match_level }}<br>
            <strong>Crossmatch:</strong> {{ data.donorRegistrationHlaTyping.crossmatchResult }}<br>
            <strong>Collection Method:</strong> {{ collection_method }}
        </div>
    </div>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Findings ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge grade-{{ rule.grade }}">Grade {{ rule.grade }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
