<div class="card">
    <h2>Step 4: Hair &amp; Scalp Examination</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="hair_distribution">Hair Distribution</label>
            <input type="text" id="hair_distribution" name="hair_scalp_examination.hair_distribution"
                   value="{{ hair_scalp_examination.hairDistribution }}" placeholder="e.g. normal, thinning, patchy">
        </div>
        <div class="form-group">
            <label for="hair_texture">Hair Texture</label>
            <input type="text" id="hair_texture" name="hair_scalp_examination.hair_texture"
                   value="{{ hair_scalp_examination.hairTexture }}" placeholder="e.g. coarse, fine, brittle">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="alopecia">Alopecia</label>
            <select id="alopecia" name="hair_scalp_examination.alopecia">
                <option value="" {% if hair_scalp_examination.alopecia == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if hair_scalp_examination.alopecia == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if hair_scalp_examination.alopecia == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="alopecia_pattern">Alopecia Pattern</label>
            <input type="text" id="alopecia_pattern" name="hair_scalp_examination.alopecia_pattern"
                   value="{{ hair_scalp_examination.alopeciaPattern }}" placeholder="e.g. androgenetic, areata, diffuse">
        </div>
        <div class="form-group">
            <label for="scalp_lesions">Scalp Lesions</label>
            <select id="scalp_lesions" name="hair_scalp_examination.scalp_lesions">
                <option value="" {% if hair_scalp_examination.scalpLesions == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if hair_scalp_examination.scalpLesions == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if hair_scalp_examination.scalpLesions == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="scalp_notes">Scalp Notes</label>
        <textarea id="scalp_notes" name="hair_scalp_examination.scalp_notes"
                  rows="2">{{ hair_scalp_examination.scalpNotes }}</textarea>
    </div>
</div>
