<div class="card">
    <h2>Step 8: Photography &amp; Documentation</h2>
    <p class="form-hint">Photographs of skin lesions / wounds require documented patient consent.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="consent_obtained">Consent Obtained?</label>
            <select id="consent_obtained" name="photography_documentation.consent_obtained">
                <option value="" {% if photography_documentation.consentObtained == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if photography_documentation.consentObtained == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if photography_documentation.consentObtained == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="photos_taken">Photos Taken?</label>
            <select id="photos_taken" name="photography_documentation.photos_taken">
                <option value="" {% if photography_documentation.photosTaken == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if photography_documentation.photosTaken == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if photography_documentation.photosTaken == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="documentation_notes">Documentation Notes</label>
        <textarea id="documentation_notes" name="photography_documentation.documentation_notes"
                  rows="3">{{ photography_documentation.documentationNotes }}</textarea>
    </div>
</div>
