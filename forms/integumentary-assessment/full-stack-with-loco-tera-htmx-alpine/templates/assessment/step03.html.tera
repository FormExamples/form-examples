<div class="card">
    <h2>Step 3: Skin Inspection</h2>
    <p class="form-hint">Head-to-toe inspection: colour, moisture, integrity, turgor, temperature.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="colour">Colour</label>
            <select id="colour" name="skin_inspection.colour">
                <option value="" {% if skin_inspection.colour == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if skin_inspection.colour == "normal" %}selected{% endif %}>Normal</option>
                <option value="pale" {% if skin_inspection.colour == "pale" %}selected{% endif %}>Pale</option>
                <option value="erythematous" {% if skin_inspection.colour == "erythematous" %}selected{% endif %}>Erythematous</option>
                <option value="jaundiced" {% if skin_inspection.colour == "jaundiced" %}selected{% endif %}>Jaundiced</option>
                <option value="cyanotic" {% if skin_inspection.colour == "cyanotic" %}selected{% endif %}>Cyanotic</option>
            </select>
        </div>
        <div class="form-group">
            <label for="moisture">Moisture</label>
            <select id="moisture" name="skin_inspection.moisture">
                <option value="" {% if skin_inspection.moisture == "" %}selected{% endif %}>&mdash;</option>
                <option value="dry" {% if skin_inspection.moisture == "dry" %}selected{% endif %}>Dry</option>
                <option value="normal" {% if skin_inspection.moisture == "normal" %}selected{% endif %}>Normal</option>
                <option value="moist" {% if skin_inspection.moisture == "moist" %}selected{% endif %}>Moist</option>
                <option value="diaphoretic" {% if skin_inspection.moisture == "diaphoretic" %}selected{% endif %}>Diaphoretic</option>
            </select>
        </div>
        <div class="form-group">
            <label for="integrity">Integrity</label>
            <select id="integrity" name="skin_inspection.integrity">
                <option value="" {% if skin_inspection.integrity == "" %}selected{% endif %}>&mdash;</option>
                <option value="intact" {% if skin_inspection.integrity == "intact" %}selected{% endif %}>Intact</option>
                <option value="dry" {% if skin_inspection.integrity == "dry" %}selected{% endif %}>Dry</option>
                <option value="breakdown" {% if skin_inspection.integrity == "breakdown" %}selected{% endif %}>Breakdown</option>
                <option value="open-lesions" {% if skin_inspection.integrity == "open-lesions" %}selected{% endif %}>Open lesions</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="turgor">Turgor</label>
            <select id="turgor" name="skin_inspection.turgor">
                <option value="" {% if skin_inspection.turgor == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if skin_inspection.turgor == "normal" %}selected{% endif %}>Normal</option>
                <option value="tenting" {% if skin_inspection.turgor == "tenting" %}selected{% endif %}>Tenting</option>
                <option value="poor" {% if skin_inspection.turgor == "poor" %}selected{% endif %}>Poor</option>
            </select>
        </div>
        <div class="form-group">
            <label for="temperature">Temperature</label>
            <select id="temperature" name="skin_inspection.temperature">
                <option value="" {% if skin_inspection.temperature == "" %}selected{% endif %}>&mdash;</option>
                <option value="warm" {% if skin_inspection.temperature == "warm" %}selected{% endif %}>Warm</option>
                <option value="cool" {% if skin_inspection.temperature == "cool" %}selected{% endif %}>Cool</option>
                <option value="hot" {% if skin_inspection.temperature == "hot" %}selected{% endif %}>Hot</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="additional_notes">Additional Notes</label>
        <textarea id="additional_notes" name="skin_inspection.additional_notes"
                  rows="3">{{ skin_inspection.additionalNotes }}</textarea>
    </div>
</div>
