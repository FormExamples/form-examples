<div class="card">
    <h2>Step 9: Clinical Impression &amp; Care Plan</h2>

    <div class="form-group">
        <label for="clinical_impression">Clinical Impression</label>
        <textarea id="clinical_impression" name="clinical_impression_care_plan.clinical_impression"
                  rows="3">{{ clinical_impression_care_plan.clinicalImpression }}</textarea>
    </div>

    <div class="form-group">
        <label for="differential_diagnoses">Differential Diagnoses</label>
        <textarea id="differential_diagnoses" name="clinical_impression_care_plan.differential_diagnoses"
                  rows="2">{{ clinical_impression_care_plan.differentialDiagnoses }}</textarea>
    </div>

    <div class="form-group">
        <label for="care_plan">Care Plan</label>
        <textarea id="care_plan" name="clinical_impression_care_plan.care_plan"
                  rows="3">{{ clinical_impression_care_plan.carePlan }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dressing_required">Dressing Required?</label>
            <select id="dressing_required" name="clinical_impression_care_plan.dressing_required">
                <option value="" {% if clinical_impression_care_plan.dressingRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if clinical_impression_care_plan.dressingRequired == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if clinical_impression_care_plan.dressingRequired == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dressing_type">Dressing Type</label>
            <input type="text" id="dressing_type" name="clinical_impression_care_plan.dressing_type"
                   value="{{ clinical_impression_care_plan.dressingType }}">
        </div>
        <div class="form-group">
            <label for="pressure_relief_required">Pressure Relief Required?</label>
            <select id="pressure_relief_required" name="clinical_impression_care_plan.pressure_relief_required">
                <option value="" {% if clinical_impression_care_plan.pressureReliefRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if clinical_impression_care_plan.pressureReliefRequired == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if clinical_impression_care_plan.pressureReliefRequired == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="referral_required">Referral Required?</label>
            <select id="referral_required" name="clinical_impression_care_plan.referral_required">
                <option value="" {% if clinical_impression_care_plan.referralRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if clinical_impression_care_plan.referralRequired == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if clinical_impression_care_plan.referralRequired == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="referral_details">Referral Details</label>
            <input type="text" id="referral_details" name="clinical_impression_care_plan.referral_details"
                   value="{{ clinical_impression_care_plan.referralDetails }}" placeholder="Service, urgency, indication">
        </div>
        <div class="form-group">
            <label for="follow_up_date">Follow-Up Date</label>
            <input type="date" id="follow_up_date" name="clinical_impression_care_plan.follow_up_date"
                   value="{{ clinical_impression_care_plan.followUpDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="clinician_name">Clinician Name</label>
        <input type="text" id="clinician_name" name="clinical_impression_care_plan.clinician_name"
               value="{{ clinical_impression_care_plan.clinicianName }}">
    </div>
</div>
