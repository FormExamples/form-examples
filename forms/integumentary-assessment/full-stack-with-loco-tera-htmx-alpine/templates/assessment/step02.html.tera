<div class="card">
    <h2>Step 2: Presenting Skin Concern</h2>
    <p class="form-hint">Chief complaint, onset, and associated symptoms (pain, itching, bleeding, discharge).</p>

    <div class="form-group">
        <label for="chief_complaint">Chief Complaint</label>
        <textarea id="chief_complaint" name="presenting_skin_concern.chief_complaint"
                  rows="2">{{ presenting_skin_concern.chiefComplaint }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="onset">Onset</label>
            <input type="text" id="onset" name="presenting_skin_concern.onset"
                   value="{{ presenting_skin_concern.onset }}" placeholder="e.g. 3 days ago, gradual">
        </div>
        <div class="form-group">
            <label for="duration">Duration</label>
            <input type="text" id="duration" name="presenting_skin_concern.duration"
                   value="{{ presenting_skin_concern.duration }}" placeholder="e.g. ongoing, 2 weeks">
        </div>
        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="presenting_skin_concern.location"
                   value="{{ presenting_skin_concern.location }}" placeholder="e.g. sacrum, left calf">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="pain">Pain</label>
            <select id="pain" name="presenting_skin_concern.pain">
                <option value="" {% if presenting_skin_concern.pain == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_skin_concern.pain == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_skin_concern.pain == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pain_score">Pain Score (0&ndash;10)</label>
            <input type="number" min="0" max="10" id="pain_score" name="presenting_skin_concern.pain_score"
                   value="{{ presenting_skin_concern.painScore }}">
        </div>
        <div class="form-group">
            <label for="itching">Itching</label>
            <select id="itching" name="presenting_skin_concern.itching">
                <option value="" {% if presenting_skin_concern.itching == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_skin_concern.itching == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_skin_concern.itching == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="bleeding">Bleeding</label>
            <select id="bleeding" name="presenting_skin_concern.bleeding">
                <option value="" {% if presenting_skin_concern.bleeding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_skin_concern.bleeding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_skin_concern.bleeding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="discharge">Discharge</label>
            <select id="discharge" name="presenting_skin_concern.discharge">
                <option value="" {% if presenting_skin_concern.discharge == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_skin_concern.discharge == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_skin_concern.discharge == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="aggravating_factors">Aggravating Factors</label>
        <input type="text" id="aggravating_factors" name="presenting_skin_concern.aggravating_factors"
               value="{{ presenting_skin_concern.aggravatingFactors }}">
    </div>
    <div class="form-group">
        <label for="relieving_factors">Relieving Factors</label>
        <input type="text" id="relieving_factors" name="presenting_skin_concern.relieving_factors"
               value="{{ presenting_skin_concern.relievingFactors }}">
    </div>
    <div class="form-group">
        <label for="prior_treatment">Prior Treatment</label>
        <textarea id="prior_treatment" name="presenting_skin_concern.prior_treatment"
                  rows="2">{{ presenting_skin_concern.priorTreatment }}</textarea>
    </div>
</div>
