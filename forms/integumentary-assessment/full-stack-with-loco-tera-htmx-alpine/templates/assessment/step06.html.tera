<div class="card">
    <h2>Step 6: Wound Assessment</h2>
    <p class="form-hint">If a wound is present, record stage (NPIAP) and TIME (Tissue, Infection, Moisture, Edge) characteristics.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_present">Wound Present?</label>
            <select id="wound_present" name="wound_assessment.wound_present">
                <option value="" {% if wound_assessment.woundPresent == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if wound_assessment.woundPresent == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if wound_assessment.woundPresent == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="wound_location">Location</label>
            <input type="text" id="wound_location" name="wound_assessment.wound_location"
                   value="{{ wound_assessment.woundLocation }}" placeholder="e.g. sacrum">
        </div>
        <div class="form-group">
            <label for="wound_stage">Stage</label>
            <select id="wound_stage" name="wound_assessment.wound_stage">
                <option value="" {% if wound_assessment.woundStage == "" %}selected{% endif %}>&mdash;</option>
                <option value="stage-i" {% if wound_assessment.woundStage == "stage-i" %}selected{% endif %}>Stage I</option>
                <option value="stage-ii" {% if wound_assessment.woundStage == "stage-ii" %}selected{% endif %}>Stage II</option>
                <option value="stage-iii" {% if wound_assessment.woundStage == "stage-iii" %}selected{% endif %}>Stage III</option>
                <option value="stage-iv" {% if wound_assessment.woundStage == "stage-iv" %}selected{% endif %}>Stage IV</option>
                <option value="unstageable" {% if wound_assessment.woundStage == "unstageable" %}selected{% endif %}>Unstageable</option>
                <option value="deep-tissue-injury" {% if wound_assessment.woundStage == "deep-tissue-injury" %}selected{% endif %}>Deep tissue injury</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_length">Length (cm)</label>
            <input type="number" step="0.1" id="wound_length" name="wound_assessment.wound_length"
                   value="{{ wound_assessment.woundLength }}">
        </div>
        <div class="form-group">
            <label for="wound_width">Width (cm)</label>
            <input type="number" step="0.1" id="wound_width" name="wound_assessment.wound_width"
                   value="{{ wound_assessment.woundWidth }}">
        </div>
        <div class="form-group">
            <label for="wound_depth">Depth (cm)</label>
            <input type="number" step="0.1" id="wound_depth" name="wound_assessment.wound_depth"
                   value="{{ wound_assessment.woundDepth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="tissue_type">Tissue Type (T)</label>
            <select id="tissue_type" name="wound_assessment.tissue_type">
                <option value="" {% if wound_assessment.tissueType == "" %}selected{% endif %}>&mdash;</option>
                <option value="epithelial" {% if wound_assessment.tissueType == "epithelial" %}selected{% endif %}>Epithelial</option>
                <option value="granulation" {% if wound_assessment.tissueType == "granulation" %}selected{% endif %}>Granulation</option>
                <option value="slough" {% if wound_assessment.tissueType == "slough" %}selected{% endif %}>Slough</option>
                <option value="necrotic" {% if wound_assessment.tissueType == "necrotic" %}selected{% endif %}>Necrotic</option>
                <option value="eschar" {% if wound_assessment.tissueType == "eschar" %}selected{% endif %}>Eschar</option>
            </select>
        </div>
        <div class="form-group">
            <label for="infection_signs">Infection Signs (I)</label>
            <select id="infection_signs" name="wound_assessment.infection_signs">
                <option value="" {% if wound_assessment.infectionSigns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if wound_assessment.infectionSigns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if wound_assessment.infectionSigns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="moisture_balance">Moisture Balance (M)</label>
            <input type="text" id="moisture_balance" name="wound_assessment.moisture_balance"
                   value="{{ wound_assessment.moistureBalance }}" placeholder="e.g. balanced, dry, macerated">
        </div>
        <div class="form-group">
            <label for="edge_condition">Edge (E)</label>
            <input type="text" id="edge_condition" name="wound_assessment.edge_condition"
                   value="{{ wound_assessment.edgeCondition }}" placeholder="e.g. attached, rolled, undermined">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="exudate_amount">Exudate Amount</label>
            <select id="exudate_amount" name="wound_assessment.exudate_amount">
                <option value="" {% if wound_assessment.exudateAmount == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if wound_assessment.exudateAmount == "none" %}selected{% endif %}>None</option>
                <option value="scant" {% if wound_assessment.exudateAmount == "scant" %}selected{% endif %}>Scant</option>
                <option value="moderate" {% if wound_assessment.exudateAmount == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="heavy" {% if wound_assessment.exudateAmount == "heavy" %}selected{% endif %}>Heavy</option>
            </select>
        </div>
        <div class="form-group">
            <label for="exudate_type">Exudate Type</label>
            <input type="text" id="exudate_type" name="wound_assessment.exudate_type"
                   value="{{ wound_assessment.exudateType }}" placeholder="e.g. serous, sanguineous, purulent">
        </div>
        <div class="form-group">
            <label for="wound_odour">Wound Odour</label>
            <select id="wound_odour" name="wound_assessment.wound_odour">
                <option value="" {% if wound_assessment.woundOdour == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if wound_assessment.woundOdour == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if wound_assessment.woundOdour == "mild" %}selected{% endif %}>Mild</option>
                <option value="strong" {% if wound_assessment.woundOdour == "strong" %}selected{% endif %}>Strong</option>
                <option value="foul" {% if wound_assessment.woundOdour == "foul" %}selected{% endif %}>Foul</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="wound_notes">Wound Notes</label>
        <textarea id="wound_notes" name="wound_assessment.wound_notes"
                  rows="2">{{ wound_assessment.woundNotes }}</textarea>
    </div>
</div>
