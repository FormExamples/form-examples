{% extends "base.html.tera" %}

{% block title %}Integumentary Assessment Report - {{ risk_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Integumentary Assessment &mdash; Report</h1>
    <div class="risk-badge {{ risk_class }}">{{ risk_label }}</div>
    <div class="risk-label">Braden total: <strong>{{ braden_score }}</strong> ({{ answered_count }} of 6 subscales answered)</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Weight:</strong> {{ data.demographics.weight }} kg<br>
            <strong>Height:</strong> {{ data.demographics.height }} cm
        </div>
        <div>
            <strong>Clinician:</strong> {{ data.clinicalImpressionCarePlan.clinicianName }}<br>
            <strong>Follow-Up:</strong> {{ data.clinicalImpressionCarePlan.followUpDate }}<br>
            <strong>Dressing Required:</strong> {{ data.clinicalImpressionCarePlan.dressingRequired }}<br>
            <strong>Pressure Relief Required:</strong> {{ data.clinicalImpressionCarePlan.pressureReliefRequired }}<br>
            <strong>Referral Required:</strong> {{ data.clinicalImpressionCarePlan.referralRequired }}
        </div>
    </div>
</div>

<!-- Braden subscale audit -->
<div class="card">
    <h2>Braden Scale Audit</h2>
    {% if fired_rules | length > 0 %}
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Subscale</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }} / {{ rule.maxScore }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No Braden subscales answered &mdash; defaulting to 23 (No Risk).</p>
    {% endif %}
</div>

<!-- Wound -->
{% if data.woundAssessment.woundPresent == "yes" %}
<div class="card">
    <h2>Wound Assessment</h2>
    <div class="form-row">
        <div>
            <strong>Location:</strong> {{ data.woundAssessment.woundLocation }}<br>
            <strong>Stage:</strong> {{ data.woundAssessment.woundStage }}<br>
            <strong>Tissue Type:</strong> {{ data.woundAssessment.tissueType }}<br>
            <strong>Infection Signs:</strong> {{ data.woundAssessment.infectionSigns }}
        </div>
        <div>
            <strong>Length:</strong> {{ data.woundAssessment.woundLength }} cm<br>
            <strong>Width:</strong> {{ data.woundAssessment.woundWidth }} cm<br>
            <strong>Depth:</strong> {{ data.woundAssessment.woundDepth }} cm<br>
            <strong>Exudate:</strong> {{ data.woundAssessment.exudateAmount }} &mdash; {{ data.woundAssessment.exudateType }}<br>
            <strong>Odour:</strong> {{ data.woundAssessment.woundOdour }}
        </div>
    </div>
    {% if data.woundAssessment.woundNotes %}
    <p><strong>Notes:</strong> {{ data.woundAssessment.woundNotes }}</p>
    {% endif %}
</div>
{% endif %}

<!-- Safety flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Clinical Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Clinical impression -->
<div class="card">
    <h2>Clinical Impression &amp; Care Plan</h2>
    <p><strong>Impression:</strong> {{ data.clinicalImpressionCarePlan.clinicalImpression }}</p>
    {% if data.clinicalImpressionCarePlan.differentialDiagnoses %}
    <p><strong>Differential Diagnoses:</strong> {{ data.clinicalImpressionCarePlan.differentialDiagnoses }}</p>
    {% endif %}
    <p><strong>Plan:</strong> {{ data.clinicalImpressionCarePlan.carePlan }}</p>
    {% if data.clinicalImpressionCarePlan.dressingRequired == "yes" %}
    <p><strong>Dressing:</strong> {{ data.clinicalImpressionCarePlan.dressingType }}</p>
    {% endif %}
    {% if data.clinicalImpressionCarePlan.referralRequired == "yes" %}
    <p><strong>Referral:</strong> {{ data.clinicalImpressionCarePlan.referralDetails }}</p>
    {% endif %}
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
