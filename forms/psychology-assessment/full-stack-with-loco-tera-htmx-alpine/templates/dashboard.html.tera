{% extends "base.html.tera" %}

{% block title %}Psychology Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Clinician Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or primary concern...">
    </div>
    <div class="form-group">
        <label for="depression_severity">Depression severity</label>
        <select id="depression_severity" name="depression_severity">
            <option value="">All</option>
            <option value="normal" {% if depression_severity == "normal" %}selected{% endif %}>Normal</option>
            <option value="mild" {% if depression_severity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if depression_severity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if depression_severity == "severe" %}selected{% endif %}>Severe</option>
            <option value="extremely-severe" {% if depression_severity == "extremely-severe" %}selected{% endif %}>Extremely Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="anxiety_severity">Anxiety severity</label>
        <select id="anxiety_severity" name="anxiety_severity">
            <option value="">All</option>
            <option value="normal" {% if anxiety_severity == "normal" %}selected{% endif %}>Normal</option>
            <option value="mild" {% if anxiety_severity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if anxiety_severity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if anxiety_severity == "severe" %}selected{% endif %}>Severe</option>
            <option value="extremely-severe" {% if anxiety_severity == "extremely-severe" %}selected{% endif %}>Extremely Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="stress_severity">Stress severity</label>
        <select id="stress_severity" name="stress_severity">
            <option value="">All</option>
            <option value="normal" {% if stress_severity == "normal" %}selected{% endif %}>Normal</option>
            <option value="mild" {% if stress_severity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if stress_severity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if stress_severity == "severe" %}selected{% endif %}>Severe</option>
            <option value="extremely-severe" {% if stress_severity == "extremely-severe" %}selected{% endif %}>Extremely Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Urgent/High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Created</th>
            <th>Patient</th>
            <th>Primary Concern</th>
            <th>Depression</th>
            <th>Anxiety</th>
            <th>Stress</th>
            <th>Urgent</th>
            <th>High</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.createdAt }}</a></td>
            <td>{{ c.patientName }}<br><small>{{ c.dateOfBirth }}</small></td>
            <td>{{ c.primaryConcern }}</td>
            <td>{{ c.depressionScaled }} <small>({{ c.depressionSeverity }})</small></td>
            <td>{{ c.anxietyScaled }} <small>({{ c.anxietySeverity }})</small></td>
            <td>{{ c.stressScaled }} <small>({{ c.stressSeverity }})</small></td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>
                {% if c.highFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
