{% extends "base.html.tera" %}

{% block title %}Assessment Report{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Psychology Assessment &mdash; DASS-21 Report</h1>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Demographics -->
<div class="card">
    <h2>Demographics</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Occupation:</strong> {{ data.demographics.occupation }}
        </div>
        <div>
            <strong>Reason:</strong> {{ data.reasonForAssessment.reason }}<br>
            <strong>Primary concern:</strong> {{ data.reasonForAssessment.primaryConcern }}<br>
            <strong>Symptom duration (weeks):</strong> {{ data.reasonForAssessment.symptomDurationWeeks }}
        </div>
    </div>
</div>

<!-- Subscale results -->
<div class="card">
    <h2>DASS-21 Subscale Results</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Subscale</th>
                <th>Raw (0&ndash;21)</th>
                <th>Scaled (0&ndash;42)</th>
                <th>Severity</th>
                <th>Items answered</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Depression</td>
                <td>{{ depression.raw }}</td>
                <td>{{ depression.scaled }}</td>
                <td><span class="severity-badge severity-{{ depression.severity }}">{{ depression_label }}</span></td>
                <td>{{ depression.answered }} / 7</td>
            </tr>
            <tr>
                <td>Anxiety</td>
                <td>{{ anxiety.raw }}</td>
                <td>{{ anxiety.scaled }}</td>
                <td><span class="severity-badge severity-{{ anxiety.severity }}">{{ anxiety_label }}</span></td>
                <td>{{ anxiety.answered }} / 7</td>
            </tr>
            <tr>
                <td>Stress</td>
                <td>{{ stress.raw }}</td>
                <td>{{ stress.scaled }}</td>
                <td><span class="severity-badge severity-{{ stress.severity }}">{{ stress_label }}</span></td>
                <td>{{ stress.answered }} / 7</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety / Clinical Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Answered items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>DASS-21 Items Answered ({{ fired_rules | length }} / 21)</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Subscale</th>
                <th>Item #</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.subscale }}</td>
                <td>{{ rule.itemNumber }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
