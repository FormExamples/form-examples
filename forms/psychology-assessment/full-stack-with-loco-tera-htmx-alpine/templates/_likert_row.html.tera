{% macro row(name, label, current) %}
<tr>
  <td style="padding:0.4rem 0.8rem;">{{ label }}</td>
  <td style="padding:0.4rem 0.4rem;text-align:center;">
    <input type="radio" name="{{ name }}" value="0" {% if current == 0 %}checked{% endif %}>
  </td>
  <td style="padding:0.4rem 0.4rem;text-align:center;">
    <input type="radio" name="{{ name }}" value="1" {% if current == 1 %}checked{% endif %}>
  </td>
  <td style="padding:0.4rem 0.4rem;text-align:center;">
    <input type="radio" name="{{ name }}" value="2" {% if current == 2 %}checked{% endif %}>
  </td>
  <td style="padding:0.4rem 0.4rem;text-align:center;">
    <input type="radio" name="{{ name }}" value="3" {% if current == 3 %}checked{% endif %}>
  </td>
</tr>
{% endmacro row %}
