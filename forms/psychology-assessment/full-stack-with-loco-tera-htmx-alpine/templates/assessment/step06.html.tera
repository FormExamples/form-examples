<div class="card">
    <h2>Step 6: Functional Impact</h2>
    <p class="form-hint">
        How much have these symptoms affected your day-to-day functioning?
    </p>

    {% set fi = functional_impact %}
    {% set domains = [
        ["work_impact",               "workImpact",              "Impact on work / study"],
        ["relationship_impact",       "relationshipImpact",      "Impact on relationships"],
        ["daily_activities_impact",   "dailyActivitiesImpact",   "Impact on daily activities"],
        ["sleep_impact",              "sleepImpact",             "Impact on sleep"]
    ] %}

    {% for row in domains %}
    {% set snake = row[0] %}{% set camel = row[1] %}{% set label = row[2] %}
    <div class="form-group">
        <label for="functional_impact_{{ snake }}">{{ label }}</label>
        <select id="functional_impact_{{ snake }}" name="functional_impact.{{ snake }}">
            <option value="" {% if fi[camel] == "" %}selected{% endif %}>&mdash;</option>
            <option value="none" {% if fi[camel] == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if fi[camel] == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if fi[camel] == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if fi[camel] == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="functional_impact_notes">Notes</label>
        <textarea id="functional_impact_notes" name="functional_impact.notes"
                  placeholder="Optional context about how the symptoms have affected you.">{{ functional_impact.notes }}</textarea>
    </div>
</div>
