<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Basic personal details for the assessment record.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_first_name">First Name</label>
            <input type="text" id="demographics_first_name" name="demographics.first_name"
                   value="{{ demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="demographics_last_name">Last Name</label>
            <input type="text" id="demographics_last_name" name="demographics.last_name"
                   value="{{ demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_date_of_birth">Date of Birth</label>
            <input type="date" id="demographics_date_of_birth" name="demographics.date_of_birth"
                   value="{{ demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="demographics_sex">Sex</label>
            <select id="demographics_sex" name="demographics.sex">
                <option value="" {% if demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if demographics.sex == "other" %}selected{% endif %}>Other</option>
                <option value="prefer-not-to-say" {% if demographics.sex == "prefer-not-to-say" %}selected{% endif %}>Prefer not to say</option>
            </select>
        </div>
        <div class="form-group">
            <label for="demographics_occupation">Occupation</label>
            <input type="text" id="demographics_occupation" name="demographics.occupation"
                   value="{{ demographics.occupation }}">
        </div>
    </div>
</div>
