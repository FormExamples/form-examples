{% extends "base.html.tera" %}

{% block title %}Psychology Assessment — Report{% endblock %}

{% block content %}
<div style="max-width:780px;margin:2rem auto;padding:1rem;">
  <h1>DASS-21 Report</h1>
  <p style="color:#555;">Report generated: {{ timestamp }}</p>
  <p style="color:#555;">Assessment ID: {{ id }}</p>

  <h2>Subscale Severities</h2>
  <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;">
    <thead>
      <tr style="background:#f4f4f4;">
        <th style="padding:0.6rem 1rem;text-align:left;">Subscale</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Raw (0–21)</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Scaled (0–42)</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Severity</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Answered</th>
      </tr>
    </thead>
    <tbody>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;">Depression</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ depression_view.raw }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;font-weight:bold;">{{ depression_view.scaled }}</td>
        <td style="padding:0.6rem 1rem;">{{ depression_view.severityLabel }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ depression_view.answered }} / 7</td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;">Anxiety</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ anxiety_view.raw }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;font-weight:bold;">{{ anxiety_view.scaled }}</td>
        <td style="padding:0.6rem 1rem;">{{ anxiety_view.severityLabel }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ anxiety_view.answered }} / 7</td>
      </tr>
      <tr>
        <td style="padding:0.6rem 1rem;">Stress</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ stress_view.raw }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;font-weight:bold;">{{ stress_view.scaled }}</td>
        <td style="padding:0.6rem 1rem;">{{ stress_view.severityLabel }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ stress_view.answered }} / 7</td>
      </tr>
    </tbody>
  </table>

  <h2>Flagged Issues</h2>
  {% if result.additionalFlags | length == 0 %}
    <p style="color:#080;">No additional clinician flags were raised.</p>
  {% else %}
    <ul style="padding-left:1.2rem;">
      {% for flag in result.additionalFlags %}
        <li style="margin-bottom:0.6rem;">
          <span style="display:inline-block;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;
            {% if flag.priority == 'urgent' %}background:#fee;color:#900;border:1px solid #f99;{% endif %}
            {% if flag.priority == 'high' %}background:#fef0e6;color:#a35100;border:1px solid #f5b97c;{% endif %}
            {% if flag.priority == 'medium' %}background:#fffbe6;color:#8a6d00;border:1px solid #f1d76b;{% endif %}
            {% if flag.priority == 'low' %}background:#eef;color:#226;border:1px solid #99d;{% endif %}">
            {{ flag.priority | upper }}
          </span>
          <strong>{{ flag.category }}:</strong> {{ flag.message }}
          <span style="color:#888;font-size:0.85rem;">({{ flag.id }})</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <div style="display:flex;gap:1rem;margin-top:1.5rem;">
    <a href="/assessment/{{ id }}" style="padding:0.5rem 1.2rem;border:1px solid #0070f3;color:#0070f3;border-radius:4px;text-decoration:none;">
      Edit Assessment
    </a>
    <a href="/" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">
      Home
    </a>
  </div>
</div>
{% endblock %}
