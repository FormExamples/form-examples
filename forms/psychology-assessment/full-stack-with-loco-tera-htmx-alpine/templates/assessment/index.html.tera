{% extends "base.html.tera" %}
{% import "_likert_row.html.tera" as ui %}

{% block title %}Psychology Assessment — DASS-21{% endblock %}

{% block content %}
<div style="max-width:840px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>Psychology Assessment (DASS-21)</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Demographics -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Demographics</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label>First Name</label>
          <input type="text" name="firstName" value="{{ data.demographics.firstName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Last Name</label>
          <input type="text" name="lastName" value="{{ data.demographics.lastName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:160px;">
          <label>Date of Birth</label>
          <input type="date" name="dateOfBirth" value="{{ data.demographics.dateOfBirth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Sex</label>
          {% set sex = data.demographics.sex %}
          <select name="sex" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="male" {% if sex == "male" %}selected{% endif %}>Male</option>
            <option value="female" {% if sex == "female" %}selected{% endif %}>Female</option>
            <option value="other" {% if sex == "other" %}selected{% endif %}>Other</option>
            <option value="prefer-not-to-say" {% if sex == "prefer-not-to-say" %}selected{% endif %}>Prefer not to say</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Occupation</label>
          <input type="text" name="occupation" value="{{ data.demographics.occupation }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 2 — Reason -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Reason for Assessment</h2>
      <div>
        <label>Reason</label>
        {% set reason = data.reasonForAssessment.reason %}
        <select name="reason" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="self-referral" {% if reason == "self-referral" %}selected{% endif %}>Self-referral</option>
          <option value="gp-referral" {% if reason == "gp-referral" %}selected{% endif %}>GP referral</option>
          <option value="employer-referral" {% if reason == "employer-referral" %}selected{% endif %}>Employer referral</option>
          <option value="follow-up" {% if reason == "follow-up" %}selected{% endif %}>Follow-up</option>
          <option value="screening" {% if reason == "screening" %}selected{% endif %}>Screening</option>
          <option value="other" {% if reason == "other" %}selected{% endif %}>Other</option>
        </select>
      </div>
      <div style="margin-top:1rem;">
        <label>Reason details</label>
        <textarea name="reasonDetails" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.reasonForAssessment.reasonDetails }}</textarea>
      </div>
      <div style="margin-top:1rem;">
        <label>Primary concern</label>
        <textarea name="primaryConcern" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.reasonForAssessment.primaryConcern }}</textarea>
      </div>
      <div style="margin-top:1rem;">
        <label>Symptom duration (weeks)</label>
        <input type="number" name="symptomDurationWeeks" min="0"
               value="{% if data.reasonForAssessment.symptomDurationWeeks %}{{ data.reasonForAssessment.symptomDurationWeeks }}{% endif %}"
               style="width:160px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 3 — DASS Depression -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: DASS — Depression</h2>
      <p style="color:#666;font-size:0.9rem;">Rate each statement 0 (did not apply) to 3 (most of the time) over the past week.</p>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:0.4rem 0.8rem;text-align:left;">Item</th>
            <th style="padding:0.4rem 0.4rem;">0<br><small>Did not apply</small></th>
            <th style="padding:0.4rem 0.4rem;">1<br><small>Sometimes</small></th>
            <th style="padding:0.4rem 0.4rem;">2<br><small>Often</small></th>
            <th style="padding:0.4rem 0.4rem;">3<br><small>Most</small></th>
          </tr>
        </thead>
        <tbody>
          {% set d = data.dassDepression %}
          {{ ui::row(name="item3CouldNotExperiencePositive", label="3. Could not experience any positive feeling", current=d.item3CouldNotExperiencePositive) }}
          {{ ui::row(name="item5DifficultInitiating", label="5. Difficult to work up the initiative to do things", current=d.item5DifficultInitiating) }}
          {{ ui::row(name="item10NothingToLookForwardTo", label="10. Felt I had nothing to look forward to", current=d.item10NothingToLookForwardTo) }}
          {{ ui::row(name="item13DownheartedBlue", label="13. Felt down-hearted and blue", current=d.item13DownheartedBlue) }}
          {{ ui::row(name="item16UnableToBecomeEnthusiastic", label="16. Unable to become enthusiastic about anything", current=d.item16UnableToBecomeEnthusiastic) }}
          {{ ui::row(name="item17NotWorthMuch", label="17. Felt I wasn't worth much as a person", current=d.item17NotWorthMuch) }}
          {{ ui::row(name="item21LifeMeaningless", label="21. Felt life was meaningless", current=d.item21LifeMeaningless) }}
        </tbody>
      </table>
    </div>

    <!-- Step 4 — DASS Anxiety -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: DASS — Anxiety</h2>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:0.4rem 0.8rem;text-align:left;">Item</th>
            <th style="padding:0.4rem 0.4rem;">0</th>
            <th style="padding:0.4rem 0.4rem;">1</th>
            <th style="padding:0.4rem 0.4rem;">2</th>
            <th style="padding:0.4rem 0.4rem;">3</th>
          </tr>
        </thead>
        <tbody>
          {% set a = data.dassAnxiety %}
          {{ ui::row(name="item2DrynessOfMouth", label="2. Aware of dryness of mouth", current=a.item2DrynessOfMouth) }}
          {{ ui::row(name="item4BreathingDifficulty", label="4. Experienced breathing difficulty", current=a.item4BreathingDifficulty) }}
          {{ ui::row(name="item7Trembling", label="7. Experienced trembling (e.g. hands)", current=a.item7Trembling) }}
          {{ ui::row(name="item9PanicWorry", label="9. Worried I might panic and make a fool of myself", current=a.item9PanicWorry) }}
          {{ ui::row(name="item15ClosedToPanic", label="15. Felt close to panic", current=a.item15ClosedToPanic) }}
          {{ ui::row(name="item19HeartActionAware", label="19. Aware of heart action without exertion", current=a.item19HeartActionAware) }}
          {{ ui::row(name="item20ScaredWithoutReason", label="20. Felt scared without any good reason", current=a.item20ScaredWithoutReason) }}
        </tbody>
      </table>
    </div>

    <!-- Step 5 — DASS Stress -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: DASS — Stress</h2>
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:0.4rem 0.8rem;text-align:left;">Item</th>
            <th style="padding:0.4rem 0.4rem;">0</th>
            <th style="padding:0.4rem 0.4rem;">1</th>
            <th style="padding:0.4rem 0.4rem;">2</th>
            <th style="padding:0.4rem 0.4rem;">3</th>
          </tr>
        </thead>
        <tbody>
          {% set s = data.dassStress %}
          {{ ui::row(name="item1HardToWindDown", label="1. Found it hard to wind down", current=s.item1HardToWindDown) }}
          {{ ui::row(name="item6OverReact", label="6. Tended to over-react to situations", current=s.item6OverReact) }}
          {{ ui::row(name="item8NervousEnergy", label="8. Felt I was using a lot of nervous energy", current=s.item8NervousEnergy) }}
          {{ ui::row(name="item11AgitatedEasily", label="11. Found myself getting agitated", current=s.item11AgitatedEasily) }}
          {{ ui::row(name="item12DifficultToRelax", label="12. Found it difficult to relax", current=s.item12DifficultToRelax) }}
          {{ ui::row(name="item14Intolerant", label="14. Intolerant of anything that kept me from getting on", current=s.item14Intolerant) }}
          {{ ui::row(name="item18TouchyEasily", label="18. Felt that I was rather touchy", current=s.item18TouchyEasily) }}
        </tbody>
      </table>
    </div>

    <!-- Step 6 — Functional Impact -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Functional Impact</h2>
      <p style="color:#666;font-size:0.9rem;">Rate the impact of symptoms on each life domain.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label>Work</label>
          {% set v = data.functionalImpact.workImpact %}
          <select name="workImpact" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="none" {% if v == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if v == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if v == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if v == "severe" %}selected{% endif %}>Severe</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Relationships</label>
          {% set v = data.functionalImpact.relationshipImpact %}
          <select name="relationshipImpact" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="none" {% if v == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if v == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if v == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if v == "severe" %}selected{% endif %}>Severe</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Daily activities</label>
          {% set v = data.functionalImpact.dailyActivitiesImpact %}
          <select name="dailyActivitiesImpact" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="none" {% if v == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if v == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if v == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if v == "severe" %}selected{% endif %}>Severe</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Sleep</label>
          {% set v = data.functionalImpact.sleepImpact %}
          <select name="sleepImpact" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="none" {% if v == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if v == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if v == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if v == "severe" %}selected{% endif %}>Severe</option>
          </select>
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Notes</label>
        <textarea name="notes" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.functionalImpact.notes }}</textarea>
      </div>
    </div>

    <!-- Step 7 — Risk Screen -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Risk Screen</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label>Have you had thoughts of suicide?</label>
          {% set v = data.riskScreen.suicidalIdeation %}
          <select name="suicidalIdeation" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>If yes, please give details</label>
          <textarea name="suicidalIdeationDetails" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.riskScreen.suicidalIdeationDetails }}</textarea>
        </div>
        <div>
          <label>Self-harm in the past 12 months?</label>
          {% set v = data.riskScreen.selfHarm %}
          <select name="selfHarm" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Thoughts of harming others?</label>
          {% set v = data.riskScreen.harmToOthers %}
          <select name="harmToOthers" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Previous psychiatric emergency?</label>
          {% set v = data.riskScreen.psychiatricEmergencyHistory %}
          <select name="psychiatricEmergencyHistory" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Do you have a current safety plan?</label>
          {% set v = data.riskScreen.hasSafetyPlan %}
          <select name="hasSafetyPlan" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Step 8 — Support and History -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: Support and History</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label>Previous mental health care?</label>
          {% set v = data.supportAndHistory.previousMentalHealthCare %}
          <select name="previousMentalHealthCare" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Details of previous care</label>
          <textarea name="previousMentalHealthDetails" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.supportAndHistory.previousMentalHealthDetails }}</textarea>
        </div>
        <div>
          <label>Currently in treatment?</label>
          {% set v = data.supportAndHistory.currentlyInTreatment %}
          <select name="currentlyInTreatment" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Current treatment details</label>
          <textarea name="currentTreatmentDetails" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.supportAndHistory.currentTreatmentDetails }}</textarea>
        </div>
        <div>
          <label>Current medications</label>
          <textarea name="currentMedications" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.supportAndHistory.currentMedications }}</textarea>
        </div>
        <div>
          <label>Family history of mental health issues?</label>
          {% set v = data.supportAndHistory.familyMentalHealthHistory %}
          <select name="familyMentalHealthHistory" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div>
          <label>Family history details</label>
          <textarea name="familyMentalHealthDetails" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.supportAndHistory.familyMentalHealthDetails }}</textarea>
        </div>
        <div>
          <label>Social support</label>
          {% set ss = data.supportAndHistory.socialSupport %}
          <select name="socialSupport" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="strong" {% if ss == "strong" %}selected{% endif %}>Strong</option>
            <option value="adequate" {% if ss == "adequate" %}selected{% endif %}>Adequate</option>
            <option value="limited" {% if ss == "limited" %}selected{% endif %}>Limited</option>
            <option value="isolated" {% if ss == "isolated" %}selected{% endif %}>Isolated</option>
          </select>
        </div>
        <div>
          <label>Substance use concerns?</label>
          {% set v = data.supportAndHistory.substanceUseConcern %}
          <select name="substanceUseConcern" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>
      <p style="color:#666;font-size:0.9rem;margin-top:1rem;">Assessment ID: {{ id }}</p>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;margin-top:1.5rem;">
      <button type="button" @click="if(step > 1) step--" :disabled="step === 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        &laquo; Previous
      </button>
      <button type="button" @click="if(step < totalSteps) step++" x-show="step < totalSteps"
              style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Next &raquo;
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.4rem;background:#28a745;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">
        Submit
      </button>
    </div>
  </form>
</div>
{% endblock %}
