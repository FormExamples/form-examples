{% extends "base.html.tera" %}

{% block title %}Psychology Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Psychology Assessment</h1>
        <p class="landing-description">
            General psychological screening using the <strong>DASS-21</strong>
            (Depression Anxiety Stress Scales &mdash; 21 item) instrument.
            Collects self-reported data on depression, anxiety, and stress
            symptoms, computes severity categories per subscale, and flags
            safety-critical items (e.g. suicidal ideation) for clinician review.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>DASS-21 Scoring</h3>
                <p>21 items across three subscales (Depression, Anxiety, Stress); doubled raw aligned with DASS-42 norms.</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Urgent escalation for suicidal ideation and harm-to-others reports; high-priority flags for severe scores.</p>
            </div>
            <div class="feature">
                <h3>Eight Steps</h3>
                <p>Demographics, reason, three DASS subscales, functional impact, risk screen, support and history.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
