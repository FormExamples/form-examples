#!/bin/sh
set -euf

form_kebab_case=blood-test-request
form_snake_case=blood_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold blood_test_request \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    full_blood_count:bool! \
    urea_electrolytes:bool! \
    liver_function:bool! \
    thyroid_function:bool! \
    hba1c:bool! \
    lipid_profile:bool! \
    c_reactive_protein:bool! \
    coagulation_screen:bool! \
    bone_profile:bool! \
    ferritin_iron:bool! \
    vitamin_b12_folate:bool! \
    vitamin_d:bool! \
    hba1c_monitoring:bool! \
    glucose:bool! \
    inr:bool! \
    blood_culture:bool! \
    group_and_save:bool! \
    crossmatch:bool! \
    troponin:bool! \
    d_dimer:bool! \
    amylase_lipase:bool! \
    primary_indication:string! \
    clinical_details:string! \
    relevant_medications:string! \
    fasting_required:bool! \
    fasting_status:string! \
    specimen_collected:string! \
    collection_datetime:tstz \
    known_blood_borne_virus:bool! \
    difficult_venous_access:bool! \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    notes:string! \
    --api

cargo loco generate scaffold blood_test_request_grade \
    deleted_at:tstz \
    blood_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    preanalytical_band:string! \
    fasting_violation:bool! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold blood_test_request_grade_rule \
    deleted_at:tstz \
    blood_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold blood_test_request_grade_flag \
    deleted_at:tstz \
    blood_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
