#!/bin/sh
set -euf

form_kebab_case=abdominal-aortic-aneurysm-screening
form_snake_case=abdominal_aortic_aneurysm_screening

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold abdominal_aortic_aneurysm_screening \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    technician_name:text! \
    technician_role:string! \
    clinic_site:text! \
    scanned_at:tstz \
    device_identifier:text! \
    patient_identifier:string! \
    age:int \
    sex:string! \
    eligibility_route:string! \
    scan_type:string! \
    consent_given:string! \
    leaflet_provided:string! \
    consent_note:text! \
    aorta_visualised:string! \
    max_aortic_diameter_cm:double \
    prior_max_diameter_cm:double \
    prior_scan_date:date \
    symptomatic:string! \
    incidental_findings:text! \
    result_note:text! \
    --api

cargo loco generate scaffold abdominal_aortic_aneurysm_screening_grade \
    deleted_at:tstz \
    abdominal_aortic_aneurysm_screening:references \
    category:string! \
    surveillance_band:string! \
    recommended_action:text! \
    growth_cm:double \
    graded_at:tstz! \
    --api

cargo loco generate scaffold abdominal_aortic_aneurysm_screening_grade_rule \
    deleted_at:tstz \
    abdominal_aortic_aneurysm_screening_grade:references \
    rule_id:string! \
    stage:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold abdominal_aortic_aneurysm_screening_grade_flag \
    deleted_at:tstz \
    abdominal_aortic_aneurysm_screening_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
