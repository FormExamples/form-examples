#!/bin/sh
set -euf

form_kebab_case=mental-state-examination
form_snake_case=mental_state_examination

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold mental_state_examination \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:text! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    assessment_reason:text! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    appearance_grooming:string! \
    appearance_eye_contact:string! \
    appearance_rapport:string! \
    appearance_psychomotor:string! \
    appearance_abnormal_movements:text! \
    appearance_notes:text! \
    speech_rate:string! \
    speech_volume:string! \
    speech_quantity:string! \
    speech_fluency:string! \
    speech_notes:text! \
    mood_subjective:text! \
    mood_descriptor:string! \
    affect_range:string! \
    affect_congruence:string! \
    affect_reactivity:string! \
    emotion_notes:text! \
    hallucinations_present:string! \
    command_hallucinations:string! \
    illusions:string! \
    depersonalisation:string! \
    derealisation:string! \
    perception_notes:text! \
    thought_form:string! \
    delusions:string! \
    obsessions:string! \
    suicidal_ideation:string! \
    homicidal_ideation:string! \
    self_harm_thoughts:string! \
    thought_notes:text! \
    insight_level:string! \
    treatment_understanding:string! \
    judgement:string! \
    insight_notes:text! \
    orientation:string! \
    attention:string! \
    memory:string! \
    cognitive_impression:string! \
    cognition_notes:text! \
    clinical_formulation:text! \
    --api

cargo loco generate scaffold mental_state_examination_grade \
    deleted_at:tstz \
    mental_state_examination:references \
    status:string! \
    risk_level:string! \
    completeness_percent:int \
    appearance_behaviour_documented:string! \
    speech_documented:string! \
    emotion_documented:string! \
    perception_documented:string! \
    thought_documented:string! \
    insight_documented:string! \
    cognition_documented:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold mental_state_examination_grade_rule \
    deleted_at:tstz \
    mental_state_examination_grade:references \
    rule_id:string! \
    domain:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold mental_state_examination_grade_flag \
    deleted_at:tstz \
    mental_state_examination_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
