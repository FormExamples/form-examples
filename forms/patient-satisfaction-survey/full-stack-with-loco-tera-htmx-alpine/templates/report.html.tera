{% extends "base.html.tera" %}

{% block title %}Survey Report - {{ satisfaction_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Patient Satisfaction Survey &mdash; Report</h1>
    <div class="checklist-badge {{ satisfaction_class }}">{{ satisfaction_label }}</div>
    <div class="checklist-label">Overall composite score: {{ normalized_score }}/100</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Survey ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Visit Summary -->
<div class="card">
    <h2>Visit Summary</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Age range:</strong> {{ data.demographics.ageRange }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}
        </div>
        <div>
            <strong>Visit date:</strong> {{ data.visitDetails.visitDate }}<br>
            <strong>Visit type:</strong> {{ data.visitDetails.visitType }}<br>
            <strong>Site:</strong> {{ data.visitDetails.hospitalSite }}<br>
            <strong>Department:</strong> {{ data.visitDetails.department }}<br>
            <strong>Referral:</strong> {{ data.visitDetails.referralSource }}
        </div>
    </div>
</div>

<!-- Per-Domain Scores -->
<div class="card">
    <h2>Domain Scores</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Domain</th>
                <th>Normalized Score (0&ndash;100)</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Access &amp; Waiting Times</td><td>{% if domain_scores.access %}{{ domain_scores.access }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Communication &amp; Information</td><td>{% if domain_scores.communication %}{{ domain_scores.communication }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Clinical Care Quality</td><td>{% if domain_scores.clinicalCare %}{{ domain_scores.clinicalCare }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Staff Attitude</td><td>{% if domain_scores.staff %}{{ domain_scores.staff }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Environment &amp; Facilities</td><td>{% if domain_scores.environment %}{{ domain_scores.environment }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Discharge &amp; Follow-up</td><td>{% if domain_scores.discharge %}{{ domain_scores.discharge }}{% else %}&mdash;{% endif %}</td></tr>
            <tr><td>Overall Experience</td><td>{% if domain_scores.overall %}{{ domain_scores.overall }}{% else %}&mdash;{% endif %}</td></tr>
        </tbody>
    </table>
</div>

<!-- Flagged Issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Domain</th>
                <th>Description</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.domain }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge severity-{{ rule.severity }}">{{ rule.severity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Comments -->
{% if data.commentsSuggestions.whatWentWell or data.commentsSuggestions.whatCouldImprove or data.commentsSuggestions.additionalComments %}
<div class="card">
    <h2>Patient Comments</h2>
    {% if data.commentsSuggestions.whatWentWell %}<p><strong>What went well:</strong> {{ data.commentsSuggestions.whatWentWell }}</p>{% endif %}
    {% if data.commentsSuggestions.whatCouldImprove %}<p><strong>What could improve:</strong> {{ data.commentsSuggestions.whatCouldImprove }}</p>{% endif %}
    {% if data.commentsSuggestions.specificStaffPraise %}<p><strong>Specific staff praise:</strong> {{ data.commentsSuggestions.specificStaffPraise }}</p>{% endif %}
    {% if data.commentsSuggestions.additionalComments %}<p><strong>Additional comments:</strong> {{ data.commentsSuggestions.additionalComments }}</p>{% endif %}
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Survey</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
