<div class="card">
    <h2>Step 2: Visit Details</h2>
    <p class="form-hint">Where, when, and how you accessed care.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="visit_date">Visit Date</label>
            <input type="date" id="visit_date" name="visit_details.visit_date"
                   value="{{ visit_details.visitDate }}">
        </div>
        <div class="form-group">
            <label for="visit_type">Visit Type</label>
            <select id="visit_type" name="visit_details.visit_type">
                <option value="" {% if visit_details.visitType == "" %}selected{% endif %}>&mdash;</option>
                <option value="outpatient" {% if visit_details.visitType == "outpatient" %}selected{% endif %}>Outpatient</option>
                <option value="inpatient" {% if visit_details.visitType == "inpatient" %}selected{% endif %}>Inpatient</option>
                <option value="day-case" {% if visit_details.visitType == "day-case" %}selected{% endif %}>Day case</option>
                <option value="emergency" {% if visit_details.visitType == "emergency" %}selected{% endif %}>Emergency</option>
                <option value="telehealth" {% if visit_details.visitType == "telehealth" %}selected{% endif %}>Telehealth</option>
                <option value="home-visit" {% if visit_details.visitType == "home-visit" %}selected{% endif %}>Home visit</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="department">Department</label>
            <input type="text" id="department" name="visit_details.department"
                   value="{{ visit_details.department }}">
        </div>
        <div class="form-group">
            <label for="hospital_site">Hospital / Site</label>
            <input type="text" id="hospital_site" name="visit_details.hospital_site"
                   value="{{ visit_details.hospitalSite }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="length_of_stay_days">Length of Stay (days)</label>
            <input type="number" min="0" id="length_of_stay_days" name="visit_details.length_of_stay_days"
                   value="{{ visit_details.lengthOfStayDays }}">
        </div>
        <div class="form-group">
            <label for="referral_source">Referral Source</label>
            <select id="referral_source" name="visit_details.referral_source">
                <option value="" {% if visit_details.referralSource == "" %}selected{% endif %}>&mdash;</option>
                <option value="gp" {% if visit_details.referralSource == "gp" %}selected{% endif %}>GP</option>
                <option value="self" {% if visit_details.referralSource == "self" %}selected{% endif %}>Self-referral</option>
                <option value="emergency" {% if visit_details.referralSource == "emergency" %}selected{% endif %}>Emergency</option>
                <option value="another-hospital" {% if visit_details.referralSource == "another-hospital" %}selected{% endif %}>Another hospital</option>
                <option value="specialist" {% if visit_details.referralSource == "specialist" %}selected{% endif %}>Specialist</option>
            </select>
        </div>
        <div class="form-group">
            <label for="is_first_visit">First visit to this service?</label>
            <select id="is_first_visit" name="visit_details.is_first_visit">
                <option value="" {% if visit_details.isFirstVisit == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if visit_details.isFirstVisit == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if visit_details.isFirstVisit == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
