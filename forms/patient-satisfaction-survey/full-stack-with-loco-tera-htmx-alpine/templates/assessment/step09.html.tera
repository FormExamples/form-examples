{% import "assessment/_likert.html.tera" as macros %}
<div class="card">
    <h2>Step 9: Overall Experience</h2>
    <p class="form-hint">Your overall view of this visit.</p>

    <div class="form-row">
        {{ macros::likert(name="overall_experience.overall_satisfaction", label="Overall satisfaction", value=overall_experience.overallSatisfaction) }}
        {{ macros::likert(name="overall_experience.would_recommend", label="Would recommend service", value=overall_experience.wouldRecommend) }}
    </div>
    <div class="form-row">
        {{ macros::likert(name="overall_experience.met_expectations", label="Met expectations", value=overall_experience.metExpectations) }}
        {{ macros::likert(name="overall_experience.felt_safe", label="Felt safe", value=overall_experience.feltSafe) }}
    </div>
    <div class="form-row">
        {{ macros::likert(name="overall_experience.would_return", label="Would return for future care", value=overall_experience.wouldReturn) }}
        <div class="form-group">
            <label for="nhs_rating">NHS rating (0&ndash;10)</label>
            <input type="number" min="0" max="10" id="nhs_rating" name="overall_experience.nhs_rating"
                   value="{{ overall_experience.nhsRating }}">
        </div>
    </div>
</div>
