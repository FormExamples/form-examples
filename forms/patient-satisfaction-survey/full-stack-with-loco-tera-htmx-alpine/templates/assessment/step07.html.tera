{% import "assessment/_likert.html.tera" as macros %}
<div class="card">
    <h2>Step 7: Environment &amp; Facilities</h2>
    <p class="form-hint">Rate the physical environment.</p>

    <div class="form-row">
        {{ macros::likert(name="environment_facilities.cleanliness", label="Cleanliness", value=environment_facilities.cleanliness) }}
        {{ macros::likert(name="environment_facilities.comfort", label="Comfort", value=environment_facilities.comfort) }}
    </div>
    <div class="form-row">
        {{ macros::likert(name="environment_facilities.noise_levels", label="Noise levels", value=environment_facilities.noiseLevels) }}
        {{ macros::likert(name="environment_facilities.food_quality", label="Food quality", value=environment_facilities.foodQuality) }}
    </div>
    <div class="form-row">
        {{ macros::likert(name="environment_facilities.toilet_facilities", label="Toilet facilities", value=environment_facilities.toiletFacilities) }}
        {{ macros::likert(name="environment_facilities.temperature_comfort", label="Temperature comfort", value=environment_facilities.temperatureComfort) }}
    </div>
</div>
