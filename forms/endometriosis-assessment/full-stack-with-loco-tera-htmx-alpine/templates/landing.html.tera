{% extends "base.html.tera" %}

{% block title %}Endometriosis Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Endometriosis Assessment</h1>
        <p class="landing-description">
            Revised ASRM (American Society for Reproductive Medicine) staging plus
            EHP-30 (Endometriosis Health Profile) quality-of-life scoring, with
            comprehensive pelvic-pain profiling and fertility assessment. Patient-
            reported questionnaire for adults with suspected or confirmed endometriosis.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>ASRM Staging</h3>
                <p>Stage I (Minimal) through Stage IV (Severe) with points-based scoring</p>
            </div>
            <div class="feature">
                <h3>EHP-30 Quality of Life</h3>
                <p>Pain, control, emotional well-being, social support, and self-image domains</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for bowel/urinary obstruction, infertility, severe pain, and opioid use</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
