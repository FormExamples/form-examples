{% extends "base.html.tera" %}

{% block title %}Endometriosis Assessment - Questionnaire{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>Endometriosis Assessment</h1>
    <p class="form-hint">
        Please answer the questions below about your menstrual history,
        pelvic pain, gastrointestinal and urinary symptoms, fertility,
        previous treatments, surgical history, quality of life, and
        treatment planning. The form is one continuous page &mdash;
        scroll through and answer what you can.
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}
    {% include "assessment/step04.html.tera" %}
    {% include "assessment/step05.html.tera" %}
    {% include "assessment/step06.html.tera" %}
    {% include "assessment/step07.html.tera" %}
    {% include "assessment/step08.html.tera" %}
    {% include "assessment/step09.html.tera" %}
    {% include "assessment/step10.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Submit and view report</button>
    </div>
</form>
{% endblock %}
