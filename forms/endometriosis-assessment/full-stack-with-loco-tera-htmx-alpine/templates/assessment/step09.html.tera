<div class="card">
    <h2>Step 9: Quality of Life Impact (EHP-30)</h2>
    <p class="form-hint">Domain scores 0-100 (higher = worse impact).</p>

    <div class="form-row">
        <div class="form-group">
            <label for="pain_domain_score">Pain (0-100)</label>
            <input type="number" min="0" max="100" id="pain_domain_score" name="quality_of_life.pain_domain_score"
                   value="{{ quality_of_life.painDomainScore }}">
        </div>
        <div class="form-group">
            <label for="control_powerlessness_score">Control &amp; powerlessness</label>
            <input type="number" min="0" max="100" id="control_powerlessness_score" name="quality_of_life.control_powerlessness_score"
                   value="{{ quality_of_life.controlPowerlessnessScore }}">
        </div>
        <div class="form-group">
            <label for="emotional_wellbeing_score">Emotional well-being</label>
            <input type="number" min="0" max="100" id="emotional_wellbeing_score" name="quality_of_life.emotional_wellbeing_score"
                   value="{{ quality_of_life.emotionalWellbeingScore }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="social_support_score">Social support</label>
            <input type="number" min="0" max="100" id="social_support_score" name="quality_of_life.social_support_score"
                   value="{{ quality_of_life.socialSupportScore }}">
        </div>
        <div class="form-group">
            <label for="self_image_score">Self-image</label>
            <input type="number" min="0" max="100" id="self_image_score" name="quality_of_life.self_image_score"
                   value="{{ quality_of_life.selfImageScore }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="work_impact">Work impact</label>
            <select id="work_impact" name="quality_of_life.work_impact">
                <option value="" {% if quality_of_life.workImpact == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if quality_of_life.workImpact == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if quality_of_life.workImpact == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if quality_of_life.workImpact == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if quality_of_life.workImpact == "severe" %}selected{% endif %}>Severe</option>
                <option value="unable-to-work" {% if quality_of_life.workImpact == "unable-to-work" %}selected{% endif %}>Unable to work</option>
            </select>
        </div>
        <div class="form-group">
            <label for="mental_health_impact">Mental health impact</label>
            <select id="mental_health_impact" name="quality_of_life.mental_health_impact">
                <option value="" {% if quality_of_life.mentalHealthImpact == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if quality_of_life.mentalHealthImpact == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if quality_of_life.mentalHealthImpact == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if quality_of_life.mentalHealthImpact == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if quality_of_life.mentalHealthImpact == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sleep_impact">Sleep impact</label>
            <select id="sleep_impact" name="quality_of_life.sleep_impact">
                <option value="" {% if quality_of_life.sleepImpact == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if quality_of_life.sleepImpact == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if quality_of_life.sleepImpact == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if quality_of_life.sleepImpact == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if quality_of_life.sleepImpact == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="qol_notes">Notes</label>
        <textarea id="qol_notes" name="quality_of_life.qol_notes">{{ quality_of_life.qolNotes }}</textarea>
    </div>
</div>
