<div class="card">
    <h2>Step 8: Surgical History</h2>
    <p class="form-hint">Past laparoscopies and confirmed endometriosis findings.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_laparoscopy">Previous laparoscopy?</label>
            <select id="previous_laparoscopy" name="surgical_history.previous_laparoscopy">
                <option value="" {% if surgical_history.previousLaparoscopy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if surgical_history.previousLaparoscopy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if surgical_history.previousLaparoscopy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="number_of_laparoscopies">Number of laparoscopies</label>
            <input type="number" id="number_of_laparoscopies" name="surgical_history.number_of_laparoscopies"
                   value="{{ surgical_history.numberOfLaparoscopies }}">
        </div>
        <div class="form-group">
            <label for="asrm_stage_at_surgery">ASRM stage at surgery</label>
            <select id="asrm_stage_at_surgery" name="surgical_history.asrm_stage_at_surgery">
                <option value="" {% if surgical_history.asrmStageAtSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="I" {% if surgical_history.asrmStageAtSurgery == "I" %}selected{% endif %}>Stage I</option>
                <option value="II" {% if surgical_history.asrmStageAtSurgery == "II" %}selected{% endif %}>Stage II</option>
                <option value="III" {% if surgical_history.asrmStageAtSurgery == "III" %}selected{% endif %}>Stage III</option>
                <option value="IV" {% if surgical_history.asrmStageAtSurgery == "IV" %}selected{% endif %}>Stage IV</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="endometrioma_drained">Endometrioma documented?</label>
            <select id="endometrioma_drained" name="surgical_history.endometrioma_drained">
                <option value="" {% if surgical_history.endometriomaDrained == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if surgical_history.endometriomaDrained == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if surgical_history.endometriomaDrained == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="bowel_surgery">Previous bowel surgery for endometriosis?</label>
            <select id="bowel_surgery" name="surgical_history.bowel_surgery">
                <option value="" {% if surgical_history.bowelSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if surgical_history.bowelSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if surgical_history.bowelSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="bladder_surgery">Previous bladder surgery for endometriosis?</label>
            <select id="bladder_surgery" name="surgical_history.bladder_surgery">
                <option value="" {% if surgical_history.bladderSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if surgical_history.bladderSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if surgical_history.bladderSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="surgical_notes">Notes</label>
        <textarea id="surgical_notes" name="surgical_history.surgical_notes">{{ surgical_history.surgicalNotes }}</textarea>
    </div>
</div>
