<div class="card">
    <h2>Step 4: Gastrointestinal Symptoms</h2>
    <p class="form-hint">Bowel-related symptoms that may indicate bowel endometriosis.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="bowel_obstruction_symptoms">Bowel obstruction symptoms?</label>
            <select id="bowel_obstruction_symptoms" name="gastrointestinal_symptoms.bowel_obstruction_symptoms">
                <option value="" {% if gastrointestinal_symptoms.bowelObstructionSymptoms == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.bowelObstructionSymptoms == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.bowelObstructionSymptoms == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="rectal_bleeding">Rectal bleeding</label>
            <select id="rectal_bleeding" name="gastrointestinal_symptoms.rectal_bleeding">
                <option value="" {% if gastrointestinal_symptoms.rectalBleeding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.rectalBleeding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.rectalBleeding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="rectal_bleeding_cyclical">Cyclical rectal bleeding?</label>
            <select id="rectal_bleeding_cyclical" name="gastrointestinal_symptoms.rectal_bleeding_cyclical">
                <option value="" {% if gastrointestinal_symptoms.rectalBleedingCyclical == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.rectalBleedingCyclical == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.rectalBleedingCyclical == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="bloating">Bloating</label>
            <select id="bloating" name="gastrointestinal_symptoms.bloating">
                <option value="" {% if gastrointestinal_symptoms.bloating == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.bloating == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.bloating == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="bloating_cyclical">Cyclical bloating?</label>
            <select id="bloating_cyclical" name="gastrointestinal_symptoms.bloating_cyclical">
                <option value="" {% if gastrointestinal_symptoms.bloatingCyclical == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.bloatingCyclical == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.bloatingCyclical == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="alternating_bowel_habit">Alternating bowel habit?</label>
            <select id="alternating_bowel_habit" name="gastrointestinal_symptoms.alternating_bowel_habit">
                <option value="" {% if gastrointestinal_symptoms.alternatingBowelHabit == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if gastrointestinal_symptoms.alternatingBowelHabit == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if gastrointestinal_symptoms.alternatingBowelHabit == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="gi_notes">Notes</label>
        <textarea id="gi_notes" name="gastrointestinal_symptoms.gi_notes">{{ gastrointestinal_symptoms.giNotes }}</textarea>
    </div>
</div>
