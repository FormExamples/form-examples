<div class="card">
    <h2>Step 7: Previous Treatments</h2>
    <p class="form-hint">Medications and treatments tried so far.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="combined_pill_tried">Combined pill tried?</label>
            <select id="combined_pill_tried" name="previous_treatments.combined_pill_tried">
                <option value="" {% if previous_treatments.combinedPillTried == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatments.combinedPillTried == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatments.combinedPillTried == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="combined_pill_effective">Combined pill effective?</label>
            <select id="combined_pill_effective" name="previous_treatments.combined_pill_effective">
                <option value="" {% if previous_treatments.combinedPillEffective == "" %}selected{% endif %}>&mdash;</option>
                <option value="effective" {% if previous_treatments.combinedPillEffective == "effective" %}selected{% endif %}>Effective</option>
                <option value="partially-effective" {% if previous_treatments.combinedPillEffective == "partially-effective" %}selected{% endif %}>Partially effective</option>
                <option value="ineffective" {% if previous_treatments.combinedPillEffective == "ineffective" %}selected{% endif %}>Ineffective</option>
            </select>
        </div>
        <div class="form-group">
            <label for="progesterone_tried">Progesterone tried?</label>
            <select id="progesterone_tried" name="previous_treatments.progesterone_tried">
                <option value="" {% if previous_treatments.progesteroneTried == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatments.progesteroneTried == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatments.progesteroneTried == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="gnrh_agonist_tried">GnRH agonist tried?</label>
            <select id="gnrh_agonist_tried" name="previous_treatments.gnrh_agonist_tried">
                <option value="" {% if previous_treatments.gnrhAgonistTried == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatments.gnrhAgonistTried == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatments.gnrhAgonistTried == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="mirena_ius_tried">Mirena IUS tried?</label>
            <select id="mirena_ius_tried" name="previous_treatments.mirena_ius_tried">
                <option value="" {% if previous_treatments.mirenaIusTried == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatments.mirenaIusTried == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatments.mirenaIusTried == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="opioids_current">Current opioid use?</label>
            <select id="opioids_current" name="previous_treatments.opioids_current">
                <option value="" {% if previous_treatments.opioidsCurrent == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatments.opioidsCurrent == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatments.opioidsCurrent == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="treatment_notes">Notes</label>
        <textarea id="treatment_notes" name="previous_treatments.treatment_notes">{{ previous_treatments.treatmentNotes }}</textarea>
    </div>
</div>
