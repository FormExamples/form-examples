<div class="card">
    <h2>Step 2: Menstrual History</h2>
    <p class="form-hint">Tell us about your menstrual cycles.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="age_at_menarche">Age at first period</label>
            <input type="number" id="age_at_menarche" name="menstrual_history.age_at_menarche"
                   value="{{ menstrual_history.ageAtMenarche }}">
        </div>
        <div class="form-group">
            <label for="cycle_regularity">Cycle regularity</label>
            <select id="cycle_regularity" name="menstrual_history.cycle_regularity">
                <option value="" {% if menstrual_history.cycleRegularity == "" %}selected{% endif %}>&mdash;</option>
                <option value="regular" {% if menstrual_history.cycleRegularity == "regular" %}selected{% endif %}>Regular</option>
                <option value="irregular" {% if menstrual_history.cycleRegularity == "irregular" %}selected{% endif %}>Irregular</option>
                <option value="absent" {% if menstrual_history.cycleRegularity == "absent" %}selected{% endif %}>Absent</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="flow_heaviness">Flow heaviness</label>
            <select id="flow_heaviness" name="menstrual_history.flow_heaviness">
                <option value="" {% if menstrual_history.flowHeaviness == "" %}selected{% endif %}>&mdash;</option>
                <option value="light" {% if menstrual_history.flowHeaviness == "light" %}selected{% endif %}>Light</option>
                <option value="normal" {% if menstrual_history.flowHeaviness == "normal" %}selected{% endif %}>Normal</option>
                <option value="heavy" {% if menstrual_history.flowHeaviness == "heavy" %}selected{% endif %}>Heavy</option>
                <option value="very-heavy" {% if menstrual_history.flowHeaviness == "very-heavy" %}selected{% endif %}>Very heavy</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dysmenorrhoea_severity">Period-pain severity</label>
            <select id="dysmenorrhoea_severity" name="menstrual_history.dysmenorrhoea_severity">
                <option value="" {% if menstrual_history.dysmenorrhoeaSeverity == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if menstrual_history.dysmenorrhoeaSeverity == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if menstrual_history.dysmenorrhoeaSeverity == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if menstrual_history.dysmenorrhoeaSeverity == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if menstrual_history.dysmenorrhoeaSeverity == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="days_off_work_per_cycle">Days off work per cycle</label>
            <input type="number" id="days_off_work_per_cycle" name="menstrual_history.days_off_work_per_cycle"
                   value="{{ menstrual_history.daysOffWorkPerCycle }}">
        </div>
    </div>

    <div class="form-group">
        <label for="menstrual_notes">Notes</label>
        <textarea id="menstrual_notes" name="menstrual_history.menstrual_notes">{{ menstrual_history.menstrualNotes }}</textarea>
    </div>
</div>
