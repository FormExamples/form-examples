<div class="card">
    <h2>Step 3: Pain Assessment</h2>
    <p class="form-hint">Pelvic pain profiling.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="has_pelvic_pain">Pelvic pain present?</label>
            <select id="has_pelvic_pain" name="pain_assessment.has_pelvic_pain">
                <option value="" {% if pain_assessment.hasPelvicPain == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if pain_assessment.hasPelvicPain == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if pain_assessment.hasPelvicPain == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pelvic_pain_severity">Pelvic pain severity (VAS 0-10)</label>
            <input type="number" min="0" max="10" id="pelvic_pain_severity" name="pain_assessment.pelvic_pain_severity"
                   value="{{ pain_assessment.pelvicPainSeverity }}">
        </div>
        <div class="form-group">
            <label for="pelvic_pain_timing">Pain timing</label>
            <select id="pelvic_pain_timing" name="pain_assessment.pelvic_pain_timing">
                <option value="" {% if pain_assessment.pelvicPainTiming == "" %}selected{% endif %}>&mdash;</option>
                <option value="cyclical" {% if pain_assessment.pelvicPainTiming == "cyclical" %}selected{% endif %}>Cyclical</option>
                <option value="constant" {% if pain_assessment.pelvicPainTiming == "constant" %}selected{% endif %}>Constant</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dyspareunia">Painful intercourse</label>
            <select id="dyspareunia" name="pain_assessment.dyspareunia">
                <option value="" {% if pain_assessment.dyspareunia == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if pain_assessment.dyspareunia == "none" %}selected{% endif %}>None</option>
                <option value="superficial" {% if pain_assessment.dyspareunia == "superficial" %}selected{% endif %}>Superficial</option>
                <option value="deep" {% if pain_assessment.dyspareunia == "deep" %}selected{% endif %}>Deep</option>
                <option value="both" {% if pain_assessment.dyspareunia == "both" %}selected{% endif %}>Both</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dyschezia">Painful defecation (dyschezia)</label>
            <select id="dyschezia" name="pain_assessment.dyschezia">
                <option value="" {% if pain_assessment.dyschezia == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if pain_assessment.dyschezia == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if pain_assessment.dyschezia == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dyschezia_cyclical">Cyclical dyschezia?</label>
            <select id="dyschezia_cyclical" name="pain_assessment.dyschezia_cyclical">
                <option value="" {% if pain_assessment.dyscheziaCyclical == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if pain_assessment.dyscheziaCyclical == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if pain_assessment.dyscheziaCyclical == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="pain_notes">Notes</label>
        <textarea id="pain_notes" name="pain_assessment.pain_notes">{{ pain_assessment.painNotes }}</textarea>
    </div>
</div>
