#!/bin/sh
set -euf

form_kebab_case=knee-replacement-surgery-evaluation
form_snake_case=knee_replacement_surgery_evaluation

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    preferred_language:text \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    employer:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold knee_replacement_surgery_evaluation \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    assessment_date:date \
    assessment_time:string \
    knee_side:string! \
    symptom_duration_months:int \
    pain_at_rest_0_to_10:int \
    pain_on_activity_0_to_10:int \
    night_pain:string! \
    prior_knee_surgery:string! \
    prior_knee_surgery_type:string! \
    prior_knee_surgery_date:date \
    prior_injury:string! \
    prior_injury_detail:text! \
    oks_pain_severity:int \
    oks_washing_and_drying:int \
    oks_transport:int \
    oks_walking_distance:int \
    oks_pain_sitting_or_lying:int \
    oks_limping:int \
    oks_kneeling:int \
    oks_night_pain_frequency:int \
    oks_pain_interfering_with_work:int \
    oks_giving_way:int \
    oks_shopping:int \
    oks_stairs:int \
    walking_distance_before_pain:string! \
    stair_climbing_ability:string! \
    stand_from_chair_unaided:string! \
    walking_aid:string! \
    flexion_degrees:int \
    extension_deficit_degrees:int \
    fixed_flexion_deformity_present:string! \
    fixed_flexion_deformity_degrees:int \
    coronal_deformity_type:string! \
    coronal_deformity_severity:string! \
    ligament_acl:string! \
    ligament_pcl:string! \
    ligament_mcl:string! \
    ligament_lcl:string! \
    patellar_tracking:string! \
    quadriceps_strength_mrc:int \
    effusion_present:string! \
    crepitus_present:string! \
    weight_bearing_xray_performed:string! \
    kellgren_lawrence_grade_medial:int \
    kellgren_lawrence_grade_lateral:int \
    kellgren_lawrence_grade_patellofemoral:int \
    mri_performed:string! \
    mri_findings:text! \
    ct_performed:string! \
    ct_indication:string! \
    physiotherapy_tried:string! \
    physiotherapy_duration_weeks:int \
    weight_management_advice_given:string! \
    injection_given:string! \
    injection_type:string! \
    injection_count:int \
    injection_response:string! \
    nsaid_analgesic_trial:string! \
    nsaid_analgesic_response:string! \
    walking_aid_trial:string! \
    conservative_measures_exhausted:string! \
    diabetes_controlled:string! \
    cardiac_disease:string! \
    bleeding_disorder_or_anticoagulant:string! \
    smoking_status:string! \
    general_fitness_note:text! \
    fbc_done:string! \
    renal_function_done:string! \
    clotting_done:string! \
    ecg_done:string! \
    mrsa_screen_done:string! \
    urinalysis_done:string! \
    risks_benefits_discussed:string! \
    realistic_expectations_discussed:string! \
    patient_decision_aid_given:string! \
    interpreter_required:string! \
    plan_recommendation:string! \
    target_list_date:date \
    responsible_surgeon:string! \
    --api

cargo loco generate scaffold knee_replacement_surgery_evaluation_grade \
    deleted_at:tstz \
    knee_replacement_surgery_evaluation:references \
    oks_total:int \
    computed_oks_category:string! \
    final_oks_category:string! \
    max_kellgren_lawrence_grade:int \
    computed_candidacy:string! \
    final_candidacy:string! \
    override_reason:string! \
    clinician_notes:text! \
    signed_by_name:string! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold knee_replacement_surgery_evaluation_grade_flag \
    deleted_at:tstz \
    knee_replacement_surgery_evaluation_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"

# Fix two loco-new scaffold defaults that fail clippy -D warnings:
# App::seed()'s unused base param, and the test auth_header() helper's
# redundant &token.
"$(git rev-parse --show-toplevel)/bin/loco-seed-base-rename" "${form_kebab_case}"
"$(git rev-parse --show-toplevel)/bin/loco-test-auth-header-fix" "${form_kebab_case}"
