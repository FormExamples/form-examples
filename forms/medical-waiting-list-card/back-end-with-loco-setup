#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding medical-waiting-list-card (7 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    preferred_language_as_iso_639_1:string! \
    interpreter_required:string! \
    accessibility_needs:text! \
    preferred_contact_channel:string! \
    --api && \
cargo loco generate scaffold practitioner \
    deleted_at:ts \
    name:string! \
    email:text \
    phone:text \
    role:string! \
    registration_body:string! \
    registration_number:string! \
    organisation_name:string! \
    organisation_ods_code:string! \
    site_name:string! \
    country_as_iso_3166_1_alpha_2:string \
    --api && \
cargo loco generate scaffold medical_waiting_list_card \
    deleted_at:ts \
    patient:references \
    practitioner:references \
    status:string! \
    entry_date:date \
    entry_time:string \
    referral_source:string! \
    referral_date:date \
    referral_letter_reference:string! \
    reason_for_referral:text! \
    presenting_condition:text! \
    icd_10_code:string! \
    snomed_ct_code:string! \
    suspected_cancer:string! \
    list_name:string! \
    specialty:string! \
    sub_specialty:string! \
    procedure_description:text! \
    opcs_4_code:string! \
    clinical_priority:string! \
    rtt_clock_start_date:date \
    expected_procedure_type:string! \
    expected_wait_weeks:int \
    consent_to_reminders:string! \
    communication_notes:text! \
    additional_notes:text! \
    signed_at:ts \
    --api && \
cargo loco generate scaffold medical_waiting_list_card_appointment \
    deleted_at:ts \
    medical_waiting_list_card:references \
    appointment_date:date \
    appointment_time:string \
    duration_minutes:int \
    appointment_type:string! \
    site_name:string! \
    site_address:text! \
    clinic_name:string! \
    room:string! \
    clinician_name:string! \
    clinician_team:string! \
    status:string! \
    travel_notes:text! \
    access_notes:text! \
    --api && \
cargo loco generate scaffold medical_waiting_list_card_grade \
    deleted_at:ts \
    medical_waiting_list_card:references \
    waiting_time_status:string! \
    clinical_priority:string! \
    target_wait_weeks:double \
    days_waited:int \
    weeks_waited:double \
    days_to_target:int \
    days_to_breach:int \
    days_to_appointment:int \
    grader_notes:text! \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold medical_waiting_list_card_grade_rule \
    deleted_at:ts \
    medical_waiting_list_card_grade:references \
    rule_id:string! \
    instrument:string! \
    band:string! \
    category:string! \
    description:string! \
    --api && \
cargo loco generate scaffold medical_waiting_list_card_grade_flag \
    deleted_at:ts \
    medical_waiting_list_card_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

echo "Done."
