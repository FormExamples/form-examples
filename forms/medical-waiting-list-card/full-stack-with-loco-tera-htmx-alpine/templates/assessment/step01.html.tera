<div class="card">
    <h2>Step 1: Practitioner identification</h2>
    <p class="form-hint">Identify the practitioner placing the patient on the list.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="practitioner_name">Name</label>
            <input type="text" id="practitioner_name" name="practitioner.name"
                   value="{{ practitioner.name }}">
        </div>
        <div class="form-group">
            <label for="practitioner_role">Role</label>
            <input type="text" id="practitioner_role" name="practitioner.role"
                   value="{{ practitioner.role }}"
                   placeholder="GP, Consultant, Booking clerk, RTT validator...">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="registration_body">Registration body</label>
            <input type="text" id="registration_body" name="practitioner.registration_body"
                   value="{{ practitioner.registrationBody }}"
                   placeholder="GMC, NMC, HCPC, GPhC, NHS...">
        </div>
        <div class="form-group">
            <label for="registration_number">Registration number</label>
            <input type="text" id="registration_number" name="practitioner.registration_number"
                   value="{{ practitioner.registrationNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="organisation_name">Organisation</label>
            <input type="text" id="organisation_name" name="practitioner.organisation_name"
                   value="{{ practitioner.organisationName }}"
                   placeholder="NHS trust or independent provider">
        </div>
        <div class="form-group">
            <label for="organisation_ods_code">ODS code</label>
            <input type="text" id="organisation_ods_code" name="practitioner.organisation_ods_code"
                   value="{{ practitioner.organisationOdsCode }}"
                   placeholder="e.g. RJ1">
        </div>
    </div>

    <div class="form-group">
        <label for="site_name">Site</label>
        <input type="text" id="site_name" name="practitioner.site_name"
               value="{{ practitioner.siteName }}"
               placeholder="Hospital, clinic, or referral hub">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="practitioner_email">Email</label>
            <input type="email" id="practitioner_email" name="practitioner.email"
                   value="{{ practitioner.email }}">
        </div>
        <div class="form-group">
            <label for="practitioner_phone">Phone</label>
            <input type="tel" id="practitioner_phone" name="practitioner.phone"
                   value="{{ practitioner.phone }}">
        </div>
    </div>
</div>
