<div class="card">
    <h2>Step 3: Referral details</h2>
    <p class="form-hint">Where did the referral come from, and why?</p>

    <div class="form-row">
        <div class="form-group">
            <label for="referral_source">Referral source</label>
            <select id="referral_source" name="referral.referral_source">
                <option value="" {% if referral.referralSource == "" %}selected{% endif %}>Select...</option>
                <option value="gp" {% if referral.referralSource == "gp" %}selected{% endif %}>GP</option>
                <option value="consultant" {% if referral.referralSource == "consultant" %}selected{% endif %}>Hospital consultant</option>
                <option value="a-and-e" {% if referral.referralSource == "a-and-e" %}selected{% endif %}>A&amp;E</option>
                <option value="self" {% if referral.referralSource == "self" %}selected{% endif %}>Self-referral</option>
                <option value="screening" {% if referral.referralSource == "screening" %}selected{% endif %}>Screening programme</option>
                <option value="other" {% if referral.referralSource == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="referral_date">Referral date</label>
            <input type="date" id="referral_date" name="referral.referral_date"
                   value="{{ referral.referralDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="referral_letter_reference">Referral letter reference</label>
        <input type="text" id="referral_letter_reference" name="referral.referral_letter_reference"
               value="{{ referral.referralLetterReference }}"
               placeholder="e.g. eRS UBRN or letter number">
    </div>

    <div class="form-group">
        <label for="reason_for_referral">Reason for referral</label>
        <textarea id="reason_for_referral" name="referral.reason_for_referral"
                  placeholder="Brief clinical justification">{{ referral.reasonForReferral }}</textarea>
    </div>

    <div class="form-group">
        <label for="presenting_condition">Presenting condition</label>
        <textarea id="presenting_condition" name="referral.presenting_condition"
                  placeholder="Symptoms, duration, severity">{{ referral.presentingCondition }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="icd10_code">ICD-10 code</label>
            <input type="text" id="icd10_code" name="referral.icd10_code"
                   value="{{ referral.icd10Code }}"
                   placeholder="e.g. I25.10">
        </div>
        <div class="form-group">
            <label for="snomed_ct_code">SNOMED CT code</label>
            <input type="text" id="snomed_ct_code" name="referral.snomed_ct_code"
                   value="{{ referral.snomedCtCode }}"
                   placeholder="e.g. 53741008">
        </div>
    </div>

    <div class="form-group">
        <label>Suspected cancer referral (two-week wait)?</label>
        <div class="radio-group">
            <label><input type="radio" name="referral.suspected_cancer" value="yes" {% if referral.suspectedCancer == "yes" %}checked{% endif %}> Yes</label>
            <label><input type="radio" name="referral.suspected_cancer" value="no" {% if referral.suspectedCancer == "no" %}checked{% endif %}> No</label>
        </div>
    </div>
</div>
