<div class="card">
    <h2>Step 4: Waiting list entry</h2>
    <p class="form-hint">
        The clinical priority and RTT clock-start date drive the Waiting Time
        Status calculation.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="list_name">List name</label>
            <input type="text" id="list_name" name="waiting_list.list_name"
                   value="{{ waiting_list.listName }}"
                   placeholder="e.g. Cardiology outpatient list">
        </div>
        <div class="form-group">
            <label for="specialty">Specialty</label>
            <input type="text" id="specialty" name="waiting_list.specialty"
                   value="{{ waiting_list.specialty }}"
                   placeholder="e.g. cardiology, orthopaedics">
        </div>
    </div>

    <div class="form-group">
        <label for="sub_specialty">Sub-specialty</label>
        <input type="text" id="sub_specialty" name="waiting_list.sub_specialty"
               value="{{ waiting_list.subSpecialty }}"
               placeholder="e.g. interventional cardiology">
    </div>

    <div class="form-group">
        <label for="procedure_description">Procedure / appointment description</label>
        <textarea id="procedure_description" name="waiting_list.procedure_description"
                  placeholder="Free-text description of what the patient is waiting for">{{ waiting_list.procedureDescription }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="opcs4_code">OPCS-4 code</label>
            <input type="text" id="opcs4_code" name="waiting_list.opcs4_code"
                   value="{{ waiting_list.opcs4Code }}"
                   placeholder="e.g. K49.1">
        </div>
        <div class="form-group">
            <label for="clinical_priority">Clinical priority</label>
            <select id="clinical_priority" name="waiting_list.clinical_priority">
                <option value="" {% if waiting_list.clinicalPriority == "" %}selected{% endif %}>Select...</option>
                <option value="P1a" {% if waiting_list.clinicalPriority == "P1a" %}selected{% endif %}>P1a &mdash; Emergency (24 hours)</option>
                <option value="P1b" {% if waiting_list.clinicalPriority == "P1b" %}selected{% endif %}>P1b &mdash; Urgent (72 hours)</option>
                <option value="P2" {% if waiting_list.clinicalPriority == "P2" %}selected{% endif %}>P2 &mdash; Cancer / time-critical (4 weeks)</option>
                <option value="P3" {% if waiting_list.clinicalPriority == "P3" %}selected{% endif %}>P3 &mdash; Substantial harm risk (12 weeks)</option>
                <option value="P4" {% if waiting_list.clinicalPriority == "P4" %}selected{% endif %}>P4 &mdash; Routine (18 weeks, RTT)</option>
                <option value="P5" {% if waiting_list.clinicalPriority == "P5" %}selected{% endif %}>P5 &mdash; Deferred (26 weeks)</option>
                <option value="P6" {% if waiting_list.clinicalPriority == "P6" %}selected{% endif %}>P6 &mdash; Removed from list</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="rtt_clock_start_date">RTT clock-start date</label>
            <input type="date" id="rtt_clock_start_date" name="waiting_list.rtt_clock_start_date"
                   value="{{ waiting_list.rttClockStartDate }}">
        </div>
        <div class="form-group">
            <label for="expected_procedure_type">Expected procedure / appointment type</label>
            <input type="text" id="expected_procedure_type" name="waiting_list.expected_procedure_type"
                   value="{{ waiting_list.expectedProcedureType }}"
                   placeholder="first outpatient, day case, inpatient...">
        </div>
    </div>

    <div class="form-group">
        <label for="expected_wait_weeks">Expected wait (weeks)</label>
        <input type="number" id="expected_wait_weeks" name="waiting_list.expected_wait_weeks"
               min="0" step="1"
               value="{% if waiting_list.expectedWaitWeeks %}{{ waiting_list.expectedWaitWeeks }}{% endif %}">
    </div>
</div>
