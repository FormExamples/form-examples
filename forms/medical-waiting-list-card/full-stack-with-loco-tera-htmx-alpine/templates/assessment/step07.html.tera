<div class="card">
    <h2>Step 7: Sign-off</h2>
    <p class="form-hint">
        Record any final notes before the card is submitted. The Waiting Time
        Status is computed from the data above.
    </p>

    <div class="form-group">
        <label for="additional_notes">Additional notes</label>
        <textarea id="additional_notes" name="signoff.additional_notes"
                  placeholder="Anything the booking team should know that isn't captured above">{{ signoff.additionalNotes }}</textarea>
    </div>

    <div class="form-group">
        <label for="signed_at">Sign-off timestamp</label>
        <input type="text" id="signed_at" name="signoff.signed_at"
               value="{{ signoff.signedAt }}"
               placeholder="ISO 8601 datetime; auto-stamped on submit if left blank">
    </div>
</div>
