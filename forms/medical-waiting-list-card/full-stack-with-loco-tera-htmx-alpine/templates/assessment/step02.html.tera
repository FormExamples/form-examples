<div class="card">
    <h2>Step 2: Patient identification</h2>
    <p class="form-hint">Identify the patient and capture any access needs.</p>

    <div class="form-group">
        <label for="patient_name">Full name</label>
        <input type="text" id="patient_name" name="patient.name"
               value="{{ patient.name }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_birth_date">Date of birth</label>
            <input type="date" id="patient_birth_date" name="patient.birth_date"
                   value="{{ patient.birthDate }}">
        </div>
        <div class="form-group">
            <label for="patient_sex">Sex</label>
            <select id="patient_sex" name="patient.sex">
                <option value="" {% if patient.sex == "" %}selected{% endif %}>Select...</option>
                <option value="female" {% if patient.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if patient.sex == "male" %}selected{% endif %}>Male</option>
                <option value="intersex" {% if patient.sex == "intersex" %}selected{% endif %}>Intersex</option>
                <option value="unknown" {% if patient.sex == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="nhs_number">NHS number</label>
        <input type="text" id="nhs_number" name="patient.united_kingdom_nhs_number"
               value="{{ patient.unitedKingdomNhsNumber }}"
               placeholder="e.g. 943 476 5919">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_email">Email</label>
            <input type="email" id="patient_email" name="patient.email"
                   value="{{ patient.email }}">
        </div>
        <div class="form-group">
            <label for="patient_phone">Phone</label>
            <input type="tel" id="patient_phone" name="patient.phone"
                   value="{{ patient.phone }}">
        </div>
    </div>

    <div class="form-group">
        <label for="postal_address">Postal address</label>
        <textarea id="postal_address" name="patient.postal_address_as_full_text"
                  placeholder="Full address including postcode">{{ patient.postalAddressAsFullText }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="postcode">Postcode</label>
            <input type="text" id="postcode" name="patient.postcode"
                   value="{{ patient.postcode }}">
        </div>
        <div class="form-group">
            <label for="preferred_language">Preferred language (ISO 639-1)</label>
            <input type="text" id="preferred_language" name="patient.preferred_language_as_iso6391"
                   value="{{ patient.preferredLanguageAsIso6391 }}"
                   placeholder="e.g. en, cy, pl">
        </div>
    </div>

    <div class="form-group">
        <label>Interpreter required?</label>
        <div class="radio-group">
            <label><input type="radio" name="patient.interpreter_required" value="yes" {% if patient.interpreterRequired == "yes" %}checked{% endif %}> Yes</label>
            <label><input type="radio" name="patient.interpreter_required" value="no" {% if patient.interpreterRequired == "no" %}checked{% endif %}> No</label>
        </div>
    </div>

    <div class="form-group">
        <label for="accessibility_needs">Accessibility needs</label>
        <textarea id="accessibility_needs" name="patient.accessibility_needs"
                  placeholder="BSL, large print, easy-read, step-free access, hearing loop...">{{ patient.accessibilityNeeds }}</textarea>
    </div>

    <div class="form-group">
        <label for="preferred_contact_channel">Preferred contact channel</label>
        <select id="preferred_contact_channel" name="patient.preferred_contact_channel">
            <option value="" {% if patient.preferredContactChannel == "" %}selected{% endif %}>Select...</option>
            <option value="sms" {% if patient.preferredContactChannel == "sms" %}selected{% endif %}>SMS</option>
            <option value="email" {% if patient.preferredContactChannel == "email" %}selected{% endif %}>Email</option>
            <option value="phone" {% if patient.preferredContactChannel == "phone" %}selected{% endif %}>Phone</option>
            <option value="letter" {% if patient.preferredContactChannel == "letter" %}selected{% endif %}>Letter</option>
            <option value="nhs-app" {% if patient.preferredContactChannel == "nhs-app" %}selected{% endif %}>NHS App</option>
        </select>
    </div>
</div>
