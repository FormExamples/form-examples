<div class="card">
    <h2>Step 6: Patient communication</h2>
    <p class="form-hint">
        Confirm consent to reminders and capture any communication notes
        relevant to the booking team.
    </p>

    <div class="form-group">
        <label>Consent to appointment reminders?</label>
        <div class="radio-group">
            <label><input type="radio" name="communication.consent_to_reminders" value="yes" {% if communication.consentToReminders == "yes" %}checked{% endif %}> Yes</label>
            <label><input type="radio" name="communication.consent_to_reminders" value="no" {% if communication.consentToReminders == "no" %}checked{% endif %}> No</label>
        </div>
    </div>

    <div class="form-group">
        <label for="communication_notes">Communication notes</label>
        <textarea id="communication_notes" name="communication.communication_notes"
                  placeholder="Best time to call, alternative contact, family member to copy in, do-not-contact periods...">{{ communication.communicationNotes }}</textarea>
    </div>
</div>
