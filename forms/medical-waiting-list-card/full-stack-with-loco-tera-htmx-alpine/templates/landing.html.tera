{% extends "base.html.tera" %}

{% block title %}Medical Waiting List Card - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Medical Waiting List Card</h1>
        <p class="landing-description">
            Place a patient on a medical waiting list aligned with NHS England's
            <strong>Referral to Treatment (RTT)</strong> patient-pathway rules and the
            <strong>Clinical Prioritisation (P1&ndash;P6)</strong> framework.
            The card records the referral, RTT clock start, clinical priority,
            upcoming appointment, communication needs, and computes the
            Waiting Time Status with 18-week and 52-week breach checks.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>7-step practitioner wizard</h3>
                <p>Practitioner, patient, referral, waiting list, appointment, communication, sign-off.</p>
            </div>
            <div class="feature">
                <h3>Waiting Time Status</h3>
                <p>Within target / Approaching breach / Breached / Long wait (&gt; 52 weeks).</p>
            </div>
            <div class="feature">
                <h3>Operational flags</h3>
                <p>Cancer two-week wait, P1 escalation, interpreter, accessibility, contact-detail gaps.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin new waiting list card
            </button>
        </form>
    </div>
</div>
{% endblock %}
