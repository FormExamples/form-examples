{% extends "base.html.tera" %}

{% block title %}Waiting List Card &mdash; {{ waiting_time_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Medical Waiting List Card</h1>
    <div class="status-badge status-{{ waiting_time_status }}">{{ waiting_time_label }}</div>
    <p class="report-summary">
        Clinical priority: <strong>{{ clinical_priority_label }}</strong>
        {% if target_wait_weeks %} &middot; Target {{ target_wait_weeks }} weeks{% endif %}
    </p>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Card ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient summary -->
<div class="card">
    <h2>Patient summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.patient.name }}<br>
            <strong>Date of birth:</strong> {{ data.patient.birthDate }}<br>
            <strong>NHS number:</strong> {{ data.patient.unitedKingdomNhsNumber }}<br>
            <strong>Preferred contact:</strong> {{ data.patient.preferredContactChannel }}
        </div>
        <div>
            <strong>Specialty:</strong> {{ data.waitingList.specialty }}<br>
            <strong>Procedure:</strong> {{ data.waitingList.procedureDescription }}<br>
            <strong>RTT clock start:</strong> {{ data.waitingList.rttClockStartDate }}<br>
            <strong>Suspected cancer referral:</strong> {{ data.referral.suspectedCancer }}
        </div>
    </div>
</div>

<!-- Wait projection -->
<div class="card">
    <h2>Wait projection</h2>
    <dl class="report-grid">
        <div><dt>Days waited</dt><dd>{% if days_waited %}{{ days_waited }}{% else %}&mdash;{% endif %}</dd></div>
        <div><dt>Weeks waited</dt><dd>{% if weeks_waited %}{{ weeks_waited }}{% else %}&mdash;{% endif %}</dd></div>
        <div><dt>Days to priority target</dt><dd>{% if days_to_target %}{{ days_to_target }}{% else %}&mdash;{% endif %}</dd></div>
        <div><dt>Days to 18-week breach</dt><dd>{% if days_to_breach %}{{ days_to_breach }}{% else %}&mdash;{% endif %}</dd></div>
        <div><dt>Days to next appointment</dt><dd>{% if days_to_appointment %}{{ days_to_appointment }}{% else %}&mdash;{% endif %}</dd></div>
    </dl>
</div>

<!-- Operational flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Operational flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">[{{ flag.priority | upper }}] {{ flag.category }}</span>
            <span class="flag-message">{{ flag.description }}</span>
            <span class="flag-action"><em>{{ flag.suggestedAction }}</em></span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Waiting-time rules fired ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Rule ID</th>
                <th>Instrument</th>
                <th>Band</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.ruleId }}</code></td>
                <td>{{ rule.instrument }}</td>
                <td>{{ rule.band }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New waiting list card</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print report</button>
</div>
{% endblock %}
