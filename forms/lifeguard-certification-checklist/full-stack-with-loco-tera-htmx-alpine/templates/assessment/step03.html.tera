<div class="card">
    <h2>Step 3: Supervision, Scanning &amp; Zoning</h2>
    <p class="form-hint">
        Effective scanning patterns and zone management. Critical: effective scanning pattern.
    </p>

    <div class="form-group">
        <label for="understands_zone_of_responsibility">Understands zone of responsibility?</label>
        <select id="understands_zone_of_responsibility" name="supervision_scanning_zoning.understands_zone_of_responsibility">
            <option value="" {% if supervision_scanning_zoning.understandsZoneOfResponsibility == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.understandsZoneOfResponsibility == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.understandsZoneOfResponsibility == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.understandsZoneOfResponsibility == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="effective_scanning_pattern">Effective scanning pattern? (critical)</label>
        <select id="effective_scanning_pattern" name="supervision_scanning_zoning.effective_scanning_pattern">
            <option value="" {% if supervision_scanning_zoning.effectiveScanningPattern == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.effectiveScanningPattern == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.effectiveScanningPattern == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.effectiveScanningPattern == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ten_twenty_scan_rule">Applies 10/20 rule?</label>
        <select id="ten_twenty_scan_rule" name="supervision_scanning_zoning.ten_twenty_scan_rule">
            <option value="" {% if supervision_scanning_zoning.tenTwentyScanRule == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.tenTwentyScanRule == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.tenTwentyScanRule == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.tenTwentyScanRule == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recognises_distressed_swimmer">Recognises distressed swimmer?</label>
        <select id="recognises_distressed_swimmer" name="supervision_scanning_zoning.recognises_distressed_swimmer">
            <option value="" {% if supervision_scanning_zoning.recognisesDistressedSwimmer == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.recognisesDistressedSwimmer == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.recognisesDistressedSwimmer == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.recognisesDistressedSwimmer == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="appropriate_rotation">Appropriate rotation?</label>
        <select id="appropriate_rotation" name="supervision_scanning_zoning.appropriate_rotation">
            <option value="" {% if supervision_scanning_zoning.appropriateRotation == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.appropriateRotation == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.appropriateRotation == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.appropriateRotation == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="uses_whistle_and_signals">Uses whistle and signals?</label>
        <select id="uses_whistle_and_signals" name="supervision_scanning_zoning.uses_whistle_and_signals">
            <option value="" {% if supervision_scanning_zoning.usesWhistleAndSignals == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if supervision_scanning_zoning.usesWhistleAndSignals == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if supervision_scanning_zoning.usesWhistleAndSignals == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if supervision_scanning_zoning.usesWhistleAndSignals == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>
</div>
