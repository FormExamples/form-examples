            <option value="no" {% if legal_regulatory_incident.eapInvocation == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if legal_regulatory_incident.eapInvocation == "na" %}selected{% endif %}>Not assessed</option>
        </select>
