<div class="card">
    <h2>Step 9: Legal, Regulatory &amp; Incident Reporting</h2>
    <p class="form-hint">Duty of care, PSOP / EAP knowledge, RIDDOR, and safeguarding.</p>

    <div class="form-group">
        <label for="lr_duty_of_care_understood">Duty of care understood?</label>
        <select id="lr_duty_of_care_understood" name="legal_regulatory_incident.duty_of_care_understood">
            <option value="" {% if legal_regulatory_incident.dutyOfCareUnderstood == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if legal_regulatory_incident.dutyOfCareUnderstood == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if legal_regulatory_incident.dutyOfCareUnderstood == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if legal_regulatory_incident.dutyOfCareUnderstood == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="lr_pswp_knowledge">PSOP / NOP / EAP knowledge?</label>
