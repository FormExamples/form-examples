            <option value="no" {% if legal_regulatory_incident.incidentReportCompleted == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if legal_regulatory_incident.incidentReportCompleted == "na" %}selected{% endif %}>Not assessed</option>
