            <option value="" {% if rescue_unconscious.recognitionAndAlert == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if rescue_unconscious.recognitionAndAlert == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if rescue_unconscious.recognitionAndAlert == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if rescue_unconscious.recognitionAndAlert == "na" %}selected{% endif %}>Not assessed</option>
