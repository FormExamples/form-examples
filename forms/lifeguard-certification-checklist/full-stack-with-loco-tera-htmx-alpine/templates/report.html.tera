{% extends "base.html.tera" %}

{% block title %}Lifeguard Assessment Report - {{ outcome_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Lifeguard Certification Checklist &mdash; Examiner Report</h1>
    <div class="checklist-badge checklist-{{ outcome }}">{{ outcome_label }}</div>
    <div class="checklist-label">Rules answered: {{ answered_count }} / {{ total_rules }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<div class="card">
    <h2>Candidate Summary</h2>
    <div class="form-row">
        <div>
            <strong>Candidate:</strong> {{ data.candidateDetails.firstName }} {{ data.candidateDetails.lastName }}<br>
            <strong>Candidate ID:</strong> {{ data.candidateDetails.candidateId }}<br>
            <strong>Date of Birth:</strong> {{ data.candidateDetails.dateOfBirth }}<br>
            <strong>Prior cert expiry:</strong> {{ data.candidateDetails.priorCertificationExpiry }}
        </div>
        <div>
            <strong>Venue:</strong> {{ data.candidateDetails.venueName }} ({{ data.candidateDetails.venueType }})<br>
            <strong>Type:</strong> {{ data.candidateDetails.assessmentType }}<br>
            <strong>Session date:</strong> {{ data.candidateDetails.sessionDate }}<br>
            <strong>Examiner:</strong> {{ data.candidateDetails.examinerName }} ({{ data.candidateDetails.examinerLicenceNumber }})
        </div>
    </div>
</div>

{% if critical_failures | length > 0 %}
<div class="card">
    <h2>Critical-Competency Failures ({{ critical_failures | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in critical_failures %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{% if deficiencies | length > 0 %}
<div class="card">
    <h2>Non-Critical Deficiencies ({{ deficiencies | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in deficiencies %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Examiner Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<div class="card">
    <h2>Examiner Notes</h2>
    <p><strong>Strengths:</strong> {{ data.overallResultSignoff.strengths }}</p>
    <p><strong>Development areas:</strong> {{ data.overallResultSignoff.developmentAreas }}</p>
    <p><strong>Examiner notes:</strong> {{ data.overallResultSignoff.examinerNotes }}</p>
    <p><strong>Candidate feedback:</strong> {{ data.overallResultSignoff.candidateFeedback }}</p>
</div>

<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
