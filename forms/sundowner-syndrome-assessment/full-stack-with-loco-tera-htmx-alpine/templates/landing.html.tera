{% extends "base.html.tera" %}

{% block title %}Sundowner Syndrome Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Sundowner Syndrome Assessment</h1>
        <p class="landing-description">
            Sundowner syndrome (sundowning) evaluation using the Cohen-Mansfield
            Agitation Inventory (CMAI) and the Neuropsychiatric Inventory (NPI)
            for behavioural symptoms in elderly patients, particularly those
            with dementia. The output is a graded clinical report with severity
            band (mild, moderate, severe, critical), fired rules, and flagged
            issues prioritised for the multidisciplinary team.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>CMAI (29 items)</h3>
                <p>Observer-rated agitation inventory scored 1-7 per item; total 29-203 mapped to four severity bands.</p>
            </div>
            <div class="feature">
                <h3>NPI (12 domains)</h3>
                <p>Frequency &times; severity per behavioural domain (0-12 each, total 0-144).</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>High / medium / low priority alerts for aggression, self-harm, falls, sleep disturbance, carer strain, and environmental factors.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
