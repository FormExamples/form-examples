{% extends "base.html.tera" %}

{% block title %}Sundowner Syndrome Assessment &mdash; Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Sundowner Assessment Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Name or diagnosis&hellip;">
    </div>
    <div class="form-group">
        <label for="severity">Severity</label>
        <select id="severity" name="severity">
            <option value="">All</option>
            <option value="mild" {% if severity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if severity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if severity == "severe" %}selected{% endif %}>Severe</option>
            <option value="critical" {% if severity == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="care_setting">Care setting</label>
        <select id="care_setting" name="care_setting">
            <option value="">All</option>
            <option value="home-with-family" {% if care_setting == "home-with-family" %}selected{% endif %}>Home with family carer</option>
            <option value="home-alone" {% if care_setting == "home-alone" %}selected{% endif %}>Home, lives alone</option>
            <option value="home-with-formal-care" {% if care_setting == "home-with-formal-care" %}selected{% endif %}>Home with formal care</option>
            <option value="residential-care" {% if care_setting == "residential-care" %}selected{% endif %}>Residential care</option>
            <option value="nursing-home" {% if care_setting == "nursing-home" %}selected{% endif %}>Nursing home</option>
            <option value="hospital" {% if care_setting == "hospital" %}selected{% endif %}>Hospital</option>
            <option value="other" {% if care_setting == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-priority flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Patient</th>
            <th>Diagnosis</th>
            <th>Care setting</th>
            <th>Severity</th>
            <th>CMAI</th>
            <th>NPI</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.timestamp }}</a></td>
            <td>{{ c.firstName }} {{ c.lastName }}<br><small>{{ c.dateOfBirth }}</small></td>
            <td>{{ c.primaryDiagnosis }}</td>
            <td>{{ c.careSetting }}</td>
            <td><span class="severity-badge severity-{{ c.severity }}">{{ c.severity }}</span></td>
            <td>{{ c.cmaiScore }} / 203</td>
            <td>{{ c.npiScore }} / 144</td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
