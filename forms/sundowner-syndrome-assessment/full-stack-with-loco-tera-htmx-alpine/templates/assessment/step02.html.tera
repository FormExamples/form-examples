<div class="card">
    <h2>Step 2: Cognitive Status</h2>
    <p class="form-hint">Baseline cognition and dementia stage.</p>

    <div class="form-group">
        <label for="dementia_stage">Dementia stage</label>
        <select id="dementia_stage" name="cognitive_status.dementia_stage">
            <option value="" {% if cognitive_status.dementiaStage == "" %}selected{% endif %}>&mdash;</option>
            <option value="normal" {% if cognitive_status.dementiaStage == "normal" %}selected{% endif %}>No dementia</option>
            <option value="mild" {% if cognitive_status.dementiaStage == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if cognitive_status.dementiaStage == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if cognitive_status.dementiaStage == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>

    <div class="form-group">
        <label for="cognitive_impairment">Cognitive impairment</label>
        <select id="cognitive_impairment" name="cognitive_status.cognitive_impairment">
            <option value="" {% if cognitive_status.cognitiveImpairment == "" %}selected{% endif %}>&mdash;</option>
            <option value="none" {% if cognitive_status.cognitiveImpairment == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if cognitive_status.cognitiveImpairment == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if cognitive_status.cognitiveImpairment == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if cognitive_status.cognitiveImpairment == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="mmse_score">MMSE / MOCA score</label>
            <input type="number" min="0" max="30" id="mmse_score" name="cognitive_status.mmse_score"
                   value="{{ cognitive_status.mmseScore }}">
        </div>
        <div class="form-group">
            <label for="mmse_date">Date of cognitive testing</label>
            <input type="date" id="mmse_date" name="cognitive_status.mmse_date"
                   value="{{ cognitive_status.mmseDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="prior_delirium_history">Prior history of delirium?</label>
        <select id="prior_delirium_history" name="cognitive_status.prior_delirium_history">
            <option value="" {% if cognitive_status.priorDeliriumHistory == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if cognitive_status.priorDeliriumHistory == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if cognitive_status.priorDeliriumHistory == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="cognitive_notes">Cognitive notes</label>
        <textarea id="cognitive_notes" name="cognitive_status.cognitive_notes"
                  placeholder="Recent changes, fluctuations, focal deficits&hellip;">{{ cognitive_status.cognitiveNotes }}</textarea>
    </div>
</div>
