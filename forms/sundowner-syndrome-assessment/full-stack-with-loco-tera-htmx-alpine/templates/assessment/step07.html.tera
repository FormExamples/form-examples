<div class="card">
    <h2>Step 7: Medication Review</h2>
    <p class="form-hint">Current medications, anticholinergic / sedative burden, recent changes.</p>

    <h3>Current medications</h3>
    {% set meds = medication_review.currentMedications | default(value=[]) %}
    {% if meds | length > 0 %}
    <table class="med-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Dose</th>
                <th>Frequency</th>
                <th>Indication</th>
            </tr>
        </thead>
        <tbody>
            {% for med in meds %}
            <tr>
                <td>
                    <input type="text" name="current_medications[{{ loop.index0 }}].name" value="{{ med.name }}" placeholder="e.g. Quetiapine">
                </td>
                <td>
                    <input type="text" name="current_medications[{{ loop.index0 }}].dose" value="{{ med.dose }}" placeholder="e.g. 25 mg">
                </td>
                <td>
                    <input type="text" name="current_medications[{{ loop.index0 }}].frequency" value="{{ med.frequency }}" placeholder="e.g. nocte">
                </td>
                <td>
                    <input type="text" name="current_medications[{{ loop.index0 }}].indication" value="{{ med.indication }}" placeholder="e.g. agitation">
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
    <p class="form-hint">Add a new medication row:</p>
    {% set next_idx = meds | length %}
    <table class="med-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Dose</th>
                <th>Frequency</th>
                <th>Indication</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input type="text" name="current_medications[{{ next_idx }}].name" placeholder="e.g. Quetiapine"></td>
                <td><input type="text" name="current_medications[{{ next_idx }}].dose" placeholder="e.g. 25 mg"></td>
                <td><input type="text" name="current_medications[{{ next_idx }}].frequency" placeholder="e.g. nocte"></td>
                <td><input type="text" name="current_medications[{{ next_idx }}].indication" placeholder="e.g. agitation"></td>
            </tr>
        </tbody>
    </table>

    <div class="form-group">
        <label for="anticholinergic_burden">Significant anticholinergic burden?</label>
        <select id="anticholinergic_burden" name="medication_review.anticholinergic_burden">
            <option value="" {% if medication_review.anticholinergicBurden == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medication_review.anticholinergicBurden == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medication_review.anticholinergicBurden == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sedative_use">Sedative use (benzodiazepines, Z-drugs)?</label>
        <select id="sedative_use" name="medication_review.sedative_use">
            <option value="" {% if medication_review.sedativeUse == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medication_review.sedativeUse == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medication_review.sedativeUse == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="antipsychotic_use">Antipsychotic use?</label>
        <select id="antipsychotic_use" name="medication_review.antipsychotic_use">
            <option value="" {% if medication_review.antipsychoticUse == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medication_review.antipsychoticUse == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medication_review.antipsychoticUse == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recent_medication_change">Recent medication change (last 30 days)?</label>
        <select id="recent_medication_change" name="medication_review.recent_medication_change">
            <option value="" {% if medication_review.recentMedicationChange == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medication_review.recentMedicationChange == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medication_review.recentMedicationChange == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recent_medication_change_details">Details of recent medication change</label>
        <input type="text" id="recent_medication_change_details" name="medication_review.recent_medication_change_details"
               value="{{ medication_review.recentMedicationChangeDetails }}">
    </div>

    <div class="form-group">
        <label for="medication_adherence">Medication adherence</label>
        <select id="medication_adherence" name="medication_review.medication_adherence">
            <option value="" {% if medication_review.medicationAdherence == "" %}selected{% endif %}>&mdash;</option>
            <option value="good" {% if medication_review.medicationAdherence == "good" %}selected{% endif %}>Good &mdash; taken as prescribed</option>
            <option value="partial" {% if medication_review.medicationAdherence == "partial" %}selected{% endif %}>Partial &mdash; occasional missed doses</option>
            <option value="poor" {% if medication_review.medicationAdherence == "poor" %}selected{% endif %}>Poor &mdash; frequently missed or unsupervised</option>
        </select>
    </div>

    <div class="form-group">
        <label for="medication_notes">Medication notes</label>
        <textarea id="medication_notes" name="medication_review.medication_notes"
                  placeholder="Allergies, intolerances, deprescribing plan&hellip;">{{ medication_review.medicationNotes }}</textarea>
    </div>
</div>
