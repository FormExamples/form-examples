<div class="card">
    <h2>Step 6: Sleep-Wake Cycle</h2>
    <p class="form-hint">Sleep history and circadian-rhythm disturbance.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="bedtime_hour_clock">Usual bedtime hour (24-hour clock)</label>
            <input type="number" min="0" max="23" id="bedtime_hour_clock" name="sleep_wake_cycle.bedtime_hour_clock"
                   value="{{ sleep_wake_cycle.bedtimeHourClock }}">
        </div>
        <div class="form-group">
            <label for="average_hours_of_sleep">Average hours of sleep per night</label>
            <input type="number" min="0" max="24" step="0.5" id="average_hours_of_sleep" name="sleep_wake_cycle.average_hours_of_sleep"
                   value="{{ sleep_wake_cycle.averageHoursOfSleep }}">
        </div>
    </div>

    {% set yesno_items = [
        ["difficulty_falling_asleep", "Difficulty falling asleep?"],
        ["nighttime_wandering", "Nighttime wandering?"],
        ["early_morning_waking", "Early morning waking?"],
        ["daytime_napping", "Daytime napping?"],
        ["reversed_sleep_cycle", "Reversed sleep cycle (sleeps in day, awake at night)?"]
    ] %}

    {% for it in yesno_items %}
    {% set field = it[0] %}
    {% set label = it[1] %}
    {% set current = sleep_wake_cycle[field] | default(value="") %}
    <div class="form-group">
        <label for="sleep_{{ field }}">{{ label }}</label>
        <select id="sleep_{{ field }}" name="sleep_wake_cycle.{{ field }}">
            <option value="" {% if current == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if current == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if current == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="night_awakening_count">Average number of awakenings per night</label>
        <input type="number" min="0" max="30" id="night_awakening_count" name="sleep_wake_cycle.night_awakening_count"
               value="{{ sleep_wake_cycle.nightAwakeningCount }}">
    </div>

    <div class="form-group">
        <label for="sleep_notes">Sleep notes</label>
        <textarea id="sleep_notes" name="sleep_wake_cycle.sleep_notes"
                  placeholder="Sleep environment, recent changes, melatonin use&hellip;">{{ sleep_wake_cycle.sleepNotes }}</textarea>
    </div>
</div>
