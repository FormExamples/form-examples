<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Basic patient information.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="demographics.first_name"
                   value="{{ demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="demographics.last_name"
                   value="{{ demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="demographics.date_of_birth"
                   value="{{ demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="age_years">Age (years)</label>
            <input type="number" min="0" max="130" id="age_years" name="demographics.age_years"
                   value="{{ demographics.ageYears }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="demographics.sex">
                <option value="" {% if demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if demographics.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="primary_diagnosis">Primary diagnosis</label>
        <input type="text" id="primary_diagnosis" name="demographics.primary_diagnosis"
               value="{{ demographics.primaryDiagnosis }}"
               placeholder="e.g. Alzheimer's, vascular dementia, Lewy-body">
    </div>

    <div class="form-group">
        <label for="care_setting">Care setting</label>
        <select id="care_setting" name="demographics.care_setting">
            <option value="" {% if demographics.careSetting == "" %}selected{% endif %}>&mdash;</option>
            <option value="home-with-family" {% if demographics.careSetting == "home-with-family" %}selected{% endif %}>Home with family carer</option>
            <option value="home-alone" {% if demographics.careSetting == "home-alone" %}selected{% endif %}>Home, lives alone</option>
            <option value="home-with-formal-care" {% if demographics.careSetting == "home-with-formal-care" %}selected{% endif %}>Home with formal care package</option>
            <option value="residential-care" {% if demographics.careSetting == "residential-care" %}selected{% endif %}>Residential care home</option>
            <option value="nursing-home" {% if demographics.careSetting == "nursing-home" %}selected{% endif %}>Nursing home</option>
            <option value="hospital" {% if demographics.careSetting == "hospital" %}selected{% endif %}>Hospital ward</option>
            <option value="other" {% if demographics.careSetting == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
</div>
