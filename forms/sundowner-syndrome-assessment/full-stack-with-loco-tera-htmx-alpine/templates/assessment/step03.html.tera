<div class="card">
    <h2>Step 3: Behavioural Symptoms &mdash; CMAI and NPI</h2>
    <p class="form-hint">
        Cohen-Mansfield Agitation Inventory (29 items, scored 1-7) and
        Neuropsychiatric Inventory (12 domains, frequency &times; severity).
    </p>

    <h3>CMAI &mdash; Agitation Inventory</h3>
    <p class="form-hint">
        1 = Never, 2 = Less than once a week, 3 = Once or twice a week,
        4 = Several times a week, 5 = Once or twice a day,
        6 = Several times a day, 7 = Several times an hour.
    </p>

    {% set cmai_items = [
        [1,  "Pacing or aimless wandering"],
        [2,  "Inappropriate dress or disrobing"],
        [3,  "Spitting (including at meals)"],
        [4,  "Cursing or verbal aggression"],
        [5,  "Constant unwarranted requests for attention or help"],
        [6,  "Repetitive sentences or questions"],
        [7,  "Hitting (including self)"],
        [8,  "Kicking"],
        [9,  "Grabbing onto people"],
        [10, "Pushing"],
        [11, "Throwing things"],
        [12, "Strange noises (weird laughter or crying)"],
        [13, "Screaming"],
        [14, "Biting"],
        [15, "Scratching"],
        [16, "Trying to get to a different place (e.g. out of the room)"],
        [17, "Intentional falling"],
        [18, "Complaining"],
        [19, "Negativism"],
        [20, "Eating or drinking inappropriate substances"],
        [21, "Hurting self or others"],
        [22, "Handling things inappropriately"],
        [23, "Hiding things"],
        [24, "Hoarding things"],
        [25, "Tearing things or destroying property"],
        [26, "Performing repetitive mannerisms"],
        [27, "Making verbal sexual advances"],
        [28, "Making physical sexual advances"],
        [29, "General restlessness"]
    ] %}

    <table class="cmai-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Behaviour</th>
                <th>Rating (1-7)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in cmai_items %}
            {% set n = item[0] %}
            {% set label = item[1] %}
            {% if n < 10 %}{% set id = "cmai0" ~ n %}{% else %}{% set id = "cmai" ~ n %}{% endif %}
            {% set current = behavioural_symptoms.cmai[id] | default(value=0) %}
            <tr>
                <td>{{ n }}</td>
                <td><label for="{{ id }}">{{ label }}</label></td>
                <td>
                    <select id="{{ id }}" name="behavioural_symptoms.cmai.{{ id }}">
                        <option value="0" {% if current == 0 %}selected{% endif %}>&mdash;</option>
                        <option value="1" {% if current == 1 %}selected{% endif %}>1 &mdash; Never</option>
                        <option value="2" {% if current == 2 %}selected{% endif %}>2 &mdash; Less than once a week</option>
                        <option value="3" {% if current == 3 %}selected{% endif %}>3 &mdash; Once or twice a week</option>
                        <option value="4" {% if current == 4 %}selected{% endif %}>4 &mdash; Several times a week</option>
                        <option value="5" {% if current == 5 %}selected{% endif %}>5 &mdash; Once or twice a day</option>
                        <option value="6" {% if current == 6 %}selected{% endif %}>6 &mdash; Several times a day</option>
                        <option value="7" {% if current == 7 %}selected{% endif %}>7 &mdash; Several times an hour</option>
                    </select>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>NPI &mdash; Neuropsychiatric Inventory</h3>
    <p class="form-hint">
        Frequency: 1 = occasional, 2 = often, 3 = frequent, 4 = very frequent / daily.
        Severity: 1 = mild, 2 = moderate, 3 = severe. Domain score = frequency &times; severity.
    </p>

    {% set npi_domains = [
        ["delusions",            "Delusions"],
        ["hallucinations",       "Hallucinations"],
        ["agitationAggression",  "Agitation / aggression"],
        ["depressionDysphoria",  "Depression / dysphoria"],
        ["anxiety",              "Anxiety"],
        ["elationEuphoria",      "Elation / euphoria"],
        ["apathyIndifference",   "Apathy / indifference"],
        ["disinhibition",        "Disinhibition"],
        ["irritabilityLability", "Irritability / lability"],
        ["motorDisturbance",     "Aberrant motor disturbance"],
        ["sleep",                "Sleep / night-time behaviour"],
        ["appetiteEating",       "Appetite / eating change"]
    ] %}

    <table class="npi-table">
        <thead>
            <tr>
                <th>Domain</th>
                <th>Frequency</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for d in npi_domains %}
            {% set key = d[0] %}
            {% set label = d[1] %}
            {% set entry = behavioural_symptoms.npi[key] | default(value=false) %}
            {% if entry %}
                {% set freq = entry.frequency | default(value=0) %}
                {% set sev = entry.severity | default(value=0) %}
            {% else %}
                {% set freq = 0 %}
                {% set sev = 0 %}
            {% endif %}
            <tr>
                <td><label>{{ label }}</label></td>
                <td>
                    <select name="behavioural_symptoms.npi.{{ key }}.frequency">
                        <option value="0" {% if freq == 0 %}selected{% endif %}>&mdash;</option>
                        <option value="1" {% if freq == 1 %}selected{% endif %}>1 &mdash; Occasional</option>
                        <option value="2" {% if freq == 2 %}selected{% endif %}>2 &mdash; Often</option>
                        <option value="3" {% if freq == 3 %}selected{% endif %}>3 &mdash; Frequent</option>
                        <option value="4" {% if freq == 4 %}selected{% endif %}>4 &mdash; Very frequent / daily</option>
                    </select>
                </td>
                <td>
                    <select name="behavioural_symptoms.npi.{{ key }}.severity">
                        <option value="0" {% if sev == 0 %}selected{% endif %}>&mdash;</option>
                        <option value="1" {% if sev == 1 %}selected{% endif %}>1 &mdash; Mild</option>
                        <option value="2" {% if sev == 2 %}selected{% endif %}>2 &mdash; Moderate</option>
                        <option value="3" {% if sev == 3 %}selected{% endif %}>3 &mdash; Severe</option>
                    </select>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="form-group">
        <label for="behavioural_notes">Other behavioural notes</label>
        <textarea id="behavioural_notes" name="behavioural_symptoms.behavioural_notes"
                  placeholder="Anything not captured above&hellip;">{{ behavioural_symptoms.behaviouralNotes }}</textarea>
    </div>
</div>
