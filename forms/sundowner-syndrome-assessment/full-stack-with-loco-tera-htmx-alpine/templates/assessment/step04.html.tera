<div class="card">
    <h2>Step 4: Temporal Pattern Assessment</h2>
    <p class="form-hint">When during the day does sundowning typically occur?</p>

    <div class="form-row">
        <div class="form-group">
            <label for="typical_onset_time">Typical onset time</label>
            <input type="time" id="typical_onset_time" name="temporal_pattern.typical_onset_time"
                   value="{{ temporal_pattern.typicalOnsetTime }}">
        </div>
        <div class="form-group">
            <label for="typical_offset_time">Typical offset / settle time</label>
            <input type="time" id="typical_offset_time" name="temporal_pattern.typical_offset_time"
                   value="{{ temporal_pattern.typicalOffsetTime }}">
        </div>
        <div class="form-group">
            <label for="peak_time">Peak time</label>
            <input type="time" id="peak_time" name="temporal_pattern.peak_time"
                   value="{{ temporal_pattern.peakTime }}">
        </div>
    </div>

    <div class="form-group">
        <label for="episode_frequency">Episode frequency</label>
        <select id="episode_frequency" name="temporal_pattern.episode_frequency">
            <option value="" {% if temporal_pattern.episodeFrequency == "" %}selected{% endif %}>&mdash;</option>
            <option value="none" {% if temporal_pattern.episodeFrequency == "none" %}selected{% endif %}>None</option>
            <option value="occasional" {% if temporal_pattern.episodeFrequency == "occasional" %}selected{% endif %}>Occasional (less than weekly)</option>
            <option value="frequent" {% if temporal_pattern.episodeFrequency == "frequent" %}selected{% endif %}>Frequent (most days)</option>
            <option value="continuous" {% if temporal_pattern.episodeFrequency == "continuous" %}selected{% endif %}>Continuous / daily</option>
        </select>
    </div>

    <div class="form-group">
        <label for="average_duration_minutes">Average duration (minutes)</label>
        <input type="number" min="0" max="1440" id="average_duration_minutes" name="temporal_pattern.average_duration_minutes"
               value="{{ temporal_pattern.averageDurationMinutes }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="worse_at_dusk">Worse around dusk?</label>
            <select id="worse_at_dusk" name="temporal_pattern.worse_at_dusk">
                <option value="" {% if temporal_pattern.worseAtDusk == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if temporal_pattern.worseAtDusk == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if temporal_pattern.worseAtDusk == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="worse_seasonally">Worse seasonally?</label>
            <select id="worse_seasonally" name="temporal_pattern.worse_seasonally">
                <option value="" {% if temporal_pattern.worseSeasonally == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if temporal_pattern.worseSeasonally == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if temporal_pattern.worseSeasonally == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="temporal_notes">Temporal pattern notes</label>
        <textarea id="temporal_notes" name="temporal_pattern.temporal_notes"
                  placeholder="Days of the week, recent changes, weekday vs weekend&hellip;">{{ temporal_pattern.temporalNotes }}</textarea>
    </div>
</div>
