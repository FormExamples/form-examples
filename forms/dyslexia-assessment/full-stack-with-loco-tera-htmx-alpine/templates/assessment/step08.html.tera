<div class="card">
    <h2>Step 8: Emotional &amp; Behavioural Impact</h2>
    <p class="form-hint">Secondary impacts of literacy difficulties.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="low_self_esteem">Low self-esteem?</label>
            <select id="low_self_esteem" name="emotional_behavioural.low_self_esteem">
                <option value="" {% if emotional_behavioural.lowSelfEsteem == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.lowSelfEsteem == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.lowSelfEsteem == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="anxiety_about_school">Anxiety about school?</label>
            <select id="anxiety_about_school" name="emotional_behavioural.anxiety_about_school">
                <option value="" {% if emotional_behavioural.anxietyAboutSchool == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.anxietyAboutSchool == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.anxietyAboutSchool == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="avoidance_behaviour">Avoidance behaviour?</label>
            <select id="avoidance_behaviour" name="emotional_behavioural.avoidance_behaviour">
                <option value="" {% if emotional_behavioural.avoidanceBehaviour == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.avoidanceBehaviour == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.avoidanceBehaviour == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="frustration_with_learning">Frustration with learning?</label>
            <select id="frustration_with_learning" name="emotional_behavioural.frustration_with_learning">
                <option value="" {% if emotional_behavioural.frustrationWithLearning == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.frustrationWithLearning == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.frustrationWithLearning == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="peer_relationship_difficulties">Peer relationship difficulties?</label>
            <select id="peer_relationship_difficulties" name="emotional_behavioural.peer_relationship_difficulties">
                <option value="" {% if emotional_behavioural.peerRelationshipDifficulties == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.peerRelationshipDifficulties == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.peerRelationshipDifficulties == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sleep_disturbance">Sleep disturbance?</label>
            <select id="sleep_disturbance" name="emotional_behavioural.sleep_disturbance">
                <option value="" {% if emotional_behavioural.sleepDisturbance == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if emotional_behavioural.sleepDisturbance == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if emotional_behavioural.sleepDisturbance == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="mental_health_concerns">Mental health concerns?</label>
        <select id="mental_health_concerns" name="emotional_behavioural.mental_health_concerns">
            <option value="" {% if emotional_behavioural.mentalHealthConcerns == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if emotional_behavioural.mentalHealthConcerns == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if emotional_behavioural.mentalHealthConcerns == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    <div class="form-group">
        <label for="mental_health_details">Mental health details</label>
        <textarea id="mental_health_details" name="emotional_behavioural.mental_health_details">{{ emotional_behavioural.mentalHealthDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="behavioural_notes">Behavioural notes</label>
        <textarea id="behavioural_notes" name="emotional_behavioural.behavioural_notes">{{ emotional_behavioural.behaviouralNotes }}</textarea>
    </div>
</div>
