<div class="card">
    <h2>Step 2: Developmental History</h2>
    <p class="form-hint">Pregnancy, birth, early milestones, sensory function, and family history.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="pregnancy_complications">Pregnancy complications?</label>
            <select id="pregnancy_complications" name="developmental_history.pregnancy_complications">
                <option value="" {% if developmental_history.pregnancyComplications == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.pregnancyComplications == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.pregnancyComplications == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.pregnancyComplications == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
        <div class="form-group">
            <label for="birth_complications">Birth complications?</label>
            <select id="birth_complications" name="developmental_history.birth_complications">
                <option value="" {% if developmental_history.birthComplications == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.birthComplications == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.birthComplications == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.birthComplications == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="pregnancy_details">Pregnancy details</label>
        <textarea id="pregnancy_details" name="developmental_history.pregnancy_details">{{ developmental_history.pregnancyDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="birth_details">Birth details</label>
        <textarea id="birth_details" name="developmental_history.birth_details">{{ developmental_history.birthDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="early_milestones">Early milestones (walking, talking)</label>
        <textarea id="early_milestones" name="developmental_history.early_milestones">{{ developmental_history.earlyMilestones }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="speech_delay">Speech delay?</label>
            <select id="speech_delay" name="developmental_history.speech_delay">
                <option value="" {% if developmental_history.speechDelay == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.speechDelay == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.speechDelay == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.speechDelay == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
        <div class="form-group">
            <label for="language_delay">Language delay?</label>
            <select id="language_delay" name="developmental_history.language_delay">
                <option value="" {% if developmental_history.languageDelay == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.languageDelay == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.languageDelay == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.languageDelay == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hearing_problems">Hearing problems?</label>
            <select id="hearing_problems" name="developmental_history.hearing_problems">
                <option value="" {% if developmental_history.hearingProblems == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.hearingProblems == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.hearingProblems == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.hearingProblems == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vision_problems">Vision problems?</label>
            <select id="vision_problems" name="developmental_history.vision_problems">
                <option value="" {% if developmental_history.visionProblems == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if developmental_history.visionProblems == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if developmental_history.visionProblems == "yes" %}selected{% endif %}>Yes</option>
                <option value="unsure" {% if developmental_history.visionProblems == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="family_history_dyslexia">Family history of dyslexia?</label>
        <select id="family_history_dyslexia" name="developmental_history.family_history_dyslexia">
            <option value="" {% if developmental_history.familyHistoryDyslexia == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if developmental_history.familyHistoryDyslexia == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if developmental_history.familyHistoryDyslexia == "yes" %}selected{% endif %}>Yes</option>
            <option value="unsure" {% if developmental_history.familyHistoryDyslexia == "unsure" %}selected{% endif %}>Unsure</option>
        </select>
    </div>
    <div class="form-group">
        <label for="family_history_details">Family history details</label>
        <textarea id="family_history_details" name="developmental_history.family_history_details">{{ developmental_history.familyHistoryDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="other_developmental_notes">Other developmental notes</label>
        <textarea id="other_developmental_notes" name="developmental_history.other_developmental_notes">{{ developmental_history.otherDevelopmentalNotes }}</textarea>
    </div>
</div>
