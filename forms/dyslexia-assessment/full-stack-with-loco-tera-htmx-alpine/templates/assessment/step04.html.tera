<div class="card">
    <h2>Step 4: Reading Assessment</h2>
    <p class="form-hint">Standardised reading scores (mean 100, SD 15) and observational indicators.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="reading_fluency_score">Reading fluency standardised score (DYS-001)</label>
            <input type="number" min="40" max="160" id="reading_fluency_score"
                   name="reading_assessment.reading_fluency_score"
                   value="{{ reading_assessment.readingFluencyScore }}">
        </div>
        <div class="form-group">
            <label for="reading_comprehension_score">Reading comprehension standardised score (DYS-002)</label>
            <input type="number" min="40" max="160" id="reading_comprehension_score"
                   name="reading_assessment.reading_comprehension_score"
                   value="{{ reading_assessment.readingComprehensionScore }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="difficulty_decoding">Difficulty decoding words?</label>
            <select id="difficulty_decoding" name="reading_assessment.difficulty_decoding">
                <option value="" {% if reading_assessment.difficultyDecoding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reading_assessment.difficultyDecoding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reading_assessment.difficultyDecoding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="difficulty_comprehension">Difficulty with comprehension?</label>
            <select id="difficulty_comprehension" name="reading_assessment.difficulty_comprehension">
                <option value="" {% if reading_assessment.difficultyComprehension == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reading_assessment.difficultyComprehension == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reading_assessment.difficultyComprehension == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="avoids_reading">Avoids reading?</label>
            <select id="avoids_reading" name="reading_assessment.avoids_reading">
                <option value="" {% if reading_assessment.avoidsReading == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reading_assessment.avoidsReading == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reading_assessment.avoidsReading == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="slow_reading_speed">Slow reading speed?</label>
            <select id="slow_reading_speed" name="reading_assessment.slow_reading_speed">
                <option value="" {% if reading_assessment.slowReadingSpeed == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reading_assessment.slowReadingSpeed == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reading_assessment.slowReadingSpeed == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="loses_place_when_reading">Loses place when reading?</label>
            <select id="loses_place_when_reading" name="reading_assessment.loses_place_when_reading">
                <option value="" {% if reading_assessment.losesPlaceWhenReading == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reading_assessment.losesPlaceWhenReading == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reading_assessment.losesPlaceWhenReading == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="reading_notes">Reading notes</label>
        <textarea id="reading_notes" name="reading_assessment.reading_notes">{{ reading_assessment.readingNotes }}</textarea>
    </div>
</div>
