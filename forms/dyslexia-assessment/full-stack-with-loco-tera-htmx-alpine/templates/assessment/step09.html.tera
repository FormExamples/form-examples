<div class="card">
    <h2>Step 9: Previous Support &amp; Interventions</h2>
    <p class="form-hint">Existing intervention, accommodations, and assistive technology.</p>

    <div class="form-group">
        <label for="previous_intervention">Previous intervention?</label>
        <select id="previous_intervention" name="previous_support.previous_intervention">
            <option value="" {% if previous_support.previousIntervention == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if previous_support.previousIntervention == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if previous_support.previousIntervention == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    <div class="form-group">
        <label for="intervention_types">Intervention types</label>
        <textarea id="intervention_types" name="previous_support.intervention_types">{{ previous_support.interventionTypes }}</textarea>
    </div>

    <div class="form-group">
        <label for="current_ehcp_or_iep">Current EHCP or IEP?</label>
        <select id="current_ehcp_or_iep" name="previous_support.current_ehcp_or_iep">
            <option value="" {% if previous_support.currentEhcpOrIep == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if previous_support.currentEhcpOrIep == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if previous_support.currentEhcpOrIep == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    <div class="form-group">
        <label for="ehcp_details">EHCP / IEP details</label>
        <textarea id="ehcp_details" name="previous_support.ehcp_details">{{ previous_support.ehcpDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="access_arrangements">Exam access arrangements?</label>
            <select id="access_arrangements" name="previous_support.access_arrangements">
                <option value="" {% if previous_support.accessArrangements == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_support.accessArrangements == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_support.accessArrangements == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tutorial_support">Tutorial support?</label>
            <select id="tutorial_support" name="previous_support.tutorial_support">
                <option value="" {% if previous_support.tutorialSupport == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_support.tutorialSupport == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_support.tutorialSupport == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="assistive_technology_used">Assistive technology used?</label>
            <select id="assistive_technology_used" name="previous_support.assistive_technology_used">
                <option value="" {% if previous_support.assistiveTechnologyUsed == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_support.assistiveTechnologyUsed == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_support.assistiveTechnologyUsed == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="assistive_technology_details">Assistive technology details</label>
        <textarea id="assistive_technology_details" name="previous_support.assistive_technology_details">{{ previous_support.assistiveTechnologyDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="previous_support_notes">Previous support notes</label>
        <textarea id="previous_support_notes" name="previous_support.previous_support_notes">{{ previous_support.previousSupportNotes }}</textarea>
    </div>
</div>
