<div class="card">
    <h2>Step 10: Recommendations &amp; Support Plan</h2>
    <p class="form-hint">Proposed supports, accommodations, and review timeframe.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="structured_literacy_recommended">Structured literacy intervention?</label>
            <select id="structured_literacy_recommended" name="recommendations_support_plan.structured_literacy_recommended">
                <option value="" {% if recommendations_support_plan.structuredLiteracyRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recommendations_support_plan.structuredLiteracyRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recommendations_support_plan.structuredLiteracyRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="assistive_tech_recommended">Assistive technology?</label>
            <select id="assistive_tech_recommended" name="recommendations_support_plan.assistive_tech_recommended">
                <option value="" {% if recommendations_support_plan.assistiveTechRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recommendations_support_plan.assistiveTechRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recommendations_support_plan.assistiveTechRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="extra_time_recommended">Extra time?</label>
            <select id="extra_time_recommended" name="recommendations_support_plan.extra_time_recommended">
                <option value="" {% if recommendations_support_plan.extraTimeRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recommendations_support_plan.extraTimeRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recommendations_support_plan.extraTimeRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="specialist_assessment_recommended">Specialist assessment?</label>
            <select id="specialist_assessment_recommended" name="recommendations_support_plan.specialist_assessment_recommended">
                <option value="" {% if recommendations_support_plan.specialistAssessmentRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recommendations_support_plan.specialistAssessmentRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recommendations_support_plan.specialistAssessmentRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="parent_training_recommended">Parent training?</label>
            <select id="parent_training_recommended" name="recommendations_support_plan.parent_training_recommended">
                <option value="" {% if recommendations_support_plan.parentTrainingRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if recommendations_support_plan.parentTrainingRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if recommendations_support_plan.parentTrainingRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="key_goals">Key goals</label>
        <textarea id="key_goals" name="recommendations_support_plan.key_goals">{{ recommendations_support_plan.keyGoals }}</textarea>
    </div>
    <div class="form-group">
        <label for="review_timeframe">Review timeframe</label>
        <input type="text" id="review_timeframe" name="recommendations_support_plan.review_timeframe"
               value="{{ recommendations_support_plan.reviewTimeframe }}" placeholder="e.g. 6 months">
    </div>
    <div class="form-group">
        <label for="additional_recommendations">Additional recommendations</label>
        <textarea id="additional_recommendations" name="recommendations_support_plan.additional_recommendations">{{ recommendations_support_plan.additionalRecommendations }}</textarea>
    </div>
</div>
