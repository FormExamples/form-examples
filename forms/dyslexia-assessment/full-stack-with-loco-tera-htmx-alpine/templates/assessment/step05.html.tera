<div class="card">
    <h2>Step 5: Writing &amp; Spelling Assessment</h2>
    <p class="form-hint">Standardised spelling and writing scores plus observational indicators.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="spelling_accuracy_score">Spelling accuracy standardised score (DYS-003)</label>
            <input type="number" min="40" max="160" id="spelling_accuracy_score"
                   name="writing_spelling.spelling_accuracy_score"
                   value="{{ writing_spelling.spellingAccuracyScore }}">
        </div>
        <div class="form-group">
            <label for="written_expression_score">Written expression standardised score (DYS-004)</label>
            <input type="number" min="40" max="160" id="written_expression_score"
                   name="writing_spelling.written_expression_score"
                   value="{{ writing_spelling.writtenExpressionScore }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="difficulty_spelling">Difficulty spelling?</label>
            <select id="difficulty_spelling" name="writing_spelling.difficulty_spelling">
                <option value="" {% if writing_spelling.difficultySpelling == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if writing_spelling.difficultySpelling == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if writing_spelling.difficultySpelling == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="difficulty_handwriting">Difficulty with handwriting?</label>
            <select id="difficulty_handwriting" name="writing_spelling.difficulty_handwriting">
                <option value="" {% if writing_spelling.difficultyHandwriting == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if writing_spelling.difficultyHandwriting == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if writing_spelling.difficultyHandwriting == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="difficulty_organising_ideas">Difficulty organising ideas?</label>
            <select id="difficulty_organising_ideas" name="writing_spelling.difficulty_organising_ideas">
                <option value="" {% if writing_spelling.difficultyOrganisingIdeas == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if writing_spelling.difficultyOrganisingIdeas == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if writing_spelling.difficultyOrganisingIdeas == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="omits_letters_or_words">Omits letters or words?</label>
            <select id="omits_letters_or_words" name="writing_spelling.omits_letters_or_words">
                <option value="" {% if writing_spelling.omitsLettersOrWords == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if writing_spelling.omitsLettersOrWords == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if writing_spelling.omitsLettersOrWords == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reverses_letters_or_numbers">Reverses letters or numbers?</label>
            <select id="reverses_letters_or_numbers" name="writing_spelling.reverses_letters_or_numbers">
                <option value="" {% if writing_spelling.reversesLettersOrNumbers == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if writing_spelling.reversesLettersOrNumbers == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if writing_spelling.reversesLettersOrNumbers == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="writing_notes">Writing notes</label>
        <textarea id="writing_notes" name="writing_spelling.writing_notes">{{ writing_spelling.writingNotes }}</textarea>
    </div>
</div>
