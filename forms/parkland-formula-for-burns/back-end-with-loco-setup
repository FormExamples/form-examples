#!/bin/sh
set -euf

form_kebab_case=parkland-formula-for-burns
form_snake_case=parkland_formula_for_burns

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold parkland_formula_for_burns \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    care_setting:string! \
    assessed_at:tstz \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    weight_kg:double \
    tbsa_percent:double \
    tbsa_method:string! \
    injury_at:tstz \
    injury_time_known:string! \
    inhalation_suspected:string! \
    circumferential_or_deep:string! \
    mechanism:string! \
    --api

cargo loco generate scaffold parkland_formula_for_burns_grade \
    deleted_at:tstz \
    parkland_formula_for_burns:references \
    total_24h_volume_ml:double \
    first_8h_volume_ml:double \
    next_16h_volume_ml:double \
    hours_since_injury:double \
    remaining_first_8h_hours:double \
    first_8h_rate_ml_h:double \
    next_16h_rate_ml_h:double \
    urine_output_target_min_ml_h:double \
    urine_output_target_max_ml_h:double \
    graded_at:tstz! \
    --api

cargo loco generate scaffold parkland_formula_for_burns_grade_rule \
    deleted_at:tstz \
    parkland_formula_for_burns_grade:references \
    rule_id:string! \
    instrument:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold parkland_formula_for_burns_grade_flag \
    deleted_at:tstz \
    parkland_formula_for_burns_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
