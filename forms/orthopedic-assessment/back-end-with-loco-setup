#!/bin/sh
set -euf

form_kebab_case=orthopedic-assessment
form_snake_case=orthopedic_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold assessment \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold assessment_range_of_motion \
    deleted_at:tstz \
    assessment:references \
    joint_assessed:string! \
    side_assessed:string! \
    overall_rom_status:string! \
    range_of_motion_notes:text! \
    --api

cargo loco generate scaffold assessment_rom_measurement \
    deleted_at:tstz \
    range_of_motion:references \
    movement:string! \
    active_degrees:int \
    passive_degrees:int \
    normal_degrees:int \
    end_feel:string! \
    pain_on_movement:string! \
    sort_order:int! \
    --api

cargo loco generate scaffold assessment_strength_testing \
    deleted_at:tstz \
    assessment:references \
    grip_strength_affected_kg:double \
    grip_strength_unaffected_kg:double \
    overall_strength_status:string! \
    strength_testing_notes:text! \
    --api

cargo loco generate scaffold assessment_strength_test_item \
    deleted_at:tstz \
    strength_testing:references \
    muscle_group:string! \
    movement:string! \
    mrc_grade:int \
    pain_on_testing:string! \
    sort_order:int! \
    --api

cargo loco generate scaffold assessment_imaging_history \
    deleted_at:tstz \
    assessment:references \
    has_previous_imaging:string! \
    imaging_requested:string! \
    imaging_requested_details:text! \
    imaging_notes:text! \
    --api

cargo loco generate scaffold assessment_imaging_item \
    deleted_at:tstz \
    imaging_history:references \
    modality:string! \
    body_region:string! \
    date_performed:date \
    findings:text! \
    sort_order:int! \
    --api

cargo loco generate scaffold grading_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api

cargo loco generate scaffold assessment_surgical_history \
    deleted_at:tstz \
    assessment:references \
    has_previous_surgery:string! \
    surgery_considered:string! \
    surgery_considered_details:text! \
    patient_preference:string! \
    comorbidities_affecting_surgery:text! \
    anaesthetic_risk:string! \
    anticoagulant_use:string! \
    anticoagulant_details:text! \
    surgical_history_notes:text! \
    --api

cargo loco generate scaffold assessment_surgery_item \
    deleted_at:tstz \
    surgical_history:references \
    procedure_name:string! \
    date_performed:date \
    surgeon:string! \
    hospital:string! \
    outcome:string! \
    outcome_details:text! \
    sort_order:int! \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    assessment:references \
    dash_score:double! \
    disability_category:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold grading_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --api
