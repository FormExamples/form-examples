<div class="card">
    <h2>Step 5: Contributing Factors</h2>
    <p class="form-hint">Human, system, and environmental factors that contributed to the error.</p>

    {% set factors = [
        ["staff_fatigue", "Staff fatigue", contributing_factors.staffFatigue],
        ["inadequate_training", "Inadequate training", contributing_factors.inadequateTraining],
        ["communication_failure", "Communication failure", contributing_factors.communicationFailure],
        ["handover_failure", "Handover failure", contributing_factors.handoverFailure],
        ["equipment_failure", "Equipment failure", contributing_factors.equipmentFailure],
        ["environmental_factors", "Environmental factors", contributing_factors.environmentalFactors],
        ["policy_not_followed", "Policy / protocol not followed", contributing_factors.policyNotFollowed],
        ["workload_pressure", "Workload pressure", contributing_factors.workloadPressure],
        ["patient_factors", "Patient factors", contributing_factors.patientFactors]
    ] %}

    {% for f in factors %}
    <div class="form-group">
        <label for="contributing_factors_{{ f[0] }}">{{ f[1] }} contributed?</label>
        <select id="contributing_factors_{{ f[0] }}" name="contributing_factors.{{ f[0] }}">
            <option value="" {% if f[2] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if f[2] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if f[2] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="contributing_factors_communication_failure_details">Communication failure details</label>
        <textarea id="contributing_factors_communication_failure_details" name="contributing_factors.communication_failure_details" rows="2">{{ contributing_factors.communicationFailureDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="contributing_factors_equipment_failure_details">Equipment failure details</label>
        <textarea id="contributing_factors_equipment_failure_details" name="contributing_factors.equipment_failure_details" rows="2">{{ contributing_factors.equipmentFailureDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="contributing_factors_environmental_details">Environmental details</label>
        <textarea id="contributing_factors_environmental_details" name="contributing_factors.environmental_details" rows="2">{{ contributing_factors.environmentalDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="contributing_factors_policy_details">Policy / protocol details</label>
        <textarea id="contributing_factors_policy_details" name="contributing_factors.policy_details" rows="2">{{ contributing_factors.policyDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="contributing_factors_patient_factors_details">Patient factor details</label>
        <textarea id="contributing_factors_patient_factors_details" name="contributing_factors.patient_factors_details" rows="2">{{ contributing_factors.patientFactorsDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="contributing_factors_other_factors">Other contributing factors</label>
        <textarea id="contributing_factors_other_factors" name="contributing_factors.other_factors" rows="3">{{ contributing_factors.otherFactors }}</textarea>
    </div>
</div>
