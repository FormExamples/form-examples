<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Reporter information and facility details.</p>

    <div class="form-group">
        <label for="demographics_anonymous_report">Submit this report anonymously?</label>
        <select id="demographics_anonymous_report" name="demographics.anonymous_report">
            <option value="" {% if demographics.anonymousReport == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if demographics.anonymousReport == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if demographics.anonymousReport == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_reporter_first_name">Reporter First Name</label>
            <input type="text" id="demographics_reporter_first_name" name="demographics.reporter_first_name"
                   value="{{ demographics.reporterFirstName }}">
        </div>
        <div class="form-group">
            <label for="demographics_reporter_last_name">Reporter Last Name</label>
            <input type="text" id="demographics_reporter_last_name" name="demographics.reporter_last_name"
                   value="{{ demographics.reporterLastName }}">
        </div>
    </div>

    <div class="form-group">
        <label for="demographics_reporter_role">Reporter Role</label>
        <select id="demographics_reporter_role" name="demographics.reporter_role">
            <option value="" {% if demographics.reporterRole == "" %}selected{% endif %}>&mdash;</option>
            <option value="doctor" {% if demographics.reporterRole == "doctor" %}selected{% endif %}>Doctor</option>
            <option value="nurse" {% if demographics.reporterRole == "nurse" %}selected{% endif %}>Nurse</option>
            <option value="pharmacist" {% if demographics.reporterRole == "pharmacist" %}selected{% endif %}>Pharmacist</option>
            <option value="allied-health" {% if demographics.reporterRole == "allied-health" %}selected{% endif %}>Allied Health</option>
            <option value="administrator" {% if demographics.reporterRole == "administrator" %}selected{% endif %}>Administrator</option>
            <option value="patient" {% if demographics.reporterRole == "patient" %}selected{% endif %}>Patient</option>
            <option value="other" {% if demographics.reporterRole == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>

    <div class="form-group">
        <label for="demographics_reporter_department">Department</label>
        <input type="text" id="demographics_reporter_department" name="demographics.reporter_department"
               value="{{ demographics.reporterDepartment }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_reporter_contact_phone">Contact Phone</label>
            <input type="tel" id="demographics_reporter_contact_phone" name="demographics.reporter_contact_phone"
                   value="{{ demographics.reporterContactPhone }}">
        </div>
        <div class="form-group">
            <label for="demographics_reporter_contact_email">Contact Email</label>
            <input type="email" id="demographics_reporter_contact_email" name="demographics.reporter_contact_email"
                   value="{{ demographics.reporterContactEmail }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_facility_name">Facility Name</label>
            <input type="text" id="demographics_facility_name" name="demographics.facility_name"
                   value="{{ demographics.facilityName }}">
        </div>
        <div class="form-group">
            <label for="demographics_facility_ward">Ward / Unit</label>
            <input type="text" id="demographics_facility_ward" name="demographics.facility_ward"
                   value="{{ demographics.facilityWard }}">
        </div>
        <div class="form-group">
            <label for="demographics_report_date">Report Date</label>
            <input type="date" id="demographics_report_date" name="demographics.report_date"
                   value="{{ demographics.reportDate }}">
        </div>
    </div>
</div>
