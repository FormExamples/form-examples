<div class="card">
    <h2>Step 7: Patient Outcome</h2>
    <p class="form-hint">Harm reaching the patient and downstream consequences.</p>

    <div class="form-group">
        <label for="patient_outcome_harm_reached_patient">Did harm reach the patient?</label>
        <select id="patient_outcome_harm_reached_patient" name="patient_outcome.harm_reached_patient">
            <option value="" {% if patient_outcome.harmReachedPatient == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if patient_outcome.harmReachedPatient == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if patient_outcome.harmReachedPatient == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="patient_outcome_harm_level">Harm Level</label>
        <select id="patient_outcome_harm_level" name="patient_outcome.harm_level">
            <option value="" {% if patient_outcome.harmLevel == "" %}selected{% endif %}>&mdash;</option>
            <option value="none" {% if patient_outcome.harmLevel == "none" %}selected{% endif %}>None</option>
            <option value="low" {% if patient_outcome.harmLevel == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if patient_outcome.harmLevel == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if patient_outcome.harmLevel == "severe" %}selected{% endif %}>Severe</option>
            <option value="death" {% if patient_outcome.harmLevel == "death" %}selected{% endif %}>Death</option>
        </select>
    </div>

    <div class="form-group">
        <label for="patient_outcome_harm_description">Harm description</label>
        <textarea id="patient_outcome_harm_description" name="patient_outcome.harm_description" rows="3">{{ patient_outcome.harmDescription }}</textarea>
    </div>

    <div class="form-group">
        <label for="patient_outcome_additional_treatment_required">Additional treatment required?</label>
        <select id="patient_outcome_additional_treatment_required" name="patient_outcome.additional_treatment_required">
            <option value="" {% if patient_outcome.additionalTreatmentRequired == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if patient_outcome.additionalTreatmentRequired == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if patient_outcome.additionalTreatmentRequired == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="patient_outcome_additional_treatment_details">Additional treatment details</label>
        <textarea id="patient_outcome_additional_treatment_details" name="patient_outcome.additional_treatment_details" rows="2">{{ patient_outcome.additionalTreatmentDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_outcome_extended_hospital_stay">Extended hospital stay?</label>
            <select id="patient_outcome_extended_hospital_stay" name="patient_outcome.extended_hospital_stay">
                <option value="" {% if patient_outcome.extendedHospitalStay == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_outcome.extendedHospitalStay == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_outcome.extendedHospitalStay == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_outcome_extra_days">Extra days</label>
            <input type="number" id="patient_outcome_extra_days" name="patient_outcome.extra_days"
                   value="{% if patient_outcome.extraDays %}{{ patient_outcome.extraDays }}{% endif %}" min="0" max="365">
        </div>
        <div class="form-group">
            <label for="patient_outcome_readmission_required">Readmission required?</label>
            <select id="patient_outcome_readmission_required" name="patient_outcome.readmission_required">
                <option value="" {% if patient_outcome.readmissionRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_outcome.readmissionRequired == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_outcome.readmissionRequired == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="patient_outcome_permanent_disability">Permanent disability?</label>
        <select id="patient_outcome_permanent_disability" name="patient_outcome.permanent_disability">
            <option value="" {% if patient_outcome.permanentDisability == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if patient_outcome.permanentDisability == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if patient_outcome.permanentDisability == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="patient_outcome_disability_details">Disability details</label>
        <textarea id="patient_outcome_disability_details" name="patient_outcome.disability_details" rows="2">{{ patient_outcome.disabilityDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_outcome_patient_died">Did the patient die?</label>
            <select id="patient_outcome_patient_died" name="patient_outcome.patient_died">
                <option value="" {% if patient_outcome.patientDied == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_outcome.patientDied == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_outcome.patientDied == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_outcome_death_date">Date of death</label>
            <input type="date" id="patient_outcome_death_date" name="patient_outcome.death_date"
                   value="{{ patient_outcome.deathDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="patient_outcome_outcome_notes">Outcome notes</label>
        <textarea id="patient_outcome_outcome_notes" name="patient_outcome.outcome_notes" rows="3">{{ patient_outcome.outcomeNotes }}</textarea>
    </div>
</div>
