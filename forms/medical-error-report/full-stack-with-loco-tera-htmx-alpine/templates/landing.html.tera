{% extends "base.html.tera" %}

{% block title %}Medical Error Report - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Medical Error Report</h1>
        <p class="landing-description">
            Medical error reporting form for incident documentation, root cause analysis, and patient
            safety improvement. Classifies events using the <strong>WHO Severity Scale</strong>
            (Near Miss &mdash; Mild &mdash; Moderate &mdash; Severe &mdash; Critical) and the
            <strong>NCC MERP Harm Categories</strong> (A through I).
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Demographics, Incident, Patient, Classification, Contributing factors, Immediate actions, Outcome, RCA, Corrective actions, Reporting</p>
            </div>
            <div class="feature">
                <h3>Pure Grading Engine</h3>
                <p>Reproducible risk classification combining WHO severity, NCC MERP category, and grade-weighted rules</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for patient death, permanent disability, duty-of-candour gaps, preventable errors, and recurring incidents</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Report
            </button>
        </form>
    </div>
</div>
{% endblock %}
