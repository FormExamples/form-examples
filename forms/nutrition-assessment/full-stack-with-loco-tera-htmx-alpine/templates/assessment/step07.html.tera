<div class="card">
    <h2>Step 7: Food Allergies &amp; Intolerances</h2>
    <p class="form-hint">Document food allergies and intolerances. Add up to six allergy rows and six intolerance rows.</p>

    <h3>Food allergies</h3>
    {% for i in range(end=6) %}
    <fieldset class="allergy-row">
        <legend>Allergy {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="food_allergies_{{ i }}_allergen">Allergen</label>
                <input type="text" id="food_allergies_{{ i }}_allergen"
                       name="food_allergies[{{ i }}].allergen"
                       value="{% if food_allergies_intolerances.foodAllergies | length > i %}{{ food_allergies_intolerances.foodAllergies[i].allergen }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="food_allergies_{{ i }}_reaction">Reaction</label>
                <input type="text" id="food_allergies_{{ i }}_reaction"
                       name="food_allergies[{{ i }}].reaction"
                       value="{% if food_allergies_intolerances.foodAllergies | length > i %}{{ food_allergies_intolerances.foodAllergies[i].reaction }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="food_allergies_{{ i }}_severity">Severity</label>
                {% set sev = "" %}{% if food_allergies_intolerances.foodAllergies | length > i %}{% set_global sev = food_allergies_intolerances.foodAllergies[i].severity %}{% endif %}
                <select id="food_allergies_{{ i }}_severity" name="food_allergies[{{ i }}].severity">
                    <option value="" {% if sev == "" %}selected{% endif %}>&mdash;</option>
                    <option value="mild" {% if sev == "mild" %}selected{% endif %}>Mild</option>
                    <option value="moderate" {% if sev == "moderate" %}selected{% endif %}>Moderate</option>
                    <option value="anaphylaxis" {% if sev == "anaphylaxis" %}selected{% endif %}>Anaphylaxis</option>
                </select>
            </div>
        </div>
    </fieldset>
    {% endfor %}

    <h3>Food intolerances</h3>
    {% for i in range(end=6) %}
    <div class="form-group">
        <label for="food_intolerances_{{ i }}">Intolerance {{ i + 1 }}</label>
        <input type="text" id="food_intolerances_{{ i }}"
               name="food_intolerances[{{ i }}]"
               value="{% if food_allergies_intolerances.foodIntolerances | length > i %}{{ food_allergies_intolerances.foodIntolerances[i] }}{% endif %}"
               placeholder="e.g. lactose, FODMAPs">
    </div>
    {% endfor %}

    <div class="form-row">
        <div class="form-group">
            <label for="lactose_intolerance">Lactose intolerance?</label>
            <select id="lactose_intolerance" name="food_allergies_intolerances.lactose_intolerance">
                <option value="" {% if food_allergies_intolerances.lactoseIntolerance == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if food_allergies_intolerances.lactoseIntolerance == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if food_allergies_intolerances.lactoseIntolerance == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="gluten_intolerance">Gluten intolerance / coeliac?</label>
            <select id="gluten_intolerance" name="food_allergies_intolerances.gluten_intolerance">
                <option value="" {% if food_allergies_intolerances.glutenIntolerance == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if food_allergies_intolerances.glutenIntolerance == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if food_allergies_intolerances.glutenIntolerance == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="allergy_testing_done">Formal allergy testing done?</label>
        <select id="allergy_testing_done" name="food_allergies_intolerances.allergy_testing_done">
            <option value="" {% if food_allergies_intolerances.allergyTestingDone == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if food_allergies_intolerances.allergyTestingDone == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if food_allergies_intolerances.allergyTestingDone == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="allergy_test_results">Allergy test results</label>
        <textarea id="allergy_test_results" name="food_allergies_intolerances.allergy_test_results">{{ food_allergies_intolerances.allergyTestResults }}</textarea>
    </div>
</div>
