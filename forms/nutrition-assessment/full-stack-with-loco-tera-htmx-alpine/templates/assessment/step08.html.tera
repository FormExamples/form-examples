<div class="card">
    <h2>Step 8: Nutritional Requirements</h2>
    <p class="form-hint">Estimated daily energy, protein, and fluid requirements.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="estimated_energy_kcal">Estimated energy (kcal/day)</label>
            <input type="number" min="0" max="6000" id="estimated_energy_kcal"
                   name="nutritional_requirements.estimated_energy_kcal"
                   value="{{ nutritional_requirements.estimatedEnergyKcal }}">
        </div>
        <div class="form-group">
            <label for="estimated_protein_g">Estimated protein (g/day)</label>
            <input type="number" step="0.1" min="0" max="500" id="estimated_protein_g"
                   name="nutritional_requirements.estimated_protein_g"
                   value="{{ nutritional_requirements.estimatedProteinG }}">
        </div>
        <div class="form-group">
            <label for="estimated_fluid_ml">Estimated fluid (ml/day)</label>
            <input type="number" min="0" max="10000" id="estimated_fluid_ml"
                   name="nutritional_requirements.estimated_fluid_ml"
                   value="{{ nutritional_requirements.estimatedFluidMl }}">
        </div>
    </div>

    <div class="form-group">
        <label for="requirements_basis">How were these requirements estimated?</label>
        <textarea id="requirements_basis" name="nutritional_requirements.requirements_basis"
                  placeholder="e.g. Schofield equation, body-weight rule...">{{ nutritional_requirements.requirementsBasis }}</textarea>
    </div>

    <div class="form-group">
        <label for="increased_requirements">Requirements increased above baseline?</label>
        <select id="increased_requirements" name="nutritional_requirements.increased_requirements">
            <option value="" {% if nutritional_requirements.increasedRequirements == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if nutritional_requirements.increasedRequirements == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if nutritional_requirements.increasedRequirements == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="increased_requirements_reason">Reason for increased requirements</label>
        <textarea id="increased_requirements_reason" name="nutritional_requirements.increased_requirements_reason"
                  placeholder="e.g. wound healing, sepsis, burns, pregnancy...">{{ nutritional_requirements.increasedRequirementsReason }}</textarea>
    </div>
</div>
