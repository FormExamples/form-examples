<div class="card">
    <h2>Step 6: Gastrointestinal Function</h2>
    <p class="form-hint">Symptoms that may interfere with appetite, intake, or nutrient absorption.</p>

    {% set g = gastrointestinal_function %}
    {% set gi_fields = [
      ["nausea", "Nausea?", g.nausea],
      ["vomiting", "Vomiting?", g.vomiting],
      ["diarrhea", "Diarrhoea?", g.diarrhea],
      ["constipation", "Constipation?", g.constipation],
      ["abdominal_pain", "Abdominal pain?", g.abdominalPain],
      ["bloating", "Bloating?", g.bloating],
      ["reflux", "Reflux / heartburn?", g.reflux],
      ["earlysatiety", "Early satiety (feeling full quickly)?", g.earlysatiety]
    ] %}
    {% for f in gi_fields %}
    <div class="form-group">
        <label for="{{ f[0] }}">{{ f[1] }}</label>
        <select id="{{ f[0] }}" name="gastrointestinal_function.{{ f[0] }}">
            <option value="" {% if f[2] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if f[2] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if f[2] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="bowel_habit_notes">Bowel-habit notes</label>
        <textarea id="bowel_habit_notes" name="gastrointestinal_function.bowel_habit_notes">{{ g.bowelHabitNotes }}</textarea>
    </div>
</div>
