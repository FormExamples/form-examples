<div class="card">
    <h2>Step 2: Anthropometric Measurements</h2>
    <p class="form-hint">
        Current weight, height, recent weight change, and other body-composition measures.
        BMI and weight-loss % are auto-calculated server-side on submit.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="weight_kg">Current weight (kg)</label>
            <input type="number" step="0.1" min="1" max="400" id="weight_kg"
                   name="anthropometric_measurements.weight_kg"
                   value="{{ anthropometric_measurements.weightKg }}">
        </div>
        <div class="form-group">
            <label for="height_cm">Height (cm)</label>
            <input type="number" step="0.1" min="50" max="250" id="height_cm"
                   name="anthropometric_measurements.height_cm"
                   value="{{ anthropometric_measurements.heightCm }}">
        </div>
        <div class="form-group">
            <label>BMI (auto)</label>
            <div class="readout-value">
                {% if anthropometric_measurements.bmi %}{{ anthropometric_measurements.bmi }}{% else %}&mdash;{% endif %}
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="usual_weight_kg">Usual stable weight (kg)</label>
            <input type="number" step="0.1" min="1" max="400" id="usual_weight_kg"
                   name="anthropometric_measurements.usual_weight_kg"
                   value="{{ anthropometric_measurements.usualWeightKg }}">
        </div>
        <div class="form-group">
            <label for="weight_loss_kg">Unplanned weight loss (kg, 3-6 mo)</label>
            <input type="number" step="0.1" min="0" max="200" id="weight_loss_kg"
                   name="anthropometric_measurements.weight_loss_kg"
                   value="{{ anthropometric_measurements.weightLossKg }}">
        </div>
        <div class="form-group">
            <label>Weight loss % (auto)</label>
            <div class="readout-value">
                {% if anthropometric_measurements.weightLossPercent %}{{ anthropometric_measurements.weightLossPercent }}%{% else %}&mdash;{% endif %}
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="mid_upper_arm_circumference_cm">MUAC (cm)</label>
            <input type="number" step="0.1" min="0" max="100" id="mid_upper_arm_circumference_cm"
                   name="anthropometric_measurements.mid_upper_arm_circumference_cm"
                   value="{{ anthropometric_measurements.midUpperArmCircumferenceCm }}">
        </div>
        <div class="form-group">
            <label for="triceps_skinfold_mm">Triceps skinfold (mm)</label>
            <input type="number" step="0.1" min="0" max="100" id="triceps_skinfold_mm"
                   name="anthropometric_measurements.triceps_skinfold_mm"
                   value="{{ anthropometric_measurements.tricepsSkinfoldMm }}">
        </div>
        <div class="form-group">
            <label for="measurement_date">Measurement date</label>
            <input type="date" id="measurement_date"
                   name="anthropometric_measurements.measurement_date"
                   value="{{ anthropometric_measurements.measurementDate }}">
        </div>
    </div>
</div>
