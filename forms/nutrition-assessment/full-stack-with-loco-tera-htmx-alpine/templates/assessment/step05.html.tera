<div class="card">
    <h2>Step 5: Swallowing &amp; Oral Health</h2>
    <p class="form-hint">Difficulties with swallowing, chewing, or oral health.</p>

    {% set s = swallowing_oral_health %}
    {% set yes_no_fields = [
      ["swallowing_difficulty", "Difficulty swallowing?", s.swallowingDifficulty],
      ["coughing_while_eating", "Cough while eating or drinking?", s.coughingWhileEating],
      ["choking_episodes", "Episodes of choking?", s.chokingEpisodes],
      ["denture_use", "Wear dentures?", s.dentureUse],
      ["dentures_fit_well", "Dentures fit well?", s.denturesFitWell],
      ["dental_pain", "Dental pain?", s.dentalPain],
      ["mouth_sores", "Mouth sores or ulcers?", s.mouthSores],
      ["dry_mouth", "Dry mouth?", s.dryMouth],
      ["taste_changes", "Taste changes?", s.tasteChanges]
    ] %}
    {% for f in yes_no_fields %}
    <div class="form-group">
        <label for="{{ f[0] }}">{{ f[1] }}</label>
        <select id="{{ f[0] }}" name="swallowing_oral_health.{{ f[0] }}">
            <option value="" {% if f[2] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if f[2] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if f[2] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="swallowing_notes">Additional notes</label>
        <textarea id="swallowing_notes" name="swallowing_oral_health.swallowing_notes">{{ s.swallowingNotes }}</textarea>
    </div>
</div>
