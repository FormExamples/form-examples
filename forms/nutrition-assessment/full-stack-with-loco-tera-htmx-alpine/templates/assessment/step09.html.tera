<div class="card">
    <h2>Step 9: Current Nutritional Support</h2>
    <p class="form-hint">
        Current oral, enteral, and parenteral support; vitamin / mineral supplementation;
        dietician involvement.
    </p>

    <div class="form-group">
        <label for="oral_supplements">Taking oral nutritional supplements?</label>
        <select id="oral_supplements" name="current_nutritional_support.oral_supplements">
            <option value="" {% if current_nutritional_support.oralSupplements == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if current_nutritional_support.oralSupplements == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if current_nutritional_support.oralSupplements == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <h3>Oral nutritional supplements</h3>
    {% for i in range(end=3) %}
    <fieldset class="supplement-row">
        <legend>Supplement {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="oral_supplement_list_{{ i }}_name">Name</label>
                <input type="text" id="oral_supplement_list_{{ i }}_name"
                       name="oral_supplement_list[{{ i }}].name"
                       value="{% if current_nutritional_support.oralSupplementList | length > i %}{{ current_nutritional_support.oralSupplementList[i].name }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="oral_supplement_list_{{ i }}_dose">Dose</label>
                <input type="text" id="oral_supplement_list_{{ i }}_dose"
                       name="oral_supplement_list[{{ i }}].dose"
                       value="{% if current_nutritional_support.oralSupplementList | length > i %}{{ current_nutritional_support.oralSupplementList[i].dose }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="oral_supplement_list_{{ i }}_frequency">Frequency</label>
                <input type="text" id="oral_supplement_list_{{ i }}_frequency"
                       name="oral_supplement_list[{{ i }}].frequency"
                       value="{% if current_nutritional_support.oralSupplementList | length > i %}{{ current_nutritional_support.oralSupplementList[i].frequency }}{% endif %}">
            </div>
        </div>
    </fieldset>
    {% endfor %}

    <div class="form-group">
        <label for="enteral_feeding">Receiving enteral (tube) feeding?</label>
        <select id="enteral_feeding" name="current_nutritional_support.enteral_feeding">
            <option value="" {% if current_nutritional_support.enteralFeeding == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if current_nutritional_support.enteralFeeding == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if current_nutritional_support.enteralFeeding == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="enteral_route">Enteral route</label>
            <select id="enteral_route" name="current_nutritional_support.enteral_route">
                <option value="" {% if current_nutritional_support.enteralRoute == "" %}selected{% endif %}>&mdash;</option>
                <option value="NG" {% if current_nutritional_support.enteralRoute == "NG" %}selected{% endif %}>Nasogastric (NG)</option>
                <option value="NJ" {% if current_nutritional_support.enteralRoute == "NJ" %}selected{% endif %}>Nasojejunal (NJ)</option>
                <option value="PEG" {% if current_nutritional_support.enteralRoute == "PEG" %}selected{% endif %}>PEG</option>
                <option value="PEJ" {% if current_nutritional_support.enteralRoute == "PEJ" %}selected{% endif %}>PEJ</option>
                <option value="RIG" {% if current_nutritional_support.enteralRoute == "RIG" %}selected{% endif %}>RIG</option>
                <option value="other" {% if current_nutritional_support.enteralRoute == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="enteral_formula">Enteral formula</label>
            <input type="text" id="enteral_formula"
                   name="current_nutritional_support.enteral_formula"
                   value="{{ current_nutritional_support.enteralFormula }}">
        </div>
    </div>

    <div class="form-group">
        <label for="parenteral_nutrition">Receiving parenteral nutrition?</label>
        <select id="parenteral_nutrition" name="current_nutritional_support.parenteral_nutrition">
            <option value="" {% if current_nutritional_support.parenteralNutrition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if current_nutritional_support.parenteralNutrition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if current_nutritional_support.parenteralNutrition == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="parenteral_details">Parenteral nutrition details</label>
        <textarea id="parenteral_details" name="current_nutritional_support.parenteral_details">{{ current_nutritional_support.parenteralDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="vitamin_mineral_supplements">Taking vitamin / mineral supplements?</label>
        <select id="vitamin_mineral_supplements" name="current_nutritional_support.vitamin_mineral_supplements">
            <option value="" {% if current_nutritional_support.vitaminMineralSupplements == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if current_nutritional_support.vitaminMineralSupplements == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if current_nutritional_support.vitaminMineralSupplements == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <h3>Vitamin / mineral supplements</h3>
    {% for i in range(end=3) %}
    <fieldset class="supplement-row">
        <legend>Vitamin / Mineral {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="vitamin_mineral_list_{{ i }}_name">Name</label>
                <input type="text" id="vitamin_mineral_list_{{ i }}_name"
                       name="vitamin_mineral_list[{{ i }}].name"
                       value="{% if current_nutritional_support.vitaminMineralList | length > i %}{{ current_nutritional_support.vitaminMineralList[i].name }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="vitamin_mineral_list_{{ i }}_dose">Dose</label>
                <input type="text" id="vitamin_mineral_list_{{ i }}_dose"
                       name="vitamin_mineral_list[{{ i }}].dose"
                       value="{% if current_nutritional_support.vitaminMineralList | length > i %}{{ current_nutritional_support.vitaminMineralList[i].dose }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="vitamin_mineral_list_{{ i }}_frequency">Frequency</label>
                <input type="text" id="vitamin_mineral_list_{{ i }}_frequency"
                       name="vitamin_mineral_list[{{ i }}].frequency"
                       value="{% if current_nutritional_support.vitaminMineralList | length > i %}{{ current_nutritional_support.vitaminMineralList[i].frequency }}{% endif %}">
            </div>
        </div>
    </fieldset>
    {% endfor %}

    <div class="form-row">
        <div class="form-group">
            <label for="dietician_involvement">Under dietician care?</label>
            <select id="dietician_involvement" name="current_nutritional_support.dietician_involvement">
                <option value="" {% if current_nutritional_support.dieticianInvolvement == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if current_nutritional_support.dieticianInvolvement == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if current_nutritional_support.dieticianInvolvement == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="last_dietician_review_date">Last review date</label>
            <input type="date" id="last_dietician_review_date"
                   name="current_nutritional_support.last_dietician_review_date"
                   value="{{ current_nutritional_support.lastDieticianReviewDate }}">
        </div>
    </div>
</div>
