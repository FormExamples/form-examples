<div class="card">
    <h2>Step 3: Dietary History</h2>
    <p class="form-hint">Usual diet pattern, intake, fluids, and lifestyle factors.</p>

    <div class="form-group">
        <label for="typical_diet">Describe your typical diet</label>
        <textarea id="typical_diet" name="dietary_history.typical_diet"
                  placeholder="A typical day...">{{ dietary_history.typicalDiet }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="diet_pattern">Diet pattern</label>
            <select id="diet_pattern" name="dietary_history.diet_pattern">
                <option value="" {% if dietary_history.dietPattern == "" %}selected{% endif %}>&mdash;</option>
                <option value="omnivore" {% if dietary_history.dietPattern == "omnivore" %}selected{% endif %}>Omnivore</option>
                <option value="vegetarian" {% if dietary_history.dietPattern == "vegetarian" %}selected{% endif %}>Vegetarian</option>
                <option value="vegan" {% if dietary_history.dietPattern == "vegan" %}selected{% endif %}>Vegan</option>
                <option value="pescatarian" {% if dietary_history.dietPattern == "pescatarian" %}selected{% endif %}>Pescatarian</option>
                <option value="other" {% if dietary_history.dietPattern == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="diet_pattern_other">Other diet pattern (if "other")</label>
            <input type="text" id="diet_pattern_other" name="dietary_history.diet_pattern_other"
                   value="{{ dietary_history.dietPatternOther }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="meals_per_day">Meals per day</label>
            <input type="number" min="0" max="10" id="meals_per_day"
                   name="dietary_history.meals_per_day"
                   value="{{ dietary_history.mealsPerDay }}">
        </div>
        <div class="form-group">
            <label for="snacks_per_day">Snacks per day</label>
            <input type="number" min="0" max="10" id="snacks_per_day"
                   name="dietary_history.snacks_per_day"
                   value="{{ dietary_history.snacksPerDay }}">
        </div>
    </div>

    <div class="form-group">
        <label for="appetite_decreased">Has your appetite decreased recently?</label>
        <select id="appetite_decreased" name="dietary_history.appetite_decreased">
            <option value="" {% if dietary_history.appetiteDecreased == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if dietary_history.appetiteDecreased == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if dietary_history.appetiteDecreased == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="appetite_change_notes">Appetite change notes</label>
        <textarea id="appetite_change_notes" name="dietary_history.appetite_change_notes">{{ dietary_history.appetiteChangeNotes }}</textarea>
    </div>

    <div class="form-group">
        <label for="food_intake_reduced">Has your food intake been reduced?</label>
        <select id="food_intake_reduced" name="dietary_history.food_intake_reduced">
            <option value="" {% if dietary_history.foodIntakeReduced == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if dietary_history.foodIntakeReduced == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if dietary_history.foodIntakeReduced == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="reduced_intake_days">For how many days?</label>
        <input type="number" min="0" max="365" id="reduced_intake_days"
               name="dietary_history.reduced_intake_days"
               value="{{ dietary_history.reducedIntakeDays }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="fluid_intake_adequate">Is fluid intake adequate?</label>
            <select id="fluid_intake_adequate" name="dietary_history.fluid_intake_adequate">
                <option value="" {% if dietary_history.fluidIntakeAdequate == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if dietary_history.fluidIntakeAdequate == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if dietary_history.fluidIntakeAdequate == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fluid_intake_ml_per_day">Estimated fluid intake (ml/day)</label>
            <input type="number" min="0" max="10000" id="fluid_intake_ml_per_day"
                   name="dietary_history.fluid_intake_ml_per_day"
                   value="{{ dietary_history.fluidIntakeMlPerDay }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="alcohol_use">Do you drink alcohol?</label>
            <select id="alcohol_use" name="dietary_history.alcohol_use">
                <option value="" {% if dietary_history.alcoholUse == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if dietary_history.alcoholUse == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if dietary_history.alcoholUse == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="alcohol_units_per_week">Units per week</label>
            <input type="number" min="0" max="200" id="alcohol_units_per_week"
                   name="dietary_history.alcohol_units_per_week"
                   value="{{ dietary_history.alcoholUnitsPerWeek }}">
        </div>
    </div>

    <div class="form-group">
        <label for="cultural_religious_restrictions">Cultural or religious dietary restrictions?</label>
        <select id="cultural_religious_restrictions" name="dietary_history.cultural_religious_restrictions">
            <option value="" {% if dietary_history.culturalReligiousRestrictions == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if dietary_history.culturalReligiousRestrictions == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if dietary_history.culturalReligiousRestrictions == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group">
        <label for="cultural_religious_details">Details</label>
        <textarea id="cultural_religious_details" name="dietary_history.cultural_religious_details">{{ dietary_history.culturalReligiousDetails }}</textarea>
    </div>
</div>
