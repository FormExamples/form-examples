{% extends "base.html.tera" %}

{% block title %}Nutrition Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Nutrition Assessment Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name...">
    </div>
    <div class="form-group">
        <label for="must_risk">MUST Risk</label>
        <select id="must_risk" name="must_risk">
            <option value="">All</option>
            <option value="low" {% if must_risk == "low" %}selected{% endif %}>Low</option>
            <option value="medium" {% if must_risk == "medium" %}selected{% endif %}>Medium</option>
            <option value="high" {% if must_risk == "high" %}selected{% endif %}>High</option>
        </select>
    </div>
    <div class="form-group">
        <label for="severity">Severity</label>
        <select id="severity" name="severity">
            <option value="">All</option>
            <option value="low" {% if severity == "low" %}selected{% endif %}>Well-nourished</option>
            <option value="moderate" {% if severity == "moderate" %}selected{% endif %}>At risk</option>
            <option value="high" {% if severity == "high" %}selected{% endif %}>Malnourished</option>
            <option value="critical" {% if severity == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Urgent/High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Patient</th>
            <th>DOB</th>
            <th>Sex</th>
            <th>MUST</th>
            <th>Risk</th>
            <th>Severity</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for a in assessments %}
        <tr>
            <td><a href="/assessment/{{ a.id }}/report">{{ a.createdAt }}</a></td>
            <td>{{ a.firstName }} {{ a.lastName }}</td>
            <td>{{ a.dateOfBirth }}</td>
            <td>{{ a.sex }}</td>
            <td>{{ a.mustScore }} / 6</td>
            <td><span class="badge badge-{{ a.mustRisk }}">{{ a.mustRisk }}</span></td>
            <td><span class="severity-badge severity-{{ a.severity }}">{{ a.severity }}</span></td>
            <td>
                {% set total_flags = a.urgentFlagCount + a.highFlagCount %}
                {% if total_flags > 0 %}
                    <span class="badge badge-no">{{ a.urgentFlagCount }} urgent / {{ a.highFlagCount }} high</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
