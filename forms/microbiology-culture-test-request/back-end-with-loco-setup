#!/bin/sh
set -euf

form_kebab_case=microbiology-culture-test-request
form_snake_case=microbiology_culture_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold microbiology_culture_test_request \
    deleted_at:ts \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    specimen_type:string! \
    specimen_site_detail:string! \
    test_culture_and_sensitivity:bool! \
    test_gram_stain:bool! \
    test_acid_fast_bacilli_tb:bool! \
    test_fungal_culture:bool! \
    test_pcr_molecular:bool! \
    test_c_difficile_toxin:bool! \
    test_mrsa_screen:bool! \
    primary_indication:string! \
    clinical_details:string! \
    fever:bool! \
    current_antibiotics:bool! \
    antibiotic_name:string! \
    recent_travel:bool! \
    immunocompromised:bool! \
    specimen_collected:string! \
    collection_datetime:ts \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    notes:string! \
    --api

cargo loco generate scaffold microbiology_culture_test_request_grade \
    deleted_at:ts \
    microbiology_culture_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    preanalytical_band:string! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold microbiology_culture_test_request_grade_rule \
    deleted_at:ts \
    microbiology_culture_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold microbiology_culture_test_request_grade_flag \
    deleted_at:ts \
    microbiology_culture_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
