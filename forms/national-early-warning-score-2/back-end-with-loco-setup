#!/bin/sh
set -euf

form_kebab_case=national-early-warning-score-2
form_snake_case=national_early_warning_score_2

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold national_early_warning_score_2 \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    observation_at:tstz \
    ward_or_location:string! \
    spo2_scale:string! \
    spo2_scale2_endorsed:string! \
    respiratory_rate:int \
    spo2:int \
    on_oxygen:string! \
    oxygen_device:string! \
    oxygen_flow_rate_l_min:double \
    inspired_oxygen_fraction_percent:int \
    systolic_blood_pressure:int \
    pulse:int \
    consciousness_acvpu:string! \
    temperature:double \
    is_under_16:string! \
    is_pregnant:string! \
    has_spinal_cord_injury:string! \
    clinical_notes:text! \
    --api

cargo loco generate scaffold national_early_warning_score_2_grade \
    deleted_at:tstz \
    national_early_warning_score_2:references \
    aggregate_score:int \
    respiratory_rate_score:int \
    spo2_score:int \
    oxygen_score:int \
    blood_pressure_score:int \
    pulse_score:int \
    consciousness_score:int \
    temperature_score:int \
    any_single_parameter_three:string! \
    risk_band:string! \
    monitoring_frequency:text! \
    recommendation:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold national_early_warning_score_2_grade_rule \
    deleted_at:tstz \
    national_early_warning_score_2_grade:references \
    rule_id:string! \
    instrument:string! \
    band:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold national_early_warning_score_2_grade_flag \
    deleted_at:tstz \
    national_early_warning_score_2_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
