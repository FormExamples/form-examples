#!/bin/sh
set -euf

form_kebab_case=glasgow-coma-scale
form_snake_case=glasgow_coma_scale

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold glasgow_coma_scale \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    assessor_name:string! \
    assessor_role:string! \
    assessed_at:tstz \
    setting:string! \
    reason:text! \
    intubated:string! \
    sedated:string! \
    paralysed:string! \
    eye_response:string! \
    eye_not_testable_reason:text! \
    verbal_response:string! \
    verbal_not_testable_reason:text! \
    motor_response:string! \
    motor_not_testable_reason:text! \
    left_pupil_reactivity:string! \
    right_pupil_reactivity:string! \
    left_pupil_size_mm:double \
    right_pupil_size_mm:double \
    previous_total:int \
    previous_motor_score:int \
    previous_assessed_at:tstz \
    clinical_note:text! \
    --api

cargo loco generate scaffold glasgow_coma_scale_grade \
    deleted_at:tstz \
    glasgow_coma_scale:references \
    eye_score:int \
    verbal_score:int \
    motor_score:int \
    total_score:int \
    breakdown:string! \
    total_display:string! \
    severity_band:string! \
    pupil_reactivity_score:int \
    gcs_p:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold glasgow_coma_scale_grade_rule \
    deleted_at:tstz \
    glasgow_coma_scale_grade:references \
    rule_id:string! \
    component:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold glasgow_coma_scale_grade_flag \
    deleted_at:tstz \
    glasgow_coma_scale_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"

# Fix two loco-new scaffold defaults that fail clippy -D warnings:
# App::seed()'s unused base param, and the test auth_header() helper's
# redundant &token.
"$(git rev-parse --show-toplevel)/bin/loco-seed-base-rename" "${form_kebab_case}"
"$(git rev-parse --show-toplevel)/bin/loco-test-auth-header-fix" "${form_kebab_case}"
