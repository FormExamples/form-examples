{% extends "base.html.tera" %}

{% block title %}WHO Counter-Referral Form - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>WHO Counter-Referral Form</h1>
        <p class="landing-description">
            World Health Organization standardised counter-referral form for discharging
            patients back from a referral facility to their primary care facility. The form
            follows the <strong>SBAR</strong> communication framework &mdash; Situation,
            Background, Assessment, Recommendations &mdash; and captures patient identification,
            facility details, treatments initiated during stay, diagnoses, and recommendations
            for follow-up care.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>SBAR Framework</h3>
                <p>Situation, Background, Assessment, and Recommendations &mdash; a structured handover for clinical safety</p>
            </div>
            <div class="feature">
                <h3>Follow-up Timeframes</h3>
                <p>Urgent (within 24 hours), 2-6 days, 1-2 weeks, or &gt; 2 weeks</p>
            </div>
            <div class="feature">
                <h3>Clinical Flags</h3>
                <p>Real-time alerts for urgent follow-up, missing deterioration plan, communication breakdown, and palliative care</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Counter-Referral
            </button>
        </form>
    </div>
</div>
{% endblock %}
