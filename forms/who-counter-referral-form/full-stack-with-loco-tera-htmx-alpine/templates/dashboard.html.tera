{% extends "base.html.tera" %}

{% block title %}WHO Counter-Referral Form - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Counter-Referral Dashboard</h1>
    <a href="/" class="btn btn-primary">New Counter-Referral</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, diagnosis, or referral facility...">
    </div>
    <div class="form-group">
        <label for="form_status">Status</label>
        <select id="form_status" name="form_status">
            <option value="">All</option>
            <option value="not-started" {% if form_status == "not-started" %}selected{% endif %}>Not Started</option>
            <option value="in-progress" {% if form_status == "in-progress" %}selected{% endif %}>In Progress</option>
            <option value="complete" {% if form_status == "complete" %}selected{% endif %}>Complete</option>
            <option value="complete-with-concerns" {% if form_status == "complete-with-concerns" %}selected{% endif %}>Complete (with concerns)</option>
        </select>
    </div>
    <div class="form-group">
        <label for="follow_up_timeframe">Follow-up timeframe</label>
        <select id="follow_up_timeframe" name="follow_up_timeframe">
            <option value="">All</option>
            <option value="urgent-within-24-hours" {% if follow_up_timeframe == "urgent-within-24-hours" %}selected{% endif %}>Urgent (within 24 hours)</option>
            <option value="2-to-6-days" {% if follow_up_timeframe == "2-to-6-days" %}selected{% endif %}>2 to 6 days</option>
            <option value="1-to-2-weeks" {% if follow_up_timeframe == "1-to-2-weeks" %}selected{% endif %}>1 to 2 weeks</option>
            <option value="more-than-2-weeks" {% if follow_up_timeframe == "more-than-2-weeks" %}selected{% endif %}>More than 2 weeks</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Urgent / High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed counter-referral{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Referral Facility</th>
            <th>Primary Care</th>
            <th>Diagnosis</th>
            <th>Follow-up</th>
            <th>Status</th>
            <th>Completion</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.patientName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.referralFacility }}</td>
            <td>{{ c.primaryCareFacility }}</td>
            <td>{{ c.primaryDiagnosis }}</td>
            <td>{{ c.followUpTimeframe }}</td>
            <td><span class="checklist-badge checklist-{{ c.formStatus }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.formStatus }}</span></td>
            <td>{{ c.overallPercent }}%</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed counter-referrals found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
