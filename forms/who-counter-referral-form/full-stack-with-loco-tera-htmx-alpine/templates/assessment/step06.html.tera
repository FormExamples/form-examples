<div class="card">
    <h2>Step 6: Recommendations (R of SBAR)</h2>
    <p class="form-hint">Follow-up plan, pending investigations, follow-up arrangements, deterioration instructions, status flags.</p>

    <div class="form-group">
        <label for="follow_up_plan">Next steps in follow-up plan</label>
        <textarea id="follow_up_plan" name="followUpPlan"
                  placeholder="Medications to stop or continue, wound management, palliative care">{{ recommendations.followUpPlan }}</textarea>
    </div>

    <div class="form-group">
        <label for="pending_investigations">Pending investigations (results to chase up)</label>
        <textarea id="pending_investigations" name="pendingInvestigations">{{ recommendations.pendingInvestigations }}</textarea>
    </div>

    <div class="form-group">
        <label for="follow_up_arrangements">Follow-up arrangements (when, where, with whom)</label>
        <textarea id="follow_up_arrangements" name="followUpArrangements">{{ recommendations.followUpArrangements }}</textarea>
    </div>

    <div class="form-group">
        <label for="deterioration_instructions">Instructions if patient's condition deteriorates</label>
        <textarea id="deterioration_instructions" name="deteriorationInstructions">{{ recommendations.deteriorationInstructions }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="contact_name">Contact name (for follow-up questions)</label>
            <input type="text" id="contact_name" name="contactName"
                   value="{{ recommendations.contactName }}">
        </div>
        <div class="form-group">
            <label for="contact_information">Contact information</label>
            <input type="text" id="contact_information" name="contactInformation"
                   value="{{ recommendations.contactInformation }}">
        </div>
    </div>

    <h3>Status Flags</h3>
    <div class="form-group">
        <label>
            <input type="checkbox" name="cognitiveImpairment" value="on"
                   {% if recommendations.statusFlags.cognitiveImpairment %}checked{% endif %}>
            Cognitive impairment
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="carerDependent" value="on"
                   {% if recommendations.statusFlags.carerDependent %}checked{% endif %}>
            Carer-dependent
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="spinalPrecautions" value="on"
                   {% if recommendations.statusFlags.spinalPrecautions %}checked{% endif %}>
            Spinal precautions
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="weightBearingRestrictions" value="on"
                   {% if recommendations.statusFlags.weightBearingRestrictions %}checked{% endif %}>
            Weight-bearing restrictions
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="palliativeCare" value="on"
                   {% if recommendations.statusFlags.palliativeCare %}checked{% endif %}>
            Palliative care
        </label>
    </div>
</div>
