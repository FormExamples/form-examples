<div class="card">
    <h2>Step 1: Patient Identification</h2>
    <p class="form-hint">Patient demographics and emergency contact for the discharge back to primary care.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_name">Patient name (LAST, First)</label>
            <input type="text" id="patient_name" name="patientName"
                   value="{{ patient_identification.patientName }}">
        </div>
        <div class="form-group">
            <label for="date_of_birth">Date of birth</label>
            <input type="date" id="date_of_birth" name="dateOfBirth"
                   value="{{ patient_identification.dateOfBirth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="sex">
                <option value="" {% if patient_identification.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="male" {% if patient_identification.sex == "male" %}selected{% endif %}>Male</option>
                <option value="female" {% if patient_identification.sex == "female" %}selected{% endif %}>Female</option>
                <option value="unknown" {% if patient_identification.sex == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_contact">Patient contact information</label>
            <input type="text" id="patient_contact" name="patientContact"
                   value="{{ patient_identification.patientContact }}" placeholder="Phone number">
        </div>
    </div>

    <h3>Emergency Contact Person</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="emergency_contact_name">Name</label>
            <input type="text" id="emergency_contact_name" name="emergencyContactName"
                   value="{{ patient_identification.emergencyContact.name }}">
        </div>
        <div class="form-group">
            <label for="emergency_contact_information">Contact information</label>
            <input type="text" id="emergency_contact_information" name="emergencyContactInformation"
                   value="{{ patient_identification.emergencyContact.contactInformation }}">
        </div>
    </div>
</div>
