<div class="card">
    <h2>Step 5: Assessment (A of SBAR)</h2>
    <p class="form-hint">Final diagnoses, prognosis, and patient/family communication.</p>

    <div class="form-group">
        <label for="final_diagnoses">Final diagnoses / problem list</label>
        <textarea id="final_diagnoses" name="finalDiagnoses"
                  placeholder="Include social factors for consideration">{{ assessment.finalDiagnoses }}</textarea>
    </div>

    <div class="form-group">
        <label for="prognosis_and_goals_of_care">Prognosis and goals of care</label>
        <textarea id="prognosis_and_goals_of_care" name="prognosisAndGoalsOfCare">{{ assessment.prognosisAndGoalsOfCare }}</textarea>
    </div>

    <div class="form-group">
        <label for="patient_family_informed">Patient / family informed of diagnosis?</label>
        <select id="patient_family_informed" name="patientFamilyInformed">
            <option value="" {% if assessment.patientFamilyInformed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if assessment.patientFamilyInformed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if assessment.patientFamilyInformed == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="informed_explanation">If Yes, please explain how patient/family were informed</label>
        <textarea id="informed_explanation" name="informedExplanation">{{ assessment.informedExplanation }}</textarea>
    </div>
</div>
