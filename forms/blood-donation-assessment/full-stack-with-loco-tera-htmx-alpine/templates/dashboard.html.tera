{% extends "base.html.tera" %}

{% block title %}Blood Donation Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Donor-Session Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Donor name or date of birth...">
    </div>
    <div class="form-group">
        <label for="eligibility_status">Eligibility</label>
        <select id="eligibility_status" name="eligibility_status">
            <option value="">All</option>
            <option value="eligible" {% if eligibility_status == "eligible" %}selected{% endif %}>Eligible</option>
            <option value="temporarily-deferred" {% if eligibility_status == "temporarily-deferred" %}selected{% endif %}>Temporarily Deferred</option>
            <option value="permanently-deferred" {% if eligibility_status == "permanently-deferred" %}selected{% endif %}>Permanently Deferred</option>
        </select>
    </div>
    <div class="form-group">
        <label for="donor_type">Donor Type</label>
        <select id="donor_type" name="donor_type">
            <option value="">All</option>
            <option value="first-time" {% if donor_type == "first-time" %}selected{% endif %}>First-time</option>
            <option value="regular" {% if donor_type == "regular" %}selected{% endif %}>Regular</option>
            <option value="lapsed" {% if donor_type == "lapsed" %}selected{% endif %}>Lapsed</option>
        </select>
    </div>
    <div class="form-group">
        <label for="sex">Sex</label>
        <select id="sex" name="sex">
            <option value="">All</option>
            <option value="female" {% if sex == "female" %}selected{% endif %}>Female</option>
            <option value="male" {% if sex == "male" %}selected{% endif %}>Male</option>
            <option value="other" {% if sex == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent_flags">Urgent Flags</label>
        <select id="has_urgent_flags" name="has_urgent_flags">
            <option value="">All</option>
            <option value="yes" {% if has_urgent_flags == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent_flags == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Donor</th>
            <th>DOB</th>
            <th>Sex</th>
            <th>Donor Type</th>
            <th>Eligibility</th>
            <th>Deferral Window</th>
            <th>Rules Fired</th>
            <th>Urgent Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for d in donors %}
        <tr>
            <td><a href="/assessment/{{ d.id }}/report">{{ d.donorName }}</a></td>
            <td>{{ d.dateOfBirth }}</td>
            <td>{{ d.sex }}</td>
            <td>{{ d.donorType }}</td>
            <td><span class="eligibility-badge eligibility-{{ d.eligibilityStatus }}">{{ d.eligibilityStatus }}</span></td>
            <td>{{ d.deferralWindow }}</td>
            <td>{{ d.firedRuleCount }}</td>
            <td>
                {% if d.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ d.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
