<div class="card">
    <h2>Step 1: Donor Demographics</h2>
    <p class="form-hint">Basic identification, sex, weight and donation history.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="donor_demographics.first_name"
                   value="{{ donor_demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="donor_demographics.last_name"
                   value="{{ donor_demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="donor_demographics.date_of_birth"
                   value="{{ donor_demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="donor_demographics.sex">
                <option value="" {% if donor_demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if donor_demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if donor_demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if donor_demographics.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="weight">Weight (kg)</label>
            <input type="number" step="0.1" id="weight" name="donor_demographics.weight"
                   value="{{ donor_demographics.weight }}" placeholder="Minimum 50 kg">
        </div>
        <div class="form-group">
            <label for="height">Height (cm)</label>
            <input type="number" step="0.1" id="height" name="donor_demographics.height"
                   value="{{ donor_demographics.height }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="donor_type">Donor Type</label>
            <select id="donor_type" name="donor_demographics.donor_type">
                <option value="" {% if donor_demographics.donorType == "" %}selected{% endif %}>&mdash;</option>
                <option value="first-time" {% if donor_demographics.donorType == "first-time" %}selected{% endif %}>First-time</option>
                <option value="regular" {% if donor_demographics.donorType == "regular" %}selected{% endif %}>Regular</option>
                <option value="lapsed" {% if donor_demographics.donorType == "lapsed" %}selected{% endif %}>Lapsed</option>
            </select>
        </div>
        <div class="form-group">
            <label for="last_donation_date">Last Donation Date</label>
            <input type="date" id="last_donation_date" name="donor_demographics.last_donation_date"
                   value="{{ donor_demographics.lastDonationDate }}">
        </div>
    </div>
</div>
