<div class="card">
    <h2>Step 7: Pregnancy &amp; Transfusion History</h2>
    <p class="form-hint">Pregnancy, breastfeeding and historical receipt of blood or transplants.</p>

    {% set yesno = [
        ["currently_pregnant", "currentlyPregnant", "Currently pregnant?"],
        ["pregnancy_past_six_months", "pregnancyPastSixMonths", "Pregnancy ended in the past 6 months?"],
        ["breastfeeding", "breastfeeding", "Currently breastfeeding?"],
        ["received_transfusion_ever", "receivedTransfusionEver", "Ever received a blood transfusion?"],
        ["received_transplant_ever", "receivedTransplantEver", "Ever received an organ or tissue transplant?"]
    ] %}

    {% for q in yesno %}
    <div class="form-group">
        <label for="{{ q[0] }}">{{ q[2] }}</label>
        <select id="{{ q[0] }}" name="pregnancy_transfusion.{{ q[0] }}">
            <option value="" {% if pregnancy_transfusion[q[1]] == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if pregnancy_transfusion[q[1]] == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if pregnancy_transfusion[q[1]] == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="last_transfusion_date">Last Transfusion Date (if any)</label>
        <input type="date" id="last_transfusion_date" name="pregnancy_transfusion.last_transfusion_date"
               value="{{ pregnancy_transfusion.lastTransfusionDate }}">
    </div>
</div>
