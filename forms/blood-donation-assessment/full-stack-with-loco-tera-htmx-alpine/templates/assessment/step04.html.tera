<div class="card">
    <h2>Step 4: Recent Illness &amp; Infections</h2>
    <p class="form-hint">Acute illness, antibiotics, dental work, surgery, COVID-19 and vaccinations.</p>

    {% set yesno = [
        ["fever_past_two_weeks", "feverPastTwoWeeks", "Fever in the past 2 weeks?"],
        ["infection_past_two_weeks", "infectionPastTwoWeeks", "Active infection in the past 2 weeks?"],
        ["antibiotics_past_seven_days", "antibioticsPastSevenDays", "Antibiotics taken in the past 7 days?"],
        ["dental_work_past_week", "dentalWorkPastWeek", "Dental work in the past 7 days?"],
        ["surgery_past_six_months", "surgeryPastSixMonths", "Major surgery in the past 6 months?"],
        ["covid_positive_past_twenty_eight_days", "covidPositivePastTwentyEightDays", "COVID-19 positive in the past 28 days?"],
        ["vaccination_past_four_weeks", "vaccinationPastFourWeeks", "Vaccination in the past 4 weeks?"]
    ] %}

    {% for q in yesno %}
    <div class="form-group">
        <label for="{{ q[0] }}">{{ q[2] }}</label>
        <select id="{{ q[0] }}" name="recent_illness.{{ q[0] }}">
            <option value="" {% if recent_illness[q[1]] == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if recent_illness[q[1]] == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if recent_illness[q[1]] == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="vaccination_details">Vaccination details (vaccine name / date)</label>
        <input type="text" id="vaccination_details" name="recent_illness.vaccination_details"
               value="{{ recent_illness.vaccinationDetails }}">
    </div>
</div>
