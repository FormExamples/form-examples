{% extends "base.html.tera" %}

{% block title %}Eligibility Report - {{ eligibility_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Blood Donation Assessment &mdash; Eligibility Report</h1>
    <div class="eligibility-badge {{ eligibility_class }}">{{ eligibility_label }}</div>
    {% if deferral_window %}
    <p class="deferral-window"><strong>Deferral window:</strong> {{ deferral_window }}</p>
    {% endif %}
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}<br>
        Fields answered: {{ answered_count }}
    </p>
</div>

<!-- Donor Summary -->
<div class="card">
    <h2>Donor Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong>
            {{ data.donorDemographics.firstName }} {{ data.donorDemographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.donorDemographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.donorDemographics.sex }}<br>
            <strong>Weight (kg):</strong> {{ data.donorDemographics.weight }}<br>
            <strong>Donor Type:</strong> {{ data.donorDemographics.donorType }}
        </div>
        <div>
            <strong>Last Donation:</strong> {{ data.donorDemographics.lastDonationDate }}<br>
            <strong>Hb (g/dL):</strong> {{ data.vitalSigns.hemoglobin }}<br>
            <strong>BP (mmHg):</strong>
            {{ data.vitalSigns.systolicBp }}/{{ data.vitalSigns.diastolicBp }}<br>
            <strong>Pulse (bpm):</strong> {{ data.vitalSigns.pulseBpm }}<br>
            <strong>Temperature (°C):</strong> {{ data.vitalSigns.temperatureCelsius }}
        </div>
    </div>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Clinician Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- DSG Rules Fired -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>JPAC DSG Rules Fired ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th>Deferral Window</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="eligibility-badge eligibility-{{ rule.status }}">{{ rule.status }}</span></td>
                <td>{{ rule.deferralWindow }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="card">
    <h2>JPAC DSG Rules</h2>
    <p>No deferral rules fired. Donor is provisionally eligible.</p>
</div>
{% endif %}

<!-- Current medications -->
{% if data.medicalHistory.currentMedications and data.medicalHistory.currentMedications | length > 0 %}
<div class="card">
    <h2>Current Medications ({{ data.medicalHistory.currentMedications | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Reason</th>
            </tr>
        </thead>
        <tbody>
            {% for med in data.medicalHistory.currentMedications %}
            <tr>
                <td>{{ med.name }}</td>
                <td>{{ med.reason }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Recent travel -->
{% if data.travelHistory.recentTravel and data.travelHistory.recentTravel | length > 0 %}
<div class="card">
    <h2>Recent Travel ({{ data.travelHistory.recentTravel | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Country</th>
                <th>Return Date</th>
                <th>Duration</th>
            </tr>
        </thead>
        <tbody>
            {% for t in data.travelHistory.recentTravel %}
            <tr>
                <td>{{ t.country }}</td>
                <td>{{ t.returnDate }}</td>
                <td>{{ t.duration }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
