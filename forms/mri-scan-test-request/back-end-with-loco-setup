#!/bin/sh
set -euf

form_kebab_case=mri-scan-test-request
form_snake_case=mri_scan_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold mri_scan_test_request \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    body_region:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    contrast_required:string! \
    egfr:double \
    previous_gadolinium_reaction:string! \
    pregnancy_status:string! \
    pacemaker_or_icd:bool! \
    cochlear_implant:bool! \
    aneurysm_clip:bool! \
    metallic_foreign_body_eye:bool! \
    shrapnel_or_metal_fragments:bool! \
    programmable_shunt:bool! \
    neurostimulator:bool! \
    metal_implant_or_prosthesis:bool! \
    insulin_pump:bool! \
    claustrophobia:bool! \
    mri_safety_status:string! \
    weight_kg:double \
    relevant_previous_imaging:string! \
    urgency:string! \
    supervising_consultant:string! \
    notes:string! \
    --api

cargo loco generate scaffold mri_scan_test_request_grade \
    deleted_at:tstz \
    mri_scan_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    mri_safety_band:string! \
    contrast_renal_flag:string! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold mri_scan_test_request_grade_rule \
    deleted_at:tstz \
    mri_scan_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold mri_scan_test_request_grade_flag \
    deleted_at:tstz \
    mri_scan_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
