#!/bin/sh
set -euf

form_kebab_case=post-anaesthesia-care-unit-record
form_snake_case=post_anaesthesia_care_unit_record

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold post_anaesthesia_care_unit_record \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    nurse_name:string! \
    nurse_role:string! \
    anaesthetist_name:string! \
    admitted_at:tstz \
    anaesthetic_technique:string! \
    procedure:text! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    asa_status:string! \
    baseline_systolic_bp:double \
    ambulatory_case:string! \
    activity:string! \
    respiration:string! \
    circulation:string! \
    consciousness:string! \
    oxygen_saturation:string! \
    airway_status:string! \
    pain_score:double \
    ponv_severity:string! \
    analgesia_given:text! \
    antiemetics_given:text! \
    padss_vital_signs:string! \
    padss_ambulation:string! \
    padss_nausea_vomiting:string! \
    padss_pain:string! \
    padss_surgical_bleeding:string! \
    recovery_note:text! \
    --api

cargo loco generate scaffold post_anaesthesia_care_unit_record_grade \
    deleted_at:tstz \
    post_anaesthesia_care_unit_record:references \
    activity_score:int \
    respiration_score:int \
    circulation_score:int \
    consciousness_score:int \
    oxygen_saturation_score:int \
    aldrete_total:int \
    discharge_ready:string! \
    padss_total:int \
    padss_street_fit:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold post_anaesthesia_care_unit_record_grade_rule \
    deleted_at:tstz \
    post_anaesthesia_care_unit_record_grade:references \
    rule_id:string! \
    parameter:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold post_anaesthesia_care_unit_record_grade_flag \
    deleted_at:tstz \
    post_anaesthesia_care_unit_record_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
