<div class="card">
    <h2>Step 5: Blood Tests</h2>
    <p class="form-hint">
        Recent renal-function panel and related labs. eGFR auto-calculates
        from creatinine + age + sex (CKD-EPI 2021) if not entered directly.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="serum_creatinine">Serum creatinine (mg/dL)</label>
            <input type="number" step="0.01" min="0" max="30" id="serum_creatinine"
                   name="blood_tests.serum_creatinine" value="{{ blood_tests.serumCreatinine }}">
        </div>
        <div class="form-group">
            <label for="egfr">eGFR entered (mL/min/1.73 m&sup2;)</label>
            <input type="number" step="0.1" min="0" max="200" id="egfr"
                   name="blood_tests.egfr" value="{{ blood_tests.egfr }}">
        </div>
        <div class="form-group">
            <label for="bun">BUN / urea (mg/dL)</label>
            <input type="number" step="0.1" min="0" max="200" id="bun"
                   name="blood_tests.bun" value="{{ blood_tests.bun }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sodium">Sodium (mmol/L)</label>
            <input type="number" step="0.1" min="100" max="180" id="sodium"
                   name="blood_tests.sodium" value="{{ blood_tests.sodium }}">
        </div>
        <div class="form-group">
            <label for="potassium">Potassium (mmol/L)</label>
            <input type="number" step="0.1" min="1" max="10" id="potassium"
                   name="blood_tests.potassium" value="{{ blood_tests.potassium }}">
        </div>
        <div class="form-group">
            <label for="chloride">Chloride (mmol/L)</label>
            <input type="number" step="0.1" min="60" max="140" id="chloride"
                   name="blood_tests.chloride" value="{{ blood_tests.chloride }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="bicarbonate">Bicarbonate (mmol/L)</label>
            <input type="number" step="0.1" min="5" max="50" id="bicarbonate"
                   name="blood_tests.bicarbonate" value="{{ blood_tests.bicarbonate }}">
        </div>
        <div class="form-group">
            <label for="calcium">Calcium (mmol/L)</label>
            <input type="number" step="0.01" min="1" max="4" id="calcium"
                   name="blood_tests.calcium" value="{{ blood_tests.calcium }}">
        </div>
        <div class="form-group">
            <label for="phosphate">Phosphate (mmol/L)</label>
            <input type="number" step="0.01" min="0" max="5" id="phosphate"
                   name="blood_tests.phosphate" value="{{ blood_tests.phosphate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="magnesium">Magnesium (mmol/L)</label>
            <input type="number" step="0.01" min="0" max="5" id="magnesium"
                   name="blood_tests.magnesium" value="{{ blood_tests.magnesium }}">
        </div>
        <div class="form-group">
            <label for="albumin">Albumin (g/L)</label>
            <input type="number" step="0.1" min="0" max="60" id="albumin"
                   name="blood_tests.albumin" value="{{ blood_tests.albumin }}">
        </div>
        <div class="form-group">
            <label for="hemoglobin">Hemoglobin (g/L)</label>
            <input type="number" min="30" max="250" id="hemoglobin"
                   name="blood_tests.hemoglobin" value="{{ blood_tests.hemoglobin }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hba1c">HbA1c (%)</label>
            <input type="number" step="0.1" min="3" max="20" id="hba1c"
                   name="blood_tests.hba1c" value="{{ blood_tests.hba1c }}">
        </div>
        <div class="form-group">
            <label for="pth">PTH (pg/mL)</label>
            <input type="number" min="0" max="5000" id="pth"
                   name="blood_tests.pth" value="{{ blood_tests.pth }}">
        </div>
        <div class="form-group">
            <label for="vitamin_d">Vitamin D 25-OH (ng/mL)</label>
            <input type="number" min="0" max="200" id="vitamin_d"
                   name="blood_tests.vitamin_d" value="{{ blood_tests.vitaminD }}">
        </div>
    </div>

    <div class="form-group">
        <label for="bt_test_date">Test date</label>
        <input type="date" id="bt_test_date" name="blood_tests.test_date"
               value="{{ blood_tests.testDate }}">
    </div>
</div>
