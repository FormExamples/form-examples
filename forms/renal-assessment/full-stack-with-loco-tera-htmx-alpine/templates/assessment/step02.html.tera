<div class="card">
    <h2>Step 2: Presenting Symptoms</h2>
    <p class="form-hint">Symptoms suggestive of kidney disease or uremia.</p>

    {% set yes_no = [
        {"name": "fatigue", "camel": "fatigue", "label": "Fatigue or weakness?"},
        {"name": "edema", "camel": "edema", "label": "Edema (ankle, leg, periorbital)?"},
        {"name": "foamy_urine", "camel": "foamyUrine", "label": "Foamy / frothy urine?"},
        {"name": "nocturia", "camel": "nocturia", "label": "Nocturia (waking at night to urinate)?"},
        {"name": "hematuria", "camel": "hematuria", "label": "Hematuria (blood in urine)?"},
        {"name": "flank_pain", "camel": "flankPain", "label": "Flank or loin pain?"},
        {"name": "reduced_urine_output", "camel": "reducedUrineOutput", "label": "Reduced urine output (oliguria)?"},
        {"name": "pruritus", "camel": "pruritus", "label": "Pruritus (itching)?"},
        {"name": "nausea_vomiting", "camel": "nauseaVomiting", "label": "Nausea or vomiting?"},
        {"name": "appetite_loss", "camel": "appetiteLoss", "label": "Loss of appetite?"},
        {"name": "dyspnea", "camel": "dyspnea", "label": "Shortness of breath (dyspnea)?"},
        {"name": "confusion", "camel": "confusion", "label": "Confusion or altered mental status?"}
    ] %}

    {% for q in yes_no %}
    <div class="form-group">
        <label for="ps_{{ q.name }}">{{ q.label }}</label>
        <select id="ps_{{ q.name }}" name="presenting_symptoms.{{ q.name }}">
            <option value="" {% if presenting_symptoms[q.camel] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if presenting_symptoms[q.camel] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if presenting_symptoms[q.camel] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="symptom_duration">Symptom duration</label>
        <select id="symptom_duration" name="presenting_symptoms.symptom_duration">
            <option value="" {% if presenting_symptoms.symptomDuration == "" %}selected{% endif %}>&mdash;</option>
            <option value="days" {% if presenting_symptoms.symptomDuration == "days" %}selected{% endif %}>Days</option>
            <option value="weeks" {% if presenting_symptoms.symptomDuration == "weeks" %}selected{% endif %}>Weeks</option>
            <option value="months" {% if presenting_symptoms.symptomDuration == "months" %}selected{% endif %}>Months</option>
            <option value="years" {% if presenting_symptoms.symptomDuration == "years" %}selected{% endif %}>Years</option>
            <option value="unknown" {% if presenting_symptoms.symptomDuration == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="other_symptoms">Other symptoms</label>
        <textarea id="other_symptoms" name="presenting_symptoms.other_symptoms"
                  placeholder="Any other symptoms not listed above">{{ presenting_symptoms.otherSymptoms }}</textarea>
    </div>
</div>
