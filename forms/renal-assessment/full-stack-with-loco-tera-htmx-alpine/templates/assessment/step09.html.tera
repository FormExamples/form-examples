<div class="card">
    <h2>Step 9: Clinical Impression &amp; KDIGO Stage</h2>
    <p class="form-hint">
        Clinician synthesis. Leave GFR / albuminuria categories blank to
        auto-derive from labs.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="gfr_category">GFR category (override auto-derived)</label>
            <select id="gfr_category" name="clinical_impression.gfr_category">
                <option value="" {% if clinical_impression.gfrCategory == "" %}selected{% endif %}>&mdash;</option>
                <option value="G1" {% if clinical_impression.gfrCategory == "G1" %}selected{% endif %}>G1: &ge;90</option>
                <option value="G2" {% if clinical_impression.gfrCategory == "G2" %}selected{% endif %}>G2: 60-89</option>
                <option value="G3a" {% if clinical_impression.gfrCategory == "G3a" %}selected{% endif %}>G3a: 45-59</option>
                <option value="G3b" {% if clinical_impression.gfrCategory == "G3b" %}selected{% endif %}>G3b: 30-44</option>
                <option value="G4" {% if clinical_impression.gfrCategory == "G4" %}selected{% endif %}>G4: 15-29</option>
                <option value="G5" {% if clinical_impression.gfrCategory == "G5" %}selected{% endif %}>G5: &lt;15 (kidney failure)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="albuminuria_category">Albuminuria category (override auto-derived)</label>
            <select id="albuminuria_category" name="clinical_impression.albuminuria_category">
                <option value="" {% if clinical_impression.albuminuriaCategory == "" %}selected{% endif %}>&mdash;</option>
                <option value="A1" {% if clinical_impression.albuminuriaCategory == "A1" %}selected{% endif %}>A1: &lt;3 mg/mmol</option>
                <option value="A2" {% if clinical_impression.albuminuriaCategory == "A2" %}selected{% endif %}>A2: 3-30 mg/mmol</option>
                <option value="A3" {% if clinical_impression.albuminuriaCategory == "A3" %}selected{% endif %}>A3: &gt;30 mg/mmol</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="suspected_etiology">Suspected etiology</label>
        <select id="suspected_etiology" name="clinical_impression.suspected_etiology">
            <option value="" {% if clinical_impression.suspectedEtiology == "" %}selected{% endif %}>&mdash;</option>
            <option value="diabetic-nephropathy" {% if clinical_impression.suspectedEtiology == "diabetic-nephropathy" %}selected{% endif %}>Diabetic nephropathy</option>
            <option value="hypertensive-nephrosclerosis" {% if clinical_impression.suspectedEtiology == "hypertensive-nephrosclerosis" %}selected{% endif %}>Hypertensive nephrosclerosis</option>
            <option value="glomerulonephritis" {% if clinical_impression.suspectedEtiology == "glomerulonephritis" %}selected{% endif %}>Glomerulonephritis</option>
            <option value="polycystic-kidney-disease" {% if clinical_impression.suspectedEtiology == "polycystic-kidney-disease" %}selected{% endif %}>Polycystic kidney disease</option>
            <option value="tubulointerstitial" {% if clinical_impression.suspectedEtiology == "tubulointerstitial" %}selected{% endif %}>Tubulointerstitial disease</option>
            <option value="obstructive-uropathy" {% if clinical_impression.suspectedEtiology == "obstructive-uropathy" %}selected{% endif %}>Obstructive uropathy</option>
            <option value="vascular" {% if clinical_impression.suspectedEtiology == "vascular" %}selected{% endif %}>Renovascular disease</option>
            <option value="drug-induced" {% if clinical_impression.suspectedEtiology == "drug-induced" %}selected{% endif %}>Drug-induced nephropathy</option>
            <option value="unknown" {% if clinical_impression.suspectedEtiology == "unknown" %}selected{% endif %}>Unknown / under investigation</option>
            <option value="other" {% if clinical_impression.suspectedEtiology == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>

    {% set decision_fields = [
        {"name": "aksuperimposed_on_ckd", "camel": "aksuperimposedOnCkd", "label": "Acute kidney injury superimposed on CKD?"},
        {"name": "nephrology_referral", "camel": "nephrologyReferral", "label": "Nephrology referral indicated?"},
        {"name": "dialysis_discussion_needed", "camel": "dialysisDiscussionNeeded", "label": "Dialysis discussion needed?"},
        {"name": "transplant_candidate", "camel": "transplantCandidate", "label": "Transplant candidate?"}
    ] %}

    {% for q in decision_fields %}
    <div class="form-group">
        <label for="ci_{{ q.name }}">{{ q.label }}</label>
        <select id="ci_{{ q.name }}" name="clinical_impression.{{ q.name }}">
            <option value="" {% if clinical_impression[q.camel] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if clinical_impression[q.camel] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if clinical_impression[q.camel] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="referral_urgency">Referral urgency</label>
        <select id="referral_urgency" name="clinical_impression.referral_urgency">
            <option value="" {% if clinical_impression.referralUrgency == "" %}selected{% endif %}>&mdash;</option>
            <option value="urgent" {% if clinical_impression.referralUrgency == "urgent" %}selected{% endif %}>Urgent (within 1 week)</option>
            <option value="soon" {% if clinical_impression.referralUrgency == "soon" %}selected{% endif %}>Soon (within 4 weeks)</option>
            <option value="routine" {% if clinical_impression.referralUrgency == "routine" %}selected{% endif %}>Routine</option>
        </select>
    </div>

    <div class="form-group">
        <label for="management_plan">Management plan</label>
        <textarea id="management_plan" name="clinical_impression.management_plan"
                  placeholder="Targets, RAAS / SGLT2 plan, anemia management, MBD, lifestyle">{{ clinical_impression.managementPlan }}</textarea>
    </div>

    <div class="form-group">
        <label for="follow_up_interval">Follow-up interval</label>
        <select id="follow_up_interval" name="clinical_impression.follow_up_interval">
            <option value="" {% if clinical_impression.followUpInterval == "" %}selected{% endif %}>&mdash;</option>
            <option value="1-month" {% if clinical_impression.followUpInterval == "1-month" %}selected{% endif %}>1 month</option>
            <option value="3-months" {% if clinical_impression.followUpInterval == "3-months" %}selected{% endif %}>3 months</option>
            <option value="6-months" {% if clinical_impression.followUpInterval == "6-months" %}selected{% endif %}>6 months</option>
            <option value="12-months" {% if clinical_impression.followUpInterval == "12-months" %}selected{% endif %}>12 months</option>
            <option value="as-needed" {% if clinical_impression.followUpInterval == "as-needed" %}selected{% endif %}>As needed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="clinician_notes">Clinician notes</label>
        <textarea id="clinician_notes" name="clinical_impression.clinician_notes">{{ clinical_impression.clinicianNotes }}</textarea>
    </div>
</div>
