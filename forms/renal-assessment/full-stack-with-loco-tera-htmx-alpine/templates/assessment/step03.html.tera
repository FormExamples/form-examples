<div class="card">
    <h2>Step 3: CKD Risk Factors</h2>
    <p class="form-hint">Conditions and exposures that raise the risk of chronic kidney disease.</p>

    {% set yes_no_fields = [
        {"name": "hypertension", "camel": "hypertension", "label": "Hypertension?"},
        {"name": "diabetes", "camel": "diabetes", "label": "Diabetes mellitus?"},
        {"name": "cardiovascular_disease", "camel": "cardiovascularDisease", "label": "Cardiovascular disease (IHD, stroke, PAD)?"},
        {"name": "family_history_ckd", "camel": "familyHistoryCkd", "label": "Family history of CKD?"},
        {"name": "family_history_polycystic_kidney", "camel": "familyHistoryPolycysticKidney", "label": "Family history of polycystic kidney disease?"},
        {"name": "prior_aki", "camel": "priorAki", "label": "Prior episode of acute kidney injury?"},
        {"name": "kidney_stones", "camel": "kidneyStones", "label": "History of kidney stones?"},
        {"name": "recurrent_uti", "camel": "recurrentUti", "label": "Recurrent urinary tract infections?"},
        {"name": "autoimmune_disease", "camel": "autoimmuneDisease", "label": "Autoimmune disease (e.g. SLE, vasculitis)?"},
        {"name": "nephrotoxic_drugs", "camel": "nephrotoxicDrugs", "label": "Exposure to nephrotoxic drugs?"},
        {"name": "nsaid_use", "camel": "nsaidUse", "label": "Regular NSAID use?"},
        {"name": "obesity", "camel": "obesity", "label": "Obesity (BMI >= 30)?"}
    ] %}

    {% for q in yes_no_fields %}
    <div class="form-group">
        <label for="crf_{{ q.name }}">{{ q.label }}</label>
        <select id="crf_{{ q.name }}" name="ckd_risk_factors.{{ q.name }}">
            <option value="" {% if ckd_risk_factors[q.camel] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ckd_risk_factors[q.camel] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ckd_risk_factors[q.camel] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="diabetes_type">Diabetes type (if diabetes = yes)</label>
        <select id="diabetes_type" name="ckd_risk_factors.diabetes_type">
            <option value="" {% if ckd_risk_factors.diabetesType == "" %}selected{% endif %}>&mdash;</option>
            <option value="type1" {% if ckd_risk_factors.diabetesType == "type1" %}selected{% endif %}>Type 1</option>
            <option value="type2" {% if ckd_risk_factors.diabetesType == "type2" %}selected{% endif %}>Type 2</option>
            <option value="gestational" {% if ckd_risk_factors.diabetesType == "gestational" %}selected{% endif %}>Gestational</option>
            <option value="other" {% if ckd_risk_factors.diabetesType == "other" %}selected{% endif %}>Other / unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="autoimmune_details">Autoimmune disease details</label>
        <input type="text" id="autoimmune_details" name="ckd_risk_factors.autoimmune_details"
               value="{{ ckd_risk_factors.autoimmuneDetails }}">
    </div>

    <div class="form-group">
        <label for="nephrotoxic_drug_details">Which nephrotoxic drug(s)?</label>
        <input type="text" id="nephrotoxic_drug_details" name="ckd_risk_factors.nephrotoxic_drug_details"
               value="{{ ckd_risk_factors.nephrotoxicDrugDetails }}">
    </div>

    <div class="form-group">
        <label for="smoking">Smoking status</label>
        <select id="smoking" name="ckd_risk_factors.smoking">
            <option value="" {% if ckd_risk_factors.smoking == "" %}selected{% endif %}>&mdash;</option>
            <option value="current" {% if ckd_risk_factors.smoking == "current" %}selected{% endif %}>Current smoker</option>
            <option value="ex" {% if ckd_risk_factors.smoking == "ex" %}selected{% endif %}>Ex-smoker</option>
            <option value="never" {% if ckd_risk_factors.smoking == "never" %}selected{% endif %}>Never smoked</option>
        </select>
    </div>
</div>
