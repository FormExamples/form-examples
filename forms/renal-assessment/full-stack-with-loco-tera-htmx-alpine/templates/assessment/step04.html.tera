<div class="card">
    <h2>Step 4: Physical Examination</h2>
    <p class="form-hint">Targeted exam findings relevant to kidney disease.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="systolic_bp">Systolic BP (mmHg)</label>
            <input type="number" min="50" max="280" id="systolic_bp" name="physical_examination.systolic_bp"
                   value="{{ physical_examination.systolicBp }}">
        </div>
        <div class="form-group">
            <label for="diastolic_bp">Diastolic BP (mmHg)</label>
            <input type="number" min="30" max="180" id="diastolic_bp" name="physical_examination.diastolic_bp"
                   value="{{ physical_examination.diastolicBp }}">
        </div>
        <div class="form-group">
            <label for="heart_rate">Heart rate (bpm)</label>
            <input type="number" min="20" max="250" id="heart_rate" name="physical_examination.heart_rate"
                   value="{{ physical_examination.heartRate }}">
        </div>
    </div>

    {% set exam_fields = [
        {"name": "peripheral_edema", "camel": "peripheralEdema", "label": "Peripheral edema?"},
        {"name": "pulmonary_edema", "camel": "pulmonaryEdema", "label": "Pulmonary edema (crackles)?"},
        {"name": "jvd_elevated", "camel": "jvdElevated", "label": "Elevated JVD?"},
        {"name": "pallor", "camel": "pallor", "label": "Pallor?"},
        {"name": "uremic_skin", "camel": "uremicSkin", "label": "Uremic skin changes?"},
        {"name": "flank_tenderness", "camel": "flankTenderness", "label": "Flank tenderness?"},
        {"name": "palpable_kidneys", "camel": "palpableKidneys", "label": "Palpable kidneys?"},
        {"name": "bladder_distension", "camel": "bladderDistension", "label": "Bladder distension?"}
    ] %}

    {% for q in exam_fields %}
    <div class="form-group">
        <label for="pe_{{ q.name }}">{{ q.label }}</label>
        <select id="pe_{{ q.name }}" name="physical_examination.{{ q.name }}">
            <option value="" {% if physical_examination[q.camel] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination[q.camel] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination[q.camel] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="exam_notes">Examination notes</label>
        <textarea id="exam_notes" name="physical_examination.exam_notes"
                  placeholder="Other relevant findings">{{ physical_examination.examNotes }}</textarea>
    </div>
</div>
