{% extends "base.html.tera" %}

{% block title %}Workplace Climate Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Leadership Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Department, role level, tenure band...">
    </div>
    <div class="form-group">
        <label for="category">Climate category</label>
        <select id="category" name="category">
            <option value="">All</option>
            <option value="thriving"   {% if category == "thriving"   %}selected{% endif %}>Thriving</option>
            <option value="healthy"    {% if category == "healthy"    %}selected{% endif %}>Healthy</option>
            <option value="developing" {% if category == "developing" %}selected{% endif %}>Developing</option>
            <option value="strained"   {% if category == "strained"   %}selected{% endif %}>Strained</option>
            <option value="critical"   {% if category == "critical"   %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="department">Department</label>
        <select id="department" name="department">
            <option value="">All</option>
            <option value="operations"        {% if department == "operations" %}selected{% endif %}>Operations</option>
            <option value="engineering"       {% if department == "engineering" %}selected{% endif %}>Engineering / IT</option>
            <option value="sales-marketing"   {% if department == "sales-marketing" %}selected{% endif %}>Sales / Marketing</option>
            <option value="customer-service"  {% if department == "customer-service" %}selected{% endif %}>Customer Service</option>
            <option value="finance"           {% if department == "finance" %}selected{% endif %}>Finance</option>
            <option value="human-resources"   {% if department == "human-resources" %}selected{% endif %}>Human Resources</option>
            <option value="administration"    {% if department == "administration" %}selected{% endif %}>Administration</option>
            <option value="clinical"          {% if department == "clinical" %}selected{% endif %}>Clinical / Care</option>
            <option value="research"          {% if department == "research" %}selected{% endif %}>Research</option>
            <option value="leadership"        {% if department == "leadership" %}selected{% endif %}>Leadership / Executive</option>
            <option value="other"             {% if department == "other" %}selected{% endif %}>Other / Prefer not to say</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-priority flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no"  {% if has_flags == "no"  %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Created</th>
            <th>Department</th>
            <th>Role / Tenure</th>
            <th>Composite</th>
            <th>Category</th>
            <th>Answered</th>
            <th>Recommend</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.createdAt }}</a></td>
            <td>{{ c.department }}</td>
            <td>{{ c.roleLevel }}<br><small>{{ c.tenureBand }}</small></td>
            <td>{% if c.compositeScore %}{{ c.compositeScore }}{% else %}&mdash;{% endif %}</td>
            <td><span class="checklist-badge checklist-{{ c.category }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.category }}</span></td>
            <td>{{ c.answeredCount }} / {{ c.totalCount }}</td>
            <td>{{ c.recommendAsPlaceToWork }}</td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
