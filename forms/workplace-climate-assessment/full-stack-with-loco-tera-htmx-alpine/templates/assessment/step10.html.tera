<div class="card">
    <h2>Step 10: Overall Climate &amp; Recommendations</h2>
    <p class="form-hint">
        Your overall view of the climate at this organisation. The Likert items here
        are stored alongside the report but are NOT included in the eight-domain
        composite score. Free-text fields are optional and are scanned for accidental
        identifying details.
    </p>

    <div class="form-group">
        <label for="overall_oc1">1. Overall, the climate at this organisation is positive.</label>
        <select id="overall_oc1" name="overall.oc1">
            <option value="" {% if overall.oc1 == "" or overall.oc1 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if overall.oc1 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if overall.oc1 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if overall.oc1 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if overall.oc1 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if overall.oc1 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="overall_oc2">2. I would recommend this organisation as a great place to work.</label>
        <select id="overall_oc2" name="overall.oc2">
            <option value="" {% if overall.oc2 == "" or overall.oc2 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if overall.oc2 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if overall.oc2 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if overall.oc2 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if overall.oc2 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if overall.oc2 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="overall_oc3">3. This organisation lives the values it says it stands for.</label>
        <select id="overall_oc3" name="overall.oc3">
            <option value="" {% if overall.oc3 == "" or overall.oc3 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if overall.oc3 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if overall.oc3 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if overall.oc3 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if overall.oc3 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if overall.oc3 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="overall_recommend_as_place_to_work">Would you recommend this organisation as a place to work?</label>
        <select id="overall_recommend_as_place_to_work" name="overall.recommend_as_place_to_work">
            <option value="" {% if overall.recommendAsPlaceToWork == "" %}selected{% endif %}>&mdash;</option>
            <option value="definitely"     {% if overall.recommendAsPlaceToWork == "definitely"     %}selected{% endif %}>Definitely yes</option>
            <option value="probably"       {% if overall.recommendAsPlaceToWork == "probably"       %}selected{% endif %}>Probably yes</option>
            <option value="unsure"         {% if overall.recommendAsPlaceToWork == "unsure"         %}selected{% endif %}>Unsure</option>
            <option value="probably-not"   {% if overall.recommendAsPlaceToWork == "probably-not"   %}selected{% endif %}>Probably not</option>
            <option value="definitely-not" {% if overall.recommendAsPlaceToWork == "definitely-not" %}selected{% endif %}>Definitely not</option>
        </select>
    </div>

    <div class="form-group">
        <label for="overall_biggest_strength">Biggest strength (optional, anonymous)</label>
        <textarea id="overall_biggest_strength" name="overall.biggest_strength" rows="3"
                  placeholder="What is working well? Please avoid names or contact details.">{{ overall.biggestStrength }}</textarea>
    </div>

    <div class="form-group">
        <label for="overall_biggest_improvement">Most important improvement (optional, anonymous)</label>
        <textarea id="overall_biggest_improvement" name="overall.biggest_improvement" rows="3"
                  placeholder="The single most important change you would make. Please avoid names or contact details.">{{ overall.biggestImprovement }}</textarea>
    </div>

    <div class="form-group">
        <label for="overall_other_comments">Other comments (optional, anonymous)</label>
        <textarea id="overall_other_comments" name="overall.other_comments" rows="3"
                  placeholder="Anything else. Please avoid names or contact details.">{{ overall.otherComments }}</textarea>
    </div>
</div>
