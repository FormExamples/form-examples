        </select>
    </div>

    <div class="form-group">
        <label for="psych_safety_ps4">4. When I raise a concern, it is taken seriously.</label>
        <select id="psych_safety_ps4" name="psych_safety.ps4">
            <option value="" {% if psych_safety.ps4 == "" or psych_safety.ps4 == null %}selected{% endif %}>&mdash;</option>
