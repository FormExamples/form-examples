            <option value="5" {% if psych_safety.ps2 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="psych_safety_ps3">3. My colleagues respect different opinions, including disagreement.</label>
