<div class="card">
    <h2>Step 2: Leadership &amp; Management</h2>
    <p class="form-hint">Whether senior leaders and line managers are trustworthy, consistent and supportive.</p>

    <div class="form-group">
        <label for="leadership_ld1">1. I trust the senior leadership of this organisation.</label>
        <select id="leadership_ld1" name="leadership.ld1">
            <option value="" {% if leadership.ld1 == "" or leadership.ld1 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if leadership.ld1 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if leadership.ld1 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if leadership.ld1 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if leadership.ld1 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if leadership.ld1 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="leadership_ld2">2. My line manager treats me with respect.</label>
        <select id="leadership_ld2" name="leadership.ld2">
            <option value="" {% if leadership.ld2 == "" or leadership.ld2 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if leadership.ld2 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if leadership.ld2 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if leadership.ld2 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if leadership.ld2 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if leadership.ld2 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="leadership_ld3">3. Leaders make decisions that are consistent with the organisation&rsquo;s stated values.</label>
        <select id="leadership_ld3" name="leadership.ld3">
            <option value="" {% if leadership.ld3 == "" or leadership.ld3 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if leadership.ld3 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if leadership.ld3 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if leadership.ld3 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if leadership.ld3 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if leadership.ld3 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="leadership_ld4">4. My line manager supports my professional growth.</label>
        <select id="leadership_ld4" name="leadership.ld4">
            <option value="" {% if leadership.ld4 == "" or leadership.ld4 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if leadership.ld4 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if leadership.ld4 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if leadership.ld4 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if leadership.ld4 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if leadership.ld4 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="leadership_ld5">5. Leadership communicates a clear direction for the organisation.</label>
        <select id="leadership_ld5" name="leadership.ld5">
            <option value="" {% if leadership.ld5 == "" or leadership.ld5 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if leadership.ld5 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if leadership.ld5 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if leadership.ld5 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if leadership.ld5 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if leadership.ld5 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>
</div>
