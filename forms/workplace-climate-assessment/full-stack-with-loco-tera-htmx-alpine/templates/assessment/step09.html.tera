<div class="card">
    <h2>Step 9: Career Development</h2>
    <p class="form-hint">Whether there are meaningful opportunities to learn, grow and progress.</p>

    <div class="form-group">
        <label for="career_ca1">1. I have meaningful opportunities to learn new skills here.</label>
        <select id="career_ca1" name="career.ca1">
            <option value="" {% if career.ca1 == "" or career.ca1 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if career.ca1 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if career.ca1 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if career.ca1 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if career.ca1 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if career.ca1 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="career_ca2">2. I see a clear path for career progression.</label>
        <select id="career_ca2" name="career.ca2">
            <option value="" {% if career.ca2 == "" or career.ca2 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if career.ca2 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if career.ca2 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if career.ca2 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if career.ca2 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if career.ca2 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="career_ca3">3. My manager actively supports my professional development.</label>
        <select id="career_ca3" name="career.ca3">
            <option value="" {% if career.ca3 == "" or career.ca3 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if career.ca3 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if career.ca3 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if career.ca3 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if career.ca3 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if career.ca3 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>

    <div class="form-group">
        <label for="career_ca4">4. Training and development resources are available when I need them.</label>
        <select id="career_ca4" name="career.ca4">
            <option value="" {% if career.ca4 == "" or career.ca4 == null %}selected{% endif %}>&mdash;</option>
            <option value="1" {% if career.ca4 == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
            <option value="2" {% if career.ca4 == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
            <option value="3" {% if career.ca4 == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
            <option value="4" {% if career.ca4 == 4 %}selected{% endif %}>4 &mdash; Agree</option>
            <option value="5" {% if career.ca4 == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
        </select>
    </div>
</div>
