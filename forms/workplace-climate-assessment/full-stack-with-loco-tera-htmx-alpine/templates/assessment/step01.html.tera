<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">
        Anonymised banding only &mdash; please do not enter your name, employee
        id, contact details, or anything that could identify you. These
        responses are NOT graded into the composite score.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_department">Department</label>
            <select id="demographics_department" name="demographics.department">
                <option value="" {% if demographics.department == "" %}selected{% endif %}>&mdash;</option>
                <option value="operations"        {% if demographics.department == "operations" %}selected{% endif %}>Operations</option>
                <option value="engineering"       {% if demographics.department == "engineering" %}selected{% endif %}>Engineering / IT</option>
                <option value="sales-marketing"   {% if demographics.department == "sales-marketing" %}selected{% endif %}>Sales / Marketing</option>
                <option value="customer-service"  {% if demographics.department == "customer-service" %}selected{% endif %}>Customer Service</option>
                <option value="finance"           {% if demographics.department == "finance" %}selected{% endif %}>Finance</option>
                <option value="human-resources"   {% if demographics.department == "human-resources" %}selected{% endif %}>Human Resources</option>
                <option value="administration"    {% if demographics.department == "administration" %}selected{% endif %}>Administration</option>
                <option value="clinical"          {% if demographics.department == "clinical" %}selected{% endif %}>Clinical / Care</option>
                <option value="research"          {% if demographics.department == "research" %}selected{% endif %}>Research</option>
                <option value="leadership"        {% if demographics.department == "leadership" %}selected{% endif %}>Leadership / Executive</option>
                <option value="other"             {% if demographics.department == "other" %}selected{% endif %}>Other / Prefer not to say</option>
            </select>
        </div>
        <div class="form-group">
            <label for="demographics_tenure_band">Tenure</label>
            <select id="demographics_tenure_band" name="demographics.tenure_band">
                <option value="" {% if demographics.tenureBand == "" %}selected{% endif %}>&mdash;</option>
                <option value="less-than-1-year"    {% if demographics.tenureBand == "less-than-1-year" %}selected{% endif %}>Less than 1 year</option>
                <option value="1-to-3-years"        {% if demographics.tenureBand == "1-to-3-years" %}selected{% endif %}>1 to 3 years</option>
                <option value="3-to-5-years"        {% if demographics.tenureBand == "3-to-5-years" %}selected{% endif %}>3 to 5 years</option>
                <option value="5-to-10-years"       {% if demographics.tenureBand == "5-to-10-years" %}selected{% endif %}>5 to 10 years</option>
                <option value="more-than-10-years"  {% if demographics.tenureBand == "more-than-10-years" %}selected{% endif %}>More than 10 years</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="demographics_hours_band">Working hours</label>
            <select id="demographics_hours_band" name="demographics.hours_band">
                <option value="" {% if demographics.hoursBand == "" %}selected{% endif %}>&mdash;</option>
                <option value="part-time-under-20"  {% if demographics.hoursBand == "part-time-under-20" %}selected{% endif %}>Part-time (under 20 hours / week)</option>
                <option value="part-time-20-to-34"  {% if demographics.hoursBand == "part-time-20-to-34" %}selected{% endif %}>Part-time (20&ndash;34 hours / week)</option>
                <option value="full-time-35-to-44"  {% if demographics.hoursBand == "full-time-35-to-44" %}selected{% endif %}>Full-time (35&ndash;44 hours / week)</option>
                <option value="long-hours-45-plus"  {% if demographics.hoursBand == "long-hours-45-plus" %}selected{% endif %}>Long hours (45+ hours / week)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="demographics_role_level">Role level</label>
            <select id="demographics_role_level" name="demographics.role_level">
                <option value="" {% if demographics.roleLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="individual-contributor" {% if demographics.roleLevel == "individual-contributor" %}selected{% endif %}>Individual contributor</option>
                <option value="team-lead"              {% if demographics.roleLevel == "team-lead" %}selected{% endif %}>Team lead</option>
                <option value="manager"                {% if demographics.roleLevel == "manager" %}selected{% endif %}>Manager</option>
                <option value="senior-manager"         {% if demographics.roleLevel == "senior-manager" %}selected{% endif %}>Senior manager</option>
                <option value="director-or-above"      {% if demographics.roleLevel == "director-or-above" %}selected{% endif %}>Director or above</option>
            </select>
        </div>
        <div class="form-group">
            <label for="demographics_work_location">Work location</label>
            <select id="demographics_work_location" name="demographics.work_location">
                <option value="" {% if demographics.workLocation == "" %}selected{% endif %}>&mdash;</option>
                <option value="on-site" {% if demographics.workLocation == "on-site" %}selected{% endif %}>Mostly on-site</option>
                <option value="hybrid"  {% if demographics.workLocation == "hybrid"  %}selected{% endif %}>Hybrid</option>
                <option value="remote"  {% if demographics.workLocation == "remote"  %}selected{% endif %}>Mostly remote</option>
            </select>
        </div>
    </div>
</div>
