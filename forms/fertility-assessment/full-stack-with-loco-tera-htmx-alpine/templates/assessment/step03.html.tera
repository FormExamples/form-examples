<div class="card">
    <h2>Step 3: Menstrual Cycle History</h2>
    <p class="form-hint">Cycle regularity and length inform ovulation status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="menarche_age">Menarche Age</label>
            <input type="number" id="menarche_age" name="menstrual_cycle.menarche_age"
                   value="{{ menstrual_cycle.menarcheAge }}">
        </div>
        <div class="form-group">
            <label for="cycle_length_days">Cycle Length (days)</label>
            <input type="number" id="cycle_length_days" name="menstrual_cycle.cycle_length_days"
                   value="{{ menstrual_cycle.cycleLengthDays }}">
        </div>
        <div class="form-group">
            <label for="period_duration_days">Period Duration (days)</label>
            <input type="number" id="period_duration_days" name="menstrual_cycle.period_duration_days"
                   value="{{ menstrual_cycle.periodDurationDays }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cycle_regularity">Cycle Regularity</label>
            <select id="cycle_regularity" name="menstrual_cycle.cycle_regularity">
                <option value="" {% if menstrual_cycle.cycleRegularity == "" %}selected{% endif %}>&mdash;</option>
                <option value="regular" {% if menstrual_cycle.cycleRegularity == "regular" %}selected{% endif %}>Regular</option>
                <option value="irregular" {% if menstrual_cycle.cycleRegularity == "irregular" %}selected{% endif %}>Irregular</option>
                <option value="absent" {% if menstrual_cycle.cycleRegularity == "absent" %}selected{% endif %}>Absent (amenorrhoea)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="heavy_bleeding">Heavy Bleeding</label>
            <select id="heavy_bleeding" name="menstrual_cycle.heavy_bleeding">
                <option value="" {% if menstrual_cycle.heavyBleeding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if menstrual_cycle.heavyBleeding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if menstrual_cycle.heavyBleeding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dysmenorrhoea">Dysmenorrhoea</label>
            <select id="dysmenorrhoea" name="menstrual_cycle.dysmenorrhoea">
                <option value="" {% if menstrual_cycle.dysmenorrhoea == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if menstrual_cycle.dysmenorrhoea == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if menstrual_cycle.dysmenorrhoea == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="intermenstrual_bleeding">Intermenstrual Bleeding</label>
            <select id="intermenstrual_bleeding" name="menstrual_cycle.intermenstrual_bleeding">
                <option value="" {% if menstrual_cycle.intermenstrualBleeding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if menstrual_cycle.intermenstrualBleeding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if menstrual_cycle.intermenstrualBleeding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="last_menstrual_period">Last Menstrual Period</label>
            <input type="date" id="last_menstrual_period" name="menstrual_cycle.last_menstrual_period"
                   value="{{ menstrual_cycle.lastMenstrualPeriod }}">
        </div>
    </div>

    <div class="form-group">
        <label for="cycle_notes">Cycle Notes</label>
        <textarea id="cycle_notes" name="menstrual_cycle.cycle_notes">{{ menstrual_cycle.cycleNotes }}</textarea>
    </div>
</div>
