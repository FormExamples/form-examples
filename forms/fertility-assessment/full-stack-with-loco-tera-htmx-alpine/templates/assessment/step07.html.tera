<div class="card">
    <h2>Step 7: Partner Factors &amp; Semen Analysis</h2>
    <p class="form-hint">Lower reference limits per WHO 2021 (6th ed.) standardised semen analysis.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="partner_age_years">Partner Age (years)</label>
            <input type="number" id="partner_age_years" name="partner_semen.partner_age_years"
                   value="{{ partner_semen.partnerAgeYears }}">
        </div>
        <div class="form-group">
            <label for="partner_smoking">Partner Smoking</label>
            <select id="partner_smoking" name="partner_semen.partner_smoking">
                <option value="" {% if partner_semen.partnerSmoking == "" %}selected{% endif %}>&mdash;</option>
                <option value="never" {% if partner_semen.partnerSmoking == "never" %}selected{% endif %}>Never</option>
                <option value="former" {% if partner_semen.partnerSmoking == "former" %}selected{% endif %}>Former</option>
                <option value="current" {% if partner_semen.partnerSmoking == "current" %}selected{% endif %}>Current</option>
            </select>
        </div>
        <div class="form-group">
            <label for="partner_alcohol">Partner Alcohol</label>
            <select id="partner_alcohol" name="partner_semen.partner_alcohol">
                <option value="" {% if partner_semen.partnerAlcohol == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if partner_semen.partnerAlcohol == "none" %}selected{% endif %}>None</option>
                <option value="low" {% if partner_semen.partnerAlcohol == "low" %}selected{% endif %}>Low</option>
                <option value="moderate" {% if partner_semen.partnerAlcohol == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="heavy" {% if partner_semen.partnerAlcohol == "heavy" %}selected{% endif %}>Heavy</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="partner_occupational_hazards">Partner Occupational Hazards</label>
            <select id="partner_occupational_hazards" name="partner_semen.partner_occupational_hazards">
                <option value="" {% if partner_semen.partnerOccupationalHazards == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if partner_semen.partnerOccupationalHazards == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if partner_semen.partnerOccupationalHazards == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="semen_analysis_done">Semen Analysis Done</label>
            <select id="semen_analysis_done" name="partner_semen.semen_analysis_done">
                <option value="" {% if partner_semen.semenAnalysisDone == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if partner_semen.semenAnalysisDone == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if partner_semen.semenAnalysisDone == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="semen_analysis_date">Semen Analysis Date</label>
            <input type="date" id="semen_analysis_date" name="partner_semen.semen_analysis_date"
                   value="{{ partner_semen.semenAnalysisDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="semen_volume_ml">Volume (mL, WHO LRL 1.4)</label>
            <input type="number" step="0.1" id="semen_volume_ml" name="partner_semen.semen_volume_ml"
                   value="{{ partner_semen.semenVolumeMl }}">
        </div>
        <div class="form-group">
            <label for="semen_concentration_million_per_ml">Concentration (million/mL, WHO LRL 16)</label>
            <input type="number" step="0.1" id="semen_concentration_million_per_ml" name="partner_semen.semen_concentration_million_per_ml"
                   value="{{ partner_semen.semenConcentrationMillionPerMl }}">
        </div>
        <div class="form-group">
            <label for="semen_total_motility_percent">Total Motility % (WHO LRL 42)</label>
            <input type="number" step="0.1" id="semen_total_motility_percent" name="partner_semen.semen_total_motility_percent"
                   value="{{ partner_semen.semenTotalMotilityPercent }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="semen_progressive_motility_percent">Progressive Motility % (WHO LRL 30)</label>
            <input type="number" step="0.1" id="semen_progressive_motility_percent" name="partner_semen.semen_progressive_motility_percent"
                   value="{{ partner_semen.semenProgressiveMotilityPercent }}">
        </div>
        <div class="form-group">
            <label for="semen_normal_morphology_percent">Normal Morphology % (WHO LRL 4)</label>
            <input type="number" step="0.1" id="semen_normal_morphology_percent" name="partner_semen.semen_normal_morphology_percent"
                   value="{{ partner_semen.semenNormalMorphologyPercent }}">
        </div>
    </div>

    <div class="form-group">
        <label for="partner_medical_history">Partner Medical History</label>
        <textarea id="partner_medical_history" name="partner_semen.partner_medical_history">{{ partner_semen.partnerMedicalHistory }}</textarea>
    </div>
    <div class="form-group">
        <label for="semen_notes">Semen Notes</label>
        <textarea id="semen_notes" name="partner_semen.semen_notes">{{ partner_semen.semenNotes }}</textarea>
    </div>
</div>
