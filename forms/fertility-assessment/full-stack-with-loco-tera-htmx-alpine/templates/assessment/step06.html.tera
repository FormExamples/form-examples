<div class="card">
    <h2>Step 6: Medications &amp; Supplements</h2>
    <p class="form-hint">Pre-conception folic acid is strongly recommended.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="folic_acid">Folic Acid</label>
            <select id="folic_acid" name="medications_supplements.folic_acid">
                <option value="" {% if medications_supplements.folicAcid == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medications_supplements.folicAcid == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medications_supplements.folicAcid == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="folic_acid_dose_mcg">Folic Acid Dose (mcg)</label>
            <input type="number" id="folic_acid_dose_mcg" name="medications_supplements.folic_acid_dose_mcg"
                   value="{{ medications_supplements.folicAcidDoseMcg }}">
        </div>
        <div class="form-group">
            <label for="vitamin_d">Vitamin D</label>
            <select id="vitamin_d" name="medications_supplements.vitamin_d">
                <option value="" {% if medications_supplements.vitaminD == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medications_supplements.vitaminD == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medications_supplements.vitaminD == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_supplements">Other Supplements</label>
        <textarea id="other_supplements" name="medications_supplements.other_supplements">{{ medications_supplements.otherSupplements }}</textarea>
    </div>

    <h3>Current Medications</h3>
    <p class="form-hint">Add up to four medications. Empty rows are discarded on submission.</p>
    {% for idx in range(end=4) %}
    <div class="form-row">
        <div class="form-group">
            <label for="med_{{ idx }}_name">Name</label>
            <input type="text" id="med_{{ idx }}_name" name="current_medications[{{ idx }}].name"
                   value="{% if medications_supplements.currentMedications | length > idx %}{{ medications_supplements.currentMedications[idx].name }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="med_{{ idx }}_dose">Dose</label>
            <input type="text" id="med_{{ idx }}_dose" name="current_medications[{{ idx }}].dose"
                   value="{% if medications_supplements.currentMedications | length > idx %}{{ medications_supplements.currentMedications[idx].dose }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="med_{{ idx }}_frequency">Frequency</label>
            <input type="text" id="med_{{ idx }}_frequency" name="current_medications[{{ idx }}].frequency"
                   value="{% if medications_supplements.currentMedications | length > idx %}{{ medications_supplements.currentMedications[idx].frequency }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="med_{{ idx }}_indication">Indication</label>
            <input type="text" id="med_{{ idx }}_indication" name="current_medications[{{ idx }}].indication"
                   value="{% if medications_supplements.currentMedications | length > idx %}{{ medications_supplements.currentMedications[idx].indication }}{% endif %}">
        </div>
    </div>
    {% endfor %}
</div>
