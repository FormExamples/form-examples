<div class="card">
    <h2>Step 2: Reproductive History</h2>
    <p class="form-hint">Duration trying to conceive and prior pregnancy outcomes.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="duration_trying_months">Duration Trying (months)</label>
            <input type="number" id="duration_trying_months" name="reproductive_history.duration_trying_months"
                   value="{{ reproductive_history.durationTryingMonths }}">
        </div>
        <div class="form-group">
            <label for="prior_pregnancies">Prior Pregnancies</label>
            <input type="number" id="prior_pregnancies" name="reproductive_history.prior_pregnancies"
                   value="{{ reproductive_history.priorPregnancies }}">
        </div>
        <div class="form-group">
            <label for="prior_live_births">Prior Live Births</label>
            <input type="number" id="prior_live_births" name="reproductive_history.prior_live_births"
                   value="{{ reproductive_history.priorLiveBirths }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="prior_miscarriages">Prior Miscarriages</label>
            <input type="number" id="prior_miscarriages" name="reproductive_history.prior_miscarriages"
                   value="{{ reproductive_history.priorMiscarriages }}">
        </div>
        <div class="form-group">
            <label for="prior_ectopic">Prior Ectopic</label>
            <input type="number" id="prior_ectopic" name="reproductive_history.prior_ectopic"
                   value="{{ reproductive_history.priorEctopic }}">
        </div>
        <div class="form-group">
            <label for="prior_terminations">Prior Terminations</label>
            <input type="number" id="prior_terminations" name="reproductive_history.prior_terminations"
                   value="{{ reproductive_history.priorTerminations }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="prior_fertility_treatment">Prior Fertility Treatment</label>
            <select id="prior_fertility_treatment" name="reproductive_history.prior_fertility_treatment">
                <option value="" {% if reproductive_history.priorFertilityTreatment == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reproductive_history.priorFertilityTreatment == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reproductive_history.priorFertilityTreatment == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="contraception_stopped">Contraception Stopped</label>
            <select id="contraception_stopped" name="reproductive_history.contraception_stopped">
                <option value="" {% if reproductive_history.contraceptionStopped == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if reproductive_history.contraceptionStopped == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if reproductive_history.contraceptionStopped == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="contraception_stopped_date">Contraception Stopped Date</label>
            <input type="date" id="contraception_stopped_date" name="reproductive_history.contraception_stopped_date"
                   value="{{ reproductive_history.contraceptionStoppedDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="prior_treatment_details">Prior Treatment Details</label>
        <textarea id="prior_treatment_details" name="reproductive_history.prior_treatment_details">{{ reproductive_history.priorTreatmentDetails }}</textarea>
    </div>
</div>
