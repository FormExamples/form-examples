<div class="card">
    <h2>Step 9: Investigations</h2>
    <p class="form-hint">Transvaginal ultrasound (AFC), hysterosalpingogram, hysteroscopy, laparoscopy.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="transvaginal_ultrasound">Transvaginal Ultrasound</label>
            <select id="transvaginal_ultrasound" name="investigations.transvaginal_ultrasound">
                <option value="" {% if investigations.transvaginalUltrasound == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if investigations.transvaginalUltrasound == "no" %}selected{% endif %}>Not done</option>
                <option value="yes" {% if investigations.transvaginalUltrasound == "yes" %}selected{% endif %}>Done</option>
            </select>
        </div>
        <div class="form-group">
            <label for="antral_follicle_count">Antral Follicle Count</label>
            <input type="number" id="antral_follicle_count" name="investigations.antral_follicle_count"
                   value="{{ investigations.antralFollicleCount }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hysterosalpingogram_done">HSG Done</label>
            <select id="hysterosalpingogram_done" name="investigations.hysterosalpingogram_done">
                <option value="" {% if investigations.hysterosalpingogramDone == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if investigations.hysterosalpingogramDone == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if investigations.hysterosalpingogramDone == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hysterosalpingogram_result">HSG Result</label>
            <select id="hysterosalpingogram_result" name="investigations.hysterosalpingogram_result">
                <option value="" {% if investigations.hysterosalpingogramResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if investigations.hysterosalpingogramResult == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if investigations.hysterosalpingogramResult == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hysteroscopy_done">Hysteroscopy Done</label>
            <select id="hysteroscopy_done" name="investigations.hysteroscopy_done">
                <option value="" {% if investigations.hysteroscopyDone == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if investigations.hysteroscopyDone == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if investigations.hysteroscopyDone == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hysteroscopy_result">Hysteroscopy Result</label>
            <select id="hysteroscopy_result" name="investigations.hysteroscopy_result">
                <option value="" {% if investigations.hysteroscopyResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if investigations.hysteroscopyResult == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if investigations.hysteroscopyResult == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="laparoscopy_done">Laparoscopy Done</label>
            <select id="laparoscopy_done" name="investigations.laparoscopy_done">
                <option value="" {% if investigations.laparoscopyDone == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if investigations.laparoscopyDone == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if investigations.laparoscopyDone == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="laparoscopy_result">Laparoscopy Result</label>
            <select id="laparoscopy_result" name="investigations.laparoscopy_result">
                <option value="" {% if investigations.laparoscopyResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if investigations.laparoscopyResult == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if investigations.laparoscopyResult == "abnormal" %}selected{% endif %}>Abnormal</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_investigations">Other Investigations</label>
        <textarea id="other_investigations" name="investigations.other_investigations">{{ investigations.otherInvestigations }}</textarea>
    </div>
</div>
