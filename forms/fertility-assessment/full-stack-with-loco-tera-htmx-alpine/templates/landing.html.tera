{% extends "base.html.tera" %}

{% block title %}Fertility Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Fertility Assessment</h1>
        <p class="landing-description">
            NICE CG156 Fertility Assessment for couples investigating sub-fertility.
            Captures demographics, reproductive history, menstrual cycle, medical and
            surgical history, lifestyle factors, current medications, partner factors
            and WHO 2021 semen analysis, hormone profile, ultrasound/HSG/hysteroscopy
            investigations, and the clinical recommendation. Output is a graded
            Low / Moderate / High concern report with prioritised clinician flags.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Demographics, reproductive and menstrual history, medical/surgical history, lifestyle, medications, partner semen analysis, hormones, investigations, recommendation</p>
            </div>
            <div class="feature">
                <h3>NICE CG156 Engine</h3>
                <p>Weighted ruleset across age, duration, ovarian reserve, hormones, BMI, semen analysis (WHO 2021), pelvic history, tubal investigations, and lifestyle</p>
            </div>
            <div class="feature">
                <h3>Clinical Flags</h3>
                <p>Real-time prioritised flags for urgent referral, low ovarian reserve, severe oligozoospermia, hyperprolactinaemia, BMI extremes, and modifiable lifestyle factors</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
