{% extends "base.html.tera" %}

{% block title %}Fertility Assessment Report - {{ concern_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Fertility Assessment &mdash; Report</h1>
    <div class="concern-badge {{ concern_class }}">{{ concern_label }}</div>
    <div class="concern-label">Concern score: {{ concern_score }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient and Partner</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.demographics.patientFirstName }} {{ data.demographics.patientLastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.patientDateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.patientSex }}<br>
            <strong>Ethnicity:</strong> {{ data.demographics.ethnicity }}
        </div>
        <div>
            <strong>Partner:</strong> {{ data.demographics.partnerFirstName }} {{ data.demographics.partnerLastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.partnerDateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.partnerSex }}
        </div>
    </div>
</div>

<!-- Recommendation -->
<div class="card">
    <h2>Clinical Recommendation</h2>
    <p><strong>Clinician:</strong> {{ data.clinicalRecommendation.clinicianName }}</p>
    <p><strong>Assessment Date:</strong> {{ data.clinicalRecommendation.assessmentDate }}</p>
    <p><strong>Recommendation:</strong> {{ data.clinicalRecommendation.recommendation }}</p>
    <p><strong>Referral Urgency:</strong> {{ data.clinicalRecommendation.referralUrgency }}</p>
    {% if data.clinicalRecommendation.additionalNotes %}
    <p><strong>Additional Notes:</strong><br>{{ data.clinicalRecommendation.additionalNotes }}</p>
    {% endif %}
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Clinical Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
