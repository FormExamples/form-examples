<div class="card">
    <h2>Step 6: Alterations in Arousal &amp; Reactivity (DSM-5 Cluster E)</h2>
    <p class="form-hint">In the past month, how much were you bothered by&hellip;</p>

    <div class="form-group">
        <label for="item15">15. Irritable behavior, angry outbursts, or acting aggressively?</label>
        <select id="item15" name="cluster_e.item15_irritable_or_aggressive">
            <option value="" {% if cluster_e.item15IrritableOrAggressive == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item15IrritableOrAggressive == 0 %}selected{% endif %}>0 - Not at all</option>
            <option value="1" {% if cluster_e.item15IrritableOrAggressive == 1 %}selected{% endif %}>1 - A little bit</option>
            <option value="2" {% if cluster_e.item15IrritableOrAggressive == 2 %}selected{% endif %}>2 - Moderately</option>
            <option value="3" {% if cluster_e.item15IrritableOrAggressive == 3 %}selected{% endif %}>3 - Quite a bit</option>
            <option value="4" {% if cluster_e.item15IrritableOrAggressive == 4 %}selected{% endif %}>4 - Extremely</option>
        </select>
    </div>

    <div class="form-group">
        <label for="item16">16. Taking too many risks or doing things that could cause you harm?</label>
        <select id="item16" name="cluster_e.item16_reckless_or_self_destructive">
            <option value="" {% if cluster_e.item16RecklessOrSelfDestructive == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item16RecklessOrSelfDestructive == 0 %}selected{% endif %}>0 - Not at all</option>
            <option value="1" {% if cluster_e.item16RecklessOrSelfDestructive == 1 %}selected{% endif %}>1 - A little bit</option>
            <option value="2" {% if cluster_e.item16RecklessOrSelfDestructive == 2 %}selected{% endif %}>2 - Moderately</option>
            <option value="3" {% if cluster_e.item16RecklessOrSelfDestructive == 3 %}selected{% endif %}>3 - Quite a bit</option>
            <option value="4" {% if cluster_e.item16RecklessOrSelfDestructive == 4 %}selected{% endif %}>4 - Extremely</option>
        </select>
    </div>

    <div class="form-group">
        <label for="item17">17. Being "super-alert" or watchful or on guard?</label>
        <select id="item17" name="cluster_e.item17_super_alert_or_on_guard">
            <option value="" {% if cluster_e.item17SuperAlertOrOnGuard == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item17SuperAlertOrOnGuard == 0 %}selected{% endif %}>0 - Not at all</option>
            <option value="1" {% if cluster_e.item17SuperAlertOrOnGuard == 1 %}selected{% endif %}>1 - A little bit</option>
            <option value="2" {% if cluster_e.item17SuperAlertOrOnGuard == 2 %}selected{% endif %}>2 - Moderately</option>
            <option value="3" {% if cluster_e.item17SuperAlertOrOnGuard == 3 %}selected{% endif %}>3 - Quite a bit</option>
            <option value="4" {% if cluster_e.item17SuperAlertOrOnGuard == 4 %}selected{% endif %}>4 - Extremely</option>
        </select>
    </div>

    <div class="form-group">
        <label for="item18">18. Feeling jumpy or easily startled?</label>
        <select id="item18" name="cluster_e.item18_jumpy_or_easily_startled">
            <option value="" {% if cluster_e.item18JumpyOrEasilyStartled == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item18JumpyOrEasilyStartled == 0 %}selected{% endif %}>0 - Not at all</option>
            <option value="1" {% if cluster_e.item18JumpyOrEasilyStartled == 1 %}selected{% endif %}>1 - A little bit</option>
            <option value="2" {% if cluster_e.item18JumpyOrEasilyStartled == 2 %}selected{% endif %}>2 - Moderately</option>
            <option value="3" {% if cluster_e.item18JumpyOrEasilyStartled == 3 %}selected{% endif %}>3 - Quite a bit</option>
            <option value="4" {% if cluster_e.item18JumpyOrEasilyStartled == 4 %}selected{% endif %}>4 - Extremely</option>
        </select>
    </div>

    <div class="form-group">
        <label for="item19">19. Having difficulty concentrating?</label>
        <select id="item19" name="cluster_e.item19_difficulty_concentrating">
            <option value="" {% if cluster_e.item19DifficultyConcentrating == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item19DifficultyConcentrating == 0 %}selected{% endif %}>0 - Not at all</option>
            <option value="1" {% if cluster_e.item19DifficultyConcentrating == 1 %}selected{% endif %}>1 - A little bit</option>
            <option value="2" {% if cluster_e.item19DifficultyConcentrating == 2 %}selected{% endif %}>2 - Moderately</option>
            <option value="3" {% if cluster_e.item19DifficultyConcentrating == 3 %}selected{% endif %}>3 - Quite a bit</option>
