    <div class="form-group">
        <label for="item20">20. Trouble falling or staying asleep?</label>
        <select id="item20" name="cluster_e.item20_trouble_sleeping">
            <option value="" {% if cluster_e.item20TroubleSleeping == null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if cluster_e.item20TroubleSleeping == 0 %}selected{% endif %}>0 - Not at all</option>
