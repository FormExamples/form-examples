<div class="card">
    <h2>Step 2: Trauma Event Identification</h2>
    <p class="form-hint">
        Describe the worst stressful event the patient identifies for the PCL-5 referent (DSM-5
        Criterion A). The score must be interpreted in the context of this event.
    </p>

    <div class="form-group">
        <label for="event_description">Worst trauma event (Criterion A)</label>
        <textarea id="event_description" name="trauma_event.event_description"
                  placeholder="Briefly describe the event (e.g. motor vehicle collision, combat exposure, assault).">{{ trauma_event.eventDescription }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="event_date">Approximate event date</label>
            <input type="date" id="event_date" name="trauma_event.event_date"
                   value="{{ trauma_event.eventDate }}">
        </div>
        <div class="form-group">
            <label for="is_ongoing">
                <input type="checkbox" id="is_ongoing" name="trauma_event.is_ongoing"
                       value="true" {% if trauma_event.isOngoing %}checked{% endif %}>
                Trauma is ongoing
            </label>
        </div>
    </div>
</div>
