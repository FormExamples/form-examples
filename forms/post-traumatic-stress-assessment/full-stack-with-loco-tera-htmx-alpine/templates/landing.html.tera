{% extends "base.html.tera" %}

{% block title %}Post-Traumatic Stress Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Post-Traumatic Stress Assessment</h1>
        <p class="landing-description">
            DSM-5 aligned PCL-5 (PTSD Checklist for DSM-5) symptom screen. Used by clinicians to
            identify probable PTSD, monitor severity, and track response to trauma-focused
            therapy. Twenty items, each rated 0&ndash;4, summed across the four DSM-5 clusters
            (B Intrusion, C Avoidance, D Negative Alterations, E Arousal &amp; Reactivity).
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Severity Bands</h3>
                <p>Minimal (0&ndash;20), Mild (21&ndash;32), Moderate (33&ndash;37, probable PTSD threshold), Severe (38&ndash;80)</p>
            </div>
            <div class="feature">
                <h3>DSM-5 Pattern Check</h3>
                <p>B &ge; 1, C &ge; 1, D &ge; 2, E &ge; 2 items each rated &ge; 2 (Moderately)</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for suicidality risk, dissociative features, ongoing trauma exposure, and severe symptom burden</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
