{% extends "base.html.tera" %}

{% block title %}Post-Traumatic Stress Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Clinician Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or trauma event...">
    </div>
    <div class="form-group">
        <label for="category">Severity Category</label>
        <select id="category" name="category">
            <option value="">All</option>
            <option value="Minimal" {% if category == "Minimal" %}selected{% endif %}>Minimal</option>
            <option value="Mild" {% if category == "Mild" %}selected{% endif %}>Mild</option>
            <option value="Moderate" {% if category == "Moderate" %}selected{% endif %}>Moderate</option>
            <option value="Severe" {% if category == "Severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="probable_dsm5">DSM-5 pattern</label>
        <select id="probable_dsm5" name="probable_dsm5">
            <option value="">All</option>
            <option value="yes" {% if probable_dsm5 == "yes" %}selected{% endif %}>Probable PTSD</option>
            <option value="no" {% if probable_dsm5 == "no" %}selected{% endif %}>Not probable</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent_flag">Urgent Flags</label>
        <select id="has_urgent_flag" name="has_urgent_flag">
            <option value="">All</option>
            <option value="yes" {% if has_urgent_flag == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent_flag == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Trauma Event</th>
            <th>Total Score</th>
            <th>Category</th>
            <th>Probable PTSD</th>
            <th>Urgent Flags</th>
            <th>Completed</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.firstName }} {{ c.lastName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.eventDescription }}{% if c.isOngoing %}<br><small><strong>Ongoing</strong></small>{% endif %}</td>
            <td>{{ c.totalScore }} / 80</td>
            <td><span class="severity-badge severity-{{ c.category }}">{{ c.category }}</span></td>
            <td>
                {% if c.probableDsm5Diagnosis %}
                    <span class="badge badge-no">Yes</span>
                {% else %}
                    <span class="badge badge-yes">No</span>
                {% endif %}
            </td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td><small>{{ c.timestamp }}</small></td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
