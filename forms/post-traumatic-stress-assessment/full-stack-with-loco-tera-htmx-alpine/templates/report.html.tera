{% extends "base.html.tera" %}

{% block title %}PCL-5 Assessment Report - {{ category }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Post-Traumatic Stress Assessment &mdash; PCL-5 Report</h1>
    <div class="severity-badge severity-{{ category }}">{{ category }}</div>
    <div class="checklist-label">Total Score: {{ total_score }} / 80 &mdash; {{ category_description }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}<br>
        Items answered: {{ answered_count }} / 20
    </p>
</div>

<!-- Patient summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}
        </div>
        <div>
            <strong>Trauma event:</strong> {{ data.traumaEvent.eventDescription }}<br>
            <strong>Event date:</strong> {{ data.traumaEvent.eventDate }}<br>
            <strong>Ongoing:</strong> {% if data.traumaEvent.isOngoing %}Yes{% else %}No{% endif %}
        </div>
    </div>
</div>

<!-- Cluster scores -->
<div class="card">
    <h2>DSM-5 Cluster Scores</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Cluster</th>
                <th>Items</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>B &mdash; Intrusion</td>
                <td>Items 1&ndash;5</td>
                <td>{{ cluster_scores.b }} / 20</td>
            </tr>
            <tr>
                <td>C &mdash; Avoidance</td>
                <td>Items 6&ndash;7</td>
                <td>{{ cluster_scores.c }} / 8</td>
            </tr>
            <tr>
                <td>D &mdash; Negative Alterations in Cognitions &amp; Mood</td>
                <td>Items 8&ndash;14</td>
                <td>{{ cluster_scores.d }} / 28</td>
            </tr>
            <tr>
                <td>E &mdash; Arousal &amp; Reactivity</td>
                <td>Items 15&ndash;20</td>
                <td>{{ cluster_scores.e }} / 24</td>
            </tr>
        </tbody>
    </table>
    <p style="margin-top: 1rem;">
        <strong>DSM-5 provisional diagnosis pattern:</strong>
        {% if probable_dsm5_diagnosis %}
            <span class="badge badge-no">Met (B&ge;1, C&ge;1, D&ge;2, E&ge;2 items rated &ge;2 AND total &ge; 33)</span>
        {% else %}
            <span class="badge badge-yes">Not met</span>
        {% endif %}
    </p>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">[{{ flag.id }}] {{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Clinical Summary Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge severity-{{ rule.severity }}">{{ rule.severity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
