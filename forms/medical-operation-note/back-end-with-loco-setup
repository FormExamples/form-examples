    --api

cargo loco generate scaffold medical_operation_note_grade \
    deleted_at:tstz \
    medical_operation_note:references \
    computed_composite_risk:string! \
    final_composite_risk:string! \
    override_reason:string! \
    worst_clavien_dindo_grade:string! \
    asa_physical_status:string! \
    blood_loss_band:string! \
    counts_agreed:string! \
    never_event_suspected:string! \
    recommendation:string! \
    surgeon_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold medical_operation_note_grade_rule \
    deleted_at:tstz \
    medical_operation_note_grade:references \
    rule_id:string! \
    instrument:string! \
    band:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold medical_operation_note_grade_flag \
    deleted_at:tstz \
    medical_operation_note_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
