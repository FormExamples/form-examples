    laterality:string! \
    sequence_index:int! \
    --api

cargo loco generate scaffold medical_operation_note_step \
    deleted_at:tstz \
    medical_operation_note:references \
    step_number:int! \
    title:string! \
    description:text! \
    --api

cargo loco generate scaffold medical_operation_note_implant \
    deleted_at:tstz \
    medical_operation_note:references \
    category:string! \
    name:string! \
    size_or_gauge:string! \
    quantity:int! \
    manufacturer:string! \
    lot_number:string! \
    serial_number:string! \
    batch_number:string! \
    expiry_date:date \
    udi_di:string! \
    implant_site:string! \
    registry_required:string! \
    registry_submitted:string! \
    notes:text! \
    --api

cargo loco generate scaffold medical_operation_note_drain \
    deleted_at:tstz \
    medical_operation_note:references \
    device_type:string! \
    name:string! \
    site:string! \
    size_or_gauge:string! \
    output_target:string! \
    removal_plan:string! \
    removal_by_date:date \
    quantity:int! \
    notes:text! \
    --api

cargo loco generate scaffold medical_operation_note_specimen \
    deleted_at:tstz \
    medical_operation_note:references \
    label:string! \
    specimen_type:string! \
    anatomical_site:string! \
    container:string! \
    fixative:string! \
    destination:string! \
    urgency:string! \
    label_verified:string! \
    chain_of_custody_documented:string! \
