#!/bin/sh
set -euf

form_kebab_case=medical-operation-note
form_snake_case=medical_operation_note

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold medical_operation_note \
    deleted_at:tstz \
    patient:references \
    lead_surgeon:references \
    status:string! \
    hospital_name:string! \
    theatre_number:string! \
    list_type:string! \
    case_start_at:tstz \
    anaesthesia_start_at:tstz \
    knife_to_skin_at:tstz \
    end_of_surgery_at:tstz \
    case_end_at:tstz \
    consent_status:string! \
    side_marked:string! \
    sign_in_completed:string! \
    asa_physical_status:string! \
    pre_operative_diagnosis:text! \
    post_operative_diagnosis:text! \
    indication:text! \
    urgency:string! \
    laterality:string! \
    anaesthesia_type:string! \
    airway_management:string! \
    induction_agent:string! \
    maintenance_agent:string! \
    neuromuscular_blockade:string! \
    regional_block_description:string! \
    invasive_monitoring:text! \
    intraop_crystalloid_ml:int \
    intraop_colloid_ml:int \
    intraop_blood_ml:int \
    intraop_urine_ml:int \
    anaesthetic_event:string! \
    anaesthetic_event_description:text! \
    patient_position:string! \
    pressure_area_protection_notes:text! \
    prep_solution:string! \
    drape_type:string! \
    surgical_approach:string! \
    incision_type:string! \
    incision_length_cm:double \
    table_tilt:string! \
    tourniquet_used:string! \
    tourniquet_site:string! \
    tourniquet_pressure_mmhg:int \
    tourniquet_on_at:tstz \
    tourniquet_off_at:tstz \
    converted_to_open:string! \
    conversion_reason:text! \
    operative_findings_summary:text! \
    pathology_found:text! \
    anatomical_anomalies:text! \
    intraop_photographs_taken:string! \
    frozen_section_requested:string! \
    swab_count_first_agreed:string! \
    swab_count_final_agreed:string! \
    needle_count_first_agreed:string! \
    needle_count_final_agreed:string! \
    instrument_count_first_agreed:string! \
    instrument_count_final_agreed:string! \
    count_discrepancy_resolution:text! \
    estimated_blood_loss_ml:int \
    transfusion_given:string! \
    prbc_units:int \
    ffp_units:int \
    platelet_units:int \
    cryoprecipitate_units:int \
    cell_salvage_ml:int \
    massive_haemorrhage_protocol_activated:string! \
    never_event_flagged:string! \
    never_event_description:text! \
    equipment_problem:string! \
    equipment_problem_description:text! \
    recovery_destination:string! \
    monitoring_frequency:string! \
    iv_fluids_plan:string! \
    analgesia_plan:text! \
    antibiotic_plan:string! \
    vte_prophylaxis_plan:string! \
    diet_plan:string! \
    mobilisation_plan:string! \
    wound_care_plan:text! \
    follow_up_plan:text! \
    special_instructions:text! \
    sign_out_completed:string! \
    debrief_completed:string! \
    surgeon_override_grade:string! \
    surgeon_override_reason:text! \
    attestation_text:text! \
    electronic_signature:text! \
    dictated_at:tstz \
    signed_at:tstz \
    --api

cargo loco generate scaffold medical_operation_note_team_member \
    deleted_at:tstz \
    medical_operation_note:references \
    clinician:references \
    team_role:string! \
    arrived_at:tstz \
    left_at:tstz \
    notes:text! \
    --api

cargo loco generate scaffold medical_operation_note_procedure \
    deleted_at:tstz \
    medical_operation_note:references \
    role:string! \
    opcs4_code:string! \
    name:string! \
