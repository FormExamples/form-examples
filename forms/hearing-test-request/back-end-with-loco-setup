#!/bin/sh
set -euf

form_kebab_case=hearing-test-request
form_snake_case=hearing_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold hearing_test_request \
    deleted_at:ts \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    test_type:string! \
    laterality:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    symptom_hearing_loss:bool! \
    symptom_tinnitus:bool! \
    symptom_vertigo:bool! \
    symptom_otalgia:bool! \
    sudden_onset:bool! \
    ear_discharge:bool! \
    ototoxic_medication:bool! \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    notes:string! \
    --api

cargo loco generate scaffold hearing_test_request_grade \
    deleted_at:ts \
    hearing_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    triage_tier:string! \
    target_timeframe:string! \
    completeness_percent:int \
    priority_band:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold hearing_test_request_grade_rule \
    deleted_at:ts \
    hearing_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold hearing_test_request_grade_flag \
    deleted_at:ts \
    hearing_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
