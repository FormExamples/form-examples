<div class="card">
    <h2>Step 5: Breathing (B)</h2>
    <p class="form-hint">Tick "Normal" or record respiratory rate / abnormal findings; record interventions.</p>

    <div class="form-row">
        <label><input type="checkbox" name="breathing.normal__cb" value="on" {% if breathing.normal %}checked{% endif %}> Normal</label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="spontaneous_rr">Spontaneous respiratory rate</label>
            <input type="number" step="any" id="spontaneous_rr" name="breathing.spontaneous_respiratory_rate"
                   value="{{ breathing.spontaneousRespiratoryRate | default(value='') }}">
        </div>
    </div>

    <h3>Chest rise</h3>
    <div class="form-row">
        <label><input type="checkbox" name="breathing.chest_rise_shallow__cb" value="on" {% if breathing.chestRiseShallow %}checked{% endif %}> Shallow</label>
        <label><input type="checkbox" name="breathing.chest_rise_retractions__cb" value="on" {% if breathing.chestRiseRetractions %}checked{% endif %}> Retractions</label>
        <label><input type="checkbox" name="breathing.chest_rise_paradoxical__cb" value="on" {% if breathing.chestRiseParadoxical %}checked{% endif %}> Paradoxical</label>
    </div>

    <h3>Trachea</h3>
    <div class="form-row">
        <label><input type="checkbox" name="breathing.trachea_midline__cb" value="on" {% if breathing.tracheaMidline %}checked{% endif %}> Midline</label>
        <label><input type="checkbox" name="breathing.trachea_deviated_left__cb" value="on" {% if breathing.tracheaDeviatedLeft %}checked{% endif %}> Deviated L</label>
        <label><input type="checkbox" name="breathing.trachea_deviated_right__cb" value="on" {% if breathing.tracheaDeviatedRight %}checked{% endif %}> Deviated R</label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="breath_sounds_left">Breath sounds L</label>
            <input type="text" id="breath_sounds_left" name="breathing.breath_sounds_left"
                   value="{{ breathing.breathSoundsLeft }}">
        </div>
        <div class="form-group">
            <label for="breath_sounds_right">Breath sounds R</label>
            <input type="text" id="breath_sounds_right" name="breathing.breath_sounds_right"
                   value="{{ breathing.breathSoundsRight }}">
        </div>
        <div class="form-group">
            <label for="oxygen_litres">Oxygen (L)</label>
            <input type="number" step="any" id="oxygen_litres" name="breathing.oxygen_litres"
                   value="{{ breathing.oxygenLitres | default(value='') }}">
        </div>
    </div>

    <h3>Oxygen / ventilation</h3>
    <div class="form-row">
        <label><input type="checkbox" name="breathing.oxygen_nasal_cannula__cb" value="on" {% if breathing.oxygenNasalCannula %}checked{% endif %}> NC</label>
        <label><input type="checkbox" name="breathing.oxygen_mask__cb" value="on" {% if breathing.oxygenMask %}checked{% endif %}> Mask</label>
        <label><input type="checkbox" name="breathing.oxygen_non_rebreather__cb" value="on" {% if breathing.oxygenNonRebreather %}checked{% endif %}> NRB</label>
        <label><input type="checkbox" name="breathing.oxygen_bvm__cb" value="on" {% if breathing.oxygenBvm %}checked{% endif %}> BVM</label>
        <label><input type="checkbox" name="breathing.oxygen_cpap_bipap__cb" value="on" {% if breathing.oxygenCpapBipap %}checked{% endif %}> CPAP / BiPAP</label>
        <label><input type="checkbox" name="breathing.oxygen_ventilator__cb" value="on" {% if breathing.oxygenVentilator %}checked{% endif %}> Ventilator</label>
        <label><input type="checkbox" name="breathing.bronchodilator__cb" value="on" {% if breathing.bronchodilator %}checked{% endif %}> Bronchodilator</label>
    </div>

    <div class="form-group">
        <label for="breathing_notes">Breathing notes</label>
        <textarea id="breathing_notes" name="breathing.notes" rows="2">{{ breathing.notes }}</textarea>
    </div>
</div>
