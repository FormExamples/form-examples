<div class="card">
    <h2>Step 13: Additional Interventions</h2>
    <p class="form-hint">Medications, fluids, blood products, procedures (with times and outcomes).</p>

    <h3>Medications &amp; fluids</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="med_time">Time (24h)</label>
            <input type="time" id="med_time" name="additional_interventions.medications.time"
                   value="{{ additional_interventions.medications.time }}">
        </div>
        <div class="form-group">
            <label for="med_ivf_mls">IVF (mL)</label>
            <input type="number" step="any" id="med_ivf_mls" name="additional_interventions.medications.ivf_mls"
                   value="{{ additional_interventions.medications.ivfMls | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="med_ivf_type">IVF type</label>
            <input type="text" id="med_ivf_type" name="additional_interventions.medications.ivf_type"
                   value="{{ additional_interventions.medications.ivfType }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="blood_units">Blood products (units)</label>
            <input type="text" id="blood_units" name="additional_interventions.medications.blood_products_units"
                   value="{{ additional_interventions.medications.bloodProductsUnits }}">
        </div>
        <div class="form-group">
            <label for="opioid">Opioid analgesia</label>
            <input type="text" id="opioid" name="additional_interventions.medications.opioid_analgesia"
                   value="{{ additional_interventions.medications.opioidAnalgesia }}">
        </div>
        <div class="form-group">
            <label for="other_analgesia">Other analgesia</label>
            <input type="text" id="other_analgesia" name="additional_interventions.medications.other_analgesia"
                   value="{{ additional_interventions.medications.otherAnalgesia }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="sedation">Sedation / paralytics</label>
            <input type="text" id="sedation" name="additional_interventions.medications.sedation_paralytics"
                   value="{{ additional_interventions.medications.sedationParalytics }}">
        </div>
        <div class="form-group">
            <label for="antimicrobials">Antimicrobials</label>
            <input type="text" id="antimicrobials" name="additional_interventions.medications.antimicrobials"
                   value="{{ additional_interventions.medications.antimicrobials }}">
        </div>
        <div class="form-group">
            <label for="tetanus">Tetanus</label>
            <input type="text" id="tetanus" name="additional_interventions.medications.tetanus"
                   value="{{ additional_interventions.medications.tetanus }}">
        </div>
    </div>
    <div class="form-group">
        <label for="med_other">Other medications</label>
        <input type="text" id="med_other" name="additional_interventions.medications.other"
               value="{{ additional_interventions.medications.other }}">
    </div>

    <h3>Procedures</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="intubation_time">Intubation time</label>
            <input type="time" id="intubation_time" name="additional_interventions.procedures.intubation_time"
                   value="{{ additional_interventions.procedures.intubationTime }}">
        </div>
        <div class="form-group">
            <label for="intubation_outcome">Intubation outcome</label>
            <input type="text" id="intubation_outcome" name="additional_interventions.procedures.intubation_outcome"
                   value="{{ additional_interventions.procedures.intubationOutcome }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="chest_tube_time">Chest tube time</label>
            <input type="time" id="chest_tube_time" name="additional_interventions.procedures.chest_tube_time"
                   value="{{ additional_interventions.procedures.chestTubeTime }}">
        </div>
        <div class="form-group">
            <label for="chest_tube_outcome">Chest tube outcome</label>
            <input type="text" id="chest_tube_outcome" name="additional_interventions.procedures.chest_tube_outcome"
                   value="{{ additional_interventions.procedures.chestTubeOutcome }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="lp_time">Lumbar puncture time</label>
            <input type="time" id="lp_time" name="additional_interventions.procedures.lumbar_puncture_time"
                   value="{{ additional_interventions.procedures.lumbarPunctureTime }}">
        </div>
        <div class="form-group">
            <label for="lp_outcome">LP outcome</label>
            <input type="text" id="lp_outcome" name="additional_interventions.procedures.lumbar_puncture_outcome"
                   value="{{ additional_interventions.procedures.lumbarPunctureOutcome }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="lac_time">Laceration repair time</label>
            <input type="time" id="lac_time" name="additional_interventions.procedures.laceration_repair_time"
                   value="{{ additional_interventions.procedures.lacerationRepairTime }}">
        </div>
        <div class="form-group">
            <label for="lac_outcome">Laceration repair outcome</label>
            <input type="text" id="lac_outcome" name="additional_interventions.procedures.laceration_repair_outcome"
                   value="{{ additional_interventions.procedures.lacerationRepairOutcome }}">
        </div>
    </div>
    <div class="form-group">
        <label for="proc_other">Other procedures</label>
        <input type="text" id="proc_other" name="additional_interventions.procedures.other"
               value="{{ additional_interventions.procedures.other }}">
    </div>
</div>
