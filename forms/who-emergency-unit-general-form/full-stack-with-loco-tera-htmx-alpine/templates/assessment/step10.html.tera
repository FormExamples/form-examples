<div class="card">
    <h2>Step 10: Past Medical History</h2>
    <p class="form-hint">Medications, allergies, pregnancy, substance use, family/surgical history.</p>

    <div class="form-group">
        <label for="history_obtained_from">History obtained from</label>
        <input type="text" id="history_obtained_from" name="past_medical_history.history_obtained_from"
               value="{{ past_medical_history.historyObtainedFrom }}">
    </div>

    <div class="form-group">
        <label for="medications">Medications</label>
        <textarea id="medications" name="past_medical_history.medications" rows="2">{{ past_medical_history.medications }}</textarea>
        <label><input type="checkbox" name="past_medical_history.medications_unknown__cb" value="on" {% if past_medical_history.medicationsUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <div class="form-group">
        <label for="allergies">Allergies</label>
        <textarea id="allergies" name="past_medical_history.allergies" rows="2">{{ past_medical_history.allergies }}</textarea>
        <label><input type="checkbox" name="past_medical_history.allergies_unknown__cb" value="on" {% if past_medical_history.allergiesUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="last_menstrual_cycle">Last Menstrual Cycle</label>
            <input type="date" id="last_menstrual_cycle" name="past_medical_history.last_menstrual_cycle"
                   value="{{ past_medical_history.lastMenstrualCycle }}">
        </div>
        <div class="form-group">
            <label for="gravida">Gravida</label>
            <input type="number" step="1" id="gravida" name="past_medical_history.gravida"
                   value="{{ past_medical_history.gravida | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="para">Para</label>
            <input type="number" step="1" id="para" name="past_medical_history.para"
                   value="{{ past_medical_history.para | default(value='') }}">
        </div>
        <label><input type="checkbox" name="past_medical_history.lmp_unknown__cb" value="on" {% if past_medical_history.lmpUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <div class="form-group">
        <label for="pregnant">Pregnant?</label>
        <select id="pregnant" name="past_medical_history.pregnant">
            <option value="" {% if past_medical_history.pregnant == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if past_medical_history.pregnant == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if past_medical_history.pregnant == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <h3>Substance use</h3>
    <div class="form-row">
        <label><input type="checkbox" name="past_medical_history.tobacco_use__cb" value="on" {% if past_medical_history.tobaccoUse %}checked{% endif %}> Tobacco</label>
        <label><input type="checkbox" name="past_medical_history.alcohol_use__cb" value="on" {% if past_medical_history.alcoholUse %}checked{% endif %}> Alcohol</label>
        <label><input type="checkbox" name="past_medical_history.drug_use__cb" value="on" {% if past_medical_history.drugUse %}checked{% endif %}> Drugs</label>
        <label><input type="checkbox" name="past_medical_history.iv_drug_use__cb" value="on" {% if past_medical_history.ivDrugUse %}checked{% endif %}> IV drugs</label>
        <label><input type="checkbox" name="past_medical_history.substance_use_unknown__cb" value="on" {% if past_medical_history.substanceUseUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <h3>Past Medical</h3>
    <div class="form-row">
        <label><input type="checkbox" name="past_medical_history.pmh_htn__cb" value="on" {% if past_medical_history.pmhHtn %}checked{% endif %}> HTN</label>
        <label><input type="checkbox" name="past_medical_history.pmh_dm__cb" value="on" {% if past_medical_history.pmhDm %}checked{% endif %}> DM</label>
        <label><input type="checkbox" name="past_medical_history.pmh_copd__cb" value="on" {% if past_medical_history.pmhCopd %}checked{% endif %}> COPD</label>
        <label><input type="checkbox" name="past_medical_history.pmh_psych__cb" value="on" {% if past_medical_history.pmhPsych %}checked{% endif %}> Psych</label>
        <label><input type="checkbox" name="past_medical_history.pmh_renal_disease__cb" value="on" {% if past_medical_history.pmhRenalDisease %}checked{% endif %}> Renal disease</label>
        <label><input type="checkbox" name="past_medical_history.pmh_unknown__cb" value="on" {% if past_medical_history.pmhUnknown %}checked{% endif %}> Unknown</label>
    </div>
    <div class="form-group">
        <label for="pmh_other">Other past medical</label>
        <input type="text" id="pmh_other" name="past_medical_history.pmh_other"
               value="{{ past_medical_history.pmhOther }}">
    </div>

    <div class="form-group">
        <label for="family_history">Family history</label>
        <textarea id="family_history" name="past_medical_history.family_history" rows="2">{{ past_medical_history.familyHistory }}</textarea>
        <label><input type="checkbox" name="past_medical_history.family_history_unknown__cb" value="on" {% if past_medical_history.familyHistoryUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <div class="form-group">
        <label for="past_surgeries">Past surgeries (type &amp; date)</label>
        <textarea id="past_surgeries" name="past_medical_history.past_surgeries" rows="2">{{ past_medical_history.pastSurgeries }}</textarea>
        <label><input type="checkbox" name="past_medical_history.past_surgeries_unknown__cb" value="on" {% if past_medical_history.pastSurgeriesUnknown %}checked{% endif %}> Unknown</label>
    </div>

    <div class="form-group">
        <label for="safe_at_home">Safe at home?</label>
        <input type="text" id="safe_at_home" name="past_medical_history.safe_at_home"
               value="{{ past_medical_history.safeAtHome }}">
    </div>
</div>
