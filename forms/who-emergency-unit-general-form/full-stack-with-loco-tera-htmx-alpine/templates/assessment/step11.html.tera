<div class="card">
    <h2>Step 11: Physical Exam</h2>
    <p class="form-hint">11 body systems. Tick "Normal" or add notes (specify L / R if needed).</p>

    <fieldset class="pe-row">
        <legend>General</legend>
        <label><input type="checkbox" name="physical_exam.general.normal__cb" value="on" {% if physical_exam.general.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.general.notes" value="{{ physical_exam.general.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Neuro / Psych</legend>
        <label><input type="checkbox" name="physical_exam.neuro_psych.normal__cb" value="on" {% if physical_exam.neuroPsych.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.neuro_psych.notes" value="{{ physical_exam.neuroPsych.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>HEENT</legend>
        <label><input type="checkbox" name="physical_exam.heent.normal__cb" value="on" {% if physical_exam.heent.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.heent.notes" value="{{ physical_exam.heent.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Neck</legend>
        <label><input type="checkbox" name="physical_exam.neck.normal__cb" value="on" {% if physical_exam.neck.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.neck.notes" value="{{ physical_exam.neck.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Respiratory</legend>
        <label><input type="checkbox" name="physical_exam.respiratory.normal__cb" value="on" {% if physical_exam.respiratory.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.respiratory.notes" value="{{ physical_exam.respiratory.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Cardiac</legend>
        <label><input type="checkbox" name="physical_exam.cardiac.normal__cb" value="on" {% if physical_exam.cardiac.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.cardiac.notes" value="{{ physical_exam.cardiac.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Abdominal</legend>
        <label><input type="checkbox" name="physical_exam.abdominal.normal__cb" value="on" {% if physical_exam.abdominal.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.abdominal.notes" value="{{ physical_exam.abdominal.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Pelvis / GU / Rectal</legend>
        <label><input type="checkbox" name="physical_exam.pelvis_gu_rectal.normal__cb" value="on" {% if physical_exam.pelvisGuRectal.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.pelvis_gu_rectal.notes" value="{{ physical_exam.pelvisGuRectal.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Lymph</legend>
        <label><input type="checkbox" name="physical_exam.lymph.normal__cb" value="on" {% if physical_exam.lymph.normal %}checked{% endif %}> Normal</label>
        <input type="text" name="physical_exam.lymph.notes" value="{{ physical_exam.lymph.notes }}" placeholder="Notes">
    </fieldset>
    <fieldset class="pe-row">
        <legend>Musculoskeletal</legend>
        <label><input type="checkbox" name="physical_exam.musculoskeletal.normal__cb" value="on" {% if physical_exam.musculoskeletal.normal %}checked{% endif %}> Normal</label>
