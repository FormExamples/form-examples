<div class="card">
    <h2>Step 15: Reassessment</h2>
    <p class="form-hint">Repeat vitals and condition status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="reass_time">Time (24h)</label>
            <input type="time" id="reass_time" name="reassessment.time"
                   value="{{ reassessment.time }}">
        </div>
        <div class="form-group">
            <label for="reass_temp_c">Temp (°C)</label>
            <input type="number" step="0.1" id="reass_temp_c" name="reassessment.temp_c"
                   value="{{ reassessment.tempC | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="reass_pulse">Pulse</label>
            <input type="number" step="any" id="reass_pulse" name="reassessment.pulse"
                   value="{{ reassessment.pulse | default(value='') }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="reass_sbp">SBP</label>
            <input type="number" step="any" id="reass_sbp" name="reassessment.bp_systolic"
                   value="{{ reassessment.bpSystolic | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="reass_dbp">DBP</label>
            <input type="number" step="any" id="reass_dbp" name="reassessment.bp_diastolic"
                   value="{{ reassessment.bpDiastolic | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="reass_rr">RR</label>
            <input type="number" step="any" id="reass_rr" name="reassessment.respiratory_rate"
                   value="{{ reassessment.respiratoryRate | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="reass_spo2">SpO2 (%)</label>
            <input type="number" step="any" id="reass_spo2" name="reassessment.spo2"
                   value="{{ reassessment.spo2 | default(value='') }}">
        </div>
    </div>

    <div class="form-row">
        <label><input type="checkbox" name="reassessment.condition_same__cb" value="on" {% if reassessment.conditionSame %}checked{% endif %}> Condition same</label>
    </div>
    <div class="form-group">
        <label for="condition_changes">Condition changes</label>
        <textarea id="condition_changes" name="reassessment.condition_changes" rows="2">{{ reassessment.conditionChanges }}</textarea>
    </div>
</div>
