<div class="card">
    <h2>Step 1: Patient Registration</h2>
    <p class="form-hint">Demographics, arrival mode, ambulance details.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="hospital_registration_number">Hospital Registration Number</label>
            <input type="text" id="hospital_registration_number" name="patient_registration.hospital_registration_number"
                   value="{{ patient_registration.hospitalRegistrationNumber }}">
        </div>
        <div class="form-group">
            <label for="surname">Surname (family name)</label>
            <input type="text" id="surname" name="patient_registration.surname"
                   value="{{ patient_registration.surname }}">
        </div>
        <div class="form-group">
            <label for="first_name">First name (given name)</label>
            <input type="text" id="first_name" name="patient_registration.first_name"
                   value="{{ patient_registration.firstName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="patient_registration.sex">
                <option value="" {% if patient_registration.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="male" {% if patient_registration.sex == "male" %}selected{% endif %}>Male</option>
                <option value="female" {% if patient_registration.sex == "female" %}selected{% endif %}>Female</option>
                <option value="other" {% if patient_registration.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="date_of_birth">Date of birth</label>
            <input type="date" id="date_of_birth" name="patient_registration.date_of_birth"
                   value="{{ patient_registration.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="weight_kg">Weight (kg)</label>
            <input type="number" step="0.1" id="weight_kg" name="patient_registration.weight_kg"
                   value="{{ patient_registration.weightKg | default(value='') }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_arrival">Date of arrival</label>
            <input type="date" id="date_of_arrival" name="patient_registration.date_of_arrival"
                   value="{{ patient_registration.dateOfArrival }}">
        </div>
        <div class="form-group">
            <label for="time_of_arrival">Time of arrival (24h)</label>
            <input type="time" id="time_of_arrival" name="patient_registration.time_of_arrival"
                   value="{{ patient_registration.timeOfArrival }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="arrival_mode">Arrival mode</label>
            <select id="arrival_mode" name="patient_registration.arrival_mode">
                <option value="" {% if patient_registration.arrivalMode == "" %}selected{% endif %}>&mdash;</option>
                <option value="ambulance" {% if patient_registration.arrivalMode == "ambulance" %}selected{% endif %}>Ambulance</option>
                <option value="car-private" {% if patient_registration.arrivalMode == "car-private" %}selected{% endif %}>Car (private)</option>
                <option value="car-taxi" {% if patient_registration.arrivalMode == "car-taxi" %}selected{% endif %}>Car (taxi)</option>
                <option value="motor-2-3-private" {% if patient_registration.arrivalMode == "motor-2-3-private" %}selected{% endif %}>2/3-wheel motor (private)</option>
                <option value="motor-2-3-taxi" {% if patient_registration.arrivalMode == "motor-2-3-taxi" %}selected{% endif %}>2/3-wheel motor (taxi)</option>
                <option value="public-transport" {% if patient_registration.arrivalMode == "public-transport" %}selected{% endif %}>Public transport</option>
                <option value="walk" {% if patient_registration.arrivalMode == "walk" %}selected{% endif %}>Walk</option>
                <option value="other" {% if patient_registration.arrivalMode == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ambulance_level">Ambulance level (if ambulance)</label>
            <select id="ambulance_level" name="patient_registration.ambulance_level">
                <option value="" {% if patient_registration.ambulanceLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="basic" {% if patient_registration.ambulanceLevel == "basic" %}selected{% endif %}>Basic</option>
                <option value="advanced" {% if patient_registration.ambulanceLevel == "advanced" %}selected{% endif %}>Advanced</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="occupation">Occupation</label>
        <input type="text" id="occupation" name="patient_registration.occupation"
               value="{{ patient_registration.occupation }}">
    </div>
</div>
