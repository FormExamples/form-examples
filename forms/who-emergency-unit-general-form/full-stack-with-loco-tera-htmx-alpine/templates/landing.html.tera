{% extends "base.html.tera" %}

{% block title %}WHO Emergency Unit Form: General - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>WHO Emergency Unit Form: General</h1>
        <p class="landing-description">
            World Health Organization standardised emergency unit clinical documentation
            form for general (non-trauma) patients. Captures registration, vital signs,
            ABCD primary survey, history, review of systems, physical exam, diagnostics,
            interventions, and disposition.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>16 Steps</h3>
                <p>Registration, Vitals, High Risk, Airway, Breathing, Circulation, Disability, HPI, ROS, PMH, Exam, Diagnostics, Interventions, A&amp;P, Reassessment, Disposition.</p>
            </div>
            <div class="feature">
                <h3>AVPU + Vitals</h3>
                <p>Triage category, AVPU level (Alert / Verbal / Pain / Unresponsive), and full vital sign capture with thresholds.</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Critical SpO2, abnormal AVPU, hypoglycaemia, dead-on-arrival, LWBS and other clinically significant findings escalate for review.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Encounter
            </button>
        </form>
    </div>
</div>
{% endblock %}
