{% extends "base.html.tera" %}

{% block title %}WHO Emergency Unit Form: General - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Emergency Unit Dashboard</h1>
    <a href="/" class="btn btn-primary">New Encounter</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, hospital reg., or chief complaint...">
    </div>
    <div class="form-group">
        <label for="encounter_status">Status</label>
        <select id="encounter_status" name="encounter_status">
            <option value="">All</option>
            <option value="not-started" {% if encounter_status == "not-started" %}selected{% endif %}>Not Started</option>
            <option value="in-progress" {% if encounter_status == "in-progress" %}selected{% endif %}>In Progress</option>
            <option value="complete" {% if encounter_status == "complete" %}selected{% endif %}>Complete</option>
            <option value="complete-with-concerns" {% if encounter_status == "complete-with-concerns" %}selected{% endif %}>Complete (with concerns)</option>
            <option value="abandoned" {% if encounter_status == "abandoned" %}selected{% endif %}>Abandoned</option>
        </select>
    </div>
    <div class="form-group">
        <label for="triage_category">Triage</label>
        <select id="triage_category" name="triage_category">
            <option value="">All</option>
            <option value="red" {% if triage_category == "red" %}selected{% endif %}>Red</option>
            <option value="orange" {% if triage_category == "orange" %}selected{% endif %}>Orange</option>
            <option value="yellow" {% if triage_category == "yellow" %}selected{% endif %}>Yellow</option>
            <option value="green" {% if triage_category == "green" %}selected{% endif %}>Green</option>
        </select>
    </div>
    <div class="form-group">
        <label for="disposition">Disposition</label>
        <select id="disposition" name="disposition">
            <option value="">All</option>
            <option value="admit" {% if disposition == "admit" %}selected{% endif %}>Admit</option>
            <option value="transfer" {% if disposition == "transfer" %}selected{% endif %}>Transfer</option>
            <option value="discharge" {% if disposition == "discharge" %}selected{% endif %}>Discharge</option>
            <option value="died" {% if disposition == "died" %}selected{% endif %}>Died</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Flags (urgent / high)</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} encounter{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Arrival</th>
            <th>Patient</th>
            <th>Chief Complaint</th>
            <th>Triage</th>
            <th>Arrival Mode</th>
            <th>Disposition</th>
            <th>Status</th>
            <th>Completion</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.dateOfArrival }} {{ c.timeOfArrival }}</a></td>
            <td>{{ c.patientName }}<br><small>{{ c.hospitalRegistrationNumber }}</small></td>
            <td>{{ c.chiefComplaint }}</td>
            <td>{{ c.triageCategory }}</td>
            <td>{{ c.arrivalMode }}</td>
            <td>{{ c.disposition }}</td>
            <td><span class="checklist-badge checklist-{{ c.encounterStatus }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.encounterStatus }}</span></td>
            <td>{{ c.overallPercent }}%</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">U:{{ c.urgentFlagCount }}</span>
                {% endif %}
                {% if c.highFlagCount > 0 %}
                    <span class="badge badge-no">H:{{ c.highFlagCount }}</span>
                {% endif %}
                {% if c.urgentFlagCount == 0 and c.highFlagCount == 0 %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No encounters found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
