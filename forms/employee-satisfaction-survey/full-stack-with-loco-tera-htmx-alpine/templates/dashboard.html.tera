{% extends "base.html.tera" %}

{% block title %}Employee Satisfaction Survey - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>HR & Engagement Dashboard</h1>
    <a href="/" class="btn btn-primary">New Survey</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="department">Department</label>
        <select id="department" name="department">
            <option value="">All</option>
            <option value="operations" {% if department == "operations" %}selected{% endif %}>Operations</option>
            <option value="engineering" {% if department == "engineering" %}selected{% endif %}>Engineering / IT</option>
            <option value="sales-marketing" {% if department == "sales-marketing" %}selected{% endif %}>Sales / Marketing</option>
            <option value="customer-service" {% if department == "customer-service" %}selected{% endif %}>Customer Service</option>
            <option value="finance" {% if department == "finance" %}selected{% endif %}>Finance</option>
            <option value="human-resources" {% if department == "human-resources" %}selected{% endif %}>Human Resources</option>
            <option value="administration" {% if department == "administration" %}selected{% endif %}>Administration</option>
            <option value="clinical" {% if department == "clinical" %}selected{% endif %}>Clinical / Care</option>
            <option value="research" {% if department == "research" %}selected{% endif %}>Research</option>
            <option value="leadership" {% if department == "leadership" %}selected{% endif %}>Leadership / Executive</option>
            <option value="other" {% if department == "other" %}selected{% endif %}>Other / Prefer not to say</option>
        </select>
    </div>
    <div class="form-group">
        <label for="tenure_band">Tenure</label>
        <select id="tenure_band" name="tenure_band">
            <option value="">All</option>
            <option value="less-than-1-year" {% if tenure_band == "less-than-1-year" %}selected{% endif %}>Less than 1 year</option>
            <option value="1-to-3-years" {% if tenure_band == "1-to-3-years" %}selected{% endif %}>1 to 3 years</option>
            <option value="3-to-5-years" {% if tenure_band == "3-to-5-years" %}selected{% endif %}>3 to 5 years</option>
            <option value="5-to-10-years" {% if tenure_band == "5-to-10-years" %}selected{% endif %}>5 to 10 years</option>
            <option value="more-than-10-years" {% if tenure_band == "more-than-10-years" %}selected{% endif %}>More than 10 years</option>
        </select>
    </div>
    <div class="form-group">
        <label for="category">Category</label>
        <select id="category" name="category">
            <option value="">All</option>
            <option value="excellent" {% if category == "excellent" %}selected{% endif %}>Excellent</option>
            <option value="good" {% if category == "good" %}selected{% endif %}>Good</option>
            <option value="satisfactory" {% if category == "satisfactory" %}selected{% endif %}>Satisfactory</option>
            <option value="poor" {% if category == "poor" %}selected{% endif %}>Poor</option>
            <option value="very-poor" {% if category == "very-poor" %}selected{% endif %}>Very Poor</option>
        </select>
    </div>
    <div class="form-group">
        <label for="retention_intent">Retention</label>
        <select id="retention_intent" name="retention_intent">
            <option value="">All</option>
            <option value="definitely-stay" {% if retention_intent == "definitely-stay" %}selected{% endif %}>Definitely stay</option>
            <option value="probably-stay" {% if retention_intent == "probably-stay" %}selected{% endif %}>Probably stay</option>
            <option value="unsure" {% if retention_intent == "unsure" %}selected{% endif %}>Unsure</option>
            <option value="probably-leave-12-months" {% if retention_intent == "probably-leave-12-months" %}selected{% endif %}>Probably leave (12mo)</option>
            <option value="leaving-within-6-months" {% if retention_intent == "leaving-within-6-months" %}selected{% endif %}>Leaving (6mo)</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed response{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Submitted</th>
            <th>Department</th>
            <th>Tenure</th>
            <th>Role Level</th>
            <th>Location</th>
            <th>Composite</th>
            <th>Category</th>
            <th>eNPS</th>
            <th>Retention</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for r in responses %}
        <tr>
            <td><a href="/assessment/{{ r.id }}/report">{{ r.createdAt }}</a></td>
            <td>{{ r.department }}</td>
            <td>{{ r.tenureBand }}</td>
            <td>{{ r.roleLevel }}</td>
            <td>{{ r.workLocation }}</td>
            <td>{% if r.compositeScore is not undefined and r.compositeScore is not null %}{{ r.compositeScore }}{% else %}&mdash;{% endif %}</td>
            <td><span class="cat-badge cat-{{ r.category }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ r.category }}</span></td>
            <td>{% if r.enpsScore is not undefined and r.enpsScore is not null %}{{ r.enpsScore }} ({{ r.enpsClassification }}){% else %}&mdash;{% endif %}</td>
            <td>{{ r.retentionIntent }}</td>
            <td>
                {% if r.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ r.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed survey responses found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
