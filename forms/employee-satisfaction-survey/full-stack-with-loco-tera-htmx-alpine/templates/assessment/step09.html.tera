<div class="card">
    <h2>Step 9: Recognition &amp; Engagement</h2>
    <p class="form-hint">How your contributions are recognised and how engaged you feel in your work.</p>

    {% set likert_items = [
        ["rc1", "I receive meaningful recognition when I do good work.",     recognition.rc1],
        ["rc2", "I feel motivated to go beyond what is strictly required.",  recognition.rc2],
        ["rc3", "My contributions are valued by my team and manager.",       recognition.rc3],
        ["rc4", "I find my day-to-day work engaging.",                       recognition.rc4]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="recognition_{{ fid }}">{{ label }}</label>
            <select id="recognition_{{ fid }}" name="recognition.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
