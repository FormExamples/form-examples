<div class="card">
    <h2>Step 6: Compensation &amp; Benefits</h2>
    <p class="form-hint">Whether your pay, benefits, and rewards feel fair for the work you do.</p>

    {% set likert_items = [
        ["cb1", "I am paid fairly for the work I do.",                          compensation.cb1],
        ["cb2", "My benefits package meets my needs.",                          compensation.cb2],
        ["cb3", "Pay decisions in this organisation are made fairly.",          compensation.cb3],
        ["cb4", "My total compensation is competitive with similar roles elsewhere.", compensation.cb4]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="compensation_{{ fid }}">{{ label }}</label>
            <select id="compensation_{{ fid }}" name="compensation.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
