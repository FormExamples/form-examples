<div class="card">
    <h2>Step 4: Management &amp; Leadership</h2>
    <p class="form-hint">Support, communication, and trust from your line manager and senior leadership.</p>

    {% set likert_items = [
        ["mg1", "My line manager treats me with respect.",                              management.mg1],
        ["mg2", "My line manager gives me clear direction and constructive feedback.",  management.mg2],
        ["mg3", "I trust the senior leadership of this organisation.",                   management.mg3],
        ["mg4", "Decisions made by leadership are communicated openly.",                management.mg4],
        ["mg5", "My line manager supports my wellbeing.",                                management.mg5]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="management_{{ fid }}">{{ label }}</label>
            <select id="management_{{ fid }}" name="management.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
