<div class="card">
    <h2>Step 5: Growth &amp; Development</h2>
    <p class="form-hint">Opportunities to learn, develop your skills, and advance your career.</p>

    {% set likert_items = [
        ["gr1", "I have meaningful opportunities to learn new skills here.",       growth.gr1],
        ["gr2", "I see a clear path for career progression.",                       growth.gr2],
        ["gr3", "My manager actively supports my professional development.",        growth.gr3],
        ["gr4", "Training and development resources are available when I need them.", growth.gr4]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="growth_{{ fid }}">{{ label }}</label>
            <select id="growth_{{ fid }}" name="growth.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
