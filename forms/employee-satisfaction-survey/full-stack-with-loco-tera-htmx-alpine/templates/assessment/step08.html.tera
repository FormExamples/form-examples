<div class="card">
    <h2>Step 8: Environment &amp; Resources</h2>
    <p class="form-hint">The physical or virtual workplace, tools, and resources you need to do your job well.</p>

    {% set likert_items = [
        ["en1", "I have the tools and equipment I need to do my job well.",       environment.en1],
        ["en2", "My work environment (on-site or remote) supports productive work.", environment.en2],
        ["en3", "I have access to the information and systems I need.",            environment.en3],
        ["en4", "Health and safety in my workplace are taken seriously.",          environment.en4]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="environment_{{ fid }}">{{ label }}</label>
            <select id="environment_{{ fid }}" name="environment.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
