<div class="card">
    <h2>Step 7: Culture &amp; Inclusion</h2>
    <p class="form-hint">Day-to-day culture, sense of belonging, and treatment of all colleagues.</p>

    {% set likert_items = [
        ["cu1", "I feel a sense of belonging at this organisation.",         culture.cu1],
        ["cu2", "People from all backgrounds are treated fairly here.",     culture.cu2],
        ["cu3", "I can be myself at work.",                                  culture.cu3],
        ["cu4", "My colleagues collaborate well together.",                  culture.cu4],
        ["cu5", "Inappropriate behaviour is addressed promptly when it occurs.", culture.cu5]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="culture_{{ fid }}">{{ label }}</label>
            <select id="culture_{{ fid }}" name="culture.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
