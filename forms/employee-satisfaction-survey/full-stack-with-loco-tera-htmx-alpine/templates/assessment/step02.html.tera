<div class="card">
    <h2>Step 2: Role &amp; Tenure</h2>
    <p class="form-hint">Role-level and location context plus two reflective items about how well the role fits.</p>

    <div class="form-group">
        <label for="role_tenure_role_level">Role level</label>
        <select id="role_tenure_role_level" name="role_tenure.role_level">
            <option value="" {% if role_tenure.roleLevel == "" %}selected{% endif %}>&mdash;</option>
            <option value="individual-contributor" {% if role_tenure.roleLevel == "individual-contributor" %}selected{% endif %}>Individual contributor</option>
            <option value="team-lead" {% if role_tenure.roleLevel == "team-lead" %}selected{% endif %}>Team lead</option>
            <option value="manager" {% if role_tenure.roleLevel == "manager" %}selected{% endif %}>Manager</option>
            <option value="senior-manager" {% if role_tenure.roleLevel == "senior-manager" %}selected{% endif %}>Senior manager</option>
            <option value="director-or-above" {% if role_tenure.roleLevel == "director-or-above" %}selected{% endif %}>Director or above</option>
        </select>
    </div>

    <div class="form-group">
        <label for="role_tenure_work_location">Work location</label>
        <select id="role_tenure_work_location" name="role_tenure.work_location">
            <option value="" {% if role_tenure.workLocation == "" %}selected{% endif %}>&mdash;</option>
            <option value="on-site" {% if role_tenure.workLocation == "on-site" %}selected{% endif %}>Mostly on-site</option>
            <option value="hybrid" {% if role_tenure.workLocation == "hybrid" %}selected{% endif %}>Hybrid</option>
            <option value="remote" {% if role_tenure.workLocation == "remote" %}selected{% endif %}>Mostly remote</option>
        </select>
    </div>

    {% set likert_items = [
        ["rt1", "My role description matches the work I actually do.", role_tenure.rt1],
        ["rt2", "My workload is appropriate for my role level.",        role_tenure.rt2]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="role_tenure_{{ fid }}">{{ label }}</label>
            <select id="role_tenure_{{ fid }}" name="role_tenure.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
