<div class="card">
    <h2>Step 3: Workload &amp; Work-Life Balance</h2>
    <p class="form-hint">How manageable your workload is and how well you can balance work with your personal life.</p>

    {% set likert_items = [
        ["wl1", "My workload is manageable.",                                            workload.wl1],
        ["wl2", "I am able to maintain a healthy balance between work and my personal life.", workload.wl2],
        ["wl3", "I rarely feel exhausted or burnt out at the end of the working week.",  workload.wl3],
        ["wl4", "I am able to take time off when I need it.",                            workload.wl4],
        ["wl5", "My working hours are reasonable for the role I do.",                    workload.wl5]
    ] %}
    {% for item in likert_items %}
        {% set fid = item[0] %}
        {% set label = item[1] %}
        {% set val = item[2] %}
        <div class="form-group">
            <label for="workload_{{ fid }}">{{ label }}</label>
            <select id="workload_{{ fid }}" name="workload.{{ fid }}">
                <option value="" {% if val is null or val == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if val == 1 %}selected{% endif %}>1 &mdash; Strongly disagree</option>
                <option value="2" {% if val == 2 %}selected{% endif %}>2 &mdash; Disagree</option>
                <option value="3" {% if val == 3 %}selected{% endif %}>3 &mdash; Neutral</option>
                <option value="4" {% if val == 4 %}selected{% endif %}>4 &mdash; Agree</option>
                <option value="5" {% if val == 5 %}selected{% endif %}>5 &mdash; Strongly agree</option>
            </select>
        </div>
    {% endfor %}
</div>
