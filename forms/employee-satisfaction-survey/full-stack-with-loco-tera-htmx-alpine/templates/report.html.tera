{% extends "base.html.tera" %}

{% block title %}Survey Report - {{ category_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Employee Satisfaction Survey &mdash; Response Report</h1>
    <div class="cat-badge cat-{{ category }}">{{ category_label }}</div>
    <div class="composite-label">
        Composite score:
        {% if composite_score is not undefined and composite_score is not null %}
            {{ composite_score }}/100
        {% else %}
            n/a
        {% endif %}
    </div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Response ID: {{ id }}<br>
        Generated: {{ timestamp }}<br>
        Items answered: {{ answered_count }} / {{ total_count }}
    </p>
</div>

<!-- Domain Scores -->
<div class="card">
    <h2>Per-Domain Scores</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Domain</th>
                <th>Answered</th>
                <th>Mean (1-5)</th>
                <th>Score (0-100)</th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            {% set entries = [
                ["Workload & Work-Life Balance", domain_scores.workload],
                ["Management & Leadership",      domain_scores.management],
                ["Growth & Development",         domain_scores.growth],
                ["Compensation & Benefits",      domain_scores.compensation],
                ["Culture & Inclusion",          domain_scores.culture],
                ["Environment & Resources",      domain_scores.environment],
                ["Recognition & Engagement",     domain_scores.recognition],
                ["Overall Experience",           domain_scores.overall]
            ] %}
            {% for entry in entries %}
                {% set label = entry[0] %}
                {% set ds = entry[1] %}
                <tr>
                    <td>{{ label }}</td>
                    <td>{{ ds.answeredCount }} / {{ ds.totalCount }}</td>
                    <td>{% if ds.mean is not undefined and ds.mean is not null %}{{ ds.mean }}{% else %}&mdash;{% endif %}</td>
                    <td>{% if ds.score is not undefined and ds.score is not null %}{{ ds.score }}{% else %}&mdash;{% endif %}</td>
                    <td><span class="cat-badge cat-{{ ds.category }}">{{ ds.category }}</span></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- eNPS -->
<div class="card">
    <h2>Employee Net Promoter Score (eNPS)</h2>
    {% if enps.score is not undefined and enps.score is not null %}
        <p><strong>Score:</strong> {{ enps.score }}/10 &mdash; <strong>{{ enps.classification }}</strong></p>
    {% else %}
        <p>eNPS recommend question not answered.</p>
    {% endif %}
</div>

<!-- Retention intent -->
<div class="card">
    <h2>Retention Intent</h2>
    <p><strong>{{ data.overall.retentionIntent }}</strong></p>
</div>

<!-- Flagged Issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Demographics summary -->
<div class="card">
    <h2>Demographic Context</h2>
    <div class="form-row">
        <div>
            <strong>Department:</strong> {{ data.demographics.department }}<br>
            <strong>Tenure band:</strong> {{ data.demographics.tenureBand }}<br>
            <strong>Hours band:</strong> {{ data.demographics.hoursBand }}
        </div>
        <div>
            <strong>Role level:</strong> {{ data.roleTenure.roleLevel }}<br>
            <strong>Work location:</strong> {{ data.roleTenure.workLocation }}
        </div>
    </div>
</div>

<!-- Answered Items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Answered Items ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Domain</th>
                <th>Statement</th>
                <th>Rating (1-5)</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.domain }}</td>
                <td>{{ rule.label }}</td>
                <td>{{ rule.rawValue }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Free text -->
{% if data.overall.suggestionsForImprovement %}
<div class="card">
    <h2>Suggestions for Improvement</h2>
    <p>{{ data.overall.suggestionsForImprovement }}</p>
</div>
{% endif %}

{% if data.overall.otherComments %}
<div class="card">
    <h2>Other Comments</h2>
    <p>{{ data.overall.otherComments }}</p>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Survey</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
