{% extends "base.html.tera" %}

{% block title %}OOCG Report — Outpatient Outcome Report{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>Outpatient Outcome Composite Grade (OOCG)</h1>
  <p style="color:#555;">Report generated: {{ timestamp }}</p>
  <p style="color:#555;">Assessment ID: {{ id }}</p>

  <div style="border:2px solid #0070f3;border-radius:8px;padding:1.5rem;margin:1.5rem 0;text-align:center;">
    <div style="font-size:0.9rem;text-transform:uppercase;letter-spacing:0.05em;color:#555;">Composite Grade</div>
    <div style="font-size:4rem;font-weight:bold;color:#0070f3;line-height:1.1;">{{ result.composite_grade }}</div>
    <div style="color:#333;margin-top:0.5rem;">{{ result.summary }}</div>
  </div>

  <h2>Domain Grades</h2>
  <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;">
    <thead>
      <tr style="background:#f4f4f4;">
        <th style="padding:0.6rem 1rem;text-align:left;">Domain</th>
        <th style="padding:0.6rem 1rem;text-align:center;">Grade</th>
      </tr>
    </thead>
    <tbody>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;">Clinical Outcome</td>
        <td style="padding:0.6rem 1rem;text-align:center;font-weight:bold;">{{ result.clinical_grade }}</td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;">PROM (EQ-5D-5L / GRC / PROMIS)</td>
        <td style="padding:0.6rem 1rem;text-align:center;font-weight:bold;">{{ result.prom_grade }}</td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;">PREM (Friends &amp; Family Test)</td>
        <td style="padding:0.6rem 1rem;text-align:center;font-weight:bold;">{{ result.prem_grade }}</td>
      </tr>
      <tr>
        <td style="padding:0.6rem 1rem;">Operational Efficiency</td>
        <td style="padding:0.6rem 1rem;text-align:center;font-weight:bold;">{{ result.operational_grade }}</td>
      </tr>
    </tbody>
  </table>

  <div style="display:flex;gap:1rem;">
    <a href="/assessments/{{ id }}" style="padding:0.5rem 1.2rem;border:1px solid #0070f3;color:#0070f3;border-radius:4px;text-decoration:none;">
      Edit Assessment
    </a>
    <a href="/assessments" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">
      All Reports
    </a>
    <a href="/" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">
      Home
    </a>
  </div>
</div>
{% endblock %}
