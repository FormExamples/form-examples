{% extends "base.html.tera" %}

{% block title %}Outpatient Outcome Report — Assessment{% endblock %}

{% block content %}
<div style="max-width:800px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>Outpatient Outcome Report</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit.</p>

  <!-- Progress indicator -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessments/{{ id }}/submit" hx-boost="false">

    <!-- Step 1: Patient Details -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Patient Details</h2>
      <div style="margin-bottom:1rem;">
        <label for="patient_name" style="display:block;margin-bottom:0.3rem;">Patient Name</label>
        <input type="text" id="patient_name" name="patient_name" value="{{ patient_name }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;">
        <div style="flex:1;">
          <label for="date_of_birth" style="display:block;margin-bottom:0.3rem;">Date of Birth</label>
          <input type="date" id="date_of_birth" name="date_of_birth" value="{{ date_of_birth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;">
          <label for="nhs_number" style="display:block;margin-bottom:0.3rem;">NHS Number</label>
          <input type="text" id="nhs_number" name="nhs_number" value="{{ nhs_number }}"
                 placeholder="e.g. 943 476 5919"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 2: Encounter Details -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Encounter Details</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label for="encounter_date" style="display:block;margin-bottom:0.3rem;">Encounter Date</label>
          <input type="date" id="encounter_date" name="encounter_date" value="{{ encounter_date }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label for="clinician_name" style="display:block;margin-bottom:0.3rem;">Clinician Name</label>
          <input type="text" id="clinician_name" name="clinician_name" value="{{ clinician_name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label for="specialty" style="display:block;margin-bottom:0.3rem;">Specialty</label>
          <input type="text" id="specialty" name="specialty" value="{{ specialty }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 3: Operational Efficiency -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: Operational Efficiency</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label for="consultation_modality" style="display:block;margin-bottom:0.3rem;">Consultation Modality</label>
          <select id="consultation_modality" name="consultation_modality"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="face-to-face" {% if consultation_modality == "face-to-face" %}selected{% endif %}>Face to face</option>
            <option value="telephone" {% if consultation_modality == "telephone" %}selected{% endif %}>Telephone</option>
            <option value="video" {% if consultation_modality == "video" %}selected{% endif %}>Video</option>
          </select>
        </div>
        <div style="flex:1;min-width:130px;">
          <label for="wait_time_days" style="display:block;margin-bottom:0.3rem;">Wait Time (days)</label>
          <input type="number" id="wait_time_days" name="wait_time_days" value="{{ wait_time_days }}" min="0"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:130px;">
          <label for="service_target_days" style="display:block;margin-bottom:0.3rem;">Service Target (days)</label>
          <input type="number" id="service_target_days" name="service_target_days" value="{{ service_target_days }}" min="0"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label for="attendance_outcome_code" style="display:block;margin-bottom:0.3rem;">NHS Attendance Outcome Code</label>
        <select id="attendance_outcome_code" name="attendance_outcome_code"
                style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="1" {% if attendance_outcome_code == "1" %}selected{% endif %}>1 — Discharged</option>
          <option value="2" {% if attendance_outcome_code == "2" %}selected{% endif %}>2 — Referred to another specialty</option>
          <option value="3" {% if attendance_outcome_code == "3" %}selected{% endif %}>3 — Follow-up appointment made</option>
          <option value="4" {% if attendance_outcome_code == "4" %}selected{% endif %}>4 — Patient self-discharge</option>
          <option value="5" {% if attendance_outcome_code == "5" %}selected{% endif %}>5 — Died</option>
        </select>
      </div>
    </div>

    <!-- Step 4: Clinical Outcome -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Clinical Outcome</h2>
      <div>
        <label for="clinical_outcome" style="display:block;margin-bottom:0.3rem;">Clinician-rated Outcome</label>
        <select id="clinical_outcome" name="clinical_outcome"
                style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="resolved" {% if clinical_outcome == "resolved" %}selected{% endif %}>Resolved</option>
          <option value="improved" {% if clinical_outcome == "improved" %}selected{% endif %}>Improved</option>
          <option value="unchanged" {% if clinical_outcome == "unchanged" %}selected{% endif %}>Unchanged</option>
          <option value="worsened" {% if clinical_outcome == "worsened" %}selected{% endif %}>Worsened</option>
          <option value="died" {% if clinical_outcome == "died" %}selected{% endif %}>Died</option>
        </select>
      </div>
    </div>

    <!-- Step 5: PROM — EQ-5D-5L -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: PROM — EQ-5D-5L</h2>
      <p style="color:#666;font-size:0.9rem;">Rate each dimension 1 (no problems) to 5 (extreme problems), before and after treatment.</p>
      {% set dimensions = ["mobility", "self_care", "usual_activities", "pain_discomfort", "anxiety_depression"] %}
      {% set dim_labels = ["Mobility", "Self-care", "Usual activities", "Pain / discomfort", "Anxiety / depression"] %}
      <table style="width:100%;border-collapse:collapse;margin-bottom:1rem;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:0.4rem 0.8rem;text-align:left;">Dimension</th>
            <th style="padding:0.4rem 0.8rem;">Before</th>
            <th style="padding:0.4rem 0.8rem;">After</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="padding:0.4rem 0.8rem;">Mobility</td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_mobility_before" value="{{ eq5d_mobility_before }}" min="1" max="5" style="width:60px;text-align:center;"></td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_mobility_after" value="{{ eq5d_mobility_after }}" min="1" max="5" style="width:60px;text-align:center;"></td></tr>
          <tr><td style="padding:0.4rem 0.8rem;">Self-care</td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_self_care_before" value="{{ eq5d_self_care_before }}" min="1" max="5" style="width:60px;text-align:center;"></td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_self_care_after" value="{{ eq5d_self_care_after }}" min="1" max="5" style="width:60px;text-align:center;"></td></tr>
          <tr><td style="padding:0.4rem 0.8rem;">Usual activities</td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_usual_activities_before" value="{{ eq5d_usual_activities_before }}" min="1" max="5" style="width:60px;text-align:center;"></td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_usual_activities_after" value="{{ eq5d_usual_activities_after }}" min="1" max="5" style="width:60px;text-align:center;"></td></tr>
          <tr><td style="padding:0.4rem 0.8rem;">Pain / discomfort</td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_pain_discomfort_before" value="{{ eq5d_pain_discomfort_before }}" min="1" max="5" style="width:60px;text-align:center;"></td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_pain_discomfort_after" value="{{ eq5d_pain_discomfort_after }}" min="1" max="5" style="width:60px;text-align:center;"></td></tr>
          <tr><td style="padding:0.4rem 0.8rem;">Anxiety / depression</td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_anxiety_depression_before" value="{{ eq5d_anxiety_depression_before }}" min="1" max="5" style="width:60px;text-align:center;"></td>
              <td style="padding:0.4rem 0.8rem;text-align:center;"><input type="number" name="eq5d_anxiety_depression_after" value="{{ eq5d_anxiety_depression_after }}" min="1" max="5" style="width:60px;text-align:center;"></td></tr>
        </tbody>
      </table>
      <div style="display:flex;gap:1rem;">
        <div style="flex:1;">
          <label for="eq5d_vas_before" style="display:block;margin-bottom:0.3rem;">VAS Score Before (0–100)</label>
          <input type="number" id="eq5d_vas_before" name="eq5d_vas_before" value="{{ eq5d_vas_before }}" min="0" max="100"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;">
          <label for="eq5d_vas_after" style="display:block;margin-bottom:0.3rem;">VAS Score After (0–100)</label>
          <input type="number" id="eq5d_vas_after" name="eq5d_vas_after" value="{{ eq5d_vas_after }}" min="0" max="100"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 6: PROM — Global Rating of Change -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: PROM — Global Rating of Change</h2>
      <div>
        <label for="grc_score" style="display:block;margin-bottom:0.3rem;">
          Global Rating of Change (–3 = much worse, 0 = unchanged, +3 = much better)
        </label>
        <select id="grc_score" name="grc_score"
                style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="-3" {% if grc_score == "-3" %}selected{% endif %}>–3 Much worse</option>
          <option value="-2" {% if grc_score == "-2" %}selected{% endif %}>–2 Moderately worse</option>
          <option value="-1" {% if grc_score == "-1" %}selected{% endif %}>–1 A little worse</option>
          <option value="0" {% if grc_score == "0" %}selected{% endif %}>0 About the same</option>
          <option value="1" {% if grc_score == "1" %}selected{% endif %}>+1 A little better</option>
          <option value="2" {% if grc_score == "2" %}selected{% endif %}>+2 Moderately better</option>
          <option value="3" {% if grc_score == "3" %}selected{% endif %}>+3 Much better</option>
        </select>
      </div>
    </div>

    <!-- Step 7: PROM — PROMIS Global Health v1.2 -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: PROM — PROMIS Global Health v1.2</h2>
      <div style="display:flex;gap:1rem;">
        <div style="flex:1;">
          <label for="promis_gph" style="display:block;margin-bottom:0.3rem;">Global Physical Health T-score</label>
          <input type="number" id="promis_gph" name="promis_gph" value="{{ promis_gph }}" min="0" max="100" step="0.1"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;">
          <label for="promis_gmh" style="display:block;margin-bottom:0.3rem;">Global Mental Health T-score</label>
          <input type="number" id="promis_gmh" name="promis_gmh" value="{{ promis_gmh }}" min="0" max="100" step="0.1"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 8: PREM — Friends and Family Test -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: PREM — Friends and Family Test</h2>
      <div style="margin-bottom:1rem;">
        <label for="fft_response" style="display:block;margin-bottom:0.3rem;">
          How likely are you to recommend our service to friends and family if they needed similar care?
        </label>
        <select id="fft_response" name="fft_response"
                style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="very_good" {% if fft_response == "very_good" %}selected{% endif %}>Very good</option>
          <option value="good" {% if fft_response == "good" %}selected{% endif %}>Good</option>
          <option value="neither" {% if fft_response == "neither" %}selected{% endif %}>Neither good nor poor</option>
          <option value="poor" {% if fft_response == "poor" %}selected{% endif %}>Poor</option>
          <option value="very_poor" {% if fft_response == "very_poor" %}selected{% endif %}>Very poor</option>
          <option value="dont_know" {% if fft_response == "dont_know" %}selected{% endif %}>Don't know</option>
        </select>
      </div>
      <div>
        <label for="fft_comments" style="display:block;margin-bottom:0.3rem;">Comments (optional)</label>
        <textarea id="fft_comments" name="fft_comments" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ fft_comments }}</textarea>
      </div>
    </div>

    <!-- Step 9: Follow-up Plan -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Follow-up Plan</h2>
      <div style="margin-bottom:1rem;">
        <label for="followup_plan" style="display:block;margin-bottom:0.3rem;">Follow-up Plan</label>
        <textarea id="followup_plan" name="followup_plan" rows="4"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ followup_plan }}</textarea>
      </div>
      <div>
        <label for="followup_date" style="display:block;margin-bottom:0.3rem;">Follow-up Date</label>
        <input type="date" id="followup_date" name="followup_date" value="{{ followup_date }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 10: Sign-off -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: Sign-off</h2>
      <div style="display:flex;gap:1rem;">
        <div style="flex:1;">
          <label for="signoff_clinician" style="display:block;margin-bottom:0.3rem;">Clinician Signature</label>
          <input type="text" id="signoff_clinician" name="signoff_clinician" value="{{ signoff_clinician }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;">
          <label for="signoff_date" style="display:block;margin-bottom:0.3rem;">Date</label>
          <input type="date" id="signoff_date" name="signoff_date" value="{{ signoff_date }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 11: Review & Submit -->
    <div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 11: Review &amp; Submit</h2>
      <p>Please review your entries. When ready, press <strong>Submit</strong> to generate the Outpatient Outcome Composite Grade report.</p>
      <p style="color:#666;font-size:0.9rem;">Assessment ID: {{ id }}</p>
    </div>

    <!-- Navigation buttons -->
    <div style="display:flex;justify-content:space-between;margin-top:1.5rem;">
      <button type="button" @click="if(step > 1) step--"
              :disabled="step === 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        &laquo; Previous
      </button>
      <button type="button" @click="if(step < totalSteps) step++"
              x-show="step < totalSteps"
              style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Next &raquo;
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.4rem;background:#28a745;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">
        Submit Report
      </button>
    </div>

  </form>
</div>
{% endblock %}
