{% extends "base.html.tera" %}

{% block title %}Endocrinology Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Endocrinology Assessment</h1>
        <p class="landing-description">
            General endocrinology consultation assessment covering the thyroid, adrenal, glucose,
            reproductive, pituitary, and bone/calcium axes. Integrates symptom review, clinical
            examination, and laboratory findings to characterise endocrine disturbance and guide
            management. The output is a per-axis grade (Normal / Subclinical / Mild / Moderate /
            Severe) and an overall clinical impression.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Six Endocrine Axes</h3>
                <p>Thyroid, Adrenal, Glucose, Reproductive, Pituitary, and Bone &amp; Calcium &mdash;
                each graded against NICE-aligned reference ranges</p>
            </div>
            <div class="feature">
                <h3>Symptom-Driven Promotion</h3>
                <p>Subclinical biochemistry is promoted to mild when symptomatic features coexist</p>
            </div>
            <div class="feature">
                <h3>Urgent Alerts</h3>
                <p>Real-time flags for thyrotoxicosis, adrenal insufficiency, severe hypercalcaemia,
                visual disturbance, and macroprolactinaemia</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
