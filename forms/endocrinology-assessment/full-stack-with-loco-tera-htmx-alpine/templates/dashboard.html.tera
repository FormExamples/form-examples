{% extends "base.html.tera" %}

{% block title %}Endocrinology Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Endocrinology Clinic Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name...">
    </div>
    <div class="form-group">
        <label for="overall_status">Overall Status</label>
        <select id="overall_status" name="overall_status">
            <option value="">All</option>
            <option value="normal" {% if overall_status == "normal" %}selected{% endif %}>Normal</option>
            <option value="subclinical" {% if overall_status == "subclinical" %}selected{% endif %}>Subclinical</option>
            <option value="mild" {% if overall_status == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if overall_status == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if overall_status == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent">Urgent Flags</label>
        <select id="has_urgent" name="has_urgent">
            <option value="">All</option>
            <option value="yes" {% if has_urgent == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Date of Birth</th>
            <th>Sex</th>
            <th>Overall</th>
            <th>Axes Assessed</th>
            <th>Urgent</th>
            <th>High</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.patientName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.sex }}</td>
            <td><span class="status-badge status-{{ c.overallStatus }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.overallStatus }}</span></td>
            <td>{{ c.answeredCount }} / 6</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>
                {% if c.highFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
