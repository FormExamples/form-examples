<div class="card">
    <h2>Step 3: Thyroid Axis Review</h2>
    <p class="form-hint">Reference ranges: TSH 0.4&ndash;4.0 mIU/L; FT4 9&ndash;25 pmol/L; FT3 3.5&ndash;6.5 pmol/L.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="tsh">TSH (mIU/L)</label>
            <input type="number" step="0.01" id="tsh" name="thyroid_axis.tsh" value="{{ thyroid_axis.tsh }}">
        </div>
        <div class="form-group">
            <label for="ft4">FT4 (pmol/L)</label>
            <input type="number" step="0.01" id="ft4" name="thyroid_axis.ft4" value="{{ thyroid_axis.ft4 }}">
        </div>
        <div class="form-group">
            <label for="ft3">FT3 (pmol/L)</label>
            <input type="number" step="0.01" id="ft3" name="thyroid_axis.ft3" value="{{ thyroid_axis.ft3 }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="antibodies_positive">Thyroid autoantibodies positive?</label>
            <select id="antibodies_positive" name="thyroid_axis.antibodies_positive">
                <option value="" {% if thyroid_axis.antibodiesPositive == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thyroid_axis.antibodiesPositive == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thyroid_axis.antibodiesPositive == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="goitre">Goitre on examination?</label>
            <select id="goitre" name="thyroid_axis.goitre">
                <option value="" {% if thyroid_axis.goitre == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thyroid_axis.goitre == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thyroid_axis.goitre == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="family_history_thyroid">Family history of thyroid disease?</label>
            <select id="family_history_thyroid" name="thyroid_axis.family_history_thyroid">
                <option value="" {% if thyroid_axis.familyHistoryThyroid == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thyroid_axis.familyHistoryThyroid == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thyroid_axis.familyHistoryThyroid == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="thyroid_notes">Notes</label>
        <textarea id="thyroid_notes" name="thyroid_axis.thyroid_notes">{{ thyroid_axis.thyroidNotes }}</textarea>
    </div>
</div>
