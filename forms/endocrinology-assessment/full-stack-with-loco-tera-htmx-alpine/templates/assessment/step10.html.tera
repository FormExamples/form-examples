<div class="card">
    <h2>Step 10: Clinical Impression &amp; Management Plan</h2>
    <p class="form-hint">Final synthesis: working diagnosis, differentials, investigations, plan, and follow-up.</p>

    <div class="form-group">
        <label for="working_diagnosis">Working diagnosis</label>
        <textarea id="working_diagnosis" name="clinical_impression.working_diagnosis">{{ clinical_impression.workingDiagnosis }}</textarea>
    </div>
    <div class="form-group">
        <label for="differential_diagnoses">Differential diagnoses</label>
        <textarea id="differential_diagnoses" name="clinical_impression.differential_diagnoses">{{ clinical_impression.differentialDiagnoses }}</textarea>
    </div>
    <div class="form-group">
        <label for="investigations_requested">Investigations requested</label>
        <textarea id="investigations_requested" name="clinical_impression.investigations_requested">{{ clinical_impression.investigationsRequested }}</textarea>
    </div>
    <div class="form-group">
        <label for="management_plan">Management plan</label>
        <textarea id="management_plan" name="clinical_impression.management_plan">{{ clinical_impression.managementPlan }}</textarea>
    </div>
    <div class="form-group">
        <label for="follow_up_plan">Follow-up plan</label>
        <textarea id="follow_up_plan" name="clinical_impression.follow_up_plan">{{ clinical_impression.followUpPlan }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="referral_required">Referral required?</label>
            <select id="referral_required" name="clinical_impression.referral_required">
                <option value="" {% if clinical_impression.referralRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if clinical_impression.referralRequired == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if clinical_impression.referralRequired == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="referral_specialty">Referral specialty</label>
            <input type="text" id="referral_specialty" name="clinical_impression.referral_specialty" value="{{ clinical_impression.referralSpecialty }}">
        </div>
    </div>

    <div class="form-group">
        <label for="clinician_notes">Clinician notes</label>
        <textarea id="clinician_notes" name="clinical_impression.clinician_notes">{{ clinical_impression.clinicianNotes }}</textarea>
    </div>
</div>
