<div class="card">
    <h2>Step 4: Adrenal Axis Review</h2>
    <p class="form-hint">Reference ranges: morning cortisol 140&ndash;700 nmol/L; ACTH 2&ndash;11 pmol/L.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="morning_cortisol">Morning cortisol (nmol/L)</label>
            <input type="number" step="0.1" id="morning_cortisol" name="adrenal_axis.morning_cortisol" value="{{ adrenal_axis.morningCortisol }}">
        </div>
        <div class="form-group">
            <label for="acth">ACTH (pmol/L)</label>
            <input type="number" step="0.1" id="acth" name="adrenal_axis.acth" value="{{ adrenal_axis.acth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="aldosterone">Aldosterone (pmol/L)</label>
            <input type="number" step="0.1" id="aldosterone" name="adrenal_axis.aldosterone" value="{{ adrenal_axis.aldosterone }}">
        </div>
        <div class="form-group">
            <label for="renin">Renin (mU/L)</label>
            <input type="number" step="0.1" id="renin" name="adrenal_axis.renin" value="{{ adrenal_axis.renin }}">
        </div>
    </div>

    {% set adrfields = [
        ["hyperpigmentation", "Hyperpigmentation", adrenal_axis.hyperpigmentation],
        ["cushingoid_features", "Cushingoid features", adrenal_axis.cushingoidFeatures],
        ["postural_hypotension", "Postural hypotension", adrenal_axis.posturalHypotension]
    ] %}
    {% for f in adrfields %}
    <div class="form-group">
        <label for="adr_{{ f[0] }}">{{ f[1] }}?</label>
        <select id="adr_{{ f[0] }}" name="adrenal_axis.{{ f[0] }}">
            <option value="" {% if f[2] == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if f[2] == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if f[2] == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="adrenal_notes">Notes</label>
        <textarea id="adrenal_notes" name="adrenal_axis.adrenal_notes">{{ adrenal_axis.adrenalNotes }}</textarea>
    </div>
</div>
