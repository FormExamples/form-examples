<div class="card">
    <h2>Step 5: Glucose Metabolism</h2>
    <p class="form-hint">HbA1c &lt;42 normal, 42&ndash;47 pre-diabetes, &ge;48 diabetes (mmol/mol). Fasting glucose &lt;5.6 normal, 5.6&ndash;6.9 IFG, &ge;7.0 diabetes (mmol/L).</p>

    <div class="form-row">
        <div class="form-group">
            <label for="hba1c">HbA1c (mmol/mol)</label>
            <input type="number" step="0.1" id="hba1c" name="glucose_metabolism.hba1c" value="{{ glucose_metabolism.hba1c }}">
        </div>
        <div class="form-group">
            <label for="fasting_glucose">Fasting glucose (mmol/L)</label>
            <input type="number" step="0.1" id="fasting_glucose" name="glucose_metabolism.fasting_glucose" value="{{ glucose_metabolism.fastingGlucose }}">
        </div>
        <div class="form-group">
            <label for="random_glucose">Random glucose (mmol/L)</label>
            <input type="number" step="0.1" id="random_glucose" name="glucose_metabolism.random_glucose" value="{{ glucose_metabolism.randomGlucose }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="known_diabetes">Known diabetes?</label>
            <select id="known_diabetes" name="glucose_metabolism.known_diabetes">
                <option value="" {% if glucose_metabolism.knownDiabetes == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if glucose_metabolism.knownDiabetes == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if glucose_metabolism.knownDiabetes == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="diabetes_type">Diabetes type</label>
            <input type="text" id="diabetes_type" name="glucose_metabolism.diabetes_type" value="{{ glucose_metabolism.diabetesType }}">
        </div>
        <div class="form-group">
            <label for="hypoglycaemia_episodes">Hypoglycaemic episodes?</label>
            <select id="hypoglycaemia_episodes" name="glucose_metabolism.hypoglycaemia_episodes">
                <option value="" {% if glucose_metabolism.hypoglycaemiaEpisodes == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if glucose_metabolism.hypoglycaemiaEpisodes == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if glucose_metabolism.hypoglycaemiaEpisodes == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="glucose_notes">Notes</label>
        <textarea id="glucose_notes" name="glucose_metabolism.glucose_notes">{{ glucose_metabolism.glucoseNotes }}</textarea>
    </div>
</div>
