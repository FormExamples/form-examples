<div class="card">
    <h2>Step 2: Presenting Symptoms</h2>
    <p class="form-hint">Symptom review across the endocrine axes.</p>

    {% set symptoms = [
        ["fatigue", "Fatigue", presenting_symptoms.fatigue],
        ["weight_change", "Weight change", presenting_symptoms.weightChange],
        ["heat_intolerance", "Heat intolerance", presenting_symptoms.heatIntolerance],
        ["cold_intolerance", "Cold intolerance", presenting_symptoms.coldIntolerance],
        ["palpitations", "Palpitations", presenting_symptoms.palpitations],
        ["tremor", "Tremor", presenting_symptoms.tremor],
        ["sweating", "Excess sweating", presenting_symptoms.sweating],
        ["polyuria", "Polyuria", presenting_symptoms.polyuria],
        ["polydipsia", "Polydipsia", presenting_symptoms.polydipsia],
        ["mood", "Mood change", presenting_symptoms.mood],
        ["skin_changes", "Skin changes", presenting_symptoms.skinChanges],
        ["hair_changes", "Hair changes", presenting_symptoms.hairChanges]
    ] %}

    {% for s in symptoms %}
    <div class="form-group">
        <label for="ps_{{ s[0] }}">{{ s[1] }}</label>
        <select id="ps_{{ s[0] }}" name="presenting_symptoms.{{ s[0] }}">
            <option value="" {% if s[2] == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if s[2] == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if s[2] == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="weight_change_direction">Weight change direction</label>
        <input type="text" id="weight_change_direction" name="presenting_symptoms.weight_change_direction"
               value="{{ presenting_symptoms.weightChangeDirection }}" placeholder="gain / loss / stable">
    </div>
    <div class="form-group">
        <label for="symptom_duration">Symptom duration</label>
        <input type="text" id="symptom_duration" name="presenting_symptoms.symptom_duration"
               value="{{ presenting_symptoms.symptomDuration }}">
    </div>
    <div class="form-group">
        <label for="other_symptoms">Other symptoms</label>
        <textarea id="other_symptoms" name="presenting_symptoms.other_symptoms">{{ presenting_symptoms.otherSymptoms }}</textarea>
    </div>
</div>
