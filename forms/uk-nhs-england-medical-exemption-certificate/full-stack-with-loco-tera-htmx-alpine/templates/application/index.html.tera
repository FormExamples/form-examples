{% extends "base.html.tera" %}

{% block title %}FP92A — Wizard{% endblock %}

{% block content %}
<div style="max-width:920px;margin:2rem auto;padding:1rem;"
     x-data='{
       step: 1,
       totalSteps: {{ total_steps }},
       conditions: {
         {% for c in conditions_catalogue %}
           "{{ c.code }}": { selected: "{{ condition_map[c.code].selected | default(value="") }}" }{% if not loop.last %},{% endif %}
         {% endfor %}
       }
     }'>
  <h1>FP92A — Medical Exemption Certificate</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps. The form must be printed, signed in ink by the practitioner, and posted to NHSBSA Bridge House — NHSBSA does not accept scans, photocopies, or emailed copies.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/application/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Practitioner identification -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Practitioner Identification</h2>
      <p style="color:#555;">Only a registered medical practitioner (or a health professional with access to the patient's medical records) may complete the FP92A.</p>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:2;min-width:240px;">
          <label>Practitioner name</label>
          <input type="text" name="practitionerName" value="{{ data.practitioner.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Role</label>
          <select name="practitionerRole"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            {% set roles = ["", "gp", "hospital-doctor", "nurse-practitioner", "pharmacist-prescriber", "other"] %}
            {% for r in roles %}
              <option value="{{ r }}" {% if data.practitioner.role == r %}selected{% endif %}>{{ r | default(value="—") }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Registration body</label>
          <select name="practitionerRegistrationBody"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            {% set bodies = ["", "GMC", "NMC", "HCPC", "GPhC", "other"] %}
            {% for b in bodies %}
              <option value="{{ b }}" {% if data.practitioner.registrationBody == b %}selected{% endif %}>{{ b | default(value="—") }}</option>
            {% endfor %}
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Registration number</label>
          <input type="text" name="practitionerRegistrationNumber" value="{{ data.practitioner.registrationNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Practice code (optional)</label>
          <input type="text" name="practitionerPracticeCode" value="{{ data.practitioner.practiceCode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:2;min-width:240px;">
          <label>Practice / surgery name</label>
          <input type="text" name="practitionerPracticeName" value="{{ data.practitioner.practiceName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Practice telephone</label>
          <input type="text" name="practitionerPhone" value="{{ data.practitioner.phone }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <div style="margin-top:0.6rem;">
        <label>Practice address</label>
        <textarea name="practitionerAddress" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.practitioner.postalAddressAsFullText }}</textarea>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Postcode</label>
          <input type="text" name="practitionerPostcode" value="{{ data.practitioner.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Email (optional)</label>
          <input type="email" name="practitionerEmail" value="{{ data.practitioner.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date of completion</label>
          <input type="date" name="practitionerCompletedDate" value="{{ data.practitioner.completedDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 2 — Patient identification -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Patient Identification</h2>
      <p style="color:#555;">Patient demographics as printed on the FP92A. The NHS number is required for NHSBSA to match the application to the patient record.</p>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:120px;">
          <label>Title</label>
          <select name="patientTitle"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            {% set titles = ["", "Mr", "Mrs", "Miss", "Ms", "Mx", "Dr", "Prof", "Rev", "Other"] %}
            {% for t in titles %}
              <option value="{{ t }}" {% if data.patient.title == t %}selected{% endif %}>{{ t | default(value="—") }}</option>
            {% endfor %}
          </select>
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Surname</label>
          <input type="text" name="patientSurname" value="{{ data.patient.surname }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Forenames</label>
          <input type="text" name="patientForenames" value="{{ data.patient.forenames }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Date of birth</label>
          <input type="date" name="patientBirthDate" value="{{ data.patient.birthDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Sex</label>
          <select name="patientSex"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            {% set sexes = ["", "female", "male", "intersex", "unknown"] %}
            {% for x in sexes %}
              <option value="{{ x }}" {% if data.patient.sex == x %}selected{% endif %}>{{ x | default(value="—") }}</option>
            {% endfor %}
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>NHS number</label>
          <input type="text" name="patientNhsNumber" value="{{ data.patient.unitedKingdomNhsNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <div style="margin-top:0.6rem;">
        <label>Patient postal address</label>
        <textarea name="patientAddress" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.patient.postalAddressAsFullText }}</textarea>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Postcode</label>
          <input type="text" name="patientPostcode" value="{{ data.patient.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Phone (optional)</label>
          <input type="text" name="patientPhone" value="{{ data.patient.phone }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Email (optional)</label>
          <input type="email" name="patientEmail" value="{{ data.patient.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 3 — Existing exemption check -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: Existing Exemption Check</h2>
      <p style="color:#555;">Renewals are made on a fresh FP92A. If an active certificate already exists, the renewal should fall within the renewal window.</p>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Application kind</label>
          <select name="applicationKind"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            {% set kinds = ["", "new", "renewal", "replacement"] %}
            {% for k in kinds %}
              <option value="{{ k }}" {% if data.existingExemption.applicationKind == k %}selected{% endif %}>{{ k | default(value="—") }}</option>
            {% endfor %}
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Existing valid certificate?</label>
          <select name="hasExistingCertificate"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="" {% if data.existingExemption.hasExistingCertificate == "" %}selected{% endif %}>Choose…</option>
            <option value="yes" {% if data.existingExemption.hasExistingCertificate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if data.existingExemption.hasExistingCertificate == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>Previous certificate number</label>
          <input type="text" name="previousCertificateNumber" value="{{ data.existingExemption.previousCertificateNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Previous certificate expiry date</label>
          <input type="date" name="previousCertificateExpiryDate" value="{{ data.existingExemption.previousCertificateExpiryDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 4 — Age-based exclusion check -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Age-based Exclusion Check</h2>
      <p style="color:#555;">Patients under 16, in full-time education aged 16-18, or aged 60 and over already qualify for free prescriptions on age grounds and do not need an FP92A.</p>

      <div style="background:#fffbe6;border:1px solid #f1d76b;padding:0.6rem;border-radius:4px;color:#8a6d00;">
        Age is derived from the date of birth captured in Step 2. The eligibility engine will flag age-based exemptions automatically.
      </div>

      <div style="margin-top:0.6rem;">
        <label>Full-time education (only relevant for 16-18 year-olds)</label>
        <select name="patientFullTimeEducation"
                style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="" {% if data.patient.fullTimeEducation == "" %}selected{% endif %}>Choose…</option>
          <option value="yes" {% if data.patient.fullTimeEducation == "yes" %}selected{% endif %}>Yes — in full-time education</option>
          <option value="no" {% if data.patient.fullTimeEducation == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
    </div>

    <!-- Step 5 — Pregnancy / maternity check -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Pregnancy / Maternity Check</h2>
      <p style="color:#555;">Pregnant patients (and those within 12 months post-partum) should be directed to the <strong>FW8</strong> maternity exemption rather than the FP92A.</p>

      <div style="margin-top:0.6rem;">
        <label>Pregnancy status</label>
        <select name="patientPregnancyStatus"
                style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="" {% if data.patient.pregnancyStatus == "" %}selected{% endif %}>Choose…</option>
          <option value="not-pregnant" {% if data.patient.pregnancyStatus == "not-pregnant" %}selected{% endif %}>Not pregnant</option>
          <option value="pregnant" {% if data.patient.pregnancyStatus == "pregnant" %}selected{% endif %}>Pregnant</option>
          <option value="post-partum-within-12-months" {% if data.patient.pregnancyStatus == "post-partum-within-12-months" %}selected{% endif %}>Within 12 months post-partum</option>
        </select>
      </div>
    </div>

    <!-- Step 6 — Qualifying condition selection -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Qualifying Condition Selection</h2>
      <p style="color:#555;">Select one or more conditions from the closed NHSBSA list. Diet-only diabetes and temporary disability are explicitly excluded.</p>

      {% for c in conditions_catalogue %}
        <div style="border:1px solid #eee;border-radius:4px;padding:0.6rem;margin-top:0.5rem;">
          <label>
            <input type="checkbox"
                   name="condition_{% if c.code == 'permanent-fistula' %}permanent_fistula{% elif c.code == 'diabetes-insipidus-or-hypopituitarism' %}diabetes_insipidus{% elif c.code == 'diabetes-mellitus-not-diet-only' %}diabetes_mellitus{% elif c.code == 'myasthenia-gravis' %}myasthenia_gravis{% elif c.code == 'epilepsy-on-anticonvulsant' %}epilepsy{% elif c.code == 'continuing-physical-disability' %}disability{% elif c.code == 'cancer-or-effects' %}cancer{% else %}{{ c.code }}{% endif %}_selected"
                   value="yes"
                   @change="conditions['{{ c.code }}'].selected = $event.target.checked ? 'yes' : ''"
                   {% if condition_map[c.code] and condition_map[c.code].selected == "yes" %}checked{% endif %}>
            <strong>{{ c.label }}</strong>
            <span style="color:#888;font-size:0.85rem;">({{ c.code }})</span>
          </label>
        </div>
      {% endfor %}
    </div>

    <!-- Step 7 — Qualifying condition detail -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Qualifying Condition Detail</h2>
      <p style="color:#555;">Capture diagnosis date and treatment details for each selected condition. Practitioner attestation is required.</p>

      {# ── Permanent fistula ───────────────────────────── #}
      <div x-show="conditions['permanent-fistula'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Permanent fistula</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_permanent_fistula_diagnosisDate"
                   value="{{ cond_permanent_fistula.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:160px;">
            <label>SNOMED CT code</label>
            <input type="text" name="condition_permanent_fistula_snomedCtCode"
                   value="{{ cond_permanent_fistula.snomedCtCode | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
        <div style="margin-top:0.4rem;">
          <label>Treatment detail</label>
          <textarea name="condition_permanent_fistula_treatmentDetail" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ cond_permanent_fistula.treatmentDetail | default(value='') }}</textarea>
        </div>
      </div>

      {# ── Hypoadrenalism ──────────────────────────────── #}
      <div x-show="conditions['hypoadrenalism'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Hypoadrenalism</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_hypoadrenalism_diagnosisDate"
                   value="{{ cond_hypoadrenalism.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Substitution therapy (drug + dose)</label>
            <input type="text" name="condition_hypoadrenalism_substitutionTherapy"
                   value="{{ cond_hypoadrenalism.substitutionTherapy | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
      </div>

      {# ── Diabetes insipidus / hypopituitarism ────────── #}
      <div x-show="conditions['diabetes-insipidus-or-hypopituitarism'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Diabetes insipidus / hypopituitarism</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_diabetes_insipidus_diagnosisDate"
                   value="{{ cond_diabetes_insipidus.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Substitution therapy</label>
            <input type="text" name="condition_diabetes_insipidus_substitutionTherapy"
                   value="{{ cond_diabetes_insipidus.substitutionTherapy | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
      </div>

      {# ── Diabetes mellitus ───────────────────────────── #}
      <div x-show="conditions['diabetes-mellitus-not-diet-only'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Diabetes mellitus</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_diabetes_mellitus_diagnosisDate"
                   value="{{ cond_diabetes_mellitus.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Treatment mode (<em>diet-only is excluded</em>)</label>
            <select name="condition_diabetes_mellitus_treatmentMode"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set tm = cond_diabetes_mellitus.diabetesTreatmentMode | default(value='') %}
              {% set modes = ["", "insulin", "oral-hypoglycaemic", "insulin-and-oral", "glp1-agonist", "diet-only"] %}
              {% for m in modes %}
                <option value="{{ m }}" {% if tm == m %}selected{% endif %}>{{ m | default(value="—") }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>

      {# ── Hypoparathyroidism ──────────────────────────── #}
      <div x-show="conditions['hypoparathyroidism'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Hypoparathyroidism</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_hypoparathyroidism_diagnosisDate"
                   value="{{ cond_hypoparathyroidism.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Substitution therapy</label>
            <input type="text" name="condition_hypoparathyroidism_substitutionTherapy"
                   value="{{ cond_hypoparathyroidism.substitutionTherapy | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
      </div>

      {# ── Myasthenia gravis ───────────────────────────── #}
      <div x-show="conditions['myasthenia-gravis'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Myasthenia gravis</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_myasthenia_gravis_diagnosisDate"
                   value="{{ cond_myasthenia_gravis.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Treatment detail</label>
            <input type="text" name="condition_myasthenia_gravis_treatmentDetail"
                   value="{{ cond_myasthenia_gravis.treatmentDetail | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
      </div>

      {# ── Myxoedema ───────────────────────────────────── #}
      <div x-show="conditions['myxoedema'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Myxoedema</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_myxoedema_diagnosisDate"
                   value="{{ cond_myxoedema.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Thyroid replacement (drug + dose)</label>
            <input type="text" name="condition_myxoedema_substitutionTherapy"
                   value="{{ cond_myxoedema.substitutionTherapy | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
      </div>

      {# ── Epilepsy ────────────────────────────────────── #}
      <div x-show="conditions['epilepsy-on-anticonvulsant'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Epilepsy</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_epilepsy_diagnosisDate"
                   value="{{ cond_epilepsy.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:2;min-width:200px;">
            <label>Anticonvulsant (drug + dose)</label>
            <input type="text" name="condition_epilepsy_anticonvulsant"
                   value="{{ cond_epilepsy.anticonvulsant | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:200px;">
            <label>Continuous therapy?</label>
            <select name="condition_epilepsy_continuousAnticonvulsantTherapy"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set cct = cond_epilepsy.continuousAnticonvulsantTherapy | default(value='') %}
              <option value="" {% if cct == "" %}selected{% endif %}>Choose…</option>
              <option value="yes" {% if cct == "yes" %}selected{% endif %}>Yes</option>
              <option value="no" {% if cct == "no" %}selected{% endif %}>No</option>
            </select>
          </div>
        </div>
      </div>

      {# ── Cancer ──────────────────────────────────────── #}
      <div x-show="conditions['cancer-or-effects'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Cancer or effects of cancer / treatment</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Diagnosis date</label>
            <input type="date" name="condition_cancer_diagnosisDate"
                   value="{{ cond_cancer.diagnosisDate | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
          <div style="flex:1;min-width:200px;">
            <label>Cancer site</label>
            <input type="text" name="condition_cancer_site"
                   value="{{ cond_cancer.cancerSite | default(value='') }}"
                   style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          </div>
        </div>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.4rem;">
          <div style="flex:2;min-width:200px;">
            <label>Treatment phase</label>
            <select name="condition_cancer_treatmentPhase"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set ph = cond_cancer.cancerTreatmentPhase | default(value='') %}
              {% set phases = ["", "active-treatment", "effects-of-cancer", "effects-of-treatment", "remission-with-ongoing-treatment", "palliative"] %}
              {% for p in phases %}
                <option value="{{ p }}" {% if ph == p %}selected{% endif %}>{{ p | default(value="—") }}</option>
              {% endfor %}
            </select>
          </div>
          <div style="flex:1;min-width:160px;">
            <label>Histology confirmed?</label>
            <select name="condition_cancer_histologyConfirmed"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set hc = cond_cancer.histologyConfirmed | default(value='') %}
              <option value="" {% if hc == "" %}selected{% endif %}>Choose…</option>
              <option value="yes" {% if hc == "yes" %}selected{% endif %}>Yes</option>
              <option value="no" {% if hc == "no" %}selected{% endif %}>No</option>
              <option value="pending" {% if hc == "pending" %}selected{% endif %}>Pending</option>
            </select>
          </div>
        </div>
      </div>

      <div x-show="conditions['permanent-fistula'].selected !== 'yes' &&
                   conditions['hypoadrenalism'].selected !== 'yes' &&
                   conditions['diabetes-insipidus-or-hypopituitarism'].selected !== 'yes' &&
                   conditions['diabetes-mellitus-not-diet-only'].selected !== 'yes' &&
                   conditions['hypoparathyroidism'].selected !== 'yes' &&
                   conditions['myasthenia-gravis'].selected !== 'yes' &&
                   conditions['myxoedema'].selected !== 'yes' &&
                   conditions['epilepsy-on-anticonvulsant'].selected !== 'yes' &&
                   conditions['continuing-physical-disability'].selected !== 'yes' &&
                   conditions['cancer-or-effects'].selected !== 'yes'"
           style="background:#fffbe6;border:1px solid #f1d76b;padding:0.6rem;border-radius:4px;color:#8a6d00;">
        No qualifying condition has been selected in Step 6. Go back to Step 6 to choose one or more.
      </div>
    </div>

    <!-- Step 8 — Disability / appliance attestation -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: Disability &amp; Appliance Attestation</h2>
      <p style="color:#555;">For permanent fistula — record the appliance type. For continuing physical disability — attest that the patient cannot leave home without assistance.</p>

      <div x-show="conditions['permanent-fistula'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Permanent fistula — appliance</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:160px;">
            <label>Fistula site</label>
            <select name="condition_permanent_fistula_fistulaSite"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set fs = cond_permanent_fistula.fistulaSite | default(value='') %}
              {% set sites = ["", "caecostomy", "colostomy", "laryngostomy", "ileostomy", "urostomy", "gastrostomy", "other"] %}
              {% for s in sites %}
                <option value="{{ s }}" {% if fs == s %}selected{% endif %}>{{ s | default(value="—") }}</option>
              {% endfor %}
            </select>
          </div>
          <div style="flex:1;min-width:200px;">
            <label>Appliance type</label>
            <select name="condition_permanent_fistula_applianceType"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set ap = cond_permanent_fistula.applianceType | default(value='') %}
              {% set apps = ["", "one-piece-bag", "two-piece-bag", "continuous-dressing", "irrigation-kit", "other"] %}
              {% for a in apps %}
                <option value="{{ a }}" {% if ap == a %}selected{% endif %}>{{ a | default(value="—") }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>

      <div x-show="conditions['continuing-physical-disability'].selected === 'yes'"
           style="border:1px solid #cef;border-radius:4px;padding:0.8rem;margin-top:0.5rem;">
        <h3>Continuing physical disability</h3>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:200px;">
            <label>Cannot leave home unaided?</label>
            <select name="condition_disability_cannotLeaveHomeUnaided"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set ca = cond_disability.cannotLeaveHomeUnaided | default(value='') %}
              <option value="" {% if ca == "" %}selected{% endif %}>Choose…</option>
              <option value="yes" {% if ca == "yes" %}selected{% endif %}>Yes</option>
              <option value="no" {% if ca == "no" %}selected{% endif %}>No</option>
            </select>
          </div>
          <div style="flex:1;min-width:200px;">
            <label>Expected to be permanent?</label>
            <select name="condition_disability_expectedToBePermanent"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
              {% set ep = cond_disability.disabilityExpectedToBePermanent | default(value='') %}
              <option value="" {% if ep == "" %}selected{% endif %}>Choose…</option>
              <option value="yes" {% if ep == "yes" %}selected{% endif %}>Yes — permanent / continuing</option>
              <option value="no" {% if ep == "no" %}selected{% endif %}>No — temporary (excluded)</option>
            </select>
          </div>
        </div>
        <div style="margin-top:0.4rem;">
          <label>Carer / assistance detail</label>
          <textarea name="condition_disability_carerDetail" rows="2"
                    style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ cond_disability.disabilityCarerDetail | default(value='') }}</textarea>
        </div>
      </div>

      <div x-show="conditions['permanent-fistula'].selected !== 'yes' &&
                   conditions['continuing-physical-disability'].selected !== 'yes'"
           style="background:#eef;border:1px solid #99d;padding:0.6rem;border-radius:4px;color:#226;">
        No appliance or disability attestation is required for the conditions you have selected. Proceed to Step 9.
      </div>
    </div>

    <!-- Step 9 — Practitioner declaration -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Practitioner Declaration</h2>
      <p style="color:#555;">The practitioner must confirm they have access to the patient's medical records and have signed the FP92A in ink before posting.</p>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Practitioner signature applied in ink?</label>
          <select name="declarationSignaturePresent"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="" {% if data.declaration.signaturePresent == "" %}selected{% endif %}>Choose…</option>
            <option value="yes" {% if data.declaration.signaturePresent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if data.declaration.signaturePresent == "no" %}selected{% endif %}>No — not yet signed</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Access to patient's medical records?</label>
          <select name="declarationAccessToMedicalRecords"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="" {% if data.declaration.accessToMedicalRecords == "" %}selected{% endif %}>Choose…</option>
            <option value="yes" {% if data.declaration.accessToMedicalRecords == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if data.declaration.accessToMedicalRecords == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="declarationSignatureDate" value="{{ data.declaration.signatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Declaration text (free text printed on the FP92A above the signature)</label>
        <textarea name="declarationText" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.declaration.declarationText }}</textarea>
      </div>
    </div>

    <!-- Step 10 — Summary & sign-off -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: Summary &amp; Sign-off</h2>
      <p style="color:#555;">Review the captured data, add any free-text notes, then submit to compute eligibility and generate a printable PDF preview.</p>

      <div style="background:#f7f7f7;border:1px solid #ddd;border-radius:4px;padding:0.8rem;">
        <p style="margin:0;"><strong>Patient:</strong> {{ data.patient.title }} {{ data.patient.forenames }} {{ data.patient.surname }} ({{ data.patient.unitedKingdomNhsNumber | default(value="—") }})</p>
        <p style="margin:0;"><strong>Practitioner:</strong> {{ data.practitioner.name }} — {{ data.practitioner.registrationBody }} {{ data.practitioner.registrationNumber }}</p>
        <p style="margin:0;"><strong>Practice:</strong> {{ data.practitioner.practiceName }}</p>
        <p style="margin:0;"><strong>Conditions selected:</strong>
          <span x-text="Object.entries(conditions).filter(([_,v]) => v.selected === 'yes').map(([k]) => k).join(', ') || 'none'"></span>
        </p>
      </div>

      <div style="margin-top:0.6rem;">
        <label>Application notes (optional)</label>
        <textarea name="applicationNotes" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.notes }}</textarea>
      </div>

      <p style="color:#a35100;margin-top:0.8rem;">
        After submission, print the resulting FP92A, have the practitioner sign it in ink, and post the original to:
        <br><em>NHSBSA, Medical Exemption Certificates, Bridge House, 152 Pilgrim Street, Newcastle upon Tyne, NE1 6SN.</em>
      </p>
    </div>

    <!-- Wizard nav -->
    <div style="display:flex;justify-content:space-between;margin-top:1rem;">
      <button type="button" x-show="step > 1" @click="step = step - 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        Previous
      </button>
      <span></span>
      <button type="button" x-show="step < totalSteps" @click="step = step + 1"
              style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Next
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.4rem;background:#080;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Submit &amp; Generate Report
      </button>
    </div>
  </form>
</div>
{% endblock %}
