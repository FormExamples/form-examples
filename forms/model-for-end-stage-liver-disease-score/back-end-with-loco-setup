#!/bin/sh
set -euf

form_kebab_case=model-for-end-stage-liver-disease-score
form_snake_case=model_for_end_stage_liver_disease_score

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold model_for_end_stage_liver_disease_score \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    meld_variant:string! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    bilirubin:double \
    bilirubin_unit:string! \
    inr:double \
    creatinine:double \
    creatinine_unit:string! \
    dialysis_sessions_past_week:int \
    cvvhd_24h:string! \
    sodium:double \
    albumin:double \
    clinical_note:text! \
    --api

cargo loco generate scaffold model_for_end_stage_liver_disease_score_grade \
    deleted_at:tstz \
    model_for_end_stage_liver_disease_score:references \
    bilirubin_mg_dl:double \
    creatinine_mg_dl:double \
    creatinine_adjusted:double \
    dialysis_rule_applied:bool! \
    meld_score:int \
    mortality_band:string! \
    estimated_mortality_percent:double \
    graded_at:tstz! \
    --api

cargo loco generate scaffold model_for_end_stage_liver_disease_score_grade_rule \
    deleted_at:tstz \
    model_for_end_stage_liver_disease_score_grade:references \
    rule_id:string! \
    component:string! \
    contribution:double \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold model_for_end_stage_liver_disease_score_grade_flag \
    deleted_at:tstz \
    model_for_end_stage_liver_disease_score_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
