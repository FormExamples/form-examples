<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Patient identification, reporter, and assessment context.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="demographics.first_name"
                   value="{{ demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="demographics.last_name"
                   value="{{ demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="demographics.date_of_birth"
                   value="{{ demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="demographics.sex">
                <option value="" {% if demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if demographics.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="nhs_or_mrn_number">NHS / MRN Number</label>
            <input type="text" id="nhs_or_mrn_number" name="demographics.nhs_or_mrn_number"
                   value="{{ demographics.nhsOrMrnNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="preferred_language">Preferred Language</label>
            <input type="text" id="preferred_language" name="demographics.preferred_language"
                   value="{{ demographics.preferredLanguage }}">
        </div>
        <div class="form-group">
            <label for="ethnicity">Ethnicity</label>
            <input type="text" id="ethnicity" name="demographics.ethnicity"
                   value="{{ demographics.ethnicity }}">
        </div>
    </div>

    <h3>Reporter</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="reporter_role">Reporter Role</label>
            <select id="reporter_role" name="demographics.reporter_role">
                <option value="" {% if demographics.reporterRole == "" %}selected{% endif %}>&mdash;</option>
                <option value="patient" {% if demographics.reporterRole == "patient" %}selected{% endif %}>Patient</option>
                <option value="carer" {% if demographics.reporterRole == "carer" %}selected{% endif %}>Carer</option>
                <option value="clinician" {% if demographics.reporterRole == "clinician" %}selected{% endif %}>Clinician</option>
                <option value="family" {% if demographics.reporterRole == "family" %}selected{% endif %}>Family</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reporter_name">Reporter Name</label>
            <input type="text" id="reporter_name" name="demographics.reporter_name"
                   value="{{ demographics.reporterName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="assessment_date">Assessment Date</label>
            <input type="date" id="assessment_date" name="demographics.assessment_date"
                   value="{{ demographics.assessmentDate }}">
        </div>
        <div class="form-group">
            <label for="assessment_setting">Assessment Setting</label>
            <input type="text" id="assessment_setting" name="demographics.assessment_setting"
                   value="{{ demographics.assessmentSetting }}" placeholder="e.g. Community, Hospice, Hospital">
        </div>
    </div>
</div>
