<div class="card">
    <h2>Step 9: Multidisciplinary Plan &amp; Referrals</h2>
    <p class="form-hint">Confirm which palliative-care services are involved, and any referrals made.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="specialist_palliative_care_involved">Specialist Palliative Care Involved?</label>
            <select id="specialist_palliative_care_involved" name="multidisciplinary_plan.specialist_palliative_care_involved">
                <option value="" {% if multidisciplinary_plan.specialistPalliativeCareInvolved == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.specialistPalliativeCareInvolved == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.specialistPalliativeCareInvolved == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="community_nursing_involved">Community Nursing Involved?</label>
            <select id="community_nursing_involved" name="multidisciplinary_plan.community_nursing_involved">
                <option value="" {% if multidisciplinary_plan.communityNursingInvolved == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.communityNursingInvolved == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.communityNursingInvolved == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hospice_referral_made">Hospice Referral Made?</label>
            <select id="hospice_referral_made" name="multidisciplinary_plan.hospice_referral_made">
                <option value="" {% if multidisciplinary_plan.hospiceReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.hospiceReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.hospiceReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="social_work_referral_made">Social Work Referral?</label>
            <select id="social_work_referral_made" name="multidisciplinary_plan.social_work_referral_made">
                <option value="" {% if multidisciplinary_plan.socialWorkReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.socialWorkReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.socialWorkReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="occupational_therapy_referral_made">Occupational Therapy?</label>
            <select id="occupational_therapy_referral_made" name="multidisciplinary_plan.occupational_therapy_referral_made">
                <option value="" {% if multidisciplinary_plan.occupationalTherapyReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.occupationalTherapyReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.occupationalTherapyReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="physiotherapy_referral_made">Physiotherapy?</label>
            <select id="physiotherapy_referral_made" name="multidisciplinary_plan.physiotherapy_referral_made">
                <option value="" {% if multidisciplinary_plan.physiotherapyReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.physiotherapyReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.physiotherapyReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dietician_referral_made">Dietician?</label>
            <select id="dietician_referral_made" name="multidisciplinary_plan.dietician_referral_made">
                <option value="" {% if multidisciplinary_plan.dieticianReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.dieticianReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.dieticianReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="chaplaincy_referral_made">Chaplaincy?</label>
            <select id="chaplaincy_referral_made" name="multidisciplinary_plan.chaplaincy_referral_made">
                <option value="" {% if multidisciplinary_plan.chaplaincyReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.chaplaincyReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.chaplaincyReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="psychology_referral_made">Psychology?</label>
            <select id="psychology_referral_made" name="multidisciplinary_plan.psychology_referral_made">
                <option value="" {% if multidisciplinary_plan.psychologyReferralMade == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if multidisciplinary_plan.psychologyReferralMade == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if multidisciplinary_plan.psychologyReferralMade == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_referrals">Other Referrals</label>
        <textarea id="other_referrals" name="multidisciplinary_plan.other_referrals">{{ multidisciplinary_plan.otherReferrals }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="review_interval">Review Interval</label>
            <input type="text" id="review_interval" name="multidisciplinary_plan.review_interval"
                   value="{{ multidisciplinary_plan.reviewInterval }}" placeholder="e.g. 2 weeks">
        </div>
        <div class="form-group">
            <label for="key_worker_name">Key Worker Name</label>
            <input type="text" id="key_worker_name" name="multidisciplinary_plan.key_worker_name"
                   value="{{ multidisciplinary_plan.keyWorkerName }}">
        </div>
    </div>

    <div class="form-group">
        <label for="plan_summary">Plan Summary</label>
        <textarea id="plan_summary" name="multidisciplinary_plan.plan_summary">{{ multidisciplinary_plan.planSummary }}</textarea>
    </div>
</div>
