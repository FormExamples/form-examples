<div class="card">
    <h2>Step 7: Psychosocial &amp; Spiritual Concerns</h2>
    <p class="form-hint">Mood, anxiety, existential distress, spiritual support, and unresolved concerns.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="mood_concerns">Mood Concerns?</label>
            <select id="mood_concerns" name="psychosocial_spiritual_concerns.mood_concerns">
                <option value="" {% if psychosocial_spiritual_concerns.moodConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychosocial_spiritual_concerns.moodConcerns == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychosocial_spiritual_concerns.moodConcerns == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="anxiety_concerns">Anxiety Concerns?</label>
            <select id="anxiety_concerns" name="psychosocial_spiritual_concerns.anxiety_concerns">
                <option value="" {% if psychosocial_spiritual_concerns.anxietyConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychosocial_spiritual_concerns.anxietyConcerns == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychosocial_spiritual_concerns.anxietyConcerns == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="existential_distress">Existential Distress?</label>
            <select id="existential_distress" name="psychosocial_spiritual_concerns.existential_distress">
                <option value="" {% if psychosocial_spiritual_concerns.existentialDistress == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychosocial_spiritual_concerns.existentialDistress == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychosocial_spiritual_concerns.existentialDistress == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="mood_notes">Mood Notes</label>
        <textarea id="mood_notes" name="psychosocial_spiritual_concerns.mood_notes">{{ psychosocial_spiritual_concerns.moodNotes }}</textarea>
    </div>
    <div class="form-group">
        <label for="anxiety_notes">Anxiety Notes</label>
        <textarea id="anxiety_notes" name="psychosocial_spiritual_concerns.anxiety_notes">{{ psychosocial_spiritual_concerns.anxietyNotes }}</textarea>
    </div>
    <div class="form-group">
        <label for="existential_notes">Existential Notes</label>
        <textarea id="existential_notes" name="psychosocial_spiritual_concerns.existential_notes">{{ psychosocial_spiritual_concerns.existentialNotes }}</textarea>
    </div>

    <h3>Spiritual</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="spiritual_support_requested">Spiritual Support Requested?</label>
            <select id="spiritual_support_requested" name="psychosocial_spiritual_concerns.spiritual_support_requested">
                <option value="" {% if psychosocial_spiritual_concerns.spiritualSupportRequested == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychosocial_spiritual_concerns.spiritualSupportRequested == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychosocial_spiritual_concerns.spiritualSupportRequested == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="faith_or_belief">Faith or Belief</label>
            <input type="text" id="faith_or_belief" name="psychosocial_spiritual_concerns.faith_or_belief"
                   value="{{ psychosocial_spiritual_concerns.faithOrBelief }}">
        </div>
    </div>
    <div class="form-group">
        <label for="chaplaincy_notes">Chaplaincy Notes</label>
        <textarea id="chaplaincy_notes" name="psychosocial_spiritual_concerns.chaplaincy_notes">{{ psychosocial_spiritual_concerns.chaplaincyNotes }}</textarea>
    </div>

    <h3>Unresolved Concerns</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="unresolved_concerns">Unresolved Concerns?</label>
            <select id="unresolved_concerns" name="psychosocial_spiritual_concerns.unresolved_concerns">
                <option value="" {% if psychosocial_spiritual_concerns.unresolvedConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychosocial_spiritual_concerns.unresolvedConcerns == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychosocial_spiritual_concerns.unresolvedConcerns == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>
    <div class="form-group">
        <label for="unresolved_notes">Unresolved Notes</label>
        <textarea id="unresolved_notes" name="psychosocial_spiritual_concerns.unresolved_notes">{{ psychosocial_spiritual_concerns.unresolvedNotes }}</textarea>
    </div>
</div>
