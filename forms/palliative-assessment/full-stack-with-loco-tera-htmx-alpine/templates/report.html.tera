{% extends "base.html.tera" %}

{% block title %}Palliative Assessment Report - {{ severity_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Palliative Assessment &mdash; Report</h1>
    <div class="severity-badge severity-{{ severity_band }}">{{ severity_label }}</div>
    <div class="checklist-label">ESAS-r Total: {{ esas_total }} / 100 ({{ answered_count }} item{% if answered_count != 1 %}s{% endif %} answered)</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>NHS / MRN:</strong> {{ data.demographics.nhsOrMrnNumber }}<br>
            <strong>Assessment Date:</strong> {{ data.demographics.assessmentDate }}
        </div>
        <div>
            <strong>Primary Diagnosis:</strong> {{ data.primaryDiagnosisPrognosis.primaryDiagnosis }}<br>
            <strong>Prognosis Horizon:</strong> {{ data.primaryDiagnosisPrognosis.prognosisHorizon }}<br>
            <strong>Surprise Question:</strong> {{ data.primaryDiagnosisPrognosis.surpriseQuestion }}<br>
            <strong>Reporter:</strong> {{ data.demographics.reporterName }} ({{ data.demographics.reporterRole }})
        </div>
    </div>
</div>

<!-- ESAS-r Symptoms Table -->
<div class="card">
    <h2>ESAS-r Symptoms</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Symptom</th>
                <th>Intensity (0-10)</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Pain</td><td>{{ data.esasrSymptoms.pain }}</td></tr>
            <tr><td>Tiredness</td><td>{{ data.esasrSymptoms.tiredness }}</td></tr>
            <tr><td>Drowsiness</td><td>{{ data.esasrSymptoms.drowsiness }}</td></tr>
            <tr><td>Nausea</td><td>{{ data.esasrSymptoms.nausea }}</td></tr>
            <tr><td>Lack of appetite</td><td>{{ data.esasrSymptoms.lackOfAppetite }}</td></tr>
            <tr><td>Shortness of breath</td><td>{{ data.esasrSymptoms.shortnessOfBreath }}</td></tr>
            <tr><td>Depression</td><td>{{ data.esasrSymptoms.depression }}</td></tr>
            <tr><td>Anxiety</td><td>{{ data.esasrSymptoms.anxiety }}</td></tr>
            <tr><td>Wellbeing</td><td>{{ data.esasrSymptoms.wellbeing }}</td></tr>
            <tr><td>Other ({{ data.esasrSymptoms.otherLabel }})</td><td>{{ data.esasrSymptoms.other }}</td></tr>
        </tbody>
    </table>
</div>

<!-- Individual symptom flags (any ESAS >= 7) -->
{% if individual_flags | length > 0 %}
<div class="card">
    <h2>Severe-Symptom Flags ({{ individual_flags | length }})</h2>
    <div class="flags-section">
        {% for f in individual_flags %}
        <div class="flag-item flag-high">
            <span class="flag-category">{{ f.symptomLabel }}</span>
            <span class="flag-message">ESAS-r {{ f.score }}/10 &mdash; single-symptom severe flag.</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Additional clinician-facing flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
