{% extends "base.html.tera" %}

{% block title %}Palliative Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Palliative MDT Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, NHS / MRN, or diagnosis...">
    </div>
    <div class="form-group">
        <label for="severity_band">Severity</label>
        <select id="severity_band" name="severity_band">
            <option value="">All</option>
            <option value="none" {% if severity_band == "none" %}selected{% endif %}>None</option>
            <option value="mild" {% if severity_band == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if severity_band == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if severity_band == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="prognosis_horizon">Prognosis</label>
        <select id="prognosis_horizon" name="prognosis_horizon">
            <option value="">All</option>
            <option value="days" {% if prognosis_horizon == "days" %}selected{% endif %}>Days</option>
            <option value="weeks" {% if prognosis_horizon == "weeks" %}selected{% endif %}>Weeks</option>
            <option value="months" {% if prognosis_horizon == "months" %}selected{% endif %}>Months</option>
            <option value="years" {% if prognosis_horizon == "years" %}selected{% endif %}>Years</option>
            <option value="uncertain" {% if prognosis_horizon == "uncertain" %}selected{% endif %}>Uncertain</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Assessment Date</th>
            <th>Patient</th>
            <th>Primary Diagnosis</th>
            <th>Prognosis Horizon</th>
            <th>ESAS-r Total</th>
            <th>Severity</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.assessmentDate }}</a></td>
            <td>{{ c.patientName }}<br><small>{{ c.nhsOrMrnNumber }}</small></td>
            <td>{{ c.primaryDiagnosis }}</td>
            <td>{{ c.prognosisHorizon }}</td>
            <td>{{ c.esasTotal }}</td>
            <td><span class="severity-badge severity-{{ c.severityBand }}">{{ c.severityBand }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
