#!/bin/sh
set -euf

form_kebab_case=cha2ds2-vasc-score-for-atrial-fibrillation-stroke-risk
form_snake_case=cha2ds2_vasc_score_for_atrial_fibrillation_stroke_risk

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold cha2ds2_vasc \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    atrial_fibrillation_type:string! \
    patient_identifier:string! \
    age_years:int \
    sex:string! \
    congestive_heart_failure:string! \
    hypertension:string! \
    diabetes:string! \
    stroke_tia_thromboembolism:string! \
    vascular_disease:string! \
    clinical_note:text! \
    --api

cargo loco generate scaffold cha2ds2_vasc_grade \
    deleted_at:tstz \
    cha2ds2_vasc:references \
    congestive_heart_failure_points:int \
    hypertension_points:int \
    age_points:int \
    diabetes_points:int \
    stroke_points:int \
    vascular_disease_points:int \
    sex_points:int \
    total_score:int \
    risk_band:string! \
    annual_stroke_risk_percent:double \
    anticoagulation_recommendation:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold cha2ds2_vasc_grade_rule \
    deleted_at:tstz \
    cha2ds2_vasc_grade:references \
    rule_id:string! \
    criterion:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold cha2ds2_vasc_grade_flag \
    deleted_at:tstz \
    cha2ds2_vasc_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
