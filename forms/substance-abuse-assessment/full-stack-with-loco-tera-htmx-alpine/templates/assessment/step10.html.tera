<div class="card">
    <h2>Step 10: Treatment Planning &amp; Goals</h2>
    <p class="form-hint">Stage of change, treatment preferences, safety planning, and follow-up.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="treatment_goal">Treatment goal</label>
            <select id="treatment_goal" name="treatment_planning_goals.treatment_goal">
                <option value="" {% if treatment_planning_goals.treatmentGoal == "" %}selected{% endif %}>&mdash;</option>
                <option value="abstinence" {% if treatment_planning_goals.treatmentGoal == "abstinence" %}selected{% endif %}>Abstinence</option>
                <option value="reduced-use" {% if treatment_planning_goals.treatmentGoal == "reduced-use" %}selected{% endif %}>Reduced use / harm reduction</option>
                <option value="maintenance" {% if treatment_planning_goals.treatmentGoal == "maintenance" %}selected{% endif %}>Maintenance (e.g. opioid agonist therapy)</option>
                <option value="undecided" {% if treatment_planning_goals.treatmentGoal == "undecided" %}selected{% endif %}>Undecided</option>
            </select>
        </div>
        <div class="form-group">
            <label for="readiness_to_change">Readiness to change</label>
            <select id="readiness_to_change" name="treatment_planning_goals.readiness_to_change">
                <option value="" {% if treatment_planning_goals.readinessToChange == "" %}selected{% endif %}>&mdash;</option>
                <option value="pre-contemplation" {% if treatment_planning_goals.readinessToChange == "pre-contemplation" %}selected{% endif %}>Pre-contemplation</option>
                <option value="contemplation" {% if treatment_planning_goals.readinessToChange == "contemplation" %}selected{% endif %}>Contemplation</option>
                <option value="preparation" {% if treatment_planning_goals.readinessToChange == "preparation" %}selected{% endif %}>Preparation</option>
                <option value="action" {% if treatment_planning_goals.readinessToChange == "action" %}selected{% endif %}>Action</option>
                <option value="maintenance" {% if treatment_planning_goals.readinessToChange == "maintenance" %}selected{% endif %}>Maintenance</option>
            </select>
        </div>
        <div class="form-group">
            <label for="motivation_level">Motivation level</label>
            <select id="motivation_level" name="treatment_planning_goals.motivation_level">
                <option value="" {% if treatment_planning_goals.motivationLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="low" {% if treatment_planning_goals.motivationLevel == "low" %}selected{% endif %}>Low</option>
                <option value="moderate" {% if treatment_planning_goals.motivationLevel == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="high" {% if treatment_planning_goals.motivationLevel == "high" %}selected{% endif %}>High</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="preferred_treatment_setting">Preferred treatment setting</label>
        <select id="preferred_treatment_setting" name="treatment_planning_goals.preferred_treatment_setting">
            <option value="" {% if treatment_planning_goals.preferredTreatmentSetting == "" %}selected{% endif %}>&mdash;</option>
            <option value="community" {% if treatment_planning_goals.preferredTreatmentSetting == "community" %}selected{% endif %}>Community / outpatient</option>
            <option value="day-programme" {% if treatment_planning_goals.preferredTreatmentSetting == "day-programme" %}selected{% endif %}>Day programme</option>
            <option value="residential" {% if treatment_planning_goals.preferredTreatmentSetting == "residential" %}selected{% endif %}>Residential rehab</option>
            <option value="inpatient" {% if treatment_planning_goals.preferredTreatmentSetting == "inpatient" %}selected{% endif %}>Inpatient detox</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="interested_in_counselling">Interested in counselling?</label>
            <select id="interested_in_counselling" name="treatment_planning_goals.interested_in_counselling">
                <option value="" {% if treatment_planning_goals.interestedInCounselling == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.interestedInCounselling == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.interestedInCounselling == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="interested_in_medication">Interested in medication-assisted treatment?</label>
            <select id="interested_in_medication" name="treatment_planning_goals.interested_in_medication">
                <option value="" {% if treatment_planning_goals.interestedInMedication == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.interestedInMedication == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.interestedInMedication == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="interested_in_self_help">Interested in self-help groups?</label>
            <select id="interested_in_self_help" name="treatment_planning_goals.interested_in_self_help">
                <option value="" {% if treatment_planning_goals.interestedInSelfHelp == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.interestedInSelfHelp == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.interestedInSelfHelp == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="barriers_to_treatment">Barriers to treatment</label>
        <textarea id="barriers_to_treatment" name="treatment_planning_goals.barriers_to_treatment"
                  placeholder="e.g. childcare, transport, work commitments, stigma">{{ treatment_planning_goals.barriersToTreatment }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="support_network_available">Support network available?</label>
            <select id="support_network_available" name="treatment_planning_goals.support_network_available">
                <option value="" {% if treatment_planning_goals.supportNetworkAvailable == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.supportNetworkAvailable == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.supportNetworkAvailable == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="support_network_details">Support network details</label>
            <input type="text" id="support_network_details" name="treatment_planning_goals.support_network_details"
                   value="{{ treatment_planning_goals.supportNetworkDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="risk_of_relapse">Risk of relapse</label>
            <select id="risk_of_relapse" name="treatment_planning_goals.risk_of_relapse">
                <option value="" {% if treatment_planning_goals.riskOfRelapse == "" %}selected{% endif %}>&mdash;</option>
                <option value="low" {% if treatment_planning_goals.riskOfRelapse == "low" %}selected{% endif %}>Low</option>
                <option value="moderate" {% if treatment_planning_goals.riskOfRelapse == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="high" {% if treatment_planning_goals.riskOfRelapse == "high" %}selected{% endif %}>High</option>
            </select>
        </div>
        <div class="form-group">
            <label for="safety_plan_needed">Safety plan needed?</label>
            <select id="safety_plan_needed" name="treatment_planning_goals.safety_plan_needed">
                <option value="" {% if treatment_planning_goals.safetyPlanNeeded == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.safetyPlanNeeded == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.safetyPlanNeeded == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="naloxone_provided">Naloxone provided?</label>
            <select id="naloxone_provided" name="treatment_planning_goals.naloxone_provided">
                <option value="" {% if treatment_planning_goals.naloxoneProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if treatment_planning_goals.naloxoneProvided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if treatment_planning_goals.naloxoneProvided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="follow_up_plan">Follow-up plan</label>
        <textarea id="follow_up_plan" name="treatment_planning_goals.follow_up_plan"
                  placeholder="Describe the agreed follow-up plan, appointments, and key worker.">{{ treatment_planning_goals.followUpPlan }}</textarea>
    </div>
</div>
