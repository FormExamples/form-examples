<div class="card">
    <h2>Step 8: Social &amp; Legal Impact</h2>
    <p class="form-hint">Housing, employment, relationships, safeguarding and legal status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="employment_status">Employment status</label>
            <select id="employment_status" name="social_legal_impact.employment_status">
                <option value="" {% if social_legal_impact.employmentStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="employed-full-time" {% if social_legal_impact.employmentStatus == "employed-full-time" %}selected{% endif %}>Employed full-time</option>
                <option value="employed-part-time" {% if social_legal_impact.employmentStatus == "employed-part-time" %}selected{% endif %}>Employed part-time</option>
                <option value="unemployed" {% if social_legal_impact.employmentStatus == "unemployed" %}selected{% endif %}>Unemployed</option>
                <option value="student" {% if social_legal_impact.employmentStatus == "student" %}selected{% endif %}>Student</option>
                <option value="retired" {% if social_legal_impact.employmentStatus == "retired" %}selected{% endif %}>Retired</option>
                <option value="disability" {% if social_legal_impact.employmentStatus == "disability" %}selected{% endif %}>On disability</option>
            </select>
        </div>
        <div class="form-group">
            <label for="occupation">Occupation</label>
            <input type="text" id="occupation" name="social_legal_impact.occupation"
                   value="{{ social_legal_impact.occupation }}">
        </div>
        <div class="form-group">
            <label for="employment_affected">Employment affected by substance use?</label>
            <select id="employment_affected" name="social_legal_impact.employment_affected">
                <option value="" {% if social_legal_impact.employmentAffected == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.employmentAffected == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.employmentAffected == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="housing_status">Housing status</label>
            <select id="housing_status" name="social_legal_impact.housing_status">
                <option value="" {% if social_legal_impact.housingStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="stable" {% if social_legal_impact.housingStatus == "stable" %}selected{% endif %}>Stable / own / rented</option>
                <option value="temporary" {% if social_legal_impact.housingStatus == "temporary" %}selected{% endif %}>Temporary / sofa-surfing</option>
                <option value="supported" {% if social_legal_impact.housingStatus == "supported" %}selected{% endif %}>Supported housing</option>
                <option value="homeless" {% if social_legal_impact.housingStatus == "homeless" %}selected{% endif %}>Homeless</option>
            </select>
        </div>
        <div class="form-group">
            <label for="relationship_status">Relationship status</label>
            <input type="text" id="relationship_status" name="social_legal_impact.relationship_status"
                   value="{{ social_legal_impact.relationshipStatus }}">
        </div>
        <div class="form-group">
            <label for="relationship_impact">Substance use affecting relationships?</label>
            <select id="relationship_impact" name="social_legal_impact.relationship_impact">
                <option value="" {% if social_legal_impact.relationshipImpact == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.relationshipImpact == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.relationshipImpact == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dependents">Number of dependents</label>
            <input type="number" min="0" id="dependents" name="social_legal_impact.dependents"
                   value="{{ social_legal_impact.dependents }}">
        </div>
        <div class="form-group">
            <label for="children_safeguarding_concerns">Children safeguarding concerns?</label>
            <select id="children_safeguarding_concerns" name="social_legal_impact.children_safeguarding_concerns">
                <option value="" {% if social_legal_impact.childrenSafeguardingConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.childrenSafeguardingConcerns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.childrenSafeguardingConcerns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="social_support">Social support</label>
            <select id="social_support" name="social_legal_impact.social_support">
                <option value="" {% if social_legal_impact.socialSupport == "" %}selected{% endif %}>&mdash;</option>
                <option value="strong" {% if social_legal_impact.socialSupport == "strong" %}selected{% endif %}>Strong</option>
                <option value="some" {% if social_legal_impact.socialSupport == "some" %}selected{% endif %}>Some</option>
                <option value="limited" {% if social_legal_impact.socialSupport == "limited" %}selected{% endif %}>Limited</option>
                <option value="none" {% if social_legal_impact.socialSupport == "none" %}selected{% endif %}>None</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="criminal_record">Criminal record?</label>
            <select id="criminal_record" name="social_legal_impact.criminal_record">
                <option value="" {% if social_legal_impact.criminalRecord == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.criminalRecord == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.criminalRecord == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="criminal_record_details">Criminal record details</label>
            <input type="text" id="criminal_record_details" name="social_legal_impact.criminal_record_details"
                   value="{{ social_legal_impact.criminalRecordDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="current_legal_issues">Current legal issues?</label>
            <select id="current_legal_issues" name="social_legal_impact.current_legal_issues">
                <option value="" {% if social_legal_impact.currentLegalIssues == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.currentLegalIssues == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.currentLegalIssues == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="current_legal_details">Current legal details</label>
            <input type="text" id="current_legal_details" name="social_legal_impact.current_legal_details"
                   value="{{ social_legal_impact.currentLegalDetails }}">
        </div>
        <div class="form-group">
            <label for="dui_dwi_history">DUI / DWI history?</label>
            <select id="dui_dwi_history" name="social_legal_impact.dui_dwi_history">
                <option value="" {% if social_legal_impact.duiDwiHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.duiDwiHistory == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.duiDwiHistory == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="financial_difficulties">Financial difficulties?</label>
            <select id="financial_difficulties" name="social_legal_impact.financial_difficulties">
                <option value="" {% if social_legal_impact.financialDifficulties == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.financialDifficulties == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.financialDifficulties == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="domestic_violence">Domestic violence?</label>
            <select id="domestic_violence" name="social_legal_impact.domestic_violence">
                <option value="" {% if social_legal_impact.domesticViolence == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_legal_impact.domesticViolence == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_legal_impact.domesticViolence == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="domestic_violence_details">Domestic violence details</label>
            <input type="text" id="domestic_violence_details" name="social_legal_impact.domestic_violence_details"
                   value="{{ social_legal_impact.domesticViolenceDetails }}">
        </div>
    </div>
</div>
