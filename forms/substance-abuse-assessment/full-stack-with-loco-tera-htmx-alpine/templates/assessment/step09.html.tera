<div class="card">
    <h2>Step 9: Previous Treatment History</h2>
    <p class="form-hint">Past episodes of detox, rehab, counselling, MAT, and self-help groups.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_treatment">Any previous treatment?</label>
            <select id="previous_treatment" name="previous_treatment_history.previous_treatment">
                <option value="" {% if previous_treatment_history.previousTreatment == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.previousTreatment == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.previousTreatment == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="number_of_treatment_episodes">Number of treatment episodes</label>
            <input type="number" min="0" id="number_of_treatment_episodes" name="previous_treatment_history.number_of_treatment_episodes"
                   value="{{ previous_treatment_history.numberOfTreatmentEpisodes }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_detox">Previous detox?</label>
            <select id="previous_detox" name="previous_treatment_history.previous_detox">
                <option value="" {% if previous_treatment_history.previousDetox == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.previousDetox == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.previousDetox == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="detox_setting">Detox setting</label>
            <select id="detox_setting" name="previous_treatment_history.detox_setting">
                <option value="" {% if previous_treatment_history.detoxSetting == "" %}selected{% endif %}>&mdash;</option>
                <option value="community" {% if previous_treatment_history.detoxSetting == "community" %}selected{% endif %}>Community</option>
                <option value="inpatient" {% if previous_treatment_history.detoxSetting == "inpatient" %}selected{% endif %}>Inpatient</option>
                <option value="residential" {% if previous_treatment_history.detoxSetting == "residential" %}selected{% endif %}>Residential</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_rehab">Previous rehab?</label>
            <select id="previous_rehab" name="previous_treatment_history.previous_rehab">
                <option value="" {% if previous_treatment_history.previousRehab == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.previousRehab == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.previousRehab == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="rehab_type">Rehab type</label>
            <input type="text" id="rehab_type" name="previous_treatment_history.rehab_type"
                   value="{{ previous_treatment_history.rehabType }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_counselling">Previous counselling?</label>
            <select id="previous_counselling" name="previous_treatment_history.previous_counselling">
                <option value="" {% if previous_treatment_history.previousCounselling == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.previousCounselling == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.previousCounselling == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="counselling_type">Counselling type</label>
            <input type="text" id="counselling_type" name="previous_treatment_history.counselling_type"
                   value="{{ previous_treatment_history.counsellingType }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_medication_assisted">Previous medication-assisted treatment?</label>
            <select id="previous_medication_assisted" name="previous_treatment_history.previous_medication_assisted">
                <option value="" {% if previous_treatment_history.previousMedicationAssisted == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.previousMedicationAssisted == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.previousMedicationAssisted == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="mat_medication">MAT medication</label>
            <input type="text" id="mat_medication" name="previous_treatment_history.mat_medication"
                   value="{{ previous_treatment_history.matMedication }}" placeholder="e.g. methadone, buprenorphine, naltrexone">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="self_help_groups">Self-help group attendance?</label>
            <select id="self_help_groups" name="previous_treatment_history.self_help_groups">
                <option value="" {% if previous_treatment_history.selfHelpGroups == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_treatment_history.selfHelpGroups == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_treatment_history.selfHelpGroups == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="self_help_group_type">Self-help group type</label>
            <input type="text" id="self_help_group_type" name="previous_treatment_history.self_help_group_type"
                   value="{{ previous_treatment_history.selfHelpGroupType }}" placeholder="e.g. AA, NA, SMART Recovery">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="longest_period_abstinent">Longest period abstinent</label>
            <input type="text" id="longest_period_abstinent" name="previous_treatment_history.longest_period_abstinent"
                   value="{{ previous_treatment_history.longestPeriodAbstinent }}">
        </div>
        <div class="form-group">
            <label for="relapse_triggers">Relapse triggers</label>
            <input type="text" id="relapse_triggers" name="previous_treatment_history.relapse_triggers"
                   value="{{ previous_treatment_history.relapseTriggers }}">
        </div>
    </div>
</div>
