<div class="card">
    <h2>Step 5: Withdrawal Assessment</h2>
    <p class="form-hint">
        Current and historical withdrawal risk. Seizures, delirium tremens, and
        hallucinations indicate medically-supervised detoxification.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="currently_in_withdrawal">Currently in withdrawal?</label>
            <select id="currently_in_withdrawal" name="withdrawal_assessment.currently_in_withdrawal">
                <option value="" {% if withdrawal_assessment.currentlyInWithdrawal == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if withdrawal_assessment.currentlyInWithdrawal == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if withdrawal_assessment.currentlyInWithdrawal == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="withdrawal_substance">Substance withdrawing from</label>
            <input type="text" id="withdrawal_substance" name="withdrawal_assessment.withdrawal_substance"
                   value="{{ withdrawal_assessment.withdrawalSubstance }}">
        </div>
        <div class="form-group">
            <label for="last_drink_drug_hours">Hours since last drink/drug</label>
            <input type="number" min="0" id="last_drink_drug_hours" name="withdrawal_assessment.last_drink_drug_hours"
                   value="{{ withdrawal_assessment.lastDrinkDrugHours }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="tremor">Tremor</label>
            <select id="tremor" name="withdrawal_assessment.tremor">
                <option value="" {% if withdrawal_assessment.tremor == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.tremor == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.tremor == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.tremor == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.tremor == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sweating">Sweating</label>
            <select id="sweating" name="withdrawal_assessment.sweating">
                <option value="" {% if withdrawal_assessment.sweating == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.sweating == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.sweating == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.sweating == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.sweating == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="nausea_vomiting">Nausea / Vomiting</label>
            <select id="nausea_vomiting" name="withdrawal_assessment.nausea_vomiting">
                <option value="" {% if withdrawal_assessment.nauseaVomiting == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.nauseaVomiting == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.nauseaVomiting == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.nauseaVomiting == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.nauseaVomiting == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="anxiety">Anxiety</label>
            <select id="anxiety" name="withdrawal_assessment.anxiety">
                <option value="" {% if withdrawal_assessment.anxiety == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.anxiety == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.anxiety == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.anxiety == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.anxiety == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="agitation">Agitation</label>
            <select id="agitation" name="withdrawal_assessment.agitation">
                <option value="" {% if withdrawal_assessment.agitation == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.agitation == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.agitation == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.agitation == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.agitation == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="withdrawal_severity">Overall withdrawal severity</label>
            <select id="withdrawal_severity" name="withdrawal_assessment.withdrawal_severity">
                <option value="" {% if withdrawal_assessment.withdrawalSeverity == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if withdrawal_assessment.withdrawalSeverity == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if withdrawal_assessment.withdrawalSeverity == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if withdrawal_assessment.withdrawalSeverity == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if withdrawal_assessment.withdrawalSeverity == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="seizure_history">History of withdrawal seizures?</label>
            <select id="seizure_history" name="withdrawal_assessment.seizure_history">
                <option value="" {% if withdrawal_assessment.seizureHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if withdrawal_assessment.seizureHistory == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if withdrawal_assessment.seizureHistory == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="delirium_tremens_history">History of delirium tremens?</label>
            <select id="delirium_tremens_history" name="withdrawal_assessment.delirium_tremens_history">
                <option value="" {% if withdrawal_assessment.deliriumTremensHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if withdrawal_assessment.deliriumTremensHistory == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if withdrawal_assessment.deliriumTremensHistory == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hallucinations">Hallucinations during withdrawal?</label>
            <select id="hallucinations" name="withdrawal_assessment.hallucinations">
                <option value="" {% if withdrawal_assessment.hallucinations == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if withdrawal_assessment.hallucinations == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if withdrawal_assessment.hallucinations == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="medically_supervised_detox_needed">Medically-supervised detox needed?</label>
        <select id="medically_supervised_detox_needed" name="withdrawal_assessment.medically_supervised_detox_needed">
            <option value="" {% if withdrawal_assessment.medicallySupervisedDetoxNeeded == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if withdrawal_assessment.medicallySupervisedDetoxNeeded == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if withdrawal_assessment.medicallySupervisedDetoxNeeded == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
</div>
