{% extends "base.html.tera" %}

{% block title %}Substance Abuse Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Assessment Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or substance...">
    </div>
    <div class="form-group">
        <label for="overall_risk">Overall Risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if overall_risk == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="audit_risk_category">AUDIT</label>
        <select id="audit_risk_category" name="audit_risk_category">
            <option value="">All</option>
            <option value="low-risk" {% if audit_risk_category == "low-risk" %}selected{% endif %}>Low risk (0-7)</option>
            <option value="hazardous" {% if audit_risk_category == "hazardous" %}selected{% endif %}>Hazardous (8-15)</option>
            <option value="harmful" {% if audit_risk_category == "harmful" %}selected{% endif %}>Harmful (16-19)</option>
            <option value="dependence-likely" {% if audit_risk_category == "dependence-likely" %}selected{% endif %}>Dependence likely (20-40)</option>
        </select>
    </div>
    <div class="form-group">
        <label for="dast_risk_category">DAST-10</label>
        <select id="dast_risk_category" name="dast_risk_category">
            <option value="">All</option>
            <option value="no-problems" {% if dast_risk_category == "no-problems" %}selected{% endif %}>No problems (0)</option>
            <option value="low" {% if dast_risk_category == "low" %}selected{% endif %}>Low (1-2)</option>
            <option value="moderate" {% if dast_risk_category == "moderate" %}selected{% endif %}>Moderate (3-5)</option>
            <option value="substantial" {% if dast_risk_category == "substantial" %}selected{% endif %}>Substantial (6-8)</option>
            <option value="severe" {% if dast_risk_category == "severe" %}selected{% endif %}>Severe (9-10)</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Primary Substance</th>
            <th>AUDIT</th>
            <th>DAST-10</th>
            <th>Overall Risk</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.firstName }} {{ c.lastName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.primarySubstance }}<br><small>{{ c.currentUseStatus }}</small></td>
            <td>{{ c.auditScore }}/40<br><small>{{ c.auditRiskCategory }}</small></td>
            <td>{{ c.dastScore }}/10<br><small>{{ c.dastRiskCategory }}</small></td>
            <td><span class="risk-badge risk-{{ c.overallRisk }}">{{ c.overallRisk }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
