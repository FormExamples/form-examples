{% extends "base.html.tera" %}

{% block title %}Substance Abuse Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Substance Abuse Assessment</h1>
        <p class="landing-description">
            A biopsychosocial substance use disorder evaluation using the validated
            <strong>AUDIT</strong> (Alcohol Use Disorders Identification Test, 0&ndash;40)
            and <strong>DAST-10</strong> (Drug Abuse Screening Test, 0&ndash;10) instruments,
            combined with structured history-taking covering withdrawal risk, mental and
            physical health comorbidities, social and legal context, prior treatment, and
            treatment-planning goals.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>AUDIT &amp; DAST-10</h3>
                <p>Validated alcohol and drug screening instruments with automated scoring and risk-category derivation</p>
            </div>
            <div class="feature">
                <h3>Withdrawal Risk</h3>
                <p>Active withdrawal, seizure history, delirium tremens, and severity scoring drive escalation flags</p>
            </div>
            <div class="feature">
                <h3>Safeguarding Flags</h3>
                <p>High-priority alerts for suicidality, children safeguarding, domestic violence, overdose, and BBV risk</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
