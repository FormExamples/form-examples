#!/bin/sh
set -euf

form_kebab_case=curb-65-pneumonia-severity-score
form_snake_case=curb_65_pneumonia_severity_score

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold curb_65_pneumonia_severity_score \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    patient_identifier:string! \
    sex:string! \
    age_years:int \
    confusion_present:string! \
    amt_score:int \
    urea_measured:string! \
    urea_mmol_l:double \
    respiratory_rate:int \
    systolic_bp:int \
    diastolic_bp:int \
    oxygen_saturation:int \
    temperature_c:double \
    significant_comorbidity:string! \
    multilobar_changes:string! \
    clinician_override_band:string! \
    override_reason:text! \
    clinical_note:text! \
    --api

cargo loco generate scaffold curb_65_pneumonia_severity_score_grade \
    deleted_at:tstz \
    curb_65_pneumonia_severity_score:references \
    confusion_score:int \
    urea_score:int \
    respiratory_rate_score:int \
    blood_pressure_score:int \
    age_score:int \
    total_score:int \
    score_variant:string! \
    risk_band:string! \
    recommended_setting:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold curb_65_pneumonia_severity_score_grade_rule \
    deleted_at:tstz \
    curb_65_pneumonia_severity_score_grade:references \
    rule_id:string! \
    criterion:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold curb_65_pneumonia_severity_score_grade_flag \
    deleted_at:tstz \
    curb_65_pneumonia_severity_score_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
