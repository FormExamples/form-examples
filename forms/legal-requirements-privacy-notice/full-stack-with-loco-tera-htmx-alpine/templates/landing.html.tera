{% extends "base.html.tera" %}

{% block title %}Legal Requirements Privacy Notice - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Legal Requirements Privacy Notice</h1>
        <p class="landing-description">
            UK NHS GP practice privacy notice informing patients how their information
            is shared to meet legal requirements. The notice covers legally-mandated
            data sharing with <strong>NHS England</strong>, the <strong>Care Quality
            Commission (CQC)</strong>, and the <strong>UK Health Security Agency</strong>
            for public health purposes.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Read the Notice</h3>
                <p>The full legal-requirements privacy notice describing how information is shared and your rights</p>
            </div>
            <div class="feature">
                <h3>Acknowledge</h3>
                <p>Tick the confirmation box, type your full name, and record the date</p>
            </div>
            <div class="feature">
                <h3>Legal Basis</h3>
                <p>UK GDPR Article 6(1)(c) and Article 9(2)(h); processing for legal obligation and health-care management</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Acknowledgment
            </button>
        </form>
    </div>
</div>
{% endblock %}
