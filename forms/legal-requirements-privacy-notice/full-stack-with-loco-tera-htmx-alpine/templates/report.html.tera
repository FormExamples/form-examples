{% extends "base.html.tera" %}

{% block title %}Acknowledgment Report - {{ acknowledgment_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Legal Requirements Privacy Notice &mdash; Acknowledgment Report</h1>
    <div class="status-badge status-{{ acknowledgment_status }}">{{ acknowledgment_label }}</div>
    <div class="status-label">Overall completion: {{ overall_percent }}%</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Acknowledgment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>First Name:</strong> {{ data.patient.firstName }}<br>
            <strong>Last Name:</strong> {{ data.patient.lastName }}<br>
            <strong>NHS Number:</strong> {{ data.patient.nhsNumber }}
        </div>
    </div>
</div>

<!-- Acknowledgment -->
<div class="card">
    <h2>Acknowledgment</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Confirmed</td>
                <td>
                    {% if data.acknowledgment.confirmed %}
                        <span class="badge badge-yes">Yes</span>
                    {% else %}
                        <span class="badge badge-no">No</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>Full Name</td>
                <td>{{ data.acknowledgment.fullName }}</td>
            </tr>
            <tr>
                <td>Acknowledged Date</td>
                <td>{{ data.acknowledgment.acknowledgedDate }}</td>
            </tr>
            <tr>
                <td>Items Answered</td>
                <td>{{ progress.answered }} / {{ progress.total }} ({{ progress.percent }}%)</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Acknowledgment Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Unanswered items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Unanswered or Outstanding Items ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge severity-{{ rule.severity }}">{{ rule.severity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Acknowledgment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
