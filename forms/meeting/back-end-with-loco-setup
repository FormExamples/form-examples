#!/bin/sh
set -euf

form_kebab_case=meeting
form_snake_case=meeting

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold organizer \
    deleted_at:tstz \
    name:string! \
    email:string! \
    phone:string! \
    role:string! \
    organisation:string! \
    team:string! \
    location:string! \
    timezone:string! \
    preferred_contact:string! \
    --api

cargo loco generate scaffold meeting \
    deleted_at:tstz \
    organizer:references \
    status:string! \
    title:string! \
    purpose:string! \
    long_description:text! \
    category:string! \
    visibility:string! \
    scheduled_start_at:tstz \
    scheduled_end_at:tstz \
    timezone:string! \
    location:string! \
    video_url:string! \
    phone_number:string! \
    dial_in_code:string! \
    joining_instructions:text! \
    calendar_uid:string! \
    summary:string! \
    actual_start_at:tstz \
    actual_end_at:tstz \
    overall_result:string! \
    additional_notes:text! \
    signed_by_name:string! \
    signed_at:tstz \
    --api

cargo loco generate scaffold agenda_item \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    title:string! \
    duration_minutes:int \
    presenter:string! \
    notes:text! \
    status:string! \
    --api

cargo loco generate scaffold participant \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    name:string! \
    email:string! \
    organisation:string! \
    role:string! \
    response_status:string! \
    attendance_status:string! \
    notes:text! \
    --api

cargo loco generate scaffold resource \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    resource_type:string! \
    name:string! \
    quantity:int \
    unit:string! \
    url:string! \
    cost_amount:double \
    cost_currency:string! \
    status:string! \
    notes:text! \
    --api

cargo loco generate scaffold recurring_rule \
    deleted_at:tstz \
    meeting:references \
    frequency:string! \
    interval_count:int! \
    by_day_of_week:string! \
    by_day_of_month:int \
    by_set_position:int \
    by_month_of_year:int \
    series_count:int \
    series_until:tstz \
    timezone:string! \
    rrule_text:string! \
    --api

cargo loco generate scaffold action_item \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    title:string! \
    description:text! \
    owner_name:string! \
    owner_email:string! \
    due_date:date \
    priority:string! \
    status:string! \
    completed_at:tstz \
    external_reference:string! \
    --api

cargo loco generate scaffold meeting_output \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    title:string! \
    kind:string! \
    url:string! \
    description:text! \
    owner_name:string! \
    --api

cargo loco generate scaffold meeting_outcome \
    deleted_at:tstz \
    meeting:references \
    position:int! \
    title:string! \
    category:string! \
    description:text! \
    impact:string! \
    related_action_item:references \
    --api

cargo loco generate scaffold meeting_grade \
    deleted_at:tstz \
    meeting:references \
    duration_minutes:int \
    agenda_item_count:int! \
    participant_count:int! \
    accepted_count:int! \
    declined_count:int! \
    attended_count:int! \
    action_item_count:int! \
    output_count:int! \
    outcome_count:int! \
    completion_status:string! \
    overall_health:string! \
    override_reason:string! \
    notes:text! \
    signed_by:string! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold meeting_grade_rule \
    deleted_at:tstz \
    meeting_grade:references \
    rule_id:string! \
    instrument:string! \
    grade:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold meeting_grade_flag \
    deleted_at:tstz \
    meeting_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
