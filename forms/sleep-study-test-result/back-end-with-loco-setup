#!/bin/sh
set -euf

form_kebab_case=sleep-study-test-result
form_snake_case=sleep_study_test_result

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    neck_circumference_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold sleep_study_test_result \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    originating_request_reference:string! \
    report_status:string! \
    performed_date:date \
    reported_date:date \
    study_type:string! \
    study_adequacy:string! \
    clinical_history:string! \
    comparison_with_previous:string! \
    total_recording_time_hours:double \
    total_sleep_time_hours:double \
    apnoea_hypopnoea_index:double \
    oxygen_desaturation_index:double \
    minimum_spo2_percent:double \
    time_below_90_percent_spo2:double \
    mean_heart_rate_bpm:int \
    osa_severity:string! \
    obstructive_sleep_apnoea:bool! \
    central_sleep_apnoea:bool! \
    periodic_limb_movements:bool! \
    nocturnal_hypoventilation:bool! \
    significant_desaturation:bool! \
    normal_study:bool! \
    findings_narrative:string! \
    impression:string! \
    reporting_category:string! \
    recommended_follow_up:string! \
    critical_result_communicated:bool! \
    reported_to:string! \
    --api

cargo loco generate scaffold sleep_study_test_result_grade \
    deleted_at:tstz \
    sleep_study_test_result:references \
    result_classification:string! \
    abnormality_severity:string! \
    reporting_category:string! \
    report_completeness_percent:int \
    follow_up_urgency:string! \
    target_timeframe:string! \
    recommended_action:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold sleep_study_test_result_grade_rule \
    deleted_at:tstz \
    sleep_study_test_result_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold sleep_study_test_result_grade_flag \
    deleted_at:tstz \
    sleep_study_test_result_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
