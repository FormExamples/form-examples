{% extends "base.html.tera" %}

{% block title %}Vaccinations Report - {{ compliance_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Vaccinations Checklist &mdash; Report</h1>
    <div class="compliance-badge compliance-{{ compliance_status }}">{{ compliance_label }}</div>
    <div class="risk-badge risk-{{ overall_risk }}">Risk: {{ overall_risk }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}
        </div>
        <div>
            <strong>Occupation:</strong> {{ data.demographics.occupation }}<br>
            <strong>Category:</strong> {{ data.demographics.occupationCategory }}<br>
            <strong>Employer:</strong> {{ data.demographics.employer }}
        </div>
    </div>
</div>

<!-- Completeness Summary -->
<div class="card">
    <h2>Schedule Completeness</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Schedule</th>
                <th>Complete?</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Childhood Immunisations</td>
                <td>
                    {% if childhood_complete %}<span class="badge badge-yes">Yes</span>
                    {% else %}<span class="badge badge-no">No</span>{% endif %}
                </td>
            </tr>
            <tr>
                <td>Occupational Vaccines</td>
                <td>
                    {% if occupational_complete %}<span class="badge badge-yes">Yes</span>
                    {% else %}<span class="badge badge-no">No</span>{% endif %}
                </td>
            </tr>
            <tr>
                <td>COVID-19 Primary Course</td>
                <td>
                    {% if covid_complete %}<span class="badge badge-yes">Yes</span>
                    {% else %}<span class="badge badge-no">No</span>{% endif %}
                </td>
            </tr>
            <tr>
                <td>Current Season Influenza</td>
                <td>
                    {% if flu_current %}<span class="badge badge-yes">Yes</span>
                    {% else %}<span class="badge badge-no">No</span>{% endif %}
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Missing vaccinations -->
{% if missing_vaccinations | length > 0 %}
<div class="card">
    <h2>Missing Vaccinations ({{ missing_vaccinations | length }})</h2>
    <ul>
        {% for v in missing_vaccinations %}
        <li>{{ v }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge severity-grade-{{ rule.grade }}">{{ rule.grade }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Checklist</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
