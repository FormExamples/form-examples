<div class="card">
    <h2>Step 2: Vaccination History</h2>
    <p class="form-hint">Prior vaccination record and contraindications.</p>

    <div class="form-group">
        <label for="has_vaccination_record">Does the patient have a vaccination record?</label>
        <select id="has_vaccination_record" name="vaccinationHistory.hasVaccinationRecord">
            <option value="" {% if vaccination_history.hasVaccinationRecord == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if vaccination_history.hasVaccinationRecord == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if vaccination_history.hasVaccinationRecord == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="record_source">Record Source</label>
        <select id="record_source" name="vaccinationHistory.recordSource">
            <option value="" {% if vaccination_history.recordSource == "" %}selected{% endif %}>&mdash;</option>
            <option value="red-book" {% if vaccination_history.recordSource == "red-book" %}selected{% endif %}>Red Book</option>
            <option value="gp-records" {% if vaccination_history.recordSource == "gp-records" %}selected{% endif %}>GP Records</option>
            <option value="occupational-health" {% if vaccination_history.recordSource == "occupational-health" %}selected{% endif %}>Occupational Health</option>
            <option value="self-reported" {% if vaccination_history.recordSource == "self-reported" %}selected{% endif %}>Self-reported</option>
            <option value="overseas-records" {% if vaccination_history.recordSource == "overseas-records" %}selected{% endif %}>Overseas Records</option>
            <option value="other" {% if vaccination_history.recordSource == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>

    <div class="form-group">
        <label for="record_source_other">Record Source (other)</label>
        <input type="text" id="record_source_other" name="vaccinationHistory.recordSourceOther"
               value="{{ vaccination_history.recordSourceOther }}">
    </div>

    <div class="form-group">
        <label for="previous_adverse_reaction">Previous adverse reaction to a vaccine?</label>
        <select id="previous_adverse_reaction" name="vaccinationHistory.previousAdverseReaction">
            <option value="" {% if vaccination_history.previousAdverseReaction == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if vaccination_history.previousAdverseReaction == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if vaccination_history.previousAdverseReaction == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="adverse_reaction_vaccine">Adverse Reaction Vaccine</label>
        <input type="text" id="adverse_reaction_vaccine" name="vaccinationHistory.adverseReactionVaccine"
               value="{{ vaccination_history.adverseReactionVaccine }}">
    </div>

    <div class="form-group">
        <label for="adverse_reaction_severity">Adverse Reaction Severity</label>
        <select id="adverse_reaction_severity" name="vaccinationHistory.adverseReactionSeverity">
            <option value="" {% if vaccination_history.adverseReactionSeverity == "" %}selected{% endif %}>&mdash;</option>
            <option value="mild" {% if vaccination_history.adverseReactionSeverity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if vaccination_history.adverseReactionSeverity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if vaccination_history.adverseReactionSeverity == "severe" %}selected{% endif %}>Severe</option>
            <option value="anaphylaxis" {% if vaccination_history.adverseReactionSeverity == "anaphylaxis" %}selected{% endif %}>Anaphylaxis</option>
        </select>
    </div>

    <div class="form-group">
        <label for="adverse_reaction_details">Adverse Reaction Details</label>
        <textarea id="adverse_reaction_details" name="vaccinationHistory.adverseReactionDetails">{{ vaccination_history.adverseReactionDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="immunocompromised">Immunocompromised?</label>
        <select id="immunocompromised" name="vaccinationHistory.immunocompromised">
            <option value="" {% if vaccination_history.immunocompromised == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if vaccination_history.immunocompromised == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if vaccination_history.immunocompromised == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="immunocompromised_details">Immunocompromised Details</label>
        <textarea id="immunocompromised_details" name="vaccinationHistory.immunocompromisedDetails">{{ vaccination_history.immunocompromisedDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="pregnant_or_planning">Pregnant or planning pregnancy?</label>
        <select id="pregnant_or_planning" name="vaccinationHistory.pregnantOrPlanning">
            <option value="" {% if vaccination_history.pregnantOrPlanning == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if vaccination_history.pregnantOrPlanning == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if vaccination_history.pregnantOrPlanning == "yes" %}selected{% endif %}>Yes</option>
            <option value="not-applicable" {% if vaccination_history.pregnantOrPlanning == "not-applicable" %}selected{% endif %}>Not applicable</option>
        </select>
    </div>
</div>
