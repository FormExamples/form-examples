<div class="card">
    <h2>Step 8: Contraindications &amp; Allergies</h2>
    <p class="form-hint">Vaccine-specific allergens (egg, gelatin, neomycin, latex, yeast, PEG/polysorbate), GBS history, immunosuppression, blood products, live-vaccine contraindications.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="egg_allergy">Egg allergy</label>
            <select id="egg_allergy" name="contraindicationsAllergies.eggAllergy">
                <option value="" {% if contraindications_allergies.eggAllergy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.eggAllergy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.eggAllergy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="egg_allergy_severity">Egg allergy severity</label>
            <select id="egg_allergy_severity" name="contraindicationsAllergies.eggAllergySeverity">
                <option value="" {% if contraindications_allergies.eggAllergySeverity == "" %}selected{% endif %}>&mdash;</option>
                <option value="mild" {% if contraindications_allergies.eggAllergySeverity == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if contraindications_allergies.eggAllergySeverity == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if contraindications_allergies.eggAllergySeverity == "severe" %}selected{% endif %}>Severe</option>
                <option value="anaphylaxis" {% if contraindications_allergies.eggAllergySeverity == "anaphylaxis" %}selected{% endif %}>Anaphylaxis</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="gelatin_allergy">Gelatin allergy</label>
            <select id="gelatin_allergy" name="contraindicationsAllergies.gelatinAllergy">
                <option value="" {% if contraindications_allergies.gelatinAllergy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.gelatinAllergy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.gelatinAllergy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="neomycin_allergy">Neomycin allergy</label>
            <select id="neomycin_allergy" name="contraindicationsAllergies.neomycinAllergy">
                <option value="" {% if contraindications_allergies.neomycinAllergy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.neomycinAllergy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.neomycinAllergy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="latex_allergy">Latex allergy</label>
            <select id="latex_allergy" name="contraindicationsAllergies.latexAllergy">
                <option value="" {% if contraindications_allergies.latexAllergy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.latexAllergy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.latexAllergy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="yeast_allergy">Yeast allergy</label>
            <select id="yeast_allergy" name="contraindicationsAllergies.yeastAllergy">
                <option value="" {% if contraindications_allergies.yeastAllergy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.yeastAllergy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.yeastAllergy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="peg_polysorbate_allergy">PEG/polysorbate allergy</label>
        <select id="peg_polysorbate_allergy" name="contraindicationsAllergies.pegPolysorbateAllergy">
            <option value="" {% if contraindications_allergies.pegPolysorbateAllergy == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if contraindications_allergies.pegPolysorbateAllergy == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if contraindications_allergies.pegPolysorbateAllergy == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="other_vaccine_allergies">Other vaccine allergies</label>
        <textarea id="other_vaccine_allergies" name="contraindicationsAllergies.otherVaccineAllergies">{{ contraindications_allergies.otherVaccineAllergies }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="history_of_gbs">History of GBS?</label>
            <select id="history_of_gbs" name="contraindicationsAllergies.historyOfGBS">
                <option value="" {% if contraindications_allergies.historyOfGBS == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.historyOfGBS == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.historyOfGBS == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="gbs_details">GBS details</label>
            <input type="text" id="gbs_details" name="contraindicationsAllergies.gbsDetails"
                   value="{{ contraindications_allergies.gbsDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="on_immunosuppressants">On immunosuppressants?</label>
            <select id="on_immunosuppressants" name="contraindicationsAllergies.onImmunosuppressants">
                <option value="" {% if contraindications_allergies.onImmunosuppressants == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.onImmunosuppressants == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.onImmunosuppressants == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="immunosuppressant_details">Immunosuppressant details</label>
            <input type="text" id="immunosuppressant_details" name="contraindicationsAllergies.immunosuppressantDetails"
                   value="{{ contraindications_allergies.immunosuppressantDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="on_blood_products_recent">Recent blood products?</label>
            <select id="on_blood_products_recent" name="contraindicationsAllergies.onBloodProductsRecent">
                <option value="" {% if contraindications_allergies.onBloodProductsRecent == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.onBloodProductsRecent == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.onBloodProductsRecent == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="blood_products_details">Blood products details</label>
            <input type="text" id="blood_products_details" name="contraindicationsAllergies.bloodProductsDetails"
                   value="{{ contraindications_allergies.bloodProductsDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="live_vaccine_contraindicated">Live vaccine contraindicated?</label>
            <select id="live_vaccine_contraindicated" name="contraindicationsAllergies.liveVaccineContraindicated">
                <option value="" {% if contraindications_allergies.liveVaccineContraindicated == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraindications_allergies.liveVaccineContraindicated == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraindications_allergies.liveVaccineContraindicated == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="live_vaccine_contraindication_reason">Reason</label>
            <input type="text" id="live_vaccine_contraindication_reason" name="contraindicationsAllergies.liveVaccineContraindicationReason"
                   value="{{ contraindications_allergies.liveVaccineContraindicationReason }}">
        </div>
    </div>

    <div class="form-group">
        <label for="ctx_notes">Notes</label>
        <textarea id="ctx_notes" name="contraindicationsAllergies.notes">{{ contraindications_allergies.notes }}</textarea>
    </div>
</div>
