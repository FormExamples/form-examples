<div class="card">
    <h2>Step 5: Travel Vaccines</h2>
    <p class="form-hint">Destination-specific travel vaccines and malaria prophylaxis.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="travel_planned">Travel planned?</label>
            <select id="travel_planned" name="travelVaccines.travelPlanned">
                <option value="" {% if travel_vaccines.travelPlanned == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if travel_vaccines.travelPlanned == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if travel_vaccines.travelPlanned == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="travel_destination">Destination</label>
            <input type="text" id="travel_destination" name="travelVaccines.travelDestination"
                   value="{{ travel_vaccines.travelDestination }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="travel_departure_date">Departure</label>
            <input type="date" id="travel_departure_date" name="travelVaccines.travelDepartureDate"
                   value="{{ travel_vaccines.travelDepartureDate }}">
        </div>
        <div class="form-group">
            <label for="travel_return_date">Return</label>
            <input type="date" id="travel_return_date" name="travelVaccines.travelReturnDate"
                   value="{{ travel_vaccines.travelReturnDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="yellow_fever_vaccine">Yellow fever vaccine</label>
            <select id="yellow_fever_vaccine" name="travelVaccines.yellowFeverVaccine">
                <option value="" {% if travel_vaccines.yellowFeverVaccine == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.yellowFeverVaccine == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.yellowFeverVaccine == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if travel_vaccines.yellowFeverVaccine == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="yellow_fever_vaccine_date">Yellow fever date</label>
            <input type="date" id="yellow_fever_vaccine_date" name="travelVaccines.yellowFeverVaccineDate"
                   value="{{ travel_vaccines.yellowFeverVaccineDate }}">
        </div>
        <div class="form-group">
            <label for="yellow_fever_certificate">YF certificate held?</label>
            <select id="yellow_fever_certificate" name="travelVaccines.yellowFeverCertificate">
                <option value="" {% if travel_vaccines.yellowFeverCertificate == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.yellowFeverCertificate == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.yellowFeverCertificate == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="japanese_encephalitis_vaccine">Japanese encephalitis</label>
            <select id="japanese_encephalitis_vaccine" name="travelVaccines.japaneseEncephalitisVaccine">
                <option value="" {% if travel_vaccines.japaneseEncephalitisVaccine == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.japaneseEncephalitisVaccine == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.japaneseEncephalitisVaccine == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if travel_vaccines.japaneseEncephalitisVaccine == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="japanese_encephalitis_date">JE date</label>
            <input type="date" id="japanese_encephalitis_date" name="travelVaccines.japaneseEncephalitisDate"
                   value="{{ travel_vaccines.japaneseEncephalitisDate }}">
        </div>
        <div class="form-group">
            <label for="tick_borne_encephalitis_vaccine">Tick-borne encephalitis</label>
            <select id="tick_borne_encephalitis_vaccine" name="travelVaccines.tickBorneEncephalitisVaccine">
                <option value="" {% if travel_vaccines.tickBorneEncephalitisVaccine == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.tickBorneEncephalitisVaccine == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.tickBorneEncephalitisVaccine == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if travel_vaccines.tickBorneEncephalitisVaccine == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tick_borne_encephalitis_date">TBE date</label>
            <input type="date" id="tick_borne_encephalitis_date" name="travelVaccines.tickBorneEncephalitisDate"
                   value="{{ travel_vaccines.tickBorneEncephalitisDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cholera_vaccine">Cholera vaccine</label>
            <select id="cholera_vaccine" name="travelVaccines.choleraVaccine">
                <option value="" {% if travel_vaccines.choleraVaccine == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.choleraVaccine == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.choleraVaccine == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if travel_vaccines.choleraVaccine == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cholera_vaccine_date">Cholera vaccine date</label>
            <input type="date" id="cholera_vaccine_date" name="travelVaccines.choleraVaccineDate"
                   value="{{ travel_vaccines.choleraVaccineDate }}">
        </div>
        <div class="form-group">
            <label for="meningococcal_acwy_travel">Meningococcal ACWY (travel)</label>
            <select id="meningococcal_acwy_travel" name="travelVaccines.meningococcalACWYTravel">
                <option value="" {% if travel_vaccines.meningococcalACWYTravel == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.meningococcalACWYTravel == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.meningococcalACWYTravel == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if travel_vaccines.meningococcalACWYTravel == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="meningococcal_acwy_travel_date">MenACWY (travel) date</label>
            <input type="date" id="meningococcal_acwy_travel_date" name="travelVaccines.meningococcalACWYTravelDate"
                   value="{{ travel_vaccines.meningococcalACWYTravelDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="malaria_prophylaxis">Malaria prophylaxis</label>
            <select id="malaria_prophylaxis" name="travelVaccines.malariaProphylaxis">
                <option value="" {% if travel_vaccines.malariaProphylaxis == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if travel_vaccines.malariaProphylaxis == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if travel_vaccines.malariaProphylaxis == "no" %}selected{% endif %}>No</option>
                <option value="not-required" {% if travel_vaccines.malariaProphylaxis == "not-required" %}selected{% endif %}>Not required</option>
            </select>
        </div>
        <div class="form-group">
            <label for="malaria_prophylaxis_drug">Malaria prophylaxis drug</label>
            <select id="malaria_prophylaxis_drug" name="travelVaccines.malariaProphylaxisDrug">
                <option value="" {% if travel_vaccines.malariaProphylaxisDrug == "" %}selected{% endif %}>&mdash;</option>
                <option value="atovaquone-proguanil" {% if travel_vaccines.malariaProphylaxisDrug == "atovaquone-proguanil" %}selected{% endif %}>Atovaquone-proguanil</option>
                <option value="doxycycline" {% if travel_vaccines.malariaProphylaxisDrug == "doxycycline" %}selected{% endif %}>Doxycycline</option>
                <option value="mefloquine" {% if travel_vaccines.malariaProphylaxisDrug == "mefloquine" %}selected{% endif %}>Mefloquine</option>
                <option value="chloroquine" {% if travel_vaccines.malariaProphylaxisDrug == "chloroquine" %}selected{% endif %}>Chloroquine</option>
                <option value="other" {% if travel_vaccines.malariaProphylaxisDrug == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="travel_notes">Notes</label>
        <textarea id="travel_notes" name="travelVaccines.notes">{{ travel_vaccines.notes }}</textarea>
    </div>
</div>
