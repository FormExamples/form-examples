<div class="card">
    <h2>Step 6: COVID-19 Vaccination</h2>
    <p class="form-hint">SARS-CoV-2 primary course, boosters, and adverse reactions.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_primary_course">Primary course complete?</label>
            <select id="covid_primary_course" name="covid19Vaccination.covidPrimaryCourse">
                <option value="" {% if covid19_vaccination.covidPrimaryCourse == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if covid19_vaccination.covidPrimaryCourse == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if covid19_vaccination.covidPrimaryCourse == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if covid19_vaccination.covidPrimaryCourse == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="covid_primary_vaccine_type">Primary vaccine type</label>
            <select id="covid_primary_vaccine_type" name="covid19Vaccination.covidPrimaryVaccineType">
                <option value="" {% if covid19_vaccination.covidPrimaryVaccineType == "" %}selected{% endif %}>&mdash;</option>
                <option value="pfizer" {% if covid19_vaccination.covidPrimaryVaccineType == "pfizer" %}selected{% endif %}>Pfizer</option>
                <option value="moderna" {% if covid19_vaccination.covidPrimaryVaccineType == "moderna" %}selected{% endif %}>Moderna</option>
                <option value="astrazeneca" {% if covid19_vaccination.covidPrimaryVaccineType == "astrazeneca" %}selected{% endif %}>AstraZeneca</option>
                <option value="novavax" {% if covid19_vaccination.covidPrimaryVaccineType == "novavax" %}selected{% endif %}>Novavax</option>
                <option value="janssen" {% if covid19_vaccination.covidPrimaryVaccineType == "janssen" %}selected{% endif %}>Janssen</option>
                <option value="other" {% if covid19_vaccination.covidPrimaryVaccineType == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_dose1_date">Dose 1 date</label>
            <input type="date" id="covid_dose1_date" name="covid19Vaccination.covidDose1Date"
                   value="{{ covid19_vaccination.covidDose1Date }}">
        </div>
        <div class="form-group">
            <label for="covid_dose2_date">Dose 2 date</label>
            <input type="date" id="covid_dose2_date" name="covid19Vaccination.covidDose2Date"
                   value="{{ covid19_vaccination.covidDose2Date }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_booster1">Booster 1 received?</label>
            <select id="covid_booster1" name="covid19Vaccination.covidBooster1">
                <option value="" {% if covid19_vaccination.covidBooster1 == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if covid19_vaccination.covidBooster1 == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if covid19_vaccination.covidBooster1 == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="covid_booster1_date">Booster 1 date</label>
            <input type="date" id="covid_booster1_date" name="covid19Vaccination.covidBooster1Date"
                   value="{{ covid19_vaccination.covidBooster1Date }}">
        </div>
        <div class="form-group">
            <label for="covid_booster1_type">Booster 1 type</label>
            <select id="covid_booster1_type" name="covid19Vaccination.covidBooster1Type">
                <option value="" {% if covid19_vaccination.covidBooster1Type == "" %}selected{% endif %}>&mdash;</option>
                <option value="pfizer" {% if covid19_vaccination.covidBooster1Type == "pfizer" %}selected{% endif %}>Pfizer</option>
                <option value="moderna" {% if covid19_vaccination.covidBooster1Type == "moderna" %}selected{% endif %}>Moderna</option>
                <option value="astrazeneca" {% if covid19_vaccination.covidBooster1Type == "astrazeneca" %}selected{% endif %}>AstraZeneca</option>
                <option value="novavax" {% if covid19_vaccination.covidBooster1Type == "novavax" %}selected{% endif %}>Novavax</option>
                <option value="other" {% if covid19_vaccination.covidBooster1Type == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_booster2">Booster 2 received?</label>
            <select id="covid_booster2" name="covid19Vaccination.covidBooster2">
                <option value="" {% if covid19_vaccination.covidBooster2 == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if covid19_vaccination.covidBooster2 == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if covid19_vaccination.covidBooster2 == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="covid_booster2_date">Booster 2 date</label>
            <input type="date" id="covid_booster2_date" name="covid19Vaccination.covidBooster2Date"
                   value="{{ covid19_vaccination.covidBooster2Date }}">
        </div>
        <div class="form-group">
            <label for="covid_booster2_type">Booster 2 type</label>
            <select id="covid_booster2_type" name="covid19Vaccination.covidBooster2Type">
                <option value="" {% if covid19_vaccination.covidBooster2Type == "" %}selected{% endif %}>&mdash;</option>
                <option value="pfizer" {% if covid19_vaccination.covidBooster2Type == "pfizer" %}selected{% endif %}>Pfizer</option>
                <option value="moderna" {% if covid19_vaccination.covidBooster2Type == "moderna" %}selected{% endif %}>Moderna</option>
                <option value="novavax" {% if covid19_vaccination.covidBooster2Type == "novavax" %}selected{% endif %}>Novavax</option>
                <option value="other" {% if covid19_vaccination.covidBooster2Type == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_autumn_booster">Autumn booster received?</label>
            <select id="covid_autumn_booster" name="covid19Vaccination.covidAutumnBooster">
                <option value="" {% if covid19_vaccination.covidAutumnBooster == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if covid19_vaccination.covidAutumnBooster == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if covid19_vaccination.covidAutumnBooster == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="covid_autumn_booster_date">Autumn booster date</label>
            <input type="date" id="covid_autumn_booster_date" name="covid19Vaccination.covidAutumnBoosterDate"
                   value="{{ covid19_vaccination.covidAutumnBoosterDate }}">
        </div>
        <div class="form-group">
            <label for="total_covid_doses">Total COVID doses</label>
            <input type="number" min="0" id="total_covid_doses" name="covid19Vaccination.totalCovidDoses"
                   value="{{ covid19_vaccination.totalCovidDoses }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="covid_adverse_reaction">COVID adverse reaction?</label>
            <select id="covid_adverse_reaction" name="covid19Vaccination.covidAdverseReaction">
                <option value="" {% if covid19_vaccination.covidAdverseReaction == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if covid19_vaccination.covidAdverseReaction == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if covid19_vaccination.covidAdverseReaction == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="covid_adverse_reaction_details">COVID adverse reaction details</label>
            <input type="text" id="covid_adverse_reaction_details" name="covid19Vaccination.covidAdverseReactionDetails"
                   value="{{ covid19_vaccination.covidAdverseReactionDetails }}">
        </div>
    </div>

    <div class="form-group">
        <label for="covid_notes">Notes</label>
        <textarea id="covid_notes" name="covid19Vaccination.notes">{{ covid19_vaccination.notes }}</textarea>
    </div>
</div>
