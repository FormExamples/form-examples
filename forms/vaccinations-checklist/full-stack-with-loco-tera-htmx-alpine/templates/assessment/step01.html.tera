<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Patient identification and occupational context.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="demographics.firstName"
                   value="{{ demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="demographics.lastName"
                   value="{{ demographics.lastName }}">
        </div>
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="demographics.dateOfBirth"
                   value="{{ demographics.dateOfBirth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="demographics.sex">
                <option value="" {% if demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if demographics.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="weight">Weight (kg)</label>
            <input type="number" step="0.1" id="weight" name="demographics.weight"
                   value="{{ demographics.weight }}">
        </div>
        <div class="form-group">
            <label for="height">Height (cm)</label>
            <input type="number" step="0.1" id="height" name="demographics.height"
                   value="{{ demographics.height }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="occupation">Occupation</label>
            <input type="text" id="occupation" name="demographics.occupation"
                   value="{{ demographics.occupation }}">
        </div>
        <div class="form-group">
            <label for="occupation_category">Occupation Category</label>
            <select id="occupation_category" name="demographics.occupationCategory">
                <option value="" {% if demographics.occupationCategory == "" %}selected{% endif %}>&mdash;</option>
                <option value="healthcare" {% if demographics.occupationCategory == "healthcare" %}selected{% endif %}>Healthcare</option>
                <option value="education" {% if demographics.occupationCategory == "education" %}selected{% endif %}>Education</option>
                <option value="social-care" {% if demographics.occupationCategory == "social-care" %}selected{% endif %}>Social Care</option>
                <option value="laboratory" {% if demographics.occupationCategory == "laboratory" %}selected{% endif %}>Laboratory</option>
                <option value="travel" {% if demographics.occupationCategory == "travel" %}selected{% endif %}>Travel</option>
                <option value="military" {% if demographics.occupationCategory == "military" %}selected{% endif %}>Military</option>
                <option value="other" {% if demographics.occupationCategory == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="employer">Employer</label>
            <input type="text" id="employer" name="demographics.employer"
                   value="{{ demographics.employer }}">
        </div>
    </div>
</div>
