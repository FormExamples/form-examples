{% extends "base.html.tera" %}

{% block title %}Agile Consulting Scorecard for Hiring Help{% endblock %}

{% block content %}
<section class="hero">
  <h2>Decide whether your organization is ready to hire agile consulting help.</h2>
  <p>
    Sixteen yes/no checkpoints drawn from the Agile Manifesto (four items) and
    the Principles behind it (twelve items). Score yourself and get a banded
    verdict — low, borderline, medium, or high readiness — along with the
    seed-defined intervention for every item you can't yet tick.
  </p>
  <p class="actions">
    <a class="btn btn-primary" href="/scorecard/new">Start a scorecard →</a>
    <a class="btn btn-secondary" href="/dashboard">View dashboard</a>
  </p>
</section>

<section class="band-explainer">
  <h3>Readiness bands</h3>
  <ul>
    <li><span class="band band-low">low</span> 0–4 — focus on internal operations first; don't hire agile help yet.</li>
    <li><span class="band band-borderline">borderline</span> 5 — treated as low with an explicit "you're close" note.</li>
    <li><span class="band band-medium">medium</span> 6–10 — do your agile homework first; revisit in ~3 months.</li>
    <li><span class="band band-high">high</span> 11–16 — likely ready; trial an engagement and review in ~3 months.</li>
  </ul>
</section>

<section class="api-pointer">
  <h3>Integrating?</h3>
  <p>
    All nine HTTP endpoints are documented in
    <code>doc/api-reference.md</code> with request/response shapes and
    curl examples. The Rust crate exposes <code>POST /api/grade</code>,
    <code>POST /api/recommendations</code>, <code>POST /api/pre-tender</code>,
    <code>POST /api/diff</code>, and <code>POST /api/bulk-import</code> for
    headless integrations.
  </p>
</section>
{% endblock %}
