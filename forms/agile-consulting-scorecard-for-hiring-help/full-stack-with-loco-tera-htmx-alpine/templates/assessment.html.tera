{% extends "base.html.tera" %}

{% block title %}Start a scorecard — Agile Consulting Scorecard{% endblock %}

{% block content %}
<section class="wizard-header">
  <h2>Start a scorecard</h2>
  <p class="subtitle">
    Six steps. One point per item your organization can demonstrably tick today.
    Total banded as <span class="band band-low">low</span> 0–4,
    <span class="band band-borderline">borderline</span> 5,
    <span class="band band-medium">medium</span> 6–10,
    <span class="band band-high">high</span> 11–16.
  </p>
</section>

<form
  method="post"
  action="/scorecard/new"
  class="wizard-form"
  x-data="{ step: 1, total: 6 }"
>
  <nav class="wizard-progress" aria-label="Wizard progress">
    <span x-text="`Step ${step} of ${total}`"></span>
    <div class="progress-bar" role="progressbar" :aria-valuenow="Math.round(step / total * 100)" aria-valuemin="0" aria-valuemax="100">
      <div class="progress-bar-fill" :style="`width: ${step / total * 100}%`"></div>
    </div>
  </nav>

  {% include "assessment/step1_organization.html.tera" %}
  {% include "assessment/step2_manifesto.html.tera" %}
  {% include "assessment/step3_principles_a.html.tera" %}
  {% include "assessment/step4_principles_b.html.tera" %}
  {% include "assessment/step5_principles_c.html.tera" %}
  {% include "assessment/step6_signoff.html.tera" %}

  <div class="wizard-nav">
    <button type="button" x-show="step > 1" @click="step -= 1">← Back</button>
    <button type="button" x-show="step < total" @click="step += 1; window.scrollTo({top: 0, behavior: 'smooth'})">Next →</button>
    <button type="submit" x-show="step === total" class="btn-primary">Submit scorecard</button>
  </div>
</form>
{% endblock %}
