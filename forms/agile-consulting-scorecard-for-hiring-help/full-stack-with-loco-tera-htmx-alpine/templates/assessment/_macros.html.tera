{% macro item(key, heading, prompt) %}
<div class="checklist-item">
  <h4>{{ heading }}</h4>
  <p class="prompt">{{ prompt }}</p>
  <div class="answer-row" role="radiogroup" aria-label="{{ heading }}">
    <label><input type="radio" name="item_{{ key }}_done" value="true"> Yes</label>
    <label><input type="radio" name="item_{{ key }}_done" value="false"> No</label>
    <label><input type="radio" name="item_{{ key }}_done" value="" checked> Unanswered</label>
  </div>
  <label class="evidence-label">
    Evidence (optional)
    <textarea name="item_{{ key }}_evidence" rows="2"></textarea>
  </label>
</div>
{% endmacro %}
