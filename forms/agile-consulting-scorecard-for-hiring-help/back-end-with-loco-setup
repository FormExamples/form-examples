#!/bin/sh
set -euf

form_kebab_case=agile-consulting-scorecard-for-hiring-help
form_snake_case=agile_consulting_scorecard_for_hiring_help

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold organization \
    deleted_at:ts \
    name:string! \
    legal_name:string! \
    sector:string! \
    size_band:string! \
    headcount:int \
    country:string! \
    region:string! \
    website:text! \
    notes:text! \
    --api

cargo loco generate scaffold respondent \
    deleted_at:ts \
    organization:references \
    name:string! \
    email:text! \
    phone:text! \
    role:string! \
    department:string! \
    seniority:string! \
    timezone:string! \
    preferred_contact:string! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help \
    deleted_at:ts \
    organization:references \
    respondent:references \
    status:string! \
    assessment_date:date! \
    submitted_at:ts \
    finalized_at:ts \
    m1_done:bool \
    m1_evidence:text! \
    m2_done:bool \
    m2_evidence:text! \
    m3_done:bool \
    m3_evidence:text! \
    m4_done:bool \
    m4_evidence:text! \
    p1_done:bool \
    p1_evidence:text! \
    p2_done:bool \
    p2_evidence:text! \
    p3_done:bool \
    p3_evidence:text! \
    p4_done:bool \
    p4_evidence:text! \
    p5_done:bool \
    p5_evidence:text! \
    p6_done:bool \
    p6_evidence:text! \
    p7_done:bool \
    p7_evidence:text! \
    p8_done:bool \
    p8_evidence:text! \
    p9_done:bool \
    p9_evidence:text! \
    p10_done:bool \
    p10_evidence:text! \
    p11_done:bool \
    p11_evidence:text! \
    p12_done:bool \
    p12_evidence:text! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade \
    deleted_at:ts \
    agile_consulting_scorecard:references \
    score_total:int \
    manifesto_subtotal:int \
    principles_subtotal:int \
    computed_band:string! \
    final_band:string! \
    override_reason:string! \
    recommendation:string! \
    recommended_focus_areas:text! \
    review_notes:text! \
    signed_by:string! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade_rule \
    deleted_at:ts \
    agile_consulting_scorecard_grade:references \
    rule_id:string! \
    instrument:string! \
    item_number:int \
    grade:string! \
    points_awarded:int! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade_flag \
    deleted_at:ts \
    agile_consulting_scorecard_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
