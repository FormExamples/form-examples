#!/bin/sh
set -euf

form_kebab_case=agile-consulting-scorecard-for-hiring-help
form_snake_case=agile_consulting_scorecard_for_hiring_help

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold organization \
    deleted_at:tstz \
    name:string! \
    legal_name:string! \
    sector:string! \
    size_band:string! \
    headcount:int \
    country:string! \
    region:string! \
    website:text! \
    notes:text! \
    --api

cargo loco generate scaffold respondent \
    deleted_at:tstz \
    organization:references \
    name:string! \
    email:text! \
    phone:text! \
    role:string! \
    department:string! \
    seniority:string! \
    timezone:string! \
    preferred_contact:string! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help \
    deleted_at:tstz \
    organization:references \
    respondent:references \
    status:string! \
    assessment_date:date! \
    submitted_at:tstz \
    finalized_at:tstz \
    m1_done:bool \
    m1_evidence:text! \
    m2_done:bool \
    m2_evidence:text! \
    m3_done:bool \
    m3_evidence:text! \
    m4_done:bool \
    m4_evidence:text! \
    p1_done:bool \
    p1_evidence:text! \
    p2_done:bool \
    p2_evidence:text! \
    p3_done:bool \
    p3_evidence:text! \
    p4_done:bool \
    p4_evidence:text! \
    p5_done:bool \
    p5_evidence:text! \
    p6_done:bool \
    p6_evidence:text! \
    p7_done:bool \
    p7_evidence:text! \
    p8_done:bool \
    p8_evidence:text! \
    p9_done:bool \
    p9_evidence:text! \
    p10_done:bool \
    p10_evidence:text! \
    p11_done:bool \
    p11_evidence:text! \
    p12_done:bool \
    p12_evidence:text! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade \
    deleted_at:tstz \
    agile_consulting_scorecard:references \
    score_total:int \
    manifesto_subtotal:int \
    principles_subtotal:int \
    computed_band:string! \
    final_band:string! \
    override_reason:string! \
    recommendation:string! \
    recommended_focus_areas:text! \
    review_notes:text! \
    signed_by:string! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade_rule \
    deleted_at:tstz \
    agile_consulting_scorecard_grade:references \
    rule_id:string! \
    instrument:string! \
    item_number:int \
    grade:string! \
    points_awarded:int! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold agile_consulting_scorecard_for_hiring_help_grade_flag \
    deleted_at:tstz \
    agile_consulting_scorecard_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
