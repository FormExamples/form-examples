{% extends "base.html.tera" %}

{% block title %}WHO Emergency Unit (Trauma) - Dashboard{% endblock %}

{% block content %}
<div style="max-width:1100px;margin:2rem auto;padding:1rem;">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <h1>Trauma Assessments Dashboard</h1>
    <a href="/" style="padding:0.4rem 1rem;background:#0070f3;color:#fff;border-radius:4px;text-decoration:none;">New Assessment</a>
  </div>

  <form method="GET" action="/dashboard" style="display:flex;gap:0.8rem;flex-wrap:wrap;margin:1rem 0;align-items:flex-end;">
    <div style="flex:1;min-width:220px;">
      <label>Search</label>
      <input type="text" name="search" value="{{ search }}"
             placeholder="Patient name or chief complaint..."
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="min-width:160px;">
      <label>Triage</label>
      <select name="triage_category" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value="">All</option>
        <option value="red"    {% if triage_category == "red" %}selected{% endif %}>RED</option>
        <option value="yellow" {% if triage_category == "yellow" %}selected{% endif %}>YELLOW</option>
        <option value="green"  {% if triage_category == "green" %}selected{% endif %}>GREEN</option>
      </select>
    </div>
    <div style="min-width:160px;">
      <label>Disposition</label>
      <select name="disposition" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value="">All</option>
        <option value="admit"     {% if disposition == "admit" %}selected{% endif %}>Admit</option>
        <option value="transfer"  {% if disposition == "transfer" %}selected{% endif %}>Transfer</option>
        <option value="discharge" {% if disposition == "discharge" %}selected{% endif %}>Discharge</option>
        <option value="died"      {% if disposition == "died" %}selected{% endif %}>Died</option>
      </select>
    </div>
    <div style="min-width:160px;">
      <label>Urgent flags</label>
      <select name="has_urgent" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value="">All</option>
        <option value="yes" {% if has_urgent == "yes" %}selected{% endif %}>With urgent</option>
        <option value="no"  {% if has_urgent == "no" %}selected{% endif %}>Without urgent</option>
      </select>
    </div>
    <div style="display:flex;gap:0.4rem;">
      <button type="submit" style="padding:0.4rem 1rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">Filter</button>
      <a href="/dashboard" style="padding:0.4rem 1rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">Clear</a>
    </div>
  </form>

  <p style="color:#555;">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

  {% if total > 0 %}
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr style="background:#f4f4f4;">
        <th style="padding:0.6rem 1rem;text-align:left;">Arrival</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Patient</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Chief complaint</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Triage</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Disposition</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Completeness</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Urgent flags</th>
      </tr>
    </thead>
    <tbody>
      {% for c in cases %}
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;"><a href="/assessment/{{ c.id }}/report">{{ c.dateOfArrival }}<br><small>{{ c.timeOfArrival }}</small></a></td>
        <td style="padding:0.6rem 1rem;">{{ c.patientName }}<br><small>{{ c.patientSex }}</small></td>
        <td style="padding:0.6rem 1rem;">{{ c.chiefComplaint }}</td>
        <td style="padding:0.6rem 1rem;text-transform:uppercase;">{{ c.triageCategory }}</td>
        <td style="padding:0.6rem 1rem;">{{ c.disposition }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">{{ c.totalSatisfied }} / {{ c.totalRequired }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">
          {% if c.urgentFlagCount > 0 %}
            <span style="background:#fee;color:#900;padding:0.1rem 0.5rem;border-radius:3px;">{{ c.urgentFlagCount }}</span>
          {% else %}
            0
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="text-align:center;color:#888;border:1px solid #eee;padding:2rem;border-radius:4px;">No completed assessments match the current filters.</p>
  {% endif %}
</div>
{% endblock %}
