<!-- Step 9 — Exposure & FAST -->
<div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 9: Exposure (E) &amp; FAST (F)</h2>
  <label><input type="checkbox" name="exposedCompletely" value="on" {% if data.exposureAndFast.exposedCompletely %}checked{% endif %}> Exposed completely</label>
  <div style="margin-top:0.6rem;">
    <label>Exposure notes</label>
    <textarea name="exposureNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposureAndFast.exposureNotes }}</textarea>
  </div>
  <h3 style="margin-top:0.8rem;">FAST</h3>
  <label><input type="checkbox" name="fastNormal" value="on" {% if data.exposureAndFast.fastNormal %}checked{% endif %}> Normal</label><br>
  <label><input type="checkbox" name="fastNotIndicated" value="on" {% if data.exposureAndFast.fastNotIndicated %}checked{% endif %}> Not indicated</label><br>
  <label><input type="checkbox" name="fastNotAvailable" value="on" {% if data.exposureAndFast.fastNotAvailable %}checked{% endif %}> Not available</label>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
    <div style="flex:1;min-width:200px;">
      <label>FAST peritoneum</label>
      <select name="fastPeritoneum" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value=""              {% if data.exposureAndFast.fastPeritoneum == "" %}selected{% endif %}>-- Select --</option>
        <option value="negative"      {% if data.exposureAndFast.fastPeritoneum == "negative" %}selected{% endif %}>Negative</option>
        <option value="indeterminate" {% if data.exposureAndFast.fastPeritoneum == "indeterminate" %}selected{% endif %}>Indeterminate</option>
        <option value="free-fluid"    {% if data.exposureAndFast.fastPeritoneum == "free-fluid" %}selected{% endif %}>Free fluid</option>
      </select>
    </div>
    <div style="flex:1;min-width:200px;">
      <label>FAST chest</label>
      <select name="fastChest" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value=""                     {% if data.exposureAndFast.fastChest == "" %}selected{% endif %}>-- Select --</option>
        <option value="negative"             {% if data.exposureAndFast.fastChest == "negative" %}selected{% endif %}>Negative</option>
        <option value="indeterminate"        {% if data.exposureAndFast.fastChest == "indeterminate" %}selected{% endif %}>Indeterminate</option>
        <option value="pneumothorax"         {% if data.exposureAndFast.fastChest == "pneumothorax" %}selected{% endif %}>Pneumothorax</option>
        <option value="pleural-fluid"        {% if data.exposureAndFast.fastChest == "pleural-fluid" %}selected{% endif %}>Pleural fluid</option>
        <option value="pericardial-effusion" {% if data.exposureAndFast.fastChest == "pericardial-effusion" %}selected{% endif %}>Pericardial effusion</option>
      </select>
    </div>
  </div>
  <div style="margin-top:0.6rem;">
    <label>FAST notes</label>
    <textarea name="fastNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposureAndFast.fastNotes }}</textarea>
  </div>
</div>
