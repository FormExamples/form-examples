<!-- Step 7 — Circulation -->
<div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 7: Circulation (C)</h2>
  <label><input type="checkbox" name="circulationNormal" value="on" {% if data.circulation.normal %}checked{% endif %}> Normal</label>
  <h3 style="margin-top:0.8rem;">Bleeding control</h3>
  <label><input type="checkbox" name="circulationBleedingControlDirectPressure" value="on" {% if data.circulation.bleedingControlDirectPressure %}checked{% endif %}> Direct pressure</label><br>
  <label><input type="checkbox" name="circulationBleedingControlBandage" value="on" {% if data.circulation.bleedingControlBandage %}checked{% endif %}> Bandage</label><br>
  <label><input type="checkbox" name="circulationBleedingControlTourniquet" value="on" {% if data.circulation.bleedingControlTourniquet %}checked{% endif %}> Tourniquet</label>
  <h3 style="margin-top:0.8rem;">Access</h3>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;">
    <div style="flex:1;min-width:140px;">
      <label>IV location</label>
      <input type="text" name="circulationAccessIvLocation" value="{{ data.circulation.accessIvLocation }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="flex:1;min-width:140px;">
      <label>Central location</label>
      <input type="text" name="circulationAccessCentralLocation" value="{{ data.circulation.accessCentralLocation }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="flex:1;min-width:140px;">
      <label>IO location</label>
      <input type="text" name="circulationAccessIoLocation" value="{{ data.circulation.accessIoLocation }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
  </div>
  <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
    <div style="flex:1;min-width:140px;">
      <label>IVF (mL)</label>
      <input type="number" step="any" name="circulationIvfMls"
             value="{{ data.circulation.ivfMls | default(value='') }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="flex:1;min-width:140px;">
      <label>Unstable pelvis</label>
      <select name="circulationUnstablePelvis" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value=""    {% if data.circulation.unstablePelvis == "" %}selected{% endif %}>-- Select --</option>
        <option value="yes" {% if data.circulation.unstablePelvis == "yes" %}selected{% endif %}>Yes</option>
        <option value="no"  {% if data.circulation.unstablePelvis == "no" %}selected{% endif %}>No</option>
      </select>
    </div>
  </div>
  <label style="display:block;margin-top:0.4rem;"><input type="checkbox" name="circulationBloodOrdered" value="on" {% if data.circulation.bloodOrdered %}checked{% endif %}> Blood ordered</label>
  <label style="display:block;"><input type="checkbox" name="circulationBloodGiven" value="on" {% if data.circulation.bloodGiven %}checked{% endif %}> Blood given</label>
  <div style="margin-top:0.6rem;">
    <label>Notes</label>
    <textarea name="circulationNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.circulation.notes }}</textarea>
  </div>
</div>
