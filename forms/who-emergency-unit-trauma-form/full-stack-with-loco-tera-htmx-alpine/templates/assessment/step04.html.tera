<!-- Step 4 — Triage -->
<div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 4: Triage</h2>
  <div>
    <label>Triage category</label>
    <select name="triageCategory" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      <option value=""       {% if data.triage.category == "" %}selected{% endif %}>-- Select --</option>
      <option value="red"    {% if data.triage.category == "red" %}selected{% endif %}>RED (immediate)</option>
      <option value="yellow" {% if data.triage.category == "yellow" %}selected{% endif %}>YELLOW (urgent)</option>
      <option value="green"  {% if data.triage.category == "green" %}selected{% endif %}>GREEN (non-urgent)</option>
    </select>
  </div>
  <div style="margin-top:0.6rem;">
    <label>Triaged for</label>
    <input type="text" name="triagedFor" value="{{ data.triage.triagedFor }}"
           style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
  </div>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
    <div style="flex:1;min-width:160px;">
      <label>Provider assessment date</label>
      <input type="date" name="providerAssessmentDate" value="{{ data.triage.providerAssessmentDate }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="flex:1;min-width:160px;">
      <label>Provider assessment time (24h)</label>
      <input type="time" name="providerAssessmentTime" value="{{ data.triage.providerAssessmentTime }}"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
  </div>
</div>
