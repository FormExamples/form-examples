<!-- Step 11 — Past Histories -->
<div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 11: Past Histories</h2>
  <h3>Past medical history</h3>
  <label><input type="checkbox" name="pmhNone" value="on" {% if data.pastHistories.pmhNone %}checked{% endif %}> None</label>
  <label style="margin-left:1rem;"><input type="checkbox" name="pmhUnknown" value="on" {% if data.pastHistories.pmhUnknown %}checked{% endif %}> Unknown</label><br>
  <label><input type="checkbox" name="pmhHtn" value="on" {% if data.pastHistories.pmhHtn %}checked{% endif %}> Hypertension</label><br>
  <label><input type="checkbox" name="pmhDm" value="on" {% if data.pastHistories.pmhDm %}checked{% endif %}> Diabetes mellitus</label>
  <div style="margin-top:0.6rem;">
    <label>Other PMH</label>
    <input type="text" name="pmhOther" value="{{ data.pastHistories.pmhOther }}"
           style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
  </div>
  <h3 style="margin-top:0.8rem;">Medications</h3>
  <label><input type="checkbox" name="medicationsNone" value="on" {% if data.pastHistories.medicationsNone %}checked{% endif %}> None</label>
  <label style="margin-left:1rem;"><input type="checkbox" name="medicationsUnknown" value="on" {% if data.pastHistories.medicationsUnknown %}checked{% endif %}> Unknown</label>
  <div style="margin-top:0.4rem;">
    <label>Medication list</label>
    <textarea name="medications" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.pastHistories.medications }}</textarea>
  </div>
</div>
