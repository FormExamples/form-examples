{% extends "base.html.tera" %}

{% block title %}WHO Emergency Unit (Trauma) - Wizard{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>WHO Emergency Unit Form: Trauma</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Patient Registration -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Patient Registration</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Surname (family name)</label>
          <input type="text" name="surname" value="{{ data.patientRegistration.surname }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>First name</label>
          <input type="text" name="firstName" value="{{ data.patientRegistration.firstName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Date of birth</label>
          <input type="date" name="dateOfBirth" value="{{ data.patientRegistration.dateOfBirth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Sex</label>
          <select name="sex" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""       {% if data.patientRegistration.sex == "" %}selected{% endif %}>-- Select --</option>
            <option value="male"   {% if data.patientRegistration.sex == "male" %}selected{% endif %}>Male</option>
            <option value="female" {% if data.patientRegistration.sex == "female" %}selected{% endif %}>Female</option>
            <option value="other"  {% if data.patientRegistration.sex == "other" %}selected{% endif %}>Other</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Weight (kg)</label>
          <input type="number" step="any" name="weightKg"
                 value="{{ data.patientRegistration.weightKg | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Date of arrival</label>
          <input type="date" name="dateOfArrival" value="{{ data.patientRegistration.dateOfArrival }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Time of arrival (24h)</label>
          <input type="time" name="timeOfArrival" value="{{ data.patientRegistration.timeOfArrival }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>Arrival mode</label>
          <select name="arrivalMode" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""                {% if data.patientRegistration.arrivalMode == "" %}selected{% endif %}>-- Select --</option>
            <option value="ambulance"       {% if data.patientRegistration.arrivalMode == "ambulance" %}selected{% endif %}>Ambulance</option>
            <option value="car-private"     {% if data.patientRegistration.arrivalMode == "car-private" %}selected{% endif %}>Car (private)</option>
            <option value="car-taxi"        {% if data.patientRegistration.arrivalMode == "car-taxi" %}selected{% endif %}>Car (taxi)</option>
            <option value="motor-2-3-private" {% if data.patientRegistration.arrivalMode == "motor-2-3-private" %}selected{% endif %}>2/3-wheel motor (private)</option>
            <option value="motor-2-3-taxi"  {% if data.patientRegistration.arrivalMode == "motor-2-3-taxi" %}selected{% endif %}>2/3-wheel motor (taxi)</option>
            <option value="public-transport"{% if data.patientRegistration.arrivalMode == "public-transport" %}selected{% endif %}>Public transport</option>
            <option value="walk"            {% if data.patientRegistration.arrivalMode == "walk" %}selected{% endif %}>Walk</option>
            <option value="other"           {% if data.patientRegistration.arrivalMode == "other" %}selected{% endif %}>Other</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Pregnant</label>
          <select name="pregnant" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""    {% if data.patientRegistration.pregnant == "" %}selected{% endif %}>-- Select --</option>
            <option value="yes" {% if data.patientRegistration.pregnant == "yes" %}selected{% endif %}>Yes</option>
            <option value="no"  {% if data.patientRegistration.pregnant == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Injury location</label>
        <input type="text" name="injuryLocation" value="{{ data.patientRegistration.injuryLocation }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <label style="display:block;margin-top:0.3rem;">
          <input type="checkbox" name="injuryLocationUnknown" value="on"
                 {% if data.patientRegistration.injuryLocationUnknown %}checked{% endif %}>
          Unknown
        </label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>
          <input type="checkbox" name="ivDrugUse" value="on"
                 {% if data.patientRegistration.ivDrugUse %}checked{% endif %}>
          IV drug use reported
        </label>
      </div>
    </div>

    <!-- Step 2 — Chief Complaint & Vitals -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Chief Complaint &amp; Vitals</h2>
      <div>
        <label>Chief complaint</label>
        <textarea name="chiefComplaint" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.chiefComplaintAndVitals.chiefComplaint }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Allergies</label>
        <input type="text" name="allergies" value="{{ data.chiefComplaintAndVitals.allergies }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <label style="display:block;margin-top:0.3rem;">
          <input type="checkbox" name="allergiesUnknown" value="on"
                 {% if data.chiefComplaintAndVitals.allergiesUnknown %}checked{% endif %}>
          Unknown
        </label>
      </div>
      <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>Vitals time (24h)</label>
          <input type="time" name="initialVitalsTime" value="{{ data.chiefComplaintAndVitals.initialVitals.time }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Temp (C)</label>
          <input type="number" step="0.1" name="initialTempC"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.tempC | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Pulse (bpm)</label>
          <input type="number" name="initialPulse"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.pulse | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>RR (/min)</label>
          <input type="number" name="initialRespiratoryRate"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.respiratoryRate | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>SBP (mmHg)</label>
          <input type="number" name="initialBpSystolic"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.bpSystolic | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>DBP (mmHg)</label>
          <input type="number" name="initialBpDiastolic"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.bpDiastolic | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>SpO2 (%)</label>
          <input type="number" name="initialSpo2"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.spo2 | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Pain score (0-10)</label>
          <input type="number" min="0" max="10" name="initialPainScore"
                 value="{{ data.chiefComplaintAndVitals.initialVitals.painScore | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>
          <input type="checkbox" name="deadOnArrival" value="on"
                 {% if data.chiefComplaintAndVitals.deadOnArrival %}checked{% endif %}>
          Dead on arrival
        </label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Time of death (if DOA)</label>
        <input type="time" name="timeOfDeath" value="{{ data.chiefComplaintAndVitals.timeOfDeath }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 3 — High Risk Signs -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: High Risk Signs</h2>
      <p style="color:#666;">Tick any RED signs and trauma indicators present.</p>
      <fieldset style="border:1px solid #eee;border-radius:4px;padding:0.6rem;margin-bottom:0.6rem;">
        <legend>RED signs</legend>
        <label><input type="checkbox" name="redStridor" value="on" {% if data.highRiskSigns.redStridor %}checked{% endif %}> Stridor</label><br>
        <label><input type="checkbox" name="redCyanosis" value="on" {% if data.highRiskSigns.redCyanosis %}checked{% endif %}> Cyanosis</label><br>
        <label><input type="checkbox" name="redRespiratoryDistress" value="on" {% if data.highRiskSigns.redRespiratoryDistress %}checked{% endif %}> Respiratory distress</label><br>
        <label><input type="checkbox" name="redPoorPerfusion" value="on" {% if data.highRiskSigns.redPoorPerfusion %}checked{% endif %}> Poor perfusion</label><br>
        <label><input type="checkbox" name="redHeavyBleeding" value="on" {% if data.highRiskSigns.redHeavyBleeding %}checked{% endif %}> Heavy bleeding</label><br>
        <label><input type="checkbox" name="redUnresponsive" value="on" {% if data.highRiskSigns.redUnresponsive %}checked{% endif %}> Unresponsive</label>
      </fieldset>
      <fieldset style="border:1px solid #eee;border-radius:4px;padding:0.6rem;margin-bottom:0.6rem;">
        <legend>Trauma indicators</legend>
        <label><input type="checkbox" name="traumaPolytrauma" value="on" {% if data.highRiskSigns.traumaPolytrauma %}checked{% endif %}> Polytrauma</label><br>
        <label><input type="checkbox" name="traumaAllPenetrating" value="on" {% if data.highRiskSigns.traumaAllPenetrating %}checked{% endif %}> Penetrating trauma</label><br>
        <label><input type="checkbox" name="traumaCrushInjury" value="on" {% if data.highRiskSigns.traumaCrushInjury %}checked{% endif %}> Crush injury</label><br>
        <label><input type="checkbox" name="traumaBleedingDisorderOrAnticoag" value="on" {% if data.highRiskSigns.traumaBleedingDisorderOrAnticoag %}checked{% endif %}> Bleeding disorder / anticoagulation</label><br>
        <label><input type="checkbox" name="traumaPregnant" value="on" {% if data.highRiskSigns.traumaPregnant %}checked{% endif %}> Pregnant trauma patient</label>
      </fieldset>
      <fieldset style="border:1px solid #eee;border-radius:4px;padding:0.6rem;">
        <legend>Road traffic</legend>
        <label><input type="checkbox" name="rtHighSpeedCrash" value="on" {% if data.highRiskSigns.rtHighSpeedCrash %}checked{% endif %}> High-speed crash</label><br>
        <label><input type="checkbox" name="rtPedestrianOrCyclistHit" value="on" {% if data.highRiskSigns.rtPedestrianOrCyclistHit %}checked{% endif %}> Pedestrian / cyclist hit by vehicle</label>
      </fieldset>
    </div>

    <!-- Step 4 — Triage -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Triage</h2>
      <div>
        <label>Triage category</label>
        <select name="triageCategory" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""       {% if data.triage.category == "" %}selected{% endif %}>-- Select --</option>
          <option value="red"    {% if data.triage.category == "red" %}selected{% endif %}>RED (immediate)</option>
          <option value="yellow" {% if data.triage.category == "yellow" %}selected{% endif %}>YELLOW (urgent)</option>
          <option value="green"  {% if data.triage.category == "green" %}selected{% endif %}>GREEN (non-urgent)</option>
        </select>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Triaged for</label>
        <input type="text" name="triagedFor" value="{{ data.triage.triagedFor }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Provider assessment date</label>
          <input type="date" name="providerAssessmentDate" value="{{ data.triage.providerAssessmentDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Provider assessment time (24h)</label>
          <input type="time" name="providerAssessmentTime" value="{{ data.triage.providerAssessmentTime }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 5 — Airway -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Airway (A)</h2>
      <label><input type="checkbox" name="airwayNormal" value="on" {% if data.airway.normal %}checked{% endif %}> Normal</label><br>
      <label><input type="checkbox" name="airwaySwelling" value="on" {% if data.airway.swelling %}checked{% endif %}> Swelling / angioedema</label><br>
      <label><input type="checkbox" name="airwayStridor" value="on" {% if data.airway.stridor %}checked{% endif %}> Stridor</label><br>
      <label><input type="checkbox" name="airwayVoiceChanges" value="on" {% if data.airway.voiceChanges %}checked{% endif %}> Voice changes</label><br>
      <label><input type="checkbox" name="airwayBurns" value="on" {% if data.airway.burns %}checked{% endif %}> Burns</label>
      <h3 style="margin-top:0.8rem;">Interventions</h3>
      <label><input type="checkbox" name="airwayInterventionRepositioning" value="on" {% if data.airway.interventionRepositioning %}checked{% endif %}> Repositioning</label><br>
      <label><input type="checkbox" name="airwayInterventionSuction" value="on" {% if data.airway.interventionSuction %}checked{% endif %}> Suction</label><br>
      <label><input type="checkbox" name="airwayInterventionOpa" value="on" {% if data.airway.interventionOpa %}checked{% endif %}> OPA</label><br>
      <label><input type="checkbox" name="airwayInterventionNpa" value="on" {% if data.airway.interventionNpa %}checked{% endif %}> NPA</label><br>
      <label><input type="checkbox" name="airwayInterventionLma" value="on" {% if data.airway.interventionLma %}checked{% endif %}> LMA</label><br>
      <label><input type="checkbox" name="airwayInterventionBvm" value="on" {% if data.airway.interventionBvm %}checked{% endif %}> BVM</label><br>
      <label><input type="checkbox" name="airwayInterventionEtt" value="on" {% if data.airway.interventionEtt %}checked{% endif %}> ETT</label>
      <div style="margin-top:0.6rem;">
        <label>Spine stabilisation (required for RED triage)</label>
        <select name="airwaySpineStabilized" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""               {% if data.airway.spineStabilized == "" %}selected{% endif %}>-- Select --</option>
          <option value="before-arrival" {% if data.airway.spineStabilized == "before-arrival" %}selected{% endif %}>Before arrival</option>
          <option value="in-eu"          {% if data.airway.spineStabilized == "in-eu" %}selected{% endif %}>In EU</option>
          <option value="not-needed"     {% if data.airway.spineStabilized == "not-needed" %}selected{% endif %}>Not needed</option>
        </select>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="airwayNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.airway.notes }}</textarea>
      </div>
    </div>

    <!-- Step 6 — Breathing -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Breathing (B)</h2>
      <label><input type="checkbox" name="breathingNormal" value="on" {% if data.breathing.normal %}checked{% endif %}> Normal</label><br>
      <label><input type="checkbox" name="breathingCyanosis" value="on" {% if data.breathing.cyanosis %}checked{% endif %}> Cyanosis</label>
      <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>Spontaneous RR (/min)</label>
          <input type="number" name="breathingSpontaneousRespiratoryRate"
                 value="{{ data.breathing.spontaneousRespiratoryRate | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Oxygen (L/min)</label>
          <input type="number" step="any" name="breathingOxygenLitres"
                 value="{{ data.breathing.oxygenLitres | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <h3 style="margin-top:0.8rem;">Oxygen delivery</h3>
      <label><input type="checkbox" name="breathingOxygenNasalCannula" value="on" {% if data.breathing.oxygenNasalCannula %}checked{% endif %}> Nasal cannula</label><br>
      <label><input type="checkbox" name="breathingOxygenMask" value="on" {% if data.breathing.oxygenMask %}checked{% endif %}> Mask</label><br>
      <label><input type="checkbox" name="breathingOxygenNonRebreather" value="on" {% if data.breathing.oxygenNonRebreather %}checked{% endif %}> Non-rebreather</label><br>
      <label><input type="checkbox" name="breathingOxygenBvm" value="on" {% if data.breathing.oxygenBvm %}checked{% endif %}> BVM</label><br>
      <label><input type="checkbox" name="breathingOxygenCpapBipap" value="on" {% if data.breathing.oxygenCpapBipap %}checked{% endif %}> CPAP / BiPAP</label><br>
      <label><input type="checkbox" name="breathingOxygenVentilator" value="on" {% if data.breathing.oxygenVentilator %}checked{% endif %}> Ventilator</label>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="breathingNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.breathing.notes }}</textarea>
      </div>
    </div>

    <!-- Step 7 — Circulation -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Circulation (C)</h2>
      <label><input type="checkbox" name="circulationNormal" value="on" {% if data.circulation.normal %}checked{% endif %}> Normal</label>
      <h3 style="margin-top:0.8rem;">Bleeding control</h3>
      <label><input type="checkbox" name="circulationBleedingControlDirectPressure" value="on" {% if data.circulation.bleedingControlDirectPressure %}checked{% endif %}> Direct pressure</label><br>
      <label><input type="checkbox" name="circulationBleedingControlBandage" value="on" {% if data.circulation.bleedingControlBandage %}checked{% endif %}> Bandage</label><br>
      <label><input type="checkbox" name="circulationBleedingControlTourniquet" value="on" {% if data.circulation.bleedingControlTourniquet %}checked{% endif %}> Tourniquet</label>
      <h3 style="margin-top:0.8rem;">Access</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>IV location</label>
          <input type="text" name="circulationAccessIvLocation" value="{{ data.circulation.accessIvLocation }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Central location</label>
          <input type="text" name="circulationAccessCentralLocation" value="{{ data.circulation.accessCentralLocation }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>IO location</label>
          <input type="text" name="circulationAccessIoLocation" value="{{ data.circulation.accessIoLocation }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>IVF (mL)</label>
          <input type="number" step="any" name="circulationIvfMls"
                 value="{{ data.circulation.ivfMls | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Unstable pelvis</label>
          <select name="circulationUnstablePelvis" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""    {% if data.circulation.unstablePelvis == "" %}selected{% endif %}>-- Select --</option>
            <option value="yes" {% if data.circulation.unstablePelvis == "yes" %}selected{% endif %}>Yes</option>
            <option value="no"  {% if data.circulation.unstablePelvis == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>
      <label style="display:block;margin-top:0.4rem;"><input type="checkbox" name="circulationBloodOrdered" value="on" {% if data.circulation.bloodOrdered %}checked{% endif %}> Blood ordered</label>
      <label style="display:block;"><input type="checkbox" name="circulationBloodGiven" value="on" {% if data.circulation.bloodGiven %}checked{% endif %}> Blood given</label>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="circulationNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.circulation.notes }}</textarea>
      </div>
    </div>

    <!-- Step 8 — Disability -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: Disability (D)</h2>
      <div>
        <label>AVPU</label>
        <select name="avpu" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""  {% if data.disability.avpu == "" %}selected{% endif %}>-- Select --</option>
          <option value="A" {% if data.disability.avpu == "A" %}selected{% endif %}>A — Alert</option>
          <option value="V" {% if data.disability.avpu == "V" %}selected{% endif %}>V — Verbal</option>
          <option value="P" {% if data.disability.avpu == "P" %}selected{% endif %}>P — Pain</option>
          <option value="U" {% if data.disability.avpu == "U" %}selected{% endif %}>U — Unresponsive</option>
        </select>
      </div>
      <div style="margin-top:0.6rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:120px;">
          <label>GCS total</label>
          <input type="number" min="3" max="15" name="gcsTotal"
                 value="{{ data.disability.gcsTotal | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Eye</label>
          <input type="number" min="1" max="4" name="gcsEye"
                 value="{{ data.disability.gcsEye | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Verbal</label>
          <input type="number" min="1" max="5" name="gcsVerbal"
                 value="{{ data.disability.gcsVerbal | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Motor</label>
          <input type="number" min="1" max="6" name="gcsMotor"
                 value="{{ data.disability.gcsMotor | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <label style="display:block;margin-top:0.4rem;">
        <input type="checkbox" name="gcsQualified" value="on" {% if data.disability.gcsQualified %}checked{% endif %}>
        GCS qualified (sedated / intubated / vision obstructed)
      </label>
      <div style="margin-top:0.6rem;">
        <label>Blood glucose (mg/dL)</label>
        <input type="number" step="any" name="bloodGlucose"
               value="{{ data.disability.bloodGlucose | default(value='') }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <label style="display:block;margin-top:0.4rem;"><input type="checkbox" name="disabilityInterventionGlucose" value="on" {% if data.disability.interventionGlucose %}checked{% endif %}> Glucose given</label>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="disabilityNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.disability.notes }}</textarea>
      </div>
    </div>

    <!-- Step 9 — Exposure & FAST -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Exposure (E) &amp; FAST (F)</h2>
      <label><input type="checkbox" name="exposedCompletely" value="on" {% if data.exposureAndFast.exposedCompletely %}checked{% endif %}> Exposed completely</label>
      <div style="margin-top:0.6rem;">
        <label>Exposure notes</label>
        <textarea name="exposureNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposureAndFast.exposureNotes }}</textarea>
      </div>
      <h3 style="margin-top:0.8rem;">FAST</h3>
      <label><input type="checkbox" name="fastNormal" value="on" {% if data.exposureAndFast.fastNormal %}checked{% endif %}> Normal</label><br>
      <label><input type="checkbox" name="fastNotIndicated" value="on" {% if data.exposureAndFast.fastNotIndicated %}checked{% endif %}> Not indicated</label><br>
      <label><input type="checkbox" name="fastNotAvailable" value="on" {% if data.exposureAndFast.fastNotAvailable %}checked{% endif %}> Not available</label>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>FAST peritoneum</label>
          <select name="fastPeritoneum" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""              {% if data.exposureAndFast.fastPeritoneum == "" %}selected{% endif %}>-- Select --</option>
            <option value="negative"      {% if data.exposureAndFast.fastPeritoneum == "negative" %}selected{% endif %}>Negative</option>
            <option value="indeterminate" {% if data.exposureAndFast.fastPeritoneum == "indeterminate" %}selected{% endif %}>Indeterminate</option>
            <option value="free-fluid"    {% if data.exposureAndFast.fastPeritoneum == "free-fluid" %}selected{% endif %}>Free fluid</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>FAST chest</label>
          <select name="fastChest" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""                     {% if data.exposureAndFast.fastChest == "" %}selected{% endif %}>-- Select --</option>
            <option value="negative"             {% if data.exposureAndFast.fastChest == "negative" %}selected{% endif %}>Negative</option>
            <option value="indeterminate"        {% if data.exposureAndFast.fastChest == "indeterminate" %}selected{% endif %}>Indeterminate</option>
            <option value="pneumothorax"         {% if data.exposureAndFast.fastChest == "pneumothorax" %}selected{% endif %}>Pneumothorax</option>
            <option value="pleural-fluid"        {% if data.exposureAndFast.fastChest == "pleural-fluid" %}selected{% endif %}>Pleural fluid</option>
            <option value="pericardial-effusion" {% if data.exposureAndFast.fastChest == "pericardial-effusion" %}selected{% endif %}>Pericardial effusion</option>
          </select>
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>FAST notes</label>
        <textarea name="fastNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposureAndFast.fastNotes }}</textarea>
      </div>
    </div>

    <!-- Step 10 — Injury History -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: Injury History</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label>Date of injury</label>
          <input type="date" name="dateOfInjury" value="{{ data.injuryHistory.dateOfInjury }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Time of injury (24h)</label>
          <input type="time" name="timeOfInjury" value="{{ data.injuryHistory.timeOfInjury }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Intent</label>
        <select name="intent" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""                     {% if data.injuryHistory.intent == "" %}selected{% endif %}>-- Select --</option>
          <option value="unintentional"        {% if data.injuryHistory.intent == "unintentional" %}selected{% endif %}>Unintentional</option>
          <option value="intentional-self-harm"{% if data.injuryHistory.intent == "intentional-self-harm" %}selected{% endif %}>Intentional self-harm</option>
          <option value="intentional-assault"  {% if data.injuryHistory.intent == "intentional-assault" %}selected{% endif %}>Intentional assault</option>
          <option value="legal-political-war"  {% if data.injuryHistory.intent == "legal-political-war" %}selected{% endif %}>Legal / political / war</option>
          <option value="unknown"              {% if data.injuryHistory.intent == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Prehospital care provider</label>
        <select name="prehospitalCareProvider" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""                        {% if data.injuryHistory.prehospitalCareProvider == "" %}selected{% endif %}>-- Select --</option>
          <option value="none"                    {% if data.injuryHistory.prehospitalCareProvider == "none" %}selected{% endif %}>None</option>
          <option value="layperson"               {% if data.injuryHistory.prehospitalCareProvider == "layperson" %}selected{% endif %}>Layperson</option>
          <option value="healthcare-professional" {% if data.injuryHistory.prehospitalCareProvider == "healthcare-professional" %}selected{% endif %}>Healthcare professional</option>
        </select>
      </div>
      <h3 style="margin-top:0.8rem;">Mechanism of injury</h3>
      <label><input type="checkbox" name="mechRoadTrafficIncident" value="on" {% if data.injuryHistory.mechRoadTrafficIncident %}checked{% endif %}> Road traffic incident</label><br>
      <label><input type="checkbox" name="mechStabCut" value="on" {% if data.injuryHistory.mechStabCut %}checked{% endif %}> Stab / cut</label><br>
      <label><input type="checkbox" name="mechGunshot" value="on" {% if data.injuryHistory.mechGunshot %}checked{% endif %}> Gunshot</label><br>
      <label><input type="checkbox" name="mechOtherBluntForce" value="on" {% if data.injuryHistory.mechOtherBluntForce %}checked{% endif %}> Other blunt force</label><br>
      <label><input type="checkbox" name="mechUnknown" value="on" {% if data.injuryHistory.mechUnknown %}checked{% endif %}> Unknown</label>
      <div style="margin-top:0.6rem;">
        <label>Fall from</label>
        <input type="text" name="mechFallFrom" value="{{ data.injuryHistory.mechFallFrom }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.6rem;">
        <label>Loss of consciousness duration</label>
        <select name="lossOfConsciousnessDuration" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""           {% if data.injuryHistory.lossOfConsciousnessDuration == "" %}selected{% endif %}>-- Select --</option>
          <option value="none"       {% if data.injuryHistory.lossOfConsciousnessDuration == "none" %}selected{% endif %}>None</option>
          <option value="under-5min" {% if data.injuryHistory.lossOfConsciousnessDuration == "under-5min" %}selected{% endif %}>< 5 min</option>
          <option value="5-29min"    {% if data.injuryHistory.lossOfConsciousnessDuration == "5-29min" %}selected{% endif %}>5-29 min</option>
          <option value="30min-24hr" {% if data.injuryHistory.lossOfConsciousnessDuration == "30min-24hr" %}selected{% endif %}>30 min - 24 hr</option>
        </select>
      </div>
    </div>

    <!-- Step 11 — Past Histories -->
    <div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 11: Past Histories</h2>
      <h3>Past medical history</h3>
      <label><input type="checkbox" name="pmhNone" value="on" {% if data.pastHistories.pmhNone %}checked{% endif %}> None</label>
      <label style="margin-left:1rem;"><input type="checkbox" name="pmhUnknown" value="on" {% if data.pastHistories.pmhUnknown %}checked{% endif %}> Unknown</label><br>
      <label><input type="checkbox" name="pmhHtn" value="on" {% if data.pastHistories.pmhHtn %}checked{% endif %}> Hypertension</label><br>
      <label><input type="checkbox" name="pmhDm" value="on" {% if data.pastHistories.pmhDm %}checked{% endif %}> Diabetes mellitus</label>
      <div style="margin-top:0.6rem;">
        <label>Other PMH</label>
        <input type="text" name="pmhOther" value="{{ data.pastHistories.pmhOther }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <h3 style="margin-top:0.8rem;">Medications</h3>
      <label><input type="checkbox" name="medicationsNone" value="on" {% if data.pastHistories.medicationsNone %}checked{% endif %}> None</label>
      <label style="margin-left:1rem;"><input type="checkbox" name="medicationsUnknown" value="on" {% if data.pastHistories.medicationsUnknown %}checked{% endif %}> Unknown</label>
      <div style="margin-top:0.4rem;">
        <label>Medication list</label>
        <textarea name="medications" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.pastHistories.medications }}</textarea>
      </div>
    </div>

    <!-- Step 12 — Physical Exam -->
    <div x-show="step === 12" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 12: Physical Exam</h2>
      <p style="color:#666;">Document any abnormal findings on the body diagram and in narrative notes (this minimal full-stack stub does not capture per-system fields — see SvelteKit form for full coverage).</p>
    </div>

    <!-- Step 13 — Assessment & Plan -->
    <div x-show="step === 13" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 13: Assessment &amp; Plan</h2>
      <div>
        <label>Narrative</label>
        <textarea name="assessmentAndPlanNarrative" rows="5" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.assessmentAndPlan.narrative }}</textarea>
      </div>
    </div>

    <!-- Step 14 — Diagnostics -->
    <div x-show="step === 14" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 14: Diagnostics</h2>
      <p style="color:#666;">Order labs (Hgb, Blood Type, Chemistry, Hepatic, UPT) and imaging (CXR, Pelvis XR, Head CT, C-spine, Chest/Abdomen CT, Extremity XR) as clinically indicated. Detailed entry is captured in the SvelteKit form.</p>
    </div>

    <!-- Step 15 — Medications & Procedures -->
    <div x-show="step === 15" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 15: Medications &amp; Procedures</h2>
      <p style="color:#666;">Timed medication entries and procedure log are captured in the SvelteKit form.</p>
    </div>

    <!-- Step 16 — Reassessment -->
    <div x-show="step === 16" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 16: Reassessment</h2>
      <p style="color:#666;">Repeat vital signs and condition status are captured in the SvelteKit form.</p>
    </div>

    <!-- Step 17 — Disposition -->
    <div x-show="step === 17" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 17: Disposition</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label>ED departure date</label>
          <input type="date" name="edDepartureDate" value="{{ data.disposition.edDepartureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>ED departure time</label>
          <input type="time" name="edDepartureTime" value="{{ data.disposition.edDepartureTime }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Diagnoses / Impressions</label>
        <textarea name="diagnosesImpressions" rows="3" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.disposition.diagnosesImpressions }}</textarea>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Disposition</label>
          <select name="disposition" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""          {% if data.disposition.disposition == "" %}selected{% endif %}>-- Select --</option>
            <option value="admit"     {% if data.disposition.disposition == "admit" %}selected{% endif %}>Admit</option>
            <option value="transfer"  {% if data.disposition.disposition == "transfer" %}selected{% endif %}>Transfer</option>
            <option value="discharge" {% if data.disposition.disposition == "discharge" %}selected{% endif %}>Discharge</option>
            <option value="died"      {% if data.disposition.disposition == "died" %}selected{% endif %}>Died</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Admit ward (if Admit)</label>
          <select name="admitWard" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""     {% if data.disposition.admitWard == "" %}selected{% endif %}>-- Select --</option>
            <option value="ward" {% if data.disposition.admitWard == "ward" %}selected{% endif %}>Ward</option>
            <option value="icu"  {% if data.disposition.admitWard == "icu" %}selected{% endif %}>ICU</option>
            <option value="ot"   {% if data.disposition.admitWard == "ot" %}selected{% endif %}>OT</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Discharge plan discussed</label>
          <select name="dischargePlanDiscussed" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""    {% if data.disposition.dischargePlanDiscussed == "" %}selected{% endif %}>-- Select --</option>
            <option value="yes" {% if data.disposition.dischargePlanDiscussed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no"  {% if data.disposition.dischargePlanDiscussed == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Transfer destination (if Transfer)</label>
        <input type="text" name="transferTo" value="{{ data.disposition.transferTo }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.6rem;">
        <label>Cause of death (if Died — NOT cardiopulmonary arrest)</label>
        <input type="text" name="diedCause" value="{{ data.disposition.diedCause }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <label style="display:block;margin-top:0.4rem;">
        <input type="checkbox" name="leftWithoutBeingSeen" value="on" {% if data.disposition.leftWithoutBeingSeen %}checked{% endif %}>
        Left without being seen
      </label>
      <div style="margin-top:0.6rem;">
        <label>Emergency unit provider</label>
        <input type="text" name="emergencyUnitProvider" value="{{ data.disposition.emergencyUnitProvider }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Signature</label>
          <input type="text" name="signature" value="{{ data.disposition.signature }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="signatureDate" value="{{ data.disposition.signatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;margin-top:1rem;">
      <button type="button" x-show="step > 1" @click="step--"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        Previous
      </button>
      <span></span>
      <button type="button" x-show="step < totalSteps" @click="step++"
              style="padding:0.5rem 1.2rem;border:1px solid #0070f3;background:#0070f3;color:#fff;border-radius:4px;cursor:pointer;">
        Next
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.2rem;border:1px solid #080;background:#080;color:#fff;border-radius:4px;cursor:pointer;">
        Submit Assessment
      </button>
    </div>
  </form>

  <p style="margin-top:1rem;">
    <a href="/" style="color:#0070f3;">Cancel and return to home</a>
  </p>
</div>
{% endblock %}
