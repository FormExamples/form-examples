<!-- Step 5 — Airway -->
<div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 5: Airway (A)</h2>
  <label><input type="checkbox" name="airwayNormal" value="on" {% if data.airway.normal %}checked{% endif %}> Normal</label><br>
  <label><input type="checkbox" name="airwaySwelling" value="on" {% if data.airway.swelling %}checked{% endif %}> Swelling / angioedema</label><br>
  <label><input type="checkbox" name="airwayStridor" value="on" {% if data.airway.stridor %}checked{% endif %}> Stridor</label><br>
  <label><input type="checkbox" name="airwayVoiceChanges" value="on" {% if data.airway.voiceChanges %}checked{% endif %}> Voice changes</label><br>
  <label><input type="checkbox" name="airwayBurns" value="on" {% if data.airway.burns %}checked{% endif %}> Burns</label>
  <h3 style="margin-top:0.8rem;">Interventions</h3>
  <label><input type="checkbox" name="airwayInterventionRepositioning" value="on" {% if data.airway.interventionRepositioning %}checked{% endif %}> Repositioning</label><br>
  <label><input type="checkbox" name="airwayInterventionSuction" value="on" {% if data.airway.interventionSuction %}checked{% endif %}> Suction</label><br>
  <label><input type="checkbox" name="airwayInterventionOpa" value="on" {% if data.airway.interventionOpa %}checked{% endif %}> OPA</label><br>
  <label><input type="checkbox" name="airwayInterventionNpa" value="on" {% if data.airway.interventionNpa %}checked{% endif %}> NPA</label><br>
  <label><input type="checkbox" name="airwayInterventionLma" value="on" {% if data.airway.interventionLma %}checked{% endif %}> LMA</label><br>
  <label><input type="checkbox" name="airwayInterventionBvm" value="on" {% if data.airway.interventionBvm %}checked{% endif %}> BVM</label><br>
  <label><input type="checkbox" name="airwayInterventionEtt" value="on" {% if data.airway.interventionEtt %}checked{% endif %}> ETT</label>
  <div style="margin-top:0.6rem;">
    <label>Spine stabilisation (required for RED triage)</label>
    <select name="airwaySpineStabilized" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      <option value=""               {% if data.airway.spineStabilized == "" %}selected{% endif %}>-- Select --</option>
      <option value="before-arrival" {% if data.airway.spineStabilized == "before-arrival" %}selected{% endif %}>Before arrival</option>
      <option value="in-eu"          {% if data.airway.spineStabilized == "in-eu" %}selected{% endif %}>In EU</option>
      <option value="not-needed"     {% if data.airway.spineStabilized == "not-needed" %}selected{% endif %}>Not needed</option>
    </select>
  </div>
  <div style="margin-top:0.6rem;">
    <label>Notes</label>
    <textarea name="airwayNotes" rows="2" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.airway.notes }}</textarea>
  </div>
</div>
