{% extends "base.html.tera" %}

{% block title %}WHO Emergency Unit Form: Trauma{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>WHO Emergency Unit Form: Trauma</h1>
  <p>
    World Health Organization standardised emergency unit clinical
    documentation form for trauma patients. Captures registration, vital
    signs, ABCDE primary survey with FAST ultrasound, injury mechanism and
    history, physical exam, diagnostics, medications and procedures,
    reassessment, and disposition.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>17 Steps</h3>
      <p>Registration, Vitals, High Risk, Triage, Airway, Breathing, Circulation, Disability, Exposure &amp; FAST, Injury, Past Hx, Exam, A&amp;P, Diagnostics, Meds &amp; Procs, Reassessment, Disposition.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>RED Triage Ratchet</h3>
      <p>RED triage requires spine stabilisation status and a recorded GCS (or "qualified" when sedated/intubated) on top of the standard primary survey.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Critical SpO2, abnormal AVPU, low GCS, FAST positives, polytrauma, anticoagulation, dead-on-arrival and other clinically significant findings escalate for review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New Assessment
    </button>
  </form>
</div>
{% endblock %}
