#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding ct-scan-test-request (6 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api && \
cargo loco generate scaffold ct_scan_test_request \
    deleted_at:ts \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    body_region:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    contrast_required:string! \
    pregnancy_status:string! \
    egfr:double \
    previous_contrast_reaction:string! \
    iodine_contrast_allergy:bool! \
    metformin:bool! \
    diabetes:bool! \
    renal_impairment:bool! \
    weight_kg:double \
    relevant_previous_imaging:string! \
    urgency:string! \
    supervising_consultant:string! \
    ir_me_r_justification:string! \
    notes:string! \
    --api && \
cargo loco generate scaffold ct_scan_test_request_grade \
    deleted_at:ts \
    ct_scan_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    contrast_safety_band:string! \
    estimated_dose_band:string! \
    renal_risk:bool! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold ct_scan_test_request_grade_rule \
    deleted_at:ts \
    ct_scan_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api && \
cargo loco generate scaffold ct_scan_test_request_grade_flag \
    deleted_at:ts \
    ct_scan_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

echo "Done."
