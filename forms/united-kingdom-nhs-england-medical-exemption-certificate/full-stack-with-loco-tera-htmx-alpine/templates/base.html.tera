<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}UK NHS England FP92A Medical Exemption Certificate{% endblock %}</title>
    <link rel="stylesheet" href="/static/css/style.css">
  <script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body hx-boost="true">
    <header class="header">
        <div class="container header-inner">
            <a href="/" class="header-title">UK NHS England FP92A Medical Exemption Certificate</a>
            <nav class="header-nav">
                <a href="/">Home</a>
                <a href="/dashboard">Dashboard</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="container">
            <p>UK NHSBSA Medical Exemption Certificate (FP92A). Captures the FP92A data set, evaluates eligibility against the closed list of 10 NHSBSA qualifying conditions, and produces a signed printable record for the practitioner to sign in ink and post to NHSBSA Bridge House.</p>
        </div>
    </footer>

    {% block scripts %}{% endblock %}
</body>
</html>
