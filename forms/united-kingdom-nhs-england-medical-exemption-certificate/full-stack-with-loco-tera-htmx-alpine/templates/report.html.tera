{% extends "base.html.tera" %}

{% block title %}FP92A Report - {{ outcome }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>FP92A &mdash; Medical Exemption Certificate Report</h1>
    <div class="outcome-badge outcome-{{ outcome }}">{{ outcome }}</div>
    <div class="checklist-label">{{ result_category }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Application ID: {{ id }}<br>
        Generated: {{ timestamp }}<br>
        {% if redirect_to %}Redirect to: <strong>{{ redirect_to }}</strong><br>{% endif %}
        Validity window: {{ valid_from }} &rarr; {{ valid_until }} ({{ validity_years }} years)
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ patient.title }} {{ patient.forenames }} {{ patient.surname }}<br>
            <strong>Date of Birth:</strong> {{ patient.birthDate }}<br>
            <strong>Sex:</strong> {{ patient.sex }}<br>
            <strong>NHS Number:</strong> {{ patient.unitedKingdomNhsNumber }}<br>
        </div>
        <div>
            <strong>Address:</strong><br>{{ patient.postalAddressAsFullText }}<br>{{ patient.postcode }}<br>
            <strong>Pregnancy status:</strong> {{ patient.pregnancyStatus }}<br>
            <strong>Full-time education:</strong> {{ patient.fullTimeEducation }}
        </div>
    </div>
</div>

<!-- Practitioner Summary -->
<div class="card">
    <h2>Practitioner</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ practitioner.name }}<br>
            <strong>Role:</strong> {{ practitioner.role }}<br>
            <strong>Registration:</strong> {{ practitioner.registrationBody }} {{ practitioner.registrationNumber }}<br>
        </div>
        <div>
            <strong>Practice:</strong> {{ practitioner.practiceName }}<br>
            <strong>Practice code:</strong> {{ practitioner.practiceCode }}<br>
            <strong>Completed date:</strong> {{ practitioner.completedDate }}
        </div>
    </div>
</div>

<!-- Eligible conditions -->
<div class="card">
    <h2>Eligibility</h2>
    <p><strong>Outcome:</strong> {{ outcome }}</p>
    <p><strong>Notes:</strong> {{ result_notes }}</p>
    {% if eligible_condition_codes | length > 0 %}
    <p><strong>Qualifying conditions met:</strong></p>
    <ul>
        {% for code in eligible_condition_codes %}
            <li><code>{{ code }}</code></li>
        {% endfor %}
    </ul>
    {% else %}
    <p>No qualifying condition met the FP92A criteria.</p>
    {% endif %}
</div>

<!-- Safety / Advisory Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Advisory Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Description</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td><span class="severity-badge severity-{{ rule.priority }}">{{ rule.priority }}</span></td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.message }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Declaration -->
<div class="card">
    <h2>Declaration</h2>
    <p><strong>Signed in ink:</strong> {{ declaration.signaturePresent }}</p>
    <p><strong>Access to medical records:</strong> {{ declaration.accessToMedicalRecords }}</p>
    <p><strong>Signature date:</strong> {{ declaration.signatureDate }}</p>
    {% if declaration.declarationText %}
    <p>{{ declaration.declarationText }}</p>
    {% endif %}
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Application</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
