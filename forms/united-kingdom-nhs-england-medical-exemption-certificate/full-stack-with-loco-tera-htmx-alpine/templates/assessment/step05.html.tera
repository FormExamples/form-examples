<div class="card">
    <h2>Step 5: Pregnancy / Maternity Check</h2>
    <p class="form-hint">Pregnant patients or those within 12 months post-partum should use the FW8 maternity exemption, not FP92A.</p>

    <div class="form-group">
        <label for="patientPregnancyStatus">Pregnancy status</label>
        <select id="patientPregnancyStatus" name="patientPregnancyStatus">
            <option value="" {% if patient.pregnancyStatus == "" %}selected{% endif %}>&mdash;</option>
            <option value="not-pregnant" {% if patient.pregnancyStatus == "not-pregnant" %}selected{% endif %}>Not pregnant</option>
            <option value="pregnant" {% if patient.pregnancyStatus == "pregnant" %}selected{% endif %}>Pregnant</option>
            <option value="post-partum-within-12-months" {% if patient.pregnancyStatus == "post-partum-within-12-months" %}selected{% endif %}>Within 12 months post-partum</option>
        </select>
    </div>
</div>
