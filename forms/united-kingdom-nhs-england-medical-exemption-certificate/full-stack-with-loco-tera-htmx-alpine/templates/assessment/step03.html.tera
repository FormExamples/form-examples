<div class="card">
    <h2>Step 3: Existing Exemption Check</h2>
    <p class="form-hint">Is this a new application, a renewal of an expiring certificate, or a replacement for a lost / damaged certificate?</p>

    <div class="form-row">
        <div class="form-group">
            <label for="applicationKind">Application kind</label>
            <select id="applicationKind" name="applicationKind">
                <option value="" {% if existing_exemption.applicationKind == "" %}selected{% endif %}>&mdash;</option>
                <option value="new" {% if existing_exemption.applicationKind == "new" %}selected{% endif %}>New</option>
                <option value="renewal" {% if existing_exemption.applicationKind == "renewal" %}selected{% endif %}>Renewal</option>
                <option value="replacement" {% if existing_exemption.applicationKind == "replacement" %}selected{% endif %}>Replacement</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hasExistingCertificate">Has an existing certificate?</label>
            <select id="hasExistingCertificate" name="hasExistingCertificate">
                <option value="" {% if existing_exemption.hasExistingCertificate == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if existing_exemption.hasExistingCertificate == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if existing_exemption.hasExistingCertificate == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previousCertificateNumber">Previous certificate number</label>
            <input type="text" id="previousCertificateNumber" name="previousCertificateNumber" value="{{ existing_exemption.previousCertificateNumber }}">
        </div>
        <div class="form-group">
            <label for="previousCertificateExpiryDate">Previous certificate expiry</label>
            <input type="date" id="previousCertificateExpiryDate" name="previousCertificateExpiryDate" value="{{ existing_exemption.previousCertificateExpiryDate }}">
        </div>
    </div>
</div>
