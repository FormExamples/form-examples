<div class="card">
    <h2>Step 8: Condition Detail (Part 2)</h2>
    <p class="form-hint">Condition-specific detail for epilepsy, disability, and cancer.</p>

    <h3>Epilepsy on continuous anticonvulsant</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="condition_epilepsy_anticonvulsant">Anticonvulsant medication</label>
            <input type="text" id="condition_epilepsy_anticonvulsant" name="condition_epilepsy_anticonvulsant" value="{{ cond_epilepsy.anticonvulsant }}">
        </div>
        <div class="form-group">
            <label for="condition_epilepsy_continuousAnticonvulsantTherapy">Continuous therapy?</label>
            <select id="condition_epilepsy_continuousAnticonvulsantTherapy" name="condition_epilepsy_continuousAnticonvulsantTherapy">
                <option value="" {% if cond_epilepsy.continuousAnticonvulsantTherapy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cond_epilepsy.continuousAnticonvulsantTherapy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cond_epilepsy.continuousAnticonvulsantTherapy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <h3>Continuing physical disability</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="condition_disability_cannotLeaveHomeUnaided">Cannot leave home unaided?</label>
            <select id="condition_disability_cannotLeaveHomeUnaided" name="condition_disability_cannotLeaveHomeUnaided">
                <option value="" {% if cond_disability.cannotLeaveHomeUnaided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cond_disability.cannotLeaveHomeUnaided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cond_disability.cannotLeaveHomeUnaided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="condition_disability_expectedToBePermanent">Expected to be permanent?</label>
            <select id="condition_disability_expectedToBePermanent" name="condition_disability_expectedToBePermanent">
                <option value="" {% if cond_disability.disabilityExpectedToBePermanent == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cond_disability.disabilityExpectedToBePermanent == "no" %}selected{% endif %}>No (temporary)</option>
                <option value="yes" {% if cond_disability.disabilityExpectedToBePermanent == "yes" %}selected{% endif %}>Yes (continuing)</option>
            </select>
        </div>
    </div>
    <div class="form-group">
        <label for="condition_disability_carerDetail">Carer / support detail</label>
        <textarea id="condition_disability_carerDetail" name="condition_disability_carerDetail" rows="2">{{ cond_disability.disabilityCarerDetail }}</textarea>
    </div>

    <h3>Cancer / effects of cancer treatment</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="condition_cancer_site">Site</label>
            <input type="text" id="condition_cancer_site" name="condition_cancer_site" value="{{ cond_cancer.cancerSite }}">
        </div>
        <div class="form-group">
            <label for="condition_cancer_treatmentPhase">Treatment phase</label>
            <select id="condition_cancer_treatmentPhase" name="condition_cancer_treatmentPhase">
                <option value="" {% if cond_cancer.cancerTreatmentPhase == "" %}selected{% endif %}>&mdash;</option>
                <option value="active-treatment" {% if cond_cancer.cancerTreatmentPhase == "active-treatment" %}selected{% endif %}>Active treatment</option>
                <option value="effects-of-cancer" {% if cond_cancer.cancerTreatmentPhase == "effects-of-cancer" %}selected{% endif %}>Effects of cancer</option>
                <option value="effects-of-treatment" {% if cond_cancer.cancerTreatmentPhase == "effects-of-treatment" %}selected{% endif %}>Effects of treatment</option>
                <option value="remission-with-ongoing-treatment" {% if cond_cancer.cancerTreatmentPhase == "remission-with-ongoing-treatment" %}selected{% endif %}>Remission with ongoing treatment</option>
                <option value="palliative" {% if cond_cancer.cancerTreatmentPhase == "palliative" %}selected{% endif %}>Palliative</option>
            </select>
        </div>
        <div class="form-group">
            <label for="condition_cancer_histologyConfirmed">Histology confirmed?</label>
            <select id="condition_cancer_histologyConfirmed" name="condition_cancer_histologyConfirmed">
                <option value="" {% if cond_cancer.histologyConfirmed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if cond_cancer.histologyConfirmed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if cond_cancer.histologyConfirmed == "no" %}selected{% endif %}>No</option>
                <option value="pending" {% if cond_cancer.histologyConfirmed == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
    </div>
</div>
