<div class="card">
    <h2>Step 2: Patient Identification</h2>
    <p class="form-hint">Patient demographics as printed on the FP92A. The NHS number is required for NHSBSA to match the application to the patient record.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patientTitle">Title</label>
            <input type="text" id="patientTitle" name="patientTitle" value="{{ patient.title }}">
        </div>
        <div class="form-group">
            <label for="patientSurname">Surname</label>
            <input type="text" id="patientSurname" name="patientSurname" value="{{ patient.surname }}">
        </div>
        <div class="form-group">
            <label for="patientForenames">Forenames</label>
            <input type="text" id="patientForenames" name="patientForenames" value="{{ patient.forenames }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patientBirthDate">Date of birth</label>
            <input type="date" id="patientBirthDate" name="patientBirthDate" value="{{ patient.birthDate }}">
        </div>
        <div class="form-group">
            <label for="patientSex">Sex</label>
            <select id="patientSex" name="patientSex">
                <option value="" {% if patient.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if patient.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if patient.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if patient.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patientNhsNumber">NHS number</label>
            <input type="text" id="patientNhsNumber" name="patientNhsNumber" value="{{ patient.unitedKingdomNhsNumber }}" placeholder="e.g. 943 476 5919">
        </div>
    </div>

    <div class="form-group">
        <label for="patientAddress">Postal address</label>
        <textarea id="patientAddress" name="patientAddress" rows="2">{{ patient.postalAddressAsFullText }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patientPostcode">Postcode</label>
            <input type="text" id="patientPostcode" name="patientPostcode" value="{{ patient.postcode }}">
        </div>
        <div class="form-group">
            <label for="patientPhone">Phone</label>
            <input type="text" id="patientPhone" name="patientPhone" value="{{ patient.phone }}">
        </div>
        <div class="form-group">
            <label for="patientEmail">Email</label>
            <input type="email" id="patientEmail" name="patientEmail" value="{{ patient.email }}">
        </div>
    </div>
</div>
