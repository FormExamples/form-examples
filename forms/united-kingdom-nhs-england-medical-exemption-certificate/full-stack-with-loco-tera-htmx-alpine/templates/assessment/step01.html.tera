<div class="card">
    <h2>Step 1: Practitioner Identification</h2>
    <p class="form-hint">Only a registered medical practitioner (or a health professional with access to the patient's medical records) may complete the FP92A.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="practitionerName">Practitioner name</label>
            <input type="text" id="practitionerName" name="practitionerName" value="{{ practitioner.name }}">
        </div>
        <div class="form-group">
            <label for="practitionerRole">Role</label>
            <select id="practitionerRole" name="practitionerRole">
                <option value="" {% if practitioner.role == "" %}selected{% endif %}>&mdash;</option>
                <option value="gp" {% if practitioner.role == "gp" %}selected{% endif %}>GP</option>
                <option value="hospital-doctor" {% if practitioner.role == "hospital-doctor" %}selected{% endif %}>Hospital doctor</option>
                <option value="nurse-practitioner" {% if practitioner.role == "nurse-practitioner" %}selected{% endif %}>Nurse practitioner</option>
                <option value="pharmacist-prescriber" {% if practitioner.role == "pharmacist-prescriber" %}selected{% endif %}>Pharmacist prescriber</option>
                <option value="other" {% if practitioner.role == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="practitionerRegistrationBody">Registration body</label>
            <select id="practitionerRegistrationBody" name="practitionerRegistrationBody">
                <option value="" {% if practitioner.registrationBody == "" %}selected{% endif %}>&mdash;</option>
                <option value="GMC" {% if practitioner.registrationBody == "GMC" %}selected{% endif %}>GMC</option>
                <option value="NMC" {% if practitioner.registrationBody == "NMC" %}selected{% endif %}>NMC</option>
                <option value="HCPC" {% if practitioner.registrationBody == "HCPC" %}selected{% endif %}>HCPC</option>
                <option value="GPhC" {% if practitioner.registrationBody == "GPhC" %}selected{% endif %}>GPhC</option>
                <option value="other" {% if practitioner.registrationBody == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="practitionerRegistrationNumber">Registration number</label>
            <input type="text" id="practitionerRegistrationNumber" name="practitionerRegistrationNumber" value="{{ practitioner.registrationNumber }}">
        </div>
        <div class="form-group">
            <label for="practitionerPracticeCode">Practice code</label>
            <input type="text" id="practitionerPracticeCode" name="practitionerPracticeCode" value="{{ practitioner.practiceCode }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="practitionerPracticeName">Practice / surgery name</label>
            <input type="text" id="practitionerPracticeName" name="practitionerPracticeName" value="{{ practitioner.practiceName }}">
        </div>
        <div class="form-group">
            <label for="practitionerPhone">Practice telephone</label>
            <input type="text" id="practitionerPhone" name="practitionerPhone" value="{{ practitioner.phone }}">
        </div>
    </div>

    <div class="form-group">
        <label for="practitionerAddress">Practice address</label>
        <textarea id="practitionerAddress" name="practitionerAddress" rows="2">{{ practitioner.postalAddressAsFullText }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="practitionerPostcode">Postcode</label>
            <input type="text" id="practitionerPostcode" name="practitionerPostcode" value="{{ practitioner.postcode }}">
        </div>
        <div class="form-group">
            <label for="practitionerEmail">Email</label>
            <input type="email" id="practitionerEmail" name="practitionerEmail" value="{{ practitioner.email }}">
        </div>
        <div class="form-group">
            <label for="practitionerCompletedDate">Date of completion</label>
            <input type="date" id="practitionerCompletedDate" name="practitionerCompletedDate" value="{{ practitioner.completedDate }}">
        </div>
    </div>
</div>
