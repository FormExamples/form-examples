#!/bin/sh
set -euf

form_kebab_case=united-kingdom-nhs-england-medical-exemption-certificate
form_snake_case=united_kingdom_nhs_england_medical_exemption_certificate

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    title:text! \
    surname:string! \
    forenames:string! \
    name:string! \
    birth_date:date \
    sex:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    full_time_education:string! \
    pregnancy_status:text! \
    --api

cargo loco generate scaffold practitioner \
    deleted_at:tstz \
    name:string! \
    email:text \
    phone:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    practice_name:string! \
    practice_code:string! \
    practitioner_code:string! \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold eligible_condition \
    deleted_at:tstz \
    code:text!^ \
    label:string! \
    description:text! \
    requires_appliance_detail:string! \
    requires_substitution_therapy_detail:string! \
    requires_disability_attestation:string! \
    requires_cancer_detail:string! \
    excludes_diet_only_diabetes:string! \
    snomed_ct_reference:string! \
    icd10_reference:string! \
    --api

cargo loco generate scaffold application \
    deleted_at:tstz \
    patient:references \
    practitioner:references \
    status:string! \
    application_kind:string! \
    previous_certificate_number:string! \
    previous_certificate_expiry_date:date \
    completed_date:date \
    posted_date:date \
    received_by_nhsbsa_date:date \
    certificate_number:string! \
    valid_from:date \
    valid_until:date \
    practitioner_signature_present:string! \
    practitioner_declaration_text:text! \
    notes:text! \
    --api

cargo loco generate scaffold application_eligible_condition \
    deleted_at:tstz \
    application:references \
    eligible_condition:references \
    diagnosis_date:date \
    snomed_ct_code:string! \
    icd10_code:string! \
    treatment_detail:text! \
    fistula_site:text! \
    appliance_type:text! \
    substitution_therapy:string! \
    on_substitution_therapy:string! \
    diabetes_treatment_mode:text! \
    anticonvulsant:text! \
    continuous_anticonvulsant_therapy:string! \
    cannot_leave_home_unaided:string! \
    disability_carer_detail:text! \
    disability_expected_to_be_permanent:string! \
    cancer_site:string! \
    cancer_treatment_phase:text! \
    histology_confirmed:string! \
    practitioner_attestation_notes:text! \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    application:references \
    outcome:text! \
    redirect_to:text! \
    result_category:text! \
    result_score:double \
    result_notes:text! \
    valid_from:date \
    valid_until:date \
    validity_years:int! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold grade_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    contributing_condition_code:text! \
    --api

cargo loco generate scaffold grade_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    description:text! \
    priority:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"

# Fix two loco-new scaffold defaults that fail clippy -D warnings:
# App::seed()'s unused base param, and the test auth_header() helper's
# redundant &token.
"$(git rev-parse --show-toplevel)/bin/loco-seed-base-rename" "${form_kebab_case}"
"$(git rev-parse --show-toplevel)/bin/loco-test-auth-header-fix" "${form_kebab_case}"
