#!/bin/sh
set -euf

form_kebab_case=padua-venous-thromboembolism-risk-assessment
form_snake_case=padua_venous_thromboembolism_risk_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold padua_venous_thromboembolism_risk_assessment \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    admission_reason:text! \
    patient_identifier:string! \
    age_years:double \
    sex:string! \
    active_cancer:string! \
    previous_vte:string! \
    reduced_mobility:string! \
    known_thrombophilia:string! \
    recent_trauma_or_surgery:string! \
    --api

cargo loco generate scaffold padua_venous_thromboembolism_risk_assessment_grade \
    deleted_at:tstz \
    padua_venous_thromboembolism_risk_assessment:references \
    active_cancer_points:int \
    previous_vte_points:int \
    reduced_mobility_points:int \
    known_thrombophilia_points:int \
    recent_trauma_or_surgery_points:int \
    elderly_age_points:int \
    heart_or_respiratory_failure_points:int \
    acute_mi_or_ischaemic_stroke_points:int \
    acute_infection_or_rheumatological_points:int \
    obesity_points:int \
    ongoing_hormonal_treatment_points:int \
    total_score:int \
    risk_band:string! \
    prophylaxis_recommendation:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold padua_venous_thromboembolism_risk_assessment_grade_rule \
    deleted_at:tstz \
    padua_venous_thromboembolism_risk_assessment_grade:references \
    rule_id:string! \
    factor:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold padua_venous_thromboembolism_risk_assessment_grade_flag \
    deleted_at:tstz \
    padua_venous_thromboembolism_risk_assessment_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
