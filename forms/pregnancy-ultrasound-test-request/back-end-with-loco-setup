#!/bin/sh
set -euf

form_kebab_case=pregnancy-ultrasound-test-request
form_snake_case=pregnancy_ultrasound_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold pregnancy_ultrasound_test_request \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    last_menstrual_period_date:date \
    last_menstrual_period_reliability:string! \
    estimated_due_date:date \
    estimated_due_date_method:string! \
    gestational_age_weeks:int \
    gestational_age_days:int \
    gravida:int \
    para:int \
    plurality:string! \
    chorionicity:string! \
    conception_method:string! \
    rhesus_status:string! \
    body_mass_index:double \
    requested_scan_type:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    previous_scan_finding:string! \
    previous_scan_date:date \
    vaginal_bleeding:string! \
    abdominal_pain:string! \
    reduced_fetal_movements:bool! \
    suspected_ectopic:bool! \
    haemodynamically_unstable:bool! \
    hypertension:bool! \
    diabetes:bool! \
    previous_growth_restriction:bool! \
    previous_preterm_birth:bool! \
    previous_caesarean:bool! \
    smoker:bool! \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    interpreter_required:bool! \
    notes:string! \
    --api

cargo loco generate scaffold pregnancy_ultrasound_test_request_grade \
    deleted_at:tstz \
    pregnancy_ultrasound_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    gestational_age_window_fit:string! \
    recommended_scan_type:string! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold pregnancy_ultrasound_test_request_grade_rule \
    deleted_at:tstz \
    pregnancy_ultrasound_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold pregnancy_ultrasound_test_request_grade_flag \
    deleted_at:tstz \
    pregnancy_ultrasound_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
