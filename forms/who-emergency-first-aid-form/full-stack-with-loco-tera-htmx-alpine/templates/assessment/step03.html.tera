<div class="card">
    <h2>Step 3: Situation</h2>
    <p class="form-hint">Problem type, pregnancy status, and a brief narrative.</p>

    <div class="form-group">
        <label>Problem type (tick all that apply)</label>
        <div class="form-row">
            <label><input type="checkbox" name="situation.medical" value="on" {% if situation.medical %}checked{% endif %}> Medical</label>
            <label><input type="checkbox" name="situation.trauma" value="on" {% if situation.trauma %}checked{% endif %}> Trauma</label>
        </div>
    </div>

    <div class="form-group">
        <label for="pregnant">Pregnant?</label>
        <select id="pregnant" name="situation.pregnant">
            <option value="" {% if situation.pregnant == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if situation.pregnant == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if situation.pregnant == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if situation.pregnant == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="what_happened">What happened to the patient?</label>
        <textarea id="what_happened" name="situation.what_happened"
                  placeholder="Date/time of injury or illness, location, mechanism">{{ situation.whatHappened }}</textarea>
    </div>
</div>
