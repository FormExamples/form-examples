<div class="card">
    <h2>Step 11: Recommendations</h2>
    <p class="form-hint">Transport plan, anticipated problems, other concerns, and precaution flags.</p>

    <div class="form-group">
        <label for="transport_plan">Next steps in transport plan</label>
        <textarea id="transport_plan" name="recommendations.transport_plan">{{ recommendations.transportPlan }}</textarea>
    </div>

    <div class="form-group">
        <label for="problems_anticipated">Any problems anticipated</label>
        <textarea id="problems_anticipated" name="recommendations.problems_anticipated">{{ recommendations.problemsAnticipated }}</textarea>
    </div>

    <div class="form-group">
        <label for="other_concerns">Any other concerns</label>
        <textarea id="other_concerns" name="recommendations.other_concerns">{{ recommendations.otherConcerns }}</textarea>
    </div>

    <h3>Precautions</h3>
    <div class="form-group">
        <label><input type="checkbox" name="recommendations.precautions.highly_infectious_disease" value="on" {% if recommendations.precautions.highlyInfectiousDisease %}checked{% endif %}> Highly infectious disease</label>
        <label><input type="checkbox" name="recommendations.precautions.spinal_immobilization" value="on" {% if recommendations.precautions.spinalImmobilization %}checked{% endif %}> Spinal immobilization</label>
        <label><input type="checkbox" name="recommendations.precautions.possible_fracture" value="on" {% if recommendations.precautions.possibleFracture %}checked{% endif %}> Possible fracture</label>
        <label><input type="checkbox" name="recommendations.precautions.fall_risk" value="on" {% if recommendations.precautions.fallRisk %}checked{% endif %}> Fall risk</label>
        <label><input type="checkbox" name="recommendations.precautions.altered_mental_status" value="on" {% if recommendations.precautions.alteredMentalStatus %}checked{% endif %}> Altered mental status</label>
        <label><input type="checkbox" name="recommendations.precautions.other" value="on" {% if recommendations.precautions.other %}checked{% endif %}> Other</label>
    </div>

    <div class="form-group">
        <label for="precaution_other_details">Other precaution details (required if "Other" ticked)</label>
        <input type="text" id="precaution_other_details" name="recommendations.precautions.other_details"
               value="{{ recommendations.precautions.otherDetails }}">
    </div>
</div>
