<div class="card">
    <h2>Step 1: Patient Identification</h2>
    <p class="form-hint">Patient name, date of birth, age, sex, and contact information.</p>

    <div class="form-group">
        <label for="patient_name">Patient name (LAST, First)</label>
        <input type="text" id="patient_name" name="patient_identification.patient_name"
               value="{{ patient_identification.patientName }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of birth</label>
            <input type="date" id="date_of_birth" name="patient_identification.date_of_birth"
                   value="{{ patient_identification.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="age">Age</label>
            <input type="number" step="any" id="age" name="patient_identification.age"
                   value="{{ patient_identification.age | default(value='') }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="patient_identification.sex">
                <option value="" {% if patient_identification.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="male" {% if patient_identification.sex == "male" %}selected{% endif %}>Male</option>
                <option value="female" {% if patient_identification.sex == "female" %}selected{% endif %}>Female</option>
                <option value="unknown" {% if patient_identification.sex == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="patient_contact_information">Patient contact information</label>
        <input type="text" id="patient_contact_information" name="patient_identification.patient_contact_information"
               value="{{ patient_identification.patientContactInformation }}">
    </div>

    <h3>Patient's contact person</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="contact_person_name">Name</label>
            <input type="text" id="contact_person_name" name="patient_identification.contact_person.name"
                   value="{{ patient_identification.contactPerson.name }}">
        </div>
        <div class="form-group">
            <label for="contact_person_information">Contact information</label>
            <input type="text" id="contact_person_information" name="patient_identification.contact_person.contact_information"
                   value="{{ patient_identification.contactPerson.contactInformation }}">
        </div>
    </div>
</div>
