{% extends "base.html.tera" %}

{% block title %}WHO Emergency First Aid - Wizard{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>WHO Emergency First Aid Form</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit. Each CABCDE step pairs an Assessment ("Normal" or finding text) with an Intervention ("None" or specific actions).</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Patient Identification -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Patient Identification</h2>
      <div style="margin-top:0.6rem;">
        <label>Patient name (LAST, First)</label>
        <input type="text" name="patientName" value="{{ data.patientIdentification.patientName }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Date of birth</label>
          <input type="date" name="dateOfBirth" value="{{ data.patientIdentification.dateOfBirth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Age</label>
          <input type="number" step="any" name="age"
                 value="{{ data.patientIdentification.age | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Sex</label>
          <select name="sex" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""        {% if data.patientIdentification.sex == "" %}selected{% endif %}>-- Select --</option>
            <option value="male"    {% if data.patientIdentification.sex == "male" %}selected{% endif %}>Male</option>
            <option value="female"  {% if data.patientIdentification.sex == "female" %}selected{% endif %}>Female</option>
            <option value="unknown" {% if data.patientIdentification.sex == "unknown" %}selected{% endif %}>Unknown</option>
          </select>
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Patient contact information</label>
        <input type="text" name="patientContactInformation"
               value="{{ data.patientIdentification.patientContactInformation }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <h3 style="margin-top:1rem;">Contact person</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Name</label>
          <input type="text" name="contactPersonName"
                 value="{{ data.patientIdentification.contactPerson.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Contact information</label>
          <input type="text" name="contactPersonContactInformation"
                 value="{{ data.patientIdentification.contactPerson.contactInformation }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 2 — Referral & Transport -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Referral &amp; Transport</h2>
      <h3>Referral facility</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Name</label>
          <input type="text" name="referralFacilityName"
                 value="{{ data.referralTransport.referralFacility.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Focal point</label>
          <input type="text" name="referralFacilityFocalPoint"
                 value="{{ data.referralTransport.referralFacility.focalPoint }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Phone number</label>
          <input type="text" name="referralFacilityPhoneNumber"
                 value="{{ data.referralTransport.referralFacility.phoneNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <h3 style="margin-top:1rem;">Ambulance / transport vehicle</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Name / unit</label>
          <input type="text" name="ambulanceName"
                 value="{{ data.referralTransport.ambulance.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Focal point</label>
          <input type="text" name="ambulanceFocalPoint"
                 value="{{ data.referralTransport.ambulance.focalPoint }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Phone number</label>
          <input type="text" name="ambulancePhoneNumber"
                 value="{{ data.referralTransport.ambulance.phoneNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:220px;">
          <label>Date &amp; time of event</label>
          <input type="datetime-local" name="eventDateTime"
                 value="{{ data.referralTransport.eventDateTime }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:220px;">
          <label>Date &amp; time of departure from scene</label>
          <input type="datetime-local" name="departureDateTime"
                 value="{{ data.referralTransport.departureDateTime }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 3 — Situation -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: Situation</h2>
      <div style="margin-top:0.6rem;">
        <label>Problem type (tick all that apply)</label>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.3rem;">
          <label><input type="checkbox" name="situationMedical" value="on" {% if data.situation.medical %}checked{% endif %}> Medical</label>
          <label><input type="checkbox" name="situationTrauma" value="on" {% if data.situation.trauma %}checked{% endif %}> Trauma</label>
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Pregnant?</label>
        <select name="pregnant" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value=""        {% if data.situation.pregnant == "" %}selected{% endif %}>-- Select --</option>
          <option value="yes"     {% if data.situation.pregnant == "yes" %}selected{% endif %}>Yes</option>
          <option value="no"      {% if data.situation.pregnant == "no" %}selected{% endif %}>No</option>
          <option value="unknown" {% if data.situation.pregnant == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
      </div>
      <div style="margin-top:0.6rem;">
        <label>What happened to the patient?</label>
        <textarea name="whatHappened" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.situation.whatHappened }}</textarea>
      </div>
    </div>

    <!-- Step 4 — Background -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Background</h2>
      <div style="margin-top:0.6rem;">
        <label>Past medical &amp; surgical history (write "None" if none)</label>
        <textarea name="pastMedicalAndSurgicalHistory" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.background.pastMedicalAndSurgicalHistory }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Current medications or allergies (write "None" if none)</label>
        <textarea name="currentMedicationsOrAllergies" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.background.currentMedicationsOrAllergies }}</textarea>
      </div>
    </div>

    <!-- Step 5 — Major Bleeding (C) -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Major Bleeding (C)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="majorBleedingAssessmentNormal" value="on" {% if data.majorBleeding.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="majorBleedingAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.majorBleeding.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="majorBleedingDirectPressure" value="on" {% if data.majorBleeding.interventions.directPressure %}checked{% endif %}> Direct Pressure</label>
        <label><input type="checkbox" name="majorBleedingDeepWoundPacking" value="on" {% if data.majorBleeding.interventions.deepWoundPacking %}checked{% endif %}> Deep Wound Packing</label>
        <label><input type="checkbox" name="majorBleedingTourniquet" value="on" {% if data.majorBleeding.interventions.tourniquet %}checked{% endif %}> Tourniquet (life-threatening only)</label>
        <label><input type="checkbox" name="majorBleedingUterineMassage" value="on" {% if data.majorBleeding.interventions.uterineMassage %}checked{% endif %}> Uterine Massage</label>
        <label><input type="checkbox" name="majorBleedingNone" value="on" {% if data.majorBleeding.interventions.none %}checked{% endif %}> None</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Tourniquet application time (required if tourniquet applied)</label>
        <input type="text" name="majorBleedingTourniquetApplicationTime"
               value="{{ data.majorBleeding.interventions.tourniquetApplicationTime }}"
               placeholder="e.g. 14:32"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 6 — Airway (A) -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Airway (A)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="airwayAssessmentNormal" value="on" {% if data.airway.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="airwayAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.airway.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="airwayNeckImmobilization" value="on" {% if data.airway.interventions.neckImmobilization %}checked{% endif %}> Neck Immobilization</label>
        <label><input type="checkbox" name="airwayHeadTiltChinLift" value="on" {% if data.airway.interventions.headTiltChinLift %}checked{% endif %}> Head-Tilt Chin-Lift</label>
        <label><input type="checkbox" name="airwayJawThrust" value="on" {% if data.airway.interventions.jawThrust %}checked{% endif %}> Jaw Thrust</label>
        <label><input type="checkbox" name="airwayChokingCare" value="on" {% if data.airway.interventions.chokingCare %}checked{% endif %}> Choking Care</label>
        <label><input type="checkbox" name="airwayNone" value="on" {% if data.airway.interventions.none %}checked{% endif %}> None</label>
      </div>
    </div>

    <!-- Step 7 — Breathing (B) -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Breathing (B)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="breathingAssessmentNormal" value="on" {% if data.breathing.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="breathingAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.breathing.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="breathingMaintainedPositionOfComfort" value="on" {% if data.breathing.interventions.maintainedPositionOfComfort %}checked{% endif %}> Maintained position of patient comfort</label>
        <label><input type="checkbox" name="breathingNone" value="on" {% if data.breathing.interventions.none %}checked{% endif %}> None</label>
      </div>
    </div>

    <!-- Step 8 — Circulation (C) -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: Circulation (C)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="circulationAssessmentNormal" value="on" {% if data.circulation.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="circulationAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.circulation.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="circulationPelvicBinder" value="on" {% if data.circulation.interventions.pelvicBinder %}checked{% endif %}> Pelvic Binder</label>
        <label><input type="checkbox" name="circulationControlMinorBleeding" value="on" {% if data.circulation.interventions.controlMinorBleeding %}checked{% endif %}> Control minor bleeding</label>
        <label><input type="checkbox" name="circulationFractureCare" value="on" {% if data.circulation.interventions.fractureCare %}checked{% endif %}> Fracture Care</label>
        <label><input type="checkbox" name="circulationOralHydration" value="on" {% if data.circulation.interventions.oralHydration %}checked{% endif %}> Oral Hydration</label>
        <label><input type="checkbox" name="circulationLeftLateralPosition" value="on" {% if data.circulation.interventions.leftLateralPosition %}checked{% endif %}> Left-lateral position</label>
        <label><input type="checkbox" name="circulationNone" value="on" {% if data.circulation.interventions.none %}checked{% endif %}> None</label>
      </div>
    </div>

    <!-- Step 9 — Disability (D) -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Disability (D)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="disabilityAssessmentNormal" value="on" {% if data.disability.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="disabilityAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.disability.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="disabilitySpinalImmobilisation" value="on" {% if data.disability.interventions.spinalImmobilisation %}checked{% endif %}> Spinal Immobilisation</label>
        <label><input type="checkbox" name="disabilityGlucoseGiven" value="on" {% if data.disability.interventions.glucoseGiven %}checked{% endif %}> Glucose Given</label>
        <label><input type="checkbox" name="disabilitySeizureCare" value="on" {% if data.disability.interventions.seizureCare %}checked{% endif %}> Seizure Care</label>
        <label><input type="checkbox" name="disabilityHighTemperatureCare" value="on" {% if data.disability.interventions.highTemperatureCare %}checked{% endif %}> High Temperature Care</label>
        <label><input type="checkbox" name="disabilityLowTemperatureCare" value="on" {% if data.disability.interventions.lowTemperatureCare %}checked{% endif %}> Low Temperature Care</label>
        <label><input type="checkbox" name="disabilityNone" value="on" {% if data.disability.interventions.none %}checked{% endif %}> None</label>
      </div>
    </div>

    <!-- Step 10 — Exposure / Other (E) -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: Exposure / Other (E)</h2>
      <h3>Assessment</h3>
      <label><input type="checkbox" name="exposureAssessmentNormal" value="on" {% if data.exposure.assessmentNormal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.4rem;">
        <label>Findings (if not normal)</label>
        <textarea name="exposureAssessmentFindings" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposure.assessmentFindings }}</textarea>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="exposureRecoveryPosition" value="on" {% if data.exposure.interventions.recoveryPosition %}checked{% endif %}> Recovery Position</label>
        <label><input type="checkbox" name="exposureBurnCare" value="on" {% if data.exposure.interventions.burnCare %}checked{% endif %}> Burn Care</label>
        <label><input type="checkbox" name="exposureWoundCare" value="on" {% if data.exposure.interventions.woundCare %}checked{% endif %}> Wound Care</label>
        <label><input type="checkbox" name="exposureDrowningCare" value="on" {% if data.exposure.interventions.drowningCare %}checked{% endif %}> Drowning Care</label>
        <label><input type="checkbox" name="exposureSnakebiteCare" value="on" {% if data.exposure.interventions.snakebiteCare %}checked{% endif %}> Snakebite Care</label>
        <label><input type="checkbox" name="exposureNone" value="on" {% if data.exposure.interventions.none %}checked{% endif %}> None</label>
      </div>
      <h3 style="margin-top:1rem;">Any medication taken</h3>
      <label><input type="checkbox" name="medicationTakenNone" value="on" {% if data.exposure.medicationTakenNone %}checked{% endif %}> None</label>
      <div style="margin-top:0.4rem;">
        <label>Details (if medications taken)</label>
        <input type="text" name="medicationTakenDetails"
               value="{{ data.exposure.medicationTakenDetails }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 11 — Recommendations -->
    <div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 11: Recommendations</h2>
      <div style="margin-top:0.6rem;">
        <label>Transport plan (next steps)</label>
        <textarea name="transportPlan" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.recommendations.transportPlan }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Problems anticipated</label>
        <textarea name="problemsAnticipated" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.recommendations.problemsAnticipated }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Other concerns</label>
        <textarea name="otherConcerns" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.recommendations.otherConcerns }}</textarea>
      </div>

      <h3 style="margin-top:1rem;">Precautions</h3>
      <div style="display:flex;flex-direction:column;gap:0.3rem;">
        <label><input type="checkbox" name="highlyInfectiousDisease" value="on" {% if data.recommendations.precautions.highlyInfectiousDisease %}checked{% endif %}> Highly infectious disease</label>
        <label><input type="checkbox" name="precautionsSpinalImmobilization" value="on" {% if data.recommendations.precautions.spinalImmobilization %}checked{% endif %}> Spinal immobilization</label>
        <label><input type="checkbox" name="possibleFracture" value="on" {% if data.recommendations.precautions.possibleFracture %}checked{% endif %}> Possible fracture</label>
        <label><input type="checkbox" name="fallRisk" value="on" {% if data.recommendations.precautions.fallRisk %}checked{% endif %}> Fall risk</label>
        <label><input type="checkbox" name="alteredMentalStatus" value="on" {% if data.recommendations.precautions.alteredMentalStatus %}checked{% endif %}> Altered mental status</label>
        <label><input type="checkbox" name="precautionOther" value="on" {% if data.recommendations.precautions.other %}checked{% endif %}> Other</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Other precaution details (required if "Other" ticked)</label>
        <input type="text" name="precautionOtherDetails"
               value="{{ data.recommendations.precautions.otherDetails }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 12 — Responder Details (CFAR) -->
    <div x-show="step === 12" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 12: Responder Details (CFAR)</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:220px;">
          <label>Responder name</label>
          <input type="text" name="responderName"
                 value="{{ data.responderDetails.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:220px;">
          <label>Signature</label>
          <input type="text" name="responderSignature"
                 value="{{ data.responderDetails.signature }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Contact information</label>
        <input type="text" name="responderContactInformation"
               value="{{ data.responderDetails.contactInformation }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.6rem;">
        <label>CFAR organization</label>
        <input type="text" name="cfarOrganization"
               value="{{ data.responderDetails.cfarOrganization }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;">
      <button type="button" @click="if (step>1) step--"
              :disabled="step === 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        Previous
      </button>

      <template x-if="step < totalSteps">
        <button type="button" @click="step++"
                style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
          Next
        </button>
      </template>

      <template x-if="step === totalSteps">
        <button type="submit"
                style="padding:0.5rem 1.4rem;background:#080;color:#fff;border:none;border-radius:4px;cursor:pointer;">
          Submit
        </button>
      </template>
    </div>
  </form>
</div>
{% endblock %}
