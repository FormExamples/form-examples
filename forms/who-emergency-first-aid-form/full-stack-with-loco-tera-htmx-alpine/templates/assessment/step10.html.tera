<div class="card">
    <h2>Step 10: Exposure / Other (E)</h2>
    <p class="form-hint">Exposure assessment, intervention, and any medication taken.</p>

    <h3>Assessment</h3>
    <label><input type="checkbox" name="exposure.assessment_normal" value="on" {% if exposure.assessmentNormal %}checked{% endif %}> Normal</label>
    <div class="form-group">
        <label for="exposure_assessment_findings">Findings (if not normal)</label>
        <textarea id="exposure_assessment_findings" name="exposure.assessment_findings">{{ exposure.assessmentFindings }}</textarea>
    </div>

    <h3>Interventions</h3>
    <div class="form-group">
        <label><input type="checkbox" name="exposure.interventions.recovery_position" value="on" {% if exposure.interventions.recoveryPosition %}checked{% endif %}> Recovery Position</label>
        <label><input type="checkbox" name="exposure.interventions.burn_care" value="on" {% if exposure.interventions.burnCare %}checked{% endif %}> Burn Care</label>
        <label><input type="checkbox" name="exposure.interventions.wound_care" value="on" {% if exposure.interventions.woundCare %}checked{% endif %}> Wound Care</label>
        <label><input type="checkbox" name="exposure.interventions.drowning_care" value="on" {% if exposure.interventions.drowningCare %}checked{% endif %}> Drowning Care</label>
        <label><input type="checkbox" name="exposure.interventions.snakebite_care" value="on" {% if exposure.interventions.snakebiteCare %}checked{% endif %}> Snakebite Care</label>
        <label><input type="checkbox" name="exposure.interventions.none" value="on" {% if exposure.interventions.none %}checked{% endif %}> None</label>
    </div>

    <h3>Any medication taken?</h3>
    <label><input type="checkbox" name="exposure.medication_taken_none" value="on" {% if exposure.medicationTakenNone %}checked{% endif %}> None</label>
    <div class="form-group">
        <label for="medication_taken_details">Details (if medications taken)</label>
        <input type="text" id="medication_taken_details" name="exposure.medication_taken_details"
               value="{{ exposure.medicationTakenDetails }}">
    </div>
</div>
