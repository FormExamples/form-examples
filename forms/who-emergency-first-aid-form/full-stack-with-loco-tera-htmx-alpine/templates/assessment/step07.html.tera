<div class="card">
    <h2>Step 7: Breathing (B)</h2>
    <p class="form-hint">Breathing assessment and intervention.</p>

    <h3>Assessment</h3>
    <label><input type="checkbox" name="breathing.assessment_normal" value="on" {% if breathing.assessmentNormal %}checked{% endif %}> Normal</label>
    <div class="form-group">
        <label for="breathing_assessment_findings">Findings (if not normal)</label>
        <textarea id="breathing_assessment_findings" name="breathing.assessment_findings">{{ breathing.assessmentFindings }}</textarea>
    </div>

    <h3>Interventions</h3>
    <div class="form-group">
        <label><input type="checkbox" name="breathing.interventions.maintained_position_of_comfort" value="on" {% if breathing.interventions.maintainedPositionOfComfort %}checked{% endif %}> Maintained position of patient comfort</label>
        <label><input type="checkbox" name="breathing.interventions.none" value="on" {% if breathing.interventions.none %}checked{% endif %}> None</label>
    </div>
</div>
