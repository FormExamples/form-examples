<div class="card">
    <h2>Step 9: Disability (D)</h2>
    <p class="form-hint">Neurological assessment and intervention.</p>

    <h3>Assessment</h3>
    <label><input type="checkbox" name="disability.assessment_normal" value="on" {% if disability.assessmentNormal %}checked{% endif %}> Normal</label>
    <div class="form-group">
        <label for="disability_assessment_findings">Findings (if not normal)</label>
        <textarea id="disability_assessment_findings" name="disability.assessment_findings">{{ disability.assessmentFindings }}</textarea>
    </div>

    <h3>Interventions</h3>
    <div class="form-group">
        <label><input type="checkbox" name="disability.interventions.spinal_immobilisation" value="on" {% if disability.interventions.spinalImmobilisation %}checked{% endif %}> Spinal Immobilisation</label>
        <label><input type="checkbox" name="disability.interventions.glucose_given" value="on" {% if disability.interventions.glucoseGiven %}checked{% endif %}> Glucose Given</label>
        <label><input type="checkbox" name="disability.interventions.seizure_care" value="on" {% if disability.interventions.seizureCare %}checked{% endif %}> Seizure Care</label>
        <label><input type="checkbox" name="disability.interventions.high_temperature_care" value="on" {% if disability.interventions.highTemperatureCare %}checked{% endif %}> High Temperature Care</label>
        <label><input type="checkbox" name="disability.interventions.low_temperature_care" value="on" {% if disability.interventions.lowTemperatureCare %}checked{% endif %}> Low Temperature Care</label>
        <label><input type="checkbox" name="disability.interventions.none" value="on" {% if disability.interventions.none %}checked{% endif %}> None</label>
    </div>
</div>
