<div class="card">
    <h2>Step 4: Background</h2>
    <p class="form-hint">Past medical and surgical history, current medications, and allergies.</p>

    <div class="form-group">
        <label for="past_medical_and_surgical_history">Past medical &amp; surgical history (write "None" if none)</label>
        <textarea id="past_medical_and_surgical_history" name="background.past_medical_and_surgical_history">{{ background.pastMedicalAndSurgicalHistory }}</textarea>
    </div>

    <div class="form-group">
        <label for="current_medications_or_allergies">Current medications or allergies (write "None" if none)</label>
        <textarea id="current_medications_or_allergies" name="background.current_medications_or_allergies">{{ background.currentMedicationsOrAllergies }}</textarea>
    </div>
</div>
