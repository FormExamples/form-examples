{% extends "base.html.tera" %}

{% block title %}WHO Emergency First Aid Form - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>WHO Emergency First Aid Form</h1>
        <p class="landing-description">
            Standardised emergency first aid documentation form from the World Health
            Organization for <strong>Community First Aid Responders (CFAR)</strong>.
            Captures patient identification, referral and transport, situation,
            background, and a systematic <strong>CABCDE</strong> assessment with
            paired interventions, plus recommendations and responder identification.
            A copy of the completed form should be sent to the referral facility.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>12 Steps</h3>
                <p>Patient ID, Referral &amp; Transport, Situation, Background, CABCDE (Major Bleeding, Airway, Breathing, Circulation, Disability, Exposure), Recommendations, Responder.</p>
            </div>
            <div class="feature">
                <h3>CABCDE Framework</h3>
                <p>Each CABCDE step pairs an Assessment ("Normal" or finding text) with an Intervention ("None" or specific actions).</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Tourniquet without time, abnormal airway without intervention, pregnancy, infectious disease, spinal immobilization, altered mental status, and more are escalated.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New First Aid Form
            </button>
        </form>
    </div>
</div>
{% endblock %}
