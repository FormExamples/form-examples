{% extends "base.html.tera" %}

{% block title %}WHO Emergency First Aid Form{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>WHO Emergency First Aid Form</h1>
  <p>
    Standardised emergency first aid documentation form from the World Health
    Organization for Community First Aid Responders (CFAR). Captures patient
    identification, referral and transport, situation, background, and a
    systematic CABCDE assessment with paired interventions, plus
    recommendations and responder identification.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>12 Steps</h3>
      <p>Patient ID, Referral &amp; Transport, Situation, Background, Major Bleeding (C), Airway (A), Breathing (B), Circulation (C), Disability (D), Exposure (E), Recommendations, Responder.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>CABCDE Framework</h3>
      <p>Each CABCDE step pairs an Assessment ("Normal" or finding text) with an Intervention ("None" or specific actions).</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Major bleeding without intervention, tourniquet without time, abnormal airway findings, infectious disease, spinal immobilization, and altered mental status escalate for clinician review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New First Aid Form
    </button>
  </form>
</div>
{% endblock %}
