{% extends "base.html.tera" %}

{% block title %}First Aid Report{% endblock %}

{% block content %}
<div class="report-header">
    <h1>WHO Emergency First Aid Form &mdash; Encounter Report</h1>
    {% if result.validation.complete %}
        <div class="checklist-badge checklist-complete">Complete</div>
    {% else %}
        <div class="checklist-badge checklist-incomplete">Incomplete &mdash; {{ result.validation.totalSatisfied }} / {{ result.validation.totalRequired }}</div>
    {% endif %}
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.patientIdentification.patientName }}<br>
            <strong>Date of Birth:</strong> {{ data.patientIdentification.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.patientIdentification.sex }}<br>
            <strong>Contact:</strong> {{ data.patientIdentification.patientContactInformation }}
        </div>
        <div>
            <strong>Referral Facility:</strong> {{ data.referralTransport.referralFacility.name }}<br>
            <strong>Event:</strong> {{ data.referralTransport.eventDateTime }}<br>
            <strong>Departure:</strong> {{ data.referralTransport.departureDateTime }}<br>
            <strong>Responder:</strong> {{ data.responderDetails.name }} ({{ data.responderDetails.cfarOrganization }})
        </div>
    </div>
</div>

<!-- Per-Section Completeness -->
<div class="card">
    <h2>Section Completeness</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Section</th>
                <th>Required</th>
                <th>Satisfied</th>
                <th>Missing</th>
            </tr>
        </thead>
        <tbody>
            {% for s in result.validation.sections %}
            <tr>
                <td>{{ s.sectionLabel }}</td>
                <td>{{ s.required }}</td>
                <td>{{ s.satisfied }}</td>
                <td>{{ s.missing | length }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Flagged Issues -->
{% if result.flaggedIssues | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ result.flaggedIssues | length }})</h2>
    <div class="flags-section">
        {% for flag in result.flaggedIssues %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
            <span class="flag-id">{{ flag.id }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Missing items -->
{% if result.validation.missing | length > 0 %}
<div class="card">
    <h2>Missing Items ({{ result.validation.missing | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Section</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for m in result.validation.missing %}
            <tr>
                <td><code>{{ m.id }}</code></td>
                <td>{{ m.section }}</td>
                <td>{{ m.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New First Aid Form</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <a href="/assessment/{{ id }}" class="btn btn-secondary" style="margin-left: 1rem;">Edit Assessment</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
