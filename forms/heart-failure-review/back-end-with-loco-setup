#!/bin/sh
set -euf

form_kebab_case=heart-failure-review
form_snake_case=heart_failure_review

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold heart_failure_review \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    review_date:date \
    care_setting:string! \
    review_type:string! \
    last_review_date:date \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    year_of_diagnosis:int \
    heart_failure_type:string! \
    latest_lvef:double \
    last_echo_date:date \
    aetiology:string! \
    nyha_class:int \
    breathlessness:string! \
    orthopnoea:string! \
    paroxysmal_nocturnal_dyspnoea:string! \
    fatigue:string! \
    change_since_last_review:string! \
    decompensation:string! \
    weight_kg:double \
    weight_change_kg:double \
    peripheral_oedema:string! \
    raised_jvp:string! \
    lung_crackles:string! \
    systolic_blood_pressure:int \
    diastolic_blood_pressure:int \
    heart_rate:int \
    heart_rhythm:string! \
    nt_pro_bnp:double \
    sodium:double \
    potassium:double \
    urea:double \
    creatinine:double \
    egfr:double \
    haemoglobin:double \
    ferritin:double \
    transferrin_saturation:double \
    hba1c:double \
    bloods_date:date \
    raas_inhibitor_status:string! \
    raas_inhibitor_agent:string! \
    raas_inhibitor_dose:string! \
    raas_inhibitor_at_target_dose:string! \
    raas_inhibitor_adherence:string! \
    beta_blocker_status:string! \
    beta_blocker_agent:string! \
    beta_blocker_dose:string! \
    beta_blocker_at_target_dose:string! \
    beta_blocker_adherence:string! \
    mra_status:string! \
    mra_agent:string! \
    mra_dose:string! \
    mra_at_target_dose:string! \
    mra_adherence:string! \
    sglt2_inhibitor_status:string! \
    sglt2_inhibitor_agent:string! \
    sglt2_inhibitor_dose:string! \
    sglt2_inhibitor_at_target_dose:string! \
    sglt2_inhibitor_adherence:string! \
    loop_diuretic_agent:string! \
    loop_diuretic_dose:string! \
    other_medications:text! \
    icd:string! \
    crt:string! \
    pacemaker:string! \
    device_check_status:string! \
    influenza_vaccination:string! \
    pneumococcal_vaccination:string! \
    covid_vaccination:string! \
    smoking_status:string! \
    alcohol_status:string! \
    daily_weights:string! \
    self_management_plan:string! \
    cardiac_rehab:string! \
    review_context:text! \
    --api

cargo loco generate scaffold heart_failure_review_grade \
    deleted_at:tstz \
    heart_failure_review:references \
    nyha_status:string! \
    medication_optimisation_status:string! \
    review_status:string! \
    indicated_pillars:int \
    prescribed_pillars:int \
    missing_pillars:string! \
    completeness_score:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold heart_failure_review_grade_rule \
    deleted_at:tstz \
    heart_failure_review_grade:references \
    rule_id:string! \
    section:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold heart_failure_review_grade_flag \
    deleted_at:tstz \
    heart_failure_review_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
