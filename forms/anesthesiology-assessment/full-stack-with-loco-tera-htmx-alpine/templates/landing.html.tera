{% extends "base.html.tera" %}

{% block title %}Anesthesiology Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Anesthesiology Assessment</h1>
        <p class="landing-description">
            UK NHS-aligned pre-operative anesthesiology assessment combining four
            validated scoring systems &mdash; <strong>ASA Physical Status
            Classification</strong>, <strong>Mallampati / Airway Score</strong>,
            <strong>Revised Cardiac Risk Index (RCRI / Lee Index)</strong>, and
            <strong>STOP-BANG (OSA screening)</strong> &mdash; into a composite
            perioperative risk level, with flagged safety-critical issues and an
            anaesthetic plan.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Four Validated Instruments</h3>
                <p>ASA I-VI, Mallampati I-IV, RCRI 0-6, STOP-BANG 0-8 &mdash; composed into a Low / Moderate / High / Critical perioperative risk band</p>
            </div>
            <div class="feature">
                <h3>Ten-Step Single-Page Wizard</h3>
                <p>Demographics &rarr; surgery &rarr; history &rarr; medications &rarr; allergies &rarr; previous anaesthesia &rarr; airway &rarr; vitals &rarr; scoring &rarr; plan</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Anaphylaxis, MH risk, anticoagulants, difficult airway, GORD, pregnancy, hypoxia, morbid obesity, uncontrolled hypertension</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
