<div class="card">
    <h2>Step 3: Medical History</h2>
    <p class="form-hint">System-by-system review. Select <em>Yes</em> for any active or significant past condition.</p>

    <h3>Cardiovascular</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="hypertension">Hypertension</label>
            <select id="hypertension" name="medical_history.hypertension">
                <option value="" {% if medical_history.hypertension == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.hypertension == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.hypertension == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ischaemic_heart_disease">Ischaemic Heart Disease</label>
            <select id="ischaemic_heart_disease" name="medical_history.ischaemic_heart_disease">
                <option value="" {% if medical_history.ischaemicHeartDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.ischaemicHeartDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.ischaemicHeartDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="heart_failure">Heart Failure</label>
            <select id="heart_failure" name="medical_history.heart_failure">
                <option value="" {% if medical_history.heartFailure == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.heartFailure == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.heartFailure == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <h3>Respiratory</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="asthma">Asthma</label>
            <select id="asthma" name="medical_history.asthma">
                <option value="" {% if medical_history.asthma == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.asthma == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.asthma == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="copd">COPD</label>
            <select id="copd" name="medical_history.copd">
                <option value="" {% if medical_history.copd == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.copd == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.copd == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sleep_apnea">Sleep Apnea</label>
            <select id="sleep_apnea" name="medical_history.sleep_apnea">
                <option value="" {% if medical_history.sleepApnea == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.sleepApnea == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.sleepApnea == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <h3>Gastrointestinal &amp; Endocrine</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="gord">GORD</label>
            <select id="gord" name="medical_history.gord">
                <option value="" {% if medical_history.gord == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.gord == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.gord == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="diabetes_type1">Diabetes Type 1</label>
            <select id="diabetes_type1" name="medical_history.diabetes_type1">
                <option value="" {% if medical_history.diabetesType1 == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.diabetesType1 == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.diabetesType1 == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="diabetes_type2">Diabetes Type 2</label>
            <select id="diabetes_type2" name="medical_history.diabetes_type2">
                <option value="" {% if medical_history.diabetesType2 == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_history.diabetesType2 == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_history.diabetesType2 == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_details">Other significant medical history</label>
        <textarea id="other_details" name="medical_history.other_details">{{ medical_history.otherDetails }}</textarea>
    </div>
</div>
