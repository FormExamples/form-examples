<div class="card">
    <h2>Step 10: Anaesthetic Plan &amp; Consent</h2>

    <div class="form-group">
        <label for="proposed_technique">Proposed Anaesthetic Technique</label>
        <textarea id="proposed_technique" name="investigations_and_plan.proposed_technique">{{ investigations_and_plan.proposedTechnique }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="airway_plan">Airway Plan</label>
            <select id="airway_plan" name="investigations_and_plan.airway_plan">
                <option value="" {% if investigations_and_plan.airwayPlan == "" %}selected{% endif %}>&mdash;</option>
                <option value="facemask" {% if investigations_and_plan.airwayPlan == "facemask" %}selected{% endif %}>Facemask</option>
                <option value="lma" {% if investigations_and_plan.airwayPlan == "lma" %}selected{% endif %}>LMA</option>
                <option value="ett" {% if investigations_and_plan.airwayPlan == "ett" %}selected{% endif %}>Endotracheal Tube</option>
                <option value="awake-fibreoptic" {% if investigations_and_plan.airwayPlan == "awake-fibreoptic" %}selected{% endif %}>Awake Fibreoptic</option>
                <option value="other" {% if investigations_and_plan.airwayPlan == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="post_op_destination">Post-Op Destination</label>
            <select id="post_op_destination" name="investigations_and_plan.post_op_destination">
                <option value="" {% if investigations_and_plan.postOpDestination == "" %}selected{% endif %}>&mdash;</option>
                <option value="ward" {% if investigations_and_plan.postOpDestination == "ward" %}selected{% endif %}>Ward</option>
                <option value="hdu" {% if investigations_and_plan.postOpDestination == "hdu" %}selected{% endif %}>HDU</option>
                <option value="icu" {% if investigations_and_plan.postOpDestination == "icu" %}selected{% endif %}>ICU</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="special_requirements">Special Requirements / Notes</label>
        <textarea id="special_requirements" name="investigations_and_plan.special_requirements">{{ investigations_and_plan.specialRequirements }}</textarea>
    </div>
</div>
