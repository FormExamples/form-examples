<div class="card">
    <h2>Step 7: Airway &amp; Physical Examination</h2>
    <p class="form-hint">Mallampati class, mouth opening, thyromental distance, neck mobility, dentition.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="mallampati_class">Mallampati Class</label>
            <select id="mallampati_class" name="physical_exam.mallampati_class">
                <option value="" {% if physical_exam.mallampatiClass == "" %}selected{% endif %}>&mdash;</option>
                <option value="i" {% if physical_exam.mallampatiClass == "i" %}selected{% endif %}>I &mdash; soft palate, uvula, pillars</option>
                <option value="ii" {% if physical_exam.mallampatiClass == "ii" %}selected{% endif %}>II &mdash; soft palate, partial uvula</option>
                <option value="iii" {% if physical_exam.mallampatiClass == "iii" %}selected{% endif %}>III &mdash; soft palate, base of uvula</option>
                <option value="iv" {% if physical_exam.mallampatiClass == "iv" %}selected{% endif %}>IV &mdash; hard palate only</option>
            </select>
        </div>
        <div class="form-group">
            <label for="neck_mobility">Neck Mobility</label>
            <select id="neck_mobility" name="physical_exam.neck_mobility">
                <option value="" {% if physical_exam.neckMobility == "" %}selected{% endif %}>&mdash;</option>
                <option value="full" {% if physical_exam.neckMobility == "full" %}selected{% endif %}>Full</option>
                <option value="limited" {% if physical_exam.neckMobility == "limited" %}selected{% endif %}>Limited</option>
                <option value="fixed" {% if physical_exam.neckMobility == "fixed" %}selected{% endif %}>Fixed</option>
            </select>
        </div>
        <div class="form-group">
            <label for="jaw_protrusion">Jaw Protrusion</label>
            <select id="jaw_protrusion" name="physical_exam.jaw_protrusion">
                <option value="" {% if physical_exam.jawProtrusion == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if physical_exam.jawProtrusion == "normal" %}selected{% endif %}>Normal</option>
                <option value="limited" {% if physical_exam.jawProtrusion == "limited" %}selected{% endif %}>Limited</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="mouth_opening">Mouth opening (cm)</label>
            <input type="number" step="0.1" id="mouth_opening" name="physical_exam.mouth_opening"
                   value="{{ physical_exam.mouthOpening }}">
        </div>
        <div class="form-group">
            <label for="thyromental_distance">Thyromental distance (cm)</label>
            <input type="number" step="0.1" id="thyromental_distance" name="physical_exam.thyromental_distance"
                   value="{{ physical_exam.thyromentalDistance }}">
        </div>
    </div>

    <h3>Social History &amp; STOP-BANG Subjective Items</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="snores_loudly">Snores loudly?</label>
            <select id="snores_loudly" name="social_history.snores_loudly">
                <option value="" {% if social_history.snoresLoudly == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_history.snoresLoudly == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_history.snoresLoudly == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tired_during_day">Tired during the day?</label>
            <select id="tired_during_day" name="social_history.tired_during_day">
                <option value="" {% if social_history.tiredDuringDay == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_history.tiredDuringDay == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_history.tiredDuringDay == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="observed_apnea">Observed apnea?</label>
            <select id="observed_apnea" name="social_history.observed_apnea">
                <option value="" {% if social_history.observedApnea == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if social_history.observedApnea == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if social_history.observedApnea == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
