<div class="card">
    <h2>Step 2: Planned Surgery &amp; Proposed Anaesthesia</h2>

    <div class="form-group">
        <label for="procedure_name">Procedure</label>
        <input type="text" id="procedure_name" name="planned_surgery.procedure_name"
               value="{{ planned_surgery.procedureName }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="surgeon_name">Surgeon</label>
            <input type="text" id="surgeon_name" name="planned_surgery.surgeon_name"
                   value="{{ planned_surgery.surgeonName }}">
        </div>
        <div class="form-group">
            <label for="surgery_date">Surgery Date</label>
            <input type="date" id="surgery_date" name="planned_surgery.surgery_date"
                   value="{{ planned_surgery.surgeryDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="surgery_grade">Surgery Grade</label>
            <select id="surgery_grade" name="planned_surgery.surgery_grade">
                <option value="" {% if planned_surgery.surgeryGrade == "" %}selected{% endif %}>&mdash;</option>
                <option value="minor" {% if planned_surgery.surgeryGrade == "minor" %}selected{% endif %}>Minor</option>
                <option value="intermediate" {% if planned_surgery.surgeryGrade == "intermediate" %}selected{% endif %}>Intermediate</option>
                <option value="major" {% if planned_surgery.surgeryGrade == "major" %}selected{% endif %}>Major</option>
                <option value="complex" {% if planned_surgery.surgeryGrade == "complex" %}selected{% endif %}>Complex</option>
            </select>
        </div>
        <div class="form-group">
            <label for="proposed_anaesthesia">Proposed Anaesthesia</label>
            <select id="proposed_anaesthesia" name="planned_surgery.proposed_anaesthesia">
                <option value="" {% if planned_surgery.proposedAnaesthesia == "" %}selected{% endif %}>&mdash;</option>
                <option value="general" {% if planned_surgery.proposedAnaesthesia == "general" %}selected{% endif %}>General</option>
                <option value="regional" {% if planned_surgery.proposedAnaesthesia == "regional" %}selected{% endif %}>Regional</option>
                <option value="sedation" {% if planned_surgery.proposedAnaesthesia == "sedation" %}selected{% endif %}>Sedation</option>
                <option value="local" {% if planned_surgery.proposedAnaesthesia == "local" %}selected{% endif %}>Local</option>
                <option value="combined" {% if planned_surgery.proposedAnaesthesia == "combined" %}selected{% endif %}>Combined</option>
            </select>
        </div>
    </div>
</div>
