{% extends "base.html.tera" %}

{% block title %}Anesthesiology Assessment - Report ({{ overall_risk_label }}){% endblock %}

{% block content %}
<div class="report-header">
    <h1>Anesthesiology Assessment &mdash; Report</h1>
    <div class="risk-badge risk-{{ overall_risk }}">{{ overall_risk_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>NHS Number:</strong> {{ data.demographics.nhsNumber }}
        </div>
        <div>
            <strong>Procedure:</strong> {{ data.plannedSurgery.procedureName }}<br>
            <strong>Surgeon:</strong> {{ data.plannedSurgery.surgeonName }}<br>
            <strong>Surgery Date:</strong> {{ data.plannedSurgery.surgeryDate }}<br>
            <strong>Surgery Grade:</strong> {{ data.plannedSurgery.surgeryGrade }}<br>
            <strong>Proposed Anaesthesia:</strong> {{ data.plannedSurgery.proposedAnaesthesia }}
        </div>
    </div>
</div>

<!-- Composite Score Summary -->
<div class="card">
    <h2>Composite Score Summary</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Instrument</th>
                <th>Result</th>
                <th>Risk Level</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>ASA Physical Status</td>
                <td>{{ asa.class | upper }}{% if asa.emergency %}E{% endif %}</td>
                <td><span class="risk-badge risk-{{ asa.riskLevel }}">{{ asa.riskLevel }}</span></td>
            </tr>
            <tr>
                <td>Mallampati / Airway</td>
                <td>Class {{ airway.mallampatiClass | upper }} &mdash; {{ airway.mediumFactors }} medium factor(s)</td>
                <td><span class="risk-badge risk-{{ airway.riskLevel }}">{{ airway.riskLevel }}</span></td>
            </tr>
            <tr>
                <td>RCRI (Lee Index)</td>
                <td>Score {{ rcri.score }} &mdash; MACE risk {{ rcri.macePercent }}%</td>
                <td><span class="risk-badge risk-{{ rcri.riskLevel }}">{{ rcri.riskLevel }}</span></td>
            </tr>
            <tr>
                <td>STOP-BANG (OSA)</td>
                <td>Score {{ stopbang.score }}</td>
                <td><span class="risk-badge risk-{{ stopbang.riskLevel }}">{{ stopbang.riskLevel }}</span></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Audit Trail ({{ fired_rules | length }} fired rule{% if fired_rules | length != 1 %}s{% endif %})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Risk Level</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="risk-badge risk-{{ rule.riskLevel }}">{{ rule.riskLevel }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Anaesthetic Plan -->
<div class="card">
    <h2>Anaesthetic Plan</h2>
    <div>
        <strong>Proposed Technique:</strong> {{ data.investigationsAndPlan.proposedTechnique }}<br>
        <strong>Airway Plan:</strong> {{ data.investigationsAndPlan.airwayPlan }}<br>
        <strong>Post-Op Destination:</strong> {{ data.investigationsAndPlan.postOpDestination }}<br>
        <strong>Special Requirements:</strong> {{ data.investigationsAndPlan.specialRequirements }}
    </div>
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
