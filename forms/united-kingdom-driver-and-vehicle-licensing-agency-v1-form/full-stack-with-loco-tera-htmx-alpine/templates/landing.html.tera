{% extends "base.html.tera" %}

{% block title %}DVLA V1 — Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>DVLA V1 — Confidential Medical Information (Vision)</h1>
        <p class="landing-description">
            Digital companion to the UK Driver and Vehicle Licensing Agency's
            <strong>Form V1</strong> (vision self-declaration, September 2025
            revision). Collects personal details, healthcare-professional
            information, and a fourteen-step vision questionnaire covering
            eyesight standards, monocular vision, visual field, glaucoma,
            retinitis pigmentosa, laser treatment, blepharospasm, night
            blindness, double vision, other conditions, recent contact, and
            the applicant's authorisation.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>14-Step Wizard</h3>
                <p>One continuous single-page wizard from personal details through the applicant authorisation.</p>
            </div>
            <div class="feature">
                <h3>Branch-Aware Validation</h3>
                <p>Conditional rules guard dormant branches automatically &mdash; only the active questions count.</p>
            </div>
            <div class="feature">
                <h3>Clinical Flagging</h3>
                <p>Urgent, high, medium and low-priority flags for eyesight failure, monocular vision, diplopia, glaucoma, and more.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New DVLA V1 Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
