{% extends "base.html.tera" %}

{% block title %}DVLA V1 — Confidential Medical Information (Vision){% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>DVLA V1 — General Confidential Medical Information (Vision)</h1>
  <p>
    Vision self-declaration questionnaire for the UK Driver and Vehicle
    Licensing Agency. Captures personal details, healthcare professional
    contacts, and answers to vision questions Q1–Q11 (eyesight standards,
    monocular vision, visual field, glaucoma, retinitis pigmentosa, laser
    treatment, blepharospasm, night blindness, double vision, other vision
    conditions, recent contact) plus the applicant's authorisation.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>14 Steps</h3>
      <p>Personal Details, Healthcare Professionals, Q1–Q11, and Authorisation.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Completeness</h3>
      <p>40 validation rules with conditional <em>applies</em> predicates check the form for missing answers across the active branches.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Eyesight standard failure, monocular vision, uncontrolled diplopia, glaucoma, and other clinically significant items escalate for clinician review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New Assessment
    </button>
  </form>
</div>
{% endblock %}
