<div class="card" x-data="{ rc: '{{ recent_contact.hadContact }}' }">
    <h2>Step 13: Q11 — Recent Contact with Healthcare Professional</h2>
    <p class="form-hint">
        Have you had any contact (telephone, video, or face-to-face) with your healthcare
        professional or optician/optometrist about your vision condition in the last 12 months?
    </p>

    <div class="form-group">
        <label for="rc_had">Recent contact?</label>
        <select id="rc_had" name="recent_contact.had_contact" x-model="rc">
            <option value="" {% if recent_contact.hadContact == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if recent_contact.hadContact == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if recent_contact.hadContact == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group" x-show="rc === 'yes'" x-cloak>
        <label for="rc_date">Date of contact</label>
        <input type="date" id="rc_date" name="recent_contact.date_of_contact"
               value="{{ recent_contact.dateOfContact }}">
    </div>
</div>
