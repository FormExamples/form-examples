<div class="card">
    <h2>Step 14: Applicant's Authorisation</h2>
    <p class="form-hint">
        DVLA may require medical examination and/or a practical assessment. Only fitness-to-drive-relevant
        medical information is shared. You authorise your healthcare professional(s) to disclose
        relevant medical information to DVLA on behalf of the Secretary of State for Transport.
        It is a criminal offence to make a false declaration to obtain a driving licence.
    </p>

    <div class="form-group">
        <label>
            <input type="checkbox" name="authorisation.declaration_confirmed"
                   value="true" {% if authorisation.declarationConfirmed %}checked{% endif %}>
            I confirm the applicant authorisation declaration.
        </label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="auth_name">Name</label>
            <input type="text" id="auth_name" name="authorisation.name"
                   value="{{ authorisation.name }}">
        </div>
        <div class="form-group">
            <label for="auth_signature">Signature (typed name)</label>
            <input type="text" id="auth_signature" name="authorisation.signature"
                   value="{{ authorisation.signature }}">
        </div>
        <div class="form-group">
            <label for="auth_date">Date</label>
            <input type="date" id="auth_date" name="authorisation.date"
                   value="{{ authorisation.date }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="auth_electronic">Authorise electronic correspondence (email)?</label>
            <select id="auth_electronic" name="authorisation.authorise_electronic_correspondence">
                <option value="" {% if authorisation.authoriseElectronicCorrespondence == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if authorisation.authoriseElectronicCorrespondence == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if authorisation.authoriseElectronicCorrespondence == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="auth_pref_hcp">Contact preference (from healthcare professional)</label>
            <select id="auth_pref_hcp" name="authorisation.contact_preference_from_healthcare_professional">
                <option value="" {% if authorisation.contactPreferenceFromHealthcareProfessional == "" %}selected{% endif %}>&mdash;</option>
                <option value="email" {% if authorisation.contactPreferenceFromHealthcareProfessional == "email" %}selected{% endif %}>Email</option>
                <option value="sms" {% if authorisation.contactPreferenceFromHealthcareProfessional == "sms" %}selected{% endif %}>SMS (text)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="auth_pref_dvla">Contact preference (from DVLA)</label>
            <select id="auth_pref_dvla" name="authorisation.contact_preference_from_dvla">
                <option value="" {% if authorisation.contactPreferenceFromDvla == "" %}selected{% endif %}>&mdash;</option>
                <option value="email" {% if authorisation.contactPreferenceFromDvla == "email" %}selected{% endif %}>Email</option>
                <option value="sms" {% if authorisation.contactPreferenceFromDvla == "sms" %}selected{% endif %}>SMS (text)</option>
            </select>
        </div>
    </div>
</div>
