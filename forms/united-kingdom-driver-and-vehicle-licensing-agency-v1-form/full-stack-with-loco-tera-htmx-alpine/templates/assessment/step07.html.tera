<div class="card" x-data="{ rp: '{{ retinitis_pigmentosa.hasCondition }}' }">
    <h2>Step 7: Q5 — Retinitis Pigmentosa</h2>
    <p class="form-hint">Have you been diagnosed with retinitis pigmentosa (a progressive inherited retinal condition)?</p>

    <div class="form-group">
        <label for="rp_has">Retinitis pigmentosa?</label>
        <select id="rp_has" name="retinitis_pigmentosa.has_condition" x-model="rp">
            <option value="" {% if retinitis_pigmentosa.hasCondition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if retinitis_pigmentosa.hasCondition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if retinitis_pigmentosa.hasCondition == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div x-show="rp === 'yes'" x-cloak>
        <div class="form-group">
            <label for="rp_which_eyes">Which eye(s)?</label>
            <select id="rp_which_eyes" name="retinitis_pigmentosa.which_eyes">
                <option value="" {% if retinitis_pigmentosa.whichEyes == "" %}selected{% endif %}>&mdash;</option>
                <option value="both" {% if retinitis_pigmentosa.whichEyes == "both" %}selected{% endif %}>Both eyes</option>
                <option value="left" {% if retinitis_pigmentosa.whichEyes == "left" %}selected{% endif %}>Left eye</option>
                <option value="right" {% if retinitis_pigmentosa.whichEyes == "right" %}selected{% endif %}>Right eye</option>
            </select>
        </div>
    </div>
</div>
