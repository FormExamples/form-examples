<div class="card"
     x-data="{ dv: '{{ double_vision.hasCondition }}', ctrl: '{{ double_vision.controlled }}' }">
    <h2>Step 11: Q9 — Double Vision (Diplopia)</h2>
    <p class="form-hint">Have you been diagnosed with double vision?</p>

    <div class="form-group">
        <label for="dv_has">Double vision?</label>
        <select id="dv_has" name="double_vision.has_condition" x-model="dv">
            <option value="" {% if double_vision.hasCondition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if double_vision.hasCondition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if double_vision.hasCondition == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div x-show="dv === 'yes'" x-cloak>
        <div class="form-row">
            <div class="form-group">
                <label for="dv_controlled">Is it controlled?</label>
                <select id="dv_controlled" name="double_vision.controlled" x-model="ctrl">
                    <option value="" {% if double_vision.controlled == "" %}selected{% endif %}>&mdash;</option>
                    <option value="yes" {% if double_vision.controlled == "yes" %}selected{% endif %}>Yes</option>
                    <option value="no" {% if double_vision.controlled == "no" %}selected{% endif %}>No</option>
                </select>
            </div>
            <div class="form-group" x-show="ctrl === 'no'" x-cloak>
                <label for="dv_six_months">Has it been the same for 6 months or more?</label>
                <select id="dv_six_months" name="double_vision.same_for_six_months_or_more">
                    <option value="" {% if double_vision.sameForSixMonthsOrMore == "" %}selected{% endif %}>&mdash;</option>
                    <option value="yes" {% if double_vision.sameForSixMonthsOrMore == "yes" %}selected{% endif %}>Yes</option>
                    <option value="no" {% if double_vision.sameForSixMonthsOrMore == "no" %}selected{% endif %}>No</option>
                </select>
            </div>
        </div>

        <p class="form-hint">
            Double-vision adaptation declaration: an adaptation period of 3+ months is required when
            driving with a patch, prism, frosted glasses or lenses. Your ability to judge distances
            may be affected, and you may not be aware of objects on each side.
        </p>

        <div class="form-group">
            <label>
                <input type="checkbox" name="double_vision.double_vision_declaration_confirmed"
                       value="true" {% if double_vision.doubleVisionDeclarationConfirmed %}checked{% endif %}>
                I confirm the double-vision adaptation declaration.
            </label>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="dv_signature">Declaration signature (name)</label>
                <input type="text" id="dv_signature" name="double_vision.declaration_signature_name"
                       value="{{ double_vision.declarationSignatureName }}">
            </div>
            <div class="form-group">
                <label for="dv_date">Declaration date</label>
                <input type="date" id="dv_date" name="double_vision.declaration_date"
                       value="{{ double_vision.declarationDate }}">
            </div>
        </div>
    </div>
</div>
