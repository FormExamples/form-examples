<div class="card" x-data="{ laser: '{{ laser_treatment.hasHadTreatment }}' }">
    <h2>Step 8: Q6 — Laser Treatment</h2>
    <p class="form-hint">Have you had laser treatment? (Do not include treatment for long/short sightedness or cataracts.)</p>

    <div class="form-group">
        <label for="lt_has">Laser treatment?</label>
        <select id="lt_has" name="laser_treatment.has_had_treatment" x-model="laser">
            <option value="" {% if laser_treatment.hasHadTreatment == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if laser_treatment.hasHadTreatment == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if laser_treatment.hasHadTreatment == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div x-show="laser === 'yes'" x-cloak>
        <h3>Date of first treatment</h3>
        <div class="form-row">
            <div class="form-group">
                <label for="lt_left_first">Left eye</label>
                <input type="date" id="lt_left_first" name="laser_treatment.left_eye_first_date"
                       value="{{ laser_treatment.leftEyeFirstDate }}">
            </div>
            <div class="form-group">
                <label for="lt_right_first">Right eye</label>
                <input type="date" id="lt_right_first" name="laser_treatment.right_eye_first_date"
                       value="{{ laser_treatment.rightEyeFirstDate }}">
            </div>
        </div>

        <h3>Date of last treatment</h3>
        <div class="form-row">
            <div class="form-group">
                <label for="lt_left_last">Left eye</label>
                <input type="date" id="lt_left_last" name="laser_treatment.left_eye_last_date"
                       value="{{ laser_treatment.leftEyeLastDate }}">
            </div>
            <div class="form-group">
                <label for="lt_right_last">Right eye</label>
                <input type="date" id="lt_right_last" name="laser_treatment.right_eye_last_date"
                       value="{{ laser_treatment.rightEyeLastDate }}">
            </div>
        </div>
    </div>
</div>
