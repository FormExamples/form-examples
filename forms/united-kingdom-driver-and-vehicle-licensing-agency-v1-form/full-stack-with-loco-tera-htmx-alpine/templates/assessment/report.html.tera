{% extends "base.html.tera" %}

{% block title %}DVLA V1 — Report{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;">
  <h1>DVLA V1 — Vision Self-Declaration Report</h1>
  <p style="color:#555;">Assessment ID: <code>{{ id }}</code></p>
  <p style="color:#555;">Generated: {{ timestamp }}</p>

  <!-- Completeness summary -->
  <section style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin:1.5rem 0;">
    <h2>Completeness</h2>
    {% if result.validation.complete %}
      <p style="color:#0a7d31;font-weight:bold;">All required fields completed across the active branches.</p>
    {% else %}
      <p style="color:#b30000;font-weight:bold;">
        Form is incomplete: {{ result.validation.totalSatisfied }} of
        {{ result.validation.totalRequired }} required fields answered.
      </p>
    {% endif %}

    {% if result.validation.sections | length > 0 %}
      <table style="width:100%;border-collapse:collapse;margin-top:0.8rem;">
        <thead>
          <tr style="background:#f5f5f5;">
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Section</th>
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Satisfied</th>
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Required</th>
          </tr>
        </thead>
        <tbody>
          {% for s in result.validation.sections %}
            <tr>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ s.sectionLabel }}</td>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ s.satisfied }}</td>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ s.required }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {% if result.validation.missing | length > 0 %}
      <h3 style="margin-top:1rem;">Missing fields</h3>
      <ul>
        {% for m in result.validation.missing %}
          <li><strong>{{ m.id }}</strong> ({{ m.section }}): {{ m.description }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>

  <!-- Flagged issues -->
  <section style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin:1.5rem 0;">
    <h2>Flagged Issues</h2>
    {% if result.flaggedIssues | length == 0 %}
      <p>No flagged issues.</p>
    {% else %}
      <ul>
        {% for f in result.flaggedIssues %}
          <li>
            <strong>[{{ f.priority | upper }}]</strong>
            <em>{{ f.category }}</em> — {{ f.message }}
            <span style="color:#888;">({{ f.id }})</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>

  <p>
    <a href="/assessment/{{ id }}">← Back to wizard</a>
    &nbsp;|&nbsp;
    <a href="/">Home</a>
  </p>
</div>
{% endblock %}
