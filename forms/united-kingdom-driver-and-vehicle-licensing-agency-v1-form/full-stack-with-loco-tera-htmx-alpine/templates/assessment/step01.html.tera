<div class="card">
    <h2>Step 1: Personal Details (Part A)</h2>
    <p class="form-hint">Your current personal details. If any have changed, note the change in the dedicated field.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="pd_title">Title</label>
            <input type="text" id="pd_title" name="personal_details.title"
                   value="{{ personal_details.title }}" placeholder="Mr / Mrs / Miss / Ms / Dr">
        </div>
        <div class="form-group">
            <label for="pd_full_name">Full Name</label>
            <input type="text" id="pd_full_name" name="personal_details.full_name"
                   value="{{ personal_details.fullName }}">
        </div>
        <div class="form-group">
            <label for="pd_date_of_birth">Date of Birth</label>
            <input type="date" id="pd_date_of_birth" name="personal_details.date_of_birth"
                   value="{{ personal_details.dateOfBirth }}">
        </div>
    </div>

    <div class="form-group">
        <label for="pd_address">Address</label>
        <textarea id="pd_address" name="personal_details.address" placeholder="Address (multi-line)">{{ personal_details.address }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="pd_postcode">Postcode</label>
            <input type="text" id="pd_postcode" name="personal_details.postcode"
                   value="{{ personal_details.postcode }}">
        </div>
        <div class="form-group">
            <label for="pd_email">Email</label>
            <input type="email" id="pd_email" name="personal_details.email"
                   value="{{ personal_details.email }}">
        </div>
        <div class="form-group">
            <label for="pd_contact_number">Contact Number</label>
            <input type="tel" id="pd_contact_number" name="personal_details.contact_number"
                   value="{{ personal_details.contactNumber }}">
        </div>
    </div>

    <div class="form-group">
        <label for="pd_change_of_details">Change of Details (optional)</label>
        <textarea id="pd_change_of_details" name="personal_details.change_of_details" placeholder="Any details that have changed since your last contact with DVLA.">{{ personal_details.changeOfDetails }}</textarea>
    </div>
</div>
