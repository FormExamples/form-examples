<div class="card" x-data="{ mono: '{{ vision_in_both_eyes.hasVisionInBothEyes }}' }">
    <h2>Step 4: Q2 — Vision in Both Eyes</h2>
    <p class="form-hint">Do you have vision in both eyes? (Do not include long or short sightedness.)</p>

    <div class="form-group">
        <label for="v2_has_both">Vision in both eyes?</label>
        <select id="v2_has_both" name="vision_in_both_eyes.has_vision_in_both_eyes" x-model="mono">
            <option value="" {% if vision_in_both_eyes.hasVisionInBothEyes == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if vision_in_both_eyes.hasVisionInBothEyes == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if vision_in_both_eyes.hasVisionInBothEyes == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div x-show="mono === 'no'" x-cloak>
        <div class="form-row">
            <div class="form-group">
                <label for="v2_which_eye">Which eye can you see with?</label>
                <select id="v2_which_eye" name="vision_in_both_eyes.which_eye">
                    <option value="" {% if vision_in_both_eyes.whichEye == "" %}selected{% endif %}>&mdash;</option>
                    <option value="left" {% if vision_in_both_eyes.whichEye == "left" %}selected{% endif %}>Left eye only</option>
                    <option value="right" {% if vision_in_both_eyes.whichEye == "right" %}selected{% endif %}>Right eye only</option>
                </select>
            </div>
            <div class="form-group">
                <label for="v2_duration">How long?</label>
                <select id="v2_duration" name="vision_in_both_eyes.duration">
                    <option value="" {% if vision_in_both_eyes.duration == "" %}selected{% endif %}>&mdash;</option>
                    <option value="since-birth-or-childhood" {% if vision_in_both_eyes.duration == "since-birth-or-childhood" %}selected{% endif %}>Since birth or childhood</option>
                    <option value="health-or-injury" {% if vision_in_both_eyes.duration == "health-or-injury" %}selected{% endif %}>As a result of a health condition, accident or injury</option>
                </select>
            </div>
            <div class="form-group">
                <label for="v2_adaptation">Adaptation</label>
                <select id="v2_adaptation" name="vision_in_both_eyes.adaptation">
                    <option value="" {% if vision_in_both_eyes.adaptation == "" %}selected{% endif %}>&mdash;</option>
                    <option value="adapted-advised" {% if vision_in_both_eyes.adaptation == "adapted-advised" %}selected{% endif %}>Adapted &mdash; advised by healthcare professional</option>
                    <option value="adapted-self" {% if vision_in_both_eyes.adaptation == "adapted-self" %}selected{% endif %}>Adapted &mdash; not advised by healthcare professional</option>
                    <option value="not-adapted" {% if vision_in_both_eyes.adaptation == "not-adapted" %}selected{% endif %}>Not adapted</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>
                <input type="checkbox" name="vision_in_both_eyes.monocular_declaration_confirmed"
                       value="true" {% if vision_in_both_eyes.monocularDeclarationConfirmed %}checked{% endif %}>
                I confirm that I have adapted to vision in one eye (monocular declaration).
            </label>
        </div>
    </div>
</div>
