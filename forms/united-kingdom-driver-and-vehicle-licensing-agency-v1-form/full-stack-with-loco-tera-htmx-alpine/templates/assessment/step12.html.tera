<div class="card" x-data="{ oth: '{{ other_vision_conditions.hasOther }}' }">
    <h2>Step 12: Q10 — Other Vision Conditions</h2>
    <p class="form-hint">Do you have any other vision condition not covered above?</p>

    <div class="form-group">
        <label for="oth_has">Other vision condition?</label>
        <select id="oth_has" name="other_vision_conditions.has_other" x-model="oth">
            <option value="" {% if other_vision_conditions.hasOther == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if other_vision_conditions.hasOther == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if other_vision_conditions.hasOther == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group" x-show="oth === 'yes'" x-cloak>
        <label for="oth_details">Condition(s) and which eye(s) affected</label>
        <textarea id="oth_details" name="other_vision_conditions.details" placeholder="Describe the other vision condition(s) and which eye(s) are affected.">{{ other_vision_conditions.details }}</textarea>
    </div>
</div>
