<div class="card" x-data="{ bleph: '{{ blepharospasm.hasCondition }}' }">
    <h2>Step 9: Q7 — Blepharospasm</h2>
    <p class="form-hint">Have you been diagnosed with blepharospasm (involuntary eyelid muscle spasm)?</p>

    <div class="form-group">
        <label for="bleph_has">Blepharospasm?</label>
        <select id="bleph_has" name="blepharospasm.has_condition" x-model="bleph">
            <option value="" {% if blepharospasm.hasCondition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if blepharospasm.hasCondition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if blepharospasm.hasCondition == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div x-show="bleph === 'yes'" x-cloak>
        <div class="form-row">
            <div class="form-group">
                <label for="bleph_which_eyes">Which eye(s)?</label>
                <select id="bleph_which_eyes" name="blepharospasm.which_eyes">
                    <option value="" {% if blepharospasm.whichEyes == "" %}selected{% endif %}>&mdash;</option>
                    <option value="both" {% if blepharospasm.whichEyes == "both" %}selected{% endif %}>Both eyes</option>
                    <option value="left" {% if blepharospasm.whichEyes == "left" %}selected{% endif %}>Left eye</option>
                    <option value="right" {% if blepharospasm.whichEyes == "right" %}selected{% endif %}>Right eye</option>
                </select>
            </div>
            <div class="form-group">
                <label for="bleph_treatment">Have you had any treatment?</label>
                <select id="bleph_treatment" name="blepharospasm.has_had_treatment">
                    <option value="" {% if blepharospasm.hasHadTreatment == "" %}selected{% endif %}>&mdash;</option>
                    <option value="yes" {% if blepharospasm.hasHadTreatment == "yes" %}selected{% endif %}>Yes</option>
                    <option value="no" {% if blepharospasm.hasHadTreatment == "no" %}selected{% endif %}>No</option>
                </select>
            </div>
            <div class="form-group">
                <label for="bleph_controlled">Adequately controlled (per healthcare professional)?</label>
                <select id="bleph_controlled" name="blepharospasm.adequately_controlled">
                    <option value="" {% if blepharospasm.adequatelyControlled == "" %}selected{% endif %}>&mdash;</option>
                    <option value="yes" {% if blepharospasm.adequatelyControlled == "yes" %}selected{% endif %}>Yes</option>
                    <option value="no" {% if blepharospasm.adequatelyControlled == "no" %}selected{% endif %}>No</option>
                </select>
            </div>
        </div>
    </div>
</div>
