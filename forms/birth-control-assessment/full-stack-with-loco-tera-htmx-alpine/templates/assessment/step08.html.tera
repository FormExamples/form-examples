<div class="card">
    <h2>Step 8: Lifestyle Assessment</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="smoking">Smoking status</label>
            <select id="smoking" name="lifestyle_assessment.smoking">
                <option value="" {% if lifestyle_assessment.smoking == "" %}selected{% endif %}>&mdash;</option>
                <option value="never" {% if lifestyle_assessment.smoking == "never" %}selected{% endif %}>Never</option>
                <option value="ex-smoker" {% if lifestyle_assessment.smoking == "ex-smoker" %}selected{% endif %}>Ex-smoker</option>
                <option value="current" {% if lifestyle_assessment.smoking == "current" %}selected{% endif %}>Current</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cigarettes_per_day">Cigarettes per day</label>
            <input type="number" min="0" id="cigarettes_per_day" name="lifestyle_assessment.cigarettes_per_day"
                   value="{{ lifestyle_assessment.cigarettesPerDay }}">
        </div>
        <div class="form-group">
            <label for="age_over_35_smoker">Age &gt; 35 and smoker</label>
            <select id="age_over_35_smoker" name="lifestyle_assessment.age_over_35_smoker">
                <option value="" {% if lifestyle_assessment.ageOver35Smoker == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if lifestyle_assessment.ageOver35Smoker == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if lifestyle_assessment.ageOver35Smoker == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="alcohol">Alcohol consumption</label>
            <select id="alcohol" name="lifestyle_assessment.alcohol">
                <option value="" {% if lifestyle_assessment.alcohol == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if lifestyle_assessment.alcohol == "none" %}selected{% endif %}>None</option>
                <option value="within-guidelines" {% if lifestyle_assessment.alcohol == "within-guidelines" %}selected{% endif %}>Within guidelines</option>
                <option value="above-guidelines" {% if lifestyle_assessment.alcohol == "above-guidelines" %}selected{% endif %}>Above guidelines</option>
            </select>
        </div>
        <div class="form-group">
            <label for="alcohol_units_per_week">Alcohol units per week</label>
            <input type="number" min="0" id="alcohol_units_per_week" name="lifestyle_assessment.alcohol_units_per_week"
                   value="{{ lifestyle_assessment.alcoholUnitsPerWeek }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recreational_drug_use">Recreational drug use</label>
            <select id="recreational_drug_use" name="lifestyle_assessment.recreational_drug_use">
                <option value="" {% if lifestyle_assessment.recreationalDrugUse == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if lifestyle_assessment.recreationalDrugUse == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if lifestyle_assessment.recreationalDrugUse == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="recreational_drug_details">Recreational drug details</label>
            <input type="text" id="recreational_drug_details" name="lifestyle_assessment.recreational_drug_details"
                   value="{{ lifestyle_assessment.recreationalDrugDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="exercise_frequency">Exercise frequency</label>
            <select id="exercise_frequency" name="lifestyle_assessment.exercise_frequency">
                <option value="" {% if lifestyle_assessment.exerciseFrequency == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if lifestyle_assessment.exerciseFrequency == "none" %}selected{% endif %}>None</option>
                <option value="occasional" {% if lifestyle_assessment.exerciseFrequency == "occasional" %}selected{% endif %}>Occasional</option>
                <option value="regular" {% if lifestyle_assessment.exerciseFrequency == "regular" %}selected{% endif %}>Regular</option>
                <option value="daily" {% if lifestyle_assessment.exerciseFrequency == "daily" %}selected{% endif %}>Daily</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sexual_activity">Sexually active</label>
            <select id="sexual_activity" name="lifestyle_assessment.sexual_activity">
                <option value="" {% if lifestyle_assessment.sexualActivity == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if lifestyle_assessment.sexualActivity == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if lifestyle_assessment.sexualActivity == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="number_of_partners">Number of partners</label>
            <select id="number_of_partners" name="lifestyle_assessment.number_of_partners">
                <option value="" {% if lifestyle_assessment.numberOfPartners == "" %}selected{% endif %}>&mdash;</option>
                <option value="one" {% if lifestyle_assessment.numberOfPartners == "one" %}selected{% endif %}>One</option>
                <option value="multiple" {% if lifestyle_assessment.numberOfPartners == "multiple" %}selected{% endif %}>Multiple</option>
            </select>
        </div>
    </div>
</div>
