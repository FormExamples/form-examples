<div class="card">
    <h2>Step 6: Thromboembolism Risk</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_dvt">Previous DVT</label>
            <select id="previous_dvt" name="thromboembolism_risk.previous_dvt">
                <option value="" {% if thromboembolism_risk.previousDVT == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.previousDVT == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.previousDVT == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dvt_details">DVT details</label>
            <input type="text" id="dvt_details" name="thromboembolism_risk.dvt_details"
                   value="{{ thromboembolism_risk.dvtDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_pe">Previous PE</label>
            <select id="previous_pe" name="thromboembolism_risk.previous_pe">
                <option value="" {% if thromboembolism_risk.previousPE == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.previousPE == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.previousPE == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pe_details">PE details</label>
            <input type="text" id="pe_details" name="thromboembolism_risk.pe_details"
                   value="{{ thromboembolism_risk.peDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="known_thrombophilia">Known thrombophilia</label>
            <select id="known_thrombophilia" name="thromboembolism_risk.known_thrombophilia">
                <option value="" {% if thromboembolism_risk.knownThrombophilia == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.knownThrombophilia == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.knownThrombophilia == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="thrombophilia_type">Thrombophilia type</label>
            <select id="thrombophilia_type" name="thromboembolism_risk.thrombophilia_type">
                <option value="" {% if thromboembolism_risk.thrombophiliaType == "" %}selected{% endif %}>&mdash;</option>
                <option value="factor-v-leiden" {% if thromboembolism_risk.thrombophiliaType == "factor-v-leiden" %}selected{% endif %}>Factor V Leiden</option>
                <option value="prothrombin-mutation" {% if thromboembolism_risk.thrombophiliaType == "prothrombin-mutation" %}selected{% endif %}>Prothrombin mutation</option>
                <option value="protein-c-deficiency" {% if thromboembolism_risk.thrombophiliaType == "protein-c-deficiency" %}selected{% endif %}>Protein C deficiency</option>
                <option value="protein-s-deficiency" {% if thromboembolism_risk.thrombophiliaType == "protein-s-deficiency" %}selected{% endif %}>Protein S deficiency</option>
                <option value="antithrombin-deficiency" {% if thromboembolism_risk.thrombophiliaType == "antithrombin-deficiency" %}selected{% endif %}>Antithrombin deficiency</option>
                <option value="antiphospholipid" {% if thromboembolism_risk.thrombophiliaType == "antiphospholipid" %}selected{% endif %}>Antiphospholipid syndrome</option>
                <option value="other" {% if thromboembolism_risk.thrombophiliaType == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="immobility_risk">Immobility risk</label>
            <select id="immobility_risk" name="thromboembolism_risk.immobility_risk">
                <option value="" {% if thromboembolism_risk.immobilityRisk == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.immobilityRisk == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.immobilityRisk == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="immobility_details">Immobility details</label>
            <input type="text" id="immobility_details" name="thromboembolism_risk.immobility_details"
                   value="{{ thromboembolism_risk.immobilityDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recent_major_surgery">Recent major surgery</label>
            <select id="recent_major_surgery" name="thromboembolism_risk.recent_major_surgery">
                <option value="" {% if thromboembolism_risk.recentMajorSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.recentMajorSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.recentMajorSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="surgery_details">Surgery details</label>
            <input type="text" id="surgery_details" name="thromboembolism_risk.surgery_details"
                   value="{{ thromboembolism_risk.surgeryDetails }}">
        </div>
        <div class="form-group">
            <label for="long_haul_travel">Long-haul travel</label>
            <select id="long_haul_travel" name="thromboembolism_risk.long_haul_travel">
                <option value="" {% if thromboembolism_risk.longHaulTravel == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if thromboembolism_risk.longHaulTravel == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if thromboembolism_risk.longHaulTravel == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
