<div class="card">
    <h2>Step 9: Contraceptive Preferences</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="preferred_method">Preferred method</label>
            <select id="preferred_method" name="contraceptive_preferences.preferred_method">
                <option value="" {% if contraceptive_preferences.preferredMethod == "" %}selected{% endif %}>&mdash;</option>
                <option value="coc" {% if contraceptive_preferences.preferredMethod == "coc" %}selected{% endif %}>COC</option>
                <option value="pop" {% if contraceptive_preferences.preferredMethod == "pop" %}selected{% endif %}>POP</option>
                <option value="implant" {% if contraceptive_preferences.preferredMethod == "implant" %}selected{% endif %}>Implant</option>
                <option value="injection" {% if contraceptive_preferences.preferredMethod == "injection" %}selected{% endif %}>Injection</option>
                <option value="iud" {% if contraceptive_preferences.preferredMethod == "iud" %}selected{% endif %}>IUD</option>
                <option value="ius" {% if contraceptive_preferences.preferredMethod == "ius" %}selected{% endif %}>IUS</option>
                <option value="patch" {% if contraceptive_preferences.preferredMethod == "patch" %}selected{% endif %}>Patch</option>
                <option value="ring" {% if contraceptive_preferences.preferredMethod == "ring" %}selected{% endif %}>Ring</option>
                <option value="barrier" {% if contraceptive_preferences.preferredMethod == "barrier" %}selected{% endif %}>Barrier</option>
                <option value="natural" {% if contraceptive_preferences.preferredMethod == "natural" %}selected{% endif %}>Natural</option>
                <option value="unsure" {% if contraceptive_preferences.preferredMethod == "unsure" %}selected{% endif %}>Unsure</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fertility_plans">Fertility plans</label>
            <select id="fertility_plans" name="contraceptive_preferences.fertility_plans">
                <option value="" {% if contraceptive_preferences.fertilityPlans == "" %}selected{% endif %}>&mdash;</option>
                <option value="within-1-year" {% if contraceptive_preferences.fertilityPlans == "within-1-year" %}selected{% endif %}>Within 1 year</option>
                <option value="1-5-years" {% if contraceptive_preferences.fertilityPlans == "1-5-years" %}selected{% endif %}>1-5 years</option>
                <option value="no-plans" {% if contraceptive_preferences.fertilityPlans == "no-plans" %}selected{% endif %}>No plans</option>
                <option value="completed-family" {% if contraceptive_preferences.fertilityPlans == "completed-family" %}selected{% endif %}>Completed family</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hormonal_acceptable">Hormonal methods acceptable</label>
            <select id="hormonal_acceptable" name="contraceptive_preferences.hormonal_acceptable">
                <option value="" {% if contraceptive_preferences.hormonalAcceptable == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_preferences.hormonalAcceptable == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_preferences.hormonalAcceptable == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="long_acting_acceptable">Long-acting acceptable</label>
            <select id="long_acting_acceptable" name="contraceptive_preferences.long_acting_acceptable">
                <option value="" {% if contraceptive_preferences.longActingAcceptable == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_preferences.longActingAcceptable == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_preferences.longActingAcceptable == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="daily_pill_acceptable">Daily pill acceptable</label>
            <select id="daily_pill_acceptable" name="contraceptive_preferences.daily_pill_acceptable">
                <option value="" {% if contraceptive_preferences.dailyPillAcceptable == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_preferences.dailyPillAcceptable == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_preferences.dailyPillAcceptable == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="intrauterine_acceptable">Intrauterine acceptable</label>
            <select id="intrauterine_acceptable" name="contraceptive_preferences.intrauterine_acceptable">
                <option value="" {% if contraceptive_preferences.intrauterineAcceptable == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_preferences.intrauterineAcceptable == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_preferences.intrauterineAcceptable == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="breastfeeding">Breastfeeding</label>
            <select id="breastfeeding" name="contraceptive_preferences.breastfeeding">
                <option value="" {% if contraceptive_preferences.breastfeeding == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_preferences.breastfeeding == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_preferences.breastfeeding == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="postpartum_weeks">Postpartum weeks</label>
            <input type="number" min="0" id="postpartum_weeks" name="contraceptive_preferences.postpartum_weeks"
                   value="{{ contraceptive_preferences.postpartumWeeks }}">
        </div>
    </div>

    <div class="form-group">
        <label for="concerns">Concerns</label>
        <textarea id="concerns" name="contraceptive_preferences.concerns">{{ contraceptive_preferences.concerns }}</textarea>
    </div>
</div>
