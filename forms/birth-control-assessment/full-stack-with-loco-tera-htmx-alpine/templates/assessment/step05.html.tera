<div class="card">
    <h2>Step 5: Cardiovascular Risk Factors</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="hypertension">Hypertension</label>
            <select id="hypertension" name="cardiovascular_risk.hypertension">
                <option value="" {% if cardiovascular_risk.hypertension == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.hypertension == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.hypertension == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="systolic_bp">Systolic BP (mmHg)</label>
            <input type="number" min="0" id="systolic_bp" name="cardiovascular_risk.systolic_bp"
                   value="{{ cardiovascular_risk.systolicBP }}">
        </div>
        <div class="form-group">
            <label for="diastolic_bp">Diastolic BP (mmHg)</label>
            <input type="number" min="0" id="diastolic_bp" name="cardiovascular_risk.diastolic_bp"
                   value="{{ cardiovascular_risk.diastolicBP }}">
        </div>
        <div class="form-group">
            <label for="bp_controlled">BP controlled</label>
            <select id="bp_controlled" name="cardiovascular_risk.bp_controlled">
                <option value="" {% if cardiovascular_risk.bpControlled == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.bpControlled == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.bpControlled == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ischaemic_heart_disease">Ischaemic heart disease</label>
            <select id="ischaemic_heart_disease" name="cardiovascular_risk.ischaemic_heart_disease">
                <option value="" {% if cardiovascular_risk.ischaemicHeartDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.ischaemicHeartDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.ischaemicHeartDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="stroke_history">Stroke history</label>
            <select id="stroke_history" name="cardiovascular_risk.stroke_history">
                <option value="" {% if cardiovascular_risk.strokeHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.strokeHistory == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.strokeHistory == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="valvular_heart_disease">Valvular heart disease</label>
            <select id="valvular_heart_disease" name="cardiovascular_risk.valvular_heart_disease">
                <option value="" {% if cardiovascular_risk.valvularHeartDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.valvularHeartDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.valvularHeartDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="valvular_complications">Valvular complications</label>
            <select id="valvular_complications" name="cardiovascular_risk.valvular_complications">
                <option value="" {% if cardiovascular_risk.valvularComplications == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.valvularComplications == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.valvularComplications == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hyperlipidaemia">Hyperlipidaemia</label>
            <select id="hyperlipidaemia" name="cardiovascular_risk.hyperlipidaemia">
                <option value="" {% if cardiovascular_risk.hyperlipidaemia == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.hyperlipidaemia == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.hyperlipidaemia == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="family_history_vte">Family history of VTE</label>
            <select id="family_history_vte" name="cardiovascular_risk.family_history_vte">
                <option value="" {% if cardiovascular_risk.familyHistoryVTE == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.familyHistoryVTE == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.familyHistoryVTE == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="family_history_cvd">Family history of CVD</label>
            <select id="family_history_cvd" name="cardiovascular_risk.family_history_cvd">
                <option value="" {% if cardiovascular_risk.familyHistoryCVD == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if cardiovascular_risk.familyHistoryCVD == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if cardiovascular_risk.familyHistoryCVD == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="family_cvd_details">Family CVD details</label>
            <input type="text" id="family_cvd_details" name="cardiovascular_risk.family_cvd_details"
                   value="{{ cardiovascular_risk.familyCVDDetails }}">
        </div>
    </div>
</div>
