<div class="card">
    <h2>Step 3: Contraceptive History</h2>

    <div class="form-group">
        <label for="previous_contraception">Previous contraception</label>
        <select id="previous_contraception" name="contraceptive_history.previous_contraception">
            <option value="" {% if contraceptive_history.previousContraception == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if contraceptive_history.previousContraception == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if contraceptive_history.previousContraception == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_coc">Previous COC</label>
            <select id="previous_coc" name="contraceptive_history.previous_coc">
                <option value="" {% if contraceptive_history.previousCOC == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousCOC == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousCOC == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="coc_details">COC details</label>
            <input type="text" id="coc_details" name="contraceptive_history.coc_details"
                   value="{{ contraceptive_history.cocDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_pop">Previous POP</label>
            <select id="previous_pop" name="contraceptive_history.previous_pop">
                <option value="" {% if contraceptive_history.previousPOP == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousPOP == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousPOP == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pop_details">POP details</label>
            <input type="text" id="pop_details" name="contraceptive_history.pop_details"
                   value="{{ contraceptive_history.popDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_implant">Previous implant</label>
            <select id="previous_implant" name="contraceptive_history.previous_implant">
                <option value="" {% if contraceptive_history.previousImplant == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousImplant == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousImplant == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="implant_details">Implant details</label>
            <input type="text" id="implant_details" name="contraceptive_history.implant_details"
                   value="{{ contraceptive_history.implantDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_injection">Previous injection</label>
            <select id="previous_injection" name="contraceptive_history.previous_injection">
                <option value="" {% if contraceptive_history.previousInjection == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousInjection == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousInjection == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="injection_details">Injection details</label>
            <input type="text" id="injection_details" name="contraceptive_history.injection_details"
                   value="{{ contraceptive_history.injectionDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_iud">Previous IUD</label>
            <select id="previous_iud" name="contraceptive_history.previous_iud">
                <option value="" {% if contraceptive_history.previousIUD == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousIUD == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousIUD == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="iud_details">IUD details</label>
            <input type="text" id="iud_details" name="contraceptive_history.iud_details"
                   value="{{ contraceptive_history.iudDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_ius">Previous IUS</label>
            <select id="previous_ius" name="contraceptive_history.previous_ius">
                <option value="" {% if contraceptive_history.previousIUS == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousIUS == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousIUS == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ius_details">IUS details</label>
            <input type="text" id="ius_details" name="contraceptive_history.ius_details"
                   value="{{ contraceptive_history.iusDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_patch_ring">Previous patch/ring</label>
            <select id="previous_patch_ring" name="contraceptive_history.previous_patch_ring">
                <option value="" {% if contraceptive_history.previousPatchRing == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousPatchRing == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousPatchRing == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patch_ring_details">Patch/ring details</label>
            <input type="text" id="patch_ring_details" name="contraceptive_history.patch_ring_details"
                   value="{{ contraceptive_history.patchRingDetails }}">
        </div>
        <div class="form-group">
            <label for="previous_barrier">Previous barrier</label>
            <select id="previous_barrier" name="contraceptive_history.previous_barrier">
                <option value="" {% if contraceptive_history.previousBarrier == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if contraceptive_history.previousBarrier == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if contraceptive_history.previousBarrier == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="reason_for_change">Reason for change</label>
        <textarea id="reason_for_change" name="contraceptive_history.reason_for_change">{{ contraceptive_history.reasonForChange }}</textarea>
    </div>

    <div class="form-group">
        <label for="adverse_effects">Adverse effects</label>
        <textarea id="adverse_effects" name="contraceptive_history.adverse_effects">{{ contraceptive_history.adverseEffects }}</textarea>
    </div>
</div>
