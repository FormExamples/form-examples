{% extends "base.html.tera" %}

{% block title %}Birth Control Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Clinician Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or date of birth...">
    </div>
    <div class="form-group">
        <label for="overall_risk">Overall risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if overall_risk == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="preferred_method">Preferred method</label>
        <select id="preferred_method" name="preferred_method">
            <option value="">All</option>
            <option value="coc" {% if preferred_method == "coc" %}selected{% endif %}>COC</option>
            <option value="pop" {% if preferred_method == "pop" %}selected{% endif %}>POP</option>
            <option value="implant" {% if preferred_method == "implant" %}selected{% endif %}>Implant</option>
            <option value="injection" {% if preferred_method == "injection" %}selected{% endif %}>Injection</option>
            <option value="iud" {% if preferred_method == "iud" %}selected{% endif %}>IUD</option>
            <option value="ius" {% if preferred_method == "ius" %}selected{% endif %}>IUS</option>
            <option value="patch" {% if preferred_method == "patch" %}selected{% endif %}>Patch</option>
            <option value="ring" {% if preferred_method == "ring" %}selected{% endif %}>Ring</option>
            <option value="barrier" {% if preferred_method == "barrier" %}selected{% endif %}>Barrier</option>
            <option value="natural" {% if preferred_method == "natural" %}selected{% endif %}>Natural</option>
            <option value="unsure" {% if preferred_method == "unsure" %}selected{% endif %}>Unsure</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-priority flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Date of birth</th>
            <th>Sex</th>
            <th>Preferred method</th>
            <th>Overall risk</th>
            <th>COC</th>
            <th>POP</th>
            <th>Implant</th>
            <th>Injection</th>
            <th>IUD</th>
            <th>IUS</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.lastName }}, {{ c.firstName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.sex }}</td>
            <td>{{ c.preferredMethod }}</td>
            <td><span class="risk-badge risk-{{ c.overallRisk }}">{{ c.overallRisk }}</span></td>
            <td><span class="mec-badge mec-{{ c.cocMec }}">MEC {{ c.cocMec }}</span></td>
            <td><span class="mec-badge mec-{{ c.popMec }}">MEC {{ c.popMec }}</span></td>
            <td><span class="mec-badge mec-{{ c.implantMec }}">MEC {{ c.implantMec }}</span></td>
            <td><span class="mec-badge mec-{{ c.injectionMec }}">MEC {{ c.injectionMec }}</span></td>
            <td><span class="mec-badge mec-{{ c.iudMec }}">MEC {{ c.iudMec }}</span></td>
            <td><span class="mec-badge mec-{{ c.iusMec }}">MEC {{ c.iusMec }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
