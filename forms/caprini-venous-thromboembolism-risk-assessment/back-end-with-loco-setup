#!/bin/sh
set -euf

form_kebab_case=caprini-venous-thromboembolism-risk-assessment
form_snake_case=caprini_venous_thromboembolism_risk_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold caprini_venous_thromboembolism_risk_assessment \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    admission_type:string! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    minor_surgery:string! \
    recent_major_surgery:string! \
    varicose_veins:string! \
    inflammatory_bowel_disease:string! \
    swollen_legs:string! \
    obesity:string! \
    acute_myocardial_infarction:string! \
    congestive_heart_failure:string! \
    sepsis:string! \
    serious_lung_disease:string! \
    abnormal_pulmonary_function:string! \
    medical_patient_bed_rest:string! \
    oral_contraceptive_or_hrt:string! \
    pregnancy_or_postpartum:string! \
    adverse_pregnancy_history:string! \
    arthroscopic_surgery:string! \
    major_open_surgery:string! \
    laparoscopic_surgery:string! \
    malignancy:string! \
    confined_to_bed:string! \
    immobilising_cast:string! \
    central_venous_access:string! \
    history_of_vte:string! \
    family_history_of_thrombosis:string! \
    factor_v_leiden:string! \
    prothrombin_20210a:string! \
    lupus_anticoagulant:string! \
    anticardiolipin_antibodies:string! \
    elevated_homocysteine:string! \
    heparin_induced_thrombocytopenia:string! \
    other_thrombophilia:string! \
    stroke:string! \
    elective_arthroplasty:string! \
    hip_pelvis_leg_fracture:string! \
    acute_spinal_cord_injury:string! \
    multiple_trauma:string! \
    high_bleeding_risk:string! \
    clinical_note:text! \
    --api

cargo loco generate scaffold caprini_venous_thromboembolism_risk_assessment_grade \
    deleted_at:tstz \
    caprini_venous_thromboembolism_risk_assessment:references \
    total_score:int \
    risk_band:string! \
    prophylaxis_recommendation:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold caprini_venous_thromboembolism_risk_assessment_grade_rule \
    deleted_at:tstz \
    caprini_venous_thromboembolism_risk_assessment_grade:references \
    rule_id:string! \
    factor:string! \
    weight_group:string! \
    points:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold caprini_venous_thromboembolism_risk_assessment_grade_flag \
    deleted_at:tstz \
    caprini_venous_thromboembolism_risk_assessment_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
