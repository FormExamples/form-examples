#!/bin/sh
set -euf

form_kebab_case=corrected-calcium-calculator
form_snake_case=corrected_calcium_calculator

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold corrected_calcium_calculator \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:string! \
    clinician_role:string! \
    assessed_at:tstz \
    care_setting:string! \
    sample_reference:string! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    total_calcium_mmol_l:double \
    albumin_g_l:double \
    symptomatic:string! \
    --api

cargo loco generate scaffold corrected_calcium_calculator_grade \
    deleted_at:tstz \
    corrected_calcium_calculator:references \
    corrected_calcium_mmol_l:double \
    classification:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold corrected_calcium_calculator_grade_rule \
    deleted_at:tstz \
    corrected_calcium_calculator_grade:references \
    rule_id:string! \
    instrument:string! \
    band:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold corrected_calcium_calculator_grade_flag \
    deleted_at:tstz \
    corrected_calcium_calculator_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
