#!/bin/sh
set -euf

form_kebab_case=agile-principles-assessment
form_snake_case=agile_principles_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold respondent \
    deleted_at:ts \
    full_name:string! \
    email:string! \
    role:string! \
    team_name:string! \
    organisation_name:string! \
    years_in_agile:int \
    --api

cargo loco generate scaffold agile_principles_assessment \
    deleted_at:ts \
    respondent:references \
    status:string! \
    is_anonymous:bool! \
    assessment_date:date \
    assessment_period:string! \
    p01_customer_satisfaction:int \
    p01_comment:text! \
    p01_weight:double! \
    p02_welcome_change:int \
    p02_comment:text! \
    p02_weight:double! \
    p03_deliver_frequently:int \
    p03_comment:text! \
    p03_weight:double! \
    p04_collaboration:int \
    p04_comment:text! \
    p04_weight:double! \
    p05_motivated_individuals:int \
    p05_comment:text! \
    p05_weight:double! \
    p06_face_to_face:int \
    p06_comment:text! \
    p06_weight:double! \
    p07_working_software:int \
    p07_comment:text! \
    p07_weight:double! \
    p08_sustainable_development:int \
    p08_comment:text! \
    p08_weight:double! \
    p09_technical_excellence:int \
    p09_comment:text! \
    p09_weight:double! \
    p10_simplicity:int \
    p10_comment:text! \
    p10_weight:double! \
    p11_self_organising_teams:int \
    p11_comment:text! \
    p11_weight:double! \
    p12_regular_reflection:int \
    p12_comment:text! \
    p12_weight:double! \
    overall_notes:text! \
    --api

cargo loco generate scaffold agile_principles_assessment_grade \
    deleted_at:ts \
    agile_principles_assessment:references \
    answered_count:int! \
    mean_score:double \
    weighted_mean_score:double \
    weights_customised:bool! \
    maturity:string! \
    top_action_1:string! \
    top_action_2:string! \
    top_action_3:string! \
    coach_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold agile_principles_assessment_grade_rule \
    deleted_at:ts \
    agile_principles_assessment_grade:references \
    rule_id:string! \
    principle_number:int! \
    band:string! \
    principle_slug:string! \
    description:string! \
    --api

cargo loco generate scaffold agile_principles_assessment_grade_flag \
    deleted_at:ts \
    agile_principles_assessment_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    principle_number:int \
    description:string! \
    suggested_action:string! \
    --api
