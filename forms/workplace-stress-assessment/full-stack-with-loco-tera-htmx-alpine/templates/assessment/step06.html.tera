{% import "assessment/_macros.html.tera" as m %}
<div class="card">
    <h2>Step 6: Relationships</h2>
    <p class="form-hint">
        Promoting positive working to avoid conflict and dealing with
        unacceptable behaviour. If you indicate harassment or bullying
        "Often" or "Always", a safeguarding review will be triggered.
    </p>

    {{ m::frequency(name="relationships.rel1", id="rel1", label="I am subject to personal harassment in the form of unkind words or behaviour.", value=relationships.rel1) }}
    {{ m::frequency(name="relationships.rel2", id="rel2", label="There is friction or anger between colleagues.", value=relationships.rel2) }}
    {{ m::frequency(name="relationships.rel3", id="rel3", label="I am subject to bullying at work.", value=relationships.rel3) }}
    {{ m::frequency(name="relationships.rel4", id="rel4", label="Relationships at work are strained.", value=relationships.rel4) }}
</div>
