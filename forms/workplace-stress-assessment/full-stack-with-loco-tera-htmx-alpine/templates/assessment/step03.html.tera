{% import "assessment/_macros.html.tera" as m %}
<div class="card">
    <h2>Step 3: Control</h2>
    <p class="form-hint">How much say you have over the way you do your work.</p>

    {{ m::frequency(name="control.ctrl1", id="ctrl1", label="I can decide when to take a break.", value=control.ctrl1) }}
    {{ m::agreement(name="control.ctrl2", id="ctrl2", label="I have a say in my own work speed.", value=control.ctrl2) }}
    {{ m::agreement(name="control.ctrl3", id="ctrl3", label="I have a choice in deciding how I do my work.", value=control.ctrl3) }}
    {{ m::agreement(name="control.ctrl4", id="ctrl4", label="I have a choice in deciding what I do at work.", value=control.ctrl4) }}
    {{ m::agreement(name="control.ctrl5", id="ctrl5", label="I have some say over the way I work.", value=control.ctrl5) }}
    {{ m::frequency(name="control.ctrl6", id="ctrl6", label="My working time can be flexible.", value=control.ctrl6) }}
</div>
