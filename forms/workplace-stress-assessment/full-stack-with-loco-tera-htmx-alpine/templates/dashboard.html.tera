{% extends "base.html.tera" %}

{% block title %}Workplace Stress Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Occupational-Health Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="department">Department</label>
        <select id="department" name="department">
            <option value="">All</option>
            <option value="operations" {% if department == "operations" %}selected{% endif %}>Operations</option>
            <option value="engineering" {% if department == "engineering" %}selected{% endif %}>Engineering / IT</option>
            <option value="sales-marketing" {% if department == "sales-marketing" %}selected{% endif %}>Sales / Marketing</option>
            <option value="customer-service" {% if department == "customer-service" %}selected{% endif %}>Customer Service</option>
            <option value="finance" {% if department == "finance" %}selected{% endif %}>Finance</option>
            <option value="human-resources" {% if department == "human-resources" %}selected{% endif %}>Human Resources</option>
            <option value="administration" {% if department == "administration" %}selected{% endif %}>Administration</option>
            <option value="clinical" {% if department == "clinical" %}selected{% endif %}>Clinical / Care</option>
            <option value="research" {% if department == "research" %}selected{% endif %}>Research</option>
            <option value="leadership" {% if department == "leadership" %}selected{% endif %}>Leadership / Executive</option>
            <option value="other" {% if department == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="tenure_band">Tenure</label>
        <select id="tenure_band" name="tenure_band">
            <option value="">All</option>
            <option value="less-than-1-year" {% if tenure_band == "less-than-1-year" %}selected{% endif %}>&lt; 1 year</option>
            <option value="1-to-3-years" {% if tenure_band == "1-to-3-years" %}selected{% endif %}>1 - 3 years</option>
            <option value="3-to-5-years" {% if tenure_band == "3-to-5-years" %}selected{% endif %}>3 - 5 years</option>
            <option value="5-to-10-years" {% if tenure_band == "5-to-10-years" %}selected{% endif %}>5 - 10 years</option>
            <option value="more-than-10-years" {% if tenure_band == "more-than-10-years" %}selected{% endif %}>&gt; 10 years</option>
        </select>
    </div>
    <div class="form-group">
        <label for="hours_band">Hours</label>
        <select id="hours_band" name="hours_band">
            <option value="">All</option>
            <option value="part-time-under-20" {% if hours_band == "part-time-under-20" %}selected{% endif %}>Part-time &lt; 20h</option>
            <option value="part-time-20-to-34" {% if hours_band == "part-time-20-to-34" %}selected{% endif %}>Part-time 20 - 34h</option>
            <option value="full-time-35-to-44" {% if hours_band == "full-time-35-to-44" %}selected{% endif %}>Full-time 35 - 44h</option>
            <option value="long-hours-45-plus" {% if hours_band == "long-hours-45-plus" %}selected{% endif %}>Long hours 45h+</option>
        </select>
    </div>
    <div class="form-group">
        <label for="overall_risk">Overall risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="very-high" {% if overall_risk == "very-high" %}selected{% endif %}>Very high</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-priority flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Timestamp</th>
            <th>Department</th>
            <th>Tenure</th>
            <th>Hours</th>
            <th>Overall Risk</th>
            <th>Items Answered</th>
            <th>High-Priority Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for a in assessments %}
        <tr>
            <td><a href="/assessment/{{ a.id }}/report">{{ a.timestamp }}</a></td>
            <td>{{ a.department }}</td>
            <td>{{ a.tenureBand }}</td>
            <td>{{ a.hoursBand }}</td>
            <td><span class="risk-badge risk-{{ a.overallRisk }}">{{ a.overallRisk }}</span></td>
            <td>{{ a.answeredCount }} / 35</td>
            <td>
                {% if a.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ a.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
