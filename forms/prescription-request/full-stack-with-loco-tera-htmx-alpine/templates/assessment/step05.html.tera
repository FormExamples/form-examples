<div class="card">
    <h2>Step 5: Request Type</h2>
    <p class="form-hint">Classify this prescription request.</p>

    <div class="form-group">
        <label for="is_new_prescription">Is this a new prescription or a refill?</label>
        <select id="is_new_prescription" name="request_type.is_new_prescription">
            <option value="" {% if request_type.isNewPrescription == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if request_type.isNewPrescription == "yes" %}selected{% endif %}>New Prescription</option>
            <option value="no" {% if request_type.isNewPrescription == "no" %}selected{% endif %}>Refill / Repeat</option>
        </select>
    </div>

    <div class="form-group">
        <label for="is_emergency">Is this an emergency request?</label>
        <select id="is_emergency" name="request_type.is_emergency">
            <option value="" {% if request_type.isEmergency == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if request_type.isEmergency == "yes" %}selected{% endif %}>Emergency</option>
            <option value="no" {% if request_type.isEmergency == "no" %}selected{% endif %}>Normal</option>
        </select>
    </div>

    <div class="form-group">
        <label for="additional_notes">Additional Notes</label>
        <textarea id="additional_notes" name="request_type.additional_notes"
                  placeholder="Any other information relevant to this request…" rows="3">{{ request_type.additionalNotes }}</textarea>
    </div>
</div>
