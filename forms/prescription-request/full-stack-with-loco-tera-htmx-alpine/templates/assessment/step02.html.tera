<div class="card">
    <h2>Step 2: Clinician Information</h2>
    <p class="form-hint">Details of the prescribing clinician.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="clinician_first_name">First Name</label>
            <input type="text" id="clinician_first_name" name="clinician_information.first_name"
                   value="{{ clinician_information.firstName }}">
        </div>
        <div class="form-group">
            <label for="clinician_last_name">Last Name</label>
            <input type="text" id="clinician_last_name" name="clinician_information.last_name"
                   value="{{ clinician_information.lastName }}">
        </div>
    </div>

    <div class="form-group">
        <label for="clinician_nhs_employee_number">NHS Employee Number</label>
        <input type="text" id="clinician_nhs_employee_number" name="clinician_information.nhs_employee_number"
               value="{{ clinician_information.nhsEmployeeNumber }}" placeholder="e.g. C1234567">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="clinician_phone">Phone</label>
            <input type="text" id="clinician_phone" name="clinician_information.phone"
                   value="{{ clinician_information.phone }}">
        </div>
        <div class="form-group">
            <label for="clinician_email">Email</label>
            <input type="email" id="clinician_email" name="clinician_information.email"
                   value="{{ clinician_information.email }}">
        </div>
    </div>
</div>
