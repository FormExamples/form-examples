{% extends "base.html.tera" %}

{% block title %}Prescription Request - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Prescription Request</h1>
        <p class="landing-description">
            Prescription request form collecting patient information, clinician details,
            medication and dosage, substitution options, and request type classification.
            The deterministic priority engine classifies each request as
            <strong>Routine</strong>, <strong>Urgent</strong>, or <strong>Emergency</strong>
            and flags issues for clinician review.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Five Sections</h3>
                <p>Patient, Clinician, Prescription Details, Substitution Options, Request Type &mdash; on one continuous page</p>
            </div>
            <div class="feature">
                <h3>Priority Classification</h3>
                <p>Routine, Urgent, or Emergency &mdash; computed from declarative rules with audit IDs</p>
            </div>
            <div class="feature">
                <h3>Additional Flags</h3>
                <p>Independent checks for missing data, no-substitution combinations, and refill-without-date issues</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Prescription Request
            </button>
        </form>
    </div>
</div>
{% endblock %}
