#!/bin/sh
set -euf

form_kebab_case=prescription-request
form_snake_case=prescription_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold prescription_request \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    --api

cargo loco generate scaffold prescription_details \
    deleted_at:tstz \
    prescription_request:references \
    request_date:date! \
    medication_name:string! \
    dosage:string! \
    frequency:string! \
    route_of_administration:string! \
    treatment_instructions:text! \
    --api

cargo loco generate scaffold prescription_substitution_options \
    deleted_at:tstz \
    prescription_request:references \
    allow_brand_substitution:string! \
    allow_generic_substitution:string! \
    allow_dosage_adjustment:string! \
    substitution_notes:text! \
    --api

cargo loco generate scaffold prescription_request_type \
    deleted_at:tstz \
    prescription_request:references \
    is_new_prescription:string! \
    is_emergency:string! \
    additional_notes:text! \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    prescription_request:references \
    priority_level:string! \
    rule_count:int! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold grading_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --api

cargo loco generate scaffold grading_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api
