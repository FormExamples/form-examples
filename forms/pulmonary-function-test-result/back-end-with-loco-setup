#!/bin/sh
set -euf

form_kebab_case=pulmonary-function-test-result
form_snake_case=pulmonary_function_test_result

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    sex_at_birth:string! \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold pulmonary_function_test_result \
    deleted_at:ts \
    patient:references \
    clinician:references \
    originating_request_reference:string! \
    test_type:string! \
    performed_date:date \
    reported_date:date \
    report_status:string! \
    test_quality:string! \
    clinical_history:string! \
    fev1_litres:double \
    fev1_percent_predicted:double \
    fvc_litres:double \
    fvc_percent_predicted:double \
    fev1_fvc_ratio:double \
    peak_expiratory_flow:double \
    dlco_percent_predicted:double \
    ventilatory_pattern:string! \
    severity:string! \
    bronchodilator_reversibility:string! \
    airflow_obstruction:bool! \
    restriction:bool! \
    reduced_gas_transfer:bool! \
    significant_reversibility:bool! \
    normal_spirometry:bool! \
    findings_narrative:string! \
    comparison_with_previous:string! \
    impression:string! \
    reporting_category:string! \
    recommended_follow_up:string! \
    critical_result_communicated:bool! \
    reported_to:string! \
    --api

cargo loco generate scaffold pulmonary_function_test_result_grade \
    deleted_at:ts \
    pulmonary_function_test_result:references \
    result_classification:string! \
    abnormality_severity:string! \
    reporting_category:string! \
    report_completeness_percent:int \
    follow_up_urgency:string! \
    target_timeframe:string! \
    recommended_action:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold pulmonary_function_test_result_grade_rule \
    deleted_at:ts \
    pulmonary_function_test_result_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold pulmonary_function_test_result_grade_flag \
    deleted_at:ts \
    pulmonary_function_test_result_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
