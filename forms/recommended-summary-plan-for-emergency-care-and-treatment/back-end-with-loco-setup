#!/bin/sh
set -euf

form_kebab_case=recommended-summary-plan-for-emergency-care-and-treatment
form_snake_case=recommended_summary_plan_for_emergency_care_and_treatment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold respect \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    person_name:text! \
    date_of_birth:date \
    identifier:text! \
    address:text! \
    key_contact:text! \
    health_summary:text! \
    diagnoses:text! \
    existing_documents:text! \
    what_matters:text! \
    care_preferences:text! \
    priority_balance:string! \
    recommended_interventions:text! \
    not_recommended_interventions:text! \
    cpr_recommendation:string! \
    cpr_rationale:text! \
    cpr_discussed:string! \
    hospital_transfer:string! \
    critical_care_admission:string! \
    treatment_ceilings:text! \
    has_capacity:string! \
    capacity_assessment:text! \
    involvement:string! \
    proxy_details:text! \
    clinician_name:text! \
    clinician_role:string! \
    clinician_registration:text! \
    signature:text! \
    signed_at:tstz \
    senior_endorsement:text! \
    emergency_contacts:text! \
    review_date:date \
    --api

cargo loco generate scaffold respect_grade \
    deleted_at:tstz \
    respect:references \
    status:string! \
    completeness_percent:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold respect_grade_rule \
    deleted_at:tstz \
    respect_grade:references \
    rule_id:string! \
    section:string! \
    satisfied:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold respect_grade_flag \
    deleted_at:tstz \
    respect_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
