<div class="card">
    <h2>Step 5: Infectious Disease Screening</h2>
    <p class="form-hint">Mandatory serology and exposure screening for organ donation.</p>

    {% set screen_options = ['', 'negative', 'positive', 'pending'] %}

    <div class="form-row">
        <div class="form-group">
            <label for="ids_hiv">HIV</label>
            <select id="ids_hiv" name="infectious_disease_screening.hiv_status">
                <option value="" {% if infectious_disease_screening.hivStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.hivStatus == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.hivStatus == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.hivStatus == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_hbs">HBsAg</label>
            <select id="ids_hbs" name="infectious_disease_screening.hbs_ag">
                <option value="" {% if infectious_disease_screening.hbsAg == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.hbsAg == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.hbsAg == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.hbsAg == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_hbc">anti-HBc</label>
            <select id="ids_hbc" name="infectious_disease_screening.hbc_ab">
                <option value="" {% if infectious_disease_screening.hbcAb == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.hbcAb == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.hbcAb == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.hbcAb == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_hcv">anti-HCV</label>
            <select id="ids_hcv" name="infectious_disease_screening.hcv_ab">
                <option value="" {% if infectious_disease_screening.hcvAb == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.hcvAb == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.hcvAb == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.hcvAb == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ids_htlv">HTLV</label>
            <select id="ids_htlv" name="infectious_disease_screening.htlv_status">
                <option value="" {% if infectious_disease_screening.htlvStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.htlvStatus == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.htlvStatus == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.htlvStatus == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_cmv">CMV</label>
            <select id="ids_cmv" name="infectious_disease_screening.cmv_status">
                <option value="" {% if infectious_disease_screening.cmvStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.cmvStatus == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.cmvStatus == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.cmvStatus == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_ebv">EBV</label>
            <select id="ids_ebv" name="infectious_disease_screening.ebv_status">
                <option value="" {% if infectious_disease_screening.ebvStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.ebvStatus == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.ebvStatus == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.ebvStatus == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_syphilis">Syphilis</label>
            <select id="ids_syphilis" name="infectious_disease_screening.syphilis_screen">
                <option value="" {% if infectious_disease_screening.syphilisScreen == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.syphilisScreen == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.syphilisScreen == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.syphilisScreen == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ids_toxo">Toxoplasma</label>
            <select id="ids_toxo" name="infectious_disease_screening.toxoplasma_status">
                <option value="" {% if infectious_disease_screening.toxoplasmaStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.toxoplasmaStatus == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.toxoplasmaStatus == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.toxoplasmaStatus == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_tb">Tuberculosis</label>
            <select id="ids_tb" name="infectious_disease_screening.tuberculosis_screen">
                <option value="" {% if infectious_disease_screening.tuberculosisScreen == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if infectious_disease_screening.tuberculosisScreen == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if infectious_disease_screening.tuberculosisScreen == "positive" %}selected{% endif %}>Positive</option>
                <option value="pending" {% if infectious_disease_screening.tuberculosisScreen == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ids_recent_travel">Recent travel?</label>
            <select id="ids_recent_travel" name="infectious_disease_screening.recent_travel">
                <option value="" {% if infectious_disease_screening.recentTravel == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if infectious_disease_screening.recentTravel == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if infectious_disease_screening.recentTravel == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_travel_details">Travel details</label>
            <input type="text" id="ids_travel_details" name="infectious_disease_screening.travel_details"
                   value="{{ infectious_disease_screening.travelDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ids_recent_infection">Recent infection?</label>
            <select id="ids_recent_infection" name="infectious_disease_screening.recent_infection">
                <option value="" {% if infectious_disease_screening.recentInfection == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if infectious_disease_screening.recentInfection == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if infectious_disease_screening.recentInfection == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ids_infection_details">Infection details</label>
            <input type="text" id="ids_infection_details" name="infectious_disease_screening.infection_details"
                   value="{{ infectious_disease_screening.infectionDetails }}">
        </div>
    </div>
</div>
