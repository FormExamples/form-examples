<div class="card">
    <h2>Step 9: Ethical &amp; Legal Requirements</h2>
    <p class="form-hint">HTA Act 2004 compliance, independent assessor, informed consent, financial-reward check.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="el_hta">HTA Act 2004 compliant?</label>
            <select id="el_hta" name="ethical_legal_requirements.hta_act_2004_compliant">
                <option value="" {% if ethical_legal_requirements.htaAct2004Compliant == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.htaAct2004Compliant == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.htaAct2004Compliant == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_ia_review">Independent assessor review?</label>
            <select id="el_ia_review" name="ethical_legal_requirements.independent_assessor_review">
                <option value="" {% if ethical_legal_requirements.independentAssessorReview == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.independentAssessorReview == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.independentAssessorReview == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="el_ia_name">Independent assessor name</label>
            <input type="text" id="el_ia_name" name="ethical_legal_requirements.independent_assessor_name"
                   value="{{ ethical_legal_requirements.independentAssessorName }}">
        </div>
        <div class="form-group">
            <label for="el_ia_date">Independent assessor date</label>
            <input type="date" id="el_ia_date" name="ethical_legal_requirements.independent_assessor_date"
                   value="{{ ethical_legal_requirements.independentAssessorDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="el_consent_given">Informed consent given?</label>
            <select id="el_consent_given" name="ethical_legal_requirements.informed_consent_given">
                <option value="" {% if ethical_legal_requirements.informedConsentGiven == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.informedConsentGiven == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.informedConsentGiven == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_consent_form_signed">Consent form signed?</label>
            <select id="el_consent_form_signed" name="ethical_legal_requirements.consent_form_signed">
                <option value="" {% if ethical_legal_requirements.consentFormSigned == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.consentFormSigned == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.consentFormSigned == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_consent_date">Consent date</label>
            <input type="date" id="el_consent_date" name="ethical_legal_requirements.consent_date"
                   value="{{ ethical_legal_requirements.consentDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="el_witness_name">Witness name</label>
            <input type="text" id="el_witness_name" name="ethical_legal_requirements.witness_name"
                   value="{{ ethical_legal_requirements.witnessName }}">
        </div>
        <div class="form-group">
            <label for="el_witness_role">Witness role</label>
            <input type="text" id="el_witness_role" name="ethical_legal_requirements.witness_role"
                   value="{{ ethical_legal_requirements.witnessRole }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="el_leaflet">Information leaflet provided?</label>
            <select id="el_leaflet" name="ethical_legal_requirements.information_leaflet_provided">
                <option value="" {% if ethical_legal_requirements.informationLeafletProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.informationLeafletProvided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.informationLeafletProvided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_questions">Questions answered?</label>
            <select id="el_questions" name="ethical_legal_requirements.questions_answered">
                <option value="" {% if ethical_legal_requirements.questionsAnswered == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.questionsAnswered == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.questionsAnswered == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_financial">Financial reward check satisfied?</label>
            <select id="el_financial" name="ethical_legal_requirements.financial_reward_check">
                <option value="" {% if ethical_legal_requirements.financialRewardCheck == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.financialRewardCheck == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.financialRewardCheck == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="el_ethics_committee">Ethics committee approval?</label>
            <select id="el_ethics_committee" name="ethical_legal_requirements.ethics_committee_approval">
                <option value="" {% if ethical_legal_requirements.ethicsCommitteeApproval == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if ethical_legal_requirements.ethicsCommitteeApproval == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if ethical_legal_requirements.ethicsCommitteeApproval == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="el_ethics_ref">Ethics approval reference</label>
            <input type="text" id="el_ethics_ref" name="ethical_legal_requirements.ethics_approval_reference"
                   value="{{ ethical_legal_requirements.ethicsApprovalReference }}">
        </div>
    </div>
</div>
