<div class="card">
    <h2>Step 6: Immunological Assessment</h2>
    <p class="form-hint">ABO compatibility, HLA typing, crossmatch, and antibody status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="imm_donor_blood_group">Donor blood group</label>
            <input type="text" id="imm_donor_blood_group" name="immunological_assessment.donor_blood_group"
                   value="{{ immunological_assessment.donorBloodGroup }}" placeholder="e.g. A+, O-">
        </div>
        <div class="form-group">
            <label for="imm_recipient_blood_group">Recipient blood group</label>
            <input type="text" id="imm_recipient_blood_group" name="immunological_assessment.recipient_blood_group"
                   value="{{ immunological_assessment.recipientBloodGroup }}">
        </div>
        <div class="form-group">
            <label for="imm_abo_compatibility">ABO compatibility</label>
            <select id="imm_abo_compatibility" name="immunological_assessment.abo_compatibility">
                <option value="" {% if immunological_assessment.aboCompatibility == "" %}selected{% endif %}>&mdash;</option>
                <option value="compatible" {% if immunological_assessment.aboCompatibility == "compatible" %}selected{% endif %}>Compatible</option>
                <option value="incompatible" {% if immunological_assessment.aboCompatibility == "incompatible" %}selected{% endif %}>Incompatible</option>
                <option value="pending" {% if immunological_assessment.aboCompatibility == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="imm_hla_a">HLA A</label>
            <input type="text" id="imm_hla_a" name="immunological_assessment.hla_a" value="{{ immunological_assessment.hlaA }}">
        </div>
        <div class="form-group">
            <label for="imm_hla_b">HLA B</label>
            <input type="text" id="imm_hla_b" name="immunological_assessment.hla_b" value="{{ immunological_assessment.hlaB }}">
        </div>
        <div class="form-group">
            <label for="imm_hla_c">HLA C</label>
            <input type="text" id="imm_hla_c" name="immunological_assessment.hla_c" value="{{ immunological_assessment.hlaC }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="imm_hla_dr">HLA DR</label>
            <input type="text" id="imm_hla_dr" name="immunological_assessment.hla_dr" value="{{ immunological_assessment.hlaDr }}">
        </div>
        <div class="form-group">
            <label for="imm_hla_dq">HLA DQ</label>
            <input type="text" id="imm_hla_dq" name="immunological_assessment.hla_dq" value="{{ immunological_assessment.hlaDq }}">
        </div>
        <div class="form-group">
            <label for="imm_hla_dp">HLA DP</label>
            <input type="text" id="imm_hla_dp" name="immunological_assessment.hla_dp" value="{{ immunological_assessment.hlaDp }}">
        </div>
        <div class="form-group">
            <label for="imm_hla_match">Match level</label>
            <input type="text" id="imm_hla_match" name="immunological_assessment.hla_match_level"
                   value="{{ immunological_assessment.hlaMatchLevel }}" placeholder="e.g. 6/6, haploidentical">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="imm_crossmatch">Crossmatch result</label>
            <select id="imm_crossmatch" name="immunological_assessment.crossmatch_result">
                <option value="" {% if immunological_assessment.crossmatchResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="compatible" {% if immunological_assessment.crossmatchResult == "compatible" %}selected{% endif %}>Compatible</option>
                <option value="incompatible" {% if immunological_assessment.crossmatchResult == "incompatible" %}selected{% endif %}>Incompatible</option>
                <option value="pending" {% if immunological_assessment.crossmatchResult == "pending" %}selected{% endif %}>Pending</option>
            </select>
        </div>
        <div class="form-group">
            <label for="imm_pra">PRA (%)</label>
            <input type="number" step="0.1" id="imm_pra" name="immunological_assessment.pra"
                   value="{{ immunological_assessment.pra }}">
        </div>
        <div class="form-group">
            <label for="imm_dsa">Donor-specific antibodies?</label>
            <select id="imm_dsa" name="immunological_assessment.donor_specific_antibodies">
                <option value="" {% if immunological_assessment.donorSpecificAntibodies == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if immunological_assessment.donorSpecificAntibodies == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if immunological_assessment.donorSpecificAntibodies == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="imm_dsa_details">DSA details</label>
        <input type="text" id="imm_dsa_details" name="immunological_assessment.dsa_details"
               value="{{ immunological_assessment.dsaDetails }}">
    </div>
</div>
