{% extends "base.html.tera" %}

{% block title %}Organ Donation Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Organ Donation Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Donor name, intended organs, or assessor...">
    </div>
    <div class="form-group">
        <label for="eligibility">Eligibility</label>
        <select id="eligibility" name="eligibility">
            <option value="">All</option>
            <option value="suitable" {% if eligibility == "suitable" %}selected{% endif %}>Suitable</option>
            <option value="conditionally-suitable" {% if eligibility == "conditionally-suitable" %}selected{% endif %}>Conditionally Suitable</option>
            <option value="unsuitable" {% if eligibility == "unsuitable" %}selected{% endif %}>Unsuitable</option>
        </select>
    </div>
    <div class="form-group">
        <label for="risk_level">Risk Level</label>
        <select id="risk_level" name="risk_level">
            <option value="">All</option>
            <option value="low" {% if risk_level == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if risk_level == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if risk_level == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if risk_level == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="donor_type">Donor Type</label>
        <select id="donor_type" name="donor_type">
            <option value="">All</option>
            <option value="living" {% if donor_type == "living" %}selected{% endif %}>Living</option>
            <option value="deceased" {% if donor_type == "deceased" %}selected{% endif %}>Deceased</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Assessment Date</th>
            <th>Donor</th>
            <th>Donor Type</th>
            <th>Intended Organs</th>
            <th>Assessor</th>
            <th>Eligibility</th>
            <th>Risk Level</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.assessmentDate }}</a></td>
            <td>{{ c.donorName }}<br><small>DOB {{ c.dateOfBirth }}</small></td>
            <td>{{ c.donorType }}</td>
            <td>{{ c.intendedOrgans }}</td>
            <td>{{ c.assessorName }}</td>
            <td><span class="eligibility-badge eligibility-{{ c.eligibility }}">{{ c.eligibility }}</span></td>
            <td><span class="risk-badge risk-{{ c.riskLevel }}">{{ c.riskLevel }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
