{% extends "base.html.tera" %}

{% block title %}Organ Donation Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Organ Donation Assessment</h1>
        <p class="landing-description">
            Structured assessment of potential organ donors (living and deceased). Evaluates
            medical suitability, organ function, immunological compatibility, and ethical /
            consent requirements using a Donor Risk Index and organ-specific suitability scoring.
            The output is a signed, timestamped record with eligibility decision, risk level,
            and a list of fired rules and safety flags.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Steps</h3>
                <p>Demographics, donor type and registration, medical history, organ function, infectious disease, immunological, surgical, psychological, ethical and legal, eligibility decision.</p>
            </div>
            <div class="feature">
                <h3>Eligibility Grading</h3>
                <p>Suitable, conditionally suitable, or unsuitable &mdash; with risk level low, moderate, high, or critical.</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for ABO incompatibility, positive infectious-disease screens, malignancy, coercion, missing consent, and more.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
