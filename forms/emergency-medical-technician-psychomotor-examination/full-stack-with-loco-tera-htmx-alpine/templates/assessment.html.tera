{% extends "base.html.tera" %}

{% block title %}EMT Psychomotor Examination - Examiner{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>EMT Psychomotor Examination</h1>
    <p class="form-hint">
        Complete all six sections (Candidate details, Scene Size-Up, Primary Survey,
        History &amp; Secondary, Reassessment, Critical Criteria Review) and submit
        to grade the candidate.
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}
    {% include "assessment/step04.html.tera" %}
    {% include "assessment/step05.html.tera" %}
    {% include "assessment/step06.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Grade and View Report</button>
    </div>
</form>
{% endblock %}
