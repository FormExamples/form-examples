{% extends "base.html.tera" %}

{% block title %}Examination Report - {{ outcome_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>EMT Psychomotor Examination &mdash; Candidate Report</h1>
    <div class="outcome-{{ outcome }}">{{ outcome_label }}</div>
    <div class="checklist-label">Score: {{ points }} / {{ max_points }} ({{ percent | round(precision=0) }}%)</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Examination ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Candidate Summary -->
<div class="card">
    <h2>Candidate &amp; Scenario</h2>
    <div class="form-row">
        <div>
            <strong>Candidate:</strong> {{ data.candidateExaminerScenario.candidateFirstName }} {{ data.candidateExaminerScenario.candidateLastName }}<br>
            <strong>Candidate ID:</strong> {{ data.candidateExaminerScenario.candidateId }}<br>
            <strong>Attempt:</strong> {{ data.candidateExaminerScenario.attempt }}<br>
            <strong>Session Date:</strong> {{ data.candidateExaminerScenario.sessionDate }}
        </div>
        <div>
            <strong>Examiner:</strong> {{ data.candidateExaminerScenario.examinerName }}<br>
            <strong>Station:</strong> {{ data.candidateExaminerScenario.stationLocation }}<br>
            <strong>Chief Complaint:</strong> {{ data.candidateExaminerScenario.chiefComplaintGiven }}
        </div>
    </div>
    {% if data.candidateExaminerScenario.scenarioSummary %}
    <p><strong>Scenario:</strong> {{ data.candidateExaminerScenario.scenarioSummary }}</p>
    {% endif %}
</div>

<!-- Score summary -->
<div class="card">
    <h2>Score Summary</h2>
    <p>
        <strong>{{ answered_count }}</strong> of <strong>{{ total_rules }}</strong> rules assessed.
        Awarded <strong>{{ points }}</strong> of <strong>{{ max_points }}</strong> available points
        ({{ percent | round(precision=0) }}%). Pass threshold: 80% and no critical-criterion failure.
    </p>
</div>

<!-- Critical failures -->
{% if critical_failures | length > 0 %}
<div class="card">
    <h2>Critical-Criterion Failures ({{ critical_failures | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in critical_failures %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Per-rule audit trail -->
<div class="card">
    <h2>Audit Trail</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
                <th>Critical</th>
                <th>Status</th>
                <th>Points</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{% if rule.critical %}<span class="severity-badge severity-critical">critical</span>{% endif %}</td>
                <td>{{ rule.status }}</td>
                <td>{{ rule.pointsAwarded }} / {{ rule.points }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Examination</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
