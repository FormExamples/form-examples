<div class="card">
    <h2>Step 4: History &amp; Secondary Assessment</h2>
    <p class="form-hint">Chief complaint, OPQRST, SAMPLE history, focused exam, baseline vitals, field impression, and interventions.</p>

    <h3>History</h3>
    <div class="form-group">
        <label for="chief_complaint">Chief complaint elicited</label>
        <select id="chief_complaint" name="history_secondary_assessment.chief_complaint">
            <option value="" {% if history_secondary_assessment.chiefComplaint == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if history_secondary_assessment.chiefComplaint == "yes" %}selected{% endif %}>Performed</option>
            <option value="no" {% if history_secondary_assessment.chiefComplaint == "no" %}selected{% endif %}>Not performed</option>
            <option value="na" {% if history_secondary_assessment.chiefComplaint == "na" %}selected{% endif %}>Not applicable</option>
        </select>
    </div>

    <div class="form-group">
        <label for="history_onset_opqrst">OPQRST of present illness</label>
        <select id="history_onset_opqrst" name="history_secondary_assessment.history_onset_opqrst">
            <option value="" {% if history_secondary_assessment.historyOnsetOpqrst == "" %}selected{% endif %}>&mdash;</option>
