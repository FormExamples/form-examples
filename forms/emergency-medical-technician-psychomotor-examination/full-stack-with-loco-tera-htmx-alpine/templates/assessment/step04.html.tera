                <option value="no" {% if history_secondary_assessment.sampleSignsSymptoms == "no" %}selected{% endif %}>Not performed</option>
                <option value="na" {% if history_secondary_assessment.sampleSignsSymptoms == "na" %}selected{% endif %}>Not applicable</option>
