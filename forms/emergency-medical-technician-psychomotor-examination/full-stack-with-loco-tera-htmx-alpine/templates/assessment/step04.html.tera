    <div class="form-group">
        <label for="interventions">Interventions initiated &amp; care plan verbalized</label>
        <select id="interventions" name="history_secondary_assessment.interventions">
            <option value="" {% if history_secondary_assessment.interventions == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if history_secondary_assessment.interventions == "yes" %}selected{% endif %}>Performed</option>
            <option value="no" {% if history_secondary_assessment.interventions == "no" %}selected{% endif %}>Not performed</option>
