<div class="card">
    <h2>Step 1: Recipient Details</h2>
    <p class="form-hint">Enter the details of the person acknowledging the code of conduct.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="organisation_name">Organisation Name</label>
            <input type="text" id="organisation_name" name="recipient_details.organisation_name"
                   value="{{ recipient_details.organisationName }}"
                   placeholder="e.g. Riverside Medical Practice" required>
        </div>
        <div class="form-group">
            <label for="recipient_name">Recipient Name</label>
            <input type="text" id="recipient_name" name="recipient_details.recipient_name"
                   value="{{ recipient_details.recipientName }}"
                   placeholder="e.g. Dr Jane Smith" required>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recipient_role">Recipient Role</label>
            <input type="text" id="recipient_role" name="recipient_details.recipient_role"
                   value="{{ recipient_details.recipientRole }}"
                   placeholder="e.g. General Practitioner, Healthcare Assistant, Contractor"
                   required>
        </div>
        <div class="form-group">
            <label for="recipient_employee_id">Employee / Contractor ID (optional)</label>
            <input type="text" id="recipient_employee_id" name="recipient_details.recipient_employee_id"
                   value="{{ recipient_details.recipientEmployeeId }}"
                   placeholder="e.g. 4827">
        </div>
    </div>
</div>
