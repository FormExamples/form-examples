<div class="card">
    <h2>Step 3: Acknowledgement &amp; Signature</h2>
    <p class="form-hint">Please confirm you have read and understood the code of conduct.</p>

    <div class="form-group">
        <label class="ack-checkbox" for="agreed">
            <input type="checkbox" id="agreed" name="acknowledgement_signature.agreed"
                   value="on"
                   {% if acknowledgement_signature.agreed %}checked{% endif %}>
            <span class="ack-checkbox-text">
                I have read, understood, and agree to uphold the above Code of Conduct
                principles. I will abide by these principles in every professional
                interaction with patients and colleagues.
            </span>
        </label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recipient_typed_full_name">Full Name</label>
            <input type="text" id="recipient_typed_full_name"
                   name="acknowledgement_signature.recipient_typed_full_name"
                   value="{{ acknowledgement_signature.recipientTypedFullName }}"
                   placeholder="Type your full name" required>
        </div>
        <div class="form-group">
            <label for="recipient_typed_date">Today&rsquo;s Date</label>
            <input type="date" id="recipient_typed_date"
                   name="acknowledgement_signature.recipient_typed_date"
                   value="{{ acknowledgement_signature.recipientTypedDate }}" required>
        </div>
    </div>
</div>
