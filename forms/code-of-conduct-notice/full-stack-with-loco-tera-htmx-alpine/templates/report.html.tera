{% extends "base.html.tera" %}

{% block title %}Acknowledgement Report - {{ status }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Code of Conduct Acknowledgement &mdash; Report</h1>
    <div class="status-badge status-{{ acknowledgement_status }}">{{ acknowledgement_status_label }}</div>
    <div class="completeness-label">{{ completeness_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Acknowledgement ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Recipient Summary -->
<div class="card">
    <h2>Recipient</h2>
    <div class="form-row">
        <div>
            <strong>Organisation:</strong> {{ data.recipientDetails.organisationName }}<br>
            <strong>Recipient Name:</strong> {{ data.recipientDetails.recipientName }}<br>
            <strong>Recipient Role:</strong> {{ data.recipientDetails.recipientRole }}<br>
            {% if data.recipientDetails.recipientEmployeeId %}
            <strong>Employee / Contractor ID:</strong> {{ data.recipientDetails.recipientEmployeeId }}<br>
            {% endif %}
        </div>
        <div>
            <strong>Acknowledgement:</strong>
            {% if data.acknowledgementSignature.agreed %}
                <span class="badge badge-yes">Agreed</span>
            {% else %}
                <span class="badge badge-no">Not agreed</span>
            {% endif %}<br>
            <strong>Typed Full Name:</strong> {{ data.acknowledgementSignature.recipientTypedFullName }}<br>
            <strong>Typed Date:</strong> {{ data.acknowledgementSignature.recipientTypedDate }}
        </div>
    </div>
</div>

<!-- Validation summary -->
<div class="card">
    <h2>Validation Summary</h2>
    <p>
        Overall status: <strong>{{ status }}</strong> &mdash;
        {{ completeness_percent }}% of required fields completed
        ({{ fired_rules | length }} outstanding).
    </p>
</div>

<!-- Safety / Compliance Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-priority">{{ flag.priority | upper }}</span>
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Outstanding fields -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Outstanding Required Fields ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Section</th>
                <th>Field</th>
                <th>Validation message</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.section }}</td>
                <td>{{ rule.field }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Acknowledgement</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
