{% extends "base.html.tera" %}

{% block title %}Code of Conduct Notice - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Code of Conduct Notice</h1>
        <p class="landing-description">
            Read-and-acknowledge attestation that presents the twelve core principles that
            medical-service providers, employed staff, contractors, eligible family members,
            and re-employed annuitants must uphold. The recipient reads each principle in
            full, then captures their acknowledgement by ticking the agreement checkbox,
            typing their full name, and entering today&rsquo;s date.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Three Steps</h3>
                <p>Recipient Details &rarr; Code of Conduct Notice &rarr; Acknowledgement &amp; Signature</p>
            </div>
            <div class="feature">
                <h3>Completeness Validation</h3>
                <p>Acknowledgement is <em>Complete</em> only when the checkbox is ticked and both name and date are recorded</p>
            </div>
            <div class="feature">
                <h3>Compliance Flags</h3>
                <p>Highlights missing acknowledgement, incomplete typed name, and missing recipient metadata</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Acknowledgement
            </button>
        </form>
    </div>
</div>
{% endblock %}
