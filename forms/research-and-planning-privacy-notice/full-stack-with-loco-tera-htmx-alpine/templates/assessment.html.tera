{% extends "base.html.tera" %}

{% block title %}Research and Planning Privacy Notice - Acknowledgement{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>Research and Planning Privacy Notice</h1>
    <p class="form-hint">
        Complete all three sections (Recipient Details, Privacy Notice, Acknowledgement)
        and submit to record your acknowledgement and opt-out preferences. All fields
        marked with <span class="req" aria-hidden="true">*</span> are required.
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Submit Acknowledgement</button>
    </div>
</form>
{% endblock %}
