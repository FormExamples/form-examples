{% extends "base.html.tera" %}

{% block title %}Acknowledgement Report - {{ status }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Research and Planning Privacy Notice &mdash; Acknowledgement Report</h1>
    <div class="status-badge status-{{ ack_status }}">{{ ack_status_label }}</div>
    <div class="completeness-pct">Overall completeness: {{ completeness_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Record ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Recipient summary -->
<div class="card">
    <h2>Recipient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Organisation:</strong> {{ data.recipientDetails.organisationName }}<br>
            <strong>Recipient:</strong> {{ data.recipientDetails.recipientName }}<br>
            <strong>NHS Number:</strong> {{ data.recipientDetails.recipientNhsNumber }}<br>
            <strong>Date of Birth:</strong> {{ data.recipientDetails.recipientDob }}
        </div>
        <div>
            <strong>Signed Name:</strong> {{ data.acknowledgementSignature.recipientTypedFullName }}<br>
            <strong>Signed Date:</strong> {{ data.acknowledgementSignature.recipientTypedDate }}<br>
            <strong>Acknowledged:</strong>
            {% if data.acknowledgementSignature.agreed %}
                <span class="badge badge-yes">Yes</span>
            {% else %}
                <span class="badge badge-no">No</span>
            {% endif %}<br>
            <strong>Validation Status:</strong> {{ status }}
        </div>
    </div>
</div>

<!-- Opt-out preferences -->
<div class="card">
    <h2>Opt-Out Preferences</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Preference</th>
                <th>Choice</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Type 1 opt-out (from this practice)</td>
                <td>{{ data.acknowledgementSignature.type1OptOut }}</td>
            </tr>
            <tr>
                <td>NHS National Data Opt-Out</td>
                <td>{{ data.acknowledgementSignature.nationalDataOptOut }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Flagged issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-priority">{{ flag.priority | upper }}</span>
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules / unanswered items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Outstanding Required Fields ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Section</th>
                <th>Field</th>
                <th>Validation message</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.section }}</td>
                <td>{{ rule.field }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="card">
    <p class="muted">All required fields completed.</p>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Acknowledgement</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
