{% extends "base.html.tera" %}

{% block title %}Research and Planning Privacy Notice - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Research and Planning Privacy Notice</h1>
        <p class="landing-description">
            Read-and-acknowledge privacy notice covering the use of patient data for
            research and service-planning purposes, aligned with the UK GDPR, the
            Data Protection Act 2018, the Common Law Duty of Confidentiality, and
            the NHS National Data Opt-Out framework. The completed record is a
            timestamped acknowledgement of the recipient's opt-out preferences and
            signature.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Three Steps</h3>
                <p>Recipient details, the privacy notice itself, and an opt-out preference and acknowledgement signature</p>
            </div>
            <div class="feature">
                <h3>Two Opt-Out Choices</h3>
                <p>Type 1 opt-out (from this practice) and the NHS National Data Opt-Out, captured separately</p>
            </div>
            <div class="feature">
                <h3>Governance Flags</h3>
                <p>Real-time flags for declined acknowledgements, opt-outs elected, and incomplete recipient metadata</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Acknowledgement
            </button>
        </form>
    </div>
</div>
{% endblock %}
