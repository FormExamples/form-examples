<div class="card">
    <h2>Step 1: Recipient Details</h2>
    <p class="form-hint">Enter the details of the patient acknowledging the research and planning privacy notice.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="recipient_details_organisation_name">Organisation Name <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="recipient_details_organisation_name" name="recipient_details.organisation_name"
                   value="{{ recipient_details.organisationName }}" placeholder="e.g. Riverside Medical Practice" required>
        </div>
        <div class="form-group">
            <label for="recipient_details_recipient_name">Recipient Name <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="recipient_details_recipient_name" name="recipient_details.recipient_name"
                   value="{{ recipient_details.recipientName }}" placeholder="e.g. Mrs Jane Smith" required>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recipient_details_recipient_nhs_number">NHS Number (optional)</label>
            <input type="text" id="recipient_details_recipient_nhs_number" name="recipient_details.recipient_nhs_number"
                   value="{{ recipient_details.recipientNhsNumber }}" placeholder="e.g. 943 476 5919">
        </div>
        <div class="form-group">
            <label for="recipient_details_recipient_dob">Date of Birth (optional)</label>
            <input type="date" id="recipient_details_recipient_dob" name="recipient_details.recipient_dob"
                   value="{{ recipient_details.recipientDob }}">
        </div>
    </div>
</div>
