#!/bin/sh
set -euf

form_kebab_case=bowel-cancer-screening-with-faecal-immunochemical-test
form_snake_case=bowel_cancer_screening_with_faecal_immunochemical_test

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold bowel_cancer_screening_fit \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    reviewed_at:tstz \
    screening_hub:string! \
    participant_identifier:string! \
    age:int \
    within_age_range:string! \
    recall_interval:string! \
    invitation_date:date \
    previous_outcome:string! \
    last_screen_date:date \
    kit_returned:string! \
    return_date:date \
    sample_adequacy:string! \
    spoilt_reason:string! \
    faecal_haemoglobin_ug_g:double \
    assay:string! \
    threshold_applied:double \
    red_flag_symptoms:string! \
    clinical_note:text! \
    context:text! \
    --api

cargo loco generate scaffold bowel_cancer_screening_fit_grade \
    deleted_at:tstz \
    bowel_cancer_screening_fit:references \
    result_class:string! \
    management_action:string! \
    symptomatic_pathway:bool! \
    status:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold bowel_cancer_screening_fit_grade_rule \
    deleted_at:tstz \
    bowel_cancer_screening_fit_grade:references \
    rule_id:string! \
    stage:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold bowel_cancer_screening_fit_grade_flag \
    deleted_at:tstz \
    bowel_cancer_screening_fit_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
