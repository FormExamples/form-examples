    notes:text! \
    --api

cargo loco generate scaffold inpatient_clinical_note_investigation \
    deleted_at:tstz \
    inpatient_clinical_note:references \
    sort_order:int! \
    test_name:string! \
    category:string! \
    requested_date:date \
