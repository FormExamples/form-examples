    --api

cargo loco generate scaffold inpatient_clinical_note_medication_change \
    deleted_at:tstz \
    inpatient_clinical_note:references \
    sort_order:int! \
    drug_name:string! \
    action:string! \
    dose:string! \
    route:string! \
    frequency:string! \
    indication:string! \
    is_antimicrobial:string! \
    review_date:date \
    stop_date:date \
