#!/bin/sh
set -euf

form_kebab_case=inpatient-clinical-note
form_snake_case=inpatient_clinical_note

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    grade:string! \
    specialty:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold inpatient_clinical_note \
    deleted_at:tstz \
    patient:references \
    author:references \
    responsible_consultant:references \
    status:string! \
    note_type:string! \
    hospital_name:string! \
    ward_name:string! \
    bed_number:string! \
    note_at:tstz \
    author_name:string! \
    author_grade:string! \
    author_registration_number:string! \
    parent_specialty:string! \
    responsible_consultant_name:string! \
    consult_question:text! \
    consult_requesting_team:string! \
    procedure_performed:string! \
    procedure_detail:text! \
    procedure_consent:string! \
    procedure_complications:text! \
    transfer_from_ward:string! \
    transfer_to_ward:string! \
    transfer_reason:text! \
    admission_at:tstz \
    admitting_specialty:string! \
    admission_method:string! \
    admission_reason:text! \
    interval_history:text! \
    no_interval_events:string! \
    overnight_events:text! \
    patient_reported_symptoms:text! \
    nursing_concerns:text! \
    pain_score:int \
    sleep_quality:string! \
    oral_intake:string! \
    bowels_last_opened:date \
    mobility_status:string! \
    observed_at:tstz \
    respiratory_rate:int \
    oxygen_saturation:int \
    spo2_scale:string! \
    oxygen_delivery:string! \
    oxygen_flow_litres_per_minute:double \
    systolic_blood_pressure:int \
    diastolic_blood_pressure:int \
    pulse_rate:int \
    acvpu:string! \
    temperature_celsius:double \
    news2_total:int \
    news2_derived_total:int \
    news2_trend:string! \
    news2_applicable:string! \
    news2_not_applicable_reason:string! \
    examination_general:text! \
    examination_cardiovascular:text! \
    examination_respiratory:text! \
    examination_abdominal:text! \
    examination_neurological:text! \
    examination_musculoskeletal:text! \
    examination_skin_and_wounds:text! \
    examination_lines_and_drains:text! \
    examination_other:text! \
    no_investigations_reviewed:string! \
    no_medication_changes:string! \
    allergy_checked:string! \
