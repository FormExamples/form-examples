    capacity_notes:text! \
    author_override_acuity:string! \
    author_override_reason:text! \
    attestation_text:text! \
    electronic_signature:text! \
    signed_at:tstz \
    --api

cargo loco generate scaffold inpatient_clinical_note_problem \
    deleted_at:tstz \
    inpatient_clinical_note:references \
    sort_order:int! \
    problem:string! \
    category:string! \
    status:string! \
    priority:string! \
    onset_date:date \
    snomed_code:string! \
