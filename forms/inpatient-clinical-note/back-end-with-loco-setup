    pressure_ulcer_sites:string! \
    delirium_screen:string! \
    delirium_4at_score:int \
    delirium_notes:text! \
    nutrition_screen:string! \
    must_score:int \
    nutrition_plan:text! \
    infection_status:string! \
    isolation_status:string! \
    organism:string! \
    infection_precautions:text! \
    safeguarding_concern:string! \
    safeguarding_notes:text! \
    safeguarding_referral_made:string! \
    clinical_impression:text! \
    differential_diagnosis:text! \
    response_to_treatment:string! \
    new_oxygen_requirement:string! \
    new_confusion:string! \
