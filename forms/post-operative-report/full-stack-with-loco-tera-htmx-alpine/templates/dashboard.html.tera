{% extends "base.html.tera" %}

{% block title %}Post-Operative Report - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Post-Operative Reports Dashboard</h1>
    <a href="/" class="btn btn-primary">New Report</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, MRN, or procedure...">
    </div>
    <div class="form-group">
        <label for="overall_grade">Overall Grade</label>
        <select id="overall_grade" name="overall_grade">
            <option value="">All</option>
            <option value="grade-0" {% if overall_grade == "grade-0" %}selected{% endif %}>Grade 0</option>
            <option value="grade-i" {% if overall_grade == "grade-i" %}selected{% endif %}>Grade I</option>
            <option value="grade-ii" {% if overall_grade == "grade-ii" %}selected{% endif %}>Grade II</option>
            <option value="grade-iiia" {% if overall_grade == "grade-iiia" %}selected{% endif %}>Grade IIIa</option>
            <option value="grade-iiib" {% if overall_grade == "grade-iiib" %}selected{% endif %}>Grade IIIb</option>
            <option value="grade-iva" {% if overall_grade == "grade-iva" %}selected{% endif %}>Grade IVa</option>
            <option value="grade-ivb" {% if overall_grade == "grade-ivb" %}selected{% endif %}>Grade IVb</option>
            <option value="grade-v" {% if overall_grade == "grade-v" %}selected{% endif %}>Grade V</option>
        </select>
    </div>
    <div class="form-group">
        <label for="priority">Priority</label>
        <select id="priority" name="priority">
            <option value="">All</option>
            <option value="elective" {% if priority == "elective" %}selected{% endif %}>Elective</option>
            <option value="urgent" {% if priority == "urgent" %}selected{% endif %}>Urgent</option>
            <option value="emergency" {% if priority == "emergency" %}selected{% endif %}>Emergency</option>
        </select>
    </div>
    <div class="form-group">
        <label for="disposition">Disposition</label>
        <select id="disposition" name="disposition">
            <option value="">All</option>
            <option value="recovery" {% if disposition == "recovery" %}selected{% endif %}>Recovery</option>
            <option value="ward" {% if disposition == "ward" %}selected{% endif %}>Ward</option>
            <option value="hdu" {% if disposition == "hdu" %}selected{% endif %}>HDU</option>
            <option value="icu" {% if disposition == "icu" %}selected{% endif %}>ICU</option>
            <option value="home" {% if disposition == "home" %}selected{% endif %}>Home</option>
            <option value="theatre" {% if disposition == "theatre" %}selected{% endif %}>Theatre</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent_flags">Urgent Flags</label>
        <select id="has_urgent_flags" name="has_urgent_flags">
            <option value="">All</option>
            <option value="yes" {% if has_urgent_flags == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent_flags == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed report{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Patient</th>
            <th>Procedure</th>
            <th>Priority</th>
            <th>ASA</th>
            <th>Surgeon</th>
            <th>Disposition</th>
            <th>Overall Grade</th>
            <th>Complications</th>
            <th>Urgent Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.dateOfSurgery }}</a></td>
            <td>{{ c.patientName }}<br><small>{{ c.mrn }}</small></td>
            <td>{{ c.procedureName }}</td>
            <td>{{ c.procedurePriority }}</td>
            <td>{{ c.asaGrade }}</td>
            <td>{{ c.primarySurgeon }}</td>
            <td>{{ c.disposition }}</td>
            <td><span class="grade-badge grade-{{ c.overallGrade }}">{{ c.overallGrade }}</span></td>
            <td>{{ c.complicationCount }}</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed reports found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
