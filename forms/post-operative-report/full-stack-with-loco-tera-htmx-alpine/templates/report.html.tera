{% extends "base.html.tera" %}

{% block title %}Post-Operative Report - {{ overall_grade_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Post-Operative Report</h1>
    <div class="grade-badge grade-{{ overall_grade_badge_class }}">{{ overall_grade_label }}</div>
    <div class="grade-label">Complications recorded: {{ complication_count }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Case Summary -->
<div class="card">
    <h2>Case Summary</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.patientDetails.firstName }} {{ data.patientDetails.lastName }}<br>
            <strong>MRN:</strong> {{ data.patientDetails.mrn }}<br>
            <strong>Date of Birth:</strong> {{ data.patientDetails.dateOfBirth }}<br>
            <strong>ASA Grade:</strong> {{ data.patientDetails.asaGrade }}<br>
            <strong>Allergies:</strong> {{ data.patientDetails.allergies }}
        </div>
        <div>
            <strong>Procedure:</strong> {{ data.procedureDetails.procedureName }}<br>
            <strong>Date of Surgery:</strong> {{ data.procedureDetails.dateOfSurgery }}<br>
            <strong>Priority:</strong> {{ data.procedureDetails.priority }}<br>
            <strong>Surgeon:</strong> {{ data.surgicalTeam.primarySurgeon }}<br>
            <strong>Anaesthetist:</strong> {{ data.surgicalTeam.primaryAnaesthetist }}
        </div>
    </div>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Complications audit trail -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Complications ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Description</th>
                <th>Grade</th>
                <th>Definition</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td><span class="grade-badge grade-{{ rule.grade }}">{{ rule.grade }}</span></td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Report</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
