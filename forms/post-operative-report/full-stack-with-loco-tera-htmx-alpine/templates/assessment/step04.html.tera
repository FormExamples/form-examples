<div class="card">
    <h2>Step 4: Intra-operative Findings</h2>
    <p class="form-hint">Describe what was found and what was actually performed.</p>

    <div class="form-group">
        <label for="findings">Operative Findings</label>
        <textarea id="findings" name="intraoperative_findings.findings" rows="3">{{ intraoperative_findings.findings }}</textarea>
    </div>

    <div class="form-group">
        <label for="procedure_performed">Procedure Performed</label>
        <textarea id="procedure_performed" name="intraoperative_findings.procedure_performed" rows="3">{{ intraoperative_findings.procedurePerformed }}</textarea>
    </div>

    <div class="form-group">
        <label for="unexpected_findings">Unexpected Findings</label>
        <textarea id="unexpected_findings" name="intraoperative_findings.unexpected_findings" rows="2">{{ intraoperative_findings.unexpectedFindings }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="conversion_to_open">Conversion to Open?</label>
            <select id="conversion_to_open" name="intraoperative_findings.conversion_to_open">
                <option value="" {% if intraoperative_findings.conversionToOpen == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if intraoperative_findings.conversionToOpen == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if intraoperative_findings.conversionToOpen == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="conversion_reason">Conversion Reason</label>
            <input type="text" id="conversion_reason" name="intraoperative_findings.conversion_reason"
                   value="{{ intraoperative_findings.conversionReason }}">
        </div>
    </div>
</div>
