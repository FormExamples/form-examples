<div class="card">
    <h2>Step 6: Estimated Blood Loss &amp; Fluid Balance</h2>
    <p class="form-hint">Quantify intra-operative losses and replacement fluids.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="estimated_blood_loss_ml">Estimated Blood Loss (mL)</label>
            <input type="number" id="estimated_blood_loss_ml" name="blood_loss_fluid_balance.estimated_blood_loss_ml"
                   value="{{ blood_loss_fluid_balance.estimatedBloodLossMl }}">
        </div>
        <div class="form-group">
            <label for="crystalloids_ml">Crystalloids (mL)</label>
            <input type="number" id="crystalloids_ml" name="blood_loss_fluid_balance.crystalloids_ml"
                   value="{{ blood_loss_fluid_balance.crystalloidsMl }}">
        </div>
        <div class="form-group">
            <label for="colloids_ml">Colloids (mL)</label>
            <input type="number" id="colloids_ml" name="blood_loss_fluid_balance.colloids_ml"
                   value="{{ blood_loss_fluid_balance.colloidsMl }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="blood_products_ml">Blood Products (mL)</label>
            <input type="number" id="blood_products_ml" name="blood_loss_fluid_balance.blood_products_ml"
                   value="{{ blood_loss_fluid_balance.bloodProductsMl }}">
        </div>
        <div class="form-group">
            <label for="blood_product_details">Blood Product Details</label>
            <input type="text" id="blood_product_details" name="blood_loss_fluid_balance.blood_product_details"
                   value="{{ blood_loss_fluid_balance.bloodProductDetails }}" placeholder="units of PRBC, FFP, etc.">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="urine_output_ml">Urine Output (mL)</label>
            <input type="number" id="urine_output_ml" name="blood_loss_fluid_balance.urine_output_ml"
                   value="{{ blood_loss_fluid_balance.urineOutputMl }}">
        </div>
        <div class="form-group">
            <label for="other_drains_ml">Other Drains (mL)</label>
            <input type="number" id="other_drains_ml" name="blood_loss_fluid_balance.other_drains_ml"
                   value="{{ blood_loss_fluid_balance.otherDrainsMl }}">
        </div>
    </div>

    <div class="form-group">
        <label for="fluid_notes">Fluid Notes</label>
        <textarea id="fluid_notes" name="blood_loss_fluid_balance.fluid_notes" rows="2">{{ blood_loss_fluid_balance.fluidNotes }}</textarea>
    </div>
</div>
