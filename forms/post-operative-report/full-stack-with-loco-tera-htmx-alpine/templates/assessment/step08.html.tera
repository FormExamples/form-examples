<div class="card">
    <h2>Step 8: Immediate Post-op Status</h2>
    <p class="form-hint">Status on arrival in recovery / handover, plus disposition.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="conscious_level">Conscious Level</label>
            <select id="conscious_level" name="immediate_postop_status.conscious_level">
                <option value="" {% if immediate_postop_status.consciousLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="awake" {% if immediate_postop_status.consciousLevel == "awake" %}selected{% endif %}>Awake</option>
                <option value="drowsy" {% if immediate_postop_status.consciousLevel == "drowsy" %}selected{% endif %}>Drowsy</option>
                <option value="unresponsive" {% if immediate_postop_status.consciousLevel == "unresponsive" %}selected{% endif %}>Unresponsive</option>
                <option value="sedated" {% if immediate_postop_status.consciousLevel == "sedated" %}selected{% endif %}>Sedated</option>
                <option value="intubated" {% if immediate_postop_status.consciousLevel == "intubated" %}selected{% endif %}>Intubated</option>
            </select>
        </div>
        <div class="form-group">
            <label for="disposition">Disposition</label>
            <select id="disposition" name="immediate_postop_status.disposition">
                <option value="" {% if immediate_postop_status.disposition == "" %}selected{% endif %}>&mdash;</option>
                <option value="recovery" {% if immediate_postop_status.disposition == "recovery" %}selected{% endif %}>Recovery</option>
                <option value="ward" {% if immediate_postop_status.disposition == "ward" %}selected{% endif %}>Ward</option>
                <option value="hdu" {% if immediate_postop_status.disposition == "hdu" %}selected{% endif %}>HDU</option>
                <option value="icu" {% if immediate_postop_status.disposition == "icu" %}selected{% endif %}>ICU</option>
                <option value="home" {% if immediate_postop_status.disposition == "home" %}selected{% endif %}>Home</option>
                <option value="theatre" {% if immediate_postop_status.disposition == "theatre" %}selected{% endif %}>Theatre</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="systolic_bp">Systolic BP (mmHg)</label>
            <input type="number" id="systolic_bp" name="immediate_postop_status.systolic_bp"
                   value="{{ immediate_postop_status.systolicBp }}">
        </div>
        <div class="form-group">
            <label for="diastolic_bp">Diastolic BP (mmHg)</label>
            <input type="number" id="diastolic_bp" name="immediate_postop_status.diastolic_bp"
                   value="{{ immediate_postop_status.diastolicBp }}">
        </div>
        <div class="form-group">
            <label for="heart_rate">Heart Rate (bpm)</label>
            <input type="number" id="heart_rate" name="immediate_postop_status.heart_rate"
                   value="{{ immediate_postop_status.heartRate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="respiratory_rate">Respiratory Rate</label>
            <input type="number" id="respiratory_rate" name="immediate_postop_status.respiratory_rate"
                   value="{{ immediate_postop_status.respiratoryRate }}">
        </div>
        <div class="form-group">
            <label for="oxygen_saturation">SpO2 (%)</label>
            <input type="number" id="oxygen_saturation" name="immediate_postop_status.oxygen_saturation"
                   value="{{ immediate_postop_status.oxygenSaturation }}">
        </div>
        <div class="form-group">
            <label for="temperature">Temperature (°C)</label>
            <input type="number" step="0.1" id="temperature" name="immediate_postop_status.temperature"
                   value="{{ immediate_postop_status.temperature }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="pain_score">Pain Score (0-10)</label>
            <input type="number" min="0" max="10" id="pain_score" name="immediate_postop_status.pain_score"
                   value="{{ immediate_postop_status.painScore }}">
        </div>
        <div class="form-group">
            <label for="pain_notes">Pain Notes</label>
            <input type="text" id="pain_notes" name="immediate_postop_status.pain_notes"
                   value="{{ immediate_postop_status.painNotes }}">
        </div>
    </div>
</div>
