<div class="card">
    <h2>Step 3: Surgical Team</h2>
    <p class="form-hint">Primary surgeon, anaesthetist, scrub team, and any additional members.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="primary_surgeon">Primary Surgeon</label>
            <input type="text" id="primary_surgeon" name="surgical_team.primary_surgeon"
                   value="{{ surgical_team.primarySurgeon }}">
        </div>
        <div class="form-group">
            <label for="primary_surgeon_grade">Grade</label>
            <input type="text" id="primary_surgeon_grade" name="surgical_team.primary_surgeon_grade"
                   value="{{ surgical_team.primarySurgeonGrade }}" placeholder="e.g. consultant, registrar">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="primary_anaesthetist">Primary Anaesthetist</label>
            <input type="text" id="primary_anaesthetist" name="surgical_team.primary_anaesthetist"
                   value="{{ surgical_team.primaryAnaesthetist }}">
        </div>
        <div class="form-group">
            <label for="primary_anaesthetist_grade">Grade</label>
            <input type="text" id="primary_anaesthetist_grade" name="surgical_team.primary_anaesthetist_grade"
                   value="{{ surgical_team.primaryAnaesthetistGrade }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="scrub_nurse">Scrub Nurse</label>
            <input type="text" id="scrub_nurse" name="surgical_team.scrub_nurse"
                   value="{{ surgical_team.scrubNurse }}">
        </div>
        <div class="form-group">
            <label for="circulator">Circulator</label>
            <input type="text" id="circulator" name="surgical_team.circulator"
                   value="{{ surgical_team.circulator }}">
        </div>
    </div>

    <h3>Additional Members</h3>
    {% for m in surgical_team.additionalMembers %}
    <div class="form-row">
        <div class="form-group">
            <label>Name</label>
            <input type="text" name="additional_members[{{ loop.index0 }}].name" value="{{ m.name }}">
        </div>
        <div class="form-group">
            <label>Role</label>
            <input type="text" name="additional_members[{{ loop.index0 }}].role" value="{{ m.role }}">
        </div>
        <div class="form-group">
            <label>Grade</label>
            <input type="text" name="additional_members[{{ loop.index0 }}].grade" value="{{ m.grade }}">
        </div>
    </div>
    {% endfor %}
    <div class="form-row">
        <div class="form-group">
            <label>Name (new)</label>
            <input type="text" name="additional_members[{{ surgical_team.additionalMembers | length }}].name" value="">
        </div>
        <div class="form-group">
            <label>Role</label>
            <input type="text" name="additional_members[{{ surgical_team.additionalMembers | length }}].role" value="">
        </div>
        <div class="form-group">
            <label>Grade</label>
            <input type="text" name="additional_members[{{ surgical_team.additionalMembers | length }}].grade" value="">
        </div>
    </div>
</div>
