<div class="card">
    <h2>Step 1: Patient Details</h2>
    <p class="form-hint">Identify the patient and record baseline risk factors.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="patient_details.first_name"
                   value="{{ patient_details.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="patient_details.last_name"
                   value="{{ patient_details.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="patient_details.date_of_birth"
                   value="{{ patient_details.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="mrn">MRN</label>
            <input type="text" id="mrn" name="patient_details.mrn"
                   value="{{ patient_details.mrn }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="patient_details.sex">
                <option value="" {% if patient_details.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if patient_details.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if patient_details.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if patient_details.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="weight">Weight (kg)</label>
            <input type="number" step="0.1" id="weight" name="patient_details.weight"
                   value="{{ patient_details.weight }}">
        </div>
        <div class="form-group">
            <label for="height">Height (cm)</label>
            <input type="number" step="0.1" id="height" name="patient_details.height"
                   value="{{ patient_details.height }}">
        </div>
        <div class="form-group">
            <label for="asa_grade">ASA Grade</label>
            <select id="asa_grade" name="patient_details.asa_grade">
                <option value="" {% if patient_details.asaGrade == "" %}selected{% endif %}>&mdash;</option>
                <option value="I" {% if patient_details.asaGrade == "I" %}selected{% endif %}>I</option>
                <option value="II" {% if patient_details.asaGrade == "II" %}selected{% endif %}>II</option>
                <option value="III" {% if patient_details.asaGrade == "III" %}selected{% endif %}>III</option>
                <option value="IV" {% if patient_details.asaGrade == "IV" %}selected{% endif %}>IV</option>
                <option value="V" {% if patient_details.asaGrade == "V" %}selected{% endif %}>V</option>
                <option value="VI" {% if patient_details.asaGrade == "VI" %}selected{% endif %}>VI</option>
                <option value="E" {% if patient_details.asaGrade == "E" %}selected{% endif %}>E (emergency suffix)</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="allergies">Allergies</label>
        <textarea id="allergies" name="patient_details.allergies" rows="2">{{ patient_details.allergies }}</textarea>
    </div>
</div>
