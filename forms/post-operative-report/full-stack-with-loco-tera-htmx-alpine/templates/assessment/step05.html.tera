<div class="card">
    <h2>Step 5: Anaesthesia Summary</h2>
    <p class="form-hint">Anaesthetic technique, airway management, and significant events.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="anaesthesia_type">Anaesthesia Type</label>
            <select id="anaesthesia_type" name="anaesthesia_summary.anaesthesia_type">
                <option value="" {% if anaesthesia_summary.anaesthesiaType == "" %}selected{% endif %}>&mdash;</option>
                <option value="general" {% if anaesthesia_summary.anaesthesiaType == "general" %}selected{% endif %}>General</option>
                <option value="regional" {% if anaesthesia_summary.anaesthesiaType == "regional" %}selected{% endif %}>Regional</option>
                <option value="spinal" {% if anaesthesia_summary.anaesthesiaType == "spinal" %}selected{% endif %}>Spinal</option>
                <option value="epidural" {% if anaesthesia_summary.anaesthesiaType == "epidural" %}selected{% endif %}>Epidural</option>
                <option value="combined-spinal-epidural" {% if anaesthesia_summary.anaesthesiaType == "combined-spinal-epidural" %}selected{% endif %}>Combined spinal-epidural</option>
                <option value="monitored-anaesthesia-care" {% if anaesthesia_summary.anaesthesiaType == "monitored-anaesthesia-care" %}selected{% endif %}>Monitored anaesthesia care</option>
                <option value="local" {% if anaesthesia_summary.anaesthesiaType == "local" %}selected{% endif %}>Local</option>
                <option value="sedation" {% if anaesthesia_summary.anaesthesiaType == "sedation" %}selected{% endif %}>Sedation</option>
                <option value="none" {% if anaesthesia_summary.anaesthesiaType == "none" %}selected{% endif %}>None</option>
            </select>
        </div>
        <div class="form-group">
            <label for="airway_management">Airway Management</label>
            <input type="text" id="airway_management" name="anaesthesia_summary.airway_management"
                   value="{{ anaesthesia_summary.airwayManagement }}" placeholder="e.g. ETT, LMA, native">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="difficult_intubation">Difficult Intubation?</label>
            <select id="difficult_intubation" name="anaesthesia_summary.difficult_intubation">
                <option value="" {% if anaesthesia_summary.difficultIntubation == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if anaesthesia_summary.difficultIntubation == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if anaesthesia_summary.difficultIntubation == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="airway_notes">Airway Notes</label>
            <input type="text" id="airway_notes" name="anaesthesia_summary.airway_notes"
                   value="{{ anaesthesia_summary.airwayNotes }}">
        </div>
    </div>

    <div class="form-group">
        <label for="medications_administered">Medications Administered</label>
        <textarea id="medications_administered" name="anaesthesia_summary.medications_administered" rows="2">{{ anaesthesia_summary.medicationsAdministered }}</textarea>
    </div>

    <div class="form-group">
        <label for="reversal_agents">Reversal Agents</label>
        <input type="text" id="reversal_agents" name="anaesthesia_summary.reversal_agents"
               value="{{ anaesthesia_summary.reversalAgents }}">
    </div>

    <div class="form-group">
        <label for="anaesthesia_notes">Anaesthesia Notes</label>
        <textarea id="anaesthesia_notes" name="anaesthesia_summary.anaesthesia_notes" rows="2">{{ anaesthesia_summary.anaesthesiaNotes }}</textarea>
    </div>
</div>
