<div class="card">
    <h2>Step 9: Complications Assessment (Clavien-Dindo)</h2>
    <p class="form-hint">Record each complication and assign the highest Clavien-Dindo grade reached.</p>

    <div class="form-group">
        <label for="complications_occurred">Did any complications occur?</label>
        <select id="complications_occurred" name="complications_assessment.complications_occurred">
            <option value="" {% if complications_assessment.complicationsOccurred == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if complications_assessment.complicationsOccurred == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if complications_assessment.complicationsOccurred == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    {% for c in complications_assessment.complications %}
    <div class="form-row">
        <div class="form-group">
            <label>Description</label>
            <input type="text" name="complications[{{ loop.index0 }}].description" value="{{ c.description }}">
        </div>
        <div class="form-group">
            <label>Grade</label>
            <select name="complications[{{ loop.index0 }}].grade">
                <option value="" {% if c.grade == "" %}selected{% endif %}>&mdash;</option>
                <option value="grade-0" {% if c.grade == "grade-0" %}selected{% endif %}>Grade 0</option>
                <option value="grade-i" {% if c.grade == "grade-i" %}selected{% endif %}>Grade I</option>
                <option value="grade-ii" {% if c.grade == "grade-ii" %}selected{% endif %}>Grade II</option>
                <option value="grade-iiia" {% if c.grade == "grade-iiia" %}selected{% endif %}>Grade IIIa</option>
                <option value="grade-iiib" {% if c.grade == "grade-iiib" %}selected{% endif %}>Grade IIIb</option>
                <option value="grade-iva" {% if c.grade == "grade-iva" %}selected{% endif %}>Grade IVa</option>
                <option value="grade-ivb" {% if c.grade == "grade-ivb" %}selected{% endif %}>Grade IVb</option>
                <option value="grade-v" {% if c.grade == "grade-v" %}selected{% endif %}>Grade V</option>
            </select>
        </div>
        <div class="form-group">
            <label>Intervention</label>
            <input type="text" name="complications[{{ loop.index0 }}].intervention_required" value="{{ c.interventionRequired }}">
        </div>
        <div class="form-group">
            <label>Timing</label>
            <input type="text" name="complications[{{ loop.index0 }}].timing" value="{{ c.timing }}">
        </div>
    </div>
    {% endfor %}
    <div class="form-row">
        <div class="form-group">
            <label>Description (new)</label>
            <input type="text" name="complications[{{ complications_assessment.complications | length }}].description" value="">
        </div>
        <div class="form-group">
            <label>Grade</label>
            <select name="complications[{{ complications_assessment.complications | length }}].grade">
                <option value="" selected>&mdash;</option>
                <option value="grade-0">Grade 0</option>
                <option value="grade-i">Grade I</option>
                <option value="grade-ii">Grade II</option>
                <option value="grade-iiia">Grade IIIa</option>
                <option value="grade-iiib">Grade IIIb</option>
                <option value="grade-iva">Grade IVa</option>
                <option value="grade-ivb">Grade IVb</option>
                <option value="grade-v">Grade V</option>
            </select>
        </div>
        <div class="form-group">
            <label>Intervention</label>
            <input type="text" name="complications[{{ complications_assessment.complications | length }}].intervention_required" value="">
        </div>
        <div class="form-group">
            <label>Timing</label>
            <input type="text" name="complications[{{ complications_assessment.complications | length }}].timing" value="">
        </div>
    </div>

    <div class="form-group">
        <label for="narrative">Narrative</label>
        <textarea id="narrative" name="complications_assessment.narrative" rows="3">{{ complications_assessment.narrative }}</textarea>
    </div>
</div>
