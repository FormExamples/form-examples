{% extends "base.html.tera" %}

{% block title %}WHO Prehospital Form - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>WHO Prehospital Form</h1>
        <p class="landing-description">
            Digital implementation of the World Health Organization
            standardised prehospital clinical documentation form (SCF
            Prehospital) for emergency medical services. Captures caller and
            scene information, vital signs, high-risk signs, triage category,
            ABCDE primary survey, SAMPLE history, injury details, physical
            exam, interventions, reassessments, and disposition / handover.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>16 Steps</h3>
                <p>Caller &amp; Scene, Vitals, High Risk Signs, Triage, ABCDE primary survey, SAMPLE, Injury, Exam, Interventions, A&amp;P, Reassessments, Disposition</p>
            </div>
            <div class="feature">
                <h3>Triage RED</h3>
                <p>RED triage ratchets up requirements: GCS components, IV/IO access or fluids, and an airway intervention when the airway is abnormal</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Real-time alerts for AVPU U/P, GCS &lt; 8, critical SpO2, hypotension, hypoglycaemia, uncontrolled bleeding, and other findings</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
