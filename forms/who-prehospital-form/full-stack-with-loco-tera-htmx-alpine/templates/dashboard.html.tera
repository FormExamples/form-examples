{% extends "base.html.tera" %}

{% block title %}WHO Prehospital Form - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Prehospital Run-Sheet Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, chief complaint, or provider...">
    </div>
    <div class="form-group">
        <label for="triage_category">Triage</label>
        <select id="triage_category" name="triage_category">
            <option value="">All</option>
            <option value="red" {% if triage_category == "red" %}selected{% endif %}>RED</option>
            <option value="yellow" {% if triage_category == "yellow" %}selected{% endif %}>YELLOW</option>
            <option value="green" {% if triage_category == "green" %}selected{% endif %}>GREEN</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent_flags">Urgent Flags</label>
        <select id="has_urgent_flags" name="has_urgent_flags">
            <option value="">All</option>
            <option value="yes" {% if has_urgent_flags == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent_flags == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed run sheet{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Run Date</th>
            <th>Patient</th>
            <th>Chief Complaint</th>
            <th>Triage</th>
            <th>Disposition</th>
            <th>Provider</th>
            <th>Completeness</th>
            <th>Urgent</th>
            <th>High</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.runDate }}</a></td>
            <td>{{ c.patientName }}</td>
            <td>{{ c.chiefComplaint }}</td>
            <td><span class="triage-badge triage-{{ c.triageCategory }}">{{ c.triageCategory | upper }}</span></td>
            <td>{{ c.disposition }}</td>
            <td>{{ c.providerName }}</td>
            <td>{{ c.totalSatisfied }} / {{ c.totalRequired }}</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>
                {% if c.highFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed run sheets found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
