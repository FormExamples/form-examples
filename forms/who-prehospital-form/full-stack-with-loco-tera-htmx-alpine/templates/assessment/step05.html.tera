<div class="card">
    <h2>Step 5: Airway (A)</h2>

    <div class="form-group">
        <label><input type="checkbox" name="airway.normal" value="on" {% if airway.normal %}checked{% endif %}> Normal</label>
    </div>

    <h3>Findings</h3>
    <div class="form-group">
        <label><input type="checkbox" name="airway.voice_changes" value="on" {% if airway.voiceChanges %}checked{% endif %}> Voice changes</label>
        <label><input type="checkbox" name="airway.stridor" value="on" {% if airway.stridor %}checked{% endif %}> Stridor</label>
        <label><input type="checkbox" name="airway.oral_airway_burns" value="on" {% if airway.oralAirwayBurns %}checked{% endif %}> Oral / airway burns</label>
        <label><input type="checkbox" name="airway.angioedema" value="on" {% if airway.angioedema %}checked{% endif %}> Angioedema</label>
    </div>

    <h3>Obstructed by</h3>
    <div class="form-group">
        <label><input type="checkbox" name="airway.obstructed_by_tongue" value="on" {% if airway.obstructedByTongue %}checked{% endif %}> Tongue</label>
        <label><input type="checkbox" name="airway.obstructed_by_blood" value="on" {% if airway.obstructedByBlood %}checked{% endif %}> Blood</label>
        <label><input type="checkbox" name="airway.obstructed_by_secretions" value="on" {% if airway.obstructedBySecretions %}checked{% endif %}> Secretions</label>
        <label><input type="checkbox" name="airway.obstructed_by_vomit" value="on" {% if airway.obstructedByVomit %}checked{% endif %}> Vomit</label>
        <label><input type="checkbox" name="airway.obstructed_by_foreign_body" value="on" {% if airway.obstructedByForeignBody %}checked{% endif %}> Foreign body</label>
    </div>

    <h3>Interventions</h3>
    <div class="form-group">
        <label><input type="checkbox" name="airway.intervention_repositioning" value="on" {% if airway.interventionRepositioning %}checked{% endif %}> Repositioning</label>
        <label><input type="checkbox" name="airway.intervention_suction" value="on" {% if airway.interventionSuction %}checked{% endif %}> Suction</label>
        <label><input type="checkbox" name="airway.intervention_opa" value="on" {% if airway.interventionOpa %}checked{% endif %}> OPA</label>
        <label><input type="checkbox" name="airway.intervention_npa" value="on" {% if airway.interventionNpa %}checked{% endif %}> NPA</label>
        <label><input type="checkbox" name="airway.intervention_lma" value="on" {% if airway.interventionLma %}checked{% endif %}> LMA</label>
        <label><input type="checkbox" name="airway.intervention_bvm" value="on" {% if airway.interventionBvm %}checked{% endif %}> BVM</label>
        <label><input type="checkbox" name="airway.intervention_ett" value="on" {% if airway.interventionEtt %}checked{% endif %}> ETT</label>
    </div>

    <h3>C-spine</h3>
    <div class="form-group">
        <label><input type="checkbox" name="airway.c_spine_not_needed" value="on" {% if airway.cSpineNotNeeded %}checked{% endif %}> Not needed</label>
        <label><input type="checkbox" name="airway.c_spine_done" value="on" {% if airway.cSpineDone %}checked{% endif %}> Done</label>
    </div>

    <div class="form-group">
        <label for="airway_notes">Notes</label>
        <textarea id="airway_notes" name="airway.notes">{{ airway.notes }}</textarea>
    </div>
</div>
