{% extends "base.html.tera" %}

{% block title %}WHO Prehospital Form - Wizard{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;"
     x-data="{
       step: 1,
       totalSteps: {{ total_steps }},
       reassessmentCount: {{ data.reassessments | length }}
     }">
  <h1>WHO Prehospital Form (SCF Prehospital)</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Caller & Scene -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Caller &amp; Scene</h2>
      <label><input type="checkbox" name="massCasualty" value="on" {% if data.callerAndScene.massCasualty %}checked{% endif %}> Mass casualty incident</label>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>Patient name</label>
          <input type="text" name="patientName" value="{{ data.callerAndScene.patientName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date of birth or age</label>
          <input type="text" name="dateOfBirthOrAge" value="{{ data.callerAndScene.dateOfBirthOrAge }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Sex</label>
          <select name="sex" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""       {% if data.callerAndScene.sex == "" %}selected{% endif %}>-- Select --</option>
            <option value="male"   {% if data.callerAndScene.sex == "male" %}selected{% endif %}>Male</option>
            <option value="female" {% if data.callerAndScene.sex == "female" %}selected{% endif %}>Female</option>
          </select>
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Run date</label>
          <input type="date" name="date" value="{{ data.callerAndScene.date }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Scene call type</label>
          <select name="sceneCallType" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""                          {% if data.callerAndScene.sceneCallType == "" %}selected{% endif %}>-- Select --</option>
            <option value="scene"                     {% if data.callerAndScene.sceneCallType == "scene" %}selected{% endif %}>Scene call</option>
            <option value="inter-facility-transfer"   {% if data.callerAndScene.sceneCallType == "inter-facility-transfer" %}selected{% endif %}>Inter-Facility Transfer</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Scene location type</label>
          <select name="sceneLocationType" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""                  {% if data.callerAndScene.sceneLocationType == "" %}selected{% endif %}>-- Select --</option>
            <option value="residence"         {% if data.callerAndScene.sceneLocationType == "residence" %}selected{% endif %}>Residence</option>
            <option value="school"            {% if data.callerAndScene.sceneLocationType == "school" %}selected{% endif %}>School</option>
            <option value="public-building"   {% if data.callerAndScene.sceneLocationType == "public-building" %}selected{% endif %}>Public building</option>
            <option value="health-facility"   {% if data.callerAndScene.sceneLocationType == "health-facility" %}selected{% endif %}>Health facility</option>
            <option value="street"            {% if data.callerAndScene.sceneLocationType == "street" %}selected{% endif %}>Street</option>
            <option value="other"             {% if data.callerAndScene.sceneLocationType == "other" %}selected{% endif %}>Other</option>
          </select>
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Time call received</label>
          <input type="time" name="timeCallReceived" value="{{ data.callerAndScene.timeCallReceived }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Time arrived at scene</label>
          <input type="time" name="timeArrivedAtScene" value="{{ data.callerAndScene.timeArrivedAtScene }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 2 — Chief Complaint & Vitals -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Chief Complaint &amp; Vitals</h2>
      <div>
        <label>Chief complaint</label>
        <textarea name="chiefComplaint" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.chiefComplaintAndVitals.chiefComplaint }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label><input type="checkbox" name="injury" value="on" {% if data.chiefComplaintAndVitals.injury %}checked{% endif %}> Injury</label>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:140px;">
          <label>Initial vitals time</label>
          <input type="time" name="initialVitalsTime" value="{{ data.chiefComplaintAndVitals.initialVitals.time }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>HR</label>
          <input type="number" step="any" name="initialHr" value="{{ data.chiefComplaintAndVitals.initialVitals.hr | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>RR</label>
          <input type="number" step="any" name="initialRr" value="{{ data.chiefComplaintAndVitals.initialVitals.rr | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>BP (e.g. 120/80)</label>
          <input type="text" name="initialBp" value="{{ data.chiefComplaintAndVitals.initialVitals.bp }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Temp (°C)</label>
          <input type="number" step="any" name="initialTempC" value="{{ data.chiefComplaintAndVitals.initialVitals.tempC | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>SpO2 (%)</label>
          <input type="number" step="any" name="initialSpo2" value="{{ data.chiefComplaintAndVitals.initialVitals.spo2 | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Pain (0-10)</label>
          <input type="number" step="any" name="painScore" value="{{ data.chiefComplaintAndVitals.painScore | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Pregnant</label>
          <select name="pregnant" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""        {% if data.chiefComplaintAndVitals.pregnant == "" %}selected{% endif %}>-- Select --</option>
            <option value="yes"     {% if data.chiefComplaintAndVitals.pregnant == "yes" %}selected{% endif %}>Yes</option>
            <option value="no"      {% if data.chiefComplaintAndVitals.pregnant == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if data.chiefComplaintAndVitals.pregnant == "unknown" %}selected{% endif %}>Unknown</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Step 3 — High Risk Signs -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: High Risk Signs</h2>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label><input type="checkbox" name="stridor" value="on" {% if data.highRiskSigns.stridor %}checked{% endif %}> Stridor</label>
        <label><input type="checkbox" name="cyanosis" value="on" {% if data.highRiskSigns.cyanosis %}checked{% endif %}> Cyanosis</label>
        <label><input type="checkbox" name="respiratoryDistress" value="on" {% if data.highRiskSigns.respiratoryDistress %}checked{% endif %}> Respiratory distress</label>
        <label><input type="checkbox" name="poorPerfusion" value="on" {% if data.highRiskSigns.poorPerfusion %}checked{% endif %}> Poor perfusion</label>
        <label><input type="checkbox" name="heavyBleeding" value="on" {% if data.highRiskSigns.heavyBleeding %}checked{% endif %}> Heavy bleeding</label>
        <label><input type="checkbox" name="unresponsive" value="on" {% if data.highRiskSigns.unresponsive %}checked{% endif %}> Unresponsive</label>
        <label><input type="checkbox" name="acuteConvulsions" value="on" {% if data.highRiskSigns.acuteConvulsions %}checked{% endif %}> Acute convulsions</label>
        <label><input type="checkbox" name="hypoglycaemia" value="on" {% if data.highRiskSigns.hypoglycaemia %}checked{% endif %}> Hypoglycaemia</label>
        <label><input type="checkbox" name="highRiskTrauma" value="on" {% if data.highRiskSigns.highRiskTrauma %}checked{% endif %}> High-risk trauma</label>
        <label><input type="checkbox" name="threatenedLimb" value="on" {% if data.highRiskSigns.threatenedLimb %}checked{% endif %}> Threatened limb</label>
        <label><input type="checkbox" name="snakeBite" value="on" {% if data.highRiskSigns.snakeBite %}checked{% endif %}> Snake bite</label>
        <label><input type="checkbox" name="poisoningIngestionChemicalExposure" value="on" {% if data.highRiskSigns.poisoningIngestionChemicalExposure %}checked{% endif %}> Poisoning / chemical</label>
        <label><input type="checkbox" name="violentOrAggressive" value="on" {% if data.highRiskSigns.violentOrAggressive %}checked{% endif %}> Violent / aggressive</label>
        <label><input type="checkbox" name="pregnantWithHighRiskFindings" value="on" {% if data.highRiskSigns.pregnantWithHighRiskFindings %}checked{% endif %}> Pregnant + high-risk findings</label>
      </div>
    </div>

    <!-- Step 4 — Triage -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Triage</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Triage category</label>
          <select name="triageCategory" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""       {% if data.triage.category == "" %}selected{% endif %}>-- Select --</option>
            <option value="red"    {% if data.triage.category == "red" %}selected{% endif %}>RED (immediate)</option>
            <option value="yellow" {% if data.triage.category == "yellow" %}selected{% endif %}>YELLOW (urgent)</option>
            <option value="green"  {% if data.triage.category == "green" %}selected{% endif %}>GREEN (non-urgent)</option>
          </select>
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Triaged for</label>
          <input type="text" name="triagedFor" value="{{ data.triage.triagedFor }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 5 — Airway -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Airway (A)</h2>
      <label><input type="checkbox" name="airwayNormal" value="on" {% if data.airway.normal %}checked{% endif %}> Normal</label>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;margin-top:0.4rem;">
        <label><input type="checkbox" name="airwayVoiceChanges" value="on" {% if data.airway.voiceChanges %}checked{% endif %}> Voice changes</label>
        <label><input type="checkbox" name="airwayStridor" value="on" {% if data.airway.stridor %}checked{% endif %}> Stridor</label>
      </div>
      <h3 style="margin-top:1rem;">Interventions</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label><input type="checkbox" name="airwayInterventionRepositioning" value="on" {% if data.airway.interventionRepositioning %}checked{% endif %}> Repositioning</label>
        <label><input type="checkbox" name="airwayInterventionSuction" value="on" {% if data.airway.interventionSuction %}checked{% endif %}> Suction</label>
        <label><input type="checkbox" name="airwayInterventionOpa" value="on" {% if data.airway.interventionOpa %}checked{% endif %}> OPA</label>
        <label><input type="checkbox" name="airwayInterventionNpa" value="on" {% if data.airway.interventionNpa %}checked{% endif %}> NPA</label>
        <label><input type="checkbox" name="airwayInterventionLma" value="on" {% if data.airway.interventionLma %}checked{% endif %}> LMA</label>
        <label><input type="checkbox" name="airwayInterventionBvm" value="on" {% if data.airway.interventionBvm %}checked{% endif %}> BVM</label>
        <label><input type="checkbox" name="airwayInterventionEtt" value="on" {% if data.airway.interventionEtt %}checked{% endif %}> ETT</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="airwayNotes" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.airway.notes }}</textarea>
      </div>
    </div>

    <!-- Step 6 — Breathing -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Breathing (B)</h2>
      <label><input type="checkbox" name="breathingNormal" value="on" {% if data.breathing.normal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.6rem;">
        <label>Spontaneous respiration</label>
        <select name="breathingSpontaneousRespiration" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;max-width:160px;">
          <option value=""    {% if data.breathing.spontaneousRespiration == "" %}selected{% endif %}>-- Select --</option>
          <option value="yes" {% if data.breathing.spontaneousRespiration == "yes" %}selected{% endif %}>Yes</option>
          <option value="no"  {% if data.breathing.spontaneousRespiration == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <h3 style="margin-top:1rem;">Oxygen / ventilation</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label>O2 litres
          <input type="number" step="any" name="breathingOxygenLitres" value="{{ data.breathing.oxygenLitres | default(value='') }}"
                 style="width:100px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;"></label>
        <label><input type="checkbox" name="breathingOxygenNasalCannula" value="on" {% if data.breathing.oxygenNasalCannula %}checked{% endif %}> Nasal cannula</label>
        <label><input type="checkbox" name="breathingOxygenFaceMask" value="on" {% if data.breathing.oxygenFaceMask %}checked{% endif %}> Face mask</label>
        <label><input type="checkbox" name="breathingOxygenNonRebreather" value="on" {% if data.breathing.oxygenNonRebreather %}checked{% endif %}> Non-rebreather</label>
        <label><input type="checkbox" name="breathingOxygenBvm" value="on" {% if data.breathing.oxygenBvm %}checked{% endif %}> BVM</label>
        <label><input type="checkbox" name="breathingOxygenBipapCpap" value="on" {% if data.breathing.oxygenBipapCpap %}checked{% endif %}> BiPAP / CPAP</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="breathingNotes" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.breathing.notes }}</textarea>
      </div>
    </div>

    <!-- Step 7 — Circulation -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Circulation (C)</h2>
      <label><input type="checkbox" name="circulationNormal" value="on" {% if data.circulation.normal %}checked{% endif %}> Normal</label>
      <div style="margin-top:0.6rem;">
        <label>Active bleeding site</label>
        <input type="text" name="circulationActiveBleedingSite" value="{{ data.circulation.activeBleedingSite }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <h3 style="margin-top:1rem;">Bleeding control</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label><input type="checkbox" name="circulationBleedingControlledBandage" value="on" {% if data.circulation.bleedingControlledBandage %}checked{% endif %}> Bandage</label>
        <label><input type="checkbox" name="circulationBleedingControlledTourniquet" value="on" {% if data.circulation.bleedingControlledTourniquet %}checked{% endif %}> Tourniquet</label>
        <label><input type="checkbox" name="circulationBleedingControlledDirectPressure" value="on" {% if data.circulation.bleedingControlledDirectPressure %}checked{% endif %}> Direct pressure</label>
      </div>
      <h3 style="margin-top:1rem;">Access &amp; fluids</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label>IV site
          <input type="text" name="circulationAccessIvSite" value="{{ data.circulation.accessIvSite }}"
                 style="width:140px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;"></label>
        <label>IO site
          <input type="text" name="circulationAccessIoSite" value="{{ data.circulation.accessIoSite }}"
                 style="width:140px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;"></label>
        <label>IVF mL
          <input type="number" step="any" name="circulationIvfMls" value="{{ data.circulation.ivfMls | default(value='') }}"
                 style="width:100px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;"></label>
        <label><input type="checkbox" name="circulationIvfNs" value="on" {% if data.circulation.ivfNs %}checked{% endif %}> NS</label>
        <label><input type="checkbox" name="circulationIvfLr" value="on" {% if data.circulation.ivfLr %}checked{% endif %}> LR</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="circulationNotes" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.circulation.notes }}</textarea>
      </div>
    </div>

    <!-- Step 8 — Disability -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: Disability (D)</h2>
      <label><input type="checkbox" name="disabilityNormal" value="on" {% if data.disability.normal %}checked{% endif %}> Normal</label>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:140px;">
          <label>AVPU</label>
          <select name="avpu" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""  {% if data.disability.avpu == "" %}selected{% endif %}>-- Select --</option>
            <option value="A" {% if data.disability.avpu == "A" %}selected{% endif %}>A - Alert</option>
            <option value="V" {% if data.disability.avpu == "V" %}selected{% endif %}>V - Voice</option>
            <option value="P" {% if data.disability.avpu == "P" %}selected{% endif %}>P - Pain</option>
            <option value="U" {% if data.disability.avpu == "U" %}selected{% endif %}>U - Unresponsive</option>
          </select>
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Eye (1-4)</label>
          <input type="number" step="1" name="gcsEye" value="{{ data.disability.gcsEye | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Verbal (1-5)</label>
          <input type="number" step="1" name="gcsVerbal" value="{{ data.disability.gcsVerbal | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>GCS Motor (1-6)</label>
          <input type="number" step="1" name="gcsMotor" value="{{ data.disability.gcsMotor | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Blood glucose (mmol/L)</label>
          <input type="number" step="any" name="disabilityBloodGlucose" value="{{ data.disability.bloodGlucose | default(value='') }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.6rem;display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label><input type="checkbox" name="disabilityInterventionGlucoseGiven" value="on" {% if data.disability.interventionGlucoseGiven %}checked{% endif %}> Glucose given</label>
        <label><input type="checkbox" name="disabilityInterventionNaloxoneGiven" value="on" {% if data.disability.interventionNaloxoneGiven %}checked{% endif %}> Naloxone given</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="disabilityNotes" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.disability.notes }}</textarea>
      </div>
    </div>

    <!-- Step 9 — Exposure -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Exposure (E)</h2>
      <label><input type="checkbox" name="exposureNormal" value="on" {% if data.exposure.normal %}checked{% endif %}> Normal</label>
      <label style="margin-left:1rem;"><input type="checkbox" name="exposureExposedCompletely" value="on" {% if data.exposure.exposedCompletely %}checked{% endif %}> Exposed completely</label>
      <div style="margin-top:0.6rem;">
        <label>Notes</label>
        <textarea name="exposureNotes" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.exposure.notes }}</textarea>
      </div>
    </div>

    <!-- Step 10 — SAMPLE History -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: SAMPLE History</h2>
      {% set rows = [
        {'k':'signsSymptoms','u':'signsSymptomsUnknown','v':data.sampleHistory.signsSymptoms,'uv':data.sampleHistory.signsSymptomsUnknown,'l':'Signs / symptoms'},
        {'k':'allergies','u':'allergiesUnknown','v':data.sampleHistory.allergies,'uv':data.sampleHistory.allergiesUnknown,'l':'Allergies'},
        {'k':'medications','u':'medicationsUnknown','v':data.sampleHistory.medications,'uv':data.sampleHistory.medicationsUnknown,'l':'Medications'},
        {'k':'pastMedical','u':'pastMedicalUnknown','v':data.sampleHistory.pastMedical,'uv':data.sampleHistory.pastMedicalUnknown,'l':'Past medical'},
        {'k':'pastSurgeries','u':'pastSurgeriesUnknown','v':data.sampleHistory.pastSurgeries,'uv':data.sampleHistory.pastSurgeriesUnknown,'l':'Past surgeries'},
        {'k':'events','u':'eventsUnknown','v':data.sampleHistory.events,'uv':data.sampleHistory.eventsUnknown,'l':'Events'}
      ] %}
      {% for row in rows %}
      <div style="margin-top:0.6rem;">
        <label>{{ row.l }}
          <input type="text" name="{{ row.k }}" value="{{ row.v }}"
                 style="width:60%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;margin-left:0.5rem;">
        </label>
        <label style="margin-left:0.5rem;"><input type="checkbox" name="{{ row.u }}" value="on" {% if row.uv %}checked{% endif %}> Unknown</label>
      </div>
      {% endfor %}
      <div style="margin-top:0.6rem;">
        <label>Last ate (hours ago)
          <input type="number" step="any" name="lastAteHours" value="{{ data.sampleHistory.lastAteHours | default(value='') }}"
                 style="width:120px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;margin-left:0.5rem;">
        </label>
        <label style="margin-left:0.5rem;"><input type="checkbox" name="lastAteUnknown" value="on" {% if data.sampleHistory.lastAteUnknown %}checked{% endif %}> Unknown</label>
      </div>
    </div>

    <!-- Step 11 — Injury Details -->
    <div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 11: Injury Details</h2>
      <div>
        <label>Intent</label>
        <select name="injuryIntent" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;max-width:240px;">
          <option value=""               {% if data.injuryDetails.intent == "" %}selected{% endif %}>-- Select --</option>
          <option value="intentional"    {% if data.injuryDetails.intent == "intentional" %}selected{% endif %}>Intentional</option>
          <option value="unintentional"  {% if data.injuryDetails.intent == "unintentional" %}selected{% endif %}>Unintentional</option>
          <option value="self-inflicted" {% if data.injuryDetails.intent == "self-inflicted" %}selected{% endif %}>Self-inflicted</option>
        </select>
      </div>
      <h3 style="margin-top:1rem;">Mechanism</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1rem;">
        <label><input type="checkbox" name="mechanismFall" value="on" {% if data.injuryDetails.mechanismFall %}checked{% endif %}> Fall</label>
        <label><input type="checkbox" name="mechanismHitByFallingObject" value="on" {% if data.injuryDetails.mechanismHitByFallingObject %}checked{% endif %}> Hit by falling object</label>
        <label><input type="checkbox" name="mechanismStabCut" value="on" {% if data.injuryDetails.mechanismStabCut %}checked{% endif %}> Stab / cut</label>
        <label><input type="checkbox" name="mechanismGunshot" value="on" {% if data.injuryDetails.mechanismGunshot %}checked{% endif %}> Gunshot</label>
        <label><input type="checkbox" name="mechanismSexualAssault" value="on" {% if data.injuryDetails.mechanismSexualAssault %}checked{% endif %}> Sexual assault</label>
        <label><input type="checkbox" name="mechanismOtherBluntForce" value="on" {% if data.injuryDetails.mechanismOtherBluntForce %}checked{% endif %}> Other blunt force</label>
        <label><input type="checkbox" name="mechanismSuffocationChokingHanging" value="on" {% if data.injuryDetails.mechanismSuffocationChokingHanging %}checked{% endif %}> Suffocation / choking</label>
        <label><input type="checkbox" name="mechanismDrowning" value="on" {% if data.injuryDetails.mechanismDrowning %}checked{% endif %}> Drowning</label>
        <label><input type="checkbox" name="mechanismPoisoningToxicExposure" value="on" {% if data.injuryDetails.mechanismPoisoningToxicExposure %}checked{% endif %}> Poisoning</label>
        <label><input type="checkbox" name="mechanismUnknown" value="on" {% if data.injuryDetails.mechanismUnknown %}checked{% endif %}> Unknown</label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Burn caused by
          <input type="text" name="mechanismBurnCausedBy" value="{{ data.injuryDetails.mechanismBurnCausedBy }}"
                 style="width:60%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;margin-left:0.5rem;">
        </label>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Other mechanism
          <input type="text" name="mechanismOther" value="{{ data.injuryDetails.mechanismOther }}"
                 style="width:60%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;margin-left:0.5rem;">
        </label>
      </div>
    </div>

    <!-- Step 12 — Physical Exam -->
    <div x-show="step === 12" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 12: Physical Exam</h2>
      <p style="color:#666;font-size:0.9rem;">Tick "Normal" or add a note for each system.</p>
      {% set systems = ['general','heent','respiratory','cardiac','abdominal','pelvisGu','neurologic','psychiatric','musculoskeletal','skin'] %}
      <p style="color:#888;">Detailed per-system notes captured in the SvelteKit front-end; here record narrative observations under "Notes" within each system as needed.</p>
    </div>

    <!-- Step 13 — Additional Interventions -->
    <div x-show="step === 13" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 13: Additional Interventions</h2>
      <p style="color:#888;">Medications and procedures detail captured in the SvelteKit front-end.</p>
    </div>

    <!-- Step 14 — Assessment & Plan -->
    <div x-show="step === 14" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 14: Assessment &amp; Plan</h2>
      <div>
        <label>Summary</label>
        <textarea name="assessmentSummary" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.assessmentAndPlan.summary }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Differential</label>
        <textarea name="assessmentDifferential" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.assessmentAndPlan.differential }}</textarea>
      </div>
      <div style="margin-top:0.6rem;">
        <label>Presumptive diagnoses</label>
        <textarea name="assessmentPresumptiveDiagnoses" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.assessmentAndPlan.presumptiveDiagnoses }}</textarea>
      </div>
    </div>

    <!-- Step 15 — Reassessment (up to 3) -->
    <div x-show="step === 15" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 15: Reassessment (up to 3)</h2>
      <div style="margin-bottom:0.6rem;color:#555;">
        <span x-text="`${reassessmentCount} reassessment(s)`"></span>
        <button type="button" @click="if (reassessmentCount < 3) reassessmentCount++"
                :disabled="reassessmentCount >= 3"
                style="margin-left:0.5rem;padding:0.3rem 0.8rem;">Add</button>
        <button type="button" @click="if (reassessmentCount > 0) reassessmentCount--"
                :disabled="reassessmentCount <= 0"
                style="margin-left:0.3rem;padding:0.3rem 0.8rem;">Remove last</button>
      </div>

      {% for i in range(end=3) %}
        {% set ra = data.reassessments | nth(n=i) %}
        <div x-show="reassessmentCount > {{ i }}"
             style="border:1px solid #eee;border-radius:4px;padding:0.8rem;margin-top:0.6rem;">
          <strong>Reassessment {{ i + 1 }}</strong>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.4rem;">
            <label>Time
              <input type="time" name="reassessment{{ i }}Time"
                     value="{% if ra %}{{ ra.time }}{% endif %}"
                     style="padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label>HR
              <input type="number" step="any" name="reassessment{{ i }}Hr"
                     value="{% if ra and ra.hr %}{{ ra.hr }}{% endif %}"
                     style="width:80px;padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label>RR
              <input type="number" step="any" name="reassessment{{ i }}Rr"
                     value="{% if ra and ra.rr %}{{ ra.rr }}{% endif %}"
                     style="width:80px;padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label>Temp °C
              <input type="number" step="any" name="reassessment{{ i }}TempC"
                     value="{% if ra and ra.tempC %}{{ ra.tempC }}{% endif %}"
                     style="width:80px;padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label>SpO2
              <input type="number" step="any" name="reassessment{{ i }}Spo2"
                     value="{% if ra and ra.spo2 %}{{ ra.spo2 }}{% endif %}"
                     style="width:80px;padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label>Pain
              <input type="number" step="any" name="reassessment{{ i }}Pain"
                     value="{% if ra and ra.pain %}{{ ra.pain }}{% endif %}"
                     style="width:80px;padding:0.3rem;border:1px solid #ccc;border-radius:4px;"></label>
            <label><input type="checkbox" name="reassessment{{ i }}Unchanged" value="on"
                          {% if ra and ra.unchanged %}checked{% endif %}> Unchanged</label>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Step 16 — Disposition -->
    <div x-show="step === 16" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 16: Disposition</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Disposition</label>
          <input type="text" name="disposition" value="{{ data.disposition.disposition }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Handover time</label>
          <input type="time" name="handoverTime" value="{{ data.disposition.handoverTime }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Handover to (name)</label>
          <input type="text" name="handoverToName" value="{{ data.disposition.handoverToName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Handover to (cadre)</label>
          <input type="text" name="handoverToCadre" value="{{ data.disposition.handoverToCadre }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>Plan discussed with patient</label>
          <select name="planDiscussedWithPatient" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value=""    {% if data.disposition.planDiscussedWithPatient == "" %}selected{% endif %}>-- Select --</option>
            <option value="yes" {% if data.disposition.planDiscussedWithPatient == "yes" %}selected{% endif %}>Yes</option>
            <option value="no"  {% if data.disposition.planDiscussedWithPatient == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Provider name</label>
          <input type="text" name="providerName" value="{{ data.disposition.providerName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Provider signature</label>
          <input type="text" name="providerSignature" value="{{ data.disposition.providerSignature }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="providerSignatureDate" value="{{ data.disposition.providerSignatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;">
      <button type="button" @click="if (step > 1) step--"
              :disabled="step <= 1"
              style="padding:0.5rem 1.2rem;">&laquo; Previous</button>

      <button type="button" x-show="step < totalSteps" @click="if (step < totalSteps) step++"
              style="padding:0.5rem 1.2rem;">Next &raquo;</button>

      <button type="submit" x-show="step === totalSteps"
              style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Submit Assessment
      </button>
    </div>
  </form>
</div>
{% endblock %}
