<div class="card">
    <h2>Step 7: Circulation (C)</h2>

    <div class="form-group">
        <label><input type="checkbox" name="circulation.normal" value="on" {% if circulation.normal %}checked{% endif %}> Normal</label>
    </div>

    <h3>Skin</h3>
    <div class="form-group">
        <label><input type="checkbox" name="circulation.skin_warm" value="on" {% if circulation.skinWarm %}checked{% endif %}> Warm</label>
        <label><input type="checkbox" name="circulation.skin_dry" value="on" {% if circulation.skinDry %}checked{% endif %}> Dry</label>
        <label><input type="checkbox" name="circulation.skin_pale" value="on" {% if circulation.skinPale %}checked{% endif %}> Pale</label>
        <label><input type="checkbox" name="circulation.skin_cyanotic" value="on" {% if circulation.skinCyanotic %}checked{% endif %}> Cyanotic</label>
        <label><input type="checkbox" name="circulation.skin_moist" value="on" {% if circulation.skinMoist %}checked{% endif %}> Moist</label>
        <label><input type="checkbox" name="circulation.skin_cool" value="on" {% if circulation.skinCool %}checked{% endif %}> Cool</label>
    </div>

    <h3>Capillary refill</h3>
    <div class="form-group">
        <label><input type="checkbox" name="circulation.capillary_refill_under3" value="on" {% if circulation.capillaryRefillUnder3 %}checked{% endif %}> &lt; 3 sec</label>
        <label><input type="checkbox" name="circulation.capillary_refill3_or_more" value="on" {% if circulation.capillaryRefill3OrMore %}checked{% endif %}> &ge; 3 sec</label>
    </div>

    <h3>Pulses</h3>
    <div class="form-group">
        <label><input type="checkbox" name="circulation.pulses_weak" value="on" {% if circulation.pulsesWeak %}checked{% endif %}> Weak</label>
        <label><input type="checkbox" name="circulation.pulses_asymmetric" value="on" {% if circulation.pulsesAsymmetric %}checked{% endif %}> Asymmetric</label>
    </div>

    <div class="form-group">
        <label for="jvd">JVD</label>
        <select id="jvd" name="circulation.jvd">
            <option value="" {% if circulation.jvd == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if circulation.jvd == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if circulation.jvd == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <h3>Bleeding</h3>
    <div class="form-group">
        <label for="active_bleeding_site">Active bleeding site</label>
        <input type="text" id="active_bleeding_site" name="circulation.active_bleeding_site" value="{{ circulation.activeBleedingSite }}">
    </div>
    <div class="form-group">
        <label><input type="checkbox" name="circulation.bleeding_controlled_bandage" value="on" {% if circulation.bleedingControlledBandage %}checked{% endif %}> Bandage</label>
        <label><input type="checkbox" name="circulation.bleeding_controlled_tourniquet" value="on" {% if circulation.bleedingControlledTourniquet %}checked{% endif %}> Tourniquet</label>
        <label><input type="checkbox" name="circulation.bleeding_controlled_direct_pressure" value="on" {% if circulation.bleedingControlledDirectPressure %}checked{% endif %}> Direct pressure</label>
    </div>
    <div class="form-group">
        <label for="bleeding_control_time">Bleeding control time</label>
        <input type="time" id="bleeding_control_time" name="circulation.bleeding_control_time" value="{{ circulation.bleedingControlTime }}">
    </div>

    <h3>Access &amp; Fluids</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="access_iv_site">IV site</label>
            <input type="text" id="access_iv_site" name="circulation.access_iv_site" value="{{ circulation.accessIvSite }}">
        </div>
        <div class="form-group">
            <label for="access_iv_size">IV size</label>
            <input type="text" id="access_iv_size" name="circulation.access_iv_size" value="{{ circulation.accessIvSize }}">
        </div>
        <div class="form-group">
            <label for="access_io_site">IO site</label>
            <input type="text" id="access_io_site" name="circulation.access_io_site" value="{{ circulation.accessIoSite }}">
        </div>
        <div class="form-group">
            <label for="access_io_size">IO size</label>
            <input type="text" id="access_io_size" name="circulation.access_io_size" value="{{ circulation.accessIoSize }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="ivf_mls">IVF (ml)</label>
            <input type="number" step="1" id="ivf_mls" name="circulation.ivf_mls" value="{{ circulation.ivfMls }}">
        </div>
        <div class="form-group">
            <label><input type="checkbox" name="circulation.ivf_ns" value="on" {% if circulation.ivfNs %}checked{% endif %}> NS</label>
            <label><input type="checkbox" name="circulation.ivf_lr" value="on" {% if circulation.ivfLr %}checked{% endif %}> LR</label>
        </div>
        <div class="form-group">
            <label for="ivf_other">IVF Other</label>
            <input type="text" id="ivf_other" name="circulation.ivf_other" value="{{ circulation.ivfOther }}">
        </div>
    </div>

    <div class="form-group">
        <label><input type="checkbox" name="circulation.pelvis_stabilized" value="on" {% if circulation.pelvisStabilized %}checked{% endif %}> Pelvis stabilized</label>
        <label><input type="checkbox" name="circulation.femur_fracture_stabilized" value="on" {% if circulation.femurFractureStabilized %}checked{% endif %}> Femur fracture stabilised</label>
    </div>

    <div class="form-group">
        <label for="circulation_notes">Notes</label>
        <textarea id="circulation_notes" name="circulation.notes">{{ circulation.notes }}</textarea>
    </div>
</div>
