<div class="card">
    <h2>Step 9: Exposure (E)</h2>

    <div class="form-group">
        <label><input type="checkbox" name="exposure.normal" value="on" {% if exposure.normal %}checked{% endif %}> Normal</label>
        <label><input type="checkbox" name="exposure.exposed_completely" value="on" {% if exposure.exposedCompletely %}checked{% endif %}> Exposed completely</label>
    </div>

    <div class="form-group">
        <label for="exposure_notes">Notes</label>
        <textarea id="exposure_notes" name="exposure.notes">{{ exposure.notes }}</textarea>
    </div>
</div>
