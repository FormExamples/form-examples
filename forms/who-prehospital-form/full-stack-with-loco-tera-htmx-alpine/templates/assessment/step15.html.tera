<div class="card">
    <h2>Step 15: Reassessment</h2>
    <p class="form-hint">Up to three reassessment vital-sign sets.</p>

    {% for i in range(end=3) %}
    <fieldset class="team-member-row">
        <legend>Reassessment {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="ra_{{ i }}_time">Time</label>
                <input type="time" id="ra_{{ i }}_time" name="reassessments[{{ i }}].time"
                       value="{% if reassessments | length > i %}{{ reassessments[i].time }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="ra_{{ i }}_hr">HR</label>
                <input type="number" id="ra_{{ i }}_hr" name="reassessments[{{ i }}].hr"
                       value="{% if reassessments | length > i %}{{ reassessments[i].hr }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="ra_{{ i }}_rr">RR</label>
                <input type="number" id="ra_{{ i }}_rr" name="reassessments[{{ i }}].rr"
                       value="{% if reassessments | length > i %}{{ reassessments[i].rr }}{% endif %}">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="ra_{{ i }}_temp_c">Temp (°C)</label>
                <input type="number" step="0.1" id="ra_{{ i }}_temp_c" name="reassessments[{{ i }}].temp_c"
                       value="{% if reassessments | length > i %}{{ reassessments[i].tempC }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="ra_{{ i }}_spo2">SpO2</label>
                <input type="number" id="ra_{{ i }}_spo2" name="reassessments[{{ i }}].spo2"
                       value="{% if reassessments | length > i %}{{ reassessments[i].spo2 }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="ra_{{ i }}_rbs">RBS</label>
                <input type="number" step="0.1" id="ra_{{ i }}_rbs" name="reassessments[{{ i }}].rbs"
                       value="{% if reassessments | length > i %}{{ reassessments[i].rbs }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="ra_{{ i }}_pain">Pain</label>
                <input type="number" min="0" max="10" id="ra_{{ i }}_pain" name="reassessments[{{ i }}].pain"
                       value="{% if reassessments | length > i %}{{ reassessments[i].pain }}{% endif %}">
            </div>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" name="reassessments[{{ i }}].unchanged" value="on"
                       {% if reassessments | length > i and reassessments[i].unchanged %}checked{% endif %}>
                Unchanged
            </label>
        </div>
    </fieldset>
    {% endfor %}
</div>
