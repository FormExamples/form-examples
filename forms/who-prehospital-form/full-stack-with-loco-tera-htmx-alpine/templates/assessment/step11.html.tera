<div class="card">
    <h2>Step 11: Injury Details</h2>
    <p class="form-hint">Complete only if "Injury" is checked on step 2.</p>

    <div class="form-group">
        <label for="injury_intent">Intent</label>
        <select id="injury_intent" name="injury_details.intent">
            <option value="" {% if injury_details.intent == "" %}selected{% endif %}>&mdash;</option>
            <option value="intentional" {% if injury_details.intent == "intentional" %}selected{% endif %}>Intentional</option>
            <option value="unintentional" {% if injury_details.intent == "unintentional" %}selected{% endif %}>Unintentional</option>
            <option value="self-inflicted" {% if injury_details.intent == "self-inflicted" %}selected{% endif %}>Self-inflicted</option>
        </select>
    </div>

    <h3>Mechanism</h3>
    <div class="form-group">
        <label><input type="checkbox" name="injury_details.mechanism_fall" value="on" {% if injury_details.mechanismFall %}checked{% endif %}> Fall</label>
        <label><input type="checkbox" name="injury_details.mechanism_hit_by_falling_object" value="on" {% if injury_details.mechanismHitByFallingObject %}checked{% endif %}> Hit by falling object</label>
        <label><input type="checkbox" name="injury_details.mechanism_stab_cut" value="on" {% if injury_details.mechanismStabCut %}checked{% endif %}> Stab / cut</label>
        <label><input type="checkbox" name="injury_details.mechanism_gunshot" value="on" {% if injury_details.mechanismGunshot %}checked{% endif %}> Gunshot</label>
        <label><input type="checkbox" name="injury_details.mechanism_sexual_assault" value="on" {% if injury_details.mechanismSexualAssault %}checked{% endif %}> Sexual assault</label>
        <label><input type="checkbox" name="injury_details.mechanism_other_blunt_force" value="on" {% if injury_details.mechanismOtherBluntForce %}checked{% endif %}> Other blunt force</label>
        <label><input type="checkbox" name="injury_details.mechanism_suffocation_choking_hanging" value="on" {% if injury_details.mechanismSuffocationChokingHanging %}checked{% endif %}> Suffocation / choking / hanging</label>
        <label><input type="checkbox" name="injury_details.mechanism_drowning" value="on" {% if injury_details.mechanismDrowning %}checked{% endif %}> Drowning</label>
        <label><input type="checkbox" name="injury_details.mechanism_poisoning_toxic_exposure" value="on" {% if injury_details.mechanismPoisoningToxicExposure %}checked{% endif %}> Poisoning / toxic exposure</label>
        <label><input type="checkbox" name="injury_details.mechanism_unknown" value="on" {% if injury_details.mechanismUnknown %}checked{% endif %}> Unknown</label>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="mechanism_drowning_life_vest">Drowning life vest</label>
            <select id="mechanism_drowning_life_vest" name="injury_details.mechanism_drowning_life_vest">
                <option value="" {% if injury_details.mechanismDrowningLifeVest == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if injury_details.mechanismDrowningLifeVest == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if injury_details.mechanismDrowningLifeVest == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="mechanism_burn_caused_by">Burn caused by</label>
            <input type="text" id="mechanism_burn_caused_by" name="injury_details.mechanism_burn_caused_by" value="{{ injury_details.mechanismBurnCausedBy }}">
        </div>
        <div class="form-group">
            <label for="mechanism_other">Other mechanism</label>
            <input type="text" id="mechanism_other" name="injury_details.mechanism_other" value="{{ injury_details.mechanismOther }}">
        </div>
    </div>

    <h3>Road traffic incident</h3>
    <div class="form-group">
        <label><input type="checkbox" name="injury_details.road_traffic_driver" value="on" {% if injury_details.roadTrafficDriver %}checked{% endif %}> Driver</label>
        <label><input type="checkbox" name="injury_details.road_traffic_passenger" value="on" {% if injury_details.roadTrafficPassenger %}checked{% endif %}> Passenger</label>
        <label><input type="checkbox" name="injury_details.road_traffic_pedestrian" value="on" {% if injury_details.roadTrafficPedestrian %}checked{% endif %}> Pedestrian</label>
        <label><input type="checkbox" name="injury_details.road_traffic_ejected" value="on" {% if injury_details.roadTrafficEjected %}checked{% endif %}> Ejected</label>
        <label><input type="checkbox" name="injury_details.road_traffic_extricated" value="on" {% if injury_details.roadTrafficExtricated %}checked{% endif %}> Extricated</label>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="vehicle_type">Vehicle</label>
            <select id="vehicle_type" name="injury_details.vehicle_type">
                <option value="" {% if injury_details.vehicleType == "" %}selected{% endif %}>&mdash;</option>
                <option value="car" {% if injury_details.vehicleType == "car" %}selected{% endif %}>Car</option>
                <option value="bike" {% if injury_details.vehicleType == "bike" %}selected{% endif %}>Bike</option>
                <option value="motorbike" {% if injury_details.vehicleType == "motorbike" %}selected{% endif %}>Motorbike</option>
                <option value="other" {% if injury_details.vehicleType == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vehicle_other">Vehicle other</label>
            <input type="text" id="vehicle_other" name="injury_details.vehicle_other" value="{{ injury_details.vehicleOther }}">
        </div>
    </div>

    <h3>Safety</h3>
    <div class="form-group">
        <label><input type="checkbox" name="injury_details.safety_airbag" value="on" {% if injury_details.safetyAirbag %}checked{% endif %}> Airbag</label>
        <label><input type="checkbox" name="injury_details.safety_seatbelt" value="on" {% if injury_details.safetySeatbelt %}checked{% endif %}> Seatbelt</label>
        <label><input type="checkbox" name="injury_details.safety_helmet" value="on" {% if injury_details.safetyHelmet %}checked{% endif %}> Helmet</label>
    </div>
    <div class="form-group">
        <label for="safety_other_restraint">Other restraint</label>
        <input type="text" id="safety_other_restraint" name="injury_details.safety_other_restraint" value="{{ injury_details.safetyOtherRestraint }}">
    </div>
</div>
