<div class="card">
    <h2>Step 12: Physical Exam</h2>
    <p class="form-hint">For each system, tick "Normal" or describe findings.</p>

    {% set systems = [
        ["general", "General", physical_exam.general],
        ["heent", "HEENT", physical_exam.heent],
        ["respiratory", "Respiratory", physical_exam.respiratory],
        ["cardiac", "Cardiac", physical_exam.cardiac],
        ["abdominal", "Abdominal", physical_exam.abdominal],
        ["pelvis_gu", "Pelvis / GU", physical_exam.pelvisGu],
        ["neurologic", "Neurologic", physical_exam.neurologic],
        ["psychiatric", "Psychiatric", physical_exam.psychiatric],
        ["musculoskeletal", "Musculoskeletal", physical_exam.musculoskeletal],
        ["skin", "Skin", physical_exam.skin]
    ] %}

    {% for s in systems %}
    <fieldset>
        <legend>{{ s[1] }}</legend>
        <div class="form-group">
            <label><input type="checkbox" name="physical_exam.{{ s[0] }}.normal" value="on" {% if s[2].normal %}checked{% endif %}> Normal</label>
        </div>
        <div class="form-group">
            <label for="pe_{{ s[0] }}_notes">Notes</label>
            <textarea id="pe_{{ s[0] }}_notes" name="physical_exam.{{ s[0] }}.notes">{{ s[2].notes }}</textarea>
        </div>
    </fieldset>
    {% endfor %}
</div>
