<div class="card">
    <h2>Step 2: Chief Complaint &amp; Initial Vitals</h2>

    <div class="form-group">
        <label for="chief_complaint">Chief complaint</label>
        <input type="text" id="chief_complaint" name="chief_complaint_and_vitals.chief_complaint" value="{{ chief_complaint_and_vitals.chiefComplaint }}">
    </div>

    <div class="form-group">
        <label><input type="checkbox" name="chief_complaint_and_vitals.injury" value="on"
               {% if chief_complaint_and_vitals.injury %}checked{% endif %}> Injury</label>
    </div>

    <h3>Initial Vital Signs</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="vitals_time">Time</label>
            <input type="time" id="vitals_time" name="chief_complaint_and_vitals.initial_vitals.time" value="{{ chief_complaint_and_vitals.initialVitals.time }}">
        </div>
        <div class="form-group">
            <label for="vitals_hr">HR (bpm)</label>
            <input type="number" id="vitals_hr" name="chief_complaint_and_vitals.initial_vitals.hr" value="{{ chief_complaint_and_vitals.initialVitals.hr }}">
        </div>
        <div class="form-group">
            <label for="vitals_rr">RR (/min)</label>
            <input type="number" id="vitals_rr" name="chief_complaint_and_vitals.initial_vitals.rr" value="{{ chief_complaint_and_vitals.initialVitals.rr }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="vitals_bp">BP</label>
            <input type="text" id="vitals_bp" name="chief_complaint_and_vitals.initial_vitals.bp" value="{{ chief_complaint_and_vitals.initialVitals.bp }}" placeholder="120/80">
        </div>
        <div class="form-group">
            <label for="vitals_temp_c">Temp (°C)</label>
            <input type="number" step="0.1" id="vitals_temp_c" name="chief_complaint_and_vitals.initial_vitals.temp_c" value="{{ chief_complaint_and_vitals.initialVitals.tempC }}">
        </div>
        <div class="form-group">
            <label for="vitals_rbs">RBS</label>
            <input type="number" step="0.1" id="vitals_rbs" name="chief_complaint_and_vitals.initial_vitals.rbs" value="{{ chief_complaint_and_vitals.initialVitals.rbs }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="vitals_spo2">SpO2 (%)</label>
            <input type="number" id="vitals_spo2" name="chief_complaint_and_vitals.initial_vitals.spo2" value="{{ chief_complaint_and_vitals.initialVitals.spo2 }}">
        </div>
        <div class="form-group">
            <label for="vitals_spo2_on_oxygen">SpO2 on oxygen</label>
            <input type="text" id="vitals_spo2_on_oxygen" name="chief_complaint_and_vitals.initial_vitals.spo2_on_oxygen" value="{{ chief_complaint_and_vitals.initialVitals.spo2OnOxygen }}">
        </div>
    </div>

    <div class="form-group">
        <label for="care_in_progress">Care in progress on arrival</label>
        <textarea id="care_in_progress" name="chief_complaint_and_vitals.care_in_progress_on_arrival">{{ chief_complaint_and_vitals.careInProgressOnArrival }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="pregnant">Pregnant</label>
            <select id="pregnant" name="chief_complaint_and_vitals.pregnant">
                <option value="" {% if chief_complaint_and_vitals.pregnant == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if chief_complaint_and_vitals.pregnant == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if chief_complaint_and_vitals.pregnant == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if chief_complaint_and_vitals.pregnant == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="pain_score">Pain score (0-10)</label>
            <input type="number" min="0" max="10" id="pain_score" name="chief_complaint_and_vitals.pain_score" value="{{ chief_complaint_and_vitals.painScore }}">
        </div>
    </div>
</div>
