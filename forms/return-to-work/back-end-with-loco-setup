cargo loco generate scaffold return_to_work_grade_flag \
    deleted_at:tstz \
    return_to_work_grade:references \
    flag_code:string! \
    flag_title:string! \
    flag_category:string! \
    flag_priority:string! \
    flag_evidence:text! \
    flag_recommendation:text! \
    --api
