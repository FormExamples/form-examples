#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf

createuser --host=localhost --port=5432 --username=postgres --login --createdb loco || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco return_to_work_development || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco return_to_work_test || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco return_to_work_production || :

echo "Scaffolding return-to-work (8 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    job_title:string! \
    role_description:text! \
    contracted_hours_per_week:double \
    shift_pattern:string! \
    safety_critical_role:string! \
    dvla_group_1_licence_held:string! \
    dvla_group_2_licence_held:string! \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    site_name:string! \
    practice_ods_code:string! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold employer \
    deleted_at:ts \
    name:string! \
    industry_sector:string! \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    occupational_health_contact_name:text! \
    occupational_health_contact_email:text! \
    occupational_health_contact_phone:text! \
    hr_contact_name:text! \
    hr_contact_email:text! \
    --htmx && \
cargo loco generate scaffold return_to_work \
    deleted_at:ts \
    patient:references \
    clinician:references \
    employer:references \
    status:string! \
    statement_kind:string! \
    assessment_date:date \
    assessment_time:string \
    absence_first_day:date \
    absence_total_calendar_days:int \
    prior_med3_reference:string! \
    prior_self_certification_reference:string! \
    primary_diagnosis_text:string! \
    primary_diagnosis_snomed:string! \
    primary_diagnosis_icd10:string! \
    comorbid_conditions:text! \
    mechanism:string! \
    workplace_cause:string! \
    riddor_reference:string! \
    current_medications:text! \
    ongoing_therapy:text! \
    last_consultation_date:date \
    anticipated_recovery_trajectory:string! \
    specialist_followup_required:string! \
    mobility:string! \
    manual_handling_capacity_kg:double \
    cognition:string! \
    mood:string! \
    sleep:string! \
    pain_score_0_10:int \
    driving_capacity:string! \
    standing_tolerance_minutes:int \
    sitting_tolerance_minutes:int \
    screen_tolerance_minutes:int \
    adl_independence:string! \
    fitness_statement_computed:string! \
    fitness_statement_final:string! \
    clinician_override:string! \
    clinician_override_reason:text! \
    clinician_confidence:string! \
    valid_from:date \
    valid_until:date \
    validity_weeks:int \
    reassessment_required:string! \
    phased_return_applicable:string! \
    phased_return_template:string! \
    phased_return_target_date:date \
    phased_return_schedule_json:text! \
    phased_return_support_contact:text! \
    workstation_review_required:string! \
    additional_adjustments_text:text! \
    review_location:string! \
    review_date:date \
    occupational_health_referral_made:string! \
    dvla_notification_required:string! \
    employer_oh_notified:string! \
    return_to_work_meeting_scheduled:string! \
    maternity_certificate_reference:string! \
    final_notes:text! \
    signature_svg:text! \
    signed_at:ts \
    --htmx && \
cargo loco generate scaffold return_to_work_restriction \
    deleted_at:ts \
    return_to_work:references \
    kind:string! \
    severity:string! \
    quantitative_limit:string! \
    notes:string! \
    start_date:date \
    end_date:date \
    priority_rank:int! \
    --htmx && \
cargo loco generate scaffold return_to_work_grade \
    deleted_at:ts \
    return_to_work:references \
    fitness_statement:string! \
    restriction_priority:string! \
    rule_count:int! \
    flag_count:int! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold return_to_work_grade_rule \
    deleted_at:ts \
    return_to_work_grade:references \
    rule_code:string! \
    rule_title:string! \
    rule_band:string! \
    rule_priority:string! \
    rule_kind:string! \
    rule_evidence:text! \
    rule_notes:text! \
    --htmx && \
cargo loco generate scaffold return_to_work_grade_flag \
    deleted_at:ts \
    return_to_work_grade:references \
    flag_code:string! \
    flag_title:string! \
    flag_category:string! \
    flag_priority:string! \
    flag_evidence:text! \
    flag_recommendation:text! \
    --htmx

echo "Done."
