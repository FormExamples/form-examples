<div class="card">
    <h2>Step 6: History (Hx)</h2>
    <p class="form-hint">Related tickets, prior occurrences, recent change references, timeline.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="hx_hx_related_issues">Related issues</label>
            <input type="text" id="hx_hx_related_issues" name="hx.hx_related_issues"
                   value="{{ hx.hxRelatedIssues }}" maxlength="500">
        </div>
        <div class="form-group">
            <label for="hx_hx_prior_occurrences">Prior occurrences (count)</label>
            <input type="number" id="hx_hx_prior_occurrences" name="hx.hx_prior_occurrences"
                   value="{{ hx.hxPriorOccurrences }}" min="0">
        </div>
    </div>

    <div class="form-group">
        <label for="hx_hx_recent_change_url">Recent change URL</label>
        <input type="url" id="hx_hx_recent_change_url" name="hx.hx_recent_change_url"
               value="{{ hx.hxRecentChangeUrl }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="hx_hx_references">References (runbooks, RFCs, post-mortems)</label>
        <textarea id="hx_hx_references" name="hx.hx_references"
                  rows="3">{{ hx.hxReferences }}</textarea>
    </div>

    <div class="form-group">
        <label for="hx_hx_timeline">Timeline</label>
        <textarea id="hx_hx_timeline" name="hx.hx_timeline"
                  rows="3">{{ hx.hxTimeline }}</textarea>
    </div>
</div>
