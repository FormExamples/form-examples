<div class="card">
    <h2>Step 3: Participants (Pt)</h2>
    <p class="form-hint">Discoverer, affected users, assignees, stakeholders to inform.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="pt_pt_discoverer_name">Discoverer name</label>
            <input type="text" id="pt_pt_discoverer_name" name="pt.pt_discoverer_name"
                   value="{{ pt.ptDiscovererName }}">
        </div>
        <div class="form-group">
            <label for="pt_pt_affected_users_count">Affected users (count)</label>
            <input type="number" id="pt_pt_affected_users_count" name="pt.pt_affected_users_count"
                   value="{{ pt.ptAffectedUsersCount }}" min="0">
        </div>
    </div>

    <div class="form-group">
        <label for="pt_pt_affected_user_groups">Affected user groups</label>
        <input type="text" id="pt_pt_affected_user_groups" name="pt.pt_affected_user_groups"
               value="{{ pt.ptAffectedUserGroups }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="pt_pt_assignees">Assignees</label>
        <input type="text" id="pt_pt_assignees" name="pt.pt_assignees"
               value="{{ pt.ptAssignees }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="pt_pt_stakeholders_to_inform">Stakeholders to inform</label>
        <input type="text" id="pt_pt_stakeholders_to_inform" name="pt.pt_stakeholders_to_inform"
               value="{{ pt.ptStakeholdersToInform }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="pt_pt_observers">Observers / CC</label>
        <input type="text" id="pt_pt_observers" name="pt.pt_observers"
               value="{{ pt.ptObservers }}" maxlength="500">
    </div>
</div>
