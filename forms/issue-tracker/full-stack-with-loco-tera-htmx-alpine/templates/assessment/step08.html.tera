<div class="card">
    <h2>Step 8: Diagnosis (Dx)</h2>
    <p class="form-hint">Root cause, contributing causes, blast radius, confidence.</p>

    <div class="form-group">
        <label for="dx_dx_root_cause">Root cause</label>
        <textarea id="dx_dx_root_cause" name="dx.dx_root_cause"
                  rows="3">{{ dx.dxRootCause }}</textarea>
    </div>

    <div class="form-group">
        <label for="dx_dx_contributing_causes">Contributing / cascading causes</label>
        <textarea id="dx_dx_contributing_causes" name="dx.dx_contributing_causes"
                  rows="3">{{ dx.dxContributingCauses }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dx_dx_scope">Scope (blast radius)</label>
            <select id="dx_dx_scope" name="dx.dx_scope">
                <option value="" {% if dx.dxScope == "" %}selected{% endif %}>&mdash;</option>
                <option value="single-instance" {% if dx.dxScope == "single-instance" %}selected{% endif %}>Single instance</option>
                <option value="single-service" {% if dx.dxScope == "single-service" %}selected{% endif %}>Single service</option>
                <option value="multiple-services" {% if dx.dxScope == "multiple-services" %}selected{% endif %}>Multiple services</option>
                <option value="whole-system" {% if dx.dxScope == "whole-system" %}selected{% endif %}>Whole system</option>
                <option value="organisation-wide" {% if dx.dxScope == "organisation-wide" %}selected{% endif %}>Organisation wide</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dx_dx_confirmed">Diagnosis confirmed?</label>
            <select id="dx_dx_confirmed" name="dx.dx_confirmed">
                <option value="" {% if dx.dxConfirmed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if dx.dxConfirmed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if dx.dxConfirmed == "no" %}selected{% endif %}>No</option>
                <option value="partial" {% if dx.dxConfirmed == "partial" %}selected{% endif %}>Partial</option>
            </select>
        </div>
    </div>
</div>
