<div class="card">
    <h2>Step 2: Chief Complaint (CC)</h2>
    <p class="form-hint">One-sentence summary plus a free-text long description.</p>

    <div class="form-group">
        <label for="cc_cc_summary">Summary (one sentence)</label>
        <input type="text" id="cc_cc_summary" name="cc.cc_summary"
               value="{{ cc.ccSummary }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="cc_cc_long_description">Long description</label>
        <textarea id="cc_cc_long_description" name="cc.cc_long_description"
                  rows="4">{{ cc.ccLongDescription }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cc_cc_reported_by_name">Reported by (name)</label>
            <input type="text" id="cc_cc_reported_by_name" name="cc.cc_reported_by_name"
                   value="{{ cc.ccReportedByName }}">
        </div>
        <div class="form-group">
            <label for="cc_cc_reported_via">Reported via</label>
            <select id="cc_cc_reported_via" name="cc.cc_reported_via">
                <option value="" {% if cc.ccReportedVia == "" %}selected{% endif %}>&mdash;</option>
                <option value="self" {% if cc.ccReportedVia == "self" %}selected{% endif %}>Self</option>
                <option value="colleague" {% if cc.ccReportedVia == "colleague" %}selected{% endif %}>Colleague</option>
                <option value="customer" {% if cc.ccReportedVia == "customer" %}selected{% endif %}>Customer</option>
                <option value="monitoring-alert" {% if cc.ccReportedVia == "monitoring-alert" %}selected{% endif %}>Monitoring alert</option>
                <option value="ticket" {% if cc.ccReportedVia == "ticket" %}selected{% endif %}>Ticket</option>
                <option value="phone" {% if cc.ccReportedVia == "phone" %}selected{% endif %}>Phone</option>
                <option value="email" {% if cc.ccReportedVia == "email" %}selected{% endif %}>Email</option>
                <option value="chat" {% if cc.ccReportedVia == "chat" %}selected{% endif %}>Chat</option>
                <option value="in-person" {% if cc.ccReportedVia == "in-person" %}selected{% endif %}>In person</option>
                <option value="other" {% if cc.ccReportedVia == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>
</div>
