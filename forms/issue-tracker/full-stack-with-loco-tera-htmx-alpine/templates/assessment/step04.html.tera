<div class="card">
    <h2>Step 4: Symptoms (Sx)</h2>
    <p class="form-hint">External signals, alert IDs, error messages, attachments.</p>

    <div class="form-group">
        <label for="sx_sx_external_signals">External signals</label>
        <textarea id="sx_sx_external_signals" name="sx.sx_external_signals"
                  rows="3">{{ sx.sxExternalSignals }}</textarea>
    </div>

    <div class="form-group">
        <label for="sx_sx_alert_ids">Alert IDs (Sentry, PagerDuty, Datadog, CloudWatch)</label>
        <input type="text" id="sx_sx_alert_ids" name="sx.sx_alert_ids"
               value="{{ sx.sxAlertIds }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="sx_sx_error_messages">Error messages / status codes / stack traces</label>
        <textarea id="sx_sx_error_messages" name="sx.sx_error_messages"
                  rows="3">{{ sx.sxErrorMessages }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sx_sx_screenshots_url">Screenshots URL</label>
            <input type="url" id="sx_sx_screenshots_url" name="sx.sx_screenshots_url"
                   value="{{ sx.sxScreenshotsUrl }}" maxlength="500">
        </div>
        <div class="form-group">
            <label for="sx_sx_logs_url">Logs URL</label>
            <input type="url" id="sx_sx_logs_url" name="sx.sx_logs_url"
                   value="{{ sx.sxLogsUrl }}" maxlength="500">
        </div>
        <div class="form-group">
            <label for="sx_sx_first_observed_at">First observed at</label>
            <input type="datetime-local" id="sx_sx_first_observed_at" name="sx.sx_first_observed_at"
                   value="{{ sx.sxFirstObservedAt }}">
        </div>
    </div>
</div>
