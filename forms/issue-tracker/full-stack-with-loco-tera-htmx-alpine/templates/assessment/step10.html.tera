<fieldset class="step">
  <legend>Step 10 — Score &amp; sign-off</legend>

  <label>Priority rank (1 = do first, ascending) <input name="score_by_priority_rank" type="number" min="1" max="999" value="{{ data.score_by_priority_rank | default(value='') }}"></label>

  <label>Severity of impact (1 minimal &rarr; 5 catastrophic)
    <select name="score_by_severity_of_impact">
      {% set sev = data.score_by_severity_of_impact | default(value='') %}
      <option value="" {% if sev == '' %}selected{% endif %}>(unspecified)</option>
      {% for v in [1,2,3,4,5] %}
        <option value="{{ v }}" {% if sev == v %}selected{% endif %}>{{ v }}</option>
      {% endfor %}
    </select>
  </label>

  <label>Magnitude of damage (1 minor &rarr; 10 total destruction) <input name="score_by_magnitude_of_damage" type="number" min="1" max="10" value="{{ data.score_by_magnitude_of_damage | default(value='') }}"></label>

  <label>Harm grade (NHS LFPSE)
    <select name="score_by_harm_grade">
      {% set h = data.score_by_harm_grade | default(value='') %}
      <option value="" {% if h == '' %}selected{% endif %}>(unspecified)</option>
      {% for v in [0,1,2,3,4] %}
        <option value="{{ v }}" {% if h == v %}selected{% endif %}>{{ v }}</option>
      {% endfor %}
    </select>
  </label>

  <label>Failure condition (FAA / EASA)
    <select name="score_by_failure_condition">
      {% set fc = data.score_by_failure_condition | default(value='') %}
      <option value="" {% if fc == '' %}selected{% endif %}>(unspecified)</option>
      {% for v in ['A','B','C','D','E'] %}
        <option value="{{ v }}" {% if fc == v %}selected{% endif %}>{{ v }}</option>
      {% endfor %}
    </select>
  </label>

  <label>MoSCoW requirement
    <select name="score_by_moscow_requirement">
      {% set mc = data.score_by_moscow_requirement | default(value='') %}
      <option value="" {% if mc == '' %}selected{% endif %}>(unspecified)</option>
      {% for v in [1,2,3,4] %}
        <option value="{{ v }}" {% if mc == v %}selected{% endif %}>{{ v }}</option>
      {% endfor %}
    </select>
  </label>

  <label>Frequency percent <input name="score_by_frequency_percent" type="number" min="0" max="100" step="0.01" value="{{ data.score_by_frequency_percent | default(value='') }}"></label>

  <label>Override reason (only if final priority differs from computed)
    <textarea name="override_reason" rows="2">{{ data.override_reason | default(value='') }}</textarea>
  </label>
</fieldset>
