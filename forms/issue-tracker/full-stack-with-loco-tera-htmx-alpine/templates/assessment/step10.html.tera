<div class="card">
    <h2>Step 10: Score &amp; sign-off</h2>
    <p class="form-hint">
        Seven independent scoring scales. The composite priority is the worst single-dimension band
        (max-grade algorithm).
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="scores_score_by_priority_rank">Priority rank (1 = do first)</label>
            <input type="number" id="scores_score_by_priority_rank" name="scores.score_by_priority_rank"
                   value="{{ scores.scoreByPriorityRank }}" min="1" max="999">
        </div>
        <div class="form-group">
            <label for="scores_score_by_severity_of_impact">Severity of impact (1&ndash;5)</label>
            <input type="number" id="scores_score_by_severity_of_impact" name="scores.score_by_severity_of_impact"
                   value="{{ scores.scoreBySeverityOfImpact }}" min="1" max="5">
        </div>
        <div class="form-group">
            <label for="scores_score_by_magnitude_of_damage">Magnitude of damage (1&ndash;10)</label>
            <input type="number" id="scores_score_by_magnitude_of_damage" name="scores.score_by_magnitude_of_damage"
                   value="{{ scores.scoreByMagnitudeOfDamage }}" min="1" max="10">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="scores_score_by_harm_grade">Harm grade (0&ndash;4, NHS LFPSE)</label>
            <input type="number" id="scores_score_by_harm_grade" name="scores.score_by_harm_grade"
                   value="{{ scores.scoreByHarmGrade }}" min="0" max="4">
        </div>
        <div class="form-group">
            <label for="scores_score_by_failure_condition">Failure condition (A&ndash;E, FAA / EASA)</label>
            <select id="scores_score_by_failure_condition" name="scores.score_by_failure_condition">
                <option value="" {% if scores.scoreByFailureCondition == "" %}selected{% endif %}>&mdash;</option>
                <option value="A" {% if scores.scoreByFailureCondition == "A" %}selected{% endif %}>A &mdash; catastrophic</option>
                <option value="B" {% if scores.scoreByFailureCondition == "B" %}selected{% endif %}>B &mdash; hazardous</option>
                <option value="C" {% if scores.scoreByFailureCondition == "C" %}selected{% endif %}>C &mdash; major</option>
                <option value="D" {% if scores.scoreByFailureCondition == "D" %}selected{% endif %}>D &mdash; minor</option>
                <option value="E" {% if scores.scoreByFailureCondition == "E" %}selected{% endif %}>E &mdash; no effect</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="scores_score_by_moscow_requirement">MoSCoW requirement (1=must, 4=won't)</label>
            <select id="scores_score_by_moscow_requirement" name="scores.score_by_moscow_requirement">
                <option value="" {% if scores.scoreByMoscowRequirement == "" %}selected{% endif %}>&mdash;</option>
                <option value="1" {% if scores.scoreByMoscowRequirement == 1 %}selected{% endif %}>1 &mdash; must have</option>
                <option value="2" {% if scores.scoreByMoscowRequirement == 2 %}selected{% endif %}>2 &mdash; should have</option>
                <option value="3" {% if scores.scoreByMoscowRequirement == 3 %}selected{% endif %}>3 &mdash; could have</option>
                <option value="4" {% if scores.scoreByMoscowRequirement == 4 %}selected{% endif %}>4 &mdash; won't have</option>
            </select>
        </div>
        <div class="form-group">
            <label for="scores_score_by_frequency_percent">Frequency percent (0&ndash;100)</label>
            <input type="number" step="0.01" id="scores_score_by_frequency_percent" name="scores.score_by_frequency_percent"
                   value="{{ scores.scoreByFrequencyPercent }}" min="0" max="100">
        </div>
    </div>
</div>
