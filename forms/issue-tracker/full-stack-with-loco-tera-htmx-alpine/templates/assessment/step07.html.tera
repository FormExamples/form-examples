<div class="card">
    <h2>Step 7: Investigations (Ix)</h2>
    <p class="form-hint">Hypotheses, reproduction steps, diagnostic queries, blocking unknowns.</p>

    <div class="form-group">
        <label for="ix_ix_hypotheses">Hypotheses</label>
        <textarea id="ix_ix_hypotheses" name="ix.ix_hypotheses"
                  rows="3">{{ ix.ixHypotheses }}</textarea>
    </div>

    <div class="form-group">
        <label for="ix_ix_repro_steps">Reproduction steps</label>
        <textarea id="ix_ix_repro_steps" name="ix.ix_repro_steps"
                  rows="3">{{ ix.ixReproSteps }}</textarea>
    </div>

    <div class="form-group">
        <label for="ix_ix_diagnostic_queries">Diagnostic queries / profiles / traces</label>
        <textarea id="ix_ix_diagnostic_queries" name="ix.ix_diagnostic_queries"
                  rows="3">{{ ix.ixDiagnosticQueries }}</textarea>
    </div>

    <div class="form-group">
        <label for="ix_ix_tests_run">Tests run</label>
        <input type="text" id="ix_ix_tests_run" name="ix.ix_tests_run"
               value="{{ ix.ixTestsRun }}" maxlength="500">
    </div>

    <div class="form-group">
        <label for="ix_ix_blocking_unknowns">Blocking unknowns</label>
        <textarea id="ix_ix_blocking_unknowns" name="ix.ix_blocking_unknowns"
                  rows="3">{{ ix.ixBlockingUnknowns }}</textarea>
    </div>
</div>
