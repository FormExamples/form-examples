#!/bin/sh
set -euf

form_kebab_case=issue-tracker
form_snake_case=issue_tracker

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold reporter \
    deleted_at:ts \
    name:string! \
    email:text! \
    phone:text! \
    role:string! \
    organisation:string! \
    team:string! \
    location:string! \
    timezone:string! \
    preferred_contact:string! \
    --api

cargo loco generate scaffold participant \
    deleted_at:ts \
    name:string! \
    email:text! \
    phone:text! \
    role:string! \
    organisation:string! \
    team:string! \
    notify_on:string! \
    --api

cargo loco generate scaffold issue_tracker \
    deleted_at:ts \
    reporter:references \
    status:string! \
    reported_at:ts! \
    discovered_at:ts \
    started_at:ts \
    resolved_at:ts \
    issue_category:string! \
    environment:string! \
    system_name:string! \
    component:string! \
    customer_or_project_tag:string! \
    external_reference:string! \
    cc_summary:string! \
    cc_long_description:text! \
    cc_reported_by_name:string! \
    cc_reported_via:string! \
    pt_discoverer_name:string! \
    pt_affected_users_count:int \
    pt_affected_user_groups:string! \
    pt_assignees:string! \
    pt_stakeholders_to_inform:string! \
    pt_observers:string! \
    sx_external_signals:text! \
    sx_alert_ids:string! \
    sx_error_messages:text! \
    sx_screenshots_url:string! \
    sx_logs_url:string! \
    sx_first_observed_at:ts \
    fx_broken_components:text! \
    fx_failed_services:string! \
    fx_stuck_processes:string! \
    fx_hardware_faults:string! \
    fx_data_corruption:string! \
    hx_related_issues:string! \
    hx_prior_occurrences:int \
    hx_recent_change_url:string! \
    hx_references:text! \
    hx_timeline:text! \
    ix_hypotheses:text! \
    ix_repro_steps:text! \
    ix_diagnostic_queries:text! \
    ix_tests_run:string! \
    ix_blocking_unknowns:text! \
    dx_root_cause:text! \
    dx_contributing_causes:text! \
    dx_scope:string! \
    dx_confirmed:string! \
    tx_mitigation_steps:text! \
    tx_fix_plan:text! \
    tx_workaround:text! \
    tx_rollback_plan:text! \
    tx_communication_plan:string! \
    px_expected_resolution_at:ts \
    px_residual_risk:text! \
    px_monitoring_plan:text! \
    px_recurrence_likelihood:string! \
    px_lessons_learned:text! \
    score_by_priority_rank:int \
    score_by_severity_of_impact:int \
    score_by_magnitude_of_damage:int \
    score_by_harm_grade:int \
    score_by_failure_condition:string! \
    score_by_moscow_requirement:int \
    score_by_frequency_percent:double \
    --api

cargo loco generate scaffold issue_tracker_grade \
    deleted_at:ts \
    issue_tracker:references \
    score_by_priority_rank:int \
    score_by_severity_of_impact:int \
    score_by_magnitude_of_damage:int \
    score_by_harm_grade:int \
    score_by_failure_condition:string! \
    score_by_moscow_requirement:int \
    score_by_frequency_percent:double \
    computed_composite_priority:string! \
    final_composite_priority:string! \
    override_reason:string! \
    recommendation:string! \
    triage_notes:text! \
    signed_by:string! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold issue_tracker_grade_rule \
    deleted_at:ts \
    issue_tracker_grade:references \
    rule_id:string! \
    instrument:string! \
    grade:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold issue_tracker_grade_flag \
    deleted_at:ts \
    issue_tracker_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
