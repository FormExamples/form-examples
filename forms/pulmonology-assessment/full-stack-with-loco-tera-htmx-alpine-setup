#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding pulmonology-assessment (9 tables)..."

cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    current_medications_deleted_at:ts \
    inhaler_use:string! \
    inhaler_technique_assessed:string! \
    inhaler_technique_adequate:string! \
    short_acting_bronchodilator:string! \
    saba_frequency:text! \
    long_acting_bronchodilator:string! \
    inhaled_corticosteroid:string! \
    combination_inhaler:string! \
    long_term_oxygen_therapy:string! \
    oxygen_flow_rate_lmin:double \
    oxygen_hours_per_day:int \
    nebuliser_use:string! \
    oral_medications:text! \
    medication_adherence:string! \
    additional_notes:text! \
    medication_item_deleted_at:ts \
    current_medications:references \
    medication_name:string! \
    dose:string! \
    frequency:string! \
    route:string! \
    indication:text! \
    sort_order:int! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    gold_stage:string! \
    gold_group:string! \
    fev1_predicted_pct:double \
    symptom_burden:string! \
    exacerbation_risk:string! \
    composite_score:int! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    gold_stage:string! \
    gold_group:string! \
    fev1_predicted_pct:double \
    symptom_burden:string! \
    exacerbation_risk:string! \
    composite_score:int! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx

echo "Done."
