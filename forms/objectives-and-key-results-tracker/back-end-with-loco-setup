#!/bin/sh
set -euf

form_kebab_case=objectives-and-key-results-tracker
form_snake_case=objectives_and_key_results_tracker

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold reporter \
    deleted_at:tstz \
    name:text! \
    email:text! \
    role:text! \
    --api

cargo loco generate scaffold participant \
    deleted_at:tstz \
    okr_objective_id:uuid! \
    role:text! \
    name:text! \
    email:text! \
    notes:text! \
    --api

cargo loco generate scaffold okr_objective \
    deleted_at:tstz \
    reporter:references \
    parent_objective:references \
    status:text! \
    level:text! \
    cycle:text! \
    cycle_start_date:date \
    cycle_end_date:date \
    team_or_org_name:text! \
    strategic_theme:text! \
    external_reference:text! \
    obj_title:text! \
    obj_long_description:text! \
    sa_parent_summary:text! \
    sa_business_value_statement:text! \
    in_initiatives:text! \
    in_supporting_links:text! \
    rk_known_risks:text! \
    rk_dependencies:text! \
    rk_blockers:text! \
    rk_mitigation_plans:text! \
    fc_expected_end_state:text! \
    fc_residual_risk:text! \
    score_by_progress_percent:double \
    score_by_confidence_decile:int \
    score_by_stretch_tier:int \
    score_by_alignment_grade:int \
    score_by_impact_tier:int \
    score_by_smart_quality:int \
    score_by_pace_deviation_percent:double \
    --api

cargo loco generate scaffold okr_key_result \
    deleted_at:tstz \
    okr_objective:references \
    position:int! \
    title:text! \
    kr_type:text! \
    unit:text! \
    start_value:double \
    current_value:double \
    target_value:double \
    milestones_json:jsonb \
    binary_done:bool \
    owner_name:text! \
    due_date:date \
    progress_fraction:double \
    --api

cargo loco generate scaffold okr_check_in \
    deleted_at:tstz \
    okr_objective:references \
    checked_in_at:tstz! \
    narrative:text! \
    since_last_changes:text! \
    blockers:text! \
    asks:text! \
    confidence_decile_at_check_in:int \
    --api

cargo loco generate scaffold okr_grade \
    deleted_at:tstz \
    okr_objective:references \
    score_by_progress_percent:double \
    score_by_confidence_decile:int \
    score_by_stretch_tier:int \
    score_by_alignment_grade:int \
    score_by_impact_tier:int \
    score_by_smart_quality:int \
    score_by_pace_deviation_percent:double \
    computed_composite_rag:text! \
    final_composite_rag:text! \
    override_reason:text! \
    recommendation:text! \
    triage_notes:text! \
    signed_by:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold okr_grade_rule \
    deleted_at:tstz \
    okr_grade:references \
    rule_id:text! \
    instrument:text! \
    grade:text! \
    category:text! \
    description:text! \
    --api

cargo loco generate scaffold okr_grade_flag \
    deleted_at:tstz \
    okr_grade:references \
    flag_code:text! \
    priority:text! \
    description:text! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
