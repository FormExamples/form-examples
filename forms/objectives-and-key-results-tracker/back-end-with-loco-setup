#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding objectives-and-key-results-tracker (8 tables)..."

cargo loco generate scaffold reporter \
    deleted_at:ts \
    name:text! \
    email:text! \
    role:text! \
    --api && \
cargo loco generate scaffold participant \
    deleted_at:ts \
    okr_objective_id:uuid! \
    role:text! \
    name:text! \
    email:text! \
    notes:text! \
    --api && \
cargo loco generate scaffold okr_objective \
    deleted_at:ts \
    reporter:references \
    parent_objective:references \
    status:text! \
    level:text! \
    cycle:text! \
    cycle_start_date:date \
    cycle_end_date:date \
    team_or_org_name:text! \
    strategic_theme:text! \
    external_reference:text! \
    obj_title:text! \
    obj_long_description:text! \
    sa_parent_summary:text! \
    sa_business_value_statement:text! \
    in_initiatives:text! \
    in_supporting_links:text! \
    rk_known_risks:text! \
    rk_dependencies:text! \
    rk_blockers:text! \
    rk_mitigation_plans:text! \
    fc_expected_end_state:text! \
    fc_residual_risk:text! \
    score_by_progress_percent:double \
    score_by_confidence_decile:int \
    score_by_stretch_tier:int \
    score_by_alignment_grade:int \
    score_by_impact_tier:int \
    score_by_smart_quality:int \
    score_by_pace_deviation_percent:double \
    --api && \
cargo loco generate scaffold okr_key_result \
    deleted_at:ts \
    okr_objective:references \
    position:int! \
    title:text! \
    kr_type:text! \
    unit:text! \
    start_value:double \
    current_value:double \
    target_value:double \
    milestones_json:jsonb \
    binary_done:bool \
    owner_name:text! \
    due_date:date \
    progress_fraction:double \
    --api && \
cargo loco generate scaffold okr_check_in \
    deleted_at:ts \
    okr_objective:references \
    checked_in_at:ts! \
    narrative:text! \
    since_last_changes:text! \
    blockers:text! \
    asks:text! \
    confidence_decile_at_check_in:int \
    --api && \
cargo loco generate scaffold okr_grade \
    deleted_at:ts \
    okr_objective:references \
    score_by_progress_percent:double \
    score_by_confidence_decile:int \
    score_by_stretch_tier:int \
    score_by_alignment_grade:int \
    score_by_impact_tier:int \
    score_by_smart_quality:int \
    score_by_pace_deviation_percent:double \
    computed_composite_rag:text! \
    final_composite_rag:text! \
    override_reason:text! \
    recommendation:text! \
    triage_notes:text! \
    signed_by:text! \
    signed_at:ts \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold okr_grade_rule \
    deleted_at:ts \
    okr_grade:references \
    rule_id:text! \
    instrument:text! \
    grade:text! \
    category:text! \
    description:text! \
    --api && \
cargo loco generate scaffold okr_grade_flag \
    deleted_at:ts \
    okr_grade:references \
    flag_code:text! \
    priority:text! \
    description:text! \
    --api

echo "Done."
