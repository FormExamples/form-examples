<div class="card" x-data="{
    confirmed: {% if acknowledgment.confirmed %}true{% else %}false{% endif %},
    fullName: '{{ acknowledgment.fullName }}',
    acknowledgedDate: '{{ acknowledgment.acknowledgedDate }}',
    get isValid() {
        return this.confirmed && this.fullName.trim() !== '' && this.acknowledgedDate.trim() !== '';
    }
}">
    <h2>Step 2: Acknowledgment</h2>
    <p class="form-hint">
        Tick the confirmation box, enter your full name as a typed signature, and choose
        the date. All three are required before you can submit.
    </p>

    <div class="form-group">
        <label class="checkbox-label">
            <input type="checkbox"
                   id="acknowledgment_confirmed"
                   name="acknowledgment.confirmed"
                   value="true"
                   x-model="confirmed">
            <span>
                I confirm that I have read and understood this privacy notice about how my
                information is used for medical research, planning services, and checking
                the quality of care.
            </span>
        </label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="acknowledgment_full_name">Full Name (typed signature)</label>
            <input type="text"
                   id="acknowledgment_full_name"
                   name="acknowledgment.full_name"
                   value="{{ acknowledgment.fullName }}"
                   x-model="fullName"
                   placeholder="Enter your full name">
        </div>
        <div class="form-group">
            <label for="acknowledgment_acknowledged_date">Date</label>
            <input type="date"
                   id="acknowledgment_acknowledged_date"
                   name="acknowledgment.acknowledged_date"
                   value="{{ acknowledgment.acknowledgedDate }}"
                   x-model="acknowledgedDate">
        </div>
    </div>

    <p class="form-hint" x-show="!isValid" x-cloak>
        All three fields above are required to complete the acknowledgment.
    </p>
</div>
