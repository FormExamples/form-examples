{% extends "base.html.tera" %}

{% block title %}Screening Program Privacy Notice - Acknowledgment{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>Screening Program Privacy Notice</h1>
    <p class="form-hint">
        Please read the privacy notice carefully (Step 1) and then complete the
        acknowledgment (Step 2). Both steps appear on this single page.
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Submit Acknowledgment</button>
    </div>
</form>
{% endblock %}
