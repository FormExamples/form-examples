{% extends "base.html.tera" %}

{% block title %}Sports Medicine Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Sports Medicine Assessment</h1>
        <p class="landing-description">
            Pre-Participation Physical Evaluation (PPE 5th ed.) for athletes and sportspeople,
            aligned with the AAP / AAFP / ACSM / AMSSM / AOSSM / AOASM monograph. Captures
            demographics, sport and position details, medical and family history, menstrual / RED-S
            screening (where applicable), cardiovascular and musculoskeletal examination,
            neurological &amp; concussion baseline, vision and skin screening, and the
            clearance decision.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Demographics through Clearance Decision &mdash; single continuous wizard</p>
            </div>
            <div class="feature">
                <h3>PPE Rules</h3>
                <p>Aggregated clearance: Cleared / Conditional / Pending / Not Cleared</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for cardiovascular red flags, RED-S triad, concussion, and infectious skin lesions</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
