<div class="card">
    <h2>Step 2: Sport &amp; Position Details</h2>
    <p class="form-hint">Primary sport, position, contact level, and competitive load.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="primary_sport">Primary sport</label>
            <input type="text" id="primary_sport" name="sport_position_details.primary_sport"
                   value="{{ sport_position_details.primarySport }}">
        </div>
        <div class="form-group">
            <label for="primary_position">Primary position</label>
            <input type="text" id="primary_position" name="sport_position_details.primary_position"
                   value="{{ sport_position_details.primaryPosition }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="contact_level">Contact level</label>
            <select id="contact_level" name="sport_position_details.contact_level">
                <option value="" {% if sport_position_details.contactLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="low" {% if sport_position_details.contactLevel == "low" %}selected{% endif %}>Low (archery, golf)</option>
                <option value="moderate" {% if sport_position_details.contactLevel == "moderate" %}selected{% endif %}>Moderate (baseball, soccer)</option>
                <option value="high" {% if sport_position_details.contactLevel == "high" %}selected{% endif %}>High (football, rugby, MMA, ice hockey)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="competitive_level">Competitive level</label>
            <input type="text" id="competitive_level" name="sport_position_details.competitive_level"
                   value="{{ sport_position_details.competitiveLevel }}" placeholder="recreational / school / club / elite">
        </div>
    </div>

    <div class="form-group">
        <label for="secondary_sports">Secondary sports</label>
        <input type="text" id="secondary_sports" name="sport_position_details.secondary_sports"
               value="{{ sport_position_details.secondarySports }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hours_per_week">Hours per week training</label>
            <input type="number" step="0.5" id="hours_per_week" name="sport_position_details.hours_per_week"
                   value="{{ sport_position_details.hoursPerWeek }}">
        </div>
        <div class="form-group">
            <label for="previous_clearance_issue">Previous clearance issue?</label>
            <select id="previous_clearance_issue" name="sport_position_details.previous_clearance_issue">
                <option value="" {% if sport_position_details.previousClearanceIssue == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if sport_position_details.previousClearanceIssue == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if sport_position_details.previousClearanceIssue == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if sport_position_details.previousClearanceIssue == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="previous_clearance_details">Previous clearance details</label>
        <textarea id="previous_clearance_details" name="sport_position_details.previous_clearance_details">{{ sport_position_details.previousClearanceDetails }}</textarea>
    </div>
</div>
