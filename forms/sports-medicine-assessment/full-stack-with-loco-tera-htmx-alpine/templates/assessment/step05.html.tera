<div class="card">
    <h2>Step 5: Menstrual History / RED-S Screening</h2>
    <p class="form-hint">
        Applicable when sex is female. The <code>applicable</code> flag is set
        automatically by the backend on submit.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="age_at_menarche">Age at menarche</label>
            <input type="number" id="age_at_menarche" name="menstrual_history_reds.age_at_menarche"
                   value="{{ menstrual_history_reds.ageAtMenarche }}">
        </div>
        <div class="form-group">
            <label for="regular_periods">Regular periods?</label>
            <select id="regular_periods" name="menstrual_history_reds.regular_periods">
                <option value="" {% if menstrual_history_reds.regularPeriods == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if menstrual_history_reds.regularPeriods == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if menstrual_history_reds.regularPeriods == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if menstrual_history_reds.regularPeriods == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="amenorrhoea_six_months">Amenorrhoea &gt; 6 months?</label>
            <select id="amenorrhoea_six_months" name="menstrual_history_reds.amenorrhoea_six_months">
                <option value="" {% if menstrual_history_reds.amenorrhoeaSixMonths == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if menstrual_history_reds.amenorrhoeaSixMonths == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if menstrual_history_reds.amenorrhoeaSixMonths == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if menstrual_history_reds.amenorrhoeaSixMonths == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cycles_last_12_months">Cycles in last 12 months</label>
            <input type="number" id="cycles_last_12_months" name="menstrual_history_reds.cycles_last_12_months"
                   value="{{ menstrual_history_reds.cyclesLast12Months }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="restrictive_eating_pattern">Restrictive eating pattern?</label>
            <select id="restrictive_eating_pattern" name="menstrual_history_reds.restrictive_eating_pattern">
                <option value="" {% if menstrual_history_reds.restrictiveEatingPattern == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if menstrual_history_reds.restrictiveEatingPattern == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if menstrual_history_reds.restrictiveEatingPattern == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if menstrual_history_reds.restrictiveEatingPattern == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="stress_fracture_history">Stress fracture history?</label>
            <select id="stress_fracture_history" name="menstrual_history_reds.stress_fracture_history">
                <option value="" {% if menstrual_history_reds.stressFractureHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if menstrual_history_reds.stressFractureHistory == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if menstrual_history_reds.stressFractureHistory == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if menstrual_history_reds.stressFractureHistory == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="low_energy_availability_concern">Low energy availability concern?</label>
        <select id="low_energy_availability_concern" name="menstrual_history_reds.low_energy_availability_concern">
            <option value="" {% if menstrual_history_reds.lowEnergyAvailabilityConcern == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if menstrual_history_reds.lowEnergyAvailabilityConcern == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if menstrual_history_reds.lowEnergyAvailabilityConcern == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if menstrual_history_reds.lowEnergyAvailabilityConcern == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>
</div>
