<div class="card">
    <h2>Step 8: Neurological &amp; Concussion Baseline (SCAT6)</h2>
    <p class="form-hint">Concussion history, current symptoms, and other neurological history.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="total_concussions">Total lifetime concussions</label>
            <input type="number" id="total_concussions" name="neurological_concussion_baseline.total_concussions"
                   value="{{ neurological_concussion_baseline.totalConcussions }}">
        </div>
        <div class="form-group">
            <label for="concussion_last_six_months">Concussion in the last 6 months?</label>
            <select id="concussion_last_six_months" name="neurological_concussion_baseline.concussion_last_six_months">
                <option value="" {% if neurological_concussion_baseline.concussionLastSixMonths == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.concussionLastSixMonths == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.concussionLastSixMonths == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.concussionLastSixMonths == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="most_recent_concussion_date">Most recent concussion date</label>
            <input type="date" id="most_recent_concussion_date" name="neurological_concussion_baseline.most_recent_concussion_date"
                   value="{{ neurological_concussion_baseline.mostRecentConcussionDate }}">
        </div>
        <div class="form-group">
            <label for="ongoing_post_concussive_symptoms">Ongoing post-concussive symptoms?</label>
            <select id="ongoing_post_concussive_symptoms" name="neurological_concussion_baseline.ongoing_post_concussive_symptoms">
                <option value="" {% if neurological_concussion_baseline.ongoingPostConcussiveSymptoms == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.ongoingPostConcussiveSymptoms == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.ongoingPostConcussiveSymptoms == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.ongoingPostConcussiveSymptoms == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="history_of_seizures">History of seizures?</label>
            <select id="history_of_seizures" name="neurological_concussion_baseline.history_of_seizures">
                <option value="" {% if neurological_concussion_baseline.historyOfSeizures == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.historyOfSeizures == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.historyOfSeizures == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.historyOfSeizures == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="stinger">Stinger / burner episode?</label>
            <select id="stinger" name="neurological_concussion_baseline.stinger">
                <option value="" {% if neurological_concussion_baseline.stinger == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.stinger == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.stinger == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.stinger == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="history_of_head_or_neck_surgery">History of head/neck surgery?</label>
            <select id="history_of_head_or_neck_surgery" name="neurological_concussion_baseline.history_of_head_or_neck_surgery">
                <option value="" {% if neurological_concussion_baseline.historyOfHeadOrNeckSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.historyOfHeadOrNeckSurgery == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.historyOfHeadOrNeckSurgery == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.historyOfHeadOrNeckSurgery == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="baseline_headaches_or_migraine">Baseline headaches / migraine?</label>
            <select id="baseline_headaches_or_migraine" name="neurological_concussion_baseline.baseline_headaches_or_migraine">
                <option value="" {% if neurological_concussion_baseline.baselineHeadachesOrMigraine == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if neurological_concussion_baseline.baselineHeadachesOrMigraine == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if neurological_concussion_baseline.baselineHeadachesOrMigraine == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if neurological_concussion_baseline.baselineHeadachesOrMigraine == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>
</div>
