<div class="card">
    <h2>Step 7: Musculoskeletal Screening</h2>
    <p class="form-hint">Injury, joint stability, range of motion, and strength.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="uncorrected_major_injury">Uncorrected major injury?</label>
            <select id="uncorrected_major_injury" name="musculoskeletal_screening.uncorrected_major_injury">
                <option value="" {% if musculoskeletal_screening.uncorrectedMajorInjury == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.uncorrectedMajorInjury == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.uncorrectedMajorInjury == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.uncorrectedMajorInjury == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="major_injury_details">Major injury details</label>
            <input type="text" id="major_injury_details" name="musculoskeletal_screening.major_injury_details"
                   value="{{ musculoskeletal_screening.majorInjuryDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="joint_instability">Joint instability?</label>
            <select id="joint_instability" name="musculoskeletal_screening.joint_instability">
                <option value="" {% if musculoskeletal_screening.jointInstability == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.jointInstability == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.jointInstability == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.jointInstability == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="joint_instability_details">Joint instability details</label>
            <input type="text" id="joint_instability_details" name="musculoskeletal_screening.joint_instability_details"
                   value="{{ musculoskeletal_screening.jointInstabilityDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ongoing_pain_or_swelling">Ongoing pain or swelling?</label>
            <select id="ongoing_pain_or_swelling" name="musculoskeletal_screening.ongoing_pain_or_swelling">
                <option value="" {% if musculoskeletal_screening.ongoingPainOrSwelling == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.ongoingPainOrSwelling == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.ongoingPainOrSwelling == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.ongoingPainOrSwelling == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="chronic_joint_disease">Chronic joint disease?</label>
            <select id="chronic_joint_disease" name="musculoskeletal_screening.chronic_joint_disease">
                <option value="" {% if musculoskeletal_screening.chronicJointDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.chronicJointDisease == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.chronicJointDisease == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.chronicJointDisease == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="use_brace_or_assistive_device">Use brace / assistive device?</label>
            <select id="use_brace_or_assistive_device" name="musculoskeletal_screening.use_brace_or_assistive_device">
                <option value="" {% if musculoskeletal_screening.useBraceOrAssistiveDevice == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.useBraceOrAssistiveDevice == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.useBraceOrAssistiveDevice == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.useBraceOrAssistiveDevice == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="full_range_of_motion">Full range of motion?</label>
            <select id="full_range_of_motion" name="musculoskeletal_screening.full_range_of_motion">
                <option value="" {% if musculoskeletal_screening.fullRangeOfMotion == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if musculoskeletal_screening.fullRangeOfMotion == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if musculoskeletal_screening.fullRangeOfMotion == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if musculoskeletal_screening.fullRangeOfMotion == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="normal_strength_bilateral">Normal bilateral strength?</label>
        <select id="normal_strength_bilateral" name="musculoskeletal_screening.normal_strength_bilateral">
            <option value="" {% if musculoskeletal_screening.normalStrengthBilateral == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if musculoskeletal_screening.normalStrengthBilateral == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if musculoskeletal_screening.normalStrengthBilateral == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if musculoskeletal_screening.normalStrengthBilateral == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>
</div>
