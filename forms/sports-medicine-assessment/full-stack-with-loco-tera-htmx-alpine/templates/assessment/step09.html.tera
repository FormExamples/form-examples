<div class="card">
    <h2>Step 9: Vision &amp; Skin</h2>
    <p class="form-hint">Visual acuity protection and contact-sport skin infection screening.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="corrective_lenses_worn">Corrective lenses worn?</label>
            <select id="corrective_lenses_worn" name="vision_skin.corrective_lenses_worn">
                <option value="" {% if vision_skin.correctiveLensesWorn == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if vision_skin.correctiveLensesWorn == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if vision_skin.correctiveLensesWorn == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if vision_skin.correctiveLensesWorn == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="monocular_athlete">Monocular athlete (single eye)?</label>
            <select id="monocular_athlete" name="vision_skin.monocular_athlete">
                <option value="" {% if vision_skin.monocularAthlete == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if vision_skin.monocularAthlete == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if vision_skin.monocularAthlete == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if vision_skin.monocularAthlete == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="protective_eyewear_available">Protective eyewear available?</label>
        <select id="protective_eyewear_available" name="vision_skin.protective_eyewear_available">
            <option value="" {% if vision_skin.protectiveEyewearAvailable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if vision_skin.protectiveEyewearAvailable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if vision_skin.protectiveEyewearAvailable == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if vision_skin.protectiveEyewearAvailable == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="active_skin_infection">Active skin infection?</label>
            <select id="active_skin_infection" name="vision_skin.active_skin_infection">
                <option value="" {% if vision_skin.activeSkinInfection == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if vision_skin.activeSkinInfection == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if vision_skin.activeSkinInfection == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if vision_skin.activeSkinInfection == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="active_skin_infection_details">Active skin infection details</label>
            <input type="text" id="active_skin_infection_details" name="vision_skin.active_skin_infection_details"
                   value="{{ vision_skin.activeSkinInfectionDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="herpes_gladiatorum">Herpes gladiatorum?</label>
            <select id="herpes_gladiatorum" name="vision_skin.herpes_gladiatorum">
                <option value="" {% if vision_skin.herpesGladiatorum == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if vision_skin.herpesGladiatorum == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if vision_skin.herpesGladiatorum == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if vision_skin.herpesGladiatorum == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
        <div class="form-group">
            <label for="impetigo_or_mrsa">Impetigo / MRSA?</label>
            <select id="impetigo_or_mrsa" name="vision_skin.impetigo_or_mrsa">
                <option value="" {% if vision_skin.impetigoOrMrsa == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if vision_skin.impetigoOrMrsa == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if vision_skin.impetigoOrMrsa == "no" %}selected{% endif %}>No</option>
                <option value="unknown" {% if vision_skin.impetigoOrMrsa == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="open_wounds_or_lesions">Open wounds or weeping lesions?</label>
        <select id="open_wounds_or_lesions" name="vision_skin.open_wounds_or_lesions">
            <option value="" {% if vision_skin.openWoundsOrLesions == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if vision_skin.openWoundsOrLesions == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if vision_skin.openWoundsOrLesions == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if vision_skin.openWoundsOrLesions == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>
</div>
