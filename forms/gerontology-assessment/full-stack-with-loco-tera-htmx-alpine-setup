#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding gerontology-assessment (9 tables)..."

cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    polypharmacy_review_deleted_at:ts \
    total_regular_medications:int \
    total_prn_medications:int \
    polypharmacy_flag:string! \
    medication_review_date:date \
    falls_risk_medications:string! \
    falls_risk_medication_details:text! \
    anticholinergic_burden:string! \
    drug_interactions_identified:string! \
    drug_interaction_details:text! \
    adherence_concerns:string! \
    adherence_details:text! \
    stopp_start_review_done:string! \
    deprescribing_opportunities:text! \
    polypharmacy_notes:text! \
    polypharmacy_review_medication_deleted_at:ts \
    polypharmacy_review:references \
    medication_name:string! \
    dose:string! \
    frequency:string! \
    route:string! \
    indication:string! \
    is_prn:string! \
    sort_order:int! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    cfs_score:int! \
    cfs_category:string! \
    functional_domain_score:int \
    cognitive_domain_score:int \
    mobility_domain_score:int \
    nutrition_domain_score:int \
    polypharmacy_domain_score:int \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    cfs_contribution:int! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    cfs_score:int! \
    cfs_category:string! \
    functional_domain_score:int \
    cognitive_domain_score:int \
    mobility_domain_score:int \
    nutrition_domain_score:int \
    polypharmacy_domain_score:int \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    cfs_contribution:int! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx

echo "Done."
