#!/bin/sh
set -euf

form_kebab_case=gerontology-assessment
form_snake_case=gerontology_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold assessment \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold assessment_polypharmacy_review \
    deleted_at:tstz \
    assessment:references \
    total_regular_medications:int \
    total_prn_medications:int \
    polypharmacy_flag:string! \
    medication_review_date:date \
    falls_risk_medications:string! \
    falls_risk_medication_details:text! \
    anticholinergic_burden:string! \
    drug_interactions_identified:string! \
    drug_interaction_details:text! \
    adherence_concerns:string! \
    adherence_details:text! \
    stopp_start_review_done:string! \
    deprescribing_opportunities:text! \
    polypharmacy_notes:text! \
    --api

cargo loco generate scaffold assessment_polypharmacy_review_medication \
    deleted_at:tstz \
    polypharmacy_review:references \
    medication_name:string! \
    dose:string! \
    frequency:string! \
    route:string! \
    indication:string! \
    is_prn:string! \
    sort_order:int! \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    assessment:references \
    cfs_score:int! \
    cfs_category:string! \
    functional_domain_score:int \
    cognitive_domain_score:int \
    mobility_domain_score:int \
    nutrition_domain_score:int \
    polypharmacy_domain_score:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold grading_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    cfs_contribution:int! \
    --api

cargo loco generate scaffold grading_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api
