{% extends "base.html.tera" %}

{% block title %}Employee Onboarding Checklist - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Employee Onboarding Checklist</h1>
        <p class="landing-description">
            Healthcare staff onboarding checklist. Tracks completion of mandatory requirements:
            occupational health clearance, DBS checks, professional registration, mandatory
            training, IT access, uniform and ID badge, induction, probation, and sign-off.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Steps</h3>
                <p>Demographics, pre-employment, occupational health, training, registration, IT, uniform, induction, probation, and sign-off.</p>
            </div>
            <div class="feature">
                <h3>Completion Scoring</h3>
                <p>Tracks completion percentage (0&ndash;100%) across all key items.</p>
            </div>
            <div class="feature">
                <h3>Risk Flags</h3>
                <p>Real-time alerts for DBS, right-to-work, OH clearance, professional registration, and expired credentials.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Checklist
            </button>
        </form>
    </div>
</div>
{% endblock %}
