{% extends "base.html.tera" %}

{% block title %}Employee Onboarding Checklist - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>HR Onboarding Dashboard</h1>
    <a href="/" class="btn btn-primary">New Checklist</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Name, email, or job title...">
    </div>
    <div class="form-group">
        <label for="completion_status">Status</label>
        <select id="completion_status" name="completion_status">
            <option value="">All</option>
            <option value="not-started" {% if completion_status == "not-started" %}selected{% endif %}>Not Started</option>
            <option value="in-progress" {% if completion_status == "in-progress" %}selected{% endif %}>In Progress</option>
            <option value="mostly-complete" {% if completion_status == "mostly-complete" %}selected{% endif %}>Mostly Complete</option>
            <option value="complete" {% if completion_status == "complete" %}selected{% endif %}>Complete</option>
        </select>
    </div>
    <div class="form-group">
        <label for="overall_risk">Risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if overall_risk == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed checklist{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Start Date</th>
            <th>Employee</th>
            <th>Job Title</th>
            <th>Department</th>
            <th>Status</th>
            <th>Completion</th>
            <th>Risk</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for e in employees %}
        <tr>
            <td><a href="/assessment/{{ e.id }}/report">{{ e.startDate }}</a></td>
            <td>{{ e.firstName }} {{ e.lastName }}<br><small>{{ e.email }}</small></td>
            <td>{{ e.jobTitle }}</td>
            <td>{{ e.department }}</td>
            <td><span class="checklist-badge checklist-{{ e.completionStatus }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ e.completionStatus }}</span></td>
            <td>{{ e.completionPercentage }}%</td>
            <td><span class="risk-badge risk-{{ e.overallRisk }}">{{ e.overallRisk }}</span></td>
            <td>
                {% if e.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ e.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed checklists found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
