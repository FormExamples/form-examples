<div class="card">
    <h2>Step 4: Mandatory Training</h2>
    <p class="form-hint">Statutory and mandatory training modules.</p>

    {% set items = [
        ["fire_safety_completed", "Fire Safety", "fireSafetyCompleted"],
        ["manual_handling_completed", "Manual Handling", "manualHandlingCompleted"],
        ["infection_control_completed", "Infection Control", "infectionControlCompleted"],
        ["safeguarding_adults_completed", "Safeguarding Adults", "safeguardingAdultsCompleted"],
        ["safeguarding_children_completed", "Safeguarding Children", "safeguardingChildrenCompleted"],
        ["information_governance_completed", "Information Governance", "informationGovernanceCompleted"],
        ["basic_life_support_completed", "Basic Life Support", "basicLifeSupportCompleted"],
        ["equality_diversity_completed", "Equality & Diversity", "equalityDiversityCompleted"],
        ["health_safety_completed", "Health & Safety", "healthSafetyCompleted"],
        ["conflict_resolution_completed", "Conflict Resolution", "conflictResolutionCompleted"]
    ] %}

    {% for item in items %}
    <div class="form-group">
        <label for="{{ item[0] }}">{{ item[1] }} Completed</label>
        {% set v = mandatory_training[item[2]] %}
        <select id="{{ item[0] }}" name="mandatory_training.{{ item[0] }}">
            <option value="" {% if v == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}
</div>
