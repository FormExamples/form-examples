<div class="card">
    <h2>Step 2: Pre-Employment Checks</h2>
    <p class="form-hint">DBS, right to work, references, and identity verification.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="dbs_check_status">DBS Check Status</label>
            <select id="dbs_check_status" name="pre_employment_checks.dbs_check_status">
                <option value="" {% if pre_employment_checks.dbsCheckStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-started" {% if pre_employment_checks.dbsCheckStatus == "not-started" %}selected{% endif %}>Not Started</option>
                <option value="applied" {% if pre_employment_checks.dbsCheckStatus == "applied" %}selected{% endif %}>Applied</option>
                <option value="received" {% if pre_employment_checks.dbsCheckStatus == "received" %}selected{% endif %}>Received</option>
                <option value="cleared" {% if pre_employment_checks.dbsCheckStatus == "cleared" %}selected{% endif %}>Cleared</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dbs_certificate_number">DBS Certificate Number</label>
            <input type="text" id="dbs_certificate_number" name="pre_employment_checks.dbs_certificate_number"
                   value="{{ pre_employment_checks.dbsCertificateNumber }}">
        </div>
        <div class="form-group">
            <label for="dbs_check_date">DBS Check Date</label>
            <input type="date" id="dbs_check_date" name="pre_employment_checks.dbs_check_date"
                   value="{{ pre_employment_checks.dbsCheckDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="right_to_work_verified">Right to Work Verified</label>
            <select id="right_to_work_verified" name="pre_employment_checks.right_to_work_verified">
                <option value="" {% if pre_employment_checks.rightToWorkVerified == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if pre_employment_checks.rightToWorkVerified == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if pre_employment_checks.rightToWorkVerified == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="right_to_work_document_type">Document Type</label>
            <input type="text" id="right_to_work_document_type" name="pre_employment_checks.right_to_work_document_type"
                   value="{{ pre_employment_checks.rightToWorkDocumentType }}">
        </div>
        <div class="form-group">
            <label for="right_to_work_expiry_date">Expiry Date</label>
            <input type="date" id="right_to_work_expiry_date" name="pre_employment_checks.right_to_work_expiry_date"
                   value="{{ pre_employment_checks.rightToWorkExpiryDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="references_received">References Received</label>
            <input type="number" min="0" id="references_received" name="pre_employment_checks.references_received"
                   value="{{ pre_employment_checks.referencesReceived }}">
        </div>
        <div class="form-group">
            <label for="references_required">References Required</label>
            <input type="number" min="0" id="references_required" name="pre_employment_checks.references_required"
                   value="{{ pre_employment_checks.referencesRequired }}">
        </div>
        <div class="form-group">
            <label for="references_satisfactory">References Satisfactory</label>
            <select id="references_satisfactory" name="pre_employment_checks.references_satisfactory">
                <option value="" {% if pre_employment_checks.referencesSatisfactory == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if pre_employment_checks.referencesSatisfactory == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if pre_employment_checks.referencesSatisfactory == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="identity_verified">Identity Verified</label>
        <select id="identity_verified" name="pre_employment_checks.identity_verified">
            <option value="" {% if pre_employment_checks.identityVerified == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if pre_employment_checks.identityVerified == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if pre_employment_checks.identityVerified == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
</div>
