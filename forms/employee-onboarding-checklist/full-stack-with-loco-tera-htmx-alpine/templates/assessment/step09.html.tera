<div class="card">
    <h2>Step 9: Probation &amp; Supervision</h2>
    <p class="form-hint">Probation period, line management, and supervision plan.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="probation_period_months">Probation Period (months)</label>
            <input type="number" min="0" id="probation_period_months" name="probation_supervision.probation_period_months"
                   value="{{ probation_supervision.probationPeriodMonths }}">
        </div>
        <div class="form-group">
            <label for="probation_start_date">Probation Start</label>
            <input type="date" id="probation_start_date" name="probation_supervision.probation_start_date"
                   value="{{ probation_supervision.probationStartDate }}">
        </div>
        <div class="form-group">
            <label for="probation_end_date">Probation End</label>
            <input type="date" id="probation_end_date" name="probation_supervision.probation_end_date"
                   value="{{ probation_supervision.probationEndDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="line_manager_name">Line Manager Name</label>
            <input type="text" id="line_manager_name" name="probation_supervision.line_manager_name"
                   value="{{ probation_supervision.lineManagerName }}">
        </div>
        <div class="form-group">
            <label for="line_manager_email">Line Manager Email</label>
            <input type="email" id="line_manager_email" name="probation_supervision.line_manager_email"
                   value="{{ probation_supervision.lineManagerEmail }}">
        </div>
        <div class="form-group">
            <label for="supervisor_name">Supervisor Name</label>
            <input type="text" id="supervisor_name" name="probation_supervision.supervisor_name"
                   value="{{ probation_supervision.supervisorName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="supervision_frequency">Supervision Frequency</label>
            <select id="supervision_frequency" name="probation_supervision.supervision_frequency">
                <option value="" {% if probation_supervision.supervisionFrequency == "" %}selected{% endif %}>&mdash;</option>
                <option value="weekly" {% if probation_supervision.supervisionFrequency == "weekly" %}selected{% endif %}>Weekly</option>
                <option value="fortnightly" {% if probation_supervision.supervisionFrequency == "fortnightly" %}selected{% endif %}>Fortnightly</option>
                <option value="monthly" {% if probation_supervision.supervisionFrequency == "monthly" %}selected{% endif %}>Monthly</option>
                <option value="quarterly" {% if probation_supervision.supervisionFrequency == "quarterly" %}selected{% endif %}>Quarterly</option>
            </select>
        </div>
        <div class="form-group">
            <label for="first_supervision_date">First Supervision Date</label>
            <input type="date" id="first_supervision_date" name="probation_supervision.first_supervision_date"
                   value="{{ probation_supervision.firstSupervisionDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="objectives_set">Objectives Set</label>
            <select id="objectives_set" name="probation_supervision.objectives_set">
                <option value="" {% if probation_supervision.objectivesSet == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if probation_supervision.objectivesSet == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if probation_supervision.objectivesSet == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="appraisal_date_agreed">Appraisal Date Agreed</label>
            <select id="appraisal_date_agreed" name="probation_supervision.appraisal_date_agreed">
                <option value="" {% if probation_supervision.appraisalDateAgreed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if probation_supervision.appraisalDateAgreed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if probation_supervision.appraisalDateAgreed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="appraisal_date">Appraisal Date</label>
            <input type="date" id="appraisal_date" name="probation_supervision.appraisal_date"
                   value="{{ probation_supervision.appraisalDate }}">
        </div>
    </div>
</div>
