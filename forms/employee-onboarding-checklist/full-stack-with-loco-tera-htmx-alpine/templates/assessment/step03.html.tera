<div class="card">
    <h2>Step 3: Occupational Health</h2>
    <p class="form-hint">OH clearance, immunisations, and fitness to work.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="oh_questionnaire_submitted">OH Questionnaire Submitted</label>
            <select id="oh_questionnaire_submitted" name="occupational_health.oh_questionnaire_submitted">
                <option value="" {% if occupational_health.ohQuestionnaireSubmitted == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if occupational_health.ohQuestionnaireSubmitted == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if occupational_health.ohQuestionnaireSubmitted == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oh_clearance_received">OH Clearance Received</label>
            <select id="oh_clearance_received" name="occupational_health.oh_clearance_received">
                <option value="" {% if occupational_health.ohClearanceReceived == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if occupational_health.ohClearanceReceived == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if occupational_health.ohClearanceReceived == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oh_clearance_date">Clearance Date</label>
            <input type="date" id="oh_clearance_date" name="occupational_health.oh_clearance_date"
                   value="{{ occupational_health.ohClearanceDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="oh_restrictions">Restrictions?</label>
            <select id="oh_restrictions" name="occupational_health.oh_restrictions">
                <option value="" {% if occupational_health.ohRestrictions == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if occupational_health.ohRestrictions == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if occupational_health.ohRestrictions == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oh_restriction_details">Restriction Details</label>
            <textarea id="oh_restriction_details" name="occupational_health.oh_restriction_details"
                      placeholder="Describe any restrictions">{{ occupational_health.ohRestrictionDetails }}</textarea>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hepatitis_b_status">Hepatitis B Status</label>
            <select id="hepatitis_b_status" name="occupational_health.hepatitis_b_status">
                <option value="" {% if occupational_health.hepatitisBStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="immune" {% if occupational_health.hepatitisBStatus == "immune" %}selected{% endif %}>Immune</option>
                <option value="non-immune" {% if occupational_health.hepatitisBStatus == "non-immune" %}selected{% endif %}>Non-immune</option>
                <option value="vaccinating" {% if occupational_health.hepatitisBStatus == "vaccinating" %}selected{% endif %}>Vaccinating</option>
                <option value="declined" {% if occupational_health.hepatitisBStatus == "declined" %}selected{% endif %}>Declined</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tb_screening_status">TB Screening Status</label>
            <select id="tb_screening_status" name="occupational_health.tb_screening_status">
                <option value="" {% if occupational_health.tbScreeningStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-required" {% if occupational_health.tbScreeningStatus == "not-required" %}selected{% endif %}>Not required</option>
                <option value="required" {% if occupational_health.tbScreeningStatus == "required" %}selected{% endif %}>Required</option>
                <option value="completed" {% if occupational_health.tbScreeningStatus == "completed" %}selected{% endif %}>Completed</option>
                <option value="referred" {% if occupational_health.tbScreeningStatus == "referred" %}selected{% endif %}>Referred</option>
            </select>
        </div>
        <div class="form-group">
            <label for="immunisation_status">Immunisation Status</label>
            <select id="immunisation_status" name="occupational_health.immunisation_status">
                <option value="" {% if occupational_health.immunisationStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="complete" {% if occupational_health.immunisationStatus == "complete" %}selected{% endif %}>Complete</option>
                <option value="incomplete" {% if occupational_health.immunisationStatus == "incomplete" %}selected{% endif %}>Incomplete</option>
                <option value="in-progress" {% if occupational_health.immunisationStatus == "in-progress" %}selected{% endif %}>In progress</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="fit_to_work">Fit to Work?</label>
        <select id="fit_to_work" name="occupational_health.fit_to_work">
            <option value="" {% if occupational_health.fitToWork == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if occupational_health.fitToWork == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if occupational_health.fitToWork == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
</div>
