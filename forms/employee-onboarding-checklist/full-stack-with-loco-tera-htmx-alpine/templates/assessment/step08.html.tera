<div class="card">
    <h2>Step 8: Induction Programme</h2>
    <p class="form-hint">Corporate and local induction, tour, and policies.</p>

    {% set items = [
        ["corporate_induction_completed", "Corporate Induction Completed", "corporateInductionCompleted"],
        ["local_induction_completed", "Local Induction Completed", "localInductionCompleted"],
        ["department_tour_completed", "Department Tour Completed", "departmentTourCompleted"],
        ["introduced_to_team", "Introduced to Team", "introducedToTeam"],
        ["emergency_procedures_briefed", "Emergency Procedures Briefed", "emergencyProceduresBriefed"],
        ["policies_handbook_received", "Policies Handbook Received", "policiesHandbookReceived"],
        ["buddy_assigned", "Buddy Assigned", "buddyAssigned"]
    ] %}

    {% for item in items %}
    <div class="form-group">
        <label for="{{ item[0] }}">{{ item[1] }}</label>
        {% set v = induction_programme[item[2]] %}
        <select id="{{ item[0] }}" name="induction_programme.{{ item[0] }}">
            <option value="" {% if v == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="buddy_name">Buddy Name</label>
        <input type="text" id="buddy_name" name="induction_programme.buddy_name"
               value="{{ induction_programme.buddyName }}">
    </div>
</div>
