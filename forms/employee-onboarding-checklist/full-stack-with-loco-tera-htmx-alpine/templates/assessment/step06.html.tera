<div class="card">
    <h2>Step 6: IT Systems &amp; Access</h2>
    <p class="form-hint">NHS smartcard, accounts, and clinical-system access.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="nhs_smartcard_issued">NHS Smartcard Issued</label>
            <select id="nhs_smartcard_issued" name="it_systems_access.nhs_smartcard_issued">
                <option value="" {% if it_systems_access.nhsSmartcardIssued == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if it_systems_access.nhsSmartcardIssued == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if it_systems_access.nhsSmartcardIssued == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="nhs_smartcard_number">NHS Smartcard Number</label>
            <input type="text" id="nhs_smartcard_number" name="it_systems_access.nhs_smartcard_number"
                   value="{{ it_systems_access.nhsSmartcardNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="email_account_created">Email Account Created</label>
            <select id="email_account_created" name="it_systems_access.email_account_created">
                <option value="" {% if it_systems_access.emailAccountCreated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if it_systems_access.emailAccountCreated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if it_systems_access.emailAccountCreated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="network_login_created">Network Login Created</label>
            <select id="network_login_created" name="it_systems_access.network_login_created">
                <option value="" {% if it_systems_access.networkLoginCreated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if it_systems_access.networkLoginCreated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if it_systems_access.networkLoginCreated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="clinical_system_access">Clinical System Access</label>
            <select id="clinical_system_access" name="it_systems_access.clinical_system_access">
                <option value="" {% if it_systems_access.clinicalSystemAccess == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if it_systems_access.clinicalSystemAccess == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if it_systems_access.clinicalSystemAccess == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="clinical_system_name">Clinical System Name</label>
            <input type="text" id="clinical_system_name" name="it_systems_access.clinical_system_name"
                   value="{{ it_systems_access.clinicalSystemName }}">
        </div>
        <div class="form-group">
            <label for="phone_extension">Phone Extension</label>
            <input type="text" id="phone_extension" name="it_systems_access.phone_extension"
                   value="{{ it_systems_access.phoneExtension }}">
        </div>
        <div class="form-group">
            <label for="bleep_number">Bleep Number</label>
            <input type="text" id="bleep_number" name="it_systems_access.bleep_number"
                   value="{{ it_systems_access.bleepNumber }}">
        </div>
    </div>
</div>
