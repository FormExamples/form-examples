<div class="card">
    <h2>Step 2: Scene Safety &amp; Initial Assessment</h2>
    <p class="form-hint">Confirm the scene is safe and prepare to act.</p>

    <div class="form-group">
        <label for="scene_safe">Scene confirmed safe before approach</label>
        <select id="scene_safe" name="scene_safety.scene_safe">
            <option value="" {% if scene_safety.sceneSafe == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_safety.sceneSafe == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if scene_safety.sceneSafe == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if scene_safety.sceneSafe == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_applied">PPE applied appropriately</label>
        <select id="ppe_applied" name="scene_safety.ppe_applied">
            <option value="" {% if scene_safety.ppeApplied == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_safety.ppeApplied == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if scene_safety.ppeApplied == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if scene_safety.ppeApplied == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="hazards_identified">Environmental hazards identified and mitigated</label>
        <select id="hazards_identified" name="scene_safety.hazards_identified">
            <option value="" {% if scene_safety.hazardsIdentified == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_safety.hazardsIdentified == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if scene_safety.hazardsIdentified == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if scene_safety.hazardsIdentified == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="bystanders_controlled">Bystanders managed so they do not impede care</label>
        <select id="bystanders_controlled" name="scene_safety.bystanders_controlled">
            <option value="" {% if scene_safety.bystandersControlled == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_safety.bystandersControlled == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if scene_safety.bystandersControlled == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if scene_safety.bystandersControlled == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>
</div>
