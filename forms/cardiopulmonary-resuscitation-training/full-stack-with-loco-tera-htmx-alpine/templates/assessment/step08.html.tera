<div class="card">
    <h2>Step 8: Team Dynamics, Handoff &amp; Feedback</h2>
    <p class="form-hint">Communication, handoff, and post-event debrief observations.</p>

    <div class="form-group">
        <label for="clear_communication">Clear, calm communication with team</label>
        <select id="clear_communication" name="team_dynamics_handoff.clear_communication">
            <option value="" {% if team_dynamics_handoff.clearCommunication == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if team_dynamics_handoff.clearCommunication == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if team_dynamics_handoff.clearCommunication == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if team_dynamics_handoff.clearCommunication == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="closed_loop_orders">Closed-loop communication for orders</label>
        <select id="closed_loop_orders" name="team_dynamics_handoff.closed_loop_orders">
            <option value="" {% if team_dynamics_handoff.closedLoopOrders == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if team_dynamics_handoff.closedLoopOrders == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if team_dynamics_handoff.closedLoopOrders == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if team_dynamics_handoff.closedLoopOrders == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="appropriate_handoff">Structured handoff (SBAR) to incoming providers</label>
        <select id="appropriate_handoff" name="team_dynamics_handoff.appropriate_handoff">
            <option value="" {% if team_dynamics_handoff.appropriateHandoff == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if team_dynamics_handoff.appropriateHandoff == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if team_dynamics_handoff.appropriateHandoff == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if team_dynamics_handoff.appropriateHandoff == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="debrief_participated">Participated constructively in post-event debrief</label>
        <select id="debrief_participated" name="team_dynamics_handoff.debrief_participated">
            <option value="" {% if team_dynamics_handoff.debriefParticipated == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if team_dynamics_handoff.debriefParticipated == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if team_dynamics_handoff.debriefParticipated == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if team_dynamics_handoff.debriefParticipated == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="examiner_notes">Examiner notes</label>
        <textarea id="examiner_notes" name="team_dynamics_handoff.examiner_notes"
                  placeholder="Coaching points and observations">{{ team_dynamics_handoff.examinerNotes }}</textarea>
    </div>

    <div class="form-group">
        <label for="trainee_feedback">Trainee self-feedback</label>
        <textarea id="trainee_feedback" name="team_dynamics_handoff.trainee_feedback"
                  placeholder="Trainee reflection captured at debrief">{{ team_dynamics_handoff.traineeFeedback }}</textarea>
    </div>
</div>
