<div class="card">
    <h2>Step 4: Activate Emergency Response</h2>
    <p class="form-hint">Activate the emergency response system and direct help.</p>

    <div class="form-group">
        <label for="called_emergency_number">Emergency number called (999 / 2222 in hospital)</label>
        <select id="called_emergency_number" name="activate_emergency_response.called_emergency_number">
            <option value="" {% if activate_emergency_response.calledEmergencyNumber == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if activate_emergency_response.calledEmergencyNumber == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if activate_emergency_response.calledEmergencyNumber == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if activate_emergency_response.calledEmergencyNumber == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="stated_location_and_condition">Location and casualty condition stated clearly</label>
        <select id="stated_location_and_condition" name="activate_emergency_response.stated_location_and_condition">
            <option value="" {% if activate_emergency_response.statedLocationAndCondition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if activate_emergency_response.statedLocationAndCondition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if activate_emergency_response.statedLocationAndCondition == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if activate_emergency_response.statedLocationAndCondition == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="designated_aed_retriever">Specific bystander designated to fetch the AED</label>
        <select id="designated_aed_retriever" name="activate_emergency_response.designated_aed_retriever">
            <option value="" {% if activate_emergency_response.designatedAedRetriever == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if activate_emergency_response.designatedAedRetriever == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if activate_emergency_response.designatedAedRetriever == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if activate_emergency_response.designatedAedRetriever == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="used_speakerphone">Speakerphone used to keep both hands free</label>
        <select id="used_speakerphone" name="activate_emergency_response.used_speakerphone">
            <option value="" {% if activate_emergency_response.usedSpeakerphone == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if activate_emergency_response.usedSpeakerphone == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if activate_emergency_response.usedSpeakerphone == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if activate_emergency_response.usedSpeakerphone == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>
</div>
