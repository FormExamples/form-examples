<div class="card">
    <h2>Step 5: Chest Compressions</h2>
    <p class="form-hint">
        Rate (AHA target: 100-120/min) and depth (5-6 cm adult) are
        <strong>critical actions</strong>. Either the explicit tri-state assessment or a
        numeric measurement may be recorded; the engine prefers the explicit value.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="compression_rate">Compression rate (per minute)</label>
            <input type="number" step="1" id="compression_rate" name="chest_compressions.compression_rate"
                   value="{{ chest_compressions.compressionRate }}" placeholder="100-120">
        </div>
        <div class="form-group">
            <label for="compression_depth">Compression depth (cm)</label>
            <input type="number" step="0.1" id="compression_depth" name="chest_compressions.compression_depth"
                   value="{{ chest_compressions.compressionDepth }}" placeholder="5.0-6.0">
        </div>
    </div>

    <div class="form-group">
        <label for="correct_hand_position">Correct hand position (centre of chest)</label>
        <select id="correct_hand_position" name="chest_compressions.correct_hand_position">
            <option value="" {% if chest_compressions.correctHandPosition == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chest_compressions.correctHandPosition == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chest_compressions.correctHandPosition == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chest_compressions.correctHandPosition == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="full_chest_recoil">Allows full chest recoil between compressions</label>
        <select id="full_chest_recoil" name="chest_compressions.full_chest_recoil">
            <option value="" {% if chest_compressions.fullChestRecoil == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chest_compressions.fullChestRecoil == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chest_compressions.fullChestRecoil == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chest_compressions.fullChestRecoil == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="minimised_interruptions">Minimises interruptions (&lt;10 s)</label>
        <select id="minimised_interruptions" name="chest_compressions.minimised_interruptions">
            <option value="" {% if chest_compressions.minimisedInterruptions == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chest_compressions.minimisedInterruptions == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chest_compressions.minimisedInterruptions == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chest_compressions.minimisedInterruptions == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="compressions_at_correct_rate"><strong>Critical:</strong> Compressions at AHA rate (100-120/min)</label>
        <select id="compressions_at_correct_rate" name="chest_compressions.compressions_at_correct_rate">
            <option value="" {% if chest_compressions.compressionsAtCorrectRate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chest_compressions.compressionsAtCorrectRate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chest_compressions.compressionsAtCorrectRate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chest_compressions.compressionsAtCorrectRate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="compressions_at_correct_depth"><strong>Critical:</strong> Compressions at AHA depth (5-6 cm)</label>
        <select id="compressions_at_correct_depth" name="chest_compressions.compressions_at_correct_depth">
            <option value="" {% if chest_compressions.compressionsAtCorrectDepth == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chest_compressions.compressionsAtCorrectDepth == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chest_compressions.compressionsAtCorrectDepth == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chest_compressions.compressionsAtCorrectDepth == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>
</div>
