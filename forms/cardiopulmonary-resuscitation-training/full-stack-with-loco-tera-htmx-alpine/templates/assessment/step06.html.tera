<div class="card">
    <h2>Step 6: Airway &amp; Rescue Breaths</h2>
    <p class="form-hint">
        Effective ventilation (visible chest rise) is a <strong>critical action</strong>.
    </p>

    <div class="form-group">
        <label for="head_tilt_chin_lift">Opens airway with head tilt-chin lift</label>
        <select id="head_tilt_chin_lift" name="airway_rescue_breaths.head_tilt_chin_lift">
            <option value="" {% if airway_rescue_breaths.headTiltChinLift == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.headTiltChinLift == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.headTiltChinLift == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.headTiltChinLift == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="effective_seal">Effective mask seal</label>
        <select id="effective_seal" name="airway_rescue_breaths.effective_seal">
            <option value="" {% if airway_rescue_breaths.effectiveSeal == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.effectiveSeal == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.effectiveSeal == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.effectiveSeal == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="visible_chest_rise"><strong>Critical:</strong> Visible chest rise (effective ventilation)</label>
        <select id="visible_chest_rise" name="airway_rescue_breaths.visible_chest_rise">
            <option value="" {% if airway_rescue_breaths.visibleChestRise == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.visibleChestRise == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.visibleChestRise == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.visibleChestRise == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="one_second_per_breath">Each breath delivered over ~1 second</label>
        <select id="one_second_per_breath" name="airway_rescue_breaths.one_second_per_breath">
            <option value="" {% if airway_rescue_breaths.oneSecondPerBreath == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.oneSecondPerBreath == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.oneSecondPerBreath == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.oneSecondPerBreath == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ratio30to2">Maintains 30:2 compression-to-ventilation ratio</label>
        <select id="ratio30to2" name="airway_rescue_breaths.ratio30to2">
            <option value="" {% if airway_rescue_breaths.ratio30to2 == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.ratio30to2 == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.ratio30to2 == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.ratio30to2 == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="avoided_excessive_ventilation">Avoids excessive ventilation</label>
        <select id="avoided_excessive_ventilation" name="airway_rescue_breaths.avoided_excessive_ventilation">
            <option value="" {% if airway_rescue_breaths.avoidedExcessiveVentilation == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if airway_rescue_breaths.avoidedExcessiveVentilation == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if airway_rescue_breaths.avoidedExcessiveVentilation == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if airway_rescue_breaths.avoidedExcessiveVentilation == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>
</div>
