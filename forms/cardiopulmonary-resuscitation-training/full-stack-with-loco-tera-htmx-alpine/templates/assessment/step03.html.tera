<div class="card">
    <h2>Step 3: Responsiveness &amp; Breathing Check</h2>
    <p class="form-hint">Assess responsiveness and check breathing / pulse simultaneously within 10 s.</p>

    <div class="form-group">
        <label for="tapped_and_shouted">Taps shoulders and shouts &quot;Are you OK?&quot;</label>
        <select id="tapped_and_shouted" name="responsiveness_breathing.tapped_and_shouted">
            <option value="" {% if responsiveness_breathing.tappedAndShouted == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if responsiveness_breathing.tappedAndShouted == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if responsiveness_breathing.tappedAndShouted == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if responsiveness_breathing.tappedAndShouted == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="checked_breathing">Checks for absent / abnormal breathing</label>
        <select id="checked_breathing" name="responsiveness_breathing.checked_breathing">
            <option value="" {% if responsiveness_breathing.checkedBreathing == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if responsiveness_breathing.checkedBreathing == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if responsiveness_breathing.checkedBreathing == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if responsiveness_breathing.checkedBreathing == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="checked_pulse_simultaneously">Carotid pulse checked simultaneously with breathing</label>
        <select id="checked_pulse_simultaneously" name="responsiveness_breathing.checked_pulse_simultaneously">
            <option value="" {% if responsiveness_breathing.checkedPulseSimultaneously == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if responsiveness_breathing.checkedPulseSimultaneously == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if responsiveness_breathing.checkedPulseSimultaneously == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if responsiveness_breathing.checkedPulseSimultaneously == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="time_within_ten_seconds">Pulse/breathing check completed within 10 s</label>
        <select id="time_within_ten_seconds" name="responsiveness_breathing.time_within_ten_seconds">
            <option value="" {% if responsiveness_breathing.timeWithinTenSeconds == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if responsiveness_breathing.timeWithinTenSeconds == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if responsiveness_breathing.timeWithinTenSeconds == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if responsiveness_breathing.timeWithinTenSeconds == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>
</div>
