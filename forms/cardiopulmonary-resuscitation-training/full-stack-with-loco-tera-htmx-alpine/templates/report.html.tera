{% extends "base.html.tera" %}

{% block title %}BLS Assessment Report - {{ outcome_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>BLS Skills Verification &mdash; Assessment Report</h1>
    <div class="outcome-badge {{ outcome_class }}">{{ outcome_label }}</div>
    <div class="outcome-label">Items assessed: {{ answered_count }} / {{ total_rules }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Trainee Summary -->
<div class="card">
    <h2>Trainee Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.traineeDetails.firstName }} {{ data.traineeDetails.lastName }}<br>
            <strong>Trainee ID:</strong> {{ data.traineeDetails.traineeId }}<br>
            <strong>Role:</strong> {{ data.traineeDetails.role }}<br>
            <strong>Prior Certification Expiry:</strong> {{ data.traineeDetails.priorCertificationExpiry }}
        </div>
        <div>
            <strong>Session Date:</strong> {{ data.traineeDetails.sessionDate }}<br>
            <strong>Examiner:</strong> {{ data.traineeDetails.examinerName }}
        </div>
    </div>
</div>

<!-- Critical Failures -->
{% if critical_failures | length > 0 %}
<div class="card">
    <h2>Critical-Action Failures ({{ critical_failures | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr><th>ID</th><th>Step</th><th>Category</th><th>Description</th></tr>
        </thead>
        <tbody>
            {% for rule in critical_failures %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Non-Critical Deficiencies -->
{% if non_critical_deficiencies | length > 0 %}
<div class="card">
    <h2>Non-Critical Deficiencies ({{ non_critical_deficiencies | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr><th>ID</th><th>Step</th><th>Category</th><th>Description</th></tr>
        </thead>
        <tbody>
            {% for rule in non_critical_deficiencies %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Flagged Issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Full Rule Audit Trail -->
<div class="card">
    <h2>Rule Audit Trail ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
                <th>Critical</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{% if rule.critical %}Yes{% else %}No{% endif %}</td>
                <td>{{ rule.status }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Examiner & Trainee Notes -->
{% if data.teamDynamicsHandoff.examinerNotes or data.teamDynamicsHandoff.traineeFeedback %}
<div class="card">
    <h2>Debrief Notes</h2>
    {% if data.teamDynamicsHandoff.examinerNotes %}
    <p><strong>Examiner notes:</strong> {{ data.teamDynamicsHandoff.examinerNotes }}</p>
    {% endif %}
    {% if data.teamDynamicsHandoff.traineeFeedback %}
    <p><strong>Trainee feedback:</strong> {{ data.teamDynamicsHandoff.traineeFeedback }}</p>
    {% endif %}
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
