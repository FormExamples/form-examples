#!/bin/sh
set -euf

form_kebab_case=encounter-satisfaction
form_snake_case=encounter_satisfaction

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold encounter_satisfaction \
    deleted_at:tstz \
    patient:references \
    status:text! \
    --api

cargo loco generate scaffold visit_information \
    deleted_at:tstz \
    encounter_satisfaction:references \
    visit_date:date \
    department:text! \
    provider_name:text! \
    visit_type:text! \
    reason_for_visit:text! \
    first_visit:text! \
    --api

cargo loco generate scaffold access_scheduling \
    deleted_at:tstz \
    encounter_satisfaction:references \
    ease_of_scheduling:int \
    wait_for_appointment:int \
    wait_in_waiting_room:int \
    --api

cargo loco generate scaffold communication \
    deleted_at:tstz \
    encounter_satisfaction:references \
    listening:int \
    explaining_condition:int \
    answering_questions:int \
    time_spent:int \
    --api

cargo loco generate scaffold staff_professionalism \
    deleted_at:tstz \
    encounter_satisfaction:references \
    reception_courtesy:int \
    nursing_courtesy:int \
    respect_shown:int \
    --api

cargo loco generate scaffold care_quality \
    deleted_at:tstz \
    encounter_satisfaction:references \
    involvement_in_decisions:int \
    treatment_plan_explanation:int \
    confidence_in_care:int \
    --api

cargo loco generate scaffold environment \
    deleted_at:tstz \
    encounter_satisfaction:references \
    cleanliness:int \
    waiting_area_comfort:int \
    privacy:int \
    --api

cargo loco generate scaffold overall_satisfaction \
    deleted_at:tstz \
    encounter_satisfaction:references \
    overall_rating:int \
    likely_to_recommend:int \
    likely_to_return:int \
    comments:text! \
    --api

cargo loco generate scaffold satisfaction_result \
    deleted_at:tstz \
    encounter_satisfaction:references \
    composite_score:double! \
    category:text! \
    answered_count:int! \
    domain_scores:jsonb! \
    scored_at:tstz! \
    --api

cargo loco generate scaffold flagged_issue \
    deleted_at:tstz \
    satisfaction_result:references \
    flag_id:text! \
    category:text! \
    message:text! \
    priority:text! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
