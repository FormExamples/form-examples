<div class="card">
    <h2>Step 1: Trainee Details</h2>
    <p class="form-hint">Identification, role, prior certification, session date, examiner, and venue.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="trainee_details.first_name"
                   value="{{ trainee_details.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="trainee_details.last_name"
                   value="{{ trainee_details.lastName }}">
        </div>
        <div class="form-group">
            <label for="trainee_id">Trainee ID</label>
            <input type="text" id="trainee_id" name="trainee_details.trainee_id"
                   value="{{ trainee_details.traineeId }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="role">Role</label>
            <select id="role" name="trainee_details.role">
                <option value="" {% if trainee_details.role == "" %}selected{% endif %}>&mdash;</option>
                <option value="first-aider" {% if trainee_details.role == "first-aider" %}selected{% endif %}>First Aider</option>
                <option value="workplace-first-aider" {% if trainee_details.role == "workplace-first-aider" %}selected{% endif %}>Workplace First Aider</option>
                <option value="instructor-candidate" {% if trainee_details.role == "instructor-candidate" %}selected{% endif %}>Instructor Candidate</option>
                <option value="security-officer" {% if trainee_details.role == "security-officer" %}selected{% endif %}>Security Officer</option>
                <option value="lifeguard" {% if trainee_details.role == "lifeguard" %}selected{% endif %}>Lifeguard</option>
                <option value="teacher" {% if trainee_details.role == "teacher" %}selected{% endif %}>Teacher</option>
                <option value="volunteer" {% if trainee_details.role == "volunteer" %}selected{% endif %}>Volunteer</option>
                <option value="other" {% if trainee_details.role == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="prior_certification_expiry">Prior Certification Expiry</label>
            <input type="date" id="prior_certification_expiry" name="trainee_details.prior_certification_expiry"
                   value="{{ trainee_details.priorCertificationExpiry }}">
        </div>
        <div class="form-group">
            <label for="session_date">Session Date</label>
            <input type="date" id="session_date" name="trainee_details.session_date"
                   value="{{ trainee_details.sessionDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="examiner_name">Examiner Name</label>
            <input type="text" id="examiner_name" name="trainee_details.examiner_name"
                   value="{{ trainee_details.examinerName }}">
        </div>
        <div class="form-group">
            <label for="venue">Venue</label>
            <input type="text" id="venue" name="trainee_details.venue"
                   value="{{ trainee_details.venue }}">
        </div>
    </div>
</div>
