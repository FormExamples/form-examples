<div class="card">
    <h2>Step 2: Scene Assessment &amp; Safety</h2>
    <p class="form-hint">Confirm scene safety, PPE, hazard mitigation, and bystander control before approaching the casualty.</p>

    <div class="form-group">
        <label for="scene_safe">Scene is safe before approaching the casualty</label>
        <select id="scene_safe" name="scene_assessment_safety.scene_safe">
            <option value="" {% if scene_assessment_safety.sceneSafe == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_assessment_safety.sceneSafe == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if scene_assessment_safety.sceneSafe == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if scene_assessment_safety.sceneSafe == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_applied">Applies appropriate PPE (gloves, face shield)</label>
        <select id="ppe_applied" name="scene_assessment_safety.ppe_applied">
            <option value="" {% if scene_assessment_safety.ppeApplied == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_assessment_safety.ppeApplied == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if scene_assessment_safety.ppeApplied == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if scene_assessment_safety.ppeApplied == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="hazards_identified">Identifies and mitigates environmental hazards</label>
        <select id="hazards_identified" name="scene_assessment_safety.hazards_identified">
            <option value="" {% if scene_assessment_safety.hazardsIdentified == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_assessment_safety.hazardsIdentified == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if scene_assessment_safety.hazardsIdentified == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if scene_assessment_safety.hazardsIdentified == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="bystanders_controlled">Manages bystanders so they do not impede care</label>
        <select id="bystanders_controlled" name="scene_assessment_safety.bystanders_controlled">
            <option value="" {% if scene_assessment_safety.bystandersControlled == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if scene_assessment_safety.bystandersControlled == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if scene_assessment_safety.bystandersControlled == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if scene_assessment_safety.bystandersControlled == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>
</div>
