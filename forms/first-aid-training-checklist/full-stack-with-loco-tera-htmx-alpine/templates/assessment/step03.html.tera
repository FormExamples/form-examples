<div class="card">
    <h2>Step 3: Primary Survey (DRABC)</h2>
    <p class="form-hint">Danger, Response, Airway, Breathing, Circulation &mdash; the foundation of every first-aid response. Response check is a <strong>critical</strong> skill.</p>

    <div class="form-group">
        <label for="danger_check">D &mdash; checks for Danger to self, casualty, and bystanders</label>
        <select id="danger_check" name="primary_survey_drabc.danger_check">
            <option value="" {% if primary_survey_drabc.dangerCheck == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.dangerCheck == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.dangerCheck == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.dangerCheck == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="response_check">R &mdash; assesses Response (AVPU / shake-and-shout) <strong>critical</strong></label>
        <select id="response_check" name="primary_survey_drabc.response_check">
            <option value="" {% if primary_survey_drabc.responseCheck == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.responseCheck == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.responseCheck == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.responseCheck == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="airway_management">A &mdash; opens and clears Airway (head tilt-chin lift / jaw thrust)</label>
        <select id="airway_management" name="primary_survey_drabc.airway_management">
            <option value="" {% if primary_survey_drabc.airwayManagement == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.airwayManagement == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.airwayManagement == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.airwayManagement == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="breathing_check">B &mdash; checks Breathing (look, listen, feel) up to 10 seconds</label>
        <select id="breathing_check" name="primary_survey_drabc.breathing_check">
            <option value="" {% if primary_survey_drabc.breathingCheck == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.breathingCheck == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.breathingCheck == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.breathingCheck == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="circulation_assessment">C &mdash; assesses Circulation and obvious life-threatening bleeding</label>
        <select id="circulation_assessment" name="primary_survey_drabc.circulation_assessment">
            <option value="" {% if primary_survey_drabc.circulationAssessment == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.circulationAssessment == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.circulationAssessment == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.circulationAssessment == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recovery_position_when_appropriate">Places unconscious-but-breathing casualty in the recovery position</label>
        <select id="recovery_position_when_appropriate" name="primary_survey_drabc.recovery_position_when_appropriate">
            <option value="" {% if primary_survey_drabc.recoveryPositionWhenAppropriate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if primary_survey_drabc.recoveryPositionWhenAppropriate == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if primary_survey_drabc.recoveryPositionWhenAppropriate == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if primary_survey_drabc.recoveryPositionWhenAppropriate == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>
</div>
