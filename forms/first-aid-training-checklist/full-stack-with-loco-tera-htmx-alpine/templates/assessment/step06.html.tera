<div class="card">
    <h2>Step 6: Bleeding &amp; Wound Care</h2>
    <p class="form-hint">Direct pressure for major bleed and tourniquet for catastrophic haemorrhage are <strong>critical</strong> skills.</p>

    <div class="form-group">
        <label for="direct_pressure_applied">Applies firm direct pressure for major external bleeding <strong>critical</strong></label>
        <select id="direct_pressure_applied" name="bleeding_wound_care.direct_pressure_applied">
            <option value="" {% if bleeding_wound_care.directPressureApplied == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.directPressureApplied == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.directPressureApplied == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.directPressureApplied == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="elevated_and_immobilised">Elevates and immobilises injured part where appropriate</label>
        <select id="elevated_and_immobilised" name="bleeding_wound_care.elevated_and_immobilised">
            <option value="" {% if bleeding_wound_care.elevatedAndImmobilised == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.elevatedAndImmobilised == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.elevatedAndImmobilised == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.elevatedAndImmobilised == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="applied_dressing_correctly">Applies sterile dressing and bandage with appropriate pressure</label>
        <select id="applied_dressing_correctly" name="bleeding_wound_care.applied_dressing_correctly">
            <option value="" {% if bleeding_wound_care.appliedDressingCorrectly == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.appliedDressingCorrectly == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.appliedDressingCorrectly == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.appliedDressingCorrectly == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="tourniquet_when_indicated">Applies tourniquet correctly for catastrophic limb haemorrhage <strong>critical</strong></label>
        <select id="tourniquet_when_indicated" name="bleeding_wound_care.tourniquet_when_indicated">
            <option value="" {% if bleeding_wound_care.tourniquetWhenIndicated == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.tourniquetWhenIndicated == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.tourniquetWhenIndicated == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.tourniquetWhenIndicated == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="haemostatic_dressing_applied">Applies haemostatic dressing / wound packing for junctional haemorrhage</label>
        <select id="haemostatic_dressing_applied" name="bleeding_wound_care.haemostatic_dressing_applied">
            <option value="" {% if bleeding_wound_care.haemostaticDressingApplied == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.haemostaticDressingApplied == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.haemostaticDressingApplied == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.haemostaticDressingApplied == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>

    <div class="form-group">
        <label for="treated_for_shock">Treats casualty for shock (lay flat, raise legs, keep warm)</label>
        <select id="treated_for_shock" name="bleeding_wound_care.treated_for_shock">
            <option value="" {% if bleeding_wound_care.treatedForShock == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if bleeding_wound_care.treatedForShock == "yes" %}selected{% endif %}>Demonstrated</option>
            <option value="no" {% if bleeding_wound_care.treatedForShock == "no" %}selected{% endif %}>Not yet</option>
            <option value="na" {% if bleeding_wound_care.treatedForShock == "na" %}selected{% endif %}>Not assessed</option>
        </select>
    </div>
</div>
