{% extends "base.html.tera" %}

{% block title %}First Aid Training Checklist - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Training-Coordinator Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Trainee, ID, examiner, or venue...">
    </div>
    <div class="form-group">
        <label for="outcome">Outcome</label>
        <select id="outcome" name="outcome">
            <option value="">All</option>
            <option value="pass" {% if outcome == "pass" %}selected{% endif %}>Pass</option>
            <option value="needs-development" {% if outcome == "needs-development" %}selected{% endif %}>Needs Development</option>
            <option value="fail" {% if outcome == "fail" %}selected{% endif %}>Fail</option>
        </select>
    </div>
    <div class="form-group">
        <label for="role">Role</label>
        <select id="role" name="role">
            <option value="">All</option>
            <option value="first-aider" {% if role == "first-aider" %}selected{% endif %}>First Aider</option>
            <option value="workplace-first-aider" {% if role == "workplace-first-aider" %}selected{% endif %}>Workplace First Aider</option>
            <option value="instructor-candidate" {% if role == "instructor-candidate" %}selected{% endif %}>Instructor Candidate</option>
            <option value="security-officer" {% if role == "security-officer" %}selected{% endif %}>Security Officer</option>
            <option value="lifeguard" {% if role == "lifeguard" %}selected{% endif %}>Lifeguard</option>
            <option value="teacher" {% if role == "teacher" %}selected{% endif %}>Teacher</option>
            <option value="volunteer" {% if role == "volunteer" %}selected{% endif %}>Volunteer</option>
            <option value="other" {% if role == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Session Date</th>
            <th>Venue</th>
            <th>Trainee</th>
            <th>Role</th>
            <th>Examiner</th>
            <th>Outcome</th>
            <th>Critical</th>
            <th>Deficiencies</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.sessionDate }}</a></td>
            <td>{{ c.venue }}</td>
            <td>{{ c.traineeName }}<br><small>{{ c.traineeId }}</small></td>
            <td>{{ c.role }}</td>
            <td>{{ c.examinerName }}</td>
            <td><span class="outcome-badge outcome-{{ c.outcome }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.outcome }}</span></td>
            <td>
                {% if c.criticalFailureCount > 0 %}
                    <span class="badge badge-no">{{ c.criticalFailureCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>{{ c.deficiencyCount }}</td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
