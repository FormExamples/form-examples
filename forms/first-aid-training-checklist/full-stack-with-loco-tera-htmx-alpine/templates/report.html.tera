{% extends "base.html.tera" %}

{% block title %}Assessment Report - {{ outcome_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>First Aid at Work &mdash; Competency Report</h1>
    <div class="outcome-badge {{ outcome_class }}">{{ outcome_label }}</div>
    <div class="outcome-label">{{ answered_count }} of {{ total_rules }} rules assessed</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Trainee Summary -->
<div class="card">
    <h2>Trainee Summary</h2>
    <div class="form-row">
        <div>
            <strong>Trainee:</strong> {{ data.traineeDetails.firstName }} {{ data.traineeDetails.lastName }}<br>
            <strong>Trainee ID:</strong> {{ data.traineeDetails.traineeId }}<br>
            <strong>Role:</strong> {{ data.traineeDetails.role }}<br>
            <strong>Prior cert. expiry:</strong> {{ data.traineeDetails.priorCertificationExpiry }}
        </div>
        <div>
            <strong>Session date:</strong> {{ data.traineeDetails.sessionDate }}<br>
            <strong>Venue:</strong> {{ data.traineeDetails.venue }}<br>
            <strong>Examiner:</strong> {{ data.traineeDetails.examinerName }}
        </div>
    </div>
</div>

<!-- Critical Failures -->
{% if critical_failures | length > 0 %}
<div class="card">
    <h2>Critical-Skill Failures ({{ critical_failures | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in critical_failures %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Deficiencies -->
{% if deficiencies | length > 0 %}
<div class="card">
    <h2>Non-Critical Deficiencies ({{ deficiencies | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in deficiencies %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Flagged Issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- All evaluated rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Complete Rule Audit ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Step</th>
                <th>Category</th>
                <th>Description</th>
                <th>Critical</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.step }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{% if rule.critical %}yes{% else %}no{% endif %}</td>
                <td>{{ rule.status }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
