#!/bin/sh
set -euf

form_kebab_case=architecture-decision-record
form_snake_case=architecture_decision_record

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold author \
    deleted_at:ts \
    name:text! \
    email:text! \
    phone:text! \
    role:text! \
    organization_name:text! \
    team_name:text! \
    --api

cargo loco generate scaffold organization \
    deleted_at:ts \
    name:text! \
    legal_name:text! \
    industry:text! \
    domain:text! \
    country_as_iso_3166_1_alpha_2:string \
    description:text! \
    --api

cargo loco generate scaffold architecture_decision_record \
    deleted_at:ts \
    author:references \
    organization:references \
    slug:text! \
    number:int \
    title:text! \
    decision_date:date \
    status:text! \
    decision_group:text! \
    issue:text! \
    decision:text! \
    assumptions:text! \
    constraints:text! \
    argument:text! \
    implications:text! \
    related_decisions:text! \
    related_requirements:text! \
    related_artifacts:text! \
    related_principles:text! \
    signed_off_by:text! \
    signed_off_at:ts \
    --api

cargo loco generate scaffold architecture_decision_record_position \
    architecture_decision_record:references \
    ordinal:int! \
    name:text! \
    description:text! \
    model_or_diagram_url:text! \
    is_chosen:bool! \
    pros:text! \
    cons:text! \
    --api

cargo loco generate scaffold architecture_decision_record_note \
    architecture_decision_record:references \
    noted_at:ts! \
    noted_by:text! \
    body:text! \
    --api
