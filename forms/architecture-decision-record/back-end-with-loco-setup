#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding architecture-decision-record (5 tables)..."

cargo loco generate scaffold author \
    deleted_at:ts \
    name:text! \
    email:text! \
    phone:text! \
    role:text! \
    organization_name:text! \
    team_name:text! \
    --api && \
cargo loco generate scaffold organization \
    deleted_at:ts \
    name:text! \
    legal_name:text! \
    industry:text! \
    domain:text! \
    country_as_iso_3166_1_alpha_2:string \
    description:text! \
    --api && \
cargo loco generate scaffold architecture_decision_record \
    deleted_at:ts \
    author:references \
    organization:references \
    slug:text! \
    number:int \
    title:text! \
    decision_date:date \
    status:text! \
    decision_group:text! \
    issue:text! \
    decision:text! \
    assumptions:text! \
    constraints:text! \
    argument:text! \
    implications:text! \
    related_decisions:text! \
    related_requirements:text! \
    related_artifacts:text! \
    related_principles:text! \
    signed_off_by:text! \
    signed_off_at:ts \
    --api && \
cargo loco generate scaffold architecture_decision_record_position \
    architecture_decision_record:references \
    ordinal:int! \
    name:text! \
    description:text! \
    model_or_diagram_url:text! \
    is_chosen:bool! \
    pros:text! \
    cons:text! \
    --api && \
cargo loco generate scaffold architecture_decision_record_note \
    architecture_decision_record:references \
    noted_at:ts! \
    noted_by:text! \
    body:text! \
    --api

echo "Done."
