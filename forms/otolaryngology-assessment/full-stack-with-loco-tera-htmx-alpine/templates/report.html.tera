{% extends "base.html.tera" %}

{% block title %}Assessment Report - {{ severity_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Otolaryngology Assessment &mdash; Report</h1>
    <div class="checklist-badge {{ severity_class }}">{{ severity_label }}</div>
    <div class="checklist-label">SNOT-22 Total: {{ total_score }} / 110 &mdash; {{ answered_count }} of 22 items answered</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Demographics Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Occupation:</strong> {{ data.demographics.occupation }}
        </div>
        <div>
            <strong>Chief Complaint:</strong> {{ data.presentingComplaint.chiefComplaint }}<br>
            <strong>Onset:</strong> {{ data.historyOfPresentIllness.onsetDate }} ({{ data.historyOfPresentIllness.onsetType }})<br>
            <strong>Working Diagnosis:</strong> {{ data.clinicalImpressionPlan.workingDiagnosis }}
        </div>
    </div>
</div>

<!-- Clinical Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Clinical Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- SNOT-22 Audit Trail -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>SNOT-22 Item Audit ({{ fired_rules | length }} answered)</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Management Plan -->
<div class="card">
    <h2>Management Plan</h2>
    <p><strong>Investigations:</strong> {{ data.clinicalImpressionPlan.investigationsRequired }}
        {% if data.clinicalImpressionPlan.investigationsDetails %} &mdash; {{ data.clinicalImpressionPlan.investigationsDetails }}{% endif %}</p>
    <p><strong>Medication:</strong> {{ data.clinicalImpressionPlan.medicationPrescribed }}
        {% if data.clinicalImpressionPlan.medicationDetails %} &mdash; {{ data.clinicalImpressionPlan.medicationDetails }}{% endif %}</p>
    <p><strong>Referral:</strong> {{ data.clinicalImpressionPlan.referralRequired }}
        {% if data.clinicalImpressionPlan.referralDetails %} &mdash; {{ data.clinicalImpressionPlan.referralDetails }}{% endif %}</p>
    <p><strong>Surgery considered:</strong> {{ data.clinicalImpressionPlan.surgeryConsidered }}
        {% if data.clinicalImpressionPlan.surgeryDetails %} &mdash; {{ data.clinicalImpressionPlan.surgeryDetails }}{% endif %}</p>
    <p><strong>Follow-up:</strong> {{ data.clinicalImpressionPlan.followUpPlan }}</p>
    <p><strong>Patient education:</strong> {{ data.clinicalImpressionPlan.patientEducation }}</p>
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
