{% extends "base.html.tera" %}

{% block title %}Otolaryngology Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Otolaryngology Assessment</h1>
        <p class="landing-description">
            General ear-nose-throat consultation assessment covering presenting complaint,
            history, examination findings, and the <strong>SNOT-22</strong> (Sino-Nasal
            Outcome Test) symptom score to quantify sinonasal quality of life and guide ENT
            management. The output is a clinician-facing report with severity classification,
            red-flag detection, and a per-item audit trail.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>10 Wizard Steps</h3>
                <p>Demographics through clinical impression &mdash; one continuous single-page form</p>
            </div>
            <div class="feature">
                <h3>SNOT-22 Score</h3>
                <p>22 sino-nasal items, 0-110 total, banded mild / moderate / severe</p>
            </div>
            <div class="feature">
                <h3>Red-Flag Detection</h3>
                <p>Neck mass, tympanic perforation, sudden hearing loss, and head/neck cancer history surfaced as priority flags</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
