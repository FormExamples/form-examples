<div class="card">
    <h2>Step 3: History of Present Illness</h2>
    <p class="form-hint">Onset, progression, and modifying factors.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="onset_date">Onset Date</label>
            <input type="date" id="onset_date" name="history_of_present_illness.onset_date"
                   value="{{ history_of_present_illness.onsetDate }}">
        </div>
        <div class="form-group">
            <label for="onset_type">Onset Type</label>
            <select id="onset_type" name="history_of_present_illness.onset_type">
                <option value="" {% if history_of_present_illness.onsetType == "" %}selected{% endif %}>&mdash;</option>
                <option value="sudden" {% if history_of_present_illness.onsetType == "sudden" %}selected{% endif %}>Sudden</option>
                <option value="gradual" {% if history_of_present_illness.onsetType == "gradual" %}selected{% endif %}>Gradual</option>
            </select>
        </div>
        <div class="form-group">
            <label for="progression">Progression</label>
            <select id="progression" name="history_of_present_illness.progression">
                <option value="" {% if history_of_present_illness.progression == "" %}selected{% endif %}>&mdash;</option>
                <option value="worsening" {% if history_of_present_illness.progression == "worsening" %}selected{% endif %}>Worsening</option>
                <option value="stable" {% if history_of_present_illness.progression == "stable" %}selected{% endif %}>Stable</option>
                <option value="improving" {% if history_of_present_illness.progression == "improving" %}selected{% endif %}>Improving</option>
                <option value="fluctuating" {% if history_of_present_illness.progression == "fluctuating" %}selected{% endif %}>Fluctuating</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="laterality">Laterality</label>
            <select id="laterality" name="history_of_present_illness.laterality">
                <option value="" {% if history_of_present_illness.laterality == "" %}selected{% endif %}>&mdash;</option>
                <option value="left" {% if history_of_present_illness.laterality == "left" %}selected{% endif %}>Left</option>
                <option value="right" {% if history_of_present_illness.laterality == "right" %}selected{% endif %}>Right</option>
                <option value="both" {% if history_of_present_illness.laterality == "both" %}selected{% endif %}>Both</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_episodes">Previous Episodes</label>
            <select id="previous_episodes" name="history_of_present_illness.previous_episodes">
                <option value="" {% if history_of_present_illness.previousEpisodes == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if history_of_present_illness.previousEpisodes == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if history_of_present_illness.previousEpisodes == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="aggravating_factors">Aggravating Factors</label>
        <textarea id="aggravating_factors" name="history_of_present_illness.aggravating_factors"
                  rows="2">{{ history_of_present_illness.aggravatingFactors }}</textarea>
    </div>
    <div class="form-group">
        <label for="relieving_factors">Relieving Factors</label>
        <textarea id="relieving_factors" name="history_of_present_illness.relieving_factors"
                  rows="2">{{ history_of_present_illness.relievingFactors }}</textarea>
    </div>
    <div class="form-group">
        <label for="associated_symptoms">Associated Symptoms</label>
        <textarea id="associated_symptoms" name="history_of_present_illness.associated_symptoms"
                  rows="2">{{ history_of_present_illness.associatedSymptoms }}</textarea>
    </div>
</div>
