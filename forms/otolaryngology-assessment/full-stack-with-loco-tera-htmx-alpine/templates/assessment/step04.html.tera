<div class="card">
    <h2>Step 4: Past ENT History &amp; Surgery</h2>
    <p class="form-hint">Prior ENT diagnoses, surgery, and lifestyle risk factors.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="prior_ent_surgery">Prior ENT Surgery</label>
            <select id="prior_ent_surgery" name="past_ent_history.prior_ent_surgery">
                <option value="" {% if past_ent_history.priorEntSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.priorEntSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.priorEntSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="prior_ent_surgery_details">Surgery Details (when prior surgery = yes)</label>
        <textarea id="prior_ent_surgery_details" name="past_ent_history.prior_ent_surgery_details"
                  rows="2">{{ past_ent_history.priorEntSurgeryDetails }}</textarea>
    </div>

    <h3>Conditions</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="chronic_sinusitis">Chronic Sinusitis</label>
            <select id="chronic_sinusitis" name="past_ent_history.chronic_sinusitis">
                <option value="" {% if past_ent_history.chronicSinusitis == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.chronicSinusitis == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.chronicSinusitis == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="allergic_rhinitis">Allergic Rhinitis</label>
            <select id="allergic_rhinitis" name="past_ent_history.allergic_rhinitis">
                <option value="" {% if past_ent_history.allergicRhinitis == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.allergicRhinitis == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.allergicRhinitis == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hearing_loss">Hearing Loss</label>
            <select id="hearing_loss" name="past_ent_history.hearing_loss">
                <option value="" {% if past_ent_history.hearingLoss == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.hearingLoss == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.hearingLoss == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="tinnitus">Tinnitus</label>
            <select id="tinnitus" name="past_ent_history.tinnitus">
                <option value="" {% if past_ent_history.tinnitus == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.tinnitus == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.tinnitus == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vertigo">Vertigo</label>
            <select id="vertigo" name="past_ent_history.vertigo">
                <option value="" {% if past_ent_history.vertigo == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.vertigo == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.vertigo == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hearing_aids">Hearing Aids</label>
            <select id="hearing_aids" name="past_ent_history.hearing_aids">
                <option value="" {% if past_ent_history.hearingAids == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.hearingAids == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.hearingAids == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="head_neck_cancer">Head &amp; Neck Cancer</label>
            <select id="head_neck_cancer" name="past_ent_history.head_neck_cancer">
                <option value="" {% if past_ent_history.headNeckCancer == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.headNeckCancer == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.headNeckCancer == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="head_neck_radiotherapy">Head/Neck Radiotherapy</label>
            <select id="head_neck_radiotherapy" name="past_ent_history.head_neck_radiotherapy">
                <option value="" {% if past_ent_history.headNeckRadiotherapy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.headNeckRadiotherapy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.headNeckRadiotherapy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="smoking">Active Smoking</label>
            <select id="smoking" name="past_ent_history.smoking">
                <option value="" {% if past_ent_history.smoking == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.smoking == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.smoking == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="alcohol">Significant Alcohol</label>
            <select id="alcohol" name="past_ent_history.alcohol">
                <option value="" {% if past_ent_history.alcohol == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if past_ent_history.alcohol == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if past_ent_history.alcohol == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
