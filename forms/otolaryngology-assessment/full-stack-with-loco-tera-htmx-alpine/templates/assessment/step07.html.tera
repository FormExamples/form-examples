<div class="card">
    <h2>Step 7: Otoscopy</h2>
    <p class="form-hint">Per-side examination of tympanic membrane and ear canal.</p>

    <h3>Right Ear</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="oto_right_tm">Tympanic Membrane</label>
            <select id="oto_right_tm" name="otoscopy.right.tympanic_membrane">
                <option value="" {% if otoscopy.right.tympanicMembrane == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if otoscopy.right.tympanicMembrane == "normal" %}selected{% endif %}>Normal</option>
                <option value="erythematous" {% if otoscopy.right.tympanicMembrane == "erythematous" %}selected{% endif %}>Erythematous</option>
                <option value="bulging" {% if otoscopy.right.tympanicMembrane == "bulging" %}selected{% endif %}>Bulging</option>
                <option value="retracted" {% if otoscopy.right.tympanicMembrane == "retracted" %}selected{% endif %}>Retracted</option>
                <option value="perforated" {% if otoscopy.right.tympanicMembrane == "perforated" %}selected{% endif %}>Perforated</option>
                <option value="effusion" {% if otoscopy.right.tympanicMembrane == "effusion" %}selected{% endif %}>Effusion</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oto_right_canal">Canal</label>
            <select id="oto_right_canal" name="otoscopy.right.canal">
                <option value="" {% if otoscopy.right.canal == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if otoscopy.right.canal == "normal" %}selected{% endif %}>Normal</option>
                <option value="wax" {% if otoscopy.right.canal == "wax" %}selected{% endif %}>Wax</option>
                <option value="discharge" {% if otoscopy.right.canal == "discharge" %}selected{% endif %}>Discharge</option>
                <option value="foreign-body" {% if otoscopy.right.canal == "foreign-body" %}selected{% endif %}>Foreign body</option>
                <option value="inflamed" {% if otoscopy.right.canal == "inflamed" %}selected{% endif %}>Inflamed</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oto_right_mobility">Mobility</label>
            <select id="oto_right_mobility" name="otoscopy.right.mobility">
                <option value="" {% if otoscopy.right.mobility == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if otoscopy.right.mobility == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if otoscopy.right.mobility == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <h3>Left Ear</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="oto_left_tm">Tympanic Membrane</label>
            <select id="oto_left_tm" name="otoscopy.left.tympanic_membrane">
                <option value="" {% if otoscopy.left.tympanicMembrane == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if otoscopy.left.tympanicMembrane == "normal" %}selected{% endif %}>Normal</option>
                <option value="erythematous" {% if otoscopy.left.tympanicMembrane == "erythematous" %}selected{% endif %}>Erythematous</option>
                <option value="bulging" {% if otoscopy.left.tympanicMembrane == "bulging" %}selected{% endif %}>Bulging</option>
                <option value="retracted" {% if otoscopy.left.tympanicMembrane == "retracted" %}selected{% endif %}>Retracted</option>
                <option value="perforated" {% if otoscopy.left.tympanicMembrane == "perforated" %}selected{% endif %}>Perforated</option>
                <option value="effusion" {% if otoscopy.left.tympanicMembrane == "effusion" %}selected{% endif %}>Effusion</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oto_left_canal">Canal</label>
            <select id="oto_left_canal" name="otoscopy.left.canal">
                <option value="" {% if otoscopy.left.canal == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if otoscopy.left.canal == "normal" %}selected{% endif %}>Normal</option>
                <option value="wax" {% if otoscopy.left.canal == "wax" %}selected{% endif %}>Wax</option>
                <option value="discharge" {% if otoscopy.left.canal == "discharge" %}selected{% endif %}>Discharge</option>
                <option value="foreign-body" {% if otoscopy.left.canal == "foreign-body" %}selected{% endif %}>Foreign body</option>
                <option value="inflamed" {% if otoscopy.left.canal == "inflamed" %}selected{% endif %}>Inflamed</option>
            </select>
        </div>
        <div class="form-group">
            <label for="oto_left_mobility">Mobility</label>
            <select id="oto_left_mobility" name="otoscopy.left.mobility">
                <option value="" {% if otoscopy.left.mobility == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if otoscopy.left.mobility == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if otoscopy.left.mobility == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="otoscopy_notes">Notes</label>
        <textarea id="otoscopy_notes" name="otoscopy.otoscopy_notes"
                  rows="2">{{ otoscopy.otoscopyNotes }}</textarea>
    </div>
</div>
