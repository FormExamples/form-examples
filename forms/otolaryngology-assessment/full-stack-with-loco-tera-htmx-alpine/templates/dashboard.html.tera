{% extends "base.html.tera" %}

{% block title %}Otolaryngology Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>ENT Clinic Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, chief complaint, or working diagnosis...">
    </div>
    <div class="form-group">
        <label for="severity_level">Severity</label>
        <select id="severity_level" name="severity_level">
            <option value="">All</option>
            <option value="mild" {% if severity_level == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if severity_level == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if severity_level == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="sex">Sex</label>
        <select id="sex" name="sex">
            <option value="">All</option>
            <option value="female" {% if sex == "female" %}selected{% endif %}>Female</option>
            <option value="male" {% if sex == "male" %}selected{% endif %}>Male</option>
            <option value="other" {% if sex == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Date of Birth</th>
            <th>Sex</th>
            <th>Chief Complaint</th>
            <th>Working Diagnosis</th>
            <th>SNOT-22</th>
            <th>Severity</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.firstName }} {{ c.lastName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.sex }}</td>
            <td>{{ c.chiefComplaint }}</td>
            <td>{{ c.workingDiagnosis }}</td>
            <td>{{ c.totalScore }}</td>
            <td><span class="checklist-badge severity-{{ c.severityLevel }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.severityLevel }}</span></td>
            <td>
                {% if c.urgentFlagCount + c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount + c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
