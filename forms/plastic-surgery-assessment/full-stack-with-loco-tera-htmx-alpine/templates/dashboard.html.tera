{% extends "base.html.tera" %}

{% block title %}Plastic Surgery Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Plastic Surgery Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or procedure...">
    </div>
    <div class="form-group">
        <label for="overall_risk">Overall Risk</label>
        <select id="overall_risk" name="overall_risk">
            <option value="">All</option>
            <option value="low" {% if overall_risk == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if overall_risk == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if overall_risk == "high" %}selected{% endif %}>High</option>
            <option value="critical" {% if overall_risk == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="urgency">Urgency</label>
        <select id="urgency" name="urgency">
            <option value="">All</option>
            <option value="routine" {% if urgency == "routine" %}selected{% endif %}>Routine</option>
            <option value="urgent" {% if urgency == "urgent" %}selected{% endif %}>Urgent</option>
            <option value="emergency" {% if urgency == "emergency" %}selected{% endif %}>Emergency</option>
        </select>
    </div>
    <div class="form-group">
        <label for="referral_type">Referral Type</label>
        <select id="referral_type" name="referral_type">
            <option value="">All</option>
            <option value="reconstructive" {% if referral_type == "reconstructive" %}selected{% endif %}>Reconstructive</option>
            <option value="aesthetic" {% if referral_type == "aesthetic" %}selected{% endif %}>Aesthetic</option>
            <option value="trauma" {% if referral_type == "trauma" %}selected{% endif %}>Trauma</option>
            <option value="burn" {% if referral_type == "burn" %}selected{% endif %}>Burn</option>
            <option value="cancer" {% if referral_type == "cancer" %}selected{% endif %}>Cancer</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Sex</th>
            <th>Referral</th>
            <th>Procedure</th>
            <th>ASA</th>
            <th>Wound</th>
            <th>Complexity</th>
            <th>Risk</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.patientName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.sex }}</td>
            <td>{{ c.referralType }} / {{ c.urgency }}</td>
            <td>{{ c.proposedProcedure }}</td>
            <td>{{ c.asaClass }}</td>
            <td>{{ c.woundClass }}</td>
            <td>{{ c.complexityScore }}</td>
            <td><span class="risk-badge risk-{{ c.overallRisk }}">{{ c.overallRisk }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
