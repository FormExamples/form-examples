<div class="card">
    <h2>Step 5: Wound &amp; Tissue Assessment</h2>
    <p class="form-hint">Wound classification, viability, vascular supply, and exudate.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="has_open_wound">Open wound present?</label>
            <select id="has_open_wound" name="wound_tissue_assessment.has_open_wound">
                <option value="" {% if wound_tissue_assessment.hasOpenWound == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if wound_tissue_assessment.hasOpenWound == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if wound_tissue_assessment.hasOpenWound == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="wound_classification">Wound classification</label>
            <select id="wound_classification" name="wound_tissue_assessment.wound_classification">
                <option value="" {% if wound_tissue_assessment.woundClassification == "" %}selected{% endif %}>&mdash;</option>
                <option value="clean" {% if wound_tissue_assessment.woundClassification == "clean" %}selected{% endif %}>Class I - Clean</option>
                <option value="clean-contaminated" {% if wound_tissue_assessment.woundClassification == "clean-contaminated" %}selected{% endif %}>Class II - Clean-Contaminated</option>
                <option value="contaminated" {% if wound_tissue_assessment.woundClassification == "contaminated" %}selected{% endif %}>Class III - Contaminated</option>
                <option value="dirty" {% if wound_tissue_assessment.woundClassification == "dirty" %}selected{% endif %}>Class IV - Dirty/Infected</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_age">Wound age</label>
            <input type="text" id="wound_age" name="wound_tissue_assessment.wound_age"
                   value="{{ wound_tissue_assessment.woundAge }}">
        </div>
        <div class="form-group">
            <label for="wound_aetiology">Wound aetiology</label>
            <input type="text" id="wound_aetiology" name="wound_tissue_assessment.wound_aetiology"
                   value="{{ wound_tissue_assessment.woundAetiology }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_bed_tissue">Wound bed tissue</label>
            <select id="wound_bed_tissue" name="wound_tissue_assessment.wound_bed_tissue">
                <option value="" {% if wound_tissue_assessment.woundBedTissue == "" %}selected{% endif %}>&mdash;</option>
                <option value="granulation" {% if wound_tissue_assessment.woundBedTissue == "granulation" %}selected{% endif %}>Granulation</option>
                <option value="slough" {% if wound_tissue_assessment.woundBedTissue == "slough" %}selected{% endif %}>Slough</option>
                <option value="necrotic" {% if wound_tissue_assessment.woundBedTissue == "necrotic" %}selected{% endif %}>Necrotic</option>
                <option value="epithelial" {% if wound_tissue_assessment.woundBedTissue == "epithelial" %}selected{% endif %}>Epithelial</option>
            </select>
        </div>
        <div class="form-group">
            <label for="wound_exudate">Wound exudate</label>
            <select id="wound_exudate" name="wound_tissue_assessment.wound_exudate">
                <option value="" {% if wound_tissue_assessment.woundExudate == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if wound_tissue_assessment.woundExudate == "none" %}selected{% endif %}>None</option>
                <option value="serous" {% if wound_tissue_assessment.woundExudate == "serous" %}selected{% endif %}>Serous</option>
                <option value="sanguinous" {% if wound_tissue_assessment.woundExudate == "sanguinous" %}selected{% endif %}>Sanguinous</option>
                <option value="purulent" {% if wound_tissue_assessment.woundExudate == "purulent" %}selected{% endif %}>Purulent</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_infection_signs">Active infection signs?</label>
            <select id="wound_infection_signs" name="wound_tissue_assessment.wound_infection_signs">
                <option value="" {% if wound_tissue_assessment.woundInfectionSigns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if wound_tissue_assessment.woundInfectionSigns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if wound_tissue_assessment.woundInfectionSigns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="wound_infection_details">Infection details</label>
            <input type="text" id="wound_infection_details" name="wound_tissue_assessment.wound_infection_details"
                   value="{{ wound_tissue_assessment.woundInfectionDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="tissue_viability">Tissue viability</label>
            <select id="tissue_viability" name="wound_tissue_assessment.tissue_viability">
                <option value="" {% if wound_tissue_assessment.tissueViability == "" %}selected{% endif %}>&mdash;</option>
                <option value="viable" {% if wound_tissue_assessment.tissueViability == "viable" %}selected{% endif %}>Viable</option>
                <option value="marginal" {% if wound_tissue_assessment.tissueViability == "marginal" %}selected{% endif %}>Marginal</option>
                <option value="non-viable" {% if wound_tissue_assessment.tissueViability == "non-viable" %}selected{% endif %}>Non-viable</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vascular_supply">Vascular supply</label>
            <select id="vascular_supply" name="wound_tissue_assessment.vascular_supply">
                <option value="" {% if wound_tissue_assessment.vascularSupply == "" %}selected{% endif %}>&mdash;</option>
                <option value="adequate" {% if wound_tissue_assessment.vascularSupply == "adequate" %}selected{% endif %}>Adequate</option>
                <option value="compromised" {% if wound_tissue_assessment.vascularSupply == "compromised" %}selected{% endif %}>Compromised</option>
                <option value="absent" {% if wound_tissue_assessment.vascularSupply == "absent" %}selected{% endif %}>Absent</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="surrounding_skin">Surrounding skin</label>
            <input type="text" id="surrounding_skin" name="wound_tissue_assessment.surrounding_skin"
                   value="{{ wound_tissue_assessment.surroundingSkin }}">
        </div>
        <div class="form-group">
            <label for="sensory_status">Sensory status</label>
            <input type="text" id="sensory_status" name="wound_tissue_assessment.sensory_status"
                   value="{{ wound_tissue_assessment.sensoryStatus }}">
        </div>
    </div>

    <div class="form-group">
        <label for="previous_wound_treatments">Previous wound treatments</label>
        <textarea id="previous_wound_treatments" name="wound_tissue_assessment.previous_wound_treatments">{{ wound_tissue_assessment.previousWoundTreatments }}</textarea>
    </div>
</div>
