<div class="card">
    <h2>Step 3: Medical &amp; Surgical History</h2>
    <p class="form-hint">Prior surgery, comorbidities, and bleeding/immune status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_plastic_surgery">Previous plastic surgery?</label>
            <select id="previous_plastic_surgery" name="medical_surgical_history.previous_plastic_surgery">
                <option value="" {% if medical_surgical_history.previousPlasticSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.previousPlasticSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.previousPlasticSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_plastic_surgery_details">Details</label>
            <input type="text" id="previous_plastic_surgery_details" name="medical_surgical_history.previous_plastic_surgery_details"
                   value="{{ medical_surgical_history.previousPlasticSurgeryDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_general_surgery">Previous general surgery?</label>
            <select id="previous_general_surgery" name="medical_surgical_history.previous_general_surgery">
                <option value="" {% if medical_surgical_history.previousGeneralSurgery == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.previousGeneralSurgery == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.previousGeneralSurgery == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_general_surgery_details">Details</label>
            <input type="text" id="previous_general_surgery_details" name="medical_surgical_history.previous_general_surgery_details"
                   value="{{ medical_surgical_history.previousGeneralSurgeryDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wound_healing_problems">Wound healing problems?</label>
            <select id="wound_healing_problems" name="medical_surgical_history.wound_healing_problems">
                <option value="" {% if medical_surgical_history.woundHealingProblems == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.woundHealingProblems == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.woundHealingProblems == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="wound_healing_details">Details</label>
            <input type="text" id="wound_healing_details" name="medical_surgical_history.wound_healing_details"
                   value="{{ medical_surgical_history.woundHealingDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="keloid_scarring">Keloid / hypertrophic scarring tendency?</label>
            <select id="keloid_scarring" name="medical_surgical_history.keloid_scarring">
                <option value="" {% if medical_surgical_history.keloidScarring == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.keloidScarring == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.keloidScarring == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="scarring_details">Details</label>
            <input type="text" id="scarring_details" name="medical_surgical_history.scarring_details"
                   value="{{ medical_surgical_history.scarringDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="diabetes">Diabetes</label>
            <select id="diabetes" name="medical_surgical_history.diabetes">
                <option value="" {% if medical_surgical_history.diabetes == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.diabetes == "no" %}selected{% endif %}>No</option>
                <option value="type-1" {% if medical_surgical_history.diabetes == "type-1" %}selected{% endif %}>Type 1</option>
                <option value="type-2" {% if medical_surgical_history.diabetes == "type-2" %}selected{% endif %}>Type 2</option>
            </select>
        </div>
        <div class="form-group">
            <label for="diabetes_controlled">Diabetes controlled?</label>
            <select id="diabetes_controlled" name="medical_surgical_history.diabetes_controlled">
                <option value="" {% if medical_surgical_history.diabetesControlled == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if medical_surgical_history.diabetesControlled == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if medical_surgical_history.diabetesControlled == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hypertension">Hypertension?</label>
            <select id="hypertension" name="medical_surgical_history.hypertension">
                <option value="" {% if medical_surgical_history.hypertension == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.hypertension == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.hypertension == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cardiac_disease">Cardiac disease?</label>
            <select id="cardiac_disease" name="medical_surgical_history.cardiac_disease">
                <option value="" {% if medical_surgical_history.cardiacDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.cardiacDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.cardiacDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cardiac_disease_details">Cardiac disease details</label>
            <input type="text" id="cardiac_disease_details" name="medical_surgical_history.cardiac_disease_details"
                   value="{{ medical_surgical_history.cardiacDiseaseDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="respiratory_disease">Respiratory disease?</label>
            <select id="respiratory_disease" name="medical_surgical_history.respiratory_disease">
                <option value="" {% if medical_surgical_history.respiratoryDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.respiratoryDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.respiratoryDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="respiratory_disease_details">Respiratory disease details</label>
            <input type="text" id="respiratory_disease_details" name="medical_surgical_history.respiratory_disease_details"
                   value="{{ medical_surgical_history.respiratoryDiseaseDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="autoimmune_disease">Autoimmune disease?</label>
            <select id="autoimmune_disease" name="medical_surgical_history.autoimmune_disease">
                <option value="" {% if medical_surgical_history.autoimmuneDisease == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.autoimmuneDisease == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.autoimmuneDisease == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="autoimmune_disease_details">Autoimmune details</label>
            <input type="text" id="autoimmune_disease_details" name="medical_surgical_history.autoimmune_disease_details"
                   value="{{ medical_surgical_history.autoimmuneDiseaseDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="bleeding_disorder">Bleeding disorder?</label>
            <select id="bleeding_disorder" name="medical_surgical_history.bleeding_disorder">
                <option value="" {% if medical_surgical_history.bleedingDisorder == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.bleedingDisorder == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.bleedingDisorder == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="bleeding_disorder_details">Bleeding disorder details</label>
            <input type="text" id="bleeding_disorder_details" name="medical_surgical_history.bleeding_disorder_details"
                   value="{{ medical_surgical_history.bleedingDisorderDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="immunosuppressed">Immunosuppressed?</label>
            <select id="immunosuppressed" name="medical_surgical_history.immunosuppressed">
                <option value="" {% if medical_surgical_history.immunosuppressed == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.immunosuppressed == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.immunosuppressed == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="immunosuppressed_details">Immunosuppressed details</label>
            <input type="text" id="immunosuppressed_details" name="medical_surgical_history.immunosuppressed_details"
                   value="{{ medical_surgical_history.immunosuppressedDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="cancer_history">Active cancer history?</label>
            <select id="cancer_history" name="medical_surgical_history.cancer_history">
                <option value="" {% if medical_surgical_history.cancerHistory == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medical_surgical_history.cancerHistory == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medical_surgical_history.cancerHistory == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cancer_history_details">Cancer history details</label>
            <input type="text" id="cancer_history_details" name="medical_surgical_history.cancer_history_details"
                   value="{{ medical_surgical_history.cancerHistoryDetails }}">
        </div>
    </div>
</div>
