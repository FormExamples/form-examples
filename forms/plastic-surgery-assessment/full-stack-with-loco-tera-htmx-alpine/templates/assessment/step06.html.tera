<div class="card">
    <h2>Step 6: Psychological Assessment</h2>
    <p class="form-hint">Body image, expectations, motivation, anxiety, and social impact.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="body_dysmorphic_concern">Body dysmorphic concern?</label>
            <select id="body_dysmorphic_concern" name="psychological_assessment.body_dysmorphic_concern">
                <option value="" {% if psychological_assessment.bodyDysmorphicConcern == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if psychological_assessment.bodyDysmorphicConcern == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if psychological_assessment.bodyDysmorphicConcern == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="body_dysmorphic_details">Dysmorphic concern details</label>
            <input type="text" id="body_dysmorphic_details" name="psychological_assessment.body_dysmorphic_details"
                   value="{{ psychological_assessment.bodyDysmorphicDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="realistic_expectations">Realistic expectations?</label>
            <select id="realistic_expectations" name="psychological_assessment.realistic_expectations">
                <option value="" {% if psychological_assessment.realisticExpectations == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_assessment.realisticExpectations == "yes" %}selected{% endif %}>Yes</option>
                <option value="partly" {% if psychological_assessment.realisticExpectations == "partly" %}selected{% endif %}>Partly</option>
                <option value="no" {% if psychological_assessment.realisticExpectations == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="expectations_details">Expectations details</label>
            <input type="text" id="expectations_details" name="psychological_assessment.expectations_details"
                   value="{{ psychological_assessment.expectationsDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="motivation">Motivation</label>
            <input type="text" id="motivation" name="psychological_assessment.motivation"
                   value="{{ psychological_assessment.motivation }}">
        </div>
        <div class="form-group">
            <label for="motivation_other">Motivation (other)</label>
            <input type="text" id="motivation_other" name="psychological_assessment.motivation_other"
                   value="{{ psychological_assessment.motivationOther }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_mental_health">Previous mental health history?</label>
            <select id="previous_mental_health" name="psychological_assessment.previous_mental_health">
                <option value="" {% if psychological_assessment.previousMentalHealth == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if psychological_assessment.previousMentalHealth == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if psychological_assessment.previousMentalHealth == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="mental_health_details">Mental health details</label>
            <input type="text" id="mental_health_details" name="psychological_assessment.mental_health_details"
                   value="{{ psychological_assessment.mentalHealthDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="anxiety_level">Anxiety level</label>
            <select id="anxiety_level" name="psychological_assessment.anxiety_level">
                <option value="" {% if psychological_assessment.anxietyLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if psychological_assessment.anxietyLevel == "none" %}selected{% endif %}>None</option>
                <option value="mild" {% if psychological_assessment.anxietyLevel == "mild" %}selected{% endif %}>Mild</option>
                <option value="moderate" {% if psychological_assessment.anxietyLevel == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="severe" {% if psychological_assessment.anxietyLevel == "severe" %}selected{% endif %}>Severe</option>
            </select>
        </div>
        <div class="form-group">
            <label for="depression_screen">Depression screen positive?</label>
            <select id="depression_screen" name="psychological_assessment.depression_screen">
                <option value="" {% if psychological_assessment.depressionScreen == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if psychological_assessment.depressionScreen == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if psychological_assessment.depressionScreen == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="social_impact">Social impact</label>
            <input type="text" id="social_impact" name="psychological_assessment.social_impact"
                   value="{{ psychological_assessment.socialImpact }}">
        </div>
        <div class="form-group">
            <label for="social_impact_details">Social impact details</label>
            <input type="text" id="social_impact_details" name="psychological_assessment.social_impact_details"
                   value="{{ psychological_assessment.socialImpactDetails }}">
        </div>
    </div>

    <div class="form-group">
        <label for="psychological_referral_needed">Psychological referral needed?</label>
        <select id="psychological_referral_needed" name="psychological_assessment.psychological_referral_needed">
            <option value="" {% if psychological_assessment.psychologicalReferralNeeded == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if psychological_assessment.psychologicalReferralNeeded == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if psychological_assessment.psychologicalReferralNeeded == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
</div>
