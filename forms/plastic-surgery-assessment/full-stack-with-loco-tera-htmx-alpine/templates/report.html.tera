{% extends "base.html.tera" %}

{% block title %}Assessment Report - {{ risk_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Plastic Surgery Assessment &mdash; Report</h1>
    <div class="risk-badge {{ risk_class }}">{{ risk_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>BMI:</strong> {{ data.demographics.bmi }}
        </div>
        <div>
            <strong>Referral:</strong> {{ data.reasonForReferral.referralType }}<br>
            <strong>Urgency:</strong> {{ data.reasonForReferral.urgency }}<br>
            <strong>Affected Area:</strong> {{ data.reasonForReferral.affectedBodyArea }}<br>
            <strong>Proposed Procedure:</strong> {{ data.procedurePlanningConsent.proposedProcedure }}
        </div>
    </div>
</div>

<!-- Classifications -->
<div class="card">
    <h2>Classifications</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Classification</th>
                <th>Value</th>
                <th>Label</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>ASA Physical Status</td>
                <td>{{ asa_class }}</td>
                <td>{{ asa_class_label }}</td>
            </tr>
            <tr>
                <td>Wound Class</td>
                <td>{{ wound_class }}</td>
                <td>{{ wound_class_label }}</td>
            </tr>
            <tr>
                <td>Surgical Complexity</td>
                <td>{{ complexity_score }}</td>
                <td>{{ complexity_label }}</td>
            </tr>
            <tr>
                <td>Overall Risk</td>
                <td>{{ overall_risk }}</td>
                <td>{{ risk_label }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Grading Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge grade-{{ rule.grade }}">{{ rule.grade }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Drug Allergies -->
{% if data.medicationsAllergies.allergies and data.medicationsAllergies.allergies | length > 0 %}
<div class="card">
    <h2>Drug Allergies ({{ data.medicationsAllergies.allergies | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Allergen</th>
                <th>Reaction</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for a in data.medicationsAllergies.allergies %}
            <tr>
                <td>{{ a.allergen }}</td>
                <td>{{ a.reaction }}</td>
                <td>{{ a.severity }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
