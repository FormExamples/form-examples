<div class="card">
    <h2>Step 5: Medication Review</h2>
    <p class="form-hint">
        Medication classes that contribute to fall risk. Polypharmacy is auto-detected
        from four or more rows in the list below or by explicit answer.
    </p>

    <h3>Current Medications</h3>
    <p class="form-hint">Add up to six medications.</p>

    {% for i in range(end=6) %}
    <fieldset class="team-member-row">
        <legend>Medication {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="medications_{{ i }}_name">Name</label>
                <input type="text" id="medications_{{ i }}_name" name="medications[{{ i }}].name"
                       value="{% if medication_review.medications | length > i %}{{ medication_review.medications[i].name }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_dose">Dose</label>
                <input type="text" id="medications_{{ i }}_dose" name="medications[{{ i }}].dose"
                       value="{% if medication_review.medications | length > i %}{{ medication_review.medications[i].dose }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_frequency">Frequency</label>
                <input type="text" id="medications_{{ i }}_frequency" name="medications[{{ i }}].frequency"
                       value="{% if medication_review.medications | length > i %}{{ medication_review.medications[i].frequency }}{% endif %}">
            </div>
        </div>
    </fieldset>
    {% endfor %}

    <h3>High-Risk Classes</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="polypharmacy">Polypharmacy reported?</label>
            <select id="polypharmacy" name="medication_review.polypharmacy">
                <option value="" {% if medication_review.polypharmacy == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.polypharmacy == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.polypharmacy == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sedatives_or_hypnotics">Sedatives or hypnotics?</label>
            <select id="sedatives_or_hypnotics" name="medication_review.sedatives_or_hypnotics">
                <option value="" {% if medication_review.sedativesOrHypnotics == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.sedativesOrHypnotics == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.sedativesOrHypnotics == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="antihypertensives">Antihypertensives?</label>
            <select id="antihypertensives" name="medication_review.antihypertensives">
                <option value="" {% if medication_review.antihypertensives == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.antihypertensives == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.antihypertensives == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="diuretics">Diuretics?</label>
            <select id="diuretics" name="medication_review.diuretics">
                <option value="" {% if medication_review.diuretics == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.diuretics == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.diuretics == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="anticoagulants">Anticoagulants?</label>
            <select id="anticoagulants" name="medication_review.anticoagulants">
                <option value="" {% if medication_review.anticoagulants == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.anticoagulants == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.anticoagulants == "yes" %}selected{% endif %}>Yes (Critical-override)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="opioids">Opioids?</label>
            <select id="opioids" name="medication_review.opioids">
                <option value="" {% if medication_review.opioids == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.opioids == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.opioids == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="antidepressants">Antidepressants?</label>
            <select id="antidepressants" name="medication_review.antidepressants">
                <option value="" {% if medication_review.antidepressants == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.antidepressants == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.antidepressants == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="antipsychotics">Antipsychotics?</label>
            <select id="antipsychotics" name="medication_review.antipsychotics">
                <option value="" {% if medication_review.antipsychotics == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.antipsychotics == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.antipsychotics == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="recent_medication_change">Recent medication change?</label>
            <select id="recent_medication_change" name="medication_review.recent_medication_change">
                <option value="" {% if medication_review.recentMedicationChange == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if medication_review.recentMedicationChange == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if medication_review.recentMedicationChange == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="medication_notes">Medication notes</label>
        <textarea id="medication_notes" name="medication_review.medication_notes">{{ medication_review.medicationNotes }}</textarea>
    </div>
</div>
