<div class="card">
    <h2>Step 2: Fall History</h2>
    <p class="form-hint">Prior falls in the last twelve months and surrounding circumstances.</p>

    <div class="form-group">
        <label for="has_fallen_in_past_year">Has the patient fallen in the past year?</label>
        <select id="has_fallen_in_past_year" name="fall_history.has_fallen_in_past_year">
            <option value="" {% if fall_history.hasFallenInPastYear == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if fall_history.hasFallenInPastYear == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if fall_history.hasFallenInPastYear == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="number_of_falls_past_year">Number of falls past year</label>
            <input type="number" min="0" id="number_of_falls_past_year"
                   name="fall_history.number_of_falls_past_year"
                   value="{{ fall_history.numberOfFallsPastYear }}">
        </div>
        <div class="form-group">
            <label for="last_fall_date">Date of last fall</label>
            <input type="date" id="last_fall_date" name="fall_history.last_fall_date"
                   value="{{ fall_history.lastFallDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="most_recent_fall_injurious">Was the most recent fall injurious?</label>
        <select id="most_recent_fall_injurious" name="fall_history.most_recent_fall_injurious">
            <option value="" {% if fall_history.mostRecentFallInjurious == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if fall_history.mostRecentFallInjurious == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if fall_history.mostRecentFallInjurious == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="most_recent_fall_injury_details">Injury details</label>
        <textarea id="most_recent_fall_injury_details"
                  name="fall_history.most_recent_fall_injury_details"
                  placeholder="Describe injury (if any)">{{ fall_history.mostRecentFallInjuryDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="recurrent_falls_with_injury">Recurrent falls with injury?</label>
        <select id="recurrent_falls_with_injury" name="fall_history.recurrent_falls_with_injury">
            <option value="" {% if fall_history.recurrentFallsWithInjury == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if fall_history.recurrentFallsWithInjury == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if fall_history.recurrentFallsWithInjury == "yes" %}selected{% endif %}>Yes (Critical-override)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fear_of_falling">Fear of falling?</label>
        <select id="fear_of_falling" name="fall_history.fear_of_falling">
            <option value="" {% if fall_history.fearOfFalling == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if fall_history.fearOfFalling == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if fall_history.fearOfFalling == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fall_circumstances">Fall circumstances</label>
        <textarea id="fall_circumstances" name="fall_history.fall_circumstances"
                  placeholder="Where, when, and how the fall(s) occurred">{{ fall_history.fallCircumstances }}</textarea>
    </div>
</div>
