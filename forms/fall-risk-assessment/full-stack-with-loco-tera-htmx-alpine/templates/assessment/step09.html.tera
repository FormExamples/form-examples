<div class="card">
    <h2>Step 9: Previous Interventions</h2>
    <p class="form-hint">Past fall-prevention referrals and care-process gaps.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="falls_clinic_referral">Falls-clinic referral?</label>
            <select id="falls_clinic_referral" name="previous_interventions.falls_clinic_referral">
                <option value="" {% if previous_interventions.fallsClinicReferral == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.fallsClinicReferral == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.fallsClinicReferral == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="physiotherapy_provided">Physiotherapy provided?</label>
            <select id="physiotherapy_provided" name="previous_interventions.physiotherapy_provided">
                <option value="" {% if previous_interventions.physiotherapyProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.physiotherapyProvided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.physiotherapyProvided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="occupational_therapy_provided">Occupational therapy provided?</label>
            <select id="occupational_therapy_provided" name="previous_interventions.occupational_therapy_provided">
                <option value="" {% if previous_interventions.occupationalTherapyProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.occupationalTherapyProvided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.occupationalTherapyProvided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="medication_review_completed">Medication review completed?</label>
            <select id="medication_review_completed" name="previous_interventions.medication_review_completed">
                <option value="" {% if previous_interventions.medicationReviewCompleted == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.medicationReviewCompleted == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.medicationReviewCompleted == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="home_safety_assessment">Home safety assessment?</label>
            <select id="home_safety_assessment" name="previous_interventions.home_safety_assessment">
                <option value="" {% if previous_interventions.homeSafetyAssessment == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.homeSafetyAssessment == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.homeSafetyAssessment == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="intervention_declined">Patient declined intervention?</label>
            <select id="intervention_declined" name="previous_interventions.intervention_declined">
                <option value="" {% if previous_interventions.interventionDeclined == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.interventionDeclined == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.interventionDeclined == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="missed_referral">Missed referral?</label>
            <select id="missed_referral" name="previous_interventions.missed_referral">
                <option value="" {% if previous_interventions.missedReferral == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if previous_interventions.missedReferral == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if previous_interventions.missedReferral == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="intervention_notes">Intervention notes</label>
        <textarea id="intervention_notes" name="previous_interventions.intervention_notes">{{ previous_interventions.interventionNotes }}</textarea>
    </div>
</div>
