<div class="card">
    <h2>Step 3: Morse Fall Scale</h2>
    <p class="form-hint">
        Six bedside items. Score ranges: 0&ndash;24 Low, 25&ndash;44 Moderate, &ge;45 High.
        Critical-override if recurrent falls with injury, anticoagulation, or MFS &ge;75.
    </p>

    <div class="form-group">
        <label for="mfs_history_of_falling">MFS-001 History of falling (last 3 months or current admission)</label>
        <select id="mfs_history_of_falling" name="mfs.history_of_falling">
            <option value="" {% if mfs.historyOfFalling is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.historyOfFalling == 0 %}selected{% endif %}>No (0)</option>
            <option value="25" {% if mfs.historyOfFalling == 25 %}selected{% endif %}>Yes (25)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mfs_secondary_diagnosis">MFS-002 Secondary diagnosis</label>
        <select id="mfs_secondary_diagnosis" name="mfs.secondary_diagnosis">
            <option value="" {% if mfs.secondaryDiagnosis is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.secondaryDiagnosis == 0 %}selected{% endif %}>No (0)</option>
            <option value="15" {% if mfs.secondaryDiagnosis == 15 %}selected{% endif %}>Yes (15)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mfs_ambulatory_aid">MFS-003 Ambulatory aid</label>
        <select id="mfs_ambulatory_aid" name="mfs.ambulatory_aid">
            <option value="" {% if mfs.ambulatoryAid is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.ambulatoryAid == 0 %}selected{% endif %}>None / bed rest / wheelchair / nurse (0)</option>
            <option value="15" {% if mfs.ambulatoryAid == 15 %}selected{% endif %}>Crutches / cane / walker (15)</option>
            <option value="30" {% if mfs.ambulatoryAid == 30 %}selected{% endif %}>Furniture (30)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mfs_iv_or_heparin_lock">MFS-004 IV / heparin lock</label>
        <select id="mfs_iv_or_heparin_lock" name="mfs.iv_or_heparin_lock">
            <option value="" {% if mfs.ivOrHeparinLock is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.ivOrHeparinLock == 0 %}selected{% endif %}>No (0)</option>
            <option value="20" {% if mfs.ivOrHeparinLock == 20 %}selected{% endif %}>Yes (20)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mfs_gait_transferring">MFS-005 Gait / transferring</label>
        <select id="mfs_gait_transferring" name="mfs.gait_transferring">
            <option value="" {% if mfs.gaitTransferring is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.gaitTransferring == 0 %}selected{% endif %}>Normal / bed rest / immobile (0)</option>
            <option value="10" {% if mfs.gaitTransferring == 10 %}selected{% endif %}>Weak (10)</option>
            <option value="20" {% if mfs.gaitTransferring == 20 %}selected{% endif %}>Impaired (20)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mfs_mental_status">MFS-006 Mental status</label>
        <select id="mfs_mental_status" name="mfs.mental_status">
            <option value="" {% if mfs.mentalStatus is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if mfs.mentalStatus == 0 %}selected{% endif %}>Oriented to own ability (0)</option>
            <option value="15" {% if mfs.mentalStatus == 15 %}selected{% endif %}>Forgets / overestimates ability (15)</option>
        </select>
    </div>
</div>
