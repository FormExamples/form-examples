<div class="card">
    <h2>Step 10: Fall Prevention Plan</h2>
    <p class="form-hint">Recommended interventions to mitigate fall risk.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="bed_alarm">Bed alarm?</label>
            <select id="bed_alarm" name="prevention_plan.bed_alarm">
                <option value="" {% if prevention_plan.bedAlarm == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.bedAlarm == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.bedAlarm == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="chair_alarm">Chair alarm?</label>
            <select id="chair_alarm" name="prevention_plan.chair_alarm">
                <option value="" {% if prevention_plan.chairAlarm == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.chairAlarm == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.chairAlarm == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="non_slip_footwear">Non-slip footwear?</label>
            <select id="non_slip_footwear" name="prevention_plan.non_slip_footwear">
                <option value="" {% if prevention_plan.nonSlipFootwear == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.nonSlipFootwear == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.nonSlipFootwear == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="hip_protectors_recommended">Hip protectors recommended?</label>
            <select id="hip_protectors_recommended" name="prevention_plan.hip_protectors_recommended">
                <option value="" {% if prevention_plan.hipProtectorsRecommended == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.hipProtectorsRecommended == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.hipProtectorsRecommended == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="exercise_programme">Exercise programme?</label>
            <select id="exercise_programme" name="prevention_plan.exercise_programme">
                <option value="" {% if prevention_plan.exerciseProgramme == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.exerciseProgramme == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.exerciseProgramme == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vitamin_d_supplement">Vitamin D supplement?</label>
            <select id="vitamin_d_supplement" name="prevention_plan.vitamin_d_supplement">
                <option value="" {% if prevention_plan.vitaminDSupplement == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.vitaminDSupplement == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.vitaminDSupplement == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="environmental_modifications">Environmental modifications?</label>
            <select id="environmental_modifications" name="prevention_plan.environmental_modifications">
                <option value="" {% if prevention_plan.environmentalModifications == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.environmentalModifications == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.environmentalModifications == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="medication_deprescribing">Medication deprescribing?</label>
            <select id="medication_deprescribing" name="prevention_plan.medication_deprescribing">
                <option value="" {% if prevention_plan.medicationDeprescribing == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.medicationDeprescribing == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.medicationDeprescribing == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="carer_education_provided">Carer education provided?</label>
            <select id="carer_education_provided" name="prevention_plan.carer_education_provided">
                <option value="" {% if prevention_plan.carerEducationProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prevention_plan.carerEducationProvided == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prevention_plan.carerEducationProvided == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="plan_notes">Plan notes</label>
        <textarea id="plan_notes" name="prevention_plan.plan_notes">{{ prevention_plan.planNotes }}</textarea>
    </div>
</div>
