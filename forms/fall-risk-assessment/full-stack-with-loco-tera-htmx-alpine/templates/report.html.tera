{% extends "base.html.tera" %}

{% block title %}Fall Risk Assessment Report - {{ severity_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Fall Risk Assessment &mdash; Report</h1>
    <div class="severity-badge {{ severity_class }}">{{ severity_label }}</div>
    <div class="checklist-label">Morse Fall Scale: {{ mfs_score }} / 125 &mdash; answered {{ answered_count }} / 6 items</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}
        </div>
        <div>
            <strong>Care Setting:</strong> {{ data.demographics.careSetting }}<br>
            <strong>Primary Diagnosis:</strong> {{ data.demographics.primaryDiagnosis }}
        </div>
    </div>
</div>

<!-- Critical Override -->
{% if critical_override %}
<div class="card">
    <h2>Critical Override</h2>
    <p class="form-hint">The base MFS severity was raised to <strong>Critical</strong> for the following reasons:</p>
    <ul>
        {% for r in critical_reasons %}
        <li>{{ r }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}

<!-- MFS Items -->
<div class="card">
    <h2>Morse Fall Scale Items ({{ fired_rules | length }} answered)</h2>
    {% if fired_rules | length > 0 %}
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Item</th>
                <th>Selected Option</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No MFS items have been answered yet.</p>
    {% endif %}
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
