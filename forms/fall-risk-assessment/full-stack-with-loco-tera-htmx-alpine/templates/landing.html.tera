{% extends "base.html.tera" %}

{% block title %}Fall Risk Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Fall Risk Assessment</h1>
        <p class="landing-description">
            Comprehensive fall-risk evaluation using the <strong>Morse Fall Scale (MFS)</strong>
            with additional medication, mobility, vision, environmental, cognitive, and
            intervention review. The output is a timestamped record with a severity grade
            (Low, Moderate, High, Critical) and prioritised safety flags to inform a
            fall-prevention plan.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Morse Fall Scale</h3>
                <p>Six bedside items scored 0&ndash;125. Cut-offs: 0&ndash;24 Low, 25&ndash;44 Moderate, &ge;45 High.</p>
            </div>
            <div class="feature">
                <h3>Critical-Override</h3>
                <p>Recurrent falls with injury, anticoagulation, or MFS &ge;75 lifts the severity to Critical.</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Prioritised clinical alerts spanning medications, vision, cognition, environment, and prior interventions.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
