#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding who-surgical-safety-checklist (4 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date \
    sex:string! \
    united_kingdom_nhs_number:string^ \
    medical_record_number:string \
    weight_as_kg:double \
    --api && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    employee_number:text! \
    united_kingdom_nhs_number:string^ \
    --api && \
cargo loco generate scaffold who_surgical_safety_checklist \
    deleted_at:ts \
    patient:references \
    surgeon:references \
    anaesthetist:references \
    lead_nurse:references \
    status:string! \
    site_name:string! \
    operating_room:string! \
    case_date:date \
    case_start_at:ts \
    case_end_at:ts \
    planned_procedure:string! \
    surgical_specialty:string! \
    urgency:string! \
    laterality:string! \
    is_paediatric:string! \
    abandoned_reason:string! \
    sign_in_identity_site_procedure_consent:string! \
    sign_in_site_marked:string! \
    sign_in_anaesthesia_check_complete:string! \
    sign_in_pulse_oximeter_on_patient:string! \
    sign_in_known_allergy:string! \
    sign_in_known_allergy_detail:string! \
    sign_in_difficult_airway_aspiration_risk:string! \
    sign_in_blood_loss_risk:string! \
    sign_in_coordinator:references \
    sign_in_completed_at:ts \
    time_out_team_introductions_confirmed:string! \
    time_out_patient_procedure_incision_confirmed:string! \
    time_out_antibiotic_prophylaxis_within_60min:string! \
    time_out_surgeon_critical_steps:string! \
    time_out_surgeon_case_duration_minutes:int \
    time_out_surgeon_anticipated_blood_loss_ml:int \
    time_out_anaesthetist_patient_concerns:string! \
    time_out_nursing_sterility_confirmed:string! \
    time_out_nursing_equipment_concerns:string! \
    time_out_essential_imaging_displayed:string! \
    time_out_coordinator:references \
    time_out_completed_at:ts \
    sign_out_procedure_name_confirmed:string! \
    sign_out_counts_confirmed:string! \
    sign_out_specimens_labelled:string! \
    sign_out_equipment_problems:string! \
    sign_out_recovery_concerns:string! \
    sign_out_coordinator:references \
    sign_out_completed_at:ts \
    --api && \
cargo loco generate scaffold team_member \
    deleted_at:ts \
    checklist:references \
    clinician:references \
    name:string! \
    role:string! \
    introduced_during_time_out:string! \
    notes:string! \
    --api

echo "Done."
