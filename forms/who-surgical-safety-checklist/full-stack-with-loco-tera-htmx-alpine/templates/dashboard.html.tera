{% extends "base.html.tera" %}

{% block title %}WHO Surgical Safety Checklist - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Operating-Team Dashboard</h1>
    <a href="/" class="btn btn-primary">New Checklist</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, NHS number, or procedure...">
    </div>
    <div class="form-group">
        <label for="checklist_status">Status</label>
        <select id="checklist_status" name="checklist_status">
            <option value="">All</option>
            <option value="not-started" {% if checklist_status == "not-started" %}selected{% endif %}>Not Started</option>
            <option value="in-progress" {% if checklist_status == "in-progress" %}selected{% endif %}>In Progress</option>
            <option value="sign-in-complete" {% if checklist_status == "sign-in-complete" %}selected{% endif %}>Sign In Complete</option>
            <option value="time-out-complete" {% if checklist_status == "time-out-complete" %}selected{% endif %}>Time Out Complete</option>
            <option value="complete" {% if checklist_status == "complete" %}selected{% endif %}>Complete</option>
            <option value="complete-with-concerns" {% if checklist_status == "complete-with-concerns" %}selected{% endif %}>Complete (with concerns)</option>
            <option value="abandoned" {% if checklist_status == "abandoned" %}selected{% endif %}>Abandoned</option>
        </select>
    </div>
    <div class="form-group">
        <label for="urgency">Urgency</label>
        <select id="urgency" name="urgency">
            <option value="">All</option>
            <option value="elective" {% if urgency == "elective" %}selected{% endif %}>Elective</option>
            <option value="urgent" {% if urgency == "urgent" %}selected{% endif %}>Urgent</option>
            <option value="emergency" {% if urgency == "emergency" %}selected{% endif %}>Emergency</option>
            <option value="immediate" {% if urgency == "immediate" %}selected{% endif %}>Immediate</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed checklist{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Case Date</th>
            <th>Site / OR</th>
            <th>Patient</th>
            <th>Procedure</th>
            <th>Urgency</th>
            <th>Surgeon</th>
            <th>Status</th>
            <th>Completion</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.caseDate }}</a></td>
            <td>{{ c.siteName }} / {{ c.operatingRoom }}</td>
            <td>{{ c.patientName }}<br><small>{{ c.patientNhsNumber }}</small></td>
            <td>{{ c.plannedProcedure }}<br><small>{{ c.surgicalSpecialty }}</small></td>
            <td>{{ c.urgency }}</td>
            <td>{{ c.surgeonName }}</td>
            <td><span class="checklist-badge checklist-{{ c.checklistStatus }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.checklistStatus }}</span></td>
            <td>{{ c.overallPercent }}%</td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed checklists found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
