<div class="card">
    <h2>Step 3: Time Out</h2>
    <p class="form-hint">
        Before skin incision. Required participants: <strong>nurse</strong>,
        <strong>anaesthetist</strong>, and <strong>surgeon</strong>. The whole
        operating team pauses for the time out.
    </p>

    <div class="form-group">
        <label for="time_out_team_introductions_confirmed">
            1. Confirm all team members have introduced themselves by name and role
        </label>
        <select id="time_out_team_introductions_confirmed" name="time_out.team_introductions_confirmed">
            <option value="" {% if time_out.teamIntroductionsConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if time_out.teamIntroductionsConfirmed == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="time_out_patient_procedure_incision_confirmed">
            2. Confirm the patient's name, procedure, and where the incision will be made
        </label>
        <select id="time_out_patient_procedure_incision_confirmed" name="time_out.patient_procedure_incision_confirmed">
            <option value="" {% if time_out.patientProcedureIncisionConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if time_out.patientProcedureIncisionConfirmed == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="time_out_antibiotic_prophylaxis_within_60min">
            3. Has antibiotic prophylaxis been given within the last 60 minutes?
        </label>
        <select id="time_out_antibiotic_prophylaxis_within_60min" name="time_out.antibiotic_prophylaxis_within_60min">
            <option value="" {% if time_out.antibioticProphylaxisWithin60min == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if time_out.antibioticProphylaxisWithin60min == "yes" %}selected{% endif %}>Yes</option>
            <option value="not-applicable" {% if time_out.antibioticProphylaxisWithin60min == "not-applicable" %}selected{% endif %}>Not applicable</option>
        </select>
    </div>

    <h3>Anticipated Critical Events &mdash; Surgeon</h3>
    <div class="form-group">
        <label for="time_out_surgeon_critical_steps">
            4. Critical or non-routine steps
        </label>
        <textarea id="time_out_surgeon_critical_steps" name="time_out.surgeon_critical_steps"
                  placeholder="Describe critical or non-routine steps">{{ time_out.surgeonCriticalSteps }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="time_out_surgeon_case_duration_minutes">5. Anticipated case duration (minutes)</label>
            <input type="number" min="0" id="time_out_surgeon_case_duration_minutes" name="time_out.surgeon_case_duration_minutes"
                   value="{{ time_out.surgeonCaseDurationMinutes }}">
        </div>
        <div class="form-group">
            <label for="time_out_surgeon_anticipated_blood_loss_ml">6. Anticipated blood loss (millilitres)</label>
            <input type="number" min="0" id="time_out_surgeon_anticipated_blood_loss_ml" name="time_out.surgeon_anticipated_blood_loss_ml"
                   value="{{ time_out.surgeonAnticipatedBloodLossMl }}">
        </div>
    </div>

    <h3>Anticipated Critical Events &mdash; Anaesthetist</h3>
    <div class="form-group">
        <label for="time_out_anaesthetist_patient_concerns">
            7. Patient-specific concerns
        </label>
        <textarea id="time_out_anaesthetist_patient_concerns" name="time_out.anaesthetist_patient_concerns"
                  placeholder="Anaesthetist concerns for this patient">{{ time_out.anaesthetistPatientConcerns }}</textarea>
    </div>

    <h3>Nursing Team</h3>
    <div class="form-group">
        <label for="time_out_nursing_sterility_confirmed">
            8. Has sterility (including indicator results) been confirmed?
        </label>
        <select id="time_out_nursing_sterility_confirmed" name="time_out.nursing_sterility_confirmed">
            <option value="" {% if time_out.nursingSterilityConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if time_out.nursingSterilityConfirmed == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="time_out_nursing_equipment_concerns">
            9. Are there any equipment issues or concerns?
        </label>
        <textarea id="time_out_nursing_equipment_concerns" name="time_out.nursing_equipment_concerns"
                  placeholder="Equipment issues or concerns from the nursing team">{{ time_out.nursingEquipmentConcerns }}</textarea>
    </div>

    <div class="form-group">
        <label for="time_out_essential_imaging_displayed">
            10. Is essential imaging displayed?
        </label>
        <select id="time_out_essential_imaging_displayed" name="time_out.essential_imaging_displayed">
            <option value="" {% if time_out.essentialImagingDisplayed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if time_out.essentialImagingDisplayed == "yes" %}selected{% endif %}>Yes</option>
            <option value="not-applicable" {% if time_out.essentialImagingDisplayed == "not-applicable" %}selected{% endif %}>Not applicable</option>
        </select>
    </div>

    <h3>Time Out coordinator sign-off</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="time_out_coordinator_name">Coordinator Name</label>
            <input type="text" id="time_out_coordinator_name" name="time_out.coordinator_name"
                   value="{{ time_out.coordinatorName }}">
        </div>
        <div class="form-group">
            <label for="time_out_coordinator_role">Coordinator Role</label>
            <input type="text" id="time_out_coordinator_role" name="time_out.coordinator_role"
                   value="{{ time_out.coordinatorRole }}" placeholder="e.g. Circulating Nurse">
        </div>
        <div class="form-group">
            <label for="time_out_completed_at">Signed Off At</label>
            <input type="datetime-local" id="time_out_completed_at" name="time_out.completed_at"
                   value="{{ time_out.completedAt }}">
        </div>
    </div>
</div>
