<div class="card">
    <h2>Step 1: Case Details</h2>
    <p class="form-hint">Patient identification, lead clinicians, and scheduling for the surgical case.</p>

    <h3>Patient</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="patient_name">Patient Name</label>
            <input type="text" id="patient_name" name="case_details.patient_name"
                   value="{{ case_details.patientName }}">
        </div>
        <div class="form-group">
            <label for="patient_date_of_birth">Date of Birth</label>
            <input type="date" id="patient_date_of_birth" name="case_details.patient_date_of_birth"
                   value="{{ case_details.patientDateOfBirth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_sex">Sex</label>
            <select id="patient_sex" name="case_details.patient_sex">
                <option value="" {% if case_details.patientSex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if case_details.patientSex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if case_details.patientSex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if case_details.patientSex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_nhs_number">NHS Number</label>
            <input type="text" id="patient_nhs_number" name="case_details.patient_nhs_number"
                   value="{{ case_details.patientNhsNumber }}" placeholder="e.g. 943 476 5919">
        </div>
        <div class="form-group">
            <label for="patient_medical_record_number">Medical Record Number</label>
            <input type="text" id="patient_medical_record_number" name="case_details.patient_medical_record_number"
                   value="{{ case_details.patientMedicalRecordNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_weight_as_kg">Weight (kg)</label>
            <input type="number" step="0.1" id="patient_weight_as_kg" name="case_details.patient_weight_as_kg"
                   value="{{ case_details.patientWeightAsKg }}" placeholder="Used for 7 ml/kg paediatric blood-loss threshold">
        </div>
        <div class="form-group">
            <label for="is_paediatric">Paediatric Patient?</label>
            <select id="is_paediatric" name="case_details.is_paediatric">
                <option value="" {% if case_details.isPaediatric == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if case_details.isPaediatric == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if case_details.isPaediatric == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <h3>Operating Team (Lead)</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="surgeon_name">Lead Surgeon</label>
            <input type="text" id="surgeon_name" name="case_details.surgeon_name"
                   value="{{ case_details.surgeonName }}">
        </div>
        <div class="form-group">
            <label for="anaesthetist_name">Lead Anaesthetist</label>
            <input type="text" id="anaesthetist_name" name="case_details.anaesthetist_name"
                   value="{{ case_details.anaesthetistName }}">
        </div>
        <div class="form-group">
            <label for="lead_nurse_name">Lead (Circulating) Nurse</label>
            <input type="text" id="lead_nurse_name" name="case_details.lead_nurse_name"
                   value="{{ case_details.leadNurseName }}">
        </div>
    </div>

    <h3>Scheduling</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="site_name">Site / Facility</label>
            <input type="text" id="site_name" name="case_details.site_name"
                   value="{{ case_details.siteName }}">
        </div>
        <div class="form-group">
            <label for="operating_room">Operating Room</label>
            <input type="text" id="operating_room" name="case_details.operating_room"
                   value="{{ case_details.operatingRoom }}" placeholder="e.g. OR 4">
        </div>
        <div class="form-group">
            <label for="case_date">Case Date</label>
            <input type="date" id="case_date" name="case_details.case_date"
                   value="{{ case_details.caseDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="case_start_at">Wheels-In / Induction</label>
            <input type="datetime-local" id="case_start_at" name="case_details.case_start_at"
                   value="{{ case_details.caseStartAt }}">
        </div>
        <div class="form-group">
            <label for="case_end_at">Wheels-Out</label>
            <input type="datetime-local" id="case_end_at" name="case_details.case_end_at"
                   value="{{ case_details.caseEndAt }}">
        </div>
    </div>

    <h3>Procedure</h3>
    <div class="form-group">
        <label for="planned_procedure">Planned Procedure</label>
        <input type="text" id="planned_procedure" name="case_details.planned_procedure"
               value="{{ case_details.plannedProcedure }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="surgical_specialty">Surgical Specialty</label>
            <input type="text" id="surgical_specialty" name="case_details.surgical_specialty"
                   value="{{ case_details.surgicalSpecialty }}">
        </div>
        <div class="form-group">
            <label for="urgency">Urgency (NCEPOD)</label>
            <select id="urgency" name="case_details.urgency">
                <option value="" {% if case_details.urgency == "" %}selected{% endif %}>&mdash;</option>
                <option value="elective" {% if case_details.urgency == "elective" %}selected{% endif %}>Elective</option>
                <option value="urgent" {% if case_details.urgency == "urgent" %}selected{% endif %}>Urgent</option>
                <option value="emergency" {% if case_details.urgency == "emergency" %}selected{% endif %}>Emergency</option>
                <option value="immediate" {% if case_details.urgency == "immediate" %}selected{% endif %}>Immediate</option>
            </select>
        </div>
        <div class="form-group">
            <label for="laterality">Laterality</label>
            <select id="laterality" name="case_details.laterality">
                <option value="" {% if case_details.laterality == "" %}selected{% endif %}>&mdash;</option>
                <option value="left" {% if case_details.laterality == "left" %}selected{% endif %}>Left</option>
                <option value="right" {% if case_details.laterality == "right" %}selected{% endif %}>Right</option>
                <option value="bilateral" {% if case_details.laterality == "bilateral" %}selected{% endif %}>Bilateral</option>
                <option value="midline" {% if case_details.laterality == "midline" %}selected{% endif %}>Midline</option>
                <option value="na" {% if case_details.laterality == "na" %}selected{% endif %}>Not applicable</option>
            </select>
        </div>
    </div>
</div>
