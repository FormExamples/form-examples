<div class="card">
    <h2>Step 2: Sign In</h2>
    <p class="form-hint">
        Before induction of anaesthesia. Required participants: at least the
        circulating <strong>nurse</strong> and <strong>anaesthetist</strong>.
    </p>

    <div class="form-group">
        <label for="sign_in_identity_site_procedure_consent">
            1. Has the patient confirmed his/her identity, site, procedure, and consent?
        </label>
        <select id="sign_in_identity_site_procedure_consent" name="sign_in.identity_site_procedure_consent">
            <option value="" {% if sign_in.identitySiteProcedureConsent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_in.identitySiteProcedureConsent == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_site_marked">2. Is the site marked?</label>
        <select id="sign_in_site_marked" name="sign_in.site_marked">
            <option value="" {% if sign_in.siteMarked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_in.siteMarked == "yes" %}selected{% endif %}>Yes</option>
            <option value="not-applicable" {% if sign_in.siteMarked == "not-applicable" %}selected{% endif %}>Not applicable (bilateral / midline)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_anaesthesia_check_complete">
            3. Is the anaesthesia machine and medication check complete?
        </label>
        <select id="sign_in_anaesthesia_check_complete" name="sign_in.anaesthesia_check_complete">
            <option value="" {% if sign_in.anaesthesiaCheckComplete == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_in.anaesthesiaCheckComplete == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_pulse_oximeter_on_patient">
            4. Is the pulse oximeter on the patient and functioning?
        </label>
        <select id="sign_in_pulse_oximeter_on_patient" name="sign_in.pulse_oximeter_on_patient">
            <option value="" {% if sign_in.pulseOximeterOnPatient == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_in.pulseOximeterOnPatient == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_known_allergy">5. Does the patient have a known allergy?</label>
        <select id="sign_in_known_allergy" name="sign_in.known_allergy">
            <option value="" {% if sign_in.knownAllergy == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if sign_in.knownAllergy == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if sign_in.knownAllergy == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_known_allergy_detail">Allergy detail (required when allergy = yes)</label>
        <textarea id="sign_in_known_allergy_detail" name="sign_in.known_allergy_detail"
                  placeholder="Describe allergens and reactions">{{ sign_in.knownAllergyDetail }}</textarea>
    </div>

    <div class="form-group">
        <label for="sign_in_difficult_airway_aspiration_risk">
            6. Difficult airway or aspiration risk?
        </label>
        <select id="sign_in_difficult_airway_aspiration_risk" name="sign_in.difficult_airway_aspiration_risk">
            <option value="" {% if sign_in.difficultAirwayAspirationRisk == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if sign_in.difficultAirwayAspirationRisk == "no" %}selected{% endif %}>No</option>
            <option value="yes-equipment-available" {% if sign_in.difficultAirwayAspirationRisk == "yes-equipment-available" %}selected{% endif %}>Yes &mdash; equipment and assistance available</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_in_blood_loss_risk">
            7. Risk of &gt; 500 ml blood loss (7 ml/kg in children)?
        </label>
        <select id="sign_in_blood_loss_risk" name="sign_in.blood_loss_risk">
            <option value="" {% if sign_in.bloodLossRisk == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if sign_in.bloodLossRisk == "no" %}selected{% endif %}>No</option>
            <option value="yes-two-ivs-and-fluids-planned" {% if sign_in.bloodLossRisk == "yes-two-ivs-and-fluids-planned" %}selected{% endif %}>Yes &mdash; two IVs / central access and fluids planned</option>
        </select>
    </div>

    <h3>Sign In coordinator sign-off</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="sign_in_coordinator_name">Coordinator Name</label>
            <input type="text" id="sign_in_coordinator_name" name="sign_in.coordinator_name"
                   value="{{ sign_in.coordinatorName }}" placeholder="Usually the circulating nurse">
        </div>
        <div class="form-group">
            <label for="sign_in_coordinator_role">Coordinator Role</label>
            <input type="text" id="sign_in_coordinator_role" name="sign_in.coordinator_role"
                   value="{{ sign_in.coordinatorRole }}" placeholder="e.g. Circulating Nurse">
        </div>
        <div class="form-group">
            <label for="sign_in_completed_at">Signed Off At</label>
            <input type="datetime-local" id="sign_in_completed_at" name="sign_in.completed_at"
                   value="{{ sign_in.completedAt }}">
        </div>
    </div>
</div>
