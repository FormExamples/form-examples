<div class="card">
    <h2>Step 4: Sign Out</h2>
    <p class="form-hint">
        Before the patient leaves the operating room. Required participants:
        <strong>nurse</strong>, <strong>anaesthetist</strong>, and <strong>surgeon</strong>.
        The nurse verbally confirms the items below with the team.
    </p>

    <div class="form-group">
        <label for="sign_out_procedure_name_confirmed">
            1. Nurse verbally confirms: name of the procedure recorded
        </label>
        <select id="sign_out_procedure_name_confirmed" name="sign_out.procedure_name_confirmed">
            <option value="" {% if sign_out.procedureNameConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_out.procedureNameConfirmed == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_out_counts_confirmed">
            2. Nurse verbally confirms: instrument, sponge, and needle counts
        </label>
        <select id="sign_out_counts_confirmed" name="sign_out.counts_confirmed">
            <option value="" {% if sign_out.countsConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_out.countsConfirmed == "yes" %}selected{% endif %}>Yes &mdash; counts correct</option>
            <option value="no" {% if sign_out.countsConfirmed == "no" %}selected{% endif %}>No &mdash; count discrepancy</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_out_specimens_labelled">
            3. Nurse verbally confirms: specimen labelling (read aloud, including patient name)
        </label>
        <select id="sign_out_specimens_labelled" name="sign_out.specimens_labelled">
            <option value="" {% if sign_out.specimensLabelled == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if sign_out.specimensLabelled == "yes" %}selected{% endif %}>Yes &mdash; correctly labelled</option>
            <option value="no" {% if sign_out.specimensLabelled == "no" %}selected{% endif %}>No &mdash; labelling concern</option>
            <option value="not-applicable" {% if sign_out.specimensLabelled == "not-applicable" %}selected{% endif %}>Not applicable (no specimen)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="sign_out_equipment_problems">
            4. Nurse verbally confirms: any equipment problems to be addressed
        </label>
        <textarea id="sign_out_equipment_problems" name="sign_out.equipment_problems"
                  placeholder="Equipment problems to be addressed (or leave blank if none)">{{ sign_out.equipmentProblems }}</textarea>
    </div>

    <div class="form-group">
        <label for="sign_out_recovery_concerns">
            5. To surgeon, anaesthetist, and nurse: key concerns for recovery and management of this patient
        </label>
        <textarea id="sign_out_recovery_concerns" name="sign_out.recovery_concerns"
                  placeholder="Key concerns for recovery and management of this patient">{{ sign_out.recoveryConcerns }}</textarea>
    </div>

    <h3>Sign Out coordinator sign-off</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="sign_out_coordinator_name">Coordinator Name</label>
            <input type="text" id="sign_out_coordinator_name" name="sign_out.coordinator_name"
                   value="{{ sign_out.coordinatorName }}">
        </div>
        <div class="form-group">
            <label for="sign_out_coordinator_role">Coordinator Role</label>
            <input type="text" id="sign_out_coordinator_role" name="sign_out.coordinator_role"
                   value="{{ sign_out.coordinatorRole }}" placeholder="e.g. Circulating Nurse">
        </div>
        <div class="form-group">
            <label for="sign_out_completed_at">Signed Off At</label>
            <input type="datetime-local" id="sign_out_completed_at" name="sign_out.completed_at"
                   value="{{ sign_out.completedAt }}">
        </div>
    </div>
</div>
