{% extends "base.html.tera" %}

{% block title %}Checklist Report - {{ checklist_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>WHO Surgical Safety Checklist &mdash; Case Report</h1>
    <div class="checklist-badge checklist-{{ checklist_status }}">{{ checklist_label }}</div>
    <div class="checklist-label">Overall completion: {{ overall_percent }}%</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Case Summary -->
<div class="card">
    <h2>Case Summary</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.caseDetails.patientName }}<br>
            <strong>Date of Birth:</strong> {{ data.caseDetails.patientDateOfBirth }}<br>
            <strong>NHS Number:</strong> {{ data.caseDetails.patientNhsNumber }}<br>
            <strong>Site:</strong> {{ data.caseDetails.siteName }} &mdash; OR {{ data.caseDetails.operatingRoom }}<br>
            <strong>Case Date:</strong> {{ data.caseDetails.caseDate }}
        </div>
        <div>
            <strong>Surgeon:</strong> {{ data.caseDetails.surgeonName }}<br>
            <strong>Anaesthetist:</strong> {{ data.caseDetails.anaesthetistName }}<br>
            <strong>Lead Nurse:</strong> {{ data.caseDetails.leadNurseName }}<br>
            <strong>Procedure:</strong> {{ data.caseDetails.plannedProcedure }}<br>
            <strong>Urgency:</strong> {{ data.caseDetails.urgency }}
        </div>
    </div>
</div>

<!-- Per-Phase Progress -->
<div class="card">
    <h2>Phase Progress</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Phase</th>
                <th>Items Answered</th>
                <th>Completion</th>
                <th>Coordinator Sign-Off</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Sign In <small>(before induction of anaesthesia)</small></td>
                <td>{{ sign_in_progress.answered }} / {{ sign_in_progress.total }}</td>
                <td>{{ sign_in_progress.percent }}%</td>
                <td>
                    {% if sign_in_progress.signedOff %}
                        <span class="badge badge-yes">{{ data.signIn.coordinatorName }} &mdash; {{ data.signIn.completedAt }}</span>
                    {% else %}
                        <span class="badge badge-no">Not signed off</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>Time Out <small>(before skin incision)</small></td>
                <td>{{ time_out_progress.answered }} / {{ time_out_progress.total }}</td>
                <td>{{ time_out_progress.percent }}%</td>
                <td>
                    {% if time_out_progress.signedOff %}
                        <span class="badge badge-yes">{{ data.timeOut.coordinatorName }} &mdash; {{ data.timeOut.completedAt }}</span>
                    {% else %}
                        <span class="badge badge-no">Not signed off</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td>Sign Out <small>(before patient leaves the OR)</small></td>
                <td>{{ sign_out_progress.answered }} / {{ sign_out_progress.total }}</td>
                <td>{{ sign_out_progress.percent }}%</td>
                <td>
                    {% if sign_out_progress.signedOff %}
                        <span class="badge badge-yes">{{ data.signOut.coordinatorName }} &mdash; {{ data.signOut.completedAt }}</span>
                    {% else %}
                        <span class="badge badge-no">Not signed off</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Operating-Team Roster -->
{% if data.teamMembers and data.teamMembers | length > 0 %}
<div class="card">
    <h2>Operating-Team Roster ({{ data.teamMembers | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>Introduced (Time Out)</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            {% for tm in data.teamMembers %}
            <tr>
                <td>{{ tm.name }}</td>
                <td>{{ tm.role }}</td>
                <td>{{ tm.introducedDuringTimeOut }}</td>
                <td>{{ tm.notes }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Unanswered items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Unanswered or Outstanding Items ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Phase</th>
                <th>Category</th>
                <th>Description</th>
                <th>Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.phase }}</td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="severity-badge severity-{{ rule.severity }}">{{ rule.severity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Checklist</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
