<div class="card">
    <h2>Step 1: Respondent</h2>
    <p class="form-hint">Identify yourself, the team or organisation being assessed, and the assessment period.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="respondent_name">Respondent Name</label>
            <input type="text" id="respondent_name" name="respondent.respondent_name"
                   value="{{ respondent.respondentName }}" placeholder="Leave blank for anonymous">
        </div>
        <div class="form-group">
            <label for="respondent_role">Role</label>
            <select id="respondent_role" name="respondent.respondent_role">
                <option value="" {% if respondent.respondentRole == "" %}selected{% endif %}>&mdash;</option>
                <option value="team-member" {% if respondent.respondentRole == "team-member" %}selected{% endif %}>Team member</option>
                <option value="team-lead" {% if respondent.respondentRole == "team-lead" %}selected{% endif %}>Team lead</option>
                <option value="scrum-master" {% if respondent.respondentRole == "scrum-master" %}selected{% endif %}>Scrum master</option>
                <option value="product-owner" {% if respondent.respondentRole == "product-owner" %}selected{% endif %}>Product owner</option>
                <option value="engineering-manager" {% if respondent.respondentRole == "engineering-manager" %}selected{% endif %}>Engineering manager</option>
                <option value="agile-coach" {% if respondent.respondentRole == "agile-coach" %}selected{% endif %}>Agile coach</option>
                <option value="executive-sponsor" {% if respondent.respondentRole == "executive-sponsor" %}selected{% endif %}>Executive sponsor</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="team">Team / Programme</label>
            <input type="text" id="team" name="respondent.team" value="{{ respondent.team }}">
        </div>
        <div class="form-group">
            <label for="organisation">Organisation</label>
            <input type="text" id="organisation" name="respondent.organisation" value="{{ respondent.organisation }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="assessment_date">Assessment Date</label>
            <input type="date" id="assessment_date" name="respondent.assessment_date" value="{{ respondent.assessmentDate }}">
        </div>
        <div class="form-group">
            <label for="assessment_period">Assessment Period</label>
            <input type="text" id="assessment_period" name="respondent.assessment_period"
                   value="{{ respondent.assessmentPeriod }}" placeholder="e.g. Q2 2026">
        </div>
        <div class="form-group">
            <label for="is_anonymous">Submit anonymously?</label>
            <select id="is_anonymous" name="respondent.is_anonymous">
                <option value="" {% if respondent.isAnonymous == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if respondent.isAnonymous == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if respondent.isAnonymous == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>
</div>
