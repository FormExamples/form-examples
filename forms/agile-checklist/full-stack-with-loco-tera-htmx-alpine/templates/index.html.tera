{% extends "base.html.tera" %}

{% block content %}
<header class="top">
  <h1>Agile Checklist</h1>
  <p>57 concrete behaviours across Teams, Stakeholders, and Practices — composite maturity level and coaching action plan. Server-rendered with axum + Tera, HTMX-driven partial swaps, Alpine.js local state.</p>
</header>

<main>
  <nav class="step-nav" aria-label="View" style="margin-bottom:4px">
    <a href="/" style="background:var(--color-brand);color:#fff;border-color:var(--color-brand)">Form</a>
    <a href="/dashboard">Dashboard</a>
  </nav>
  <nav class="step-nav" aria-label="Step navigation">
    <a href="#step-2">2. Teams</a>
    <a href="#step-3">3. Stakeholders</a>
    <a href="#step-4">4. Practices</a>
    <a href="#step-5">5. Summary</a>
  </nav>

  <section id="step-2" class="form-section">
    <h2>Step 2 — Teams (25 items)</h2>
    <p class="description">Concrete behaviours of the people doing the work — autonomy, collaboration, learning, finishing, and motivation. Answer Yes when the behaviour is reliably true today, No when it is not, and N/A when the item does not apply.</p>
    <div class="item-list">
      {% for item in teams_items %}
        {% set v = answers[item.id] | default(value="") %}
        <div class="item-row" data-id="{{ item.id }}">
          <code class="item-id">{{ item.id }}</code>
          <p class="item-text">{{ item.text }}</p>
          <div class="yesnona" role="radiogroup" aria-label="{{ item.id }}">
            {% for opt in ["yes", "no", "not-applicable"] %}
              <button type="button"
                role="radio"
                aria-checked="{% if v == opt %}true{% else %}false{% endif %}"
                class="yesnona-btn yesnona-{{ opt }}{% if v == opt %} checked{% endif %}"
                hx-post="/toggle"
                hx-vals='{"id":"{{ item.id }}","value":"{{ opt }}"}'
                hx-target="#summary-region"
                hx-swap="outerHTML"
              >{% if opt == "yes" %}Yes{% elif opt == "no" %}No{% else %}N/A{% endif %}</button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <section id="step-3" class="form-section">
    <h2>Step 3 — Stakeholders (14 items)</h2>
    <p class="description">Behaviours of sponsors, executives, and other people outside the team whose decisions shape what the team can do — trust, delegation, experimentation, communication.</p>
    <div class="item-list">
      {% for item in stakeholders_items %}
        {% set v = answers[item.id] | default(value="") %}
        <div class="item-row" data-id="{{ item.id }}">
          <code class="item-id">{{ item.id }}</code>
          <p class="item-text">{{ item.text }}</p>
          <div class="yesnona" role="radiogroup" aria-label="{{ item.id }}">
            {% for opt in ["yes", "no", "not-applicable"] %}
              <button type="button"
                role="radio"
                aria-checked="{% if v == opt %}true{% else %}false{% endif %}"
                class="yesnona-btn yesnona-{{ opt }}{% if v == opt %} checked{% endif %}"
                hx-post="/toggle"
                hx-vals='{"id":"{{ item.id }}","value":"{{ opt }}"}'
                hx-target="#summary-region"
                hx-swap="outerHTML"
              >{% if opt == "yes" %}Yes{% elif opt == "no" %}No{% else %}N/A{% endif %}</button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <section id="step-4" class="form-section">
    <h2>Step 4 — Practices (18 items)</h2>
    <p class="description">Operating practices that bind teams and stakeholders together — pace of decisions, focus on finished work, transparency, and scope discipline.</p>
    <div class="item-list">
      {% for item in practices_items %}
        {% set v = answers[item.id] | default(value="") %}
        <div class="item-row" data-id="{{ item.id }}">
          <code class="item-id">{{ item.id }}</code>
          <p class="item-text">{{ item.text }}</p>
          <div class="yesnona" role="radiogroup" aria-label="{{ item.id }}">
            {% for opt in ["yes", "no", "not-applicable"] %}
              <button type="button"
                role="radio"
                aria-checked="{% if v == opt %}true{% else %}false{% endif %}"
                class="yesnona-btn yesnona-{{ opt }}{% if v == opt %} checked{% endif %}"
                hx-post="/toggle"
                hx-vals='{"id":"{{ item.id }}","value":"{{ opt }}"}'
                hx-target="#summary-region"
                hx-swap="outerHTML"
              >{% if opt == "yes" %}Yes{% elif opt == "no" %}No{% else %}N/A{% endif %}</button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <section id="step-5" class="form-section">
    <h2>Step 5 — Summary, maturity &amp; submit</h2>
    {% include "_summary.html.tera" %}

    <form action="/submit" method="post" class="form-submit" hx-boost="false">
      <fieldset>
        <legend>Respondent (optional — leave blank to submit anonymously)</legend>
        <div class="field-grid cols-2">
          <label class="stacked">
            <span>Name</span>
            <input type="text" name="respondent" autocomplete="name" />
          </label>
          <label class="stacked">
            <span>Role</span>
            <select name="role">
              <option value="">—</option>
              <option value="team-member">Team member</option>
              <option value="team-lead">Team lead</option>
              <option value="scrum-master">Scrum master</option>
              <option value="product-owner">Product owner</option>
              <option value="engineering-manager">Engineering manager</option>
              <option value="agile-coach">Agile coach</option>
              <option value="executive-sponsor">Executive sponsor</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label class="stacked">
            <span>Team</span>
            <input type="text" name="team" autocomplete="organization" placeholder="Unnamed" />
          </label>
          <label class="stacked">
            <span>Organisation</span>
            <input type="text" name="organisation" placeholder="Self-hosted" />
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Action plan (optional)</legend>
        <div class="field-grid">
          <label class="stacked">
            <span>Top action 1</span>
            <input type="text" name="top_action_1" autocomplete="off" />
          </label>
          <label class="stacked">
            <span>Top action 2</span>
            <input type="text" name="top_action_2" autocomplete="off" />
          </label>
          <label class="stacked">
            <span>Top action 3</span>
            <input type="text" name="top_action_3" autocomplete="off" />
          </label>
          <label class="stacked">
            <span>Coach notes</span>
            <textarea name="coach_notes" rows="3"></textarea>
          </label>
          <label class="stacked">
            <span>Overall notes</span>
            <textarea name="overall_notes" rows="3"></textarea>
          </label>
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Submit and save to dashboard</button>
        <button
          type="button"
          class="btn"
          hx-post="/reset"
          hx-target="body"
          hx-swap="outerHTML"
        >Start over</button>
      </div>
    </form>
  </section>
</main>
{% endblock %}
