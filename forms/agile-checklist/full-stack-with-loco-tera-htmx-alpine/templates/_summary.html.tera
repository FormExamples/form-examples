{% set r = result %}
<div id="summary-region">
  <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"
    aria-valuenow="{{ ((r.answeredCount * 100) / total_items) | round }}">
    <div class="progress-bar-fill" style="width: {{ ((r.answeredCount * 100) / total_items) | round }}%"></div>
  </div>
  <p class="progress-text">{{ r.answeredCount }} of {{ total_items }} items answered</p>

  <div class="flag-banner maturity-{{ r.maturity }}">
    <p><strong>Composite maturity:</strong> {{ r.maturityLabel }}</p>
    <p><strong>Overall:</strong>
      {% if r.overallPercent %}{{ r.overallPercent | round }}% yes{% else %}— (insufficient data){% endif %}
    </p>
    <p><strong>Sections:</strong>
      Teams {% if r.teams.percent %}{{ r.teams.percent | round }}%{% else %}—{% endif %}
      ({{ r.teams.bandSlug }}) ·
      Stakeholders {% if r.stakeholders.percent %}{{ r.stakeholders.percent | round }}%{% else %}—{% endif %}
      ({{ r.stakeholders.bandSlug }}) ·
      Practices {% if r.practices.percent %}{{ r.practices.percent | round }}%{% else %}—{% endif %}
      ({{ r.practices.bandSlug }})
    </p>
    {% if r.additionalFlags | length > 0 %}
      <ul class="flag-list">
        {% for f in r.additionalFlags %}
          <li><strong>[{{ f.priority | upper }}]</strong> {{ f.description }} — {{ f.suggestedAction }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p>No operational flags raised.</p>
    {% endif %}
  </div>

  {% if r.firedRules | length > 0 %}
    <details>
      <summary>Fired coaching rules ({{ r.firedRules | length }})</summary>
      <ul class="flag-list">
        {% for rule in r.firedRules %}
          <li><code>{{ rule.ruleId }}</code> — {{ rule.description | default(value="(no coaching note)") }}</li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</div>
