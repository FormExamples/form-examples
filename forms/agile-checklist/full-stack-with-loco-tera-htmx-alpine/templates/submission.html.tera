{% extends "base.html.tera" %}

{% block title %}Submission {{ id }} — Agile Checklist{% endblock %}

{% block content %}
<style>
  .submission-back { display: inline-block; margin: 12px 0; color: var(--color-brand); text-decoration: none; }
  .submission-back:hover { text-decoration: underline; }
  table.items { width: 100%; border-collapse: collapse; font-size: 0.85rem;
    background: var(--color-card); margin-top: 4px; }
  table.items th, table.items td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0;
    text-align: left; vertical-align: top; }
  table.items th { background: #f1f5f9; }
  table.items tr.ans-yes td.ans { color: var(--color-high); font-weight: 600; }
  table.items tr.ans-no td.ans { color: var(--color-low); font-weight: 600; }
  table.items tr.ans-not-applicable td.ans { color: var(--color-muted); }
  table.items tr.ans-blank td.ans { color: var(--color-muted); }
  table.items td.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem; }
  dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px;
    font-size: 0.9rem; margin: 0 0 8px; }
  dl.meta dt { color: var(--color-muted); }
  dl.meta dd { margin: 0; }
</style>

<header class="top">
  <h1>Agile Checklist — Submission</h1>
  <p>Per-item drill-down for a single submission stored in SQLite.</p>
</header>

<main>
  <a href="/dashboard" class="submission-back">← Back to dashboard</a>

  {% if not found %}
    <p class="description">
      No submission found with id <code>{{ id }}</code>. It may have been
      cleared or the link is stale.
    </p>
  {% else %}
    {% set r = row %}
    <header style="margin-bottom: 12px">
      <h2 style="margin: 0 0 4px; color: var(--color-brand-dark)">
        {{ r.team }} <span style="color: #94a3b8">/</span> {{ r.organisation }}
      </h2>
      <p class="description" style="margin: 0">
        Submission <code>{{ r.id }}</code> · {{ r.date }}
      </p>
    </header>

    <div class="flag-banner maturity-{{ r.maturity }}">
      <p><strong>Composite maturity:</strong> {{ r.maturity | upper }}</p>
      <p>
        <strong>Overall:</strong>
        {% if r.overallPercent %}{{ r.overallPercent }}%{% else %}—{% endif %} ·
        <strong>Answered:</strong> {{ r.answered }} / 57
      </p>
      <p>
        <strong>Teams:</strong>
        {% if r.teamsPercent %}{{ r.teamsPercent }}%{% else %}—{% endif %} ·
        <strong>Stakeholders:</strong>
        {% if r.stakeholdersPercent %}{{ r.stakeholdersPercent }}%{% else %}—{% endif %} ·
        <strong>Practices:</strong>
        {% if r.practicesPercent %}{{ r.practicesPercent }}%{% else %}—{% endif %}
      </p>
    </div>

    <section class="form-section">
      <h3 style="margin-top: 0">Respondent</h3>
      <dl class="meta">
        <dt>Name</dt>
        <dd>{% if r.isAnonymous %}Anonymous 🔒{% else %}{{ r.respondent }}{% endif %}</dd>
        <dt>Role</dt>
        <dd>{% if r.isAnonymous %}—{% else %}{{ r.role | default(value="—") }}{% endif %}</dd>
        <dt>Team</dt>
        <dd>{{ r.team }}</dd>
        <dt>Organisation</dt>
        <dd>{{ r.organisation }}</dd>
      </dl>
    </section>

    <section class="form-section">
      <h3 style="margin-top: 0">Weak sections</h3>
      {% if r.weakSections | length == 0 %}
        <p class="description">No section flagged as weak.</p>
      {% else %}
        <ul class="flag-list">
          {% for s in r.weakSections %}<li>{{ s }}</li>{% endfor %}
        </ul>
      {% endif %}
    </section>

    <section class="form-section">
      <h3 style="margin-top: 0">Operational flags</h3>
      {% if r.flags | length == 0 %}
        <p class="description">No operational flags raised.</p>
      {% else %}
        <ul class="flag-list">
          {% for f in r.flags %}<li><code>{{ f }}</code></li>{% endfor %}
        </ul>
      {% endif %}
    </section>

    {% if has_plan %}
      <section class="form-section">
        <h3 style="margin-top: 0">Action plan</h3>
        {% if plan.topAction1 or plan.topAction2 or plan.topAction3 %}
          <ol style="margin: 4px 0 12px 20px; padding: 0; font-size: 0.9rem">
            {% if plan.topAction1 %}<li>{{ plan.topAction1 }}</li>{% endif %}
            {% if plan.topAction2 %}<li>{{ plan.topAction2 }}</li>{% endif %}
            {% if plan.topAction3 %}<li>{{ plan.topAction3 }}</li>{% endif %}
          </ol>
        {% endif %}
        {% if plan.coachNotes %}
          <h4 style="margin: 8px 0 4px; font-size: 0.85rem">Coach notes</h4>
          <p style="margin: 0 0 8px; font-size: 0.9rem; white-space: pre-line">{{ plan.coachNotes }}</p>
        {% endif %}
        {% if plan.overallNotes %}
          <h4 style="margin: 8px 0 4px; font-size: 0.85rem">Overall notes</h4>
          <p style="margin: 0; font-size: 0.9rem; white-space: pre-line">{{ plan.overallNotes }}</p>
        {% endif %}
      </section>
    {% endif %}

    <section class="form-section">
      <h3 style="margin-top: 0">Per-item answers</h3>
      {% if not has_answers %}
        <p class="description">
          No per-item answers were persisted with this submission (older rows
          may pre-date the answers-JSON column).
        </p>
      {% endif %}
      <table class="items">
        <thead>
          <tr>
            <th>ID</th>
            <th>Section</th>
            <th>Item</th>
            <th>Answer</th>
          </tr>
        </thead>
        <tbody>
          {% for ia in item_answers %}
            {% set cls = ia.answer | default(value="blank") %}
            <tr class="ans-{% if ia.answer %}{{ ia.answer }}{% else %}blank{% endif %}">
              <td class="mono">{{ ia.id }}</td>
              <td>{{ ia.section }}</td>
              <td>{{ ia.text }}</td>
              <td class="ans">{% if ia.answer %}{{ ia.answer | upper }}{% else %}—{% endif %}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% endif %}
</main>
{% endblock %}
