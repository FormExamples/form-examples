{% extends "base.html.tera" %}

{% block title %}Agile Checklist - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Agile Checklist Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Respondent, team, or organisation...">
    </div>
    <div class="form-group">
        <label for="maturity">Maturity</label>
        <select id="maturity" name="maturity">
            <option value="">All</option>
            <option value="optimising" {% if maturity == "optimising" %}selected{% endif %}>Optimising</option>
            <option value="mature" {% if maturity == "mature" %}selected{% endif %}>Mature</option>
            <option value="developing" {% if maturity == "developing" %}selected{% endif %}>Developing</option>
            <option value="initial" {% if maturity == "initial" %}selected{% endif %}>Initial</option>
            <option value="ad-hoc" {% if maturity == "ad-hoc" %}selected{% endif %}>Ad-hoc</option>
            <option value="insufficient-data" {% if maturity == "insufficient-data" %}selected{% endif %}>Insufficient data</option>
        </select>
    </div>
    <div class="form-group">
        <label for="role">Role</label>
        <select id="role" name="role">
            <option value="">All</option>
            <option value="team-member" {% if role == "team-member" %}selected{% endif %}>Team member</option>
            <option value="team-lead" {% if role == "team-lead" %}selected{% endif %}>Team lead</option>
            <option value="scrum-master" {% if role == "scrum-master" %}selected{% endif %}>Scrum master</option>
            <option value="product-owner" {% if role == "product-owner" %}selected{% endif %}>Product owner</option>
            <option value="engineering-manager" {% if role == "engineering-manager" %}selected{% endif %}>Engineering manager</option>
            <option value="agile-coach" {% if role == "agile-coach" %}selected{% endif %}>Agile coach</option>
            <option value="executive-sponsor" {% if role == "executive-sponsor" %}selected{% endif %}>Executive sponsor</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-priority flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Respondent</th>
            <th>Team / Org</th>
            <th>Period</th>
            <th>Maturity</th>
            <th>Overall</th>
            <th>Teams</th>
            <th>Stakeholders</th>
            <th>Practices</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for a in assessments %}
        <tr>
            <td><a href="/assessment/{{ a.id }}/report">{{ a.assessmentDate }}</a></td>
            <td>{{ a.respondentName }}<br><small>{{ a.respondentRole }}</small></td>
            <td>{{ a.team }}<br><small>{{ a.organisation }}</small></td>
            <td>{{ a.assessmentPeriod }}</td>
            <td><span class="checklist-badge checklist-{{ a.maturity }}">{{ a.maturityLabel }}</span></td>
            <td>{% if a.overallPercent %}{{ a.overallPercent }}%{% else %}&mdash;{% endif %}</td>
            <td>{% if a.teamsPercent %}{{ a.teamsPercent }}%{% else %}&mdash;{% endif %}</td>
            <td>{% if a.stakeholdersPercent %}{{ a.stakeholdersPercent }}%{% else %}&mdash;{% endif %}</td>
            <td>{% if a.practicesPercent %}{{ a.practicesPercent }}%{% else %}&mdash;{% endif %}</td>
            <td>
                {% if a.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ a.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
