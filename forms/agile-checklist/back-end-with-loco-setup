#!/bin/sh
set -euf

form_kebab_case=agile-checklist
form_snake_case=agile_checklist

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold respondent \
    deleted_at:tstz \
    full_name:string! \
    email:string! \
    role:string! \
    team_name:string! \
    organisation_name:string! \
    years_in_agile:int \
    --api

cargo loco generate scaffold agile_checklist \
    deleted_at:tstz \
    respondent:references \
    status:string! \
    assessment_date:date \
    assessment_period:string! \
    t01_problems_to_solve:string! \
    t02_decisions_without_manager:string! \
    t03_adopt_and_improve_practices:string! \
    t04_actively_coordinate:string! \
    t05_openly_share_ideas:string! \
    t06_decide_how_to_execute:string! \
    t07_act_on_feedback:string! \
    t08_rarely_wait:string! \
    t09_fully_complete_work:string! \
    t10_manage_own_performance:string! \
    t11_understand_agile:string! \
    t12_high_quality:string! \
    t13_welcome_change:string! \
    t14_collaborate_to_finish:string! \
    t15_admit_mistakes:string! \
    t16_work_outside_specialty:string! \
    t17_seek_new_skills:string! \
    t18_improve_skills:string! \
    t19_improve_ways_of_working:string! \
    t20_various_ways_communicating:string! \
    t21_received_basic_training:string! \
    t22_safe_to_dissent:string! \
    t23_start_with_open_issues:string! \
    t24_motivated:string! \
    t25_pride_in_craft:string! \
    s01_know_priority_factors:string! \
    s02_accept_plan_ranges:string! \
    s03_accept_plan_changes:string! \
    s04_evaluate_product:string! \
    s05_champion_agile:string! \
    s06_respect_quality:string! \
    s07_delegate_authority:string! \
    s08_keep_authority_delegated:string! \
    s09_support_experiments:string! \
    s10_no_punish_experiments:string! \
    s11_communicate_agile_goals:string! \
    s12_encourage_new_skills:string! \
    s13_encourage_new_ways:string! \
    s14_develop_people:string! \
    p01_early_good_release:string! \
    p02_educated_sponsor:string! \
    p03_quick_decisions:string! \
    p04_plans_data_based:string! \
    p05_proactive_dependencies:string! \
    p06_good_intentions:string! \
    p07_reciprocal_trust:string! \
    p08_docs_plus_conversations:string! \
    p09_update_plans:string! \
    p10_non_punitive:string! \
    p11_outside_groups_aware:string! \
    p12_finished_over_wip:string! \
    p13_quality_over_deadline:string! \
    p14_solution_over_blame:string! \
    p15_change_agents_in_place:string! \
    p16_agile_beyond_origin:string! \
    p17_one_team:string! \
    p18_honor_commitments:string! \
    overall_notes:text! \
    --api

cargo loco generate scaffold agile_checklist_grade \
    deleted_at:tstz \
    agile_checklist:references \
    answered_count:int! \
    teams_yes_count:int! \
    teams_applicable_count:int! \
    teams_percent:double \
    stakeholders_yes_count:int! \
    stakeholders_applicable_count:int! \
    stakeholders_percent:double \
    practices_yes_count:int! \
    practices_applicable_count:int! \
    practices_percent:double \
    overall_percent:double \
    teams_band:string! \
    stakeholders_band:string! \
    practices_band:string! \
    maturity:string! \
    top_action_1:string! \
    top_action_2:string! \
    top_action_3:string! \
    coach_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold agile_checklist_grade_rule \
    deleted_at:tstz \
    agile_checklist_grade:references \
    rule_id:string! \
    section:string! \
    band:string! \
    description:string! \
    --api

cargo loco generate scaffold agile_checklist_grade_flag \
    deleted_at:tstz \
    agile_checklist_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    section:string! \
    triggering_items:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
