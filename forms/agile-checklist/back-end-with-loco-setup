    top_action_1:string! \
    top_action_2:string! \
    top_action_3:string! \
    coach_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold agile_checklist_grade_rule \
    deleted_at:ts \
    agile_checklist_grade:references \
    rule_id:string! \
    section:string! \
    band:string! \
    description:string! \
    --api && \
cargo loco generate scaffold agile_checklist_grade_flag \
    deleted_at:ts \
    agile_checklist_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    section:string! \
    triggering_items:string! \
    description:string! \
