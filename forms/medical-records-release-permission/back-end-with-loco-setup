#!/bin/sh
set -euf

form_kebab_case=medical-records-release-permission
form_snake_case=medical_records_release_permission

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold release_form \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold authorized_recipient \
    deleted_at:tstz \
    release_form:references \
    recipient_name:string! \
    recipient_organization:string! \
    recipient_address:text! \
    recipient_phone:string! \
    recipient_email:string! \
    recipient_role:string! \
    --api

cargo loco generate scaffold records_to_release \
    deleted_at:tstz \
    release_form:references \
    record_types:text! \
    specific_date_range:string! \
    date_from:date \
    date_to:date \
    specific_record_details:text! \
    --api

cargo loco generate scaffold purpose_of_release \
    deleted_at:tstz \
    release_form:references \
    purpose:string! \
    other_details:text! \
    --api

cargo loco generate scaffold authorization_period \
    deleted_at:tstz \
    release_form:references \
    start_date:date! \
    end_date:date! \
    single_use:string! \
    --api

cargo loco generate scaffold restrictions_limitations \
    deleted_at:tstz \
    release_form:references \
    exclude_hiv:string! \
    exclude_substance_abuse:string! \
    exclude_mental_health:string! \
    exclude_genetic_info:string! \
    exclude_sti:string! \
    additional_restrictions:text! \
    --api

cargo loco generate scaffold patient_rights \
    deleted_at:tstz \
    release_form:references \
    acknowledged_right_to_revoke:string! \
    acknowledged_no_charge_for_access:string! \
    acknowledged_data_protection:string! \
    --api

cargo loco generate scaffold signature_consent \
    deleted_at:tstz \
    release_form:references \
    patient_signature_confirmed:string! \
    signature_date:date \
    witness_name:string! \
    witness_signature_confirmed:string! \
    witness_date:date \
    parent_guardian_name:string! \
    --api

cargo loco generate scaffold validation_result \
    deleted_at:tstz \
    release_form:references \
    completeness_score:int! \
    completeness_status:string! \
    validation_status:string! \
    validated_at:tstz \
    --api

cargo loco generate scaffold validation_fired_rule \
    deleted_at:tstz \
    validation_result:references \
    rule_id:string! \
    domain:string! \
    description:text! \
    score:int! \
    --api

cargo loco generate scaffold validation_additional_flag \
    deleted_at:tstz \
    validation_result:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
