{% extends "base.html.tera" %}

{% block title %}Obstetrics Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Maternity Team Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient first or last name...">
    </div>
    <div class="form-group">
        <label for="risk_level">Risk Level</label>
        <select id="risk_level" name="risk_level">
            <option value="">All</option>
            <option value="low" {% if risk_level == "low" %}selected{% endif %}>Low</option>
            <option value="moderate" {% if risk_level == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="high" {% if risk_level == "high" %}selected{% endif %}>High</option>
        </select>
    </div>
    <div class="form-group">
        <label for="care_pathway">Care Pathway</label>
        <select id="care_pathway" name="care_pathway">
            <option value="">All</option>
            <option value="midwifery-led" {% if care_pathway == "midwifery-led" %}selected{% endif %}>Midwifery-led</option>
            <option value="obstetric-led" {% if care_pathway == "obstetric-led" %}selected{% endif %}>Obstetric-led</option>
            <option value="multidisciplinary" {% if care_pathway == "multidisciplinary" %}selected{% endif %}>Multidisciplinary</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Urgent / High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Booking</th>
            <th>EDD</th>
            <th>Gestation (wks)</th>
            <th>BMI</th>
            <th>Risk</th>
            <th>Care Pathway</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.firstName }} {{ c.lastName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.bookingDate }}</td>
            <td>{{ c.estimatedDueDate }}</td>
            <td>{% if c.gestationWeeks %}{{ c.gestationWeeks }}{% endif %}</td>
            <td>{% if c.bmi %}{{ c.bmi }}{% endif %}</td>
            <td><span class="badge risk-{{ c.riskLevel }}">{{ c.riskLevel }}</span></td>
            <td>{{ c.recommendedCarePathway }}</td>
            <td>
                {% if c.urgentFlagCount > 0 %}<span class="badge badge-no">{{ c.urgentFlagCount }} urgent</span>{% endif %}
                {% if c.highFlagCount > 0 %}<span class="badge badge-no">{{ c.highFlagCount }} high</span>{% endif %}
                {% if c.urgentFlagCount == 0 and c.highFlagCount == 0 %}<span class="badge badge-yes">0</span>{% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
