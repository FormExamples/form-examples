<div class="card">
    <h2>Step 8: Fetal Assessment</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="fundal_height">Fundal Height (cm)</label>
            <input type="number" step="0.1" id="fundal_height" name="fetal_assessment.fundal_height"
                   value="{% if fetal_assessment.fundalHeight %}{{ fetal_assessment.fundalHeight }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="fetal_heart_rate">Fetal Heart Rate (bpm)</label>
            <input type="number" id="fetal_heart_rate" name="fetal_assessment.fetal_heart_rate"
                   value="{% if fetal_assessment.fetalHeartRate %}{{ fetal_assessment.fetalHeartRate }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="fetal_lie">Fetal Lie</label>
            <input type="text" id="fetal_lie" name="fetal_assessment.fetal_lie"
                   value="{{ fetal_assessment.fetalLie }}">
        </div>
        <div class="form-group">
            <label for="fetal_presentation">Fetal Presentation</label>
            <input type="text" id="fetal_presentation" name="fetal_assessment.fetal_presentation"
                   value="{{ fetal_assessment.fetalPresentation }}">
        </div>
        <div class="form-group">
            <label for="engaged">Engaged?</label>
            <select id="engaged" name="fetal_assessment.engaged">
                <option value="" {% if fetal_assessment.engaged == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if fetal_assessment.engaged == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if fetal_assessment.engaged == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="fetal_movements_reported">Fetal Movements Reported</label>
            <input type="text" id="fetal_movements_reported" name="fetal_assessment.fetal_movements_reported"
                   value="{{ fetal_assessment.fetalMovementsReported }}">
        </div>
        <div class="form-group">
            <label for="reduced_fetal_movements">Reduced Fetal Movements?</label>
            <select id="reduced_fetal_movements" name="fetal_assessment.reduced_fetal_movements">
                <option value="" {% if fetal_assessment.reducedFetalMovements == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if fetal_assessment.reducedFetalMovements == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if fetal_assessment.reducedFetalMovements == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="growth_concern">Growth Concern?</label>
            <select id="growth_concern" name="fetal_assessment.growth_concern">
                <option value="" {% if fetal_assessment.growthConcern == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if fetal_assessment.growthConcern == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if fetal_assessment.growthConcern == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="growth_concern_details">Growth Concern Details</label>
        <textarea id="growth_concern_details" name="fetal_assessment.growth_concern_details">{{ fetal_assessment.growthConcernDetails }}</textarea>
    </div>
    <div class="form-group">
        <label for="fetal_notes">Fetal Notes</label>
        <textarea id="fetal_notes" name="fetal_assessment.fetal_notes">{{ fetal_assessment.fetalNotes }}</textarea>
    </div>
</div>
