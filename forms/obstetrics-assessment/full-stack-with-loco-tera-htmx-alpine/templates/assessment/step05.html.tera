<div class="card">
    <h2>Step 5: Lifestyle &amp; Social Factors</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="smoking_status">Smoking Status</label>
            <select id="smoking_status" name="lifestyle_social_factors.smoking_status">
                <option value="" {% if lifestyle_social_factors.smokingStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="never" {% if lifestyle_social_factors.smokingStatus == "never" %}selected{% endif %}>Never</option>
                <option value="ex" {% if lifestyle_social_factors.smokingStatus == "ex" %}selected{% endif %}>Ex-smoker</option>
                <option value="current" {% if lifestyle_social_factors.smokingStatus == "current" %}selected{% endif %}>Current</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cigarettes_per_day">Cigarettes per day</label>
            <input type="number" id="cigarettes_per_day" name="lifestyle_social_factors.cigarettes_per_day"
                   value="{% if lifestyle_social_factors.cigarettesPerDay %}{{ lifestyle_social_factors.cigarettesPerDay }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="alcohol_use">Alcohol Use</label>
            <select id="alcohol_use" name="lifestyle_social_factors.alcohol_use">
                <option value="" {% if lifestyle_social_factors.alcoholUse == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if lifestyle_social_factors.alcoholUse == "none" %}selected{% endif %}>None</option>
                <option value="occasional" {% if lifestyle_social_factors.alcoholUse == "occasional" %}selected{% endif %}>Occasional</option>
                <option value="regular" {% if lifestyle_social_factors.alcoholUse == "regular" %}selected{% endif %}>Regular</option>
            </select>
        </div>
        <div class="form-group">
            <label for="substance_use">Substance Use</label>
            <select id="substance_use" name="lifestyle_social_factors.substance_use">
                <option value="" {% if lifestyle_social_factors.substanceUse == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if lifestyle_social_factors.substanceUse == "none" %}selected{% endif %}>None</option>
                <option value="occasional" {% if lifestyle_social_factors.substanceUse == "occasional" %}selected{% endif %}>Occasional</option>
                <option value="regular" {% if lifestyle_social_factors.substanceUse == "regular" %}selected{% endif %}>Regular</option>
            </select>
        </div>
    </div>

    {% set yn = ["domestic_abuse","safeguarding_concerns","housing_insecurity","financial_difficulty","requires_interpreter","asylum_or_refugee","female_genital_mutilation"] %}
    {% set yn_c = ["domesticAbuse","safeguardingConcerns","housingInsecurity","financialDifficulty","requiresInterpreter","asylumOrRefugee","femaleGenitalMutilation"] %}
    {% set yn_l = ["Domestic abuse","Safeguarding concerns","Housing insecurity","Financial difficulty","Requires interpreter","Asylum seeker / refugee","FGM disclosed"] %}

    {% for i in range(end=7) %}
    <div class="form-group">
        <label>{{ yn_l[i] }}</label>
        <select name="lifestyle_social_factors.{{ yn[i] }}">
            {% set v = lifestyle_social_factors[yn_c[i]] %}
            <option value="" {% if v == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="interpreter_language">Interpreter Language</label>
        <input type="text" id="interpreter_language" name="lifestyle_social_factors.interpreter_language"
               value="{{ lifestyle_social_factors.interpreterLanguage }}">
    </div>

    <div class="form-group">
        <label for="social_notes">Social Notes</label>
        <textarea id="social_notes" name="lifestyle_social_factors.social_notes">{{ lifestyle_social_factors.socialNotes }}</textarea>
    </div>
</div>
