<div class="card">
    <h2>Step 2: Obstetric History</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="gravidity">Gravidity</label>
            <input type="number" id="gravidity" name="obstetric_history.gravidity"
                   value="{% if obstetric_history.gravidity %}{{ obstetric_history.gravidity }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="parity">Parity</label>
            <input type="number" id="parity" name="obstetric_history.parity"
                   value="{% if obstetric_history.parity %}{{ obstetric_history.parity }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="previous_miscarriages">Previous Miscarriages</label>
            <input type="number" id="previous_miscarriages" name="obstetric_history.previous_miscarriages"
                   value="{% if obstetric_history.previousMiscarriages %}{{ obstetric_history.previousMiscarriages }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="previous_stillbirths">Previous Stillbirths</label>
            <input type="number" id="previous_stillbirths" name="obstetric_history.previous_stillbirths"
                   value="{% if obstetric_history.previousStillbirths %}{{ obstetric_history.previousStillbirths }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="previous_neonatal_deaths">Previous Neonatal Deaths</label>
            <input type="number" id="previous_neonatal_deaths" name="obstetric_history.previous_neonatal_deaths"
                   value="{% if obstetric_history.previousNeonatalDeaths %}{{ obstetric_history.previousNeonatalDeaths }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="previous_terminations">Previous Terminations</label>
            <input type="number" id="previous_terminations" name="obstetric_history.previous_terminations"
                   value="{% if obstetric_history.previousTerminations %}{{ obstetric_history.previousTerminations }}{% endif %}">
        </div>
    </div>

    {% set yesno = ["previous_preterm_birth","previous_pre_eclampsia","previous_gestational_diabetes","previous_caesarean","previous_shoulder_dystocia","previous_postpartum_haemorrhage","previous_large_baby","previous_small_baby","previous_congenital_anomaly"] %}
    {% set yesno_camel = ["previousPretermBirth","previousPreEclampsia","previousGestationalDiabetes","previousCaesarean","previousShoulderDystocia","previousPostpartumHaemorrhage","previousLargeBaby","previousSmallBaby","previousCongenitalAnomaly"] %}
    {% set yesno_label = ["Previous preterm birth","Previous pre-eclampsia","Previous gestational diabetes","Previous caesarean","Previous shoulder dystocia","Previous postpartum haemorrhage","Previous large baby","Previous small baby","Previous congenital anomaly"] %}

    {% for i in range(end=9) %}
    <div class="form-group">
        <label>{{ yesno_label[i] }}</label>
        <select name="obstetric_history.{{ yesno[i] }}">
            {% set v = obstetric_history[yesno_camel[i]] %}
            <option value="" {% if v == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="previous_caesarean_count">Previous Caesarean Count</label>
        <input type="number" id="previous_caesarean_count" name="obstetric_history.previous_caesarean_count"
               value="{% if obstetric_history.previousCaesareanCount %}{{ obstetric_history.previousCaesareanCount }}{% endif %}">
    </div>

    <div class="form-group">
        <label for="obstetric_notes">Notes</label>
        <textarea id="obstetric_notes" name="obstetric_history.obstetric_notes">{{ obstetric_history.obstetricNotes }}</textarea>
    </div>
</div>
