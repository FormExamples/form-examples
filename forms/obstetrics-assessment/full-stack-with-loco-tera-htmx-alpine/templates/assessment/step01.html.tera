<div class="card">
    <h2>Step 1: Maternal Demographics</h2>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="maternal_demographics.first_name"
                   value="{{ maternal_demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="maternal_demographics.last_name"
                   value="{{ maternal_demographics.lastName }}">
        </div>
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="maternal_demographics.date_of_birth"
                   value="{{ maternal_demographics.dateOfBirth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="age_at_booking">Age at Booking</label>
            <input type="number" id="age_at_booking" name="maternal_demographics.age_at_booking"
                   value="{% if maternal_demographics.ageAtBooking %}{{ maternal_demographics.ageAtBooking }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ethnicity">Ethnicity</label>
            <input type="text" id="ethnicity" name="maternal_demographics.ethnicity"
                   value="{{ maternal_demographics.ethnicity }}">
        </div>
        <div class="form-group">
            <label for="occupation">Occupation</label>
            <input type="text" id="occupation" name="maternal_demographics.occupation"
                   value="{{ maternal_demographics.occupation }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="weight">Weight (kg)</label>
            <input type="number" step="0.1" id="weight" name="maternal_demographics.weight"
                   value="{% if maternal_demographics.weight %}{{ maternal_demographics.weight }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="height">Height (cm)</label>
            <input type="number" step="0.1" id="height" name="maternal_demographics.height"
                   value="{% if maternal_demographics.height %}{{ maternal_demographics.height }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="bmi">BMI</label>
            <input type="number" step="0.1" id="bmi" name="maternal_demographics.bmi"
                   value="{% if maternal_demographics.bmi %}{{ maternal_demographics.bmi }}{% endif %}">
        </div>
    </div>

    <div class="form-group">
        <label for="partner_status">Partner Status</label>
        <input type="text" id="partner_status" name="maternal_demographics.partner_status"
               value="{{ maternal_demographics.partnerStatus }}">
    </div>
</div>
