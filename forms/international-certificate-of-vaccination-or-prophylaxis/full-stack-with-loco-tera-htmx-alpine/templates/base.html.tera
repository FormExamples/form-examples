<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}International Certificate of Vaccination or Prophylaxis{% endblock %}</title>
  <link rel="stylesheet" href="/static/app.css" />
  <script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body hx-boost="true">
  <header class="topbar">
    <strong>International Certificate of Vaccination or Prophylaxis</strong>
    <span>WHO IHR 2005 Annex 6 — yellow card</span>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer>
    <small>Server-rendered by Loco / axum / Tera / HTMX / Alpine.js</small>
  </footer>
</body>
</html>
