<h2>Step 1 — Centre &amp; clinician</h2>
<fieldset>
  <legend>Issuing centre</legend>
  <label>Centre name <input name="centre_name" required /></label>
  <label>WHO designation reference <input name="who_designation_reference" /></label>
  <label>Country (ISO 3166-1 alpha-3) <input name="centre_country_alpha_3" maxlength="3" /></label>
  <label>Uniform stamp <input type="file" name="uniform_stamp" accept="image/*" /></label>
</fieldset>
<fieldset>
  <legend>Supervising clinician</legend>
  <label>Name <input name="clinician_name" required /></label>
  <label>Professional status
    <select name="clinician_professional_status">
      <option value="">Select…</option>
      <option>MD</option><option>DO</option><option>RN</option>
      <option>NP</option><option>PA</option><option>Pharmacist</option>
      <option>Paramedic</option><option>other</option>
    </select>
  </label>
  <label>Registration body / number
    <input name="clinician_registration_body" placeholder="GMC/NMC/HCPC/…" />
    <input name="clinician_registration_number" />
  </label>
</fieldset>
