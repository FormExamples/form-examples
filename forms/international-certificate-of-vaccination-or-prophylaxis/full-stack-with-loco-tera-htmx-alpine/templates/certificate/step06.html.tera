<h2>Step 6 — Vaccination entry — administration</h2>
<label>Date of vaccination <input type="date" name="entry_1_vaccination_date" /></label>
<label>Time of vaccination <input type="time" name="entry_1_vaccination_time" /></label>
<label>Administering clinician signature (image)
  <input type="file" name="entry_1_administering_clinician_signature" accept="image/*" />
</label>
<label>Professional status
  <select name="entry_1_administering_clinician_professional_status">
    <option value="">Select…</option>
    <option>MD</option><option>DO</option><option>RN</option>
    <option>NP</option><option>PA</option><option>Pharmacist</option>
    <option>Paramedic</option><option>other</option>
  </select>
</label>
