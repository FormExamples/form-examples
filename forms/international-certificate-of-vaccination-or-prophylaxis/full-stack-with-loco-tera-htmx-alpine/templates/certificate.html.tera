{% extends "base.html.tera" %}
{% block title %}Certificate {{ id }} — ICVP{% endblock %}
{% block content %}
<form method="POST" action="/certificate/{{ id }}/submit" x-data="{ step: 1 }" class="wizard">
  <nav class="wizard-progress" aria-live="polite">
    <template x-for="n in 8">
      <button type="button"
              class="wizard-step"
              :class="{ 'is-active': step === n }"
              @click="step = n"
              x-text="n"></button>
    </template>
  </nav>

  <section x-show="step === 1">{% include "certificate/step01.html.tera" %}</section>
  <section x-show="step === 2">{% include "certificate/step02.html.tera" %}</section>
  <section x-show="step === 3">{% include "certificate/step03.html.tera" %}</section>
  <section x-show="step === 4">{% include "certificate/step04.html.tera" %}</section>
  <section x-show="step === 5">{% include "certificate/step05.html.tera" %}</section>
  <section x-show="step === 6">{% include "certificate/step06.html.tera" %}</section>
  <section x-show="step === 7">{% include "certificate/step07.html.tera" %}</section>
  <section x-show="step === 8">{% include "certificate/step08.html.tera" %}</section>

  <div class="wizard-nav">
    <button type="button" @click="step = Math.max(1, step - 1)" :disabled="step === 1">Previous</button>
    <button type="button" @click="step = Math.min(8, step + 1)" :disabled="step === 8" x-show="step < 8">Next</button>
    <button type="submit" x-show="step === 8">Submit certificate</button>
  </div>
</form>
{% endblock %}
