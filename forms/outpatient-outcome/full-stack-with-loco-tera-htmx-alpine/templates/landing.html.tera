{% extends "base.html.tera" %}

{% block title %}Outpatient Outcome Report - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Outpatient Outcome Report</h1>
        <p class="landing-description">
            Structured outpatient outcome report documenting encounter details, operational
            efficiency, clinical outcome, patient-reported outcome measures (PROMs),
            patient-reported experience measures (PREMs), and follow-up plan. The output is
            an Outpatient Outcome Composite Grade (OOCG) &mdash; A (best) through E (worst)
            &mdash; computed as the worst of four domain grades.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Four Domains</h3>
                <p>Clinical, PROM (EQ-5D-5L + GRC + PROMIS), PREM (FFT), and Operational (NHS Attendance Outcome)</p>
            </div>
            <div class="feature">
                <h3>PROM Composite</h3>
                <p>EQ-5D-5L before/after, Global Rating of Change, and PROMIS Global Health v1.2 T-scores</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Critical/high/medium/low alerts for DNA, worsened outcomes, FFT concerns, and missed wait-time targets</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
