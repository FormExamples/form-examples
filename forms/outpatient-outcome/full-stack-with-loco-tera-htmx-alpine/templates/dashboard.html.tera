{% extends "base.html.tera" %}

{% block title %}Outpatient Outcome - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Outpatient Outcome Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, NHS number, or clinician...">
    </div>
    <div class="form-group">
        <label for="overall_grade">Overall Grade</label>
        <select id="overall_grade" name="overall_grade">
            <option value="">All</option>
            <option value="A" {% if overall_grade == "A" %}selected{% endif %}>A</option>
            <option value="B" {% if overall_grade == "B" %}selected{% endif %}>B</option>
            <option value="C" {% if overall_grade == "C" %}selected{% endif %}>C</option>
            <option value="D" {% if overall_grade == "D" %}selected{% endif %}>D</option>
            <option value="E" {% if overall_grade == "E" %}selected{% endif %}>E</option>
        </select>
    </div>
    <div class="form-group">
        <label for="modality">Modality</label>
        <select id="modality" name="modality">
            <option value="">All</option>
            <option value="in_person" {% if modality == "in_person" %}selected{% endif %}>In person</option>
            <option value="telephone" {% if modality == "telephone" %}selected{% endif %}>Telephone</option>
            <option value="video" {% if modality == "video" %}selected{% endif %}>Video</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Critical/High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Clinic Date</th>
            <th>Patient</th>
            <th>Specialty</th>
            <th>Clinician</th>
            <th>Modality</th>
            <th>Overall</th>
            <th>Clinical</th>
            <th>PROM</th>
            <th>PREM</th>
            <th>Operational</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.clinicDate }}</a></td>
            <td>{{ c.patientName }}<br><small>{{ c.patientNhsNumber }}</small></td>
            <td>{{ c.specialty }}</td>
            <td>{{ c.clinicianName }}</td>
            <td>{{ c.modality }}</td>
            <td><span class="grade-badge grade-{{ c.overallGrade }}">{{ c.overallGrade }}</span></td>
            <td><span class="grade-badge grade-{{ c.clinicalGrade }}">{{ c.clinicalGrade }}</span></td>
            <td><span class="grade-badge grade-{{ c.promGrade }}">{{ c.promGrade }}</span></td>
            <td><span class="grade-badge grade-{{ c.premGrade }}">{{ c.premGrade }}</span></td>
            <td><span class="grade-badge grade-{{ c.operationalGrade }}">{{ c.operationalGrade }}</span></td>
            <td>
                {% if c.criticalFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.criticalFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
