<div class="card">
    <h2>Step 7: PROM &mdash; PROMIS Global Health v1.2</h2>
    <p class="form-hint">Ten items. Items 1&ndash;8 and 10 are scored 1&ndash;5; item 9 (pain) is scored 0&ndash;10.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="item1_general_health">1. General Health (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item1_general_health" name="prom_promis.item1_general_health" value="{{ prom_promis.item1GeneralHealth }}">
        </div>
        <div class="form-group">
            <label for="item2_quality_of_life">2. Quality of Life (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item2_quality_of_life" name="prom_promis.item2_quality_of_life" value="{{ prom_promis.item2QualityOfLife }}">
        </div>
        <div class="form-group">
            <label for="item3_physical_health">3. Physical Health (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item3_physical_health" name="prom_promis.item3_physical_health" value="{{ prom_promis.item3PhysicalHealth }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="item4_mental_health">4. Mental Health (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item4_mental_health" name="prom_promis.item4_mental_health" value="{{ prom_promis.item4MentalHealth }}">
        </div>
        <div class="form-group">
            <label for="item5_satisfaction">5. Satisfaction (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item5_satisfaction" name="prom_promis.item5_satisfaction" value="{{ prom_promis.item5Satisfaction }}">
        </div>
        <div class="form-group">
            <label for="item6_fatigue_frequency">6. Fatigue frequency (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item6_fatigue_frequency" name="prom_promis.item6_fatigue_frequency" value="{{ prom_promis.item6FatigueFrequency }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="item7_emotional_problems">7. Emotional problems (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item7_emotional_problems" name="prom_promis.item7_emotional_problems" value="{{ prom_promis.item7EmotionalProblems }}">
        </div>
        <div class="form-group">
            <label for="item8_social_activities">8. Social activities (1&ndash;5)</label>
            <input type="number" min="1" max="5" id="item8_social_activities" name="prom_promis.item8_social_activities" value="{{ prom_promis.item8SocialActivities }}">
        </div>
        <div class="form-group">
            <label for="item9_pain">9. Pain (0&ndash;10)</label>
            <input type="number" min="0" max="10" id="item9_pain" name="prom_promis.item9_pain" value="{{ prom_promis.item9Pain }}">
        </div>
    </div>

    <div class="form-group">
        <label for="item10_everyday_activities">10. Everyday physical activities (1&ndash;5)</label>
        <input type="number" min="1" max="5" id="item10_everyday_activities" name="prom_promis.item10_everyday_activities" value="{{ prom_promis.item10EverydayActivities }}">
    </div>
</div>
