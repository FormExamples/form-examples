<div class="card">
    <h2>Step 2: Encounter Details</h2>
    <p class="form-hint">Clinic date, specialty, clinician, modality, and appointment type.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="clinic_date">Clinic Date</label>
            <input type="date" id="clinic_date" name="encounter_details.clinic_date"
                   value="{{ encounter_details.clinicDate }}">
        </div>
        <div class="form-group">
            <label for="specialty">Specialty</label>
            <input type="text" id="specialty" name="encounter_details.specialty"
                   value="{{ encounter_details.specialty }}">
        </div>
        <div class="form-group">
            <label for="clinician_name">Clinician Name</label>
            <input type="text" id="clinician_name" name="encounter_details.clinician_name"
                   value="{{ encounter_details.clinicianName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="modality">Modality</label>
            <select id="modality" name="encounter_details.modality">
                <option value="" {% if encounter_details.modality == "" %}selected{% endif %}>&mdash;</option>
                <option value="in_person" {% if encounter_details.modality == "in_person" %}selected{% endif %}>In person</option>
                <option value="telephone" {% if encounter_details.modality == "telephone" %}selected{% endif %}>Telephone</option>
                <option value="video" {% if encounter_details.modality == "video" %}selected{% endif %}>Video</option>
            </select>
        </div>
        <div class="form-group">
            <label for="appointment_type">Appointment Type</label>
            <select id="appointment_type" name="encounter_details.appointment_type">
                <option value="" {% if encounter_details.appointmentType == "" %}selected{% endif %}>&mdash;</option>
                <option value="new" {% if encounter_details.appointmentType == "new" %}selected{% endif %}>New</option>
                <option value="follow_up" {% if encounter_details.appointmentType == "follow_up" %}selected{% endif %}>Follow-up</option>
                <option value="pifu" {% if encounter_details.appointmentType == "pifu" %}selected{% endif %}>PIFU (Patient-Initiated Follow-Up)</option>
            </select>
        </div>
    </div>
</div>
