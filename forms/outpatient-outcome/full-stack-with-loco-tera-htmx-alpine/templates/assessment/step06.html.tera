<div class="card">
    <h2>Step 6: PROM &mdash; Global Rating of Change</h2>
    <p class="form-hint">Seven-point change scale: -3 (much worse) to +3 (much better).</p>

    <div class="form-row">
        <div class="form-group">
            <label for="global_rating_of_change">Global Rating of Change (-3 to +3)</label>
            <select id="global_rating_of_change" name="prom_grc.global_rating_of_change">
                <option value="" {% if prom_grc.globalRatingOfChange == "" %}selected{% endif %}>&mdash;</option>
                <option value="-3" {% if prom_grc.globalRatingOfChange == -3 %}selected{% endif %}>-3 Much worse</option>
                <option value="-2" {% if prom_grc.globalRatingOfChange == -2 %}selected{% endif %}>-2 Worse</option>
                <option value="-1" {% if prom_grc.globalRatingOfChange == -1 %}selected{% endif %}>-1 Slightly worse</option>
                <option value="0" {% if prom_grc.globalRatingOfChange == 0 %}selected{% endif %}>0 No change</option>
                <option value="1" {% if prom_grc.globalRatingOfChange == 1 %}selected{% endif %}>+1 Slightly better</option>
                <option value="2" {% if prom_grc.globalRatingOfChange == 2 %}selected{% endif %}>+2 Better</option>
                <option value="3" {% if prom_grc.globalRatingOfChange == 3 %}selected{% endif %}>+3 Much better</option>
            </select>
        </div>
        <div class="form-group">
            <label for="self_rated_health">Self-Rated Health</label>
            <select id="self_rated_health" name="prom_grc.self_rated_health">
                <option value="" {% if prom_grc.selfRatedHealth == "" %}selected{% endif %}>&mdash;</option>
                <option value="excellent" {% if prom_grc.selfRatedHealth == "excellent" %}selected{% endif %}>Excellent</option>
                <option value="very_good" {% if prom_grc.selfRatedHealth == "very_good" %}selected{% endif %}>Very good</option>
                <option value="good" {% if prom_grc.selfRatedHealth == "good" %}selected{% endif %}>Good</option>
                <option value="fair" {% if prom_grc.selfRatedHealth == "fair" %}selected{% endif %}>Fair</option>
                <option value="poor" {% if prom_grc.selfRatedHealth == "poor" %}selected{% endif %}>Poor</option>
            </select>
        </div>
    </div>
</div>
