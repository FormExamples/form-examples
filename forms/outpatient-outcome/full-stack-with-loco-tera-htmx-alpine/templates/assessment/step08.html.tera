<div class="card">
    <h2>Step 8: PREM &mdash; Friends and Family Test</h2>
    <p class="form-hint">NHS Friends and Family Test (FFT). How likely would the patient recommend this service?</p>

    <div class="form-group">
        <label for="fft_response">FFT Response</label>
        <select id="fft_response" name="prem_fft.fft_response">
            <option value="" {% if prem_fft.fftResponse == "" %}selected{% endif %}>&mdash;</option>
            <option value="extremely_likely" {% if prem_fft.fftResponse == "extremely_likely" %}selected{% endif %}>Extremely likely (Very Good)</option>
            <option value="likely" {% if prem_fft.fftResponse == "likely" %}selected{% endif %}>Likely (Good)</option>
            <option value="neither" {% if prem_fft.fftResponse == "neither" %}selected{% endif %}>Neither likely nor unlikely</option>
            <option value="unlikely" {% if prem_fft.fftResponse == "unlikely" %}selected{% endif %}>Unlikely (Poor)</option>
            <option value="extremely_unlikely" {% if prem_fft.fftResponse == "extremely_unlikely" %}selected{% endif %}>Extremely unlikely (Very Poor)</option>
            <option value="dont_know" {% if prem_fft.fftResponse == "dont_know" %}selected{% endif %}>Don't know</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fft_comment">FFT Free-text comment</label>
        <textarea id="fft_comment" name="prem_fft.fft_comment">{{ prem_fft.fftComment }}</textarea>
    </div>
</div>
