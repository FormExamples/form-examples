<div class="card">
    <h2>Step 3: Operational Efficiency</h2>
    <p class="form-hint">Referral and appointment dates, service target, and NHS Attendance Outcome.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="referral_date">Referral Date</label>
            <input type="date" id="referral_date" name="operational_efficiency.referral_date"
                   value="{{ operational_efficiency.referralDate }}">
        </div>
        <div class="form-group">
            <label for="appointment_date">Appointment Date</label>
            <input type="date" id="appointment_date" name="operational_efficiency.appointment_date"
                   value="{{ operational_efficiency.appointmentDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="wait_time_days">Wait Time (days)</label>
            <input type="number" id="wait_time_days" name="operational_efficiency.wait_time_days"
                   value="{{ operational_efficiency.waitTimeDays }}">
        </div>
        <div class="form-group">
            <label for="service_target_days">Service Target (days)</label>
            <input type="number" id="service_target_days" name="operational_efficiency.service_target_days"
                   value="{{ operational_efficiency.serviceTargetDays }}">
        </div>
    </div>

    <div class="form-group">
        <label for="nhs_attendance_outcome">NHS Attendance Outcome</label>
        <select id="nhs_attendance_outcome" name="operational_efficiency.nhs_attendance_outcome">
            <option value="" {% if operational_efficiency.nhsAttendanceOutcome == "" %}selected{% endif %}>&mdash;</option>
            <option value="attended_discharged" {% if operational_efficiency.nhsAttendanceOutcome == "attended_discharged" %}selected{% endif %}>Attended &mdash; discharged</option>
            <option value="attended_follow_up" {% if operational_efficiency.nhsAttendanceOutcome == "attended_follow_up" %}selected{% endif %}>Attended &mdash; follow-up</option>
            <option value="attended_pifu" {% if operational_efficiency.nhsAttendanceOutcome == "attended_pifu" %}selected{% endif %}>Attended &mdash; PIFU</option>
            <option value="attended_onward_referral" {% if operational_efficiency.nhsAttendanceOutcome == "attended_onward_referral" %}selected{% endif %}>Attended &mdash; onward referral</option>
            <option value="patient_cancelled" {% if operational_efficiency.nhsAttendanceOutcome == "patient_cancelled" %}selected{% endif %}>Patient cancelled / rebooked</option>
            <option value="patient_dna" {% if operational_efficiency.nhsAttendanceOutcome == "patient_dna" %}selected{% endif %}>Patient DNA (Did Not Attend)</option>
            <option value="provider_cancelled" {% if operational_efficiency.nhsAttendanceOutcome == "provider_cancelled" %}selected{% endif %}>Provider cancelled</option>
        </select>
    </div>
</div>
