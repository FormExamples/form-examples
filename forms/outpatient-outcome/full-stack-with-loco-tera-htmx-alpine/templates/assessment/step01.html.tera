<div class="card">
    <h2>Step 1: Patient Details</h2>
    <p class="form-hint">Basic patient identification.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="given_name">Given Name</label>
            <input type="text" id="given_name" name="patient_details.given_name"
                   value="{{ patient_details.givenName }}">
        </div>
        <div class="form-group">
            <label for="family_name">Family Name</label>
            <input type="text" id="family_name" name="patient_details.family_name"
                   value="{{ patient_details.familyName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="patient_details.date_of_birth"
                   value="{{ patient_details.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="nhs_number">NHS Number</label>
            <input type="text" id="nhs_number" name="patient_details.nhs_number"
                   value="{{ patient_details.nhsNumber }}" placeholder="e.g. 943 476 5919">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="patient_details.sex">
                <option value="" {% if patient_details.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if patient_details.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if patient_details.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if patient_details.sex == "other" %}selected{% endif %}>Other</option>
                <option value="prefer_not_to_say" {% if patient_details.sex == "prefer_not_to_say" %}selected{% endif %}>Prefer not to say</option>
            </select>
        </div>
    </div>
</div>
