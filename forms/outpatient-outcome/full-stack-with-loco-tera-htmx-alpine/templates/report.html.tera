{% extends "base.html.tera" %}

{% block title %}Outpatient Outcome Report - {{ overall_grade_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Outpatient Outcome Report &mdash; OOCG</h1>
    <div class="grade-badge grade-{{ overall_grade }}">{{ overall_grade_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient &amp; Encounter</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.patientDetails.givenName }} {{ data.patientDetails.familyName }}<br>
            <strong>Date of Birth:</strong> {{ data.patientDetails.dateOfBirth }}<br>
            <strong>NHS Number:</strong> {{ data.patientDetails.nhsNumber }}<br>
            <strong>Sex:</strong> {{ data.patientDetails.sex }}
        </div>
        <div>
            <strong>Clinic Date:</strong> {{ data.encounterDetails.clinicDate }}<br>
            <strong>Specialty:</strong> {{ data.encounterDetails.specialty }}<br>
            <strong>Clinician:</strong> {{ data.encounterDetails.clinicianName }}<br>
            <strong>Modality:</strong> {{ data.encounterDetails.modality }} &mdash; {{ data.encounterDetails.appointmentType }}
        </div>
    </div>
</div>

<!-- Domain Grades -->
<div class="card">
    <h2>Domain Grades</h2>
    <table class="phase-table">
        <thead>
            <tr><th>Domain</th><th>Grade</th><th>Label</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>Clinical</td>
                <td><span class="grade-badge grade-{{ clinical_grade }}">{{ clinical_grade }}</span></td>
                <td>{{ clinical_grade_label }}</td>
            </tr>
            <tr>
                <td>PROM (EQ-5D-5L + GRC + PROMIS)</td>
                <td><span class="grade-badge grade-{{ prom_grade }}">{{ prom_grade }}</span></td>
                <td>{{ prom_grade_label }}</td>
            </tr>
            <tr>
                <td>PREM (Friends &amp; Family Test)</td>
                <td><span class="grade-badge grade-{{ prem_grade }}">{{ prem_grade }}</span></td>
                <td>{{ prem_grade_label }}</td>
            </tr>
            <tr>
                <td>Operational</td>
                <td><span class="grade-badge grade-{{ operational_grade }}">{{ operational_grade }}</span></td>
                <td>{{ operational_grade_label }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Flagged Issues -->
{% if flagged_issues | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ flagged_issues | length }})</h2>
    <div class="flags-section">
        {% for flag in flagged_issues %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired Rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Domain</th>
                <th>Description</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.domain }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="grade-badge grade-{{ rule.grade }}">{{ rule.grade }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Sign-off -->
<div class="card">
    <h2>Sign-off</h2>
    <p>
        <strong>{{ data.signOff.reportingClinicianName }}</strong>
        ({{ data.signOff.reportingClinicianRole }})
        signed off at {{ data.signOff.signedOffAt }}.
    </p>
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
