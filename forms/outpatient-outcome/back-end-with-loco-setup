#!/bin/sh
set -euf

form_kebab_case=outpatient-outcome
form_snake_case=outpatient_outcome

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold outpatient_outcome \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold outpatient_outcome_encounter \
    deleted_at:tstz \
    outpatient_outcome:references \
    clinic_date:date \
    specialty:string! \
    clinician:references \
    modality:string! \
    appointment_type:string! \
    --api

cargo loco generate scaffold outpatient_outcome_operational \
    deleted_at:tstz \
    outpatient_outcome:references \
    referral_date:date \
    appointment_date:date \
    wait_time_days:int \
    service_target_days:int \
    nhs_attendance_outcome:string! \
    --api

cargo loco generate scaffold outpatient_outcome_clinical \
    deleted_at:tstz \
    outpatient_outcome:references \
    presenting_complaint:text! \
    diagnosis:text! \
    treatment_delivered:text! \
    outcome_classification:string! \
    --api

cargo loco generate scaffold outpatient_outcome_prom_eq5d5l \
    deleted_at:tstz \
    outpatient_outcome:references \
    --api

cargo loco generate scaffold outpatient_outcome_prom_grc \
    deleted_at:tstz \
    outpatient_outcome:references \
    global_rating_of_change:int \
    self_rated_health:string! \
    --api

cargo loco generate scaffold outpatient_outcome_prom_promis \
    deleted_at:tstz \
    outpatient_outcome:references \
    --api

cargo loco generate scaffold outpatient_outcome_prem_fft \
    deleted_at:tstz \
    outpatient_outcome:references \
    fft_response:string! \
    fft_comment:text! \
    --api

cargo loco generate scaffold outpatient_outcome_followup \
    deleted_at:tstz \
    outpatient_outcome:references \
    disposition:string! \
    next_appointment_date:date \
    onward_referral_specialty:string! \
    followup_notes:text! \
    --api

cargo loco generate scaffold outpatient_outcome_signoff \
    deleted_at:tstz \
    outpatient_outcome:references \
    reporting_clinician:references \
    reporting_clinician_name:string! \
    reporting_clinician_role:string! \
    signed_off_at:tstz \
    --api

cargo loco generate scaffold outpatient_outcome_grade \
    deleted_at:tstz \
    outpatient_outcome:references \
    overall_grade:string! \
    clinical_grade:string! \
    prom_grade:string! \
    prem_grade:string! \
    operational_grade:string! \
    result_notes:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold outpatient_outcome_grade_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --api

cargo loco generate scaffold outpatient_outcome_grade_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    description:text! \
    priority:string! \
    --api
