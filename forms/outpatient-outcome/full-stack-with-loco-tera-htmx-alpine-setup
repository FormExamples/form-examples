#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding outpatient-outcome (15 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold outpatient_outcome \
    deleted_at:ts \
    patient:references \
    status:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_encounter \
    deleted_at:ts \
    outpatient_outcome:references \
    clinic_date:date \
    specialty:string! \
    clinician:references \
    modality:string! \
    appointment_type:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_operational \
    deleted_at:ts \
    outpatient_outcome:references \
    referral_date:date \
    appointment_date:date \
    wait_time_days:int \
    service_target_days:int \
    nhs_attendance_outcome:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_clinical \
    deleted_at:ts \
    outpatient_outcome:references \
    presenting_complaint:text! \
    diagnosis:text! \
    treatment_delivered:text! \
    outcome_classification:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_prom_eq5d5l \
    deleted_at:ts \
    outpatient_outcome:references \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_prom_grc \
    deleted_at:ts \
    outpatient_outcome:references \
    global_rating_of_change:int \
    self_rated_health:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_prom_promis \
    deleted_at:ts \
    outpatient_outcome:references \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_prem_fft \
    deleted_at:ts \
    outpatient_outcome:references \
    fft_response:string! \
    fft_comment:text! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_followup \
    deleted_at:ts \
    outpatient_outcome:references \
    disposition:string! \
    next_appointment_date:date \
    onward_referral_specialty:string! \
    followup_notes:text! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_signoff \
    deleted_at:ts \
    outpatient_outcome:references \
    reporting_clinician:references \
    reporting_clinician_name:string! \
    reporting_clinician_role:string! \
    signed_off_at:ts \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_grade \
    deleted_at:ts \
    outpatient_outcome:references \
    overall_grade:string! \
    clinical_grade:string! \
    prom_grade:string! \
    prem_grade:string! \
    operational_grade:string! \
    result_notes:text! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_grade_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --htmx && \
cargo loco generate scaffold outpatient_outcome_grade_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    description:text! \
    priority:string! \
    --htmx

echo "Done."
