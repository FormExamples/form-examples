    profession_registration_number:string \
    years_known_donor:double \
    relationship_to_donor:string \
    declared_not_family:string \
    declared_not_employee:string \
    declared_not_attorney:string \
    --htmx && \
cargo loco generate scaffold person_to_notify \
    deleted_at:ts \
    title:string \
    given_names:string \
    family_name:string \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
