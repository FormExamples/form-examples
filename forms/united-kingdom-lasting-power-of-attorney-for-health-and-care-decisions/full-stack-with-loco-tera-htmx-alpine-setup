    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    relationship_to_donor:string \
    is_bankrupt:string \
    capacity_declared:string \
    --htmx && \
cargo loco generate scaffold certificate_provider \
    deleted_at:ts \
    title:string \
