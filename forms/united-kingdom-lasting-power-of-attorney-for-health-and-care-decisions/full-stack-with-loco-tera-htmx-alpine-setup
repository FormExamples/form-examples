#!/bin/sh
# setup.sh
#
# Scaffold generator for the LP1H full-stack Loco crate.
#
# - Creates the `loco` Postgres role (if not exists)
# - Creates `*_development`, `*_test`, `*_production` databases (if not exists)
# - Runs `cargo loco generate scaffold` for every table in
#   sql-migrations/*.sql, in the order they appear so foreign-key targets
#   are scaffolded first.
#
# Re-run after changing sql-migrations/*.sql.

set -euf

PROJECT="united_kingdom_lasting_power_of_attorney_for_health_and_care_decisions"
PGHOST="${PGHOST:-localhost}"
PGPORT="${PGPORT:-5432}"

echo "==> Ensuring Postgres role 'loco' exists"
createuser --host="$PGHOST" --port="$PGPORT" --username=postgres \
  --login --createdb loco || true

for env in development test production; do
  echo "==> Ensuring database ${PROJECT}_${env} exists"
  createdb --host="$PGHOST" --port="$PGPORT" --username=postgres \
    --owner=loco "${PROJECT}_${env}" || true
done

echo "==> Scaffolding LP1H tables (18 tables)..."

cargo loco generate scaffold donor \
    deleted_at:ts \
    title:string \
    given_names:string! \
    family_name:string! \
    other_names_used:text \
    birth_date:date \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string \
    jurisdiction:string \
    preferred_language:string \
    capacity_declared:string \
    capacity_declared_at:ts \
    --htmx && \
cargo loco generate scaffold attorney \
    deleted_at:ts \
    title:string \
    given_names:string! \
    family_name:string! \
    birth_date:date \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    relationship_to_donor:string \
    is_bankrupt:string \
    capacity_declared:string \
    --htmx && \
cargo loco generate scaffold replacement_attorney \
    deleted_at:ts \
    title:string \
    given_names:string! \
    family_name:string! \
    birth_date:date \
    email:text \
