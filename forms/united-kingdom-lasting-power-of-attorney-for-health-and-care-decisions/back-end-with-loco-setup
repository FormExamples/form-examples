#!/bin/sh
set -euf

form_kebab_case=united-kingdom-lasting-power-of-attorney-for-health-and-care-decisions
form_snake_case=united_kingdom_lasting_power_of_attorney_for_health_and_care_decisions

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold donor \
    deleted_at:tstz \
    title:string! \
    given_names:string! \
    family_name:string! \
    other_names_used:string! \
    birth_date:date \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string! \
    postcode:text! \
    united_kingdom_nhs_number:string \
    jurisdiction:string! \
    preferred_language:string! \
    capacity_declared:string! \
    capacity_declared_at:tstz \
    --api

cargo loco generate scaffold attorney \
    deleted_at:tstz \
    title:string! \
    given_names:string! \
    family_name:string! \
    birth_date:date \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string! \
    postcode:text! \
    relationship_to_donor:string! \
    is_bankrupt:string! \
    capacity_declared:string! \
    --api

cargo loco generate scaffold replacement_attorney \
    deleted_at:tstz \
    title:string! \
    given_names:string! \
    family_name:string! \
    birth_date:date \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string! \
    postcode:text! \
    relationship_to_donor:string! \
    is_bankrupt:string! \
    capacity_declared:string! \
    --api

cargo loco generate scaffold certificate_provider \
    deleted_at:tstz \
    title:string! \
    given_names:string! \
    family_name:string! \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string! \
    postcode:text! \
    route:string! \
    profession:string! \
    profession_registration_number:string! \
    years_known_donor:double \
    relationship_to_donor:string! \
    declared_not_family:string! \
    declared_not_employee:string! \
    declared_not_attorney:string! \
    --api

cargo loco generate scaffold person_to_notify \
    deleted_at:tstz \
    title:string! \
    given_names:string! \
    family_name:string! \
    email:text! \
    phone:text! \
    postal_address_as_full_text:text! \
    country_as_iso_3166_1_alpha_2:string! \
    postcode:text! \
    relationship_to_donor:string! \
    --api

cargo loco generate scaffold lpa \
    deleted_at:tstz \
    donor:references \
    certificate_provider:references \
    form_version:string! \
    jurisdiction:string! \
    status:string! \
    opg_reference:string! \
    registered_at:tstz \
    effective_from:tstz \
    notes:text! \
    --api

cargo loco generate scaffold lpa_attorney \
    deleted_at:tstz \
    lpa:references \
    attorney:references \
    order_position:int! \
    --api

cargo loco generate scaffold lpa_replacement_attorney \
    deleted_at:tstz \
    lpa:references \
    replacement_attorney:references \
    order_position:int! \
    replacement_trigger:text! \
    --api

cargo loco generate scaffold lpa_person_to_notify \
    deleted_at:tstz \
    lpa:references \
    person_to_notify:references \
    order_position:int! \
    --api

cargo loco generate scaffold lpa_decision_rule \
    deleted_at:tstz \
    lpa:references \
    decision_rule:string! \
    joint_decision_set:text! \
    --api

cargo loco generate scaffold lpa_lst_choice \
    deleted_at:tstz \
    lpa:references \
    lst_choice:string! \
    donor_initialled:string! \
    initialled_at:tstz \
    --api

cargo loco generate scaffold lpa_preference \
    deleted_at:tstz \
    lpa:references \
    order_position:int! \
    category:string! \
    statement:text! \
    --api

cargo loco generate scaffold lpa_instruction \
    deleted_at:tstz \
    lpa:references \
    order_position:int! \
    category:string! \
    statement:text! \
    lawfulness_assessed:string! \
    contradicts_adrt:string! \
    --api

cargo loco generate scaffold lpa_signature \
    deleted_at:tstz \
    lpa:references \
    signer_role:string! \
    signer_id:uuid \
    signed_at:tstz \
    signature_method:string! \
    signature_data:blob \
    witness_name:string! \
    witness_address:text! \
    witness_signed_at:tstz \
    witness_is_attorney:string! \
    --api

cargo loco generate scaffold lpa_registration_application \
    deleted_at:tstz \
    lpa:references \
    applicant_role:string! \
    applicant_signed_at:tstz \
    fee_amount_pounds:double! \
    fee_remission:string! \
    fee_remission_reason:string! \
    submitted_at:tstz \
    submission_channel:string! \
    --api

cargo loco generate scaffold lpa_validity \
    deleted_at:tstz \
    lpa:references \
    validity_status:string! \
    completeness_score:int! \
    effective_date:date \
    computed_at:tstz! \
    engine_version:string! \
    notes:text! \
    --api

cargo loco generate scaffold lpa_validity_fired_rule \
    deleted_at:tstz \
    lpa_validity:references \
    rule_id:string! \
    severity:string! \
    rule_family:string! \
    source_citation:string! \
    description:text! \
    suggested_correction:text! \
    --api

cargo loco generate scaffold lpa_validity_additional_flag \
    deleted_at:tstz \
    lpa_validity:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:text! \
    suggested_action:text! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
