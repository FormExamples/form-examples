#!/bin/sh
set -euf

form_kebab_case=hypertension-review
form_snake_case=hypertension_review

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold hypertension_review \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_role:string! \
    reviewed_at:date \
    practice_site:string! \
    patient_identifier:string! \
    age_band:string! \
    sex:string! \
    ethnicity:string! \
    diagnosis_date:date \
    type2_diabetes:string! \
    chronic_kidney_disease:string! \
    established_cvd:string! \
    atrial_fibrillation:string! \
    clinic_systolic:int \
    clinic_diastolic:int \
    home_systolic:int \
    home_diastolic:int \
    monitoring_method:string! \
    postural_drop:string! \
    antihypertensive_agents:int \
    adherence:string! \
    side_effects:string! \
    qrisk_percent:double \
    smoking_status:string! \
    statin_therapy:string! \
    bmi:double \
    lifestyle_advice:text! \
    serum_creatinine:double \
    egfr:double \
    serum_potassium:double \
    hba1c:double \
    total_cholesterol:double \
    hdl_cholesterol:double \
    urine_acr:double \
    complications:text! \
    review_context:text! \
    --api

cargo loco generate scaffold hypertension_review_grade \
    deleted_at:tstz \
    hypertension_review:references \
    control_status:string! \
    hypertension_stage:string! \
    review_status:string! \
    primary_source:string! \
    target_group:string! \
    clinic_target_systolic:int \
    clinic_target_diastolic:int \
    home_target_systolic:int \
    home_target_diastolic:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold hypertension_review_grade_rule \
    deleted_at:tstz \
    hypertension_review_grade:references \
    rule_id:string! \
    section:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold hypertension_review_grade_flag \
    deleted_at:tstz \
    hypertension_review_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"

# Fix two loco-new scaffold defaults that fail clippy -D warnings:
# App::seed()'s unused base param, and the test auth_header() helper's
# redundant &token.
"$(git rev-parse --show-toplevel)/bin/loco-seed-base-rename" "${form_kebab_case}"
"$(git rev-parse --show-toplevel)/bin/loco-test-auth-header-fix" "${form_kebab_case}"
