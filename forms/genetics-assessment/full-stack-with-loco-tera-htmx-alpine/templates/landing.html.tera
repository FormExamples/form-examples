{% extends "base.html.tera" %}

{% block title %}Genetics Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Genetics Assessment</h1>
        <p class="landing-description">
            Clinical genetics assessment capturing proband medical history, a detailed
            three-generation family pedigree, ancestry, and targeted risk scoring
            (Manchester Score for BRCA, Revised Bethesda for Lynch syndrome,
            Tyrer-Cuzick for breast cancer, PREMM5 for Lynch) to stratify genetic risk
            and guide testing and referral.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Nine-Step Wizard</h3>
                <p>Proband demographics, presenting concern, personal medical history, three-generation pedigree, ancestry, targeted scoring, prior testing, patient concerns, and referral plan.</p>
            </div>
            <div class="feature">
                <h3>Targeted Risk Scoring</h3>
                <p>Manchester Score, Revised Bethesda count, PREMM5, and Tyrer-Cuzick lifetime risk drive a Low / Moderate / High risk stratification.</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Surfaces testing indications, paternal-line considerations, founder-population risk modifiers, and counselling reminders.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
