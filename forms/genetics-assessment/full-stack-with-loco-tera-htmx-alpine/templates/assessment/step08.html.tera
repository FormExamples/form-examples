<div class="card">
    <h2>Step 8: Patient Understanding &amp; Concerns</h2>
    <p class="form-hint">Document the patient's expectations, concerns, and consent posture.</p>

    <div class="form-group">
        <label for="understanding_of_referral">Understanding of why they were referred</label>
        <textarea id="understanding_of_referral" name="patient_understanding_concerns.understanding_of_referral">{{ patient_understanding_concerns.understandingOfReferral }}</textarea>
    </div>

    <div class="form-group">
        <label for="primary_concerns">Primary concerns</label>
        <textarea id="primary_concerns" name="patient_understanding_concerns.primary_concerns">{{ patient_understanding_concerns.primaryConcerns }}</textarea>
    </div>

    <div class="form-group">
        <label for="expectations">Expectations from this consultation</label>
        <textarea id="expectations" name="patient_understanding_concerns.expectations">{{ patient_understanding_concerns.expectations }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="insurance_concerns">Insurance concerns?</label>
            <select id="insurance_concerns" name="patient_understanding_concerns.insurance_concerns">
                <option value="" {% if patient_understanding_concerns.insuranceConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if patient_understanding_concerns.insuranceConcerns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if patient_understanding_concerns.insuranceConcerns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="confidentiality_concerns">Confidentiality concerns?</label>
            <select id="confidentiality_concerns" name="patient_understanding_concerns.confidentiality_concerns">
                <option value="" {% if patient_understanding_concerns.confidentialityConcerns == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if patient_understanding_concerns.confidentialityConcerns == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if patient_understanding_concerns.confidentialityConcerns == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reproductive_implications">Reproductive implications discussed?</label>
            <select id="reproductive_implications" name="patient_understanding_concerns.reproductive_implications">
                <option value="" {% if patient_understanding_concerns.reproductiveImplications == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if patient_understanding_concerns.reproductiveImplications == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if patient_understanding_concerns.reproductiveImplications == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="support_system">Support system</label>
        <textarea id="support_system" name="patient_understanding_concerns.support_system">{{ patient_understanding_concerns.supportSystem }}</textarea>
    </div>

    <div class="form-group">
        <label for="consent_to_testing">Consent to testing?</label>
        <select id="consent_to_testing" name="patient_understanding_concerns.consent_to_testing">
            <option value="" {% if patient_understanding_concerns.consentToTesting == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if patient_understanding_concerns.consentToTesting == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if patient_understanding_concerns.consentToTesting == "yes" %}selected{% endif %}>Yes</option>
        </select>
    </div>
</div>
