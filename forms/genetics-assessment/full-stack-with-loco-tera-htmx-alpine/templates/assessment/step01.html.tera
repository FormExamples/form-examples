<div class="card">
    <h2>Step 1: Proband Demographics</h2>
    <p class="form-hint">Identifying details of the patient being assessed.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="proband_first_name">First Name</label>
            <input type="text" id="proband_first_name" name="proband_demographics.first_name"
                   value="{{ proband_demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="proband_last_name">Last Name</label>
            <input type="text" id="proband_last_name" name="proband_demographics.last_name"
                   value="{{ proband_demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="proband_date_of_birth">Date of Birth</label>
            <input type="date" id="proband_date_of_birth" name="proband_demographics.date_of_birth"
                   value="{{ proband_demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="proband_sex">Sex</label>
            <select id="proband_sex" name="proband_demographics.sex">
                <option value="" {% if proband_demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if proband_demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if proband_demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if proband_demographics.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="proband_mrn">Medical Record Number</label>
            <input type="text" id="proband_mrn" name="proband_demographics.mrn"
                   value="{{ proband_demographics.mrn }}">
        </div>
    </div>

    <div class="form-group">
        <label for="proband_preferred_contact">Preferred Contact</label>
        <input type="text" id="proband_preferred_contact" name="proband_demographics.preferred_contact"
               value="{{ proband_demographics.preferredContact }}" placeholder="Phone, email, etc.">
    </div>
</div>
