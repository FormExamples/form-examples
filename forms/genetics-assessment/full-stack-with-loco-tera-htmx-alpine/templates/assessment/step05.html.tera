<div class="card">
    <h2>Step 5: Consanguinity &amp; Ancestry</h2>
    <p class="form-hint">Founder-population ancestry and consanguinity inform mutation-spectrum risk.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="consanguinity">Consanguinity in the family?</label>
            <select id="consanguinity" name="consanguinity_ancestry.consanguinity">
                <option value="" {% if consanguinity_ancestry.consanguinity == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if consanguinity_ancestry.consanguinity == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if consanguinity_ancestry.consanguinity == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="consanguinity_details">Consanguinity detail</label>
            <input type="text" id="consanguinity_details" name="consanguinity_ancestry.consanguinity_details"
                   value="{{ consanguinity_ancestry.consanguinityDetails }}"
                   placeholder="e.g. first cousins">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="maternal_ancestry">Maternal ancestry</label>
            <input type="text" id="maternal_ancestry" name="consanguinity_ancestry.maternal_ancestry"
                   value="{{ consanguinity_ancestry.maternalAncestry }}">
        </div>
        <div class="form-group">
            <label for="paternal_ancestry">Paternal ancestry</label>
            <input type="text" id="paternal_ancestry" name="consanguinity_ancestry.paternal_ancestry"
                   value="{{ consanguinity_ancestry.paternalAncestry }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ashkenazi_jewish">Ashkenazi Jewish ancestry?</label>
            <select id="ashkenazi_jewish" name="consanguinity_ancestry.ashkenazi_jewish">
                <option value="" {% if consanguinity_ancestry.ashkenaziJewish == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if consanguinity_ancestry.ashkenaziJewish == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if consanguinity_ancestry.ashkenaziJewish == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sephardic_jewish">Sephardic Jewish ancestry?</label>
            <select id="sephardic_jewish" name="consanguinity_ancestry.sephardic_jewish">
                <option value="" {% if consanguinity_ancestry.sephardicJewish == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if consanguinity_ancestry.sephardicJewish == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if consanguinity_ancestry.sephardicJewish == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="founding_population">Other founding population?</label>
            <select id="founding_population" name="consanguinity_ancestry.founding_population">
                <option value="" {% if consanguinity_ancestry.foundingPopulation == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if consanguinity_ancestry.foundingPopulation == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if consanguinity_ancestry.foundingPopulation == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="founding_population_details">Founding population detail (e.g. Quebecois, Finnish)</label>
        <input type="text" id="founding_population_details" name="consanguinity_ancestry.founding_population_details"
               value="{{ consanguinity_ancestry.foundingPopulationDetails }}">
    </div>
</div>
