<div class="card">
    <h2>Step 7: Prior Genetic Testing</h2>
    <p class="form-hint">Capture prior testing, VUS findings, known familial variants, and counselling history.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="prior_testing">Any prior genetic testing?</label>
            <select id="prior_testing" name="prior_genetic_testing.prior_testing">
                <option value="" {% if prior_genetic_testing.priorTesting == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prior_genetic_testing.priorTesting == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prior_genetic_testing.priorTesting == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="variants_of_uncertain_significance">VUS reported previously?</label>
            <select id="variants_of_uncertain_significance" name="prior_genetic_testing.variants_of_uncertain_significance">
                <option value="" {% if prior_genetic_testing.variantsOfUncertainSignificance == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prior_genetic_testing.variantsOfUncertainSignificance == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prior_genetic_testing.variantsOfUncertainSignificance == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="vus_details">VUS details</label>
        <textarea id="vus_details" name="prior_genetic_testing.variants_of_uncertain_significance_details">{{ prior_genetic_testing.variantsOfUncertainSignificanceDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="familial_variant_known">Known familial variant?</label>
            <select id="familial_variant_known" name="prior_genetic_testing.familial_variant_known">
                <option value="" {% if prior_genetic_testing.familialVariantKnown == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prior_genetic_testing.familialVariantKnown == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prior_genetic_testing.familialVariantKnown == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="prior_genetic_counselling">Prior genetic counselling?</label>
            <select id="prior_genetic_counselling" name="prior_genetic_testing.prior_genetic_counselling">
                <option value="" {% if prior_genetic_testing.priorGeneticCounselling == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if prior_genetic_testing.priorGeneticCounselling == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if prior_genetic_testing.priorGeneticCounselling == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="familial_variant_details">Familial variant detail</label>
        <textarea id="familial_variant_details" name="prior_genetic_testing.familial_variant_details">{{ prior_genetic_testing.familialVariantDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="prior_counselling_notes">Prior counselling notes</label>
        <textarea id="prior_counselling_notes" name="prior_genetic_testing.prior_counselling_notes">{{ prior_genetic_testing.priorCounsellingNotes }}</textarea>
    </div>
</div>
