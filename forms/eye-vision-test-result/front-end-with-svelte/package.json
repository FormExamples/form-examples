    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfmake": "^0.3.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
