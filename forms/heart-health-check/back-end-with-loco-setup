#!/bin/sh
set -euf

form_kebab_case=heart-health-check
form_snake_case=heart_health_check

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold assessment \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold demographics_ethnicity \
    deleted_at:tstz \
    assessment:references \
    age:int \
    sex:string! \
    ethnicity:string! \
    townsend_deprivation:double \
    --api

cargo loco generate scaffold blood_pressure \
    deleted_at:tstz \
    assessment:references \
    systolic_bp:int \
    systolic_bp_sd:double \
    diastolic_bp:int \
    on_bp_treatment:string! \
    number_of_bp_medications:int \
    --api

cargo loco generate scaffold cholesterol \
    deleted_at:tstz \
    assessment:references \
    total_cholesterol:double \
    hdl_cholesterol:double \
    total_hdl_ratio:double \
    on_statin:string! \
    --api

cargo loco generate scaffold medical_conditions \
    deleted_at:tstz \
    assessment:references \
    has_diabetes:string! \
    has_atrial_fibrillation:string! \
    has_rheumatoid_arthritis:string! \
    has_chronic_kidney_disease:string! \
    has_migraine:string! \
    has_severe_mental_illness:string! \
    has_erectile_dysfunction:string! \
    on_atypical_antipsychotic:string! \
    on_corticosteroids:string! \
    --api

cargo loco generate scaffold family_history \
    deleted_at:tstz \
    assessment:references \
    family_cvd_under_60:string! \
    family_cvd_relationship:string! \
    family_diabetes_history:string! \
    --api

cargo loco generate scaffold smoking_alcohol \
    deleted_at:tstz \
    assessment:references \
    smoking_status:string! \
    cigarettes_per_day:int \
    years_since_quit:int \
    alcohol_units_per_week:double \
    alcohol_frequency:string! \
    --api

cargo loco generate scaffold physical_activity_diet \
    deleted_at:tstz \
    assessment:references \
    physical_activity_minutes_per_week:int \
    activity_intensity:string! \
    fruit_veg_portions_per_day:int \
    diet_quality:string! \
    salt_intake:string! \
    --api

cargo loco generate scaffold body_measurements \
    deleted_at:tstz \
    assessment:references \
    height_cm:double \
    weight_kg:double \
    bmi:double \
    waist_circumference_cm:double \
    --api

cargo loco generate scaffold review_calculate \
    deleted_at:tstz \
    assessment:references \
    clinician_name:string! \
    review_date:date \
    clinical_notes:text! \
    audit_score:int \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    assessment:references \
    risk_category:string! \
    ten_year_risk_percent:double! \
    heart_age:int \
    graded_at:tstz \
    --api

cargo loco generate scaffold grading_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    risk_level:string! \
    --api

cargo loco generate scaffold grading_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"

# Fix two loco-new scaffold defaults that fail clippy -D warnings:
# App::seed()'s unused base param, and the test auth_header() helper's
# redundant &token.
"$(git rev-parse --show-toplevel)/bin/loco-seed-base-rename" "${form_kebab_case}"
"$(git rev-parse --show-toplevel)/bin/loco-test-auth-header-fix" "${form_kebab_case}"
