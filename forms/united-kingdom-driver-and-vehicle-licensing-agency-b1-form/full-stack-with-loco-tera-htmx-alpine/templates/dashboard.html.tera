{% extends "base.html.tera" %}

{% block title %}DVLA B1 — Dashboard{% endblock %}

{% block content %}
<div style="max-width:1100px;margin:2rem auto;padding:1rem;">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <h1>DVLA B1 — Clinician Dashboard</h1>
    <a href="/" style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border-radius:4px;text-decoration:none;">New Assessment</a>
  </div>

  <form method="GET" action="/dashboard" style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="flex:2;min-width:200px;">
      <label>Search</label>
      <input type="text" name="search" value="{{ search }}"
             placeholder="Patient name, postcode, or GP"
             style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
    </div>
    <div style="flex:1;min-width:160px;">
      <label>Complete</label>
      <select name="complete" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value="">All</option>
        <option value="yes" {% if complete == "yes" %}selected{% endif %}>Complete</option>
        <option value="no" {% if complete == "no" %}selected{% endif %}>Incomplete</option>
      </select>
    </div>
    <div style="flex:1;min-width:160px;">
      <label>Flags</label>
      <select name="has_flags" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <option value="">All</option>
        <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
        <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
      </select>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:flex-end;">
      <button type="submit" style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;">Filter</button>
      <a href="/dashboard" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">Clear</a>
    </div>
  </form>

  <p style="color:#555;">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

  {% if total > 0 %}
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr style="background:#f4f4f4;">
        <th style="padding:0.6rem 1rem;text-align:left;">Created</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Patient</th>
        <th style="padding:0.6rem 1rem;text-align:left;">DOB</th>
        <th style="padding:0.6rem 1rem;text-align:left;">Postcode</th>
        <th style="padding:0.6rem 1rem;text-align:left;">GP</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Complete</th>
        <th style="padding:0.6rem 1rem;text-align:right;">Flags</th>
      </tr>
    </thead>
    <tbody>
      {% for c in cases %}
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.6rem 1rem;"><a href="/assessment/{{ c.id }}/report">{{ c.createdAt }}</a></td>
        <td style="padding:0.6rem 1rem;">{{ c.fullName }}</td>
        <td style="padding:0.6rem 1rem;">{{ c.dateOfBirth }}</td>
        <td style="padding:0.6rem 1rem;">{{ c.postcode }}</td>
        <td style="padding:0.6rem 1rem;">{{ c.gpName }}</td>
        <td style="padding:0.6rem 1rem;text-align:right;">
          {% if c.complete %}<span style="color:#080;">Yes</span>{% else %}<span style="color:#a00;">{{ c.totalSatisfied }}/{{ c.totalRequired }}</span>{% endif %}
        </td>
        <td style="padding:0.6rem 1rem;text-align:right;">
          {% if c.urgentFlagCount > 0 %}<span style="color:#900;">URGENT × {{ c.urgentFlagCount }}</span>{% endif %}
          {% if c.highFlagCount > 0 %}<span style="color:#a35100;margin-left:0.4rem;">HIGH × {{ c.highFlagCount }}</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="text-align:center;color:#666;">No completed assessments found.</p>
  {% endif %}
</div>
{% endblock %}
