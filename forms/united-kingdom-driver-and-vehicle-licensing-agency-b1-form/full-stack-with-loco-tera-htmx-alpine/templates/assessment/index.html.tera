{% extends "base.html.tera" %}

{% block title %}DVLA B1 — Wizard{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>DVLA B1 — Confidential Medical Information</h1>
  <p style="color:#555;">Complete all {{ total_steps }} steps, then submit.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Personal Details -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Personal Details (Part A)</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>Title</label>
          <input type="text" name="title" value="{{ data.personalDetails.title }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Full Name</label>
          <input type="text" name="fullName" value="{{ data.personalDetails.fullName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date of Birth</label>
          <input type="date" name="dateOfBirth" value="{{ data.personalDetails.dateOfBirth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Address Line 1</label>
        <input type="text" name="addressLine1" value="{{ data.personalDetails.addressLine1 }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.6rem;">
        <label>Address Line 2</label>
        <input type="text" name="addressLine2" value="{{ data.personalDetails.addressLine2 }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.6rem;">
        <label>Address Line 3</label>
        <input type="text" name="addressLine3" value="{{ data.personalDetails.addressLine3 }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:140px;">
          <label>Postcode</label>
          <input type="text" name="postcode" value="{{ data.personalDetails.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Email</label>
          <input type="email" name="email" value="{{ data.personalDetails.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Contact Number</label>
          <input type="text" name="contactNumber" value="{{ data.personalDetails.contactNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Change of details (since last contact)</label>
        <textarea name="changeOfDetails" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.personalDetails.changeOfDetails }}</textarea>
      </div>
    </div>

    <!-- Step 2 — Healthcare Professionals -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Healthcare Professionals (Part B)</h2>
      <h3>GP</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>GP name</label>
          <input type="text" name="gpName" value="{{ data.healthcareProfessionals.gp.gpName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Surgery name</label>
          <input type="text" name="gpSurgeryName" value="{{ data.healthcareProfessionals.gp.surgeryName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:2;min-width:200px;">
          <label>Address</label>
          <input type="text" name="gpAddressLine1" value="{{ data.healthcareProfessionals.gp.addressLine1 }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Town</label>
          <input type="text" name="gpTown" value="{{ data.healthcareProfessionals.gp.town }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:120px;">
          <label>Postcode</label>
          <input type="text" name="gpPostcode" value="{{ data.healthcareProfessionals.gp.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:160px;">
          <label>Contact number</label>
          <input type="text" name="gpContactNumber" value="{{ data.healthcareProfessionals.gp.contactNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Email</label>
          <input type="email" name="gpEmail" value="{{ data.healthcareProfessionals.gp.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date last seen for this condition</label>
          <input type="date" name="gpDateLastSeen" value="{{ data.healthcareProfessionals.gp.dateLastSeen }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>

      <h3 style="margin-top:1.2rem;">Consultant (optional)</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Consultant name</label>
          <input type="text" name="consultantName" value="{{ data.healthcareProfessionals.consultant.consultantName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Speciality</label>
          <input type="text" name="consultantSpeciality" value="{{ data.healthcareProfessionals.consultant.speciality }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:1;min-width:200px;">
          <label>Hospital</label>
          <input type="text" name="hospitalName" value="{{ data.healthcareProfessionals.consultant.hospitalName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date last seen</label>
          <input type="date" name="consultantDateLastSeen" value="{{ data.healthcareProfessionals.consultant.dateLastSeen }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 3 — Q1 Condition History -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: Condition History (Q1)</h2>
      <p style="color:#666;">Tick all conditions that apply.</p>
      <div>
        <label>
          <input type="checkbox" name="brainHaemorrhage" value="on"
                 {% if data.conditionHistory.brainHaemorrhage %}checked{% endif %}>
          Brain haemorrhage (subarachnoid, aneurysm, AVM)
        </label>
        <div style="display:flex;gap:1rem;margin-top:0.4rem;">
          <input type="date" name="brainHaemorrhageDate" value="{{ data.conditionHistory.brainHaemorrhageDate }}"
                 style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <input type="text" name="brainHaemorrhageDetails" value="{{ data.conditionHistory.brainHaemorrhageDetails }}"
                 placeholder="Details" style="flex:1;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.8rem;">
        <label>
          <input type="checkbox" name="severeHeadInjury" value="on"
                 {% if data.conditionHistory.severeHeadInjury %}checked{% endif %}>
          Severe head injury involving in-patient treatment
        </label>
        <div style="display:flex;gap:1rem;margin-top:0.4rem;">
          <input type="date" name="severeHeadInjuryDate" value="{{ data.conditionHistory.severeHeadInjuryDate }}"
                 style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <input type="text" name="severeHeadInjuryDetails" value="{{ data.conditionHistory.severeHeadInjuryDetails }}"
                 placeholder="Details" style="flex:1;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.8rem;">
        <label>
          <input type="checkbox" name="otherCondition" value="on"
                 {% if data.conditionHistory.otherCondition %}checked{% endif %}>
          Other neurological condition
        </label>
        <div style="display:flex;gap:1rem;margin-top:0.4rem;">
          <input type="date" name="otherConditionDate" value="{{ data.conditionHistory.otherConditionDate }}"
                 style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <input type="text" name="otherConditionDetails" value="{{ data.conditionHistory.otherConditionDetails }}"
                 placeholder="Details" style="flex:1;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Brain surgery date</label>
        <input type="date" name="brainSurgeryDate" value="{{ data.conditionHistory.brainSurgeryDate }}"
               style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        <label style="margin-left:1rem;">
          <input type="checkbox" name="brainSurgeryNotApplicable" value="on"
                 {% if data.conditionHistory.brainSurgeryNotApplicable %}checked{% endif %}>
          Not applicable
        </label>
      </div>
    </div>

    <!-- Step 4 — Q2 Treatment Provider -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Treatment Provider (Q2)</h2>
      <div>
        <label>Who did you last see for this condition?</label>
        {% set v = data.treatmentProvider.lastSeen %}
        <select name="lastSeen" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="gp" {% if v == "gp" %}selected{% endif %}>GP</option>
          <option value="consultant" {% if v == "consultant" %}selected{% endif %}>Consultant</option>
        </select>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.8rem;">
        <div style="flex:1;min-width:160px;">
          <label>GP last contact date</label>
          <input type="date" name="gpLastContactDate" value="{{ data.treatmentProvider.gpLastContactDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>GP next contact date</label>
          <input type="date" name="gpNextContactDate" value="{{ data.treatmentProvider.gpNextContactDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Consultant last contact</label>
          <input type="date" name="consultantLastContactDate" value="{{ data.treatmentProvider.consultantLastContactDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Consultant next contact</label>
          <input type="date" name="consultantNextContactDate" value="{{ data.treatmentProvider.consultantNextContactDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 5 — Q3 Blackouts -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Blackouts (Q3)</h2>
      <div>
        <label>Have you had any blackouts or altered consciousness?</label>
        {% set v = data.blackouts.hadBlackouts %}
        <select name="hadBlackouts" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Date of blackout (if Yes)</label>
        <input type="date" name="blackoutDate" value="{{ data.blackouts.blackoutDate }}"
               style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 6 — Q4-Q6 Seizures -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Seizures (Q4–Q6)</h2>
      <div>
        <label>Q4: Have you ever had a seizure or epileptic attack?</label>
        {% set v = data.seizures.hadSeizures %}
        <select name="hadSeizures" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q4: Diagnosis</label>
        {% set v = data.seizures.diagnosis %}
        <select name="seizureDiagnosis" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="first-ever" {% if v == "first-ever" %}selected{% endif %}>First ever seizure</option>
          <option value="more-than-one-or-epilepsy" {% if v == "more-than-one-or-epilepsy" %}selected{% endif %}>More than one seizure / epilepsy</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q5: First-ever seizure date</label>
        <input type="date" name="firstEverSeizureDate" value="{{ data.seizures.firstEver.date }}"
               style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q5: Details</label>
        <textarea name="firstEverSeizureDetails" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.seizures.firstEver.details }}</textarea>
      </div>

      <h3 style="margin-top:1.2rem;">Q6 — Repeated seizures / epilepsy</h3>
      <div>
        <label>Q6a: Two or more seizures within 5 years?</label>
        {% set v = data.seizures.multiple.twoOrMoreWithinFiveYears %}
        <select name="twoOrMoreWithinFiveYears" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q6g: Have seizures affected your level of consciousness?</label>
        {% set v = data.seizures.multiple.affectedConsciousness %}
        <select name="affectedConsciousness" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q6h: Would they have affected vehicle control?</label>
        {% set v = data.seizures.multiple.wouldHaveAffectedDriving %}
        <select name="wouldHaveAffectedDriving" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q6i: Was the last seizure a result of medication advice from your doctor?</label>
        {% set v = data.seizures.multiple.resultOfMedicationAdvice %}
        <select name="resultOfMedicationAdvice" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>

      <h3 style="margin-top:1.2rem;">Epilepsy Declaration</h3>
      <p style="color:#666;font-size:0.9rem;">Required if you have declared epilepsy or more than one lifetime seizure.</p>
      <div>
        <label>
          <input type="checkbox" name="epilepsyDeclarationAccepted" value="on"
                 {% if data.seizures.epilepsyDeclaration.declarationAccepted %}checked{% endif %}>
          I accept the epilepsy declaration.
        </label>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.6rem;">
        <div style="flex:2;min-width:200px;">
          <label>Signed name</label>
          <input type="text" name="epilepsySignedName" value="{{ data.seizures.epilepsyDeclaration.signedName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="epilepsySignatureDate" value="{{ data.seizures.epilepsyDeclaration.signatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 7 — Q7 Medication -->
    <div x-show="step === 7" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 7: Medication (Q7)</h2>
      <div>
        <label>
          <input type="checkbox" name="noMedicationTaken" value="on"
                 {% if data.medication.noMedicationTaken %}checked{% endif %}>
          No medication taken.
        </label>
      </div>
      {% for i in range(start=1, end=4) %}
        {% set entry_index = i - 1 %}
        {% set has_entry = data.medication.entries | length > entry_index %}
        <div style="margin-top:0.6rem;display:flex;gap:0.6rem;flex-wrap:wrap;">
          <input type="text" name="medName{{ i }}"
                 value="{% if has_entry %}{{ data.medication.entries[entry_index].name }}{% endif %}"
                 placeholder="Medication name"
                 style="flex:2;min-width:160px;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <input type="date" name="medStart{{ i }}"
                 value="{% if has_entry %}{{ data.medication.entries[entry_index].startDate }}{% endif %}"
                 style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <input type="date" name="medEnd{{ i }}"
                 value="{% if has_entry %}{{ data.medication.entries[entry_index].endDate }}{% endif %}"
                 style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      {% endfor %}
      <div style="margin-top:0.8rem;">
        <label>Q7a: Does your medication make you drowsy or confused when driving?</label>
        {% set v = data.medication.makesDrowsyOrConfused %}
        <select name="makesDrowsyOrConfused" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
    </div>

    <!-- Step 8 — Q8 VP Shunt -->
    <div x-show="step === 8" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 8: VP Shunt (Q8)</h2>
      <div>
        <label>Have you had a VP shunt or external ventricular drain?</label>
        {% set v = data.vpShunt.hadVpShuntOrDrain %}
        <select name="hadVpShuntOrDrain" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Date of procedure (if Yes)</label>
        <input type="date" name="vpShuntProcedureDate" value="{{ data.vpShunt.procedureDate }}"
               style="padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 9 — Q9 Daily Living -->
    <div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 9: Daily Living (Q9)</h2>
      <div>
        <label>Do you need help from another person with day-to-day living?</label>
        {% set v = data.dailyLiving.needsHelp %}
        <select name="needsHelp" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>If Yes, please describe the help you receive</label>
        <textarea name="helpDetails" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.dailyLiving.helpDetails }}</textarea>
      </div>
    </div>

    <!-- Step 10 — Q10 Double Vision -->
    <div x-show="step === 10" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 10: Double Vision (Q10)</h2>
      <div>
        <label>Do you have double vision (diplopia)?</label>
        {% set v = data.doubleVision.hasDoubleVision %}
        <select name="hasDoubleVision" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q10a: Is your double vision suppressed or controlled?</label>
        {% set v = data.doubleVision.suppressedOrControlled %}
        <select name="suppressedOrControlled" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q10b: Correction method</label>
        {% set v = data.doubleVision.correctionMethod %}
        <select name="correctionMethod" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="patch" {% if v == "patch" %}selected{% endif %}>Patch</option>
          <option value="prism" {% if v == "prism" %}selected{% endif %}>Prism</option>
          <option value="glasses-or-lenses" {% if v == "glasses-or-lenses" %}selected{% endif %}>Glasses or contact lenses</option>
          <option value="other" {% if v == "other" %}selected{% endif %}>Other</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Other correction method (if "Other" selected)</label>
        <input type="text" name="correctionMethodOther" value="{{ data.doubleVision.correctionMethodOther }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
    </div>

    <!-- Step 11 — Q11 Eyesight -->
    <div x-show="step === 11" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 11: Eyesight (Q11)</h2>
      <div>
        <label>Are there eyesight problems caused by your condition?</label>
        {% set v = data.eyesight.hasEyesightProblems %}
        <select name="hasEyesightProblems" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>If Yes, please describe</label>
        <textarea name="eyesightDetails" rows="3"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.eyesight.details }}</textarea>
      </div>
    </div>

    <!-- Step 12 — Q12 Vehicle Adaptations -->
    <div x-show="step === 12" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 12: Vehicle Adaptations (Q12)</h2>
      <div>
        <label>Q12: Do you need special controls or automatic transmission?</label>
        {% set v = data.vehicleAdaptations.needsAdaptations %}
        <select name="needsAdaptations" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q12a: Have you previously declared the need for special controls?</label>
        {% set v = data.vehicleAdaptations.previouslyDeclared %}
        <select name="previouslyDeclared" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Q12b: Have additional controls been fitted since last licence?</label>
        {% set v = data.vehicleAdaptations.additionalControlsFitted %}
        <select name="additionalControlsFitted" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
    </div>

    <!-- Step 13 — Authorisation -->
    <div x-show="step === 13" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 13: Applicant's Authorisation</h2>
      <p style="color:#666;font-size:0.9rem;">DVLA cannot process your form without authorisation.</p>
      <div>
        <label>
          <input type="checkbox" name="authorisationAccepted" value="on"
                 {% if data.authorisation.declarationAccepted %}checked{% endif %}>
          I accept the medical disclosure authorisation.
        </label>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.8rem;">
        <div style="flex:2;min-width:200px;">
          <label>Name</label>
          <input type="text" name="authorisationName" value="{{ data.authorisation.name }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="authorisationSignatureDate" value="{{ data.authorisation.signatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:0.8rem;">
        <label>Consent to electronic correspondence?</label>
        {% set v = data.authorisation.electronicCorrespondenceConsent %}
        <select name="electronicCorrespondenceConsent" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.8rem;">
        <div style="flex:1;min-width:160px;">
          <label>DVLA contact preference</label>
          {% set v = data.authorisation.dvlaContactPreference %}
          <select name="dvlaContactPreference" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="email" {% if v == "email" %}selected{% endif %}>Email</option>
            <option value="sms" {% if v == "sms" %}selected{% endif %}>SMS</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Healthcare professional contact preference</label>
          {% set v = data.authorisation.healthcareContactPreference %}
          <select name="healthcareContactPreference" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="email" {% if v == "email" %}selected{% endif %}>Email</option>
            <option value="sms" {% if v == "sms" %}selected{% endif %}>SMS</option>
          </select>
        </div>
      </div>
      <p style="color:#666;font-size:0.9rem;margin-top:1rem;">Assessment ID: {{ id }}</p>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;margin-top:1.5rem;">
      <button type="button" @click="if(step > 1) step--" :disabled="step === 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        &laquo; Previous
      </button>
      <button type="button" @click="if(step < totalSteps) step++" x-show="step < totalSteps"
              style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Next &raquo;
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.4rem;background:#28a745;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">
        Submit
      </button>
    </div>
  </form>
</div>
{% endblock %}
