<!-- Step 9 — Q9 Daily Living -->
<div x-show="step === 9" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
  <h2>Step 9: Daily Living (Q9)</h2>
  <div>
    <label>Do you need help from another person with day-to-day living?</label>
    {% set v = data.dailyLiving.needsHelp %}
    <select name="needsHelp" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      <option value="">— select —</option>
      <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
      <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
    </select>
  </div>
  <div style="margin-top:0.8rem;">
    <label>If Yes, please describe the help you receive</label>
    <textarea name="helpDetails" rows="3"
              style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.dailyLiving.helpDetails }}</textarea>
  </div>
</div>
