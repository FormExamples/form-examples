{% extends "base.html.tera" %}

{% block title %}DVLA B1 — Confidential Medical Information{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>DVLA B1 — Confidential Medical Information (Neurological)</h1>
  <p>
    Structured data-collection questionnaire for the UK Driver and Vehicle
    Licensing Agency. Captures personal details, healthcare professional
    contacts, and answers to medical questions Q1–Q12 (condition history,
    treatment, blackouts, seizures, medication, VP shunt, daily living, double
    vision, eyesight, and vehicle adaptations) plus the applicant's
    authorisation.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>13 Steps</h3>
      <p>Personal Details, Healthcare Professionals, Q1–Q12, and Authorisation.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Completeness</h3>
      <p>41 validation rules with conditional <em>applies</em> predicates check the form for missing answers.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Epilepsy declaration, drowsy medication, uncontrolled diplopia, and other clinically significant items escalate for clinician review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New Assessment
    </button>
  </form>
  <p style="margin-top:1rem;"><a href="/dashboard">View completed assessments dashboard &raquo;</a></p>
</div>
{% endblock %}
