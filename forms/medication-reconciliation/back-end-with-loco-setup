#!/bin/sh
set -euf

form_kebab_case=medication-reconciliation
form_snake_case=medication_reconciliation

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold medication_reconciliation \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    reconciliation_type:string! \
    care_setting:string! \
    reconciled_at:tstz \
    clinician_name:text! \
    clinician_role:string! \
    patient_identifier:text! \
    age_band:string! \
    sex:string! \
    weight_kg:double \
    allergy_status:string! \
    --api

cargo loco generate scaffold medication_reconciliation_line_item \
    deleted_at:tstz \
    medication_reconciliation:references \
    list_source:string! \
    drug_name:text! \
    form:text! \
    dose:text! \
    route:string! \
    frequency:text! \
    indication:text! \
    high_risk_class:string! \
    adherence:string! \
    source_type:string! \
    status:string! \
    --api

cargo loco generate scaffold medication_reconciliation_information_source \
    deleted_at:tstz \
    medication_reconciliation:references \
    source_type:string! \
    verified:bool! \
    --api

cargo loco generate scaffold medication_reconciliation_allergy \
    deleted_at:tstz \
    medication_reconciliation:references \
    substance:text! \
    reaction_type:string! \
    severity:string! \
    --api

cargo loco generate scaffold medication_reconciliation_discrepancy \
    deleted_at:tstz \
    medication_reconciliation:references \
    discrepancy_type:string! \
    bpmh_item_ref:text! \
    inpatient_item_ref:text! \
    intended_action:string! \
    rationale:text! \
    intentional:bool! \
    --api

cargo loco generate scaffold medication_reconciliation_grade \
    deleted_at:tstz \
    medication_reconciliation:references \
    status:string! \
    source_count:int! \
    unintentional_count:int! \
    high_risk_unintentional_count:int! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold medication_reconciliation_grade_rule \
    deleted_at:tstz \
    medication_reconciliation_grade:references \
    rule_id:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold medication_reconciliation_grade_flag \
    deleted_at:tstz \
    medication_reconciliation_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
