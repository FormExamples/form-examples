{% extends "base.html.tera" %}

{% block title %}Learning Disability Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Learning Disability Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, NHS number, or GP practice...">
    </div>
    <div class="form-group">
        <label for="severity_category">Severity</label>
        <select id="severity_category" name="severity_category">
            <option value="">All</option>
            <option value="mild" {% if severity_category == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if severity_category == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if severity_category == "severe" %}selected{% endif %}>Severe</option>
            <option value="profound" {% if severity_category == "profound" %}selected{% endif %}>Profound</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High/Urgent Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>NHS Number</th>
            <th>GP Practice</th>
            <th>Severity</th>
            <th>Adaptive Score</th>
            <th>Answered</th>
            <th>Urgent / High Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.patientName }}</a></td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.nhsNumber }}</td>
            <td>{{ c.gpPractice }}</td>
            <td><span class="severity-badge sev-{{ c.severityCategory }}">{{ c.severityCategory }}</span></td>
            <td>{{ c.adaptiveScore }} / 3</td>
            <td>{{ c.answeredCount }} / 10</td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }} urgent</span>
                {% endif %}
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }} high</span>
                {% endif %}
                {% if c.urgentFlagCount == 0 and c.highPriorityFlagCount == 0 %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
