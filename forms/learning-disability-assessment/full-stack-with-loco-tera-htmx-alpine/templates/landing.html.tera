{% extends "base.html.tera" %}

{% block title %}Learning Disability Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Learning Disability Assessment</h1>
        <p class="landing-description">
            Structured annual health check and adaptive-functioning assessment for people with a
            learning disability, aligned with the NHS England Annual Health Check and DSM-5-TR /
            ICD-11 criteria. The output is a severity category (Mild / Moderate / Severe /
            Profound) and a personalised Health Action Plan with reasonable adjustments.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Demographics, carer support, communication, medical review, physical exam, adaptive functioning, behavioural concerns, capacity, adjustments, action plan</p>
            </div>
            <div class="feature">
                <h3>Adaptive Functioning Scoring</h3>
                <p>10 items across conceptual, social, and practical domains; severity derived from the mean per-item score</p>
            </div>
            <div class="feature">
                <h3>Clinician Flags</h3>
                <p>Epilepsy, STOMP, dysphagia, missed screening, behavioural risk, capacity, communication, and reasonable adjustments</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
