<div class="card">
    <h2>Step 9: Reasonable Adjustments Required</h2>
    <p class="form-hint">
        Adjustments that make NHS services accessible (Equality Act 2010 / Accessible Information
        Standard).
    </p>

    {% for item in [
        {"id": "needs_longer_appointments", "name": "needsLongerAppointments", "label": "Needs longer appointments?"},
        {"id": "needs_quiet_room", "name": "needsQuietRoom", "label": "Needs a quiet room or low-stimulation environment?"},
        {"id": "needs_familiar_staff", "name": "needsFamiliarStaff", "label": "Needs a familiar staff member or carer present?"},
        {"id": "needs_easy_read_letters", "name": "needsEasyReadLetters", "label": "Needs Easy Read letters and information?"},
        {"id": "needs_home_visits", "name": "needsHomeVisits", "label": "Needs home visits rather than clinic appointments?"},
        {"id": "needs_double_appointment", "name": "needsDoubleAppointment", "label": "Needs a double-length appointment slot?"},
        {"id": "flag_on_record", "name": "flagOnRecord", "label": "Reasonable adjustments flag set on patient record?"}
    ] %}
    <div class="form-group">
        <label for="{{ item.id }}">{{ item.label }}</label>
        <select id="{{ item.id }}" name="reasonable_adjustments.{{ item.id }}">
            <option value="" {% if reasonable_adjustments[item.name] == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if reasonable_adjustments[item.name] == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if reasonable_adjustments[item.name] == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    {% endfor %}

    <div class="form-group">
        <label for="other_adjustments">Other reasonable adjustments</label>
        <textarea id="other_adjustments" name="reasonable_adjustments.other_adjustments"
                  placeholder="Any other adjustments needed for fair access to services&hellip;">{{ reasonable_adjustments.otherAdjustments }}</textarea>
    </div>
</div>
