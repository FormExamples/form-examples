<div class="card">
    <h2>Step 5: Physical Examination &amp; Observations</h2>
    <p class="form-hint">Vital signs, BMI, and national screening status.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="weight">Weight (kg)</label>
            <input type="number" step="0.1" min="1" max="400" id="weight" name="physical_examination.weight"
                   value="{{ physical_examination.weight }}">
        </div>
        <div class="form-group">
            <label for="height">Height (cm)</label>
            <input type="number" step="0.1" min="50" max="250" id="height" name="physical_examination.height"
                   value="{{ physical_examination.height }}">
        </div>
        <div class="form-group">
            <label>BMI (auto-calculated)</label>
            <output>{{ physical_examination.bmi }}</output>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="blood_pressure_systolic">Systolic BP (mmHg)</label>
            <input type="number" min="50" max="260" id="blood_pressure_systolic" name="physical_examination.blood_pressure_systolic"
                   value="{{ physical_examination.bloodPressureSystolic }}">
        </div>
        <div class="form-group">
            <label for="blood_pressure_diastolic">Diastolic BP (mmHg)</label>
            <input type="number" min="30" max="180" id="blood_pressure_diastolic" name="physical_examination.blood_pressure_diastolic"
                   value="{{ physical_examination.bloodPressureDiastolic }}">
        </div>
        <div class="form-group">
            <label for="pulse">Pulse (bpm)</label>
            <input type="number" min="30" max="220" id="pulse" name="physical_examination.pulse"
                   value="{{ physical_examination.pulse }}">
        </div>
    </div>

    <div class="form-group">
        <label for="vision_checked">Vision check up to date?</label>
        <select id="vision_checked" name="physical_examination.vision_checked">
            <option value="" {% if physical_examination.visionChecked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.visionChecked == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.visionChecked == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.visionChecked == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="hearing_checked">Hearing check up to date?</label>
        <select id="hearing_checked" name="physical_examination.hearing_checked">
            <option value="" {% if physical_examination.hearingChecked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.hearingChecked == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.hearingChecked == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.hearingChecked == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="dental_checked">Dental check up to date?</label>
        <select id="dental_checked" name="physical_examination.dental_checked">
            <option value="" {% if physical_examination.dentalChecked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.dentalChecked == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.dentalChecked == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.dentalChecked == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="vaccinations_up_to_date">Vaccinations up to date?</label>
        <select id="vaccinations_up_to_date" name="physical_examination.vaccinations_up_to_date">
            <option value="" {% if physical_examination.vaccinationsUpToDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.vaccinationsUpToDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.vaccinationsUpToDate == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.vaccinationsUpToDate == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="cervical_screening">Cervical screening up to date (if applicable)?</label>
        <select id="cervical_screening" name="physical_examination.cervical_screening">
            <option value="" {% if physical_examination.cervicalScreening == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.cervicalScreening == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.cervicalScreening == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.cervicalScreening == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="breast_screening">Breast screening up to date (if applicable)?</label>
        <select id="breast_screening" name="physical_examination.breast_screening">
            <option value="" {% if physical_examination.breastScreening == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.breastScreening == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.breastScreening == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.breastScreening == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="bowel_screening">Bowel cancer screening up to date (if applicable)?</label>
        <select id="bowel_screening" name="physical_examination.bowel_screening">
            <option value="" {% if physical_examination.bowelScreening == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if physical_examination.bowelScreening == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if physical_examination.bowelScreening == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if physical_examination.bowelScreening == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>
</div>
