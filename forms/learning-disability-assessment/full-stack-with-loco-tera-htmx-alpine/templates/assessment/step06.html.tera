<div class="card">
    <h2>Step 6: Adaptive Functioning</h2>
    <p class="form-hint">
        Day-to-day functioning across the conceptual, social, and practical domains. This section
        drives the severity classification.
    </p>

    <h3>Conceptual domain</h3>
    {% for item in [
        {"id": "conceptual_language", "name": "conceptualLanguage", "label": "Language and vocabulary"},
        {"id": "conceptual_reading_writing", "name": "conceptualReadingWriting", "label": "Reading and writing"},
        {"id": "conceptual_money_time", "name": "conceptualMoneyTime", "label": "Money, time, and number concepts"}
    ] %}
    <div class="form-group">
        <label for="{{ item.id }}">{{ item.label }}</label>
        <select id="{{ item.id }}" name="adaptive_functioning.{{ item.id }}">
            <option value="" {% if adaptive_functioning[item.name] == "" %}selected{% endif %}>&mdash;</option>
            <option value="independent" {% if adaptive_functioning[item.name] == "independent" %}selected{% endif %}>Independent</option>
            <option value="some-support" {% if adaptive_functioning[item.name] == "some-support" %}selected{% endif %}>Some support</option>
            <option value="significant-support" {% if adaptive_functioning[item.name] == "significant-support" %}selected{% endif %}>Significant support</option>
            <option value="full-support" {% if adaptive_functioning[item.name] == "full-support" %}selected{% endif %}>Full support</option>
        </select>
    </div>
    {% endfor %}

    <h3>Social domain</h3>
    {% for item in [
        {"id": "social_friendships", "name": "socialFriendships", "label": "Friendships and relationships"},
        {"id": "social_empathy", "name": "socialEmpathy", "label": "Empathy and social judgement"},
        {"id": "social_communication", "name": "socialCommunication", "label": "Social communication"}
    ] %}
    <div class="form-group">
        <label for="{{ item.id }}">{{ item.label }}</label>
        <select id="{{ item.id }}" name="adaptive_functioning.{{ item.id }}">
            <option value="" {% if adaptive_functioning[item.name] == "" %}selected{% endif %}>&mdash;</option>
            <option value="independent" {% if adaptive_functioning[item.name] == "independent" %}selected{% endif %}>Independent</option>
            <option value="some-support" {% if adaptive_functioning[item.name] == "some-support" %}selected{% endif %}>Some support</option>
            <option value="significant-support" {% if adaptive_functioning[item.name] == "significant-support" %}selected{% endif %}>Significant support</option>
            <option value="full-support" {% if adaptive_functioning[item.name] == "full-support" %}selected{% endif %}>Full support</option>
        </select>
    </div>
    {% endfor %}

    <h3>Practical domain</h3>
    {% for item in [
        {"id": "practical_self_care", "name": "practicalSelfCare", "label": "Personal self-care (washing, dressing, eating)"},
        {"id": "practical_home_living", "name": "practicalHomeLiving", "label": "Home living (cooking, cleaning, household tasks)"},
        {"id": "practical_community", "name": "practicalCommunity", "label": "Community use (shopping, transport, money)"},
        {"id": "practical_work_school", "name": "practicalWorkSchool", "label": "Work or school skills"}
    ] %}
    <div class="form-group">
        <label for="{{ item.id }}">{{ item.label }}</label>
        <select id="{{ item.id }}" name="adaptive_functioning.{{ item.id }}">
            <option value="" {% if adaptive_functioning[item.name] == "" %}selected{% endif %}>&mdash;</option>
            <option value="independent" {% if adaptive_functioning[item.name] == "independent" %}selected{% endif %}>Independent</option>
            <option value="some-support" {% if adaptive_functioning[item.name] == "some-support" %}selected{% endif %}>Some support</option>
            <option value="significant-support" {% if adaptive_functioning[item.name] == "significant-support" %}selected{% endif %}>Significant support</option>
            <option value="full-support" {% if adaptive_functioning[item.name] == "full-support" %}selected{% endif %}>Full support</option>
        </select>
    </div>
    {% endfor %}
</div>
