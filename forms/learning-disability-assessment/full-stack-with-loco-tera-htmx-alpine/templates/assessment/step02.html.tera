<div class="card">
    <h2>Step 2: Carer &amp; Support Network</h2>
    <p class="form-hint">Who supports the person day to day.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="primary_carer_name">Primary carer name</label>
            <input type="text" id="primary_carer_name" name="carer_support.primary_carer_name"
                   value="{{ carer_support.primaryCarerName }}">
        </div>
        <div class="form-group">
            <label for="primary_carer_relationship">Relationship</label>
            <input type="text" id="primary_carer_relationship" name="carer_support.primary_carer_relationship"
                   value="{{ carer_support.primaryCarerRelationship }}" placeholder="e.g. mother, paid carer">
        </div>
    </div>

    <div class="form-group">
        <label for="primary_carer_phone">Primary carer phone</label>
        <input type="tel" id="primary_carer_phone" name="carer_support.primary_carer_phone"
               value="{{ carer_support.primaryCarerPhone }}">
    </div>

    <div class="form-group">
        <label for="lives_with_carer">Does the person live with their primary carer?</label>
        <select id="lives_with_carer" name="carer_support.lives_with_carer">
            <option value="" {% if carer_support.livesWithCarer == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if carer_support.livesWithCarer == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if carer_support.livesWithCarer == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="living_arrangement">Living arrangement</label>
        <input type="text" id="living_arrangement" name="carer_support.living_arrangement"
               value="{{ carer_support.livingArrangement }}"
               placeholder="e.g. supported living, family home, residential care">
    </div>

    <div class="form-group">
        <label for="has_support_plan">Is there a documented support plan?</label>
        <select id="has_support_plan" name="carer_support.has_support_plan">
            <option value="" {% if carer_support.hasSupportPlan == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if carer_support.hasSupportPlan == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if carer_support.hasSupportPlan == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="has_social_worker">Does the person have a social worker?</label>
        <select id="has_social_worker" name="carer_support.has_social_worker">
            <option value="" {% if carer_support.hasSocialWorker == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if carer_support.hasSocialWorker == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if carer_support.hasSocialWorker == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="social_worker_name">Social worker name</label>
        <input type="text" id="social_worker_name" name="carer_support.social_worker_name"
               value="{{ carer_support.socialWorkerName }}">
    </div>

    <div class="form-group">
        <label for="other_supports">Other supports (day services, advocacy, charities)</label>
        <textarea id="other_supports" name="carer_support.other_supports"
                  placeholder="Other supports&hellip;">{{ carer_support.otherSupports }}</textarea>
    </div>
</div>
