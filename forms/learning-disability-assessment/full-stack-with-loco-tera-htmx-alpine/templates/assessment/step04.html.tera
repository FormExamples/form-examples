<div class="card">
    <h2>Step 4: Medical Review</h2>
    <p class="form-hint">Epilepsy, mental health, medications, and common comorbidities.</p>

    <div class="form-group">
        <label for="has_epilepsy">Does the person have epilepsy?</label>
        <select id="has_epilepsy" name="medical_review.has_epilepsy">
            <option value="" {% if medical_review.hasEpilepsy == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasEpilepsy == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasEpilepsy == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="last_seizure_date">Date of last seizure</label>
            <input type="date" id="last_seizure_date" name="medical_review.last_seizure_date"
                   value="{{ medical_review.lastSeizureDate }}">
        </div>
        <div class="form-group">
            <label for="seizures_per_month">Average seizures per month</label>
            <input type="number" min="0" max="200" id="seizures_per_month" name="medical_review.seizures_per_month"
                   value="{{ medical_review.seizuresPerMonth }}">
        </div>
    </div>

    <div class="form-group">
        <label for="has_mental_health_diagnosis">Does the person have a mental health diagnosis?</label>
        <select id="has_mental_health_diagnosis" name="medical_review.has_mental_health_diagnosis">
            <option value="" {% if medical_review.hasMentalHealthDiagnosis == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasMentalHealthDiagnosis == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasMentalHealthDiagnosis == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="mental_health_details">Mental health diagnosis details</label>
        <input type="text" id="mental_health_details" name="medical_review.mental_health_details"
               value="{{ medical_review.mentalHealthDetails }}">
    </div>

    <div class="form-group">
        <label for="takes_psychotropic">Does the person take psychotropic medication?</label>
        <select id="takes_psychotropic" name="medical_review.takes_psychotropic">
            <option value="" {% if medical_review.takesPsychotropic == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.takesPsychotropic == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.takesPsychotropic == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="stomp_review_done">STOMP medication review in the last 12 months?</label>
        <select id="stomp_review_done" name="medical_review.stomp_review_done">
            <option value="" {% if medical_review.stompReviewDone == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.stompReviewDone == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.stompReviewDone == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="current_medications">Current medications (name, dose, frequency)</label>
        <textarea id="current_medications" name="medical_review.current_medications"
                  placeholder="List all regular medications&hellip;">{{ medical_review.currentMedications }}</textarea>
    </div>

    <div class="form-group">
        <label for="has_dysphagia">Dysphagia (difficulty swallowing)?</label>
        <select id="has_dysphagia" name="medical_review.has_dysphagia">
            <option value="" {% if medical_review.hasDysphagia == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasDysphagia == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasDysphagia == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="has_constipation">Persistent constipation?</label>
        <select id="has_constipation" name="medical_review.has_constipation">
            <option value="" {% if medical_review.hasConstipation == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasConstipation == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasConstipation == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="has_incontinence">Bladder or bowel incontinence?</label>
        <select id="has_incontinence" name="medical_review.has_incontinence">
            <option value="" {% if medical_review.hasIncontinence == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasIncontinence == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasIncontinence == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="has_sleep_problems">Sleep problems?</label>
        <select id="has_sleep_problems" name="medical_review.has_sleep_problems">
            <option value="" {% if medical_review.hasSleepProblems == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if medical_review.hasSleepProblems == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if medical_review.hasSleepProblems == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="other_medical_issues">Other medical issues</label>
        <textarea id="other_medical_issues" name="medical_review.other_medical_issues">{{ medical_review.otherMedicalIssues }}</textarea>
    </div>
</div>
