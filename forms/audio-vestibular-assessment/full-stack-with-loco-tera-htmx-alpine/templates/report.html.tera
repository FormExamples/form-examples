{% extends "base.html.tera" %}

{% block title %}Audio-Vestibular Assessment Report{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Audio-Vestibular Assessment &mdash; Report</h1>
    <div class="checklist-badge {{ hearing_loss_grade_class }}">{{ hearing_loss_grade_label }}</div>
    <div class="checklist-badge {{ dhi_handicap_class }}">DHI {{ grade.dhiTotal }}/100 &mdash; {{ dhi_handicap_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ grade.timestamp }}
    </p>
</div>

<!-- Patient summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}
        </div>
        <div>
            <strong>Assessment Date:</strong> {{ data.demographics.assessmentDate }}
        </div>
    </div>
</div>

<!-- Pure-tone audiometry -->
<div class="card">
    <h2>Pure-Tone Audiometry</h2>
    <table class="phase-table">
        <thead>
            <tr><th></th><th>Right Ear</th><th>Left Ear</th><th>Better Ear</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>4-frequency PTA (dB HL)</td>
                <td>{% if grade.rightPta %}{{ grade.rightPta }}{% else %}&mdash;{% endif %}</td>
                <td>{% if grade.leftPta %}{{ grade.leftPta }}{% else %}&mdash;{% endif %}</td>
                <td>{% if grade.betterEarPta %}{{ grade.betterEarPta }}{% else %}&mdash;{% endif %}</td>
            </tr>
            <tr>
                <td>WHO grade</td>
                <td>{{ grade.rightHearingLossGrade }}</td>
                <td>{{ grade.leftHearingLossGrade }}</td>
                <td>{{ grade.hearingLossGrade }}</td>
            </tr>
            <tr>
                <td>Inter-aural asymmetry (dB)</td>
                <td colspan="3">{% if grade.asymmetry %}{{ grade.asymmetry }}{% else %}&mdash;{% endif %}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- DHI -->
<div class="card">
    <h2>Dizziness Handicap Inventory</h2>
    <table class="phase-table">
        <thead>
            <tr><th></th><th>Total</th><th>Functional</th><th>Emotional</th><th>Physical</th><th>Answered</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>Score (max 100 / 28 / 36 / 36)</td>
                <td>{{ grade.dhiTotal }}</td>
                <td>{{ grade.dhiFunctional }}</td>
                <td>{{ grade.dhiEmotional }}</td>
                <td>{{ grade.dhiPhysical }}</td>
                <td>{{ grade.dhiAnsweredCount }}/25</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Clinical flags -->
{% if grade.additionalFlags | length > 0 %}
<div class="card">
    <h2>Clinical Flags ({{ grade.additionalFlags | length }})</h2>
    <div class="flags-section">
        {% for flag in grade.additionalFlags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Clinical impression -->
<div class="card">
    <h2>Clinical Impression &amp; Referral</h2>
    <p><strong>Provisional diagnosis:</strong> {{ data.clinicalImpressionReferral.provisionalDiagnosis }}</p>
    <p><strong>Hearing-aid candidate:</strong> {{ data.clinicalImpressionReferral.hearingAidCandidate }}</p>
    <p><strong>Vestibular rehab indicated:</strong> {{ data.clinicalImpressionReferral.vestibularRehabIndicated }}</p>
    <p><strong>ENT referral:</strong> {{ data.clinicalImpressionReferral.entReferral }}</p>
    <p><strong>Neurology referral:</strong> {{ data.clinicalImpressionReferral.neurologyReferral }}</p>
    <p><strong>Imaging requested:</strong> {{ data.clinicalImpressionReferral.imagingRequested }}</p>
    {% if data.clinicalImpressionReferral.followUpWeeks %}
    <p><strong>Follow-up:</strong> {{ data.clinicalImpressionReferral.followUpWeeks }} weeks</p>
    {% endif %}
    {% if data.clinicalImpressionReferral.additionalNotes %}
    <p><strong>Notes:</strong> {{ data.clinicalImpressionReferral.additionalNotes }}</p>
    {% endif %}
</div>

<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
