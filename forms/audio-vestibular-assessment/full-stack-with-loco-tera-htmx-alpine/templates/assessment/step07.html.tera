<div class="card">
    <h2>Step 7: Vestibular Screening</h2>
    <p class="form-hint">Bedside vestibular tests: HIT, Dix-Hallpike, Romberg, tandem gait, nystagmus, Fukuda.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="head_impulse_test">Head-Impulse Test</label>
            <select id="head_impulse_test" name="vestibular_screening.head_impulse_test">
                <option value="" {% if vestibular_screening.headImpulseTest == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if vestibular_screening.headImpulseTest == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal-right" {% if vestibular_screening.headImpulseTest == "abnormal-right" %}selected{% endif %}>Abnormal right</option>
                <option value="abnormal-left" {% if vestibular_screening.headImpulseTest == "abnormal-left" %}selected{% endif %}>Abnormal left</option>
                <option value="not-done" {% if vestibular_screening.headImpulseTest == "not-done" %}selected{% endif %}>Not done</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dix_hallpike">Dix-Hallpike</label>
            <select id="dix_hallpike" name="vestibular_screening.dix_hallpike">
                <option value="" {% if vestibular_screening.dixHallpike == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if vestibular_screening.dixHallpike == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive-right" {% if vestibular_screening.dixHallpike == "positive-right" %}selected{% endif %}>Positive right</option>
                <option value="positive-left" {% if vestibular_screening.dixHallpike == "positive-left" %}selected{% endif %}>Positive left</option>
                <option value="bilateral" {% if vestibular_screening.dixHallpike == "bilateral" %}selected{% endif %}>Bilateral positive</option>
                <option value="not-done" {% if vestibular_screening.dixHallpike == "not-done" %}selected{% endif %}>Not done</option>
            </select>
        </div>
        <div class="form-group">
            <label for="romberg_test">Romberg</label>
            <select id="romberg_test" name="vestibular_screening.romberg_test">
                <option value="" {% if vestibular_screening.rombergTest == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if vestibular_screening.rombergTest == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if vestibular_screening.rombergTest == "abnormal" %}selected{% endif %}>Abnormal</option>
                <option value="unable" {% if vestibular_screening.rombergTest == "unable" %}selected{% endif %}>Unable</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tandem_gait">Tandem gait</label>
            <select id="tandem_gait" name="vestibular_screening.tandem_gait">
                <option value="" {% if vestibular_screening.tandemGait == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if vestibular_screening.tandemGait == "normal" %}selected{% endif %}>Normal</option>
                <option value="abnormal" {% if vestibular_screening.tandemGait == "abnormal" %}selected{% endif %}>Abnormal</option>
                <option value="unable" {% if vestibular_screening.tandemGait == "unable" %}selected{% endif %}>Unable</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="nystagmus">Nystagmus</label>
            <select id="nystagmus" name="vestibular_screening.nystagmus">
                <option value="" {% if vestibular_screening.nystagmus == "" %}selected{% endif %}>&mdash;</option>
                <option value="none" {% if vestibular_screening.nystagmus == "none" %}selected{% endif %}>None</option>
                <option value="spontaneous" {% if vestibular_screening.nystagmus == "spontaneous" %}selected{% endif %}>Spontaneous</option>
                <option value="gaze-evoked" {% if vestibular_screening.nystagmus == "gaze-evoked" %}selected{% endif %}>Gaze-evoked</option>
                <option value="positional" {% if vestibular_screening.nystagmus == "positional" %}selected{% endif %}>Positional</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fukuda_stepping_test">Fukuda stepping</label>
            <select id="fukuda_stepping_test" name="vestibular_screening.fukuda_stepping_test">
                <option value="" {% if vestibular_screening.fukudaSteppingTest == "" %}selected{% endif %}>&mdash;</option>
                <option value="normal" {% if vestibular_screening.fukudaSteppingTest == "normal" %}selected{% endif %}>Normal</option>
                <option value="rotation-right" {% if vestibular_screening.fukudaSteppingTest == "rotation-right" %}selected{% endif %}>Rotation right</option>
                <option value="rotation-left" {% if vestibular_screening.fukudaSteppingTest == "rotation-left" %}selected{% endif %}>Rotation left</option>
                <option value="not-done" {% if vestibular_screening.fukudaSteppingTest == "not-done" %}selected{% endif %}>Not done</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="vestibular_notes">Notes</label>
        <textarea id="vestibular_notes" name="vestibular_screening.notes">{{ vestibular_screening.notes }}</textarea>
    </div>
</div>
