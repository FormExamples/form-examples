<div class="card">
    <h2>Step 2: Presenting Symptoms</h2>
    <p class="form-hint">Hearing, tinnitus, vertigo, balance, and neurological symptoms.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="hearing_loss">Hearing loss?</label>
            <select id="hearing_loss" name="presenting_symptoms.hearing_loss">
                <option value="" {% if presenting_symptoms.hearingLoss == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.hearingLoss == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.hearingLoss == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hearing_loss_side">Side</label>
            <select id="hearing_loss_side" name="presenting_symptoms.hearing_loss_side">
                <option value="" {% if presenting_symptoms.hearingLossSide == "" %}selected{% endif %}>&mdash;</option>
                <option value="right" {% if presenting_symptoms.hearingLossSide == "right" %}selected{% endif %}>Right</option>
                <option value="left" {% if presenting_symptoms.hearingLossSide == "left" %}selected{% endif %}>Left</option>
                <option value="both" {% if presenting_symptoms.hearingLossSide == "both" %}selected{% endif %}>Both</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hearing_loss_onset">Onset</label>
            <select id="hearing_loss_onset" name="presenting_symptoms.hearing_loss_onset">
                <option value="" {% if presenting_symptoms.hearingLossOnset == "" %}selected{% endif %}>&mdash;</option>
                <option value="sudden" {% if presenting_symptoms.hearingLossOnset == "sudden" %}selected{% endif %}>Sudden</option>
                <option value="gradual" {% if presenting_symptoms.hearingLossOnset == "gradual" %}selected{% endif %}>Gradual</option>
                <option value="fluctuating" {% if presenting_symptoms.hearingLossOnset == "fluctuating" %}selected{% endif %}>Fluctuating</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hearing_loss_duration_months">Duration (months)</label>
            <input type="number" id="hearing_loss_duration_months" name="presenting_symptoms.hearing_loss_duration_months" value="{% if presenting_symptoms.hearingLossDurationMonths %}{{ presenting_symptoms.hearingLossDurationMonths }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="tinnitus">Tinnitus?</label>
            <select id="tinnitus" name="presenting_symptoms.tinnitus">
                <option value="" {% if presenting_symptoms.tinnitus == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.tinnitus == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.tinnitus == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tinnitus_side">Side</label>
            <select id="tinnitus_side" name="presenting_symptoms.tinnitus_side">
                <option value="" {% if presenting_symptoms.tinnitusSide == "" %}selected{% endif %}>&mdash;</option>
                <option value="right" {% if presenting_symptoms.tinnitusSide == "right" %}selected{% endif %}>Right</option>
                <option value="left" {% if presenting_symptoms.tinnitusSide == "left" %}selected{% endif %}>Left</option>
                <option value="both" {% if presenting_symptoms.tinnitusSide == "both" %}selected{% endif %}>Both</option>
            </select>
        </div>
        <div class="form-group">
            <label for="otalgia">Otalgia (ear pain)?</label>
            <select id="otalgia" name="presenting_symptoms.otalgia">
                <option value="" {% if presenting_symptoms.otalgia == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.otalgia == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.otalgia == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="otorrhea">Otorrhea (discharge)?</label>
            <select id="otorrhea" name="presenting_symptoms.otorrhea">
                <option value="" {% if presenting_symptoms.otorrhea == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.otorrhea == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.otorrhea == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="aural_fullness">Aural fullness?</label>
            <select id="aural_fullness" name="presenting_symptoms.aural_fullness">
                <option value="" {% if presenting_symptoms.auralFullness == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.auralFullness == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.auralFullness == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vertigo">Vertigo?</label>
            <select id="vertigo" name="presenting_symptoms.vertigo">
                <option value="" {% if presenting_symptoms.vertigo == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.vertigo == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.vertigo == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vertigo_character">Character</label>
            <select id="vertigo_character" name="presenting_symptoms.vertigo_character">
                <option value="" {% if presenting_symptoms.vertigoCharacter == "" %}selected{% endif %}>&mdash;</option>
                <option value="spinning" {% if presenting_symptoms.vertigoCharacter == "spinning" %}selected{% endif %}>Spinning</option>
                <option value="rocking" {% if presenting_symptoms.vertigoCharacter == "rocking" %}selected{% endif %}>Rocking</option>
                <option value="lightheaded" {% if presenting_symptoms.vertigoCharacter == "lightheaded" %}selected{% endif %}>Lightheaded</option>
                <option value="imbalance" {% if presenting_symptoms.vertigoCharacter == "imbalance" %}selected{% endif %}>Imbalance</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="vertigo_episode_duration_seconds">Episode duration (seconds)</label>
            <input type="number" id="vertigo_episode_duration_seconds" name="presenting_symptoms.vertigo_episode_duration_seconds" value="{% if presenting_symptoms.vertigoEpisodeDurationSeconds %}{{ presenting_symptoms.vertigoEpisodeDurationSeconds }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="vertigo_frequency_per_week">Frequency / week</label>
            <input type="number" id="vertigo_frequency_per_week" name="presenting_symptoms.vertigo_frequency_per_week" value="{% if presenting_symptoms.vertigoFrequencyPerWeek %}{{ presenting_symptoms.vertigoFrequencyPerWeek }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="imbalance">Imbalance?</label>
            <select id="imbalance" name="presenting_symptoms.imbalance">
                <option value="" {% if presenting_symptoms.imbalance == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.imbalance == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.imbalance == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="falls">Falls?</label>
            <select id="falls" name="presenting_symptoms.falls">
                <option value="" {% if presenting_symptoms.falls == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.falls == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.falls == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="falls_last_year_count">Falls in last year</label>
            <input type="number" id="falls_last_year_count" name="presenting_symptoms.falls_last_year_count" value="{% if presenting_symptoms.fallsLastYearCount %}{{ presenting_symptoms.fallsLastYearCount }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="headache_migraine">Headache / migraine?</label>
            <select id="headache_migraine" name="presenting_symptoms.headache_migraine">
                <option value="" {% if presenting_symptoms.headacheMigraine == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.headacheMigraine == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.headacheMigraine == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="neurological_symptoms">Neurological symptoms?</label>
            <select id="neurological_symptoms" name="presenting_symptoms.neurological_symptoms">
                <option value="" {% if presenting_symptoms.neurologicalSymptoms == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if presenting_symptoms.neurologicalSymptoms == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if presenting_symptoms.neurologicalSymptoms == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_symptoms">Other symptoms</label>
        <textarea id="other_symptoms" name="presenting_symptoms.other_symptoms">{{ presenting_symptoms.otherSymptoms }}</textarea>
    </div>
</div>
