<div class="card">
    <h2>Step 8: Dizziness Handicap Inventory</h2>
    <p class="form-hint">
        25 items (7 functional, 9 emotional, 9 physical). Yes = 4, Sometimes = 2,
        No = 0. Total 0&ndash;100. 0&ndash;16 = no handicap; 18&ndash;36 mild;
        38&ndash;52 moderate; &ge;54 severe.
    </p>

    {% for item in dhi_items %}
    <div class="form-group">
        <label for="dhi_q{{ item.num }}">
            <strong>{{ item.num }}. ({{ item.subscale }})</strong> {{ item.text }}
        </label>
        <select id="dhi_q{{ item.num }}" name="dizziness_handicap_inventory.q{{ item.num }}">
            <option value="" {% if item.key == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if item.key == "yes" %}selected{% endif %}>Yes (4)</option>
            <option value="sometimes" {% if item.key == "sometimes" %}selected{% endif %}>Sometimes (2)</option>
            <option value="no" {% if item.key == "no" %}selected{% endif %}>No (0)</option>
        </select>
    </div>
    {% endfor %}
</div>
