<div class="card">
    <h2>Step 4: Pure-Tone Audiometry</h2>
    <p class="form-hint">
        Air- and bone-conduction thresholds at 0.5, 1, 2, and 4 kHz, in dB HL.
        The 4-frequency PTA is computed automatically.
    </p>

    <h3>Right Ear &mdash; Air Conduction</h3>
    <div class="form-row">
        <div class="form-group"><label for="r_air_500">500 Hz</label><input type="number" id="r_air_500" name="pure_tone_audiometry.right_ear.air_conduction.hz500" step="5" value="{% if pure_tone_audiometry.rightEar.airConduction.hz500 %}{{ pure_tone_audiometry.rightEar.airConduction.hz500 }}{% endif %}"></div>
        <div class="form-group"><label for="r_air_1000">1 kHz</label><input type="number" id="r_air_1000" name="pure_tone_audiometry.right_ear.air_conduction.hz1000" step="5" value="{% if pure_tone_audiometry.rightEar.airConduction.hz1000 %}{{ pure_tone_audiometry.rightEar.airConduction.hz1000 }}{% endif %}"></div>
        <div class="form-group"><label for="r_air_2000">2 kHz</label><input type="number" id="r_air_2000" name="pure_tone_audiometry.right_ear.air_conduction.hz2000" step="5" value="{% if pure_tone_audiometry.rightEar.airConduction.hz2000 %}{{ pure_tone_audiometry.rightEar.airConduction.hz2000 }}{% endif %}"></div>
        <div class="form-group"><label for="r_air_4000">4 kHz</label><input type="number" id="r_air_4000" name="pure_tone_audiometry.right_ear.air_conduction.hz4000" step="5" value="{% if pure_tone_audiometry.rightEar.airConduction.hz4000 %}{{ pure_tone_audiometry.rightEar.airConduction.hz4000 }}{% endif %}"></div>
    </div>

    <h3>Right Ear &mdash; Bone Conduction</h3>
    <div class="form-row">
        <div class="form-group"><label for="r_bone_500">500 Hz</label><input type="number" id="r_bone_500" name="pure_tone_audiometry.right_ear.bone_conduction.hz500" step="5" value="{% if pure_tone_audiometry.rightEar.boneConduction.hz500 %}{{ pure_tone_audiometry.rightEar.boneConduction.hz500 }}{% endif %}"></div>
        <div class="form-group"><label for="r_bone_1000">1 kHz</label><input type="number" id="r_bone_1000" name="pure_tone_audiometry.right_ear.bone_conduction.hz1000" step="5" value="{% if pure_tone_audiometry.rightEar.boneConduction.hz1000 %}{{ pure_tone_audiometry.rightEar.boneConduction.hz1000 }}{% endif %}"></div>
        <div class="form-group"><label for="r_bone_2000">2 kHz</label><input type="number" id="r_bone_2000" name="pure_tone_audiometry.right_ear.bone_conduction.hz2000" step="5" value="{% if pure_tone_audiometry.rightEar.boneConduction.hz2000 %}{{ pure_tone_audiometry.rightEar.boneConduction.hz2000 }}{% endif %}"></div>
        <div class="form-group"><label for="r_bone_4000">4 kHz</label><input type="number" id="r_bone_4000" name="pure_tone_audiometry.right_ear.bone_conduction.hz4000" step="5" value="{% if pure_tone_audiometry.rightEar.boneConduction.hz4000 %}{{ pure_tone_audiometry.rightEar.boneConduction.hz4000 }}{% endif %}"></div>
    </div>

    <h3>Left Ear &mdash; Air Conduction</h3>
    <div class="form-row">
        <div class="form-group"><label for="l_air_500">500 Hz</label><input type="number" id="l_air_500" name="pure_tone_audiometry.left_ear.air_conduction.hz500" step="5" value="{% if pure_tone_audiometry.leftEar.airConduction.hz500 %}{{ pure_tone_audiometry.leftEar.airConduction.hz500 }}{% endif %}"></div>
        <div class="form-group"><label for="l_air_1000">1 kHz</label><input type="number" id="l_air_1000" name="pure_tone_audiometry.left_ear.air_conduction.hz1000" step="5" value="{% if pure_tone_audiometry.leftEar.airConduction.hz1000 %}{{ pure_tone_audiometry.leftEar.airConduction.hz1000 }}{% endif %}"></div>
        <div class="form-group"><label for="l_air_2000">2 kHz</label><input type="number" id="l_air_2000" name="pure_tone_audiometry.left_ear.air_conduction.hz2000" step="5" value="{% if pure_tone_audiometry.leftEar.airConduction.hz2000 %}{{ pure_tone_audiometry.leftEar.airConduction.hz2000 }}{% endif %}"></div>
        <div class="form-group"><label for="l_air_4000">4 kHz</label><input type="number" id="l_air_4000" name="pure_tone_audiometry.left_ear.air_conduction.hz4000" step="5" value="{% if pure_tone_audiometry.leftEar.airConduction.hz4000 %}{{ pure_tone_audiometry.leftEar.airConduction.hz4000 }}{% endif %}"></div>
    </div>

    <h3>Left Ear &mdash; Bone Conduction</h3>
    <div class="form-row">
        <div class="form-group"><label for="l_bone_500">500 Hz</label><input type="number" id="l_bone_500" name="pure_tone_audiometry.left_ear.bone_conduction.hz500" step="5" value="{% if pure_tone_audiometry.leftEar.boneConduction.hz500 %}{{ pure_tone_audiometry.leftEar.boneConduction.hz500 }}{% endif %}"></div>
        <div class="form-group"><label for="l_bone_1000">1 kHz</label><input type="number" id="l_bone_1000" name="pure_tone_audiometry.left_ear.bone_conduction.hz1000" step="5" value="{% if pure_tone_audiometry.leftEar.boneConduction.hz1000 %}{{ pure_tone_audiometry.leftEar.boneConduction.hz1000 }}{% endif %}"></div>
        <div class="form-group"><label for="l_bone_2000">2 kHz</label><input type="number" id="l_bone_2000" name="pure_tone_audiometry.left_ear.bone_conduction.hz2000" step="5" value="{% if pure_tone_audiometry.leftEar.boneConduction.hz2000 %}{{ pure_tone_audiometry.leftEar.boneConduction.hz2000 }}{% endif %}"></div>
        <div class="form-group"><label for="l_bone_4000">4 kHz</label><input type="number" id="l_bone_4000" name="pure_tone_audiometry.left_ear.bone_conduction.hz4000" step="5" value="{% if pure_tone_audiometry.leftEar.boneConduction.hz4000 %}{{ pure_tone_audiometry.leftEar.boneConduction.hz4000 }}{% endif %}"></div>
    </div>

    <div class="form-group">
        <label for="audiometry_notes">Audiometry notes</label>
        <textarea id="audiometry_notes" name="pure_tone_audiometry.audiometry_notes">{{ pure_tone_audiometry.audiometryNotes }}</textarea>
    </div>
</div>
