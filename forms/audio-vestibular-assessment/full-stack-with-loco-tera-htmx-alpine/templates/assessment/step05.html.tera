<div class="card">
    <h2>Step 5: Speech Audiometry</h2>
    <p class="form-hint">Speech-reception threshold (SRT) and word-recognition score (WRS).</p>

    <div class="form-row">
        <div class="form-group">
            <label for="right_srt_db">Right SRT (dB)</label>
            <input type="number" id="right_srt_db" name="speech_audiometry.right_srt_db" step="5" value="{% if speech_audiometry.rightSrtDb %}{{ speech_audiometry.rightSrtDb }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="left_srt_db">Left SRT (dB)</label>
            <input type="number" id="left_srt_db" name="speech_audiometry.left_srt_db" step="5" value="{% if speech_audiometry.leftSrtDb %}{{ speech_audiometry.leftSrtDb }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="right_word_recognition_percent">Right WRS (%)</label>
            <input type="number" id="right_word_recognition_percent" name="speech_audiometry.right_word_recognition_percent" min="0" max="100" value="{% if speech_audiometry.rightWordRecognitionPercent %}{{ speech_audiometry.rightWordRecognitionPercent }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="left_word_recognition_percent">Left WRS (%)</label>
            <input type="number" id="left_word_recognition_percent" name="speech_audiometry.left_word_recognition_percent" min="0" max="100" value="{% if speech_audiometry.leftWordRecognitionPercent %}{{ speech_audiometry.leftWordRecognitionPercent }}{% endif %}">
        </div>
    </div>

    <div class="form-group">
        <label for="speech_audiometry_notes">Notes</label>
        <textarea id="speech_audiometry_notes" name="speech_audiometry.speech_audiometry_notes">{{ speech_audiometry.speechAudiometryNotes }}</textarea>
    </div>
</div>
