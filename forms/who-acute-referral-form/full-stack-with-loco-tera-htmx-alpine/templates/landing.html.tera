{% extends "base.html.tera" %}

{% block title %}WHO Acute Referral Form - Home{% endblock %}

{% block content %}
<div class="landing">
  <div class="card landing-card">
    <h1>WHO Acute Referral Form</h1>
    <p class="landing-description">
      Standardised inter-facility patient transfer questionnaire from the
      World Health Organization. Captures patient identification, facility
      and transport details, and a structured SBAR clinical handover
      (Situation, Background, Assessment, Recommendations) plus the
      receiving facility's arrival receipt.
    </p>

    <div class="landing-features">
      <div class="feature">
        <h3>8 Steps</h3>
        <p>Patient ID, Facility &amp; Transport, Situation, Background, Assessment, Recommendations, Provider Sign-off, Receipt.</p>
      </div>
      <div class="feature">
        <h3>Two-party Completion</h3>
        <p>Initiating facility completes steps 1-7; the receiving facility completes step 8 on arrival.</p>
      </div>
      <div class="feature">
        <h3>Flagged Issues</h3>
        <p>Critical vital signs (SpO2 &lt; 90, GCS &le; 8, hypotension), infectious disease, aspiration and spinal precautions escalate for clinician review.</p>
      </div>
    </div>

    <form method="POST" action="/assessment/new">
      <button type="submit" class="btn btn-primary btn-lg">
        Begin New Referral
      </button>
    </form>
  </div>
</div>
{% endblock %}
