{% extends "base.html.tera" %}

{% block title %}WHO Acute Referral Form{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>WHO Acute Referral Form</h1>
  <p>
    Standardised inter-facility patient transfer questionnaire from the World
    Health Organization. Captures patient identification, facility and
    transport details, and a structured SBAR clinical handover (Situation,
    Background, Assessment, Recommendations) plus the receiving facility's
    arrival receipt.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>8 Steps</h3>
      <p>Patient ID, Facility &amp; Transport, Situation, Background, Assessment, Recommendations, Provider Sign-off, Receipt.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Two-party Completion</h3>
      <p>Initiating facility completes steps 1-7; the receiving facility completes step 8 on arrival.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Critical vital signs (SpO2 &lt; 90, GCS &le; 8, hypotension), infectious disease, aspiration and spinal precautions escalate for clinician review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New Referral
    </button>
  </form>
</div>
{% endblock %}
