<div class="card" x-show="step === 7">
  <h2>Step 7: Provider Sign-off (initiating facility)</h2>

  <div class="form-row">
    <div class="form-group">
      <label for="providerName">Provider name</label>
      <input type="text" id="providerName" name="providerName"
             value="{{ initiating_provider_signoff.providerName }}">
    </div>
    <div class="form-group">
      <label for="providerSignature">Signature</label>
      <input type="text" id="providerSignature" name="providerSignature"
             value="{{ initiating_provider_signoff.signature }}">
    </div>
    <div class="form-group">
      <label for="providerSignatureDate">Signature date</label>
      <input type="date" id="providerSignatureDate" name="providerSignatureDate"
             value="{{ initiating_provider_signoff.signatureDate }}">
    </div>
  </div>
</div>
