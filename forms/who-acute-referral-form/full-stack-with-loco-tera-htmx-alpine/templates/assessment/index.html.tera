{% extends "base.html.tera" %}

{% block title %}WHO Acute Referral Form - Wizard{% endblock %}

{% block content %}
<div class="assessment-header" x-data="{ step: 1, totalSteps: {{ total_steps }} }">
  <h1>WHO Acute Referral Form</h1>
  <p class="form-hint">
    Complete all {{ total_steps }} steps, then submit. Steps 1-7 are
    completed by the initiating facility; step 8 is completed by the
    receiving facility on arrival.
  </p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}
    {% include "assessment/step04.html.tera" %}
    {% include "assessment/step05.html.tera" %}
    {% include "assessment/step06.html.tera" %}
    {% include "assessment/step07.html.tera" %}
    {% include "assessment/step08.html.tera" %}

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;">
      <button type="button" @click="if (step>1) step--"
              :disabled="step === 1"
              class="btn btn-secondary">
        Previous
      </button>

      <template x-if="step < totalSteps">
        <button type="button" @click="step++" class="btn btn-primary">Next</button>
      </template>

      <template x-if="step === totalSteps">
        <button type="submit" class="btn btn-success">Submit Referral</button>
      </template>
    </div>
  </form>
</div>
{% endblock %}
