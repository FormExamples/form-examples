<div class="card" x-show="step === 2">
  <h2>Step 2: Facility &amp; Transport</h2>

  <h3>Initiating facility</h3>
  <div class="form-row">
    <div class="form-group">
      <label for="initiatingFacilityName">Name</label>
      <input type="text" id="initiatingFacilityName" name="initiatingFacilityName"
             value="{{ facility_and_transport.initiatingFacility.name }}">
    </div>
    <div class="form-group">
      <label for="initiatingFacilityFocalPoint">Focal point</label>
      <input type="text" id="initiatingFacilityFocalPoint" name="initiatingFacilityFocalPoint"
             value="{{ facility_and_transport.initiatingFacility.focalPoint }}">
    </div>
    <div class="form-group">
      <label for="initiatingFacilityPhoneNumber">Phone number</label>
      <input type="text" id="initiatingFacilityPhoneNumber" name="initiatingFacilityPhoneNumber"
             value="{{ facility_and_transport.initiatingFacility.phoneNumber }}">
    </div>
  </div>

  <div class="form-group">
    <label for="reasonForReferral">Reason for referral</label>
    <textarea id="reasonForReferral" name="reasonForReferral" rows="2">{{ facility_and_transport.reasonForReferral }}</textarea>
  </div>

  <div class="form-group">
    <label>
      <input type="checkbox" name="referralFacilityContacted" value="on"
             {% if facility_and_transport.referralFacilityContacted %}checked{% endif %}>
      Referral facility contacted prior to transfer
    </label>
  </div>

  <h3>Referral facility</h3>
  <div class="form-row">
    <div class="form-group">
      <label for="referralFacilityName">Name</label>
      <input type="text" id="referralFacilityName" name="referralFacilityName"
             value="{{ facility_and_transport.referralFacility.name }}">
    </div>
    <div class="form-group">
      <label for="referralFacilityFocalPoint">Focal point</label>
      <input type="text" id="referralFacilityFocalPoint" name="referralFacilityFocalPoint"
             value="{{ facility_and_transport.referralFacility.focalPoint }}">
    </div>
    <div class="form-group">
      <label for="referralFacilityPhoneNumber">Phone number</label>
      <input type="text" id="referralFacilityPhoneNumber" name="referralFacilityPhoneNumber"
             value="{{ facility_and_transport.referralFacility.phoneNumber }}">
    </div>
  </div>

  <h3>Ambulance / transport vehicle</h3>
  <div class="form-row">
    <div class="form-group">
      <label for="ambulanceName">Name / unit</label>
      <input type="text" id="ambulanceName" name="ambulanceName"
             value="{{ facility_and_transport.ambulance.name }}">
    </div>
    <div class="form-group">
      <label for="ambulanceFocalPoint">Focal point</label>
      <input type="text" id="ambulanceFocalPoint" name="ambulanceFocalPoint"
             value="{{ facility_and_transport.ambulance.focalPoint }}">
    </div>
    <div class="form-group">
      <label for="ambulancePhoneNumber">Phone number</label>
      <input type="text" id="ambulancePhoneNumber" name="ambulancePhoneNumber"
             value="{{ facility_and_transport.ambulance.phoneNumber }}">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="transferDecisionDateTime">Transfer decision (date &amp; time)</label>
      <input type="datetime-local" id="transferDecisionDateTime" name="transferDecisionDateTime"
             value="{{ facility_and_transport.transferDecisionDateTime }}">
    </div>
    <div class="form-group">
      <label for="departureDateTime">Departure (date &amp; time)</label>
      <input type="datetime-local" id="departureDateTime" name="departureDateTime"
             value="{{ facility_and_transport.departureDateTime }}">
    </div>
    <div class="form-group">
      <label for="modeOfTransfer">Mode of transfer</label>
      <select id="modeOfTransfer" name="modeOfTransfer">
        <option value="" {% if facility_and_transport.modeOfTransfer == "" %}selected{% endif %}>&mdash;</option>
        <option value="ground" {% if facility_and_transport.modeOfTransfer == "ground" %}selected{% endif %}>Ground</option>
        <option value="air" {% if facility_and_transport.modeOfTransfer == "air" %}selected{% endif %}>Air</option>
        <option value="sea" {% if facility_and_transport.modeOfTransfer == "sea" %}selected{% endif %}>Sea</option>
      </select>
    </div>
  </div>
</div>
