<div class="card" x-show="step === 3">
  <h2>Step 3: Situation</h2>

  <div class="form-group">
    <label for="chiefComplaint">Chief complaint</label>
    <textarea id="chiefComplaint" name="chiefComplaint" rows="2">{{ situation.chiefComplaint }}</textarea>
  </div>

  <div class="form-group">
    <label for="primaryDiagnosis">Primary diagnosis</label>
    <textarea id="primaryDiagnosis" name="primaryDiagnosis" rows="2">{{ situation.primaryDiagnosis }}</textarea>
  </div>

  <div class="form-group">
    <label for="pregnant">Pregnant?</label>
    <select id="pregnant" name="pregnant">
      <option value="" {% if situation.pregnant == "" %}selected{% endif %}>&mdash;</option>
      <option value="yes" {% if situation.pregnant == "yes" %}selected{% endif %}>Yes</option>
      <option value="no" {% if situation.pregnant == "no" %}selected{% endif %}>No</option>
      <option value="unknown" {% if situation.pregnant == "unknown" %}selected{% endif %}>Unknown</option>
    </select>
  </div>

  <div class="form-group">
    <label for="otherAcuteDiagnoses">Other acute diagnoses</label>
    <textarea id="otherAcuteDiagnoses" name="otherAcuteDiagnoses" rows="2">{{ situation.otherAcuteDiagnoses }}</textarea>
  </div>

  <div class="form-group">
    <label for="treatmentsInitiated">Treatments initiated</label>
    <textarea id="treatmentsInitiated" name="treatmentsInitiated" rows="2">{{ situation.treatmentsInitiated }}</textarea>
  </div>
</div>
