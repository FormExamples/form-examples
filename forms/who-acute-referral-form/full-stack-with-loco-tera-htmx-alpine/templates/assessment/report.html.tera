{% extends "base.html.tera" %}

{% block title %}Referral Report{% endblock %}

{% block content %}
<div class="report-header">
  <h1>WHO Acute Referral Form &mdash; Validation Report</h1>
  {% if result.validation.complete %}
    <div class="badge badge-yes">Form is complete</div>
  {% else %}
    <div class="badge badge-no">Form is incomplete &mdash; {{ result.validation.totalSatisfied }} of {{ result.validation.totalRequired }} required fields satisfied</div>
  {% endif %}
  <p style="color: var(--gray-500); font-size: 0.85rem;">
    Referral ID: {{ id }}<br>
    Generated: {{ timestamp }}
  </p>
</div>

<!-- Patient summary -->
<div class="card">
  <h2>Patient Summary</h2>
  <div class="form-row">
    <div>
      <strong>Name:</strong> {{ data.patientIdentification.patientLastName }}, {{ data.patientIdentification.patientFirstName }}<br>
      <strong>Date of birth:</strong> {{ data.patientIdentification.dateOfBirth }}<br>
      <strong>Sex:</strong> {{ data.patientIdentification.sex }}<br>
      <strong>Patient contact:</strong> {{ data.patientIdentification.patientContactInformation }}
    </div>
    <div>
      <strong>Emergency contact:</strong> {{ data.patientIdentification.emergencyContact.name }}<br>
      <strong>Emergency phone:</strong> {{ data.patientIdentification.emergencyContact.contactInformation }}<br>
      <strong>Pregnant:</strong> {{ data.situation.pregnant }}<br>
      <strong>Chief complaint:</strong> {{ data.situation.chiefComplaint }}
    </div>
  </div>
</div>

<!-- Facility & transport -->
<div class="card">
  <h2>Facility &amp; Transport</h2>
  <div class="form-row">
    <div>
      <strong>Initiating facility:</strong> {{ data.facilityAndTransport.initiatingFacility.name }}<br>
      <strong>Focal point:</strong> {{ data.facilityAndTransport.initiatingFacility.focalPoint }}<br>
      <strong>Phone:</strong> {{ data.facilityAndTransport.initiatingFacility.phoneNumber }}
    </div>
    <div>
      <strong>Referral facility:</strong> {{ data.facilityAndTransport.referralFacility.name }}<br>
      <strong>Focal point:</strong> {{ data.facilityAndTransport.referralFacility.focalPoint }}<br>
      <strong>Phone:</strong> {{ data.facilityAndTransport.referralFacility.phoneNumber }}
    </div>
    <div>
      <strong>Transfer decision:</strong> {{ data.facilityAndTransport.transferDecisionDateTime }}<br>
      <strong>Departure:</strong> {{ data.facilityAndTransport.departureDateTime }}<br>
      <strong>Mode:</strong> {{ data.facilityAndTransport.modeOfTransfer }}
    </div>
  </div>
</div>

<!-- Completeness -->
<div class="card">
  <h2>Completeness by Section</h2>
  <table class="phase-table">
    <thead>
      <tr>
        <th>Section</th>
        <th>Required</th>
        <th>Satisfied</th>
        <th>Missing</th>
      </tr>
    </thead>
    <tbody>
      {% for s in result.validation.sections %}
      <tr>
        <td>{{ s.sectionLabel }}</td>
        <td>{{ s.required }}</td>
        <td>{{ s.satisfied }}</td>
        <td>
          {% if s.missing | length == 0 %}
            <span class="badge badge-yes">0</span>
          {% else %}
            <span class="badge badge-no">{{ s.missing | length }}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<!-- Flagged issues -->
{% if result.flaggedIssues | length > 0 %}
<div class="card">
  <h2>Flagged Issues ({{ result.flaggedIssues | length }})</h2>
  <div class="flags-section">
    {% for flag in result.flaggedIssues %}
    <div class="flag-item flag-{{ flag.priority }}">
      <span class="flag-category">{{ flag.category }}</span>
      <span class="flag-message">{{ flag.message }}</span>
      <span style="color:#888;font-size:0.85rem;">({{ flag.id }})</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- Missing items -->
{% if result.validation.missing | length > 0 %}
<div class="card">
  <h2>Missing or Outstanding Items ({{ result.validation.missing | length }})</h2>
  <table class="rules-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Section</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {% for m in result.validation.missing %}
      <tr>
        <td><code>{{ m.id }}</code></td>
        <td>{{ m.section }}</td>
        <td>{{ m.description }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
  <a href="/assessment/{{ id }}" class="btn btn-secondary">Edit Referral</a>
  <a href="/" class="btn btn-primary" style="margin-left: 1rem;">New Referral</a>
  <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">Dashboard</a>
  <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
