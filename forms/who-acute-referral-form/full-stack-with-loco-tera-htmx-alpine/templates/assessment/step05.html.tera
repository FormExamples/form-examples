<div class="card" x-show="step === 5">
  <h2>Step 5: Assessment</h2>

  <div class="form-group">
    <label for="clinicalAssessment">Clinical assessment (description and need for referral)</label>
    <textarea id="clinicalAssessment" name="clinicalAssessment" rows="3">{{ assessment.clinicalAssessment }}</textarea>
  </div>

  <h3>Vital signs</h3>
  <div class="form-row">
    <div class="form-group">
      <label for="heartRate">Heart rate (bpm)</label>
      <input type="number" step="any" id="heartRate" name="heartRate"
             value="{{ assessment.vitalSigns.heartRate | default(value='') }}">
    </div>
    <div class="form-group">
      <label for="respiratoryRate">Respiratory rate (/min)</label>
      <input type="number" step="any" id="respiratoryRate" name="respiratoryRate"
             value="{{ assessment.vitalSigns.respiratoryRate | default(value='') }}">
    </div>
    <div class="form-group">
      <label for="systolicBloodPressure">SBP (mmHg)</label>
      <input type="number" step="any" id="systolicBloodPressure" name="systolicBloodPressure"
             value="{{ assessment.vitalSigns.systolicBloodPressure | default(value='') }}">
    </div>
    <div class="form-group">
      <label for="diastolicBloodPressure">DBP (mmHg)</label>
      <input type="number" step="any" id="diastolicBloodPressure" name="diastolicBloodPressure"
             value="{{ assessment.vitalSigns.diastolicBloodPressure | default(value='') }}">
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="temperatureCelsius">Temperature (C)</label>
      <input type="number" step="any" id="temperatureCelsius" name="temperatureCelsius"
             value="{{ assessment.vitalSigns.temperatureCelsius | default(value='') }}">
    </div>
    <div class="form-group">
      <label for="oxygenSaturation">SpO2 (%)</label>
      <input type="number" step="any" id="oxygenSaturation" name="oxygenSaturation"
             value="{{ assessment.vitalSigns.oxygenSaturation | default(value='') }}">
    </div>
    <div class="form-group">
      <label for="glasgowComaScale">GCS (3-15)</label>
      <input type="number" step="any" min="3" max="15" id="glasgowComaScale" name="glasgowComaScale"
             value="{{ assessment.vitalSigns.glasgowComaScale | default(value='') }}">
    </div>
  </div>
</div>
