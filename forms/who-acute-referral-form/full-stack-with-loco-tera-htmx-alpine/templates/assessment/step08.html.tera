<div class="card" x-show="step === 8">
  <h2>Step 8: Referral Facility Receipt</h2>
  <p class="form-hint">Completed by the receiving facility on patient arrival.</p>

  <div class="form-row">
    <div class="form-group">
      <label for="patientArrivalDateTime">Patient arrival (date &amp; time)</label>
      <input type="datetime-local" id="patientArrivalDateTime" name="patientArrivalDateTime"
             value="{{ referral_facility_receipt.patientArrivalDateTime }}">
    </div>
    <div class="form-group">
      <label for="receivingProviderName">Receiving provider name</label>
      <input type="text" id="receivingProviderName" name="receivingProviderName"
             value="{{ referral_facility_receipt.receivingProviderName }}">
    </div>
    <div class="form-group">
      <label for="receivingProviderSignature">Receiving provider signature</label>
      <input type="text" id="receivingProviderSignature" name="receivingProviderSignature"
             value="{{ referral_facility_receipt.receivingProviderSignature }}">
    </div>
  </div>

  <div class="form-group">
    <label>
      <input type="checkbox" name="feedbackProvidedToInitiatingFacility" value="on"
             {% if referral_facility_receipt.feedbackProvidedToInitiatingFacility %}checked{% endif %}>
      Feedback provided to initiating facility
    </label>
  </div>
</div>
