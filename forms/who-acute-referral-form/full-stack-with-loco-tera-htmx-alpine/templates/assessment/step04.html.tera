<div class="card" x-show="step === 4">
  <h2>Step 4: Background (history + ABCDE)</h2>

  <div class="form-group">
    <label for="historyOfPresentIllness">History of present illness</label>
    <textarea id="historyOfPresentIllness" name="historyOfPresentIllness" rows="3">{{ background.historyOfPresentIllness }}</textarea>
  </div>

  <div class="form-group">
    <label for="pastMedicalAndSurgicalHistory">Past medical &amp; surgical history</label>
    <textarea id="pastMedicalAndSurgicalHistory" name="pastMedicalAndSurgicalHistory" rows="3">{{ background.pastMedicalAndSurgicalHistory }}</textarea>
  </div>

  <h3>A &mdash; Airway</h3>
  <div class="form-row">
    <div class="form-group">
      <label><input type="checkbox" name="airwayFindingNormal" value="on" {% if background.airway.findingNormal %}checked{% endif %}> Finding normal</label>
      <input type="text" name="airwayFindingDetails" placeholder="Finding details"
             value="{{ background.airway.findingDetails }}">
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="airwayInterventionNone" value="on" {% if background.airway.interventionNone %}checked{% endif %}> Intervention: none</label>
      <input type="text" name="airwayInterventionDetails" placeholder="Intervention details"
             value="{{ background.airway.interventionDetails }}">
    </div>
  </div>

  <h3>B &mdash; Breathing</h3>
  <div class="form-row">
    <div class="form-group">
      <label><input type="checkbox" name="breathingFindingNormal" value="on" {% if background.breathing.findingNormal %}checked{% endif %}> Finding normal</label>
      <input type="text" name="breathingFindingDetails" placeholder="Finding details"
             value="{{ background.breathing.findingDetails }}">
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="breathingInterventionNone" value="on" {% if background.breathing.interventionNone %}checked{% endif %}> Intervention: none</label>
      <input type="text" name="breathingInterventionDetails" placeholder="Intervention details"
             value="{{ background.breathing.interventionDetails }}">
    </div>
  </div>

  <h3>C &mdash; Circulation</h3>
  <div class="form-row">
    <div class="form-group">
      <label><input type="checkbox" name="circulationFindingNormal" value="on" {% if background.circulation.findingNormal %}checked{% endif %}> Finding normal</label>
      <input type="text" name="circulationFindingDetails" placeholder="Finding details"
             value="{{ background.circulation.findingDetails }}">
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="circulationInterventionNone" value="on" {% if background.circulation.interventionNone %}checked{% endif %}> Intervention: none</label>
      <input type="text" name="circulationInterventionDetails" placeholder="Intervention details"
             value="{{ background.circulation.interventionDetails }}">
    </div>
  </div>

  <h3>D &mdash; Disability (neurologic)</h3>
  <div class="form-row">
    <div class="form-group">
      <label><input type="checkbox" name="disabilityFindingNormal" value="on" {% if background.disability.findingNormal %}checked{% endif %}> Finding normal</label>
      <input type="text" name="disabilityFindingDetails" placeholder="Finding details"
             value="{{ background.disability.findingDetails }}">
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="disabilityInterventionNone" value="on" {% if background.disability.interventionNone %}checked{% endif %}> Intervention: none</label>
      <input type="text" name="disabilityInterventionDetails" placeholder="Intervention details"
             value="{{ background.disability.interventionDetails }}">
    </div>
  </div>

  <h3>E &mdash; Exposure</h3>
  <div class="form-row">
    <div class="form-group">
      <label><input type="checkbox" name="exposureFindingNormal" value="on" {% if background.exposure.findingNormal %}checked{% endif %}> Finding normal</label>
      <input type="text" name="exposureFindingDetails" placeholder="Finding details"
             value="{{ background.exposure.findingDetails }}">
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="exposureInterventionNone" value="on" {% if background.exposure.interventionNone %}checked{% endif %}> Intervention: none</label>
      <input type="text" name="exposureInterventionDetails" placeholder="Intervention details"
             value="{{ background.exposure.interventionDetails }}">
    </div>
  </div>

  <div class="form-group">
    <label for="otherSignificantTreatments">Other significant treatments</label>
    <textarea id="otherSignificantTreatments" name="otherSignificantTreatments" rows="2">{{ background.otherSignificantTreatments }}</textarea>
  </div>
</div>
