<div class="card">
    <h2>Step 1: Candidate Details</h2>
    <p class="form-hint">Identify the candidate, examiner, and test sitting.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="candidate_id">Candidate ID</label>
            <input type="text" id="candidate_id" name="candidate.candidate_id"
                   value="{{ candidate.candidateId }}">
        </div>
        <div class="form-group">
            <label for="candidate_name">Candidate Name</label>
            <input type="text" id="candidate_name" name="candidate.candidate_name"
                   value="{{ candidate.candidateName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="examiner_name">Examiner Name</label>
            <input type="text" id="examiner_name" name="candidate.examiner_name"
                   value="{{ candidate.examinerName }}">
        </div>
        <div class="form-group">
            <label for="test_centre">Test Centre</label>
            <input type="text" id="test_centre" name="candidate.test_centre"
                   value="{{ candidate.testCentre }}" placeholder="e.g. Bangor, Caerdydd">
        </div>
        <div class="form-group">
            <label for="test_date">Test Date</label>
            <input type="date" id="test_date" name="candidate.test_date"
                   value="{{ candidate.testDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="profession">Profession</label>
            <input type="text" id="profession" name="candidate.profession"
                   value="{{ candidate.profession }}" placeholder="medicine">
        </div>
        <div class="form-group">
            <label for="first_language">First Language</label>
            <input type="text" id="first_language" name="candidate.first_language"
                   value="{{ candidate.firstLanguage }}" placeholder="e.g. English, Cymraeg">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="country_of_training">Country of Training</label>
            <input type="text" id="country_of_training" name="candidate.country_of_training"
                   value="{{ candidate.countryOfTraining }}">
        </div>
        <div class="form-group">
            <label for="years_of_experience">Years of Experience</label>
            <input type="text" id="years_of_experience" name="candidate.years_of_experience"
                   value="{{ candidate.yearsOfExperience }}">
        </div>
    </div>
</div>
