<div class="card">
    <h2>Step 4: Assessment Criteria Rating</h2>
    <p class="form-hint">
        Rate each linguistic criterion (Fluency, Grammar, Pronunciation,
        Clinical Appropriateness) on a 0&ndash;6 scale for both role-plays,
        then rate the five clinical communication indicators on a 0&ndash;3
        scale across the whole assessment. Leave blank for unrated.
    </p>

    <h3>Linguistic Criteria &mdash; Role-play 1 (Sgwrs gyda Chlaf)</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="ling_rp1_fluency">Fluency (Rhuglder)</label>
            <input type="number" min="0" max="6" id="ling_rp1_fluency"
                   name="linguistic_role_play1.fluency"
                   value="{% if linguistic_role_play1.fluency is not null %}{{ linguistic_role_play1.fluency }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp1_grammar">Grammar (Gramadeg)</label>
            <input type="number" min="0" max="6" id="ling_rp1_grammar"
                   name="linguistic_role_play1.grammar"
                   value="{% if linguistic_role_play1.grammar is not null %}{{ linguistic_role_play1.grammar }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp1_pronunciation">Pronunciation (Ynganu)</label>
            <input type="number" min="0" max="6" id="ling_rp1_pronunciation"
                   name="linguistic_role_play1.pronunciation"
                   value="{% if linguistic_role_play1.pronunciation is not null %}{{ linguistic_role_play1.pronunciation }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp1_clinical_appropriateness">Clinical Appropriateness</label>
            <input type="number" min="0" max="6" id="ling_rp1_clinical_appropriateness"
                   name="linguistic_role_play1.clinical_appropriateness"
                   value="{% if linguistic_role_play1.clinicalAppropriateness is not null %}{{ linguistic_role_play1.clinicalAppropriateness }}{% endif %}">
        </div>
    </div>

    <h3>Linguistic Criteria &mdash; Role-play 2 (Esboniad Clinigol)</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="ling_rp2_fluency">Fluency (Rhuglder)</label>
            <input type="number" min="0" max="6" id="ling_rp2_fluency"
                   name="linguistic_role_play2.fluency"
                   value="{% if linguistic_role_play2.fluency is not null %}{{ linguistic_role_play2.fluency }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp2_grammar">Grammar (Gramadeg)</label>
            <input type="number" min="0" max="6" id="ling_rp2_grammar"
                   name="linguistic_role_play2.grammar"
                   value="{% if linguistic_role_play2.grammar is not null %}{{ linguistic_role_play2.grammar }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp2_pronunciation">Pronunciation (Ynganu)</label>
            <input type="number" min="0" max="6" id="ling_rp2_pronunciation"
                   name="linguistic_role_play2.pronunciation"
                   value="{% if linguistic_role_play2.pronunciation is not null %}{{ linguistic_role_play2.pronunciation }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ling_rp2_clinical_appropriateness">Clinical Appropriateness</label>
            <input type="number" min="0" max="6" id="ling_rp2_clinical_appropriateness"
                   name="linguistic_role_play2.clinical_appropriateness"
                   value="{% if linguistic_role_play2.clinicalAppropriateness is not null %}{{ linguistic_role_play2.clinicalAppropriateness }}{% endif %}">
        </div>
    </div>

    <h3>Clinical Communication Indicators (0&ndash;3, whole assessment)</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="ci_relationship_building">Relationship-building</label>
            <input type="number" min="0" max="3" id="ci_relationship_building"
                   name="clinical_indicators.relationship_building"
                   value="{% if clinical_indicators.relationshipBuilding is not null %}{{ clinical_indicators.relationshipBuilding }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_understanding_patient_perspective">Understanding Patient&rsquo;s Perspective</label>
            <input type="number" min="0" max="3" id="ci_understanding_patient_perspective"
                   name="clinical_indicators.understanding_patient_perspective"
                   value="{% if clinical_indicators.understandingPatientPerspective is not null %}{{ clinical_indicators.understandingPatientPerspective }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_providing_structure">Providing Structure</label>
            <input type="number" min="0" max="3" id="ci_providing_structure"
                   name="clinical_indicators.providing_structure"
                   value="{% if clinical_indicators.providingStructure is not null %}{{ clinical_indicators.providingStructure }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ci_information_gathering">Information-gathering</label>
            <input type="number" min="0" max="3" id="ci_information_gathering"
                   name="clinical_indicators.information_gathering"
                   value="{% if clinical_indicators.informationGathering is not null %}{{ clinical_indicators.informationGathering }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_information_giving">Information-giving</label>
            <input type="number" min="0" max="3" id="ci_information_giving"
                   name="clinical_indicators.information_giving"
                   value="{% if clinical_indicators.informationGiving is not null %}{{ clinical_indicators.informationGiving }}{% endif %}">
        </div>
    </div>
</div>
