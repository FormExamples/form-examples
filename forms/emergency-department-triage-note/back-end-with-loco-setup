#!/bin/sh
set -euf

form_kebab_case=emergency-department-triage-note
form_snake_case=emergency_department_triage_note

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold emergency_department_triage_note \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    nurse_name:text! \
    triaged_at:tstz \
    care_setting:string! \
    arrival_mode:string! \
    arrived_at:tstz \
    referral_source:text! \
    patient_identifier:text! \
    age_band:string! \
    presenting_complaint:text! \
    brief_history:text! \
    symptom_onset:text! \
    respiratory_rate:int \
    spo2:int \
    on_oxygen:string! \
    systolic_bp:int \
    pulse:int \
    consciousness_acvpu:string! \
    temperature:double \
    glasgow_coma_scale:int \
    pain_score:int \
    airway_threat:string! \
    breathing_inadequate:string! \
    circulation_shock:string! \
    haemorrhage_major:string! \
    consciousness_reduced:string! \
    seizure_active:string! \
    focal_neurology:string! \
    sepsis_features:string! \
    chest_pain_cardiac:string! \
    stroke_features:string! \
    paediatric_red_flag:string! \
    clinical_notes:text! \
    --api

cargo loco generate scaffold emergency_department_triage_note_grade \
    deleted_at:tstz \
    emergency_department_triage_note:references \
    news2_total:int \
    news2_any_parameter_three:string! \
    priority_level:int \
    priority_colour:string! \
    priority_name:string! \
    target_minutes:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold emergency_department_triage_note_grade_rule \
    deleted_at:tstz \
    emergency_department_triage_note_grade:references \
    rule_id:string! \
    instrument:string! \
    band:int \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold emergency_department_triage_note_grade_flag \
    deleted_at:tstz \
    emergency_department_triage_note_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
