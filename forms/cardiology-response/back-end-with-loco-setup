#!/bin/sh
set -euf

form_kebab_case=cardiology-response
form_snake_case=cardiology_response

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold cardiology_response \
    deleted_at:ts \
    patient:references \
    clinician:references \
    originating_request_reference:string! \
    response_status:string! \
    consultation_type:string! \
    assessed_date:date \
    responded_date:date \
    clinical_summary:string! \
    examination_findings:string! \
    investigations_performed:string! \
    ischaemia_or_cad:bool! \
    significant_arrhythmia:bool! \
    reduced_ejection_fraction:bool! \
    significant_valve_disease:bool! \
    structural_abnormality:bool! \
    uncontrolled_hypertension:bool! \
    non_cardiac_cause:bool! \
    primary_diagnosis_category:string! \
    diagnosis_narrative:string! \
    lv_ejection_fraction_percent:double \
    management_plan:string! \
    medication_changes:string! \
    recommended_follow_up:string! \
    critical_result:bool! \
    critical_result_communicated:bool! \
    reported_to:string! \
    --api

cargo loco generate scaffold cardiology_response_grade \
    deleted_at:ts \
    cardiology_response:references \
    response_classification:string! \
    severity:string! \
    severity_category:string! \
    completeness_percent:int \
    follow_up_urgency:string! \
    target_timeframe:string! \
    recommended_action:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold cardiology_response_grade_rule \
    deleted_at:ts \
    cardiology_response_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold cardiology_response_grade_flag \
    deleted_at:ts \
    cardiology_response_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
