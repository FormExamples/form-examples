#!/bin/sh
set -euf

form_kebab_case=dexa-bone-density-test-request
form_snake_case=dexa_bone_density_test_request

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_kebab_case}" --db postgres --bg async --assets none
cd "${form_kebab_case}"

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold dexa_bone_density_test_request \
    deleted_at:ts \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    scan_region:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    frax_major_fracture_percent:double \
    previous_fragility_fracture:bool! \
    long_term_steroids:bool! \
    menopause_status:string! \
    parental_hip_fracture:bool! \
    weight_kg:double \
    previous_dexa:string! \
    previous_dexa_date:date \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    notes:string! \
    --api

cargo loco generate scaffold dexa_bone_density_test_request_grade \
    deleted_at:ts \
    dexa_bone_density_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    radiation_dose_band:string! \
    safety_note:string! \
    completeness_percent:int \
    triage_tier:string! \
    target_timeframe:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api

cargo loco generate scaffold dexa_bone_density_test_request_grade_rule \
    deleted_at:ts \
    dexa_bone_density_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold dexa_bone_density_test_request_grade_flag \
    deleted_at:ts \
    dexa_bone_density_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
