{% extends "base.html.tera" %}

{% block title %}Seasonal Affective Disorder Assessment - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Clinician Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or country...">
    </div>
    <div class="form-group">
        <label for="combined_severity">Combined Severity</label>
        <select id="combined_severity" name="combined_severity">
            <option value="">All</option>
            <option value="no-sad" {% if combined_severity == "no-sad" %}selected{% endif %}>No SAD</option>
            <option value="mild" {% if combined_severity == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if combined_severity == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="severe" {% if combined_severity == "severe" %}selected{% endif %}>Severe</option>
            <option value="critical" {% if combined_severity == "critical" %}selected{% endif %}>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label for="spaq_band">SPAQ Band</label>
        <select id="spaq_band" name="spaq_band">
            <option value="">All</option>
            <option value="no-sad" {% if spaq_band == "no-sad" %}selected{% endif %}>No SAD</option>
            <option value="subsyndromal" {% if spaq_band == "subsyndromal" %}selected{% endif %}>Subsyndromal</option>
            <option value="sad-likely" {% if spaq_band == "sad-likely" %}selected{% endif %}>SAD likely</option>
        </select>
    </div>
    <div class="form-group">
        <label for="phq9_band">PHQ-9 Band</label>
        <select id="phq9_band" name="phq9_band">
            <option value="">All</option>
            <option value="minimal" {% if phq9_band == "minimal" %}selected{% endif %}>Minimal</option>
            <option value="mild" {% if phq9_band == "mild" %}selected{% endif %}>Mild</option>
            <option value="moderate" {% if phq9_band == "moderate" %}selected{% endif %}>Moderate</option>
            <option value="moderately-severe" {% if phq9_band == "moderately-severe" %}selected{% endif %}>Moderately severe</option>
            <option value="severe" {% if phq9_band == "severe" %}selected{% endif %}>Severe</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Created</th>
            <th>Patient</th>
            <th>DOB</th>
            <th>Country</th>
            <th>SPAQ</th>
            <th>PHQ-9</th>
            <th>Combined</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.createdAt }}</a></td>
            <td>{{ c.patientName }}</td>
            <td>{{ c.dateOfBirth }}</td>
            <td>{{ c.country }}</td>
            <td>{{ c.spaqScore }}/24<br><small>{{ c.spaqBand }}</small></td>
            <td>{{ c.phq9Score }}/27<br><small>{{ c.phq9Band }}</small></td>
            <td><span class="severity-badge severity-{{ c.combinedSeverity }}">{{ c.combinedSeverity }}</span></td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
