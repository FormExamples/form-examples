{% extends "base.html.tera" %}

{% block title %}Assessment Report - {{ severity_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Seasonal Affective Disorder Assessment &mdash; Report</h1>
    <div class="severity-badge severity-{{ combined_severity }}">{{ severity_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient Summary -->
<div class="card">
    <h2>Patient</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Country:</strong> {{ data.demographics.country }}<br>
            <strong>Latitude:</strong> {{ data.demographics.latitude }}
        </div>
    </div>
</div>

<!-- Scores -->
<div class="card">
    <h2>Scores</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Instrument</th>
                <th>Score</th>
                <th>Band</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>SPAQ Global Seasonality Score <small>(6 items × 0-4)</small></td>
                <td>{{ spaq_score }} / 24</td>
                <td><span class="badge">{{ spaq_label }}</span></td>
            </tr>
            <tr>
                <td>PHQ-9 Depression Severity <small>(9 items × 0-3)</small></td>
                <td>{{ phq9_score }} / 27</td>
                <td><span class="badge">{{ phq9_label }}</span></td>
            </tr>
            <tr>
                <td><strong>Combined Severity</strong></td>
                <td>&mdash;</td>
                <td><span class="severity-badge severity-{{ combined_severity }}">{{ severity_label }}</span></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-id"><code>{{ flag.id }}</code></span>
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Itemised answers -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Scored Items ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
