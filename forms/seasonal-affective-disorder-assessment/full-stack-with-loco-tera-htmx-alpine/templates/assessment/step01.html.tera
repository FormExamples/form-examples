<div class="card">
    <h2>Step 1: Demographics</h2>
    <p class="form-hint">Patient identification and geographic context. Latitude is used to flag high-latitude (≥50°) residence as a SAD risk factor.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" id="first_name" name="demographics.first_name"
                   value="{{ demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" id="last_name" name="demographics.last_name"
                   value="{{ demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="date_of_birth">Date of Birth</label>
            <input type="date" id="date_of_birth" name="demographics.date_of_birth"
                   value="{{ demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="sex">Sex</label>
            <select id="sex" name="demographics.sex">
                <option value="" {% if demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if demographics.sex == "other" %}selected{% endif %}>Other</option>
                <option value="prefer-not-to-say" {% if demographics.sex == "prefer-not-to-say" %}selected{% endif %}>Prefer not to say</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="country">Country of residence</label>
            <input type="text" id="country" name="demographics.country"
                   value="{{ demographics.country }}">
        </div>
        <div class="form-group">
            <label for="latitude">Latitude</label>
            <input type="text" id="latitude" name="demographics.latitude"
                   value="{{ demographics.latitude }}" placeholder="e.g. 54.5N">
        </div>
        <div class="form-group">
            <label for="years_at_current_latitude">Years at current latitude</label>
            <input type="number" min="0" id="years_at_current_latitude"
                   name="demographics.years_at_current_latitude"
                   value="{{ demographics.yearsAtCurrentLatitude | default(value="") }}">
        </div>
    </div>
</div>
