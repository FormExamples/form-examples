<div class="card">
    <h2>Step 5: Appetite &amp; Weight</h2>
    <p class="form-hint">SPAQ items for appetite and weight change with the seasons (each 0-4), plus carbohydrate craving and winter weight change.</p>

    {% set spaq = appetite_weight.spaq %}

    <div class="form-group">
        <label for="spaq_appetite">SPAQ-005: Appetite &mdash; how much does your appetite change with the seasons? (0-4)</label>
        <select id="spaq_appetite" name="appetite_weight.spaq.appetite">
            <option value="" {% if spaq.appetite is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if spaq.appetite == 0 %}selected{% endif %}>0 - No change</option>
            <option value="1" {% if spaq.appetite == 1 %}selected{% endif %}>1 - Slight change</option>
            <option value="2" {% if spaq.appetite == 2 %}selected{% endif %}>2 - Moderate change</option>
            <option value="3" {% if spaq.appetite == 3 %}selected{% endif %}>3 - Marked change</option>
            <option value="4" {% if spaq.appetite == 4 %}selected{% endif %}>4 - Extremely marked change</option>
        </select>
    </div>

    <div class="form-group">
        <label for="spaq_weight">SPAQ-004: Weight &mdash; how much does your weight change with the seasons? (0-4)</label>
        <select id="spaq_weight" name="appetite_weight.spaq.weight">
            <option value="" {% if spaq.weight is null %}selected{% endif %}>&mdash;</option>
            <option value="0" {% if spaq.weight == 0 %}selected{% endif %}>0 - No change</option>
            <option value="1" {% if spaq.weight == 1 %}selected{% endif %}>1 - Slight change</option>
            <option value="2" {% if spaq.weight == 2 %}selected{% endif %}>2 - Moderate change</option>
            <option value="3" {% if spaq.weight == 3 %}selected{% endif %}>3 - Marked change</option>
            <option value="4" {% if spaq.weight == 4 %}selected{% endif %}>4 - Extremely marked change</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="carbohydrate_craving">Marked carbohydrate craving in winter?</label>
            <select id="carbohydrate_craving" name="appetite_weight.carbohydrate_craving">
                <option value="" {% if appetite_weight.carbohydrateCraving == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if appetite_weight.carbohydrateCraving == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if appetite_weight.carbohydrateCraving == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="winter_weight_change_kg">Winter weight change (kg, +/-)</label>
            <input type="number" step="0.1" id="winter_weight_change_kg"
                   name="appetite_weight.winter_weight_change_kg"
                   value="{{ appetite_weight.winterWeightChangeKg | default(value="") }}">
        </div>
    </div>

    <div class="form-group">
        <label for="eating_pattern_changes">Eating pattern changes</label>
        <textarea id="eating_pattern_changes" name="appetite_weight.eating_pattern_changes" rows="2">{{ appetite_weight.eatingPatternChanges }}</textarea>
    </div>
</div>
