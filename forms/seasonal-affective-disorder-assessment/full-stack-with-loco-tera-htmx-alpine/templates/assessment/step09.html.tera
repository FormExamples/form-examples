<div class="card">
    <h2>Step 9: Risk Assessment (Self-harm)</h2>
    <p class="form-hint">
        Risk indicators are surfaced as high-priority flags by the engine.
        If any of these indicators are present, the combined severity is reported as <strong>critical</strong>.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="suicidal_ideation">Active suicidal ideation?</label>
            <select id="suicidal_ideation" name="risk_assessment.suicidal_ideation">
                <option value="" {% if risk_assessment.suicidalIdeation == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if risk_assessment.suicidalIdeation == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if risk_assessment.suicidalIdeation == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="suicidal_intent">Suicidal intent?</label>
            <select id="suicidal_intent" name="risk_assessment.suicidal_intent">
                <option value="" {% if risk_assessment.suicidalIntent == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if risk_assessment.suicidalIntent == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if risk_assessment.suicidalIntent == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="suicidal_plan">Suicidal plan (free text)</label>
        <textarea id="suicidal_plan" name="risk_assessment.suicidal_plan" rows="2">{{ risk_assessment.suicidalPlan }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="self_harm">Recent self-harm?</label>
            <select id="self_harm" name="risk_assessment.self_harm">
                <option value="" {% if risk_assessment.selfHarm == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if risk_assessment.selfHarm == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if risk_assessment.selfHarm == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="previous_attempt">Previous suicide attempt?</label>
            <select id="previous_attempt" name="risk_assessment.previous_attempt">
                <option value="" {% if risk_assessment.previousAttempt == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if risk_assessment.previousAttempt == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if risk_assessment.previousAttempt == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="safety_plan_in_place">Safety plan in place?</label>
            <select id="safety_plan_in_place" name="risk_assessment.safety_plan_in_place">
                <option value="" {% if risk_assessment.safetyPlanInPlace == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if risk_assessment.safetyPlanInPlace == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if risk_assessment.safetyPlanInPlace == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="self_harm_details">Self-harm details</label>
        <textarea id="self_harm_details" name="risk_assessment.self_harm_details" rows="2">{{ risk_assessment.selfHarmDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="protective_factors">Protective factors</label>
        <textarea id="protective_factors" name="risk_assessment.protective_factors" rows="2">{{ risk_assessment.protectiveFactors }}</textarea>
    </div>
</div>
