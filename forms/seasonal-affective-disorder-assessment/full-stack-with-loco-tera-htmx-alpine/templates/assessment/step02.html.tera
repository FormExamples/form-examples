<div class="card">
    <h2>Step 2: Seasonal Pattern History</h2>
    <p class="form-hint">Recurrence and timing of seasonal symptoms across years.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="symptoms_recur_annually">Symptoms recur annually?</label>
            <select id="symptoms_recur_annually" name="seasonal_pattern_history.symptoms_recur_annually">
                <option value="" {% if seasonal_pattern_history.symptomsRecurAnnually == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if seasonal_pattern_history.symptomsRecurAnnually == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if seasonal_pattern_history.symptomsRecurAnnually == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
        <div class="form-group">
            <label for="family_history_sad">Family history of SAD?</label>
            <select id="family_history_sad" name="seasonal_pattern_history.family_history_sad">
                <option value="" {% if seasonal_pattern_history.familyHistorySad == "" %}selected{% endif %}>&mdash;</option>
                <option value="no" {% if seasonal_pattern_history.familyHistorySad == "no" %}selected{% endif %}>No</option>
                <option value="yes" {% if seasonal_pattern_history.familyHistorySad == "yes" %}selected{% endif %}>Yes</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="worst_months">Worst months</label>
            <input type="text" id="worst_months" name="seasonal_pattern_history.worst_months"
                   value="{{ seasonal_pattern_history.worstMonths }}" placeholder="e.g. Nov-Feb">
        </div>
        <div class="form-group">
            <label for="best_months">Best months</label>
            <input type="text" id="best_months" name="seasonal_pattern_history.best_months"
                   value="{{ seasonal_pattern_history.bestMonths }}" placeholder="e.g. May-Aug">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="years_affected">Years affected</label>
            <input type="number" min="0" id="years_affected" name="seasonal_pattern_history.years_affected"
                   value="{{ seasonal_pattern_history.yearsAffected | default(value="") }}">
        </div>
        <div class="form-group">
            <label for="first_onset_age">First onset age</label>
            <input type="text" id="first_onset_age" name="seasonal_pattern_history.first_onset_age"
                   value="{{ seasonal_pattern_history.firstOnsetAge }}">
        </div>
    </div>
</div>
