#!/bin/sh
set -euf

form_kebab_case=soap-note
form_snake_case=soap_note

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold soap_note \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    encountered_at:tstz \
    care_setting:string! \
    encounter_type:string! \
    clinician_role:string! \
    patient_identifier:string! \
    presenting_complaint:text! \
    history_of_presenting_complaint:text! \
    patient_reported_symptoms:text! \
    relevant_history:text! \
    red_flag_symptoms:string! \
    examination_findings:text! \
    vital_signs:text! \
    abnormal_vitals_present:string! \
    investigation_results:text! \
    primary_diagnosis:text! \
    problem_list:text! \
    differential:text! \
    clinical_impression:text! \
    investigations_plan:text! \
    treatment_plan:text! \
    referrals:text! \
    follow_up:text! \
    safety_netting:text! \
    managed_at_home:string! \
    clinical_note:text! \
    --api

cargo loco generate scaffold soap_note_grade \
    deleted_at:tstz \
    soap_note:references \
    status:string! \
    completeness_percent:int \
    subjective_present:string! \
    objective_present:string! \
    assessment_present:string! \
    plan_present:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold soap_note_grade_rule \
    deleted_at:tstz \
    soap_note_grade:references \
    rule_id:string! \
    section:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold soap_note_grade_flag \
    deleted_at:tstz \
    soap_note_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
