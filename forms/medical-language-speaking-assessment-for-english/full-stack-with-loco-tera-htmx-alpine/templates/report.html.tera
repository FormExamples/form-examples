{% extends "base.html.tera" %}

{% block title %}OET Assessment Report - {{ grade_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Medical Language Speaking Assessment for English &mdash; Examiner Report</h1>
    <div class="grade-badge grade-{{ grade | lower }}">{{ grade_label }}</div>
    <div class="checklist-label">Scaled score: {{ scaled_score }} / 500</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Candidate Summary -->
<div class="card">
    <h2>Candidate Summary</h2>
    <div class="form-row">
        <div>
            <strong>Candidate:</strong> {{ data.candidate.candidateName }}<br>
            <strong>Candidate ID:</strong> {{ data.candidate.candidateId }}<br>
            <strong>First Language:</strong> {{ data.candidate.firstLanguage }}<br>
            <strong>Country of Training:</strong> {{ data.candidate.countryOfTraining }}<br>
            <strong>Years of Experience:</strong> {{ data.candidate.yearsOfExperience }}
        </div>
        <div>
            <strong>Examiner:</strong> {{ data.candidate.examinerName }}<br>
            <strong>Test Centre:</strong> {{ data.candidate.testCentre }}<br>
            <strong>Test Date:</strong> {{ data.candidate.testDate }}<br>
            <strong>Profession:</strong> {{ data.candidate.profession }}
        </div>
    </div>
</div>

<!-- Score Breakdown -->
<div class="card">
    <h2>Score Breakdown</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Component</th>
                <th>Range</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Linguistic criteria (mean across role-plays)</td>
                <td>0 - 24</td>
                <td>{{ linguistic_total }}</td>
            </tr>
            <tr>
                <td>Clinical communication indicators</td>
                <td>0 - 15</td>
                <td>{{ clinical_total }}</td>
            </tr>
            <tr>
                <td>Raw total</td>
                <td>0 - 39</td>
                <td>{{ raw_total }}</td>
            </tr>
            <tr>
                <td>Scaled score</td>
                <td>0 - 500</td>
                <td>{{ scaled_score }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Per-criterion table -->
<div class="card">
    <h2>Per-Criterion Audit ({{ per_criterion_scores | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Domain</th>
                <th>Criterion</th>
                <th>Role-play 1</th>
                <th>Role-play 2</th>
                <th>Mean</th>
                <th>Max</th>
            </tr>
        </thead>
        <tbody>
            {% for s in per_criterion_scores %}
            <tr>
                <td><code>{{ s.id }}</code></td>
                <td>{{ s.domain }}</td>
                <td>{{ s.label }}</td>
                <td>{% if s.rolePlay1Score is null %}&mdash;{% else %}{{ s.rolePlay1Score }}{% endif %}</td>
                <td>{% if s.rolePlay2Score is null %}&mdash;{% else %}{{ s.rolePlay2Score }}{% endif %}</td>
                <td>{% if s.meanScore is null %}&mdash;{% else %}{{ s.meanScore }}{% endif %}</td>
                <td>{{ s.maxScore }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Flagged issues -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules (rated criteria) -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Rated Criteria ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.score }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
