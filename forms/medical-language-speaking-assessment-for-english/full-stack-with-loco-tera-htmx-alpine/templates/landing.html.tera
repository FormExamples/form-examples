{% extends "base.html.tera" %}

{% block title %}Medical Language Speaking Assessment for English - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Medical Language Speaking Assessment for English</h1>
        <p class="landing-description">
            Clinical English-language speaking assessment for internationally educated
            healthcare professionals, modelled on the Occupational English Test
            (OET) Speaking Sub-test for the Medicine profession. The candidate
            completes two role-played clinical scenarios; the examiner rates the
            candidate against four <strong>linguistic criteria</strong> and five
            <strong>clinical communication indicators</strong>, producing a scaled
            score (0-500) and an overall grade (A, B, C+, C, D, or E).
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Two Role-plays</h3>
                <p>Patient Interview and Clinical Explanation &mdash; each with examiner notes and a safety-criticality flag</p>
            </div>
            <div class="feature">
                <h3>Linguistic + Clinical</h3>
                <p>0-6 linguistic ratings per role-play and 0-3 clinical communication indicators across the sub-test</p>
            </div>
            <div class="feature">
                <h3>Grade A-E</h3>
                <p>0-500 scaled score mapped to OET grades; Grade B is the typical UK / Ireland / Australia / New Zealand clinical threshold</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
