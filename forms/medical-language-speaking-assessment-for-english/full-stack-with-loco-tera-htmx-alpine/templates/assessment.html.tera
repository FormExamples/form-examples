{% extends "base.html.tera" %}

{% block title %}Medical Language Speaking Assessment for English - Assessment{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>Medical Language Speaking Assessment for English</h1>
    <p class="form-hint">
        Complete all five sections (Candidate details, Role-play 1, Role-play 2,
        Linguistic criteria rating, Clinical communication indicators) and submit
        to calculate the OET scaled score (0-500) and overall grade (A-E).
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}
    {% include "assessment/step04.html.tera" %}
    {% include "assessment/step05.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Calculate score and grade</button>
    </div>
</form>
{% endblock %}
