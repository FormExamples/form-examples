<div class="card">
    <h2>Step 5: Clinical Communication Indicators &amp; Overall Grade</h2>
    <p class="form-hint">
        Rate each clinical communication indicator <strong>0 to 3</strong>
        across the whole speaking sub-test (not per role-play). The grader
        combines the linguistic mean and clinical totals into a raw score
        (0-39), scaled to 0-500, and mapped to an OET grade A-E.
    </p>

    <h3>Clinical communication indicators (0-3)</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="ci_relationship_building">Relationship-building (CLIN-REL)</label>
            <input type="number" min="0" max="3" step="1"
                   id="ci_relationship_building" name="clinical_indicators.relationship_building"
                   value="{% if clinical_indicators.relationshipBuilding is null %}{% else %}{{ clinical_indicators.relationshipBuilding }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_understanding_patient_perspective">Understanding Patient&rsquo;s Perspective (CLIN-UPP)</label>
            <input type="number" min="0" max="3" step="1"
                   id="ci_understanding_patient_perspective" name="clinical_indicators.understanding_patient_perspective"
                   value="{% if clinical_indicators.understandingPatientPerspective is null %}{% else %}{{ clinical_indicators.understandingPatientPerspective }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_providing_structure">Providing Structure (CLIN-STR)</label>
            <input type="number" min="0" max="3" step="1"
                   id="ci_providing_structure" name="clinical_indicators.providing_structure"
                   value="{% if clinical_indicators.providingStructure is null %}{% else %}{{ clinical_indicators.providingStructure }}{% endif %}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ci_information_gathering">Information-gathering (CLIN-IGT)</label>
            <input type="number" min="0" max="3" step="1"
                   id="ci_information_gathering" name="clinical_indicators.information_gathering"
                   value="{% if clinical_indicators.informationGathering is null %}{% else %}{{ clinical_indicators.informationGathering }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="ci_information_giving">Information-giving (CLIN-IGV)</label>
            <input type="number" min="0" max="3" step="1"
                   id="ci_information_giving" name="clinical_indicators.information_giving"
                   value="{% if clinical_indicators.informationGiving is null %}{% else %}{{ clinical_indicators.informationGiving }}{% endif %}">
        </div>
    </div>

    <div class="form-group">
        <label for="ci_examiner_notes">Examiner Notes (Clinical Communication)</label>
        <textarea id="ci_examiner_notes" name="clinical_indicators.examiner_notes">{{ clinical_indicators.examinerNotes }}</textarea>
    </div>
</div>
