#!/bin/sh
set -euf

form_kebab_case=fluid-balance-chart
form_snake_case=fluid_balance_chart

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold fluid_balance_chart \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    clinician_name:text! \
    clinician_role:string! \
    patient_identifier:text! \
    ward_or_unit:text! \
    chart_start_at:tstz \
    chart_period_hours:double \
    weight_kg:double \
    clinical_note:text! \
    --api

cargo loco generate scaffold fluid_balance_chart_entry \
    deleted_at:tstz \
    fluid_balance_chart:references \
    entry_at:tstz \
    direction:string! \
    category:string! \
    description:text! \
    volume_ml:double \
    --api

cargo loco generate scaffold fluid_balance_chart_grade \
    deleted_at:tstz \
    fluid_balance_chart:references \
    total_intake_ml:double! \
    total_output_ml:double! \
    net_balance_ml:double! \
    urine_output_ml:double! \
    hours_observed:double \
    weight_kg:double \
    urine_output_ml_kg_h:double \
    fluid_status:string! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold fluid_balance_chart_grade_rule \
    deleted_at:tstz \
    fluid_balance_chart_grade:references \
    rule_id:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold fluid_balance_chart_grade_flag \
    deleted_at:tstz \
    fluid_balance_chart_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"

# Add #![forbid(unsafe_code)] to each crate root the scaffold created:
# the library, the -cli binary, the migration library, and the tests.
"$(git rev-parse --show-toplevel)/bin/loco-forbid-unsafe" "${form_kebab_case}"
