<div x-data="{ step: 1 }">
  <fieldset x-show="step === 1">
    <legend>1. Donor</legend>
    <label>Donor person ID
      <input type="text" name="donor_person_id" value="{{ item.donor_person_id | default(value='') }}">
    </label>
  </fieldset>

  <fieldset x-show="step === 3">
    <legend>3. Decision mode</legend>
    <select name="decision_mode">
      <option value="">(unset)</option>
      <option value="single_attorney" {% if item.decision_mode == "single_attorney" %}selected{% endif %}>Single attorney</option>
      <option value="jointly_and_severally" {% if item.decision_mode == "jointly_and_severally" %}selected{% endif %}>Jointly and severally</option>
      <option value="jointly" {% if item.decision_mode == "jointly" %}selected{% endif %}>Jointly</option>
      <option value="mixed" {% if item.decision_mode == "mixed" %}selected{% endif %}>Mixed</option>
    </select>
    <label>If mixed, describe
      <textarea name="decision_mode_mixed_text">{{ item.decision_mode_mixed_text | default(value='') }}</textarea>
    </label>
  </fieldset>

  <fieldset x-show="step === 5">
    <legend>5. When attorneys can act</legend>
    <select name="when_attorneys_can_act">
      <option value="">(unset)</option>
      <option value="as_soon_as_registered" {% if item.when_attorneys_can_act == "as_soon_as_registered" %}selected{% endif %}>As soon as registered</option>
      <option value="only_when_no_capacity" {% if item.when_attorneys_can_act == "only_when_no_capacity" %}selected{% endif %}>Only when I don't have mental capacity</option>
    </select>
  </fieldset>

  <fieldset x-show="step === 7">
    <legend>7. Preferences and instructions</legend>
    <label>Preferences
      <textarea name="preferences_text">{{ item.preferences_text | default(value='') }}</textarea>
    </label>
    <label>Instructions
      <textarea name="instructions_text">{{ item.instructions_text | default(value='') }}</textarea>
    </label>
  </fieldset>

  <fieldset x-show="step === 8">
    <legend>8. Legal rights</legend>
    <label>
      <input type="checkbox" name="legal_rights_acknowledged" value="true" {% if item.legal_rights_acknowledged %}checked{% endif %}>
      I have read the legal-rights statement
    </label>
  </fieldset>

  <nav class="wizard-nav">
    <button type="button" x-on:click="step = Math.max(1, step - 1)">Back</button>
    <span x-text="'Step ' + step + ' / 15'"></span>
    <button type="button" x-on:click="step = Math.min(15, step + 1)">Next</button>
  </nav>
</div>
