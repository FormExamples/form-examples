{% extends "base.html.tera" %}
{% block title %}LPA {{ item.id }}{% endblock %}
{% block content %}
<article class="lpa-show" x-data="{ tab: 'overview' }">
  <h2>LPA {{ item.id }}</h2>
  <p><a href="/lpa/{{ item.id }}/edit">edit</a></p>
  <dl>
    <dt>Donor person</dt><dd>{{ item.donor_person_id }}</dd>
    <dt>Decision mode</dt><dd>{{ item.decision_mode }}</dd>
    <dt>When attorneys can act</dt><dd>{{ item.when_attorneys_can_act }}</dd>
    <dt>Status</dt><dd>{{ item.status }}</dd>
  </dl>
  <button hx-post="/lpa/{{ item.id }}/validate" hx-target="#validation">Validate</button>
  <div id="validation"></div>
</article>
{% endblock %}
