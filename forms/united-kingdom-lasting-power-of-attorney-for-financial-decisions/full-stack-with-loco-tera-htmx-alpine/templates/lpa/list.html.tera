{% extends "base.html.tera" %}
{% block title %}LPAs{% endblock %}
{% block content %}
<section class="lpa-list" hx-target="this">
  <h2>Lasting powers of attorney</h2>
  <p><a href="/lpa/new">Start a new LPA</a></p>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Donor</th>
        <th>Decision mode</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for row in items %}
        <tr>
          <td><a href="/lpa/{{ row.id }}">{{ row.id }}</a></td>
          <td>{{ row.donor_person_id }}</td>
          <td>{{ row.decision_mode }}</td>
          <td>{{ row.status }}</td>
          <td>
            <a href="/lpa/{{ row.id }}/edit">edit</a>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endblock %}
