<label>LPA ID <input type="text" name="lpa_id" value="{{ item.lpa_id | default(value='') }}"></label>
<label>Signatory person ID <input type="text" name="signatory_person_id" value="{{ item.signatory_person_id | default(value='') }}"></label>
<label>Role
  <select name="role">
    <option value="donor">Donor</option>
    <option value="certificate_provider">Certificate provider</option>
    <option value="attorney">Attorney</option>
    <option value="replacement_attorney">Replacement attorney</option>
    <option value="applicant">Applicant</option>
    <option value="signing_on_behalf_of_donor">Signing on behalf of donor</option>
    <option value="trust_corporation_authorised_person">Trust corporation authorised person</option>
  </select>
</label>
<label>LP1F section
  <select name="lp1f_section">
    <option value="9">9 — Donor</option>
    <option value="10">10 — Certificate provider</option>
    <option value="11">11 — Attorneys/replacements</option>
    <option value="15">15 — Registration applicant</option>
  </select>
</label>
<label>Signature blob path <input type="text" name="signature_blob_path" value="{{ item.signature_blob_path | default(value='') }}"></label>
<label>Signed on <input type="date" name="signed_on" value="{{ item.signed_on | default(value='') }}"></label>
<label>Signed-on-behalf full name <input type="text" name="signed_on_behalf_full_name" value="{{ item.signed_on_behalf_full_name | default(value='') }}"></label>
<label><input type="checkbox" name="is_witnessed" value="true" {% if item.is_witnessed %}checked{% endif %}> Witnessed</label>
