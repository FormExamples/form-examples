<label>LPA ID <input type="text" name="lpa_id" value="{{ item.lpa_id | default(value='') }}"></label>
<label>Applicant kind
  <select name="applicant_kind">
    <option value="">(unset)</option>
    <option value="donor">Donor</option>
    <option value="attorneys">Attorneys</option>
  </select>
</label>
<label>Payment method
  <select name="payment_method">
    <option value="">(unset)</option>
    <option value="card">Card</option>
    <option value="cheque">Cheque</option>
  </select>
</label>
<label>Card payment phone <input type="tel" name="card_payment_phone" value="{{ item.card_payment_phone | default(value='') }}"></label>
<label><input type="checkbox" name="reduced_fee_requested" value="true" {% if item.reduced_fee_requested %}checked{% endif %}> Reduced fee</label>
<label><input type="checkbox" name="has_lpa120a_evidence" value="true" {% if item.has_lpa120a_evidence %}checked{% endif %}> LPA120A evidence attached</label>
<label><input type="checkbox" name="is_repeat_application" value="true" {% if item.is_repeat_application %}checked{% endif %}> Repeat application</label>
<label>Repeat case number <input type="text" name="repeat_case_number" value="{{ item.repeat_case_number | default(value='') }}"></label>
<label>Payment reference <input type="text" name="payment_reference" value="{{ item.payment_reference | default(value='') }}"></label>
<label>Payment date <input type="date" name="payment_date" value="{{ item.payment_date | default(value='') }}"></label>
<label>Payment amount (GBP) <input type="number" step="0.01" name="payment_amount" value="{{ item.payment_amount | default(value='') }}"></label>
