{% extends "base.html.tera" %}
{% block title %}Registration applications{% endblock %}
{% block content %}<h2>Registration applications</h2><p><a href="/lpa_registration_application/new">New</a></p>
<ul>{% for row in items %}<li><a href="/lpa_registration_application/{{ row.id }}">LPA {{ row.lpa_id }} ({{ row.applicant_kind }})</a></li>{% endfor %}</ul>{% endblock %}
