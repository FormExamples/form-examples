{% extends "base.html.tera" %}
{% block title %}{{ item.first_names }} {{ item.last_name }}{% endblock %}
{% block content %}
<article><h2>{{ item.title }} {{ item.first_names }} {{ item.last_name }}</h2>
<p><a href="/person/{{ item.id }}/edit">edit</a></p>
<dl>
  <dt>DOB</dt><dd>{{ item.date_of_birth }}</dd>
  <dt>Email</dt><dd>{{ item.email }}</dd>
  <dt>Phone</dt><dd>{{ item.phone }}</dd>
  <dt>Trust corporation</dt><dd>{{ item.is_trust_corporation }}</dd>
</dl></article>{% endblock %}
