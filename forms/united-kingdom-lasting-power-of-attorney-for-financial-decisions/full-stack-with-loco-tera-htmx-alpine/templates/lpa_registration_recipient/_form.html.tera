<label>LPA ID <input type="text" name="lpa_id" value="{{ item.lpa_id | default(value='') }}"></label>
<label>Recipient kind
  <select name="recipient_kind">
    <option value="">(unset)</option>
    <option value="donor">Donor</option>
    <option value="attorney">Attorney</option>
    <option value="other">Other</option>
  </select>
</label>
<label>Recipient person ID <input type="text" name="recipient_person_id" value="{{ item.recipient_person_id | default(value='') }}"></label>
<label>Company name <input type="text" name="company_name" value="{{ item.company_name | default(value='') }}"></label>
<label><input type="checkbox" name="prefers_post" value="true" {% if item.prefers_post %}checked{% endif %}> Prefers post</label>
<label><input type="checkbox" name="prefers_phone" value="true" {% if item.prefers_phone %}checked{% endif %}> Prefers phone</label>
<label><input type="checkbox" name="prefers_email" value="true" {% if item.prefers_email %}checked{% endif %}> Prefers email</label>
<label><input type="checkbox" name="prefers_welsh" value="true" {% if item.prefers_welsh %}checked{% endif %}> Prefers Welsh</label>
<label>Contact phone <input type="tel" name="contact_phone" value="{{ item.contact_phone | default(value='') }}"></label>
<label>Contact email <input type="email" name="contact_email" value="{{ item.contact_email | default(value='') }}"></label>
