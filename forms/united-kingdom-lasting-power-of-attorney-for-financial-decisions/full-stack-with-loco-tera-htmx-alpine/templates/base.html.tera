<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}UK Lasting Power of Attorney for Financial Decisions{% endblock %}</title>
    <link rel="stylesheet" href="/static/app.css">
    <script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>
<body hx-boost="true">
    <header>
        <h1><a href="/">UK Lasting Power of Attorney for Financial Decisions</a></h1>
        <nav>
            <a href="/lpa">LPAs</a>
            <a href="/lpa/new">New LPA</a>
        </nav>
    </header>
    <main>
        {% block content %}{% endblock %}
    </main>
    <footer>
        <small>LP1F under the Mental Capacity Act 2005 — Office of the Public Guardian.</small>
    </footer>
</body>
</html>
