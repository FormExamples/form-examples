{% extends "base.html.tera" %}
{% block content %}<article><h2>Certificate provider {{ item.id }}</h2>
<dl><dt>LPA</dt><dd>{{ item.lpa_id }}</dd><dt>Person</dt><dd>{{ item.person_id }}</dd><dt>Knows donor as</dt><dd>{{ item.knows_donor_as }}</dd></dl>
<a href="/lpa_certificate_provider/{{ item.id }}/edit">edit</a></article>{% endblock %}
