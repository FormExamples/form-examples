#!/bin/sh
set -euf

form_kebab_case=united-kingdom-lasting-power-of-attorney-for-financial-decisions
form_snake_case=united_kingdom_lasting_power_of_attorney_for_financial_decisions

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold person \
    deleted_at:tstz \
    title:text! \
    first_names:text! \
    last_name:text! \
    other_names:text! \
    date_of_birth:date \
    email:text! \
    phone:text! \
    address_id:uuid \
    is_trust_corporation:bool! \
    trust_corporation_number:text! \
    is_bankrupt:bool! \
    has_debt_relief_order:bool! \
    --api

cargo loco generate scaffold address \
    deleted_at:tstz \
    address_line_1:text! \
    address_line_2:text! \
    address_line_3:text! \
    postcode:text! \
    country_as_iso_3166_1_alpha_2:text! \
    --api

cargo loco generate scaffold lasting_power_of_attorney \
    deleted_at:tstz \
    donor_person:references \
    decision_mode:text! \
    decision_mode_mixed_text:text! \
    when_attorneys_can_act:text! \
    preferences_text:text! \
    instructions_text:text! \
    legal_rights_acknowledged:bool! \
    opg_reference_number:text! \
    opg_registration_date:date \
    status:text! \
    --api

cargo loco generate scaffold lpa_attorney \
    deleted_at:tstz \
    lpa:references \
    person:references \
    ordinal:int! \
    --api

cargo loco generate scaffold lpa_replacement_attorney \
    deleted_at:tstz \
    lpa:references \
    person:references \
    ordinal:int! \
    replacement_step_in_condition:text! \
    --api

cargo loco generate scaffold lpa_certificate_provider \
    deleted_at:tstz \
    lpa:references \
    person:references \
    knows_donor_as:text! \
    is_over_eighteen:bool! \
    read_lpa:bool! \
    no_restrictions_on_acting:bool! \
    eligibility_confirmation_at:tstz \
    --api

cargo loco generate scaffold lpa_person_to_notify \
    deleted_at:tstz \
    lpa:references \
    person:references \
    ordinal:int! \
    --api

cargo loco generate scaffold lpa_preferences_and_instructions \
    deleted_at:tstz \
    lpa:references \
    preferences_overflow_text:text! \
    instructions_overflow_text:text! \
    decisions_jointly_overflow_text:text! \
    replacement_step_in_overflow_text:text! \
    --api

cargo loco generate scaffold lpa_signature \
    deleted_at:tstz \
    lpa:references \
    signatory_person:references \
    role:text! \
    lp1f_section:int! \
    signature_blob_path:text! \
    signed_on:date \
    signed_on_behalf_full_name:text! \
    is_witnessed:bool! \
    --api

cargo loco generate scaffold lpa_witness \
    deleted_at:tstz \
    signature:references \
    witness_person:references \
    witness_signature_blob_path:text! \
    witnessed_on:date \
    --api

cargo loco generate scaffold lpa_continuation_sheet \
    deleted_at:tstz \
    lpa:references \
    kind:text! \
    body_text:text! \
    signed_on:date \
    ordinal:int! \
    --api

cargo loco generate scaffold lpa_registration_application \
    deleted_at:tstz \
    lpa:references \
    applicant_kind:text! \
    payment_method:text! \
    card_payment_phone:text! \
    reduced_fee_requested:bool! \
    has_lpa120a_evidence:bool! \
    is_repeat_application:bool! \
    repeat_case_number:text! \
    payment_reference:text! \
    payment_date:date \
    payment_amount:double \
    --api

cargo loco generate scaffold lpa_registration_recipient \
    deleted_at:tstz \
    lpa:references \
    recipient_kind:text! \
    recipient_person:references \
    company_name:text! \
    prefers_post:bool! \
    prefers_phone:bool! \
    prefers_email:bool! \
    prefers_welsh:bool! \
    contact_phone:text! \
    contact_email:text! \
    other_first_names:text! \
    other_last_name:text! \
    other_address_line_1:text! \
    other_address_line_2:text! \
    other_address_line_3:text! \
    other_postcode:text! \
    --api

cargo loco generate scaffold lpa_validation_result \
    deleted_at:tstz \
    lpa:references \
    validity_band:text! \
    composite_risk:text! \
    computed_at:tstz! \
    --api

cargo loco generate scaffold lpa_validation_rule \
    deleted_at:tstz \
    lpa:references \
    rule_name:text! \
    priority:text! \
    statutory_citation:text! \
    remediation_hint:text! \
    fired_at:tstz! \
    --api

cargo loco generate scaffold lpa_validation_flag \
    deleted_at:tstz \
    lpa:references \
    flag_name:text! \
    priority:text! \
    category:text! \
    remediation_hint:text! \
    fired_at:tstz! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
