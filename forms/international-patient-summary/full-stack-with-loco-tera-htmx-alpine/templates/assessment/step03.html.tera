<div class="card">
    <h2>Section 3: Medication Summary <span class="mandatory-badge">Mandatory</span></h2>
    <p class="form-hint">Current and recent medications. Use ATC coding where possible. Up to six rows.</p>

    {% for i in range(end=6) %}
    <fieldset class="list-row">
        <legend>Medication {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="medication_summary_{{ i }}_name">Name</label>
                <input type="text" id="medication_summary_{{ i }}_name" name="medication_summary[{{ i }}].name"
                       value="{% if medication_summary | length > i %}{{ medication_summary[i].name }}{% endif %}"
                       placeholder="e.g. Metformin">
            </div>
            <div class="form-group">
                <label for="medication_summary_{{ i }}_atc_code">ATC code</label>
                <input type="text" id="medication_summary_{{ i }}_atc_code" name="medication_summary[{{ i }}].atc_code"
                       value="{% if medication_summary | length > i %}{{ medication_summary[i].atcCode }}{% endif %}"
                       placeholder="e.g. A10BA02">
            </div>
            <div class="form-group">
                <label for="medication_summary_{{ i }}_dose">Dose</label>
                <input type="text" id="medication_summary_{{ i }}_dose" name="medication_summary[{{ i }}].dose"
                       value="{% if medication_summary | length > i %}{{ medication_summary[i].dose }}{% endif %}"
                       placeholder="e.g. 500 mg">
            </div>
            <div class="form-group">
                <label for="medication_summary_{{ i }}_frequency">Frequency</label>
                <input type="text" id="medication_summary_{{ i }}_frequency" name="medication_summary[{{ i }}].frequency"
                       value="{% if medication_summary | length > i %}{{ medication_summary[i].frequency }}{% endif %}"
                       placeholder="e.g. BD">
            </div>
            <div class="form-group">
                <label for="medication_summary_{{ i }}_route">Route</label>
                <input type="text" id="medication_summary_{{ i }}_route" name="medication_summary[{{ i }}].route"
                       value="{% if medication_summary | length > i %}{{ medication_summary[i].route }}{% endif %}"
                       placeholder="e.g. PO">
            </div>
        </div>
    </fieldset>
    {% endfor %}
</div>
