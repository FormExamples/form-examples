<div class="card">
    <h2>Section 4: Allergies &amp; Intolerances <span class="mandatory-badge">Mandatory</span></h2>
    <p class="form-hint">Drug, food, and environmental allergies. Add a "no known allergies" entry if applicable. Up to six rows.</p>

    {% for i in range(end=6) %}
    <fieldset class="list-row">
        <legend>Allergy {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="allergies_intolerances_{{ i }}_substance">Substance</label>
                <input type="text" id="allergies_intolerances_{{ i }}_substance" name="allergies_intolerances[{{ i }}].substance"
                       value="{% if allergies_intolerances | length > i %}{{ allergies_intolerances[i].substance }}{% endif %}"
                       placeholder="e.g. Penicillin">
            </div>
            <div class="form-group">
                <label for="allergies_intolerances_{{ i }}_reaction">Reaction</label>
                <input type="text" id="allergies_intolerances_{{ i }}_reaction" name="allergies_intolerances[{{ i }}].reaction"
                       value="{% if allergies_intolerances | length > i %}{{ allergies_intolerances[i].reaction }}{% endif %}"
                       placeholder="e.g. Anaphylaxis">
            </div>
            <div class="form-group">
                <label for="allergies_intolerances_{{ i }}_severity">Severity</label>
                {% set sev = "" %}{% if allergies_intolerances | length > i %}{% set_global sev = allergies_intolerances[i].severity %}{% endif %}
                <select id="allergies_intolerances_{{ i }}_severity" name="allergies_intolerances[{{ i }}].severity">
                    <option value="" {% if sev == "" %}selected{% endif %}>&mdash;</option>
                    <option value="mild" {% if sev == "mild" %}selected{% endif %}>Mild</option>
                    <option value="moderate" {% if sev == "moderate" %}selected{% endif %}>Moderate</option>
                    <option value="severe" {% if sev == "severe" %}selected{% endif %}>Severe</option>
                </select>
            </div>
            <div class="form-group">
                <label for="allergies_intolerances_{{ i }}_criticality">Criticality</label>
                {% set crit = "" %}{% if allergies_intolerances | length > i %}{% set_global crit = allergies_intolerances[i].criticality %}{% endif %}
                <select id="allergies_intolerances_{{ i }}_criticality" name="allergies_intolerances[{{ i }}].criticality">
                    <option value="" {% if crit == "" %}selected{% endif %}>&mdash;</option>
                    <option value="low" {% if crit == "low" %}selected{% endif %}>Low</option>
                    <option value="high" {% if crit == "high" %}selected{% endif %}>High</option>
                    <option value="unable-to-assess" {% if crit == "unable-to-assess" %}selected{% endif %}>Unable to assess</option>
                </select>
            </div>
        </div>
    </fieldset>
    {% endfor %}
</div>
