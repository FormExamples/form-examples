<div class="card">
    <h2>Section 6: Procedures <span class="mandatory-badge">Mandatory</span></h2>
    <p class="form-hint">Significant past procedures and operations relevant to ongoing care. Up to six rows.</p>

    {% for i in range(end=6) %}
    <fieldset class="list-row">
        <legend>Procedure {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="procedures_{{ i }}_description">Procedure</label>
                <input type="text" id="procedures_{{ i }}_description" name="procedures[{{ i }}].description"
                       value="{% if procedures | length > i %}{{ procedures[i].description }}{% endif %}"
                       placeholder="e.g. Cholecystectomy">
            </div>
            <div class="form-group">
                <label for="procedures_{{ i }}_date">Date</label>
                <input type="date" id="procedures_{{ i }}_date" name="procedures[{{ i }}].date"
                       value="{% if procedures | length > i %}{{ procedures[i].date }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="procedures_{{ i }}_performer">Performer / facility</label>
                <input type="text" id="procedures_{{ i }}_performer" name="procedures[{{ i }}].performer"
                       value="{% if procedures | length > i %}{{ procedures[i].performer }}{% endif %}"
                       placeholder="Hospital or clinician">
            </div>
        </div>
    </fieldset>
    {% endfor %}
</div>
