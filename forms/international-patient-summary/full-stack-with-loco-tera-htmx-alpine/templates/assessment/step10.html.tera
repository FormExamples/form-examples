<div class="card">
    <h2>Section 10: Authoring Clinician &amp; Signoff <span class="mandatory-badge">Mandatory</span></h2>
    <p class="form-hint">Identifies the clinician responsible for compiling and signing this IPS.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="clinician_name">Clinician name</label>
            <input type="text" id="clinician_name" name="authoring_clinician.clinician_name"
                   value="{{ authoring_clinician.clinicianName }}">
        </div>
        <div class="form-group">
            <label for="clinician_role">Role / specialty</label>
            <input type="text" id="clinician_role" name="authoring_clinician.clinician_role"
                   value="{{ authoring_clinician.clinicianRole }}" placeholder="e.g. General Practitioner">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="organisation">Organisation</label>
            <input type="text" id="organisation" name="authoring_clinician.organisation"
                   value="{{ authoring_clinician.organisation }}">
        </div>
        <div class="form-group">
            <label for="authoring_clinician_country">Country (ISO 3166)</label>
            <input type="text" id="authoring_clinician_country" name="authoring_clinician.country"
                   value="{{ authoring_clinician.country }}" placeholder="e.g. GB">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="authoring_clinician_email">Clinician email</label>
            <input type="email" id="authoring_clinician_email" name="authoring_clinician.email"
                   value="{{ authoring_clinician.email }}">
        </div>
        <div class="form-group">
            <label for="authoring_clinician_phone">Clinician phone</label>
            <input type="tel" id="authoring_clinician_phone" name="authoring_clinician.phone"
                   value="{{ authoring_clinician.phone }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="signoff_date">Signoff date</label>
            <input type="date" id="signoff_date" name="authoring_clinician.signoff_date"
                   value="{{ authoring_clinician.signoffDate }}">
        </div>
        <div class="form-group">
            <label for="authoring_status">Authoring status</label>
            <select id="authoring_status" name="authoring_clinician.authoring_status">
                <option value="" {% if authoring_clinician.authoringStatus == "" %}selected{% endif %}>&mdash;</option>
                <option value="draft" {% if authoring_clinician.authoringStatus == "draft" %}selected{% endif %}>Draft</option>
                <option value="final" {% if authoring_clinician.authoringStatus == "final" %}selected{% endif %}>Final</option>
            </select>
        </div>
    </div>
</div>
