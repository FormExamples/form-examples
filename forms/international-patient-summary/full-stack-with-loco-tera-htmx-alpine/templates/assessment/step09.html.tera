<div class="card">
    <h2>Section 9: Advance Directives &amp; Consent <span class="optional-badge">Optional</span></h2>
    <p class="form-hint">DNR orders, living wills, and patient consent for cross-border IPS exchange.</p>

    <div class="form-group">
        <label for="dnr_in_place">Is a DNR (Do Not Resuscitate) order in place?</label>
        <select id="dnr_in_place" name="advance_directives.dnr_in_place">
            <option value="" {% if advance_directives.dnrInPlace == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if advance_directives.dnrInPlace == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if advance_directives.dnrInPlace == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="living_will_in_place">Is a living will / advance decision in place?</label>
        <select id="living_will_in_place" name="advance_directives.living_will_in_place">
            <option value="" {% if advance_directives.livingWillInPlace == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if advance_directives.livingWillInPlace == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if advance_directives.livingWillInPlace == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="consent_to_share_eu">Has the patient consented to share this IPS for cross-border / EU-wide care?</label>
        <select id="consent_to_share_eu" name="advance_directives.consent_to_share_eu">
            <option value="" {% if advance_directives.consentToShareEu == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if advance_directives.consentToShareEu == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if advance_directives.consentToShareEu == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="directive_notes">Directive notes</label>
        <textarea id="directive_notes" name="advance_directives.directive_notes" rows="3"
                  placeholder="Free-text notes about advance directives or consent...">{{ advance_directives.directiveNotes }}</textarea>
    </div>
</div>
