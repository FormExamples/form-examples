{% extends "base.html.tera" %}

{% block title %}International Patient Summary - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>International Patient Summary</h1>
        <p class="landing-description">
            Digital implementation of the International Patient Summary (IPS) per
            <strong>ISO 27269</strong> and the <strong>HL7 FHIR R5</strong> IPS Implementation
            Guide. A standardised, minimal, specialty-agnostic clinical extract for
            cross-border and unplanned care &mdash; capturing eight mandatory clinical
            sections (problems, medications, allergies, immunisations, procedures, results,
            patient demographics, authoring clinician) plus optional medical-device and
            advance-directive records.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Eight mandatory and two optional sections, completed in a single continuous wizard</p>
            </div>
            <div class="feature">
                <h3>Completeness Validation</h3>
                <p>Complete / Partial / Incomplete grading with per-section audit trail</p>
            </div>
            <div class="feature">
                <h3>Cross-Border Flags</h3>
                <p>Real-time alerts for severe allergies, missing identifiers, draft signoff, and consent</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New IPS
            </button>
        </form>
    </div>
</div>
{% endblock %}
