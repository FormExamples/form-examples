{% extends "base.html.tera" %}

{% block title %}International Patient Summary - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>IPS Dashboard</h1>
    <a href="/" class="btn btn-primary">New IPS</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient, clinician, or organisation...">
    </div>
    <div class="form-group">
        <label for="completeness_level">Completeness</label>
        <select id="completeness_level" name="completeness_level">
            <option value="">All</option>
            <option value="complete" {% if completeness_level == "complete" %}selected{% endif %}>Complete</option>
            <option value="partial" {% if completeness_level == "partial" %}selected{% endif %}>Partial</option>
            <option value="incomplete" {% if completeness_level == "incomplete" %}selected{% endif %}>Incomplete</option>
        </select>
    </div>
    <div class="form-group">
        <label for="authoring_status">Authoring Status</label>
        <select id="authoring_status" name="authoring_status">
            <option value="">All</option>
            <option value="draft" {% if authoring_status == "draft" %}selected{% endif %}>Draft</option>
            <option value="final" {% if authoring_status == "final" %}selected{% endif %}>Final</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_urgent_flags">Urgent Flags</label>
        <select id="has_urgent_flags" name="has_urgent_flags">
            <option value="">All</option>
            <option value="yes" {% if has_urgent_flags == "yes" %}selected{% endif %}>With urgent flags</option>
            <option value="no" {% if has_urgent_flags == "no" %}selected{% endif %}>Without urgent flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed IPS record{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Patient</th>
            <th>DOB</th>
            <th>Country</th>
            <th>Clinician</th>
            <th>Organisation</th>
            <th>Authoring</th>
            <th>Completeness</th>
            <th>Flags</th>
            <th>Signoff</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.patientName }}</a></td>
            <td>{{ c.patientDateOfBirth }}</td>
            <td>{{ c.patientCountry }}</td>
            <td>{{ c.authoringClinician }}</td>
            <td>{{ c.authoringOrganisation }}</td>
            <td>{{ c.authoringStatus }}</td>
            <td>
                <span class="completeness-badge completeness-{{ c.completenessLevel }}">
                    {{ c.completenessLevel }} ({{ c.mandatoryPopulated }}/{{ c.mandatoryTotal }})
                </span>
            </td>
            <td>
                {% if c.urgentFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.urgentFlagCount }} urgent</span>
                {% elif c.highFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highFlagCount }} high</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>{{ c.signoffDate }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed IPS records found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
