{% extends "base.html.tera" %}

{% block title %}Discharge Summary Report - {{ completeness_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Hospital Discharge Summary &mdash; Completeness Report</h1>
    <div class="completeness-badge {{ completeness_class }}">{{ completeness_label }}</div>
    <div class="completeness-label">
        Mandatory: {{ mandatory_satisfied }} / {{ mandatory_total }} &middot;
        Optional: {{ optional_satisfied }} / {{ optional_total }}
    </div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient summary -->
<div class="card">
    <h2>Patient Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.patientDetails.firstName }} {{ data.patientDetails.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.patientDetails.dateOfBirth }}<br>
            <strong>NHS Number:</strong> {{ data.patientDetails.nhsNumber }}<br>
            <strong>Hospital Number:</strong> {{ data.patientDetails.hospitalNumber }}<br>
            <strong>GP:</strong> {{ data.patientDetails.gpName }} ({{ data.patientDetails.gpPractice }})
        </div>
        <div>
            <strong>Ward:</strong> {{ data.admissionSummary.ward }}<br>
            <strong>Consultant:</strong> {{ data.admissionSummary.consultant }}<br>
            <strong>Specialty:</strong> {{ data.admissionSummary.specialty }}<br>
            <strong>Admitted:</strong> {{ data.admissionSummary.admissionDate }}<br>
            <strong>Discharged:</strong> {{ data.admissionSummary.dischargeDate }}
        </div>
    </div>
</div>

<!-- Diagnoses -->
{% if data.diagnoses.diagnoses | length > 0 %}
<div class="card">
    <h2>Diagnoses ({{ data.diagnoses.diagnoses | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr><th>Type</th><th>Description</th><th>ICD-10</th></tr>
        </thead>
        <tbody>
            {% for dx in data.diagnoses.diagnoses %}
            <tr>
                <td>{{ dx.type }}</td>
                <td>{{ dx.description }}</td>
                <td><code>{{ dx.icd10 }}</code></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Discharge medications -->
{% if data.dischargeMedications.medications | length > 0 %}
<div class="card">
    <h2>Discharge Medications ({{ data.dischargeMedications.medications | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr><th>Name</th><th>Dose</th><th>Route</th><th>Frequency</th><th>Status</th><th>Indication</th></tr>
        </thead>
        <tbody>
            {% for m in data.dischargeMedications.medications %}
            <tr>
                <td>{{ m.name }}</td>
                <td>{{ m.dose }}</td>
                <td>{{ m.route }}</td>
                <td>{{ m.frequency }}</td>
                <td>{{ m.status }}</td>
                <td>{{ m.indication }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Follow-up appointments -->
{% if data.followupArrangements.appointments | length > 0 %}
<div class="card">
    <h2>Follow-up Appointments ({{ data.followupArrangements.appointments | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr><th>Provider</th><th>Date</th><th>Location</th><th>Purpose</th></tr>
        </thead>
        <tbody>
            {% for a in data.followupArrangements.appointments %}
            <tr>
                <td>{{ a.provider }}</td>
                <td>{{ a.date }}</td>
                <td>{{ a.location }}</td>
                <td>{{ a.purpose }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Safety flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Rule audit trail -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>NICE NG27 Rule Audit ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Description</th>
                <th>Mandatory</th>
                <th>Satisfied</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td>{{ rule.description }}</td>
                <td>{% if rule.mandatory %}Yes{% else %}No{% endif %}</td>
                <td>
                    {% if rule.satisfied %}
                        <span class="badge badge-yes">Yes</span>
                    {% else %}
                        <span class="badge badge-no">No</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Discharge Summary</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
