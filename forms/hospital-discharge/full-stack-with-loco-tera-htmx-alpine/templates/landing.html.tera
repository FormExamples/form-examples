{% extends "base.html.tera" %}

{% block title %}Hospital Discharge - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Hospital Discharge</h1>
        <p class="landing-description">
            Hospital discharge summary form aligned with UK NICE NG27 and the
            SAFER patient-flow bundle. Captures diagnoses, procedures, medication
            reconciliation, follow-up arrangements, and community handover details
            to support safe transfer of care. Completeness is graded as
            <strong>Complete</strong> (all NG27 mandatory fields supplied),
            <strong>Partial</strong> (non-mandatory fields outstanding), or
            <strong>Incomplete</strong> (mandatory fields missing).
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Patient details, admission, diagnoses, procedures, medications, follow-up, community care, warning signs, sign-off, and acknowledgement</p>
            </div>
            <div class="feature">
                <h3>NICE NG27 Validation</h3>
                <p>Mandatory and optional discharge-summary fields evaluated against UK NICE NG27 with audit trail</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for missing reconciliation, allergies, pending investigations, vulnerable destinations, and prolonged stay</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Discharge Summary
            </button>
        </form>
    </div>
</div>
{% endblock %}
