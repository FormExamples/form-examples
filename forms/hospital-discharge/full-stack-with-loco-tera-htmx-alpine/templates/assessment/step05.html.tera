<div class="card">
    <h2>Step 5: Discharge Medications</h2>
    <p class="form-hint">Reconciled medication list at discharge. Each line must record name, dose, and frequency.</p>

    {% for i in range(end=8) %}
    <fieldset class="medication-row">
        <legend>Medication {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="medications_{{ i }}_name">Name</label>
                <input type="text" id="medications_{{ i }}_name" name="medications[{{ i }}].name"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].name }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_dose">Dose</label>
                <input type="text" id="medications_{{ i }}_dose" name="medications[{{ i }}].dose"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].dose }}{% endif %}"
                       placeholder="e.g. 500 mg">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_route">Route</label>
                <input type="text" id="medications_{{ i }}_route" name="medications[{{ i }}].route"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].route }}{% endif %}"
                       placeholder="oral / IV / IM">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_frequency">Frequency</label>
                <input type="text" id="medications_{{ i }}_frequency" name="medications[{{ i }}].frequency"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].frequency }}{% endif %}"
                       placeholder="e.g. tds">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="medications_{{ i }}_duration">Duration</label>
                <input type="text" id="medications_{{ i }}_duration" name="medications[{{ i }}].duration"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].duration }}{% endif %}"
                       placeholder="e.g. 7 days">
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_status">Status</label>
                {% set ms = "" %}{% if discharge_medications.medications | length > i %}{% set_global ms = discharge_medications.medications[i].status %}{% endif %}
                <select id="medications_{{ i }}_status" name="medications[{{ i }}].status">
                    <option value="" {% if ms == "" %}selected{% endif %}>&mdash;</option>
                    <option value="new" {% if ms == "new" %}selected{% endif %}>New</option>
                    <option value="changed" {% if ms == "changed" %}selected{% endif %}>Changed</option>
                    <option value="unchanged" {% if ms == "unchanged" %}selected{% endif %}>Unchanged</option>
                    <option value="stopped" {% if ms == "stopped" %}selected{% endif %}>Stopped</option>
                </select>
            </div>
            <div class="form-group">
                <label for="medications_{{ i }}_indication">Indication</label>
                <input type="text" id="medications_{{ i }}_indication" name="medications[{{ i }}].indication"
                       value="{% if discharge_medications.medications | length > i %}{{ discharge_medications.medications[i].indication }}{% endif %}">
            </div>
        </div>
    </fieldset>
    {% endfor %}

    <h3>Reconciliation</h3>
    <div class="form-group">
        <label for="discharge_medications_reconciliation_completed">Medication reconciliation completed?</label>
        <select id="discharge_medications_reconciliation_completed" name="discharge_medications.reconciliation_completed">
            <option value="" {% if discharge_medications.reconciliationCompleted == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if discharge_medications.reconciliationCompleted == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if discharge_medications.reconciliationCompleted == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="discharge_medications_reconciliation_notes">Reconciliation Notes</label>
        <textarea id="discharge_medications_reconciliation_notes" name="discharge_medications.reconciliation_notes">{{ discharge_medications.reconciliationNotes }}</textarea>
    </div>

    <div class="form-group">
        <label for="discharge_medications_allergies_reviewed">Allergies reviewed?</label>
        <select id="discharge_medications_allergies_reviewed" name="discharge_medications.allergies_reviewed">
            <option value="" {% if discharge_medications.allergiesReviewed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if discharge_medications.allergiesReviewed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if discharge_medications.allergiesReviewed == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="discharge_medications_allergy_notes">Allergy Notes</label>
        <textarea id="discharge_medications_allergy_notes" name="discharge_medications.allergy_notes">{{ discharge_medications.allergyNotes }}</textarea>
    </div>
</div>
