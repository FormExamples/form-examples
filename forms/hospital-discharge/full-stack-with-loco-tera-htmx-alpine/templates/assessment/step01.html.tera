<div class="card">
    <h2>Step 1: Patient Details</h2>
    <p class="form-hint">Patient identification and contact information.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_first_name">First Name</label>
            <input type="text" id="patient_details_first_name" name="patient_details.first_name"
                   value="{{ patient_details.firstName }}">
        </div>
        <div class="form-group">
            <label for="patient_details_last_name">Last Name</label>
            <input type="text" id="patient_details_last_name" name="patient_details.last_name"
                   value="{{ patient_details.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_date_of_birth">Date of Birth</label>
            <input type="date" id="patient_details_date_of_birth" name="patient_details.date_of_birth"
                   value="{{ patient_details.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="patient_details_sex">Sex</label>
            <select id="patient_details_sex" name="patient_details.sex">
                <option value="" {% if patient_details.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="female" {% if patient_details.sex == "female" %}selected{% endif %}>Female</option>
                <option value="male" {% if patient_details.sex == "male" %}selected{% endif %}>Male</option>
                <option value="other" {% if patient_details.sex == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_nhs_number">NHS Number</label>
            <input type="text" id="patient_details_nhs_number" name="patient_details.nhs_number"
                   value="{{ patient_details.nhsNumber }}" placeholder="e.g. 943 476 5919">
        </div>
        <div class="form-group">
            <label for="patient_details_hospital_number">Hospital Number</label>
            <input type="text" id="patient_details_hospital_number" name="patient_details.hospital_number"
                   value="{{ patient_details.hospitalNumber }}">
        </div>
    </div>

    <div class="form-group">
        <label for="patient_details_address">Address</label>
        <input type="text" id="patient_details_address" name="patient_details.address"
               value="{{ patient_details.address }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_postcode">Postcode</label>
            <input type="text" id="patient_details_postcode" name="patient_details.postcode"
                   value="{{ patient_details.postcode }}">
        </div>
        <div class="form-group">
            <label for="patient_details_phone">Phone</label>
            <input type="text" id="patient_details_phone" name="patient_details.phone"
                   value="{{ patient_details.phone }}">
        </div>
    </div>

    <h3>General Practitioner</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_gp_name">GP Name</label>
            <input type="text" id="patient_details_gp_name" name="patient_details.gp_name"
                   value="{{ patient_details.gpName }}">
        </div>
        <div class="form-group">
            <label for="patient_details_gp_practice">GP Practice</label>
            <input type="text" id="patient_details_gp_practice" name="patient_details.gp_practice"
                   value="{{ patient_details.gpPractice }}">
        </div>
    </div>

    <h3>Next of Kin</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="patient_details_next_of_kin_name">Name</label>
            <input type="text" id="patient_details_next_of_kin_name" name="patient_details.next_of_kin_name"
                   value="{{ patient_details.nextOfKinName }}">
        </div>
        <div class="form-group">
            <label for="patient_details_next_of_kin_phone">Phone</label>
            <input type="text" id="patient_details_next_of_kin_phone" name="patient_details.next_of_kin_phone"
                   value="{{ patient_details.nextOfKinPhone }}">
        </div>
    </div>
</div>
