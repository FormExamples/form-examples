<div class="card">
    <h2>Step 3: Diagnoses</h2>
    <p class="form-hint">List one primary diagnosis and any secondary diagnoses. ICD-10 coding is optional but recommended.</p>

    {% for i in range(end=5) %}
    <fieldset class="diagnosis-row">
        <legend>Diagnosis {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="diagnoses_{{ i }}_type">Type</label>
                {% set t = "" %}{% if diagnoses.diagnoses | length > i %}{% set_global t = diagnoses.diagnoses[i].type %}{% endif %}
                <select id="diagnoses_{{ i }}_type" name="diagnoses[{{ i }}].type">
                    <option value="" {% if t == "" %}selected{% endif %}>&mdash;</option>
                    <option value="primary" {% if t == "primary" %}selected{% endif %}>Primary</option>
                    <option value="secondary" {% if t == "secondary" %}selected{% endif %}>Secondary</option>
                </select>
            </div>
            <div class="form-group">
                <label for="diagnoses_{{ i }}_description">Description</label>
                <input type="text" id="diagnoses_{{ i }}_description" name="diagnoses[{{ i }}].description"
                       value="{% if diagnoses.diagnoses | length > i %}{{ diagnoses.diagnoses[i].description }}{% endif %}"
                       placeholder="e.g. Community-acquired pneumonia">
            </div>
            <div class="form-group">
                <label for="diagnoses_{{ i }}_icd10">ICD-10</label>
                <input type="text" id="diagnoses_{{ i }}_icd10" name="diagnoses[{{ i }}].icd10"
                       value="{% if diagnoses.diagnoses | length > i %}{{ diagnoses.diagnoses[i].icd10 }}{% endif %}"
                       placeholder="e.g. J18.9">
            </div>
        </div>
    </fieldset>
    {% endfor %}
</div>
