<div class="card">
    <h2>Step 10: Patient / Carer Acknowledgement</h2>
    <p class="form-hint">Confirmation that the patient (and any carer) understands the discharge plan.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_acknowledgement_patient_understands_plan">Patient understands plan?</label>
            <select id="patient_acknowledgement_patient_understands_plan" name="patient_acknowledgement.patient_understands_plan">
                <option value="" {% if patient_acknowledgement.patientUnderstandsPlan == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_acknowledgement.patientUnderstandsPlan == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_acknowledgement.patientUnderstandsPlan == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_acknowledgement_carer_informed">Carer informed?</label>
            <select id="patient_acknowledgement_carer_informed" name="patient_acknowledgement.carer_informed">
                <option value="" {% if patient_acknowledgement.carerInformed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_acknowledgement.carerInformed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_acknowledgement.carerInformed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_acknowledgement_carer_name">Carer Name</label>
            <input type="text" id="patient_acknowledgement_carer_name" name="patient_acknowledgement.carer_name"
                   value="{{ patient_acknowledgement.carerName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_acknowledgement_medications_explained">Medications explained?</label>
            <select id="patient_acknowledgement_medications_explained" name="patient_acknowledgement.medications_explained">
                <option value="" {% if patient_acknowledgement.medicationsExplained == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_acknowledgement.medicationsExplained == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_acknowledgement.medicationsExplained == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_acknowledgement_written_summary_provided">Written summary provided?</label>
            <select id="patient_acknowledgement_written_summary_provided" name="patient_acknowledgement.written_summary_provided">
                <option value="" {% if patient_acknowledgement.writtenSummaryProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_acknowledgement.writtenSummaryProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_acknowledgement.writtenSummaryProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_acknowledgement_questions_answered">Questions answered?</label>
            <select id="patient_acknowledgement_questions_answered" name="patient_acknowledgement.questions_answered">
                <option value="" {% if patient_acknowledgement.questionsAnswered == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if patient_acknowledgement.questionsAnswered == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if patient_acknowledgement.questionsAnswered == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_acknowledgement_acknowledgement_date">Acknowledgement Date</label>
            <input type="date" id="patient_acknowledgement_acknowledgement_date" name="patient_acknowledgement.acknowledgement_date"
                   value="{{ patient_acknowledgement.acknowledgementDate }}">
        </div>
        <div class="form-group">
            <label for="patient_acknowledgement_signed_by">Signed By</label>
            <input type="text" id="patient_acknowledgement_signed_by" name="patient_acknowledgement.signed_by"
                   value="{{ patient_acknowledgement.signedBy }}">
        </div>
    </div>
</div>
