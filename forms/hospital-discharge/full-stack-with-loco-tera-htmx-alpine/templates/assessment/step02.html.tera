<div class="card">
    <h2>Step 2: Admission Summary</h2>
    <p class="form-hint">Dates, ward, responsible consultant, and clinical narrative.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="admission_summary_admission_date">Admission Date</label>
            <input type="date" id="admission_summary_admission_date" name="admission_summary.admission_date"
                   value="{{ admission_summary.admissionDate }}">
        </div>
        <div class="form-group">
            <label for="admission_summary_discharge_date">Discharge Date</label>
            <input type="date" id="admission_summary_discharge_date" name="admission_summary.discharge_date"
                   value="{{ admission_summary.dischargeDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="admission_summary_ward">Ward</label>
            <input type="text" id="admission_summary_ward" name="admission_summary.ward"
                   value="{{ admission_summary.ward }}">
        </div>
        <div class="form-group">
            <label for="admission_summary_consultant">Responsible Consultant</label>
            <input type="text" id="admission_summary_consultant" name="admission_summary.consultant"
                   value="{{ admission_summary.consultant }}">
        </div>
        <div class="form-group">
            <label for="admission_summary_specialty">Specialty</label>
            <input type="text" id="admission_summary_specialty" name="admission_summary.specialty"
                   value="{{ admission_summary.specialty }}">
        </div>
    </div>

    <div class="form-group">
        <label for="admission_summary_reason_for_admission">Reason for Admission</label>
        <textarea id="admission_summary_reason_for_admission" name="admission_summary.reason_for_admission"
                  placeholder="Why was the patient admitted?">{{ admission_summary.reasonForAdmission }}</textarea>
    </div>

    <div class="form-group">
        <label for="admission_summary_presenting_complaint">Presenting Complaint</label>
        <textarea id="admission_summary_presenting_complaint" name="admission_summary.presenting_complaint"
                  placeholder="Symptoms reported at admission">{{ admission_summary.presentingComplaint }}</textarea>
    </div>

    <div class="form-group">
        <label for="admission_summary_clinical_narrative">Clinical Narrative</label>
        <textarea id="admission_summary_clinical_narrative" name="admission_summary.clinical_narrative"
                  placeholder="Brief summary of the inpatient stay">{{ admission_summary.clinicalNarrative }}</textarea>
    </div>
</div>
