<div class="card">
    <h2>Step 8: Warning Signs &amp; When to Seek Help</h2>
    <p class="form-hint">Safety-netting advice and emergency contact information.</p>

    <div class="form-group">
        <label for="warning_signs_when_to_seek_help">When to Seek Help</label>
        <textarea id="warning_signs_when_to_seek_help" name="warning_signs.when_to_seek_help"
                  placeholder="What red-flag symptoms should prompt the patient to seek help, and how?">{{ warning_signs.whenToSeekHelp }}</textarea>
    </div>

    <div class="form-group">
        <label for="warning_signs_emergency_contact_number">Emergency Contact Number</label>
        <input type="text" id="warning_signs_emergency_contact_number" name="warning_signs.emergency_contact_number"
               value="{{ warning_signs.emergencyContactNumber }}"
               placeholder="e.g. 111 / ward number">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="warning_signs_safety_neting_provided">Safety-netting provided?</label>
            <select id="warning_signs_safety_neting_provided" name="warning_signs.safety_neting_provided">
                <option value="" {% if warning_signs.safetyNetingProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if warning_signs.safetyNetingProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if warning_signs.safetyNetingProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="warning_signs_written_info_given">Written info given?</label>
            <select id="warning_signs_written_info_given" name="warning_signs.written_info_given">
                <option value="" {% if warning_signs.writtenInfoGiven == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if warning_signs.writtenInfoGiven == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if warning_signs.writtenInfoGiven == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>
</div>
