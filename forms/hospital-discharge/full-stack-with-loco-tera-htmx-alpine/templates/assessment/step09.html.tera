<div class="card">
    <h2>Step 9: Clinician Sign-off</h2>
    <p class="form-hint">Discharging clinician identification and consultant confirmation.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="clinician_signoff_clinician_name">Clinician Name</label>
            <input type="text" id="clinician_signoff_clinician_name" name="clinician_signoff.clinician_name"
                   value="{{ clinician_signoff.clinicianName }}">
        </div>
        <div class="form-group">
            <label for="clinician_signoff_clinician_role">Role</label>
            <input type="text" id="clinician_signoff_clinician_role" name="clinician_signoff.clinician_role"
                   value="{{ clinician_signoff.clinicianRole }}"
                   placeholder="e.g. FY2, Registrar, Consultant">
        </div>
        <div class="form-group">
            <label for="clinician_signoff_gmc_number">GMC Number</label>
            <input type="text" id="clinician_signoff_gmc_number" name="clinician_signoff.gmc_number"
                   value="{{ clinician_signoff.gmcNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="clinician_signoff_signoff_date">Sign-off Date</label>
            <input type="date" id="clinician_signoff_signoff_date" name="clinician_signoff.signoff_date"
                   value="{{ clinician_signoff.signoffDate }}">
        </div>
        <div class="form-group">
            <label for="clinician_signoff_bleep_or_contact">Bleep / Contact</label>
            <input type="text" id="clinician_signoff_bleep_or_contact" name="clinician_signoff.bleep_or_contact"
                   value="{{ clinician_signoff.bleepOrContact }}">
        </div>
        <div class="form-group">
            <label for="clinician_signoff_responsible_consultant_informed">Consultant informed?</label>
            <select id="clinician_signoff_responsible_consultant_informed" name="clinician_signoff.responsible_consultant_informed">
                <option value="" {% if clinician_signoff.responsibleConsultantInformed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if clinician_signoff.responsibleConsultantInformed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if clinician_signoff.responsibleConsultantInformed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="clinician_signoff_additional_notes">Additional Notes</label>
        <textarea id="clinician_signoff_additional_notes" name="clinician_signoff.additional_notes">{{ clinician_signoff.additionalNotes }}</textarea>
    </div>
</div>
