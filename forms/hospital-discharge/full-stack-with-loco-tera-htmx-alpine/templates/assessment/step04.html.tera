<div class="card">
    <h2>Step 4: Procedures Performed</h2>
    <p class="form-hint">List any procedures performed during the admission. Mark "Yes" below if no procedures were performed.</p>

    <div class="form-group">
        <label for="procedures_performed_no_procedures_performed">No procedures performed during this admission?</label>
        <select id="procedures_performed_no_procedures_performed" name="procedures_performed.no_procedures_performed">
            <option value="" {% if procedures_performed.noProceduresPerformed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if procedures_performed.noProceduresPerformed == "yes" %}selected{% endif %}>Yes &mdash; none performed</option>
            <option value="no" {% if procedures_performed.noProceduresPerformed == "no" %}selected{% endif %}>No &mdash; see list below</option>
        </select>
    </div>

    {% for i in range(end=5) %}
    <fieldset class="procedure-row">
        <legend>Procedure {{ i + 1 }}</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="procedures_{{ i }}_description">Description</label>
                <input type="text" id="procedures_{{ i }}_description" name="procedures[{{ i }}].description"
                       value="{% if procedures_performed.procedures | length > i %}{{ procedures_performed.procedures[i].description }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="procedures_{{ i }}_opcs4">OPCS-4</label>
                <input type="text" id="procedures_{{ i }}_opcs4" name="procedures[{{ i }}].opcs4"
                       value="{% if procedures_performed.procedures | length > i %}{{ procedures_performed.procedures[i].opcs4 }}{% endif %}">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="procedures_{{ i }}_date">Date</label>
                <input type="date" id="procedures_{{ i }}_date" name="procedures[{{ i }}].date"
                       value="{% if procedures_performed.procedures | length > i %}{{ procedures_performed.procedures[i].date }}{% endif %}">
            </div>
            <div class="form-group">
                <label for="procedures_{{ i }}_performed_by">Performed By</label>
                <input type="text" id="procedures_{{ i }}_performed_by" name="procedures[{{ i }}].performed_by"
                       value="{% if procedures_performed.procedures | length > i %}{{ procedures_performed.procedures[i].performedBy }}{% endif %}"
                       placeholder="Clinician">
            </div>
        </div>
    </fieldset>
    {% endfor %}
</div>
