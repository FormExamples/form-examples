{% extends "base.html.tera" %}

{% block title %}Employee Offboarding Checklist - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Employee Offboarding Checklist</h1>
        <p class="landing-description">
            Structured offboarding checklist that ensures every departing employee
            completes the administrative, operational, and knowledge-transfer steps
            required to protect patient safety, organisational data, and service
            continuity. The wizard covers exit interview, knowledge transfer,
            equipment return, access revocation, final payroll, references,
            NDA reaffirmation, forwarding details, and HR / line-manager / IT
            sign-off.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>One continuous single-page wizard covering every offboarding control point</p>
            </div>
            <div class="feature">
                <h3>Outcome Engine</h3>
                <p>Complete / Partial / Incomplete with mandatory + blocker rule classification</p>
            </div>
            <div class="feature">
                <h3>Security Flags</h3>
                <p>Real-time alerts for outstanding access, equipment, NDA reaffirmation, and data-download audit</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Checklist
            </button>
        </form>
    </div>
</div>
{% endblock %}
