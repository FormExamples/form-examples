{% extends "base.html.tera" %}

{% block title %}Employee Offboarding Checklist - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>HR Offboarding Dashboard</h1>
    <a href="/" class="btn btn-primary">New Checklist</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Name, employee ID, department, job title...">
    </div>
    <div class="form-group">
        <label for="outcome">Outcome</label>
        <select id="outcome" name="outcome">
            <option value="">All</option>
            <option value="complete" {% if outcome == "complete" %}selected{% endif %}>Complete</option>
            <option value="partial" {% if outcome == "partial" %}selected{% endif %}>Partial</option>
            <option value="incomplete" {% if outcome == "incomplete" %}selected{% endif %}>Incomplete</option>
        </select>
    </div>
    <div class="form-group">
        <label for="reason_for_leaving">Reason for Leaving</label>
        <select id="reason_for_leaving" name="reason_for_leaving">
            <option value="">All</option>
            <option value="resignation" {% if reason_for_leaving == "resignation" %}selected{% endif %}>Resignation</option>
            <option value="retirement" {% if reason_for_leaving == "retirement" %}selected{% endif %}>Retirement</option>
            <option value="redundancy" {% if reason_for_leaving == "redundancy" %}selected{% endif %}>Redundancy</option>
            <option value="dismissal" {% if reason_for_leaving == "dismissal" %}selected{% endif %}>Dismissal</option>
            <option value="end-of-fixed-term" {% if reason_for_leaving == "end-of-fixed-term" %}selected{% endif %}>End of fixed term</option>
            <option value="transfer" {% if reason_for_leaving == "transfer" %}selected{% endif %}>Transfer</option>
            <option value="other" {% if reason_for_leaving == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">High-Priority Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed offboarding checklist{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Last Working Day</th>
            <th>Employee</th>
            <th>Department</th>
            <th>Job Title</th>
            <th>Reason</th>
            <th>Outcome</th>
            <th>Completion</th>
            <th>Blockers</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.lastWorkingDay }}</a></td>
            <td>{{ c.firstName }} {{ c.lastName }}<br><small>{{ c.employeeId }}</small></td>
            <td>{{ c.department }}</td>
            <td>{{ c.jobTitle }}</td>
            <td>{{ c.reasonForLeaving }}</td>
            <td><span class="outcome-{{ c.outcome }}" style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{{ c.outcome }}</span></td>
            <td>{{ c.completionPercent }}%</td>
            <td>
                {% if c.blockerCount > 0 %}
                    <span class="badge badge-no">{{ c.blockerCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
            <td>
                {% if c.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ c.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed offboarding checklists found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
