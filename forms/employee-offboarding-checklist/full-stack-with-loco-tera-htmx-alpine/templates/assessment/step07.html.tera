<div class="card">
    <h2>Step 7: References &amp; Recommendations</h2>
    <p class="form-hint">Reference consent, contact details, and any letter of recommendation.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="reference_consent_given">Reference consent given?</label>
            <select id="reference_consent_given" name="references_recommendations.reference_consent_given">
                <option value="" {% if references_recommendations.referenceConsentGiven == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if references_recommendations.referenceConsentGiven == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if references_recommendations.referenceConsentGiven == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reference_contact_details_recorded">Reference contact details recorded?</label>
            <select id="reference_contact_details_recorded" name="references_recommendations.reference_contact_details_recorded">
                <option value="" {% if references_recommendations.referenceContactDetailsRecorded == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if references_recommendations.referenceContactDetailsRecorded == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if references_recommendations.referenceContactDetailsRecorded == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reference_policy_explained">Reference policy explained?</label>
            <select id="reference_policy_explained" name="references_recommendations.reference_policy_explained">
                <option value="" {% if references_recommendations.referencePolicyExplained == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if references_recommendations.referencePolicyExplained == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if references_recommendations.referencePolicyExplained == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="recommendation_letter_requested">Recommendation letter requested?</label>
            <select id="recommendation_letter_requested" name="references_recommendations.recommendation_letter_requested">
                <option value="" {% if references_recommendations.recommendationLetterRequested == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if references_recommendations.recommendationLetterRequested == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if references_recommendations.recommendationLetterRequested == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="recommendation_letter_provided">Recommendation letter provided?</label>
            <select id="recommendation_letter_provided" name="references_recommendations.recommendation_letter_provided">
                <option value="" {% if references_recommendations.recommendationLetterProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if references_recommendations.recommendationLetterProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if references_recommendations.recommendationLetterProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="references_notes">Notes</label>
        <textarea id="references_notes" name="references_recommendations.references_notes">{{ references_recommendations.referencesNotes }}</textarea>
    </div>
</div>
