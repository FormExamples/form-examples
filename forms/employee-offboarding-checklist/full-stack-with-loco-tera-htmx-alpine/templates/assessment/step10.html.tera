<div class="card">
    <h2>Step 10: Sign-off</h2>
    <p class="form-hint">HR, line manager, and IT sign-off plus employee acknowledgement.</p>

    <h3>HR</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="hr_signed_off">HR signed off?</label>
            <select id="hr_signed_off" name="signoff.hr_signed_off">
                <option value="" {% if signoff.hrSignedOff == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if signoff.hrSignedOff == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if signoff.hrSignedOff == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="hr_sign_off_name">HR Sign-off Name</label>
            <input type="text" id="hr_sign_off_name" name="signoff.hr_sign_off_name"
                   value="{{ signoff.hrSignOffName }}">
        </div>
        <div class="form-group">
            <label for="hr_sign_off_date">HR Sign-off Date</label>
            <input type="date" id="hr_sign_off_date" name="signoff.hr_sign_off_date"
                   value="{{ signoff.hrSignOffDate }}">
        </div>
    </div>

    <h3>Line Manager</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="line_manager_signed_off">Line manager signed off?</label>
            <select id="line_manager_signed_off" name="signoff.line_manager_signed_off">
                <option value="" {% if signoff.lineManagerSignedOff == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if signoff.lineManagerSignedOff == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if signoff.lineManagerSignedOff == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="line_manager_sign_off_name">Line Manager Sign-off Name</label>
            <input type="text" id="line_manager_sign_off_name" name="signoff.line_manager_sign_off_name"
                   value="{{ signoff.lineManagerSignOffName }}">
        </div>
        <div class="form-group">
            <label for="line_manager_sign_off_date">Line Manager Sign-off Date</label>
            <input type="date" id="line_manager_sign_off_date" name="signoff.line_manager_sign_off_date"
                   value="{{ signoff.lineManagerSignOffDate }}">
        </div>
    </div>

    <h3>IT</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="it_signed_off">IT signed off?</label>
            <select id="it_signed_off" name="signoff.it_signed_off">
                <option value="" {% if signoff.itSignedOff == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if signoff.itSignedOff == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if signoff.itSignedOff == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="it_sign_off_name">IT Sign-off Name</label>
            <input type="text" id="it_sign_off_name" name="signoff.it_sign_off_name"
                   value="{{ signoff.itSignOffName }}">
        </div>
        <div class="form-group">
            <label for="it_sign_off_date">IT Sign-off Date</label>
            <input type="date" id="it_sign_off_date" name="signoff.it_sign_off_date"
                   value="{{ signoff.itSignOffDate }}">
        </div>
    </div>

    <h3>Employee</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="employee_acknowledged">Employee acknowledged?</label>
            <select id="employee_acknowledged" name="signoff.employee_acknowledged">
                <option value="" {% if signoff.employeeAcknowledged == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if signoff.employeeAcknowledged == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if signoff.employeeAcknowledged == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="employee_sign_off_date">Employee Sign-off Date</label>
            <input type="date" id="employee_sign_off_date" name="signoff.employee_sign_off_date"
                   value="{{ signoff.employeeSignOffDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="signoff_notes">Notes</label>
        <textarea id="signoff_notes" name="signoff.signoff_notes">{{ signoff.signoffNotes }}</textarea>
    </div>
</div>
