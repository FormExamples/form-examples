<div class="card">
    <h2>Step 4: Equipment Return</h2>
    <p class="form-hint">Confirm every organisational asset has been returned (or is not applicable).</p>

    <div class="form-row">
        <div class="form-group">
            <label for="laptop_returned">Laptop returned?</label>
            <select id="laptop_returned" name="equipment_return.laptop_returned">
                <option value="" {% if equipment_return.laptopReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.laptopReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.laptopReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.laptopReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
        <div class="form-group">
            <label for="laptop_asset_tag">Laptop Asset Tag</label>
            <input type="text" id="laptop_asset_tag" name="equipment_return.laptop_asset_tag"
                   value="{{ equipment_return.laptopAssetTag }}">
        </div>
        <div class="form-group">
            <label for="mobile_phone_returned">Mobile phone returned?</label>
            <select id="mobile_phone_returned" name="equipment_return.mobile_phone_returned">
                <option value="" {% if equipment_return.mobilePhoneReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.mobilePhoneReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.mobilePhoneReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.mobilePhoneReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="id_badge_returned">ID badge returned?</label>
            <select id="id_badge_returned" name="equipment_return.id_badge_returned">
                <option value="" {% if equipment_return.idBadgeReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.idBadgeReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.idBadgeReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.idBadgeReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
        <div class="form-group">
            <label for="keys_returned">Keys returned?</label>
            <select id="keys_returned" name="equipment_return.keys_returned">
                <option value="" {% if equipment_return.keysReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.keysReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.keysReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.keysReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
        <div class="form-group">
            <label for="uniform_returned">Uniform returned?</label>
            <select id="uniform_returned" name="equipment_return.uniform_returned">
                <option value="" {% if equipment_return.uniformReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.uniformReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.uniformReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.uniformReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="parking_pass_returned">Parking pass returned?</label>
            <select id="parking_pass_returned" name="equipment_return.parking_pass_returned">
                <option value="" {% if equipment_return.parkingPassReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.parkingPassReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.parkingPassReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.parkingPassReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
        <div class="form-group">
            <label for="other_equipment_returned">Other equipment returned?</label>
            <select id="other_equipment_returned" name="equipment_return.other_equipment_returned">
                <option value="" {% if equipment_return.otherEquipmentReturned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if equipment_return.otherEquipmentReturned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if equipment_return.otherEquipmentReturned == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if equipment_return.otherEquipmentReturned == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="other_equipment_description">Other equipment description</label>
        <input type="text" id="other_equipment_description" name="equipment_return.other_equipment_description"
               value="{{ equipment_return.otherEquipmentDescription }}">
    </div>

    <div class="form-group">
        <label for="equipment_return_notes">Notes</label>
        <textarea id="equipment_return_notes" name="equipment_return.equipment_return_notes">{{ equipment_return.equipmentReturnNotes }}</textarea>
    </div>
</div>
