<div class="card">
    <h2>Step 3: Knowledge Transfer</h2>
    <p class="form-hint">Identify the successor and confirm critical handover artefacts are in place.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="successor_identified">Successor / handover recipient identified?</label>
            <select id="successor_identified" name="knowledge_transfer.successor_identified">
                <option value="" {% if knowledge_transfer.successorIdentified == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.successorIdentified == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.successorIdentified == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="successor_name">Successor Name</label>
            <input type="text" id="successor_name" name="knowledge_transfer.successor_name"
                   value="{{ knowledge_transfer.successorName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="handover_document_created">Handover document created?</label>
            <select id="handover_document_created" name="knowledge_transfer.handover_document_created">
                <option value="" {% if knowledge_transfer.handoverDocumentCreated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.handoverDocumentCreated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.handoverDocumentCreated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="handover_meetings_held">Handover meetings held?</label>
            <select id="handover_meetings_held" name="knowledge_transfer.handover_meetings_held">
                <option value="" {% if knowledge_transfer.handoverMeetingsHeld == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.handoverMeetingsHeld == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.handoverMeetingsHeld == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="work_in_progress_documented">Work-in-progress documented?</label>
            <select id="work_in_progress_documented" name="knowledge_transfer.work_in_progress_documented">
                <option value="" {% if knowledge_transfer.workInProgressDocumented == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.workInProgressDocumented == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.workInProgressDocumented == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="key_contacts_shared">Key contacts shared?</label>
            <select id="key_contacts_shared" name="knowledge_transfer.key_contacts_shared">
                <option value="" {% if knowledge_transfer.keyContactsShared == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.keyContactsShared == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.keyContactsShared == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="sop_files_transferred">SOP / shared files transferred?</label>
            <select id="sop_files_transferred" name="knowledge_transfer.sop_files_transferred">
                <option value="" {% if knowledge_transfer.sopFilesTransferred == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.sopFilesTransferred == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.sopFilesTransferred == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="clinical_caseload_reassigned">Clinical caseload reassigned?</label>
            <select id="clinical_caseload_reassigned" name="knowledge_transfer.clinical_caseload_reassigned">
                <option value="" {% if knowledge_transfer.clinicalCaseloadReassigned == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if knowledge_transfer.clinicalCaseloadReassigned == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if knowledge_transfer.clinicalCaseloadReassigned == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="knowledge_transfer_notes">Notes</label>
        <textarea id="knowledge_transfer_notes" name="knowledge_transfer.knowledge_transfer_notes">{{ knowledge_transfer.knowledgeTransferNotes }}</textarea>
    </div>
</div>
