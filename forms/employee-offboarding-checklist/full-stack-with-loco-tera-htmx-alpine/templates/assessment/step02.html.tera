<div class="card">
    <h2>Step 2: Exit Interview</h2>
    <p class="form-hint">Confirm that an exit interview was offered, completed, and feedback documented.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="interview_offered">Exit interview offered?</label>
            <select id="interview_offered" name="exit_interview.interview_offered">
                <option value="" {% if exit_interview.interviewOffered == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if exit_interview.interviewOffered == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if exit_interview.interviewOffered == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="interview_completed">Exit interview completed?</label>
            <select id="interview_completed" name="exit_interview.interview_completed">
                <option value="" {% if exit_interview.interviewCompleted == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if exit_interview.interviewCompleted == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if exit_interview.interviewCompleted == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="interview_date">Interview Date</label>
            <input type="date" id="interview_date" name="exit_interview.interview_date"
                   value="{{ exit_interview.interviewDate }}">
        </div>
        <div class="form-group">
            <label for="interviewer_name">Interviewer Name</label>
            <input type="text" id="interviewer_name" name="exit_interview.interviewer_name"
                   value="{{ exit_interview.interviewerName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="feedback_provided">Feedback provided?</label>
            <select id="feedback_provided" name="exit_interview.feedback_provided">
                <option value="" {% if exit_interview.feedbackProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if exit_interview.feedbackProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if exit_interview.feedbackProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="feedback_documented">Feedback documented?</label>
            <select id="feedback_documented" name="exit_interview.feedback_documented">
                <option value="" {% if exit_interview.feedbackDocumented == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if exit_interview.feedbackDocumented == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if exit_interview.feedbackDocumented == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="concerns_raised">Concerns raised?</label>
            <select id="concerns_raised" name="exit_interview.concerns_raised">
                <option value="" {% if exit_interview.concernsRaised == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if exit_interview.concernsRaised == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if exit_interview.concernsRaised == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="concerns_details">Concerns details</label>
        <textarea id="concerns_details" name="exit_interview.concerns_details">{{ exit_interview.concernsDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="exit_interview_notes">Notes</label>
        <textarea id="exit_interview_notes" name="exit_interview.exit_interview_notes">{{ exit_interview.exitInterviewNotes }}</textarea>
    </div>
</div>
