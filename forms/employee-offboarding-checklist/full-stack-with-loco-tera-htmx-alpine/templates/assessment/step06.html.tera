<div class="card">
    <h2>Step 6: Final Payroll &amp; Benefits</h2>
    <p class="form-hint">Final salary, accrued holiday, P45, pension info, and benefit termination.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="final_salary_calculated">Final salary calculated?</label>
            <select id="final_salary_calculated" name="final_payroll_benefits.final_salary_calculated">
                <option value="" {% if final_payroll_benefits.finalSalaryCalculated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.finalSalaryCalculated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.finalSalaryCalculated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="accrued_holiday_paid">Accrued holiday paid?</label>
            <select id="accrued_holiday_paid" name="final_payroll_benefits.accrued_holiday_paid">
                <option value="" {% if final_payroll_benefits.accruedHolidayPaid == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.accruedHolidayPaid == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.accruedHolidayPaid == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="expenses_reimbursed">Outstanding expenses reimbursed?</label>
            <select id="expenses_reimbursed" name="final_payroll_benefits.expenses_reimbursed">
                <option value="" {% if final_payroll_benefits.expensesReimbursed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.expensesReimbursed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.expensesReimbursed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="pension_information_provided">Pension information provided?</label>
            <select id="pension_information_provided" name="final_payroll_benefits.pension_information_provided">
                <option value="" {% if final_payroll_benefits.pensionInformationProvided == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.pensionInformationProvided == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.pensionInformationProvided == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="p45_issued">P45 / final tax document issued?</label>
            <select id="p45_issued" name="final_payroll_benefits.p45_issued">
                <option value="" {% if final_payroll_benefits.p45Issued == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.p45Issued == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.p45Issued == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="benefits_terminated">Benefits terminated?</label>
            <select id="benefits_terminated" name="final_payroll_benefits.benefits_terminated">
                <option value="" {% if final_payroll_benefits.benefitsTerminated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.benefitsTerminated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.benefitsTerminated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="payroll_details_confirmed">Payroll details confirmed with employee?</label>
            <select id="payroll_details_confirmed" name="final_payroll_benefits.payroll_details_confirmed">
                <option value="" {% if final_payroll_benefits.payrollDetailsConfirmed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if final_payroll_benefits.payrollDetailsConfirmed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if final_payroll_benefits.payrollDetailsConfirmed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="final_payment_date">Final Payment Date</label>
            <input type="date" id="final_payment_date" name="final_payroll_benefits.final_payment_date"
                   value="{{ final_payroll_benefits.finalPaymentDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="final_payroll_notes">Notes</label>
        <textarea id="final_payroll_notes" name="final_payroll_benefits.final_payroll_notes">{{ final_payroll_benefits.finalPayrollNotes }}</textarea>
    </div>
</div>
