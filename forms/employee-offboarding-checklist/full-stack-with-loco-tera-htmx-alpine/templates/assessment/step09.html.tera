<div class="card">
    <h2>Step 9: Forwarding Details</h2>
    <p class="form-hint">Where to send P60, references, and other future correspondence.</p>

    <div class="form-group">
        <label for="forwarding_address_line1">Forwarding Address Line 1</label>
        <input type="text" id="forwarding_address_line1" name="forwarding_details.forwarding_address_line1"
               value="{{ forwarding_details.forwardingAddressLine1 }}">
    </div>

    <div class="form-group">
        <label for="forwarding_address_line2">Forwarding Address Line 2</label>
        <input type="text" id="forwarding_address_line2" name="forwarding_details.forwarding_address_line2"
               value="{{ forwarding_details.forwardingAddressLine2 }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="forwarding_city">City / Town</label>
            <input type="text" id="forwarding_city" name="forwarding_details.forwarding_city"
                   value="{{ forwarding_details.forwardingCity }}">
        </div>
        <div class="form-group">
            <label for="forwarding_postcode">Postcode</label>
            <input type="text" id="forwarding_postcode" name="forwarding_details.forwarding_postcode"
                   value="{{ forwarding_details.forwardingPostcode }}">
        </div>
        <div class="form-group">
            <label for="forwarding_country">Country</label>
            <input type="text" id="forwarding_country" name="forwarding_details.forwarding_country"
                   value="{{ forwarding_details.forwardingCountry }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="personal_email">Personal Email</label>
            <input type="email" id="personal_email" name="forwarding_details.personal_email"
                   value="{{ forwarding_details.personalEmail }}">
        </div>
        <div class="form-group">
            <label for="personal_phone">Personal Phone</label>
            <input type="tel" id="personal_phone" name="forwarding_details.personal_phone"
                   value="{{ forwarding_details.personalPhone }}">
        </div>
        <div class="form-group">
            <label for="forwarding_details_confirmed">Forwarding details confirmed?</label>
            <select id="forwarding_details_confirmed" name="forwarding_details.forwarding_details_confirmed">
                <option value="" {% if forwarding_details.forwardingDetailsConfirmed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if forwarding_details.forwardingDetailsConfirmed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if forwarding_details.forwardingDetailsConfirmed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="forwarding_notes">Notes</label>
        <textarea id="forwarding_notes" name="forwarding_details.forwarding_notes">{{ forwarding_details.forwardingNotes }}</textarea>
    </div>
</div>
