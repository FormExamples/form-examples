<div class="card">
    <h2>Step 5: Access Revocation</h2>
    <p class="form-hint">Revoke every digital and physical access channel. IT criticals are blockers.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="email_revoked">Email account revoked?</label>
            <select id="email_revoked" name="access_revocation.email_revoked">
                <option value="" {% if access_revocation.emailRevoked == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.emailRevoked == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.emailRevoked == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ehr_epr_revoked">EHR / EPR access revoked?</label>
            <select id="ehr_epr_revoked" name="access_revocation.ehr_epr_revoked">
                <option value="" {% if access_revocation.ehrEprRevoked == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.ehrEprRevoked == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.ehrEprRevoked == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="vpn_revoked">VPN access revoked?</label>
            <select id="vpn_revoked" name="access_revocation.vpn_revoked">
                <option value="" {% if access_revocation.vpnRevoked == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.vpnRevoked == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.vpnRevoked == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="active_directory_disabled">Active Directory disabled?</label>
            <select id="active_directory_disabled" name="access_revocation.active_directory_disabled">
                <option value="" {% if access_revocation.activeDirectoryDisabled == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.activeDirectoryDisabled == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.activeDirectoryDisabled == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="building_access_revoked">Building access revoked?</label>
            <select id="building_access_revoked" name="access_revocation.building_access_revoked">
                <option value="" {% if access_revocation.buildingAccessRevoked == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.buildingAccessRevoked == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.buildingAccessRevoked == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="cloud_apps_revoked">Cloud apps access revoked?</label>
            <select id="cloud_apps_revoked" name="access_revocation.cloud_apps_revoked">
                <option value="" {% if access_revocation.cloudAppsRevoked == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.cloudAppsRevoked == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.cloudAppsRevoked == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="smartcard_deactivated">Smartcard deactivated?</label>
            <select id="smartcard_deactivated" name="access_revocation.smartcard_deactivated">
                <option value="" {% if access_revocation.smartcardDeactivated == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.smartcardDeactivated == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.smartcardDeactivated == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="data_download_audit_performed">Data download audit performed?</label>
            <select id="data_download_audit_performed" name="access_revocation.data_download_audit_performed">
                <option value="" {% if access_revocation.dataDownloadAuditPerformed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.dataDownloadAuditPerformed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.dataDownloadAuditPerformed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="unauthorised_download_detected">Unauthorised download detected?</label>
            <select id="unauthorised_download_detected" name="access_revocation.unauthorised_download_detected">
                <option value="" {% if access_revocation.unauthorisedDownloadDetected == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if access_revocation.unauthorisedDownloadDetected == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if access_revocation.unauthorisedDownloadDetected == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="access_revocation_notes">Notes</label>
        <textarea id="access_revocation_notes" name="access_revocation.access_revocation_notes">{{ access_revocation.accessRevocationNotes }}</textarea>
    </div>
</div>
