#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding mental-health-assessment (9 tables)..."

cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    current_medications_deleted_at:ts \
    taking_psychotropic_medication:string! \
    medication_adherence:string! \
    side_effects:string! \
    side_effects_details:text! \
    over_the_counter_medications:text! \
    supplements:text! \
    medication_notes:text! \
    current_medication_item_deleted_at:ts \
    current_medications:references \
    medication_name:string! \
    dose:string! \
    frequency:string! \
    prescriber:string! \
    start_date:date \
    medication_class:string! \
    sort_order:int! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    phq9_total_score:int! \
    phq9_severity:string! \
    gad7_total_score:int! \
    gad7_severity:string! \
    risk_level:string! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    phq9_total_score:int! \
    phq9_severity:string! \
    gad7_total_score:int! \
    gad7_severity:string! \
    risk_level:string! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx

echo "Done."
