#!/bin/sh
set -euf

form_kebab_case=ultrasound-test-result
form_snake_case=ultrasound_test_result

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold ultrasound_test_result \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    originating_request_reference:string! \
    report_status:string! \
    performed_date:date \
    reported_date:date \
    body_region:string! \
    laterality:string! \
    examination_adequacy:string! \
    clinical_history:string! \
    comparison_with_previous:string! \
    findings_narrative:string! \
    mass_or_lesion:bool! \
    cyst:bool! \
    gallstones:bool! \
    hydronephrosis:bool! \
    free_fluid:bool! \
    dvt_present:bool! \
    aneurysm:bool! \
    organ_enlargement:bool! \
    incidental_finding:bool! \
    largest_lesion_size_mm:double \
    impression:string! \
    reporting_category:string! \
    recommended_follow_up:string! \
    critical_result_communicated:bool! \
    reported_to:string! \
    --api

cargo loco generate scaffold ultrasound_test_result_grade \
    deleted_at:tstz \
    ultrasound_test_result:references \
    result_classification:string! \
    abnormality_severity:string! \
    reporting_category:string! \
    report_completeness_percent:int \
    follow_up_urgency:string! \
    target_timeframe:string! \
    recommended_action:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:tstz \
    graded_at:tstz! \
    --api

cargo loco generate scaffold ultrasound_test_result_grade_rule \
    deleted_at:tstz \
    ultrasound_test_result_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold ultrasound_test_result_grade_flag \
    deleted_at:tstz \
    ultrasound_test_result_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
