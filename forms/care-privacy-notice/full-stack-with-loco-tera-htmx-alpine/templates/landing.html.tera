{% extends "base.html.tera" %}

{% block title %}Care Privacy Notice - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Care Privacy Notice</h1>
        <p class="landing-description">
            Read-and-acknowledge privacy notice based on the British Medical Association (BMA) GDPR template
            for GP practices. Patients review how the practice uses their information for direct care,
            confirm understanding, and provide their name and date as an acknowledgement.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Three Steps</h3>
                <p>Practice configuration, BMA privacy notice display, and patient acknowledgement &amp; signature</p>
            </div>
            <div class="feature">
                <h3>UK GDPR Compliant</h3>
                <p>Aligned with the UK General Data Protection Regulation and the Data Protection Act 2018</p>
            </div>
            <div class="feature">
                <h3>Audit Trail</h3>
                <p>Signed, timestamped acknowledgement record retained for practice records</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Acknowledgement
            </button>
        </form>
    </div>
</div>
{% endblock %}
