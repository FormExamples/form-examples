{% extends "base.html.tera" %}

{% block title %}Acknowledgement Report - {{ overall_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Care Privacy Notice &mdash; Acknowledgement Report</h1>
    <div class="status-badge status-{{ overall_status }}">{{ overall_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Acknowledgement ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Practice Configuration -->
<div class="card">
    <h2>Practice Configuration</h2>
    <div class="form-row">
        <div>
            <strong>Practice Name:</strong> {{ data.config.practiceName }}<br>
            <strong>Practice Address:</strong> {{ data.config.practiceAddress }}
        </div>
        <div>
            <strong>DPO Name:</strong> {{ data.config.dpoName }}<br>
            <strong>DPO Contact:</strong> {{ data.config.dpoContactDetails }}
        </div>
    </div>
</div>

<!-- Patient Acknowledgement -->
<div class="card">
    <h2>Patient Acknowledgement</h2>
    <div class="form-row">
        <div>
            <strong>Acknowledged:</strong>
            {% if data.acknowledgment.checked %}
                <span class="badge badge-yes">Yes</span>
            {% else %}
                <span class="badge badge-no">No</span>
            {% endif %}
        </div>
        <div>
            <strong>Patient Name:</strong> {{ data.acknowledgment.patientName }}
        </div>
        <div>
            <strong>Date:</strong> {{ data.acknowledgment.date }}
        </div>
    </div>
</div>

<!-- Configuration Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Configuration Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Missing acknowledgement items -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Missing Acknowledgement Items ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.message }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Acknowledgement</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
