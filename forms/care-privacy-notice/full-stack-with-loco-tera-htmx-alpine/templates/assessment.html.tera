{% extends "base.html.tera" %}

{% block title %}Care Privacy Notice - Acknowledgement{% endblock %}

{% block content %}
<div class="assessment-header">
    <h1>Care Privacy Notice</h1>
    <p class="form-hint">
        Complete all three sections (Practice Configuration, Privacy Notice, Acknowledgement &amp; Signature)
        and submit to record the patient acknowledgement.
    </p>
</div>

<form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">
    {% include "assessment/step01.html.tera" %}
    {% include "assessment/step02.html.tera" %}
    {% include "assessment/step03.html.tera" %}

    <div class="submit-row">
        <button type="submit" class="btn btn-success">Submit Acknowledgement</button>
    </div>
</form>
{% endblock %}
