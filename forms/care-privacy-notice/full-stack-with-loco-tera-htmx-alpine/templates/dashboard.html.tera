{% extends "base.html.tera" %}

{% block title %}Care Privacy Notice - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Acknowledgement Dashboard</h1>
    <a href="/" class="btn btn-primary">New Acknowledgement</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name or practice name...">
    </div>
    <div class="form-group">
        <label for="overall_status">Status</label>
        <select id="overall_status" name="overall_status">
            <option value="">All</option>
            <option value="complete" {% if overall_status == "complete" %}selected{% endif %}>Complete</option>
            <option value="incomplete" {% if overall_status == "incomplete" %}selected{% endif %}>Incomplete</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Configuration Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} acknowledgement{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Practice</th>
            <th>Patient</th>
            <th>Status</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for c in cases %}
        <tr>
            <td><a href="/assessment/{{ c.id }}/report">{{ c.date }}</a></td>
            <td>{{ c.practiceName }}</td>
            <td>{{ c.patientName }}</td>
            <td><span class="status-badge status-{{ c.overallStatus }}">{{ c.overallStatus }}</span></td>
            <td>
                {% set total_flags = c.highPriorityFlagCount + c.mediumPriorityFlagCount %}
                {% if total_flags > 0 %}
                    <span class="badge badge-no">{{ total_flags }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed acknowledgements found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
