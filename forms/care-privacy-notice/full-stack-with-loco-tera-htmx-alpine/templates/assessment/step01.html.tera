<div class="card">
    <h2>Step 1: Practice Configuration</h2>
    <p class="form-hint">Filled in by practice admin or clinical staff. These values are interpolated into the patient-facing notice in Step 2.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="practice_name">Practice Name</label>
            <input type="text" id="practice_name" name="config.practice_name"
                   value="{{ config.practiceName }}" placeholder="e.g. Riverside GP Practice">
        </div>
        <div class="form-group">
            <label for="practice_address">Practice Address</label>
            <input type="text" id="practice_address" name="config.practice_address"
                   value="{{ config.practiceAddress }}" placeholder="Street, Town, Postcode">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="dpo_name">Data Protection Officer Name</label>
            <input type="text" id="dpo_name" name="config.dpo_name"
                   value="{{ config.dpoName }}">
        </div>
        <div class="form-group">
            <label for="dpo_contact_details">DPO Contact Details</label>
            <input type="text" id="dpo_contact_details" name="config.dpo_contact_details"
                   value="{{ config.dpoContactDetails }}" placeholder="Email or phone">
        </div>
    </div>

    <div class="form-group">
        <label for="data_sharing_partners">Additional Data Sharing Partners (optional)</label>
        <input type="text" id="data_sharing_partners" name="config.data_sharing_partners"
               value="{{ config.dataSharingPartners }}"
               placeholder="Comma-separated list of partner organisations">
    </div>

    <div class="form-group">
        <label for="research_organisations">Research Organisations (optional)</label>
        <input type="text" id="research_organisations" name="config.research_organisations"
               value="{{ config.researchOrganisations }}"
               placeholder="Comma-separated list of named research organisations">
    </div>
</div>
