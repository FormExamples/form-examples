<div class="card">
    <h2>Step 3: Acknowledgement &amp; Signature</h2>
    <p class="form-hint">Tick the acknowledgement, type your name, and select today's date. All three fields are required for a complete acknowledgement.</p>

    <div class="form-group">
        <label class="checkbox-label">
            <input type="checkbox" id="acknowledgment_checked" name="acknowledgment.checked"
                   value="on" {% if acknowledgment.checked %}checked{% endif %}>
            I have read and understood the privacy notice above and acknowledge how the practice uses my information for direct care.
        </label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_name">Your Name</label>
            <input type="text" id="patient_name" name="acknowledgment.patient_name"
                   value="{{ acknowledgment.patientName }}" placeholder="Full name">
        </div>
        <div class="form-group">
            <label for="acknowledgment_date">Date</label>
            <input type="date" id="acknowledgment_date" name="acknowledgment.date"
                   value="{{ acknowledgment.date }}">
        </div>
    </div>
</div>
