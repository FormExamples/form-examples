#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding care-privacy-notice (10 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api && \
cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    --api && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    completeness_status:string! \
    sections_complete:int! \
    sections_total:int! \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --api && \
cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    --api && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    completeness_status:string! \
    sections_complete:int! \
    sections_total:int! \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    severity_level:string! \
    --api

echo "Done."
