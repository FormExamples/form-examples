    direction:text! \
    --api && \
cargo loco generate scaffold technology_decision \
    deleted_at:ts \
    arc42_documentation:references \
    ordinal:int! \
    category:text! \
    choice:text! \
    rationale:text! \
    --api && \
cargo loco generate scaffold building_block \
    deleted_at:ts \
    arc42_documentation:references \
