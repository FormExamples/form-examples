#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding arc42 (19 tables)..."

cargo loco generate scaffold architecture \
    deleted_at:ts \
    name:text! \
    version:text! \
    owner:text! \
    status:text! \
    description:text! \
    --api && \
cargo loco generate scaffold arc42_documentation \
    deleted_at:ts \
    architecture:references \
    author_name:text! \
    author_role:text! \
    document_date:date \
    introduction:text! \
    business_context_description:text! \
    technical_context_description:text! \
    solution_strategy_summary:text! \
    top_level_decomposition_summary:text! \
    building_block_overview:text! \
    runtime_overview:text! \
    deployment_overview:text! \
    crosscutting_overview:text! \
    quality_tree_summary:text! \
    recommendation:text! \
    additional_notes:text! \
    signed_by:text! \
    signed_at:ts \
    --api && \
cargo loco generate scaffold business_goal \
    deleted_at:ts \
    arc42_documentation:references \
    ordinal:int! \
    name:text! \
    description:text! \
    --api && \
cargo loco generate scaffold quality_goal \
    deleted_at:ts \
    arc42_documentation:references \
    ordinal:int! \
    name:text! \
    priority:text! \
    scenario:text! \
    --api && \
cargo loco generate scaffold stakeholder \
    deleted_at:ts \
