#!/bin/sh
set -euf

form_kebab_case=arc42
form_snake_case=arc42

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold architecture \
    deleted_at:tstz \
    name:text! \
    version:text! \
    owner:text! \
    status:text! \
    description:text! \
    --api

cargo loco generate scaffold arc42_documentation \
    deleted_at:tstz \
    architecture:references \
    author_name:text! \
    author_role:text! \
    document_date:date \
    introduction:text! \
    business_context_description:text! \
    technical_context_description:text! \
    solution_strategy_summary:text! \
    top_level_decomposition_summary:text! \
    building_block_overview:text! \
    runtime_overview:text! \
    deployment_overview:text! \
    crosscutting_overview:text! \
    quality_tree_summary:text! \
    recommendation:text! \
    additional_notes:text! \
    signed_by:text! \
    signed_at:tstz \
    --api

cargo loco generate scaffold business_goal \
    deleted_at:tstz \
    arc42_documentation:references \
    ordinal:int! \
    name:text! \
