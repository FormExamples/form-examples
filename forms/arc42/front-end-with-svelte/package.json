    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfmake": "^0.3.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "^0.1.0",
    "@lilydesignsystem/svelte-locale-picker": "^0.1.2",
    "@lilydesignsystem/svelte-picker-bar": "^0.1.0",
    "@lilydesignsystem/svelte-share-picker": "^0.1.2",
    "@lilydesignsystem/svelte-text-size-picker": "^0.1.2",
    "@lilydesignsystem/svelte-theme-picker": "^0.1.2",
    "@svar-ui/svelte-grid": "^2.7.3",
