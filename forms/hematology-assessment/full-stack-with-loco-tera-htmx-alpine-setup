#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding hematology-assessment (10 tables)..."

cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:text! \
    --htmx && \
cargo loco generate scaffold hem_rule \
    deleted_at:ts \
    code:text!^ \
    category:text! \
    description:text! \
    concern_level:text! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    abnormality_level:text! \
    abnormality_score:double! \
    abnormality_level_override:text \
    override_reason:text! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    hem_rule:references \
    rule_category:text! \
    rule_description:text! \
    rule_concern_level:text! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:text! \
    category:text! \
    message:text! \
    priority:text! \
    --htmx && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    abnormality_level:text! \
    abnormality_score:double! \
    abnormality_level_override:text \
    override_reason:text! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    hem_rule:references \
    rule_category:text! \
    rule_description:text! \
    rule_concern_level:text! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:text! \
    category:text! \
    message:text! \
    priority:text! \
    --htmx

echo "Done."
