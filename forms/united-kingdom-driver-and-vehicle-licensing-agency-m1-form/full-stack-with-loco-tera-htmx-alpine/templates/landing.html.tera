{% extends "base.html.tera" %}

{% block title %}DVLA M1 Form - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>DVLA M1 Form</h1>
        <p class="landing-description">
            Digital implementation of the United Kingdom Driver and Vehicle Licensing Agency
            <strong>M1 form</strong> &mdash; Confidential medical information (mental health).
            The M1 form is used by car drivers and motorcyclists to report a diagnosed mental
            health condition to the DVLA for driving fitness assessment.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Three Parts</h3>
                <p>Part A (about you), Part B (healthcare professionals), and the mental health questionnaire</p>
            </div>
            <div class="feature">
                <h3>Conditional Logic</h3>
                <p>Q1 = No stops the questionnaire; Q2 "Other" requires details; Q3 = Yes requires last-contact dates</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>Real-time alerts for suicidal-thoughts variant, psychotic spectrum, comorbid bipolar + personality disorder, and declaration not confirmed</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New M1 Submission
            </button>
        </form>
    </div>
</div>
{% endblock %}
