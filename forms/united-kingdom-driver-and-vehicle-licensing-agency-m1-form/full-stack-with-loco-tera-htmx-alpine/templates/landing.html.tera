{% extends "base.html.tera" %}

{% block title %}DVLA M1 — Home{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>DVLA M1 — Confidential Medical Information (Mental Health)</h1>
  <p>
    This form supports the UK Driver and Vehicle Licensing Agency (DVLA) M1
    process. Patients confirm whether they have been diagnosed with a mental
    health condition, identify the categories that apply, and provide recent
    healthcare contact details to support a driving fitness review.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>6 Steps</h3>
      <p>Personal details, healthcare professionals, Q1 diagnosis, Q2 conditions, Q3 recent contact, authorisation.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Conditional logic</h3>
      <p>Q1 = No stops the form. Q2 "Other" requires details. Q3 = Yes requires at least one date.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Safety flags</h3>
      <p>The "anxiety/depression with suicidal thoughts" variant escalates to urgent professional review.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New M1 Form
    </button>
  </form>
</div>
{% endblock %}
