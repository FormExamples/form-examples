{% extends "base.html.tera" %}

{% block title %}DVLA M1 — Validation Report{% endblock %}

{% block content %}
<div style="max-width:820px;margin:2rem auto;padding:1rem;">
  <h1>DVLA M1 — Validation Report</h1>
  <p style="color:#555;">Report generated: {{ timestamp }}</p>
  <p style="color:#555;">Assessment ID: {{ id }}</p>

  <h2>Summary</h2>
  <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;">
    <tbody>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.5rem 0.8rem;">Patient</td>
        <td style="padding:0.5rem 0.8rem;">
          {{ data.personalDetails.fullName }}{% if data.personalDetails.dateOfBirth %} (DOB {{ data.personalDetails.dateOfBirth }}){% endif %}
        </td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.5rem 0.8rem;">Q1 — Diagnosis confirmed</td>
        <td style="padding:0.5rem 0.8rem;">{{ data.diagnosisConfirmation.hasMentalHealthDiagnosis | default(value="(unanswered)") }}</td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.5rem 0.8rem;">Conditions reported</td>
        <td style="padding:0.5rem 0.8rem;">{{ result.conditionCount }}</td>
      </tr>
      <tr style="border-bottom:1px solid #eee;">
        <td style="padding:0.5rem 0.8rem;">Stopped at Q1?</td>
        <td style="padding:0.5rem 0.8rem;">{% if result.stoppedAtQ1 %}Yes — Q1 = No{% else %}No{% endif %}</td>
      </tr>
      <tr>
        <td style="padding:0.5rem 0.8rem;">Form complete?</td>
        <td style="padding:0.5rem 0.8rem;">
          {% if result.complete %}<strong style="color:#080;">Yes</strong>{% else %}<strong style="color:#a00;">No</strong>{% endif %}
        </td>
      </tr>
    </tbody>
  </table>

  <h2>Validation Issues</h2>
  {% if result.firedRules | length == 0 %}
    <p style="color:#080;">No validation issues fired.</p>
  {% else %}
    <ul style="padding-left:1.2rem;">
      {% for rule in result.firedRules %}
        <li style="margin-bottom:0.6rem;">
          <span style="display:inline-block;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;
            {% if rule.priority == 'urgent' %}background:#fee;color:#900;border:1px solid #f99;{% endif %}
            {% if rule.priority == 'high' %}background:#fef0e6;color:#a35100;border:1px solid #f5b97c;{% endif %}
            {% if rule.priority == 'medium' %}background:#fffbe6;color:#8a6d00;border:1px solid #f1d76b;{% endif %}
            {% if rule.priority == 'low' %}background:#eef;color:#226;border:1px solid #99d;{% endif %}">
            {{ rule.priority | upper }}
          </span>
          <strong>{{ rule.id }}:</strong> {{ rule.message }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2>Flagged Issues</h2>
  {% if result.additionalFlags | length == 0 %}
    <p style="color:#080;">No additional clinical flags were raised.</p>
  {% else %}
    <ul style="padding-left:1.2rem;">
      {% for flag in result.additionalFlags %}
        <li style="margin-bottom:0.6rem;">
          <span style="display:inline-block;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;
            {% if flag.priority == 'urgent' %}background:#fee;color:#900;border:1px solid #f99;{% endif %}
            {% if flag.priority == 'high' %}background:#fef0e6;color:#a35100;border:1px solid #f5b97c;{% endif %}
            {% if flag.priority == 'medium' %}background:#fffbe6;color:#8a6d00;border:1px solid #f1d76b;{% endif %}
            {% if flag.priority == 'low' %}background:#eef;color:#226;border:1px solid #99d;{% endif %}">
            {{ flag.priority | upper }}
          </span>
          <strong>{{ flag.category }}:</strong> {{ flag.message }}
          <span style="color:#888;font-size:0.85rem;">({{ flag.id }})</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <div style="display:flex;gap:1rem;margin-top:1.5rem;">
    <a href="/assessment/{{ id }}" style="padding:0.5rem 1.2rem;border:1px solid #0070f3;color:#0070f3;border-radius:4px;text-decoration:none;">
      Edit Assessment
    </a>
    <a href="/" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">
      Home
    </a>
  </div>
</div>
{% endblock %}
