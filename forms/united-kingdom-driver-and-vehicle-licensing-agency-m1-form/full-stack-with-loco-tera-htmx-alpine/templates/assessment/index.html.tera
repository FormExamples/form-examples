{% extends "base.html.tera" %}

{% block title %}DVLA M1 Form{% endblock %}

{% block content %}
<div style="max-width:880px;margin:2rem auto;padding:1rem;" x-data="{ step: 1, totalSteps: {{ total_steps }}, q1: '{{ data.diagnosisConfirmation.hasMentalHealthDiagnosis }}', q2other: '{{ data.mentalHealthConditions.other }}', q3: '{{ data.recentContact.hadRecentContact }}' }">
  <h1>DVLA M1 — Confidential Medical Information (Mental Health)</h1>
  <p style="color:#555;">Complete the {{ total_steps }} steps below, then submit.</p>

  <!-- Progress -->
  <div style="margin-bottom:1.5rem;">
    <span x-text="`Step ${step} of ${totalSteps}`" style="font-weight:bold;"></span>
    <div style="background:#eee;height:8px;border-radius:4px;margin-top:0.4rem;">
      <div :style="`width:${(step/totalSteps)*100}%;background:#0070f3;height:100%;border-radius:4px;transition:width 0.3s;`"></div>
    </div>
  </div>

  <form method="POST" action="/assessment/{{ id }}/submit" hx-boost="false">

    <!-- Step 1 — Personal Details (Part A) -->
    <div x-show="step === 1" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 1: Personal Details (Part A)</h2>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:140px;">
          <label>Title</label>
          <input type="text" name="title" value="{{ data.personalDetails.title }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Full name</label>
          <input type="text" name="fullName" value="{{ data.personalDetails.fullName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Date of birth</label>
          <input type="date" name="dateOfBirth" value="{{ data.personalDetails.dateOfBirth }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Address</label>
        <textarea name="address" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.personalDetails.address }}</textarea>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:140px;">
          <label>Postcode</label>
          <input type="text" name="postcode" value="{{ data.personalDetails.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:2;min-width:200px;">
          <label>Email</label>
          <input type="email" name="email" value="{{ data.personalDetails.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Contact number</label>
          <input type="tel" name="contactNumber" value="{{ data.personalDetails.contactNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Have your details changed since DVLA last contacted you?</label>
        {% set v = data.personalDetails.changeOfDetails %}
        <select name="changeOfDetails" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
    </div>

    <!-- Step 2 — Healthcare Professionals (Part B) -->
    <div x-show="step === 2" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 2: Healthcare Professionals (Part B)</h2>
      <h3>GP details</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>GP name</label>
          <input type="text" name="gpName" value="{{ data.healthcareProfessionals.gp.gpName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Surgery name</label>
          <input type="text" name="gpSurgeryName" value="{{ data.healthcareProfessionals.gp.surgeryName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Surgery address</label>
        <input type="text" name="gpAddress" value="{{ data.healthcareProfessionals.gp.address }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:140px;">
          <label>Town</label>
          <input type="text" name="gpTown" value="{{ data.healthcareProfessionals.gp.town }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Postcode</label>
          <input type="text" name="gpPostcode" value="{{ data.healthcareProfessionals.gp.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Contact number</label>
          <input type="tel" name="gpContactNumber" value="{{ data.healthcareProfessionals.gp.contactNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Date last seen</label>
          <input type="date" name="gpDateLastSeen" value="{{ data.healthcareProfessionals.gp.dateLastSeen }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>GP email</label>
        <input type="email" name="gpEmail" value="{{ data.healthcareProfessionals.gp.email }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>

      <h3 style="margin-top:1.5rem;">Consultant details (if any)</h3>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <label>Consultant name</label>
          <input type="text" name="consultantName" value="{{ data.healthcareProfessionals.consultant.consultantName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Speciality</label>
          <input type="text" name="consultantSpeciality" value="{{ data.healthcareProfessionals.consultant.speciality }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Department</label>
          <input type="text" name="consultantDepartment" value="{{ data.healthcareProfessionals.consultant.department }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:2;min-width:200px;">
          <label>Hospital name</label>
          <input type="text" name="consultantHospitalName" value="{{ data.healthcareProfessionals.consultant.hospitalName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Date last seen</label>
          <input type="date" name="consultantDateLastSeen" value="{{ data.healthcareProfessionals.consultant.dateLastSeen }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="margin-top:1rem;">
        <label>Hospital address</label>
        <input type="text" name="consultantAddress" value="{{ data.healthcareProfessionals.consultant.address }}"
               style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:140px;">
          <label>Town</label>
          <input type="text" name="consultantTown" value="{{ data.healthcareProfessionals.consultant.town }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Postcode</label>
          <input type="text" name="consultantPostcode" value="{{ data.healthcareProfessionals.consultant.postcode }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Contact number</label>
          <input type="tel" name="consultantContactNumber" value="{{ data.healthcareProfessionals.consultant.contactNumber }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:140px;">
          <label>Email</label>
          <input type="email" name="consultantEmail" value="{{ data.healthcareProfessionals.consultant.email }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 3 — Q1 Diagnosis confirmation -->
    <div x-show="step === 3" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 3: Q1 — Diagnosis Confirmation</h2>
      <p><strong>Have you been diagnosed with a mental health condition?</strong></p>
      <select name="hasMentalHealthDiagnosis" x-model="q1"
              style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;max-width:300px;">
        <option value="">— select —</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
      <p x-show="q1 === 'no'" style="margin-top:1rem;color:#a35100;background:#fef0e6;border:1px solid #f5b97c;padding:0.6rem;border-radius:4px;">
        You have answered <strong>No</strong>. The DVLA does not require Q2 or Q3 to be completed.
        Please continue to the authorisation page.
      </p>
    </div>

    <!-- Step 4 — Q2 Mental health conditions -->
    <div x-show="step === 4" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 4: Q2 — Mental Health Conditions</h2>
      <p style="color:#666;font-size:0.9rem;">Mark Yes for any condition that applies. Required only when Q1 = Yes.</p>
      {% set yn_options = [
        ["anxietyDepressionWithoutImpairment", "Anxiety or depression (without impairment of concentration, memory or agitation)", data.mentalHealthConditions.anxietyDepressionWithoutImpairment],
        ["anxietyDepressionWithImpairment", "Anxiety or depression (with suicidal thoughts or impairment in concentration, memory or agitation)", data.mentalHealthConditions.anxietyDepressionWithImpairment],
        ["bipolarAffectiveDisorder", "Bipolar affective disorder", data.mentalHealthConditions.bipolarAffectiveDisorder],
        ["eatingDisorder", "Eating disorder (anorexia nervosa, bulimia)", data.mentalHealthConditions.eatingDisorder],
        ["ocdOrPtsd", "Obsessive compulsive disorder or post-traumatic stress disorder", data.mentalHealthConditions.ocdOrPtsd],
        ["personalityDisorder", "Personality disorder (any type)", data.mentalHealthConditions.personalityDisorder],
        ["schizophreniaOrPsychosis", "Schizophrenia, psychosis, delusional or schizoaffective disorder", data.mentalHealthConditions.schizophreniaOrPsychosis],
      ] %}
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:0.4rem 0.6rem;text-align:left;">Condition</th>
            <th style="padding:0.4rem 0.6rem;">Yes</th>
            <th style="padding:0.4rem 0.6rem;">No</th>
          </tr>
        </thead>
        <tbody>
          {% for opt in yn_options %}
          <tr style="border-bottom:1px solid #eee;">
            <td style="padding:0.4rem 0.6rem;">{{ opt[1] }}</td>
            <td style="padding:0.4rem 0.6rem;text-align:center;">
              <input type="radio" name="{{ opt[0] }}" value="yes" {% if opt[2] == "yes" %}checked{% endif %}>
            </td>
            <td style="padding:0.4rem 0.6rem;text-align:center;">
              <input type="radio" name="{{ opt[0] }}" value="no" {% if opt[2] == "no" %}checked{% endif %}>
            </td>
          </tr>
          {% endfor %}
          <tr style="border-bottom:1px solid #eee;">
            <td style="padding:0.4rem 0.6rem;">Other</td>
            <td style="padding:0.4rem 0.6rem;text-align:center;">
              <input type="radio" name="other" value="yes" x-model="q2other" {% if data.mentalHealthConditions.other == "yes" %}checked{% endif %}>
            </td>
            <td style="padding:0.4rem 0.6rem;text-align:center;">
              <input type="radio" name="other" value="no" x-model="q2other" {% if data.mentalHealthConditions.other == "no" %}checked{% endif %}>
            </td>
          </tr>
        </tbody>
      </table>
      <div style="margin-top:1rem;" x-show="q2other === 'yes'">
        <label>Please describe the other condition</label>
        <textarea name="otherDetails" rows="2"
                  style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">{{ data.mentalHealthConditions.otherDetails }}</textarea>
      </div>
    </div>

    <!-- Step 5 — Q3 Recent contact -->
    <div x-show="step === 5" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 5: Q3 — Recent Healthcare Contact</h2>
      <p><strong>Have you had any contact with your healthcare professional in the last 12 months?</strong></p>
      <select name="hadRecentContact" x-model="q3"
              style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;max-width:300px;">
        <option value="">— select —</option>
        <option value="yes" {% if data.recentContact.hadRecentContact == "yes" %}selected{% endif %}>Yes</option>
        <option value="no" {% if data.recentContact.hadRecentContact == "no" %}selected{% endif %}>No</option>
      </select>
      <div x-show="q3 === 'yes'" style="margin-top:1rem;display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <label>Doctor — date last seen</label>
          <input type="date" name="doctorLastDate" value="{{ data.recentContact.doctorLastDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Consultant — date last seen</label>
          <input type="date" name="consultantLastDate" value="{{ data.recentContact.consultantLastDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Community psychiatric nurse — date last seen</label>
          <input type="date" name="communityPsychiatricNurseLastDate"
                 value="{{ data.recentContact.communityPsychiatricNurseLastDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
    </div>

    <!-- Step 6 — Authorisation -->
    <div x-show="step === 6" style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;margin-bottom:1rem;">
      <h2>Step 6: Applicant's Authorisation</h2>
      <p style="font-size:0.9rem;color:#444;">
        I authorise the DVLA to seek information from healthcare professionals, hospitals
        and other bodies, regarding my medical condition for the purpose of assessing my
        fitness to drive.
      </p>
      <div>
        <label>Confirm the declaration?</label>
        {% set v = data.authorisation.declarationConfirmed %}
        <select name="declarationConfirmed" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;max-width:300px;">
          <option value="">— select —</option>
          <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes — I confirm</option>
          <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
        </select>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:200px;">
          <label>Signatory name</label>
          <input type="text" name="signatoryName" value="{{ data.authorisation.signatoryName }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Signature (typed)</label>
          <input type="text" name="signatureText" value="{{ data.authorisation.signatureText }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
        <div style="flex:1;min-width:160px;">
          <label>Signature date</label>
          <input type="date" name="signatureDate" value="{{ data.authorisation.signatureDate }}"
                 style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
        </div>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;">
        <div style="flex:1;min-width:200px;">
          <label>Consent to electronic correspondence?</label>
          {% set v = data.authorisation.electronicCorrespondenceConsent %}
          <select name="electronicCorrespondenceConsent" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="yes" {% if v == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if v == "no" %}selected{% endif %}>No</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>DVLA contact preference</label>
          {% set v = data.authorisation.dvlaContactPreference %}
          <select name="dvlaContactPreference" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="email" {% if v == "email" %}selected{% endif %}>Email</option>
            <option value="sms" {% if v == "sms" %}selected{% endif %}>SMS</option>
          </select>
        </div>
        <div style="flex:1;min-width:200px;">
          <label>Healthcare professional contact preference</label>
          {% set v = data.authorisation.healthcareProfessionalContactPreference %}
          <select name="healthcareProfessionalContactPreference" style="width:100%;padding:0.4rem;border:1px solid #ccc;border-radius:4px;">
            <option value="">— select —</option>
            <option value="email" {% if v == "email" %}selected{% endif %}>Email</option>
            <option value="sms" {% if v == "sms" %}selected{% endif %}>SMS</option>
          </select>
        </div>
      </div>
      <p style="color:#666;font-size:0.9rem;margin-top:1rem;">Assessment ID: {{ id }}</p>
    </div>

    <!-- Navigation -->
    <div style="display:flex;justify-content:space-between;margin-top:1.5rem;">
      <button type="button" @click="if(step > 1) step--" :disabled="step === 1"
              style="padding:0.5rem 1.2rem;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;">
        &laquo; Previous
      </button>
      <button type="button" @click="if(step < totalSteps) step++" x-show="step < totalSteps"
              style="padding:0.5rem 1.2rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;">
        Next &raquo;
      </button>
      <button type="submit" x-show="step === totalSteps"
              style="padding:0.5rem 1.4rem;background:#28a745;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:bold;">
        Submit
      </button>
    </div>
  </form>
</div>
{% endblock %}
