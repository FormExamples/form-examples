<div class="card">
    <h2>Step 4: Mental Health Conditions (Q2)</h2>
    <p class="form-hint">
        Please confirm what mental health condition you have been diagnosed with (Yes/No for each).
        Only complete this step if Q1 = Yes.
    </p>

    <div class="form-group">
        <label for="anxiety_depression_without_impairment">
            Anxiety or depression (without any impairment of concentration, memory or agitation)
        </label>
        <select id="anxiety_depression_without_impairment"
                name="mental_health_conditions.anxiety_depression_without_impairment">
            <option value="" {% if mental_health_conditions.anxietyDepressionWithoutImpairment == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.anxietyDepressionWithoutImpairment == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.anxietyDepressionWithoutImpairment == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="anxiety_depression_with_impairment">
            Anxiety or depression (with suicidal thoughts or impairment in concentration, memory or agitation)
        </label>
        <select id="anxiety_depression_with_impairment"
                name="mental_health_conditions.anxiety_depression_with_impairment">
            <option value="" {% if mental_health_conditions.anxietyDepressionWithImpairment == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.anxietyDepressionWithImpairment == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.anxietyDepressionWithImpairment == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="bipolar_affective_disorder">Bipolar affective disorder</label>
        <select id="bipolar_affective_disorder"
                name="mental_health_conditions.bipolar_affective_disorder">
            <option value="" {% if mental_health_conditions.bipolarAffectiveDisorder == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.bipolarAffectiveDisorder == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.bipolarAffectiveDisorder == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="eating_disorder">Eating disorder (anorexia nervosa, bulimia)</label>
        <select id="eating_disorder"
                name="mental_health_conditions.eating_disorder">
            <option value="" {% if mental_health_conditions.eatingDisorder == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.eatingDisorder == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.eatingDisorder == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ocd_or_ptsd">Obsessive compulsive disorder or post-traumatic stress disorder</label>
        <select id="ocd_or_ptsd"
                name="mental_health_conditions.ocd_or_ptsd">
            <option value="" {% if mental_health_conditions.ocdOrPtsd == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.ocdOrPtsd == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.ocdOrPtsd == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="personality_disorder">Personality disorder (any type)</label>
        <select id="personality_disorder"
                name="mental_health_conditions.personality_disorder">
            <option value="" {% if mental_health_conditions.personalityDisorder == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.personalityDisorder == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.personalityDisorder == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="schizophrenia_or_psychosis">
            Schizophrenia or psychosis or delusional disorder or schizoaffective disorder
        </label>
        <select id="schizophrenia_or_psychosis"
                name="mental_health_conditions.schizophrenia_or_psychosis">
            <option value="" {% if mental_health_conditions.schizophreniaOrPsychosis == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.schizophreniaOrPsychosis == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.schizophreniaOrPsychosis == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="other">Other (please specify)</label>
        <select id="other" name="mental_health_conditions.other">
            <option value="" {% if mental_health_conditions.other == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if mental_health_conditions.other == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if mental_health_conditions.other == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="other_details">Other condition details (required when Other = Yes)</label>
        <textarea id="other_details"
                  name="mental_health_conditions.other_details"
                  placeholder="Describe the other mental health condition">{{ mental_health_conditions.otherDetails }}</textarea>
    </div>
</div>
