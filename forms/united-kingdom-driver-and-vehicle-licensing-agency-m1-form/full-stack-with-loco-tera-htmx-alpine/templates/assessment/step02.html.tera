<div class="card">
    <h2>Step 2: Healthcare Professionals (Part B)</h2>
    <p class="form-hint">
        GP details and consultant details for the mental health condition.
    </p>

    <h3>GP Details</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="gp_name">GP Name</label>
            <input type="text" id="gp_name" name="healthcare_professionals.gp.gp_name"
                   value="{{ gp.gpName }}">
        </div>
        <div class="form-group">
            <label for="gp_surgery_name">Surgery Name</label>
            <input type="text" id="gp_surgery_name" name="healthcare_professionals.gp.surgery_name"
                   value="{{ gp.surgeryName }}">
        </div>
    </div>

    <div class="form-group">
        <label for="gp_address">Address</label>
        <textarea id="gp_address" name="healthcare_professionals.gp.address">{{ gp.address }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="gp_town">Town</label>
            <input type="text" id="gp_town" name="healthcare_professionals.gp.town"
                   value="{{ gp.town }}">
        </div>
        <div class="form-group">
            <label for="gp_postcode">Postcode</label>
            <input type="text" id="gp_postcode" name="healthcare_professionals.gp.postcode"
                   value="{{ gp.postcode }}">
        </div>
        <div class="form-group">
            <label for="gp_contact_number">Contact Number</label>
            <input type="text" id="gp_contact_number" name="healthcare_professionals.gp.contact_number"
                   value="{{ gp.contactNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="gp_email">Email (if known)</label>
            <input type="email" id="gp_email" name="healthcare_professionals.gp.email"
                   value="{{ gp.email }}">
        </div>
        <div class="form-group">
            <label for="gp_date_last_seen">Date Last Seen for this Condition</label>
            <input type="date" id="gp_date_last_seen" name="healthcare_professionals.gp.date_last_seen"
                   value="{{ gp.dateLastSeen }}">
        </div>
    </div>

    <h3>Consultant Details</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="consultant_name">Consultant Name</label>
            <input type="text" id="consultant_name" name="healthcare_professionals.consultant.consultant_name"
                   value="{{ consultant.consultantName }}">
        </div>
        <div class="form-group">
            <label for="consultant_speciality">Speciality</label>
            <input type="text" id="consultant_speciality" name="healthcare_professionals.consultant.speciality"
                   value="{{ consultant.speciality }}" placeholder="e.g. Psychiatry">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="consultant_department">Department</label>
            <input type="text" id="consultant_department" name="healthcare_professionals.consultant.department"
                   value="{{ consultant.department }}">
        </div>
        <div class="form-group">
            <label for="consultant_hospital_name">Hospital Name</label>
            <input type="text" id="consultant_hospital_name" name="healthcare_professionals.consultant.hospital_name"
                   value="{{ consultant.hospitalName }}">
        </div>
    </div>

    <div class="form-group">
        <label for="consultant_address">Address</label>
        <textarea id="consultant_address" name="healthcare_professionals.consultant.address">{{ consultant.address }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="consultant_town">Town</label>
            <input type="text" id="consultant_town" name="healthcare_professionals.consultant.town"
                   value="{{ consultant.town }}">
        </div>
        <div class="form-group">
            <label for="consultant_postcode">Postcode</label>
            <input type="text" id="consultant_postcode" name="healthcare_professionals.consultant.postcode"
                   value="{{ consultant.postcode }}">
        </div>
        <div class="form-group">
            <label for="consultant_contact_number">Contact Number</label>
            <input type="text" id="consultant_contact_number" name="healthcare_professionals.consultant.contact_number"
                   value="{{ consultant.contactNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="consultant_email">Email (if known)</label>
            <input type="email" id="consultant_email" name="healthcare_professionals.consultant.email"
                   value="{{ consultant.email }}">
        </div>
        <div class="form-group">
            <label for="consultant_date_last_seen">Date Last Seen for this Condition</label>
            <input type="date" id="consultant_date_last_seen" name="healthcare_professionals.consultant.date_last_seen"
                   value="{{ consultant.dateLastSeen }}">
        </div>
    </div>
</div>
