<div class="card">
    <h2>Step 6: Applicant's Authorisation</h2>
    <p class="form-hint">
        I authorise my doctor(s), specialist(s), and other healthcare professionals to release
        medical information to the DVLA Medical Adviser. I understand that making a false
        declaration is a criminal offence under section 174 of the Road Traffic Act 1988.
    </p>

    <div class="form-group">
        <label for="declaration_confirmed">
            I confirm the declaration above
        </label>
        <select id="declaration_confirmed"
                name="authorisation.declaration_confirmed">
            <option value="" {% if authorisation.declarationConfirmed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if authorisation.declarationConfirmed == "yes" %}selected{% endif %}>Yes &mdash; I confirm</option>
            <option value="no" {% if authorisation.declarationConfirmed == "no" %}selected{% endif %}>No</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="signatory_name">Signatory Name</label>
            <input type="text" id="signatory_name"
                   name="authorisation.signatory_name"
                   value="{{ authorisation.signatoryName }}">
        </div>
        <div class="form-group">
            <label for="signature_text">Signature (typed)</label>
            <input type="text" id="signature_text"
                   name="authorisation.signature_text"
                   value="{{ authorisation.signatureText }}"
                   placeholder="Type your signature">
        </div>
        <div class="form-group">
            <label for="signature_date">Signature Date</label>
            <input type="date" id="signature_date"
                   name="authorisation.signature_date"
                   value="{{ authorisation.signatureDate }}">
        </div>
    </div>

    <h3>Electronic correspondence</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="electronic_correspondence_consent">Consent to electronic correspondence (email)?</label>
            <select id="electronic_correspondence_consent"
                    name="authorisation.electronic_correspondence_consent">
                <option value="" {% if authorisation.electronicCorrespondenceConsent == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if authorisation.electronicCorrespondenceConsent == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if authorisation.electronicCorrespondenceConsent == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="dvla_contact_preference">Contact preference from DVLA</label>
            <select id="dvla_contact_preference"
                    name="authorisation.dvla_contact_preference">
                <option value="" {% if authorisation.dvlaContactPreference == "" %}selected{% endif %}>&mdash;</option>
                <option value="email" {% if authorisation.dvlaContactPreference == "email" %}selected{% endif %}>Email</option>
                <option value="sms" {% if authorisation.dvlaContactPreference == "sms" %}selected{% endif %}>SMS (Text)</option>
            </select>
        </div>
        <div class="form-group">
            <label for="healthcare_professional_contact_preference">Contact preference from healthcare professional</label>
            <select id="healthcare_professional_contact_preference"
                    name="authorisation.healthcare_professional_contact_preference">
                <option value="" {% if authorisation.healthcareProfessionalContactPreference == "" %}selected{% endif %}>&mdash;</option>
                <option value="email" {% if authorisation.healthcareProfessionalContactPreference == "email" %}selected{% endif %}>Email</option>
                <option value="sms" {% if authorisation.healthcareProfessionalContactPreference == "sms" %}selected{% endif %}>SMS (Text)</option>
            </select>
        </div>
    </div>
</div>
