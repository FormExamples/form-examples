{% extends "base.html.tera" %}

{% block title %}DVLA M1 Form - Report{% endblock %}

{% block content %}
<div class="report-header">
    <h1>DVLA M1 Form &mdash; Submission Report</h1>
    {% if complete %}
        <div class="checklist-badge checklist-complete">Complete</div>
    {% else %}
        <div class="checklist-badge checklist-in-progress">Incomplete</div>
    {% endif %}
    {% if stopped_at_q1 %}
        <p><em>Form stopped at Q1 (no mental health diagnosis reported); Q2/Q3 not required.</em></p>
    {% endif %}
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Submission ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Applicant Summary -->
<div class="card">
    <h2>Applicant Summary</h2>
    <div class="form-row">
        <div>
            <strong>Title:</strong> {{ data.personalDetails.title }}<br>
            <strong>Full Name:</strong> {{ data.personalDetails.fullName }}<br>
            <strong>Date of Birth:</strong> {{ data.personalDetails.dateOfBirth }}<br>
            <strong>Postcode:</strong> {{ data.personalDetails.postcode }}<br>
            <strong>Email:</strong> {{ data.personalDetails.email }}<br>
            <strong>Contact Number:</strong> {{ data.personalDetails.contactNumber }}
        </div>
        <div>
            <strong>GP:</strong> {{ data.healthcareProfessionals.gp.gpName }}<br>
            <strong>Surgery:</strong> {{ data.healthcareProfessionals.gp.surgeryName }}<br>
            <strong>Consultant:</strong> {{ data.healthcareProfessionals.consultant.consultantName }}<br>
            <strong>Speciality:</strong> {{ data.healthcareProfessionals.consultant.speciality }}<br>
            <strong>Hospital:</strong> {{ data.healthcareProfessionals.consultant.hospitalName }}
        </div>
    </div>
</div>

<!-- Diagnosis Summary -->
<div class="card">
    <h2>Diagnosis</h2>
    <p><strong>Q1 &mdash; Diagnosed with a mental health condition:</strong>
        {% if data.diagnosisConfirmation.hasMentalHealthDiagnosis == "" %}
            <span class="badge badge-no">Unanswered</span>
        {% else %}
            <span class="badge badge-yes">{{ data.diagnosisConfirmation.hasMentalHealthDiagnosis }}</span>
        {% endif %}
    </p>
    {% if data.diagnosisConfirmation.hasMentalHealthDiagnosis == "yes" %}
    <p><strong>Conditions reported:</strong> {{ condition_count }}</p>
    <ul>
        {% if data.mentalHealthConditions.anxietyDepressionWithoutImpairment == "yes" %}<li>Anxiety or depression (without impairment)</li>{% endif %}
        {% if data.mentalHealthConditions.anxietyDepressionWithImpairment == "yes" %}<li>Anxiety or depression (with suicidal thoughts or impairment)</li>{% endif %}
        {% if data.mentalHealthConditions.bipolarAffectiveDisorder == "yes" %}<li>Bipolar affective disorder</li>{% endif %}
        {% if data.mentalHealthConditions.eatingDisorder == "yes" %}<li>Eating disorder</li>{% endif %}
        {% if data.mentalHealthConditions.ocdOrPtsd == "yes" %}<li>Obsessive compulsive disorder or PTSD</li>{% endif %}
        {% if data.mentalHealthConditions.personalityDisorder == "yes" %}<li>Personality disorder</li>{% endif %}
        {% if data.mentalHealthConditions.schizophreniaOrPsychosis == "yes" %}<li>Schizophrenia, psychosis, delusional or schizoaffective disorder</li>{% endif %}
        {% if data.mentalHealthConditions.other == "yes" %}<li>Other &mdash; {{ data.mentalHealthConditions.otherDetails }}</li>{% endif %}
    </ul>
    <p><strong>Q3 &mdash; Recent contact in last 12 months:</strong>
        {% if data.recentContact.hadRecentContact == "" %}
            <span class="badge badge-no">Unanswered</span>
        {% else %}
            <span class="badge badge-yes">{{ data.recentContact.hadRecentContact }}</span>
        {% endif %}
    </p>
    {% if data.recentContact.hadRecentContact == "yes" %}
    <ul>
        {% if data.recentContact.doctorLastDate %}<li>Doctor &mdash; last seen {{ data.recentContact.doctorLastDate }}</li>{% endif %}
        {% if data.recentContact.consultantLastDate %}<li>Consultant &mdash; last seen {{ data.recentContact.consultantLastDate }}</li>{% endif %}
        {% if data.recentContact.communityPsychiatricNurseLastDate %}<li>Community psychiatric nurse &mdash; last seen {{ data.recentContact.communityPsychiatricNurseLastDate }}</li>{% endif %}
    </ul>
    {% endif %}
    {% endif %}
</div>

<!-- Authorisation -->
<div class="card">
    <h2>Authorisation</h2>
    <p>
        <strong>Declaration confirmed:</strong>
        {% if data.authorisation.declarationConfirmed == "yes" %}
            <span class="badge badge-yes">Yes</span>
        {% else %}
            <span class="badge badge-no">{{ data.authorisation.declarationConfirmed }}</span>
        {% endif %}
        <br>
        <strong>Signatory:</strong> {{ data.authorisation.signatoryName }}<br>
        <strong>Signature:</strong> {{ data.authorisation.signatureText }}<br>
        <strong>Signed on:</strong> {{ data.authorisation.signatureDate }}<br>
        <strong>Electronic correspondence consent:</strong> {{ data.authorisation.electronicCorrespondenceConsent }}<br>
        <strong>DVLA contact preference:</strong> {{ data.authorisation.dvlaContactPreference }}<br>
        <strong>Healthcare professional contact preference:</strong> {{ data.authorisation.healthcareProfessionalContactPreference }}
    </p>
</div>

<!-- Safety / clinical flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Additional Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Validation Findings ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Description</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.category }}</td>
                <td><span class="severity-badge severity-{{ rule.priority }}">{{ rule.priority }}</span></td>
                <td>{{ rule.description }}</td>
                <td>{{ rule.message }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New M1 Submission</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
