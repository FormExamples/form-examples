#!/bin/sh
set -euf

form_kebab_case=genetic-assessment
form_snake_case=genetic_assessment

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api

cargo loco generate scaffold assessment \
    deleted_at:tstz \
    patient:references \
    status:string! \
    --api

cargo loco generate scaffold assessment_cancer_history \
    deleted_at:tstz \
    assessment:references \
    family_cancer_history:string! \
    multiple_family_cancers:string! \
    early_onset_cancer:string! \
    bilateral_cancer:string! \
    rare_tumour_types:string! \
    rare_tumour_details:text! \
    known_cancer_syndrome:string! \
    cancer_syndrome_details:text! \
    cancer_risk_score:int \
    --api

cargo loco generate scaffold assessment_cancer_history_item \
    deleted_at:tstz \
    cancer_history:references \
    relative_relationship:string! \
    cancer_type:string! \
    age_at_diagnosis:int \
    outcome:string! \
    sort_order:int! \
    --api

cargo loco generate scaffold assessment_family_pedigree \
    deleted_at:tstz \
    assessment:references \
    total_first_degree_relatives:int \
    total_second_degree_relatives:int \
    consanguinity_in_family:string! \
    consanguinity_details:text! \
    adoption_status:string! \
    pedigree_notes:text! \
    three_generation_pedigree_drawn:string! \
    --api

cargo loco generate scaffold assessment_family_pedigree_member \
    deleted_at:tstz \
    family_pedigree:references \
    relationship:string! \
    sex:string! \
    age:int \
    alive:string! \
    age_at_death:int \
    cause_of_death:string! \
    medical_conditions:text! \
    sort_order:int! \
    --api

cargo loco generate scaffold grade \
    deleted_at:tstz \
    assessment:references \
    risk_level:string! \
    total_risk_score:int! \
    cancer_genetics_score:int! \
    cardiovascular_genetics_score:int! \
    neurogenetics_score:int! \
    reproductive_genetics_score:int! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold grading_fired_rule \
    deleted_at:tstz \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    risk_level:string! \
    --api

cargo loco generate scaffold grading_additional_flag \
    deleted_at:tstz \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --api
