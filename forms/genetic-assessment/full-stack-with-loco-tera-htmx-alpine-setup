#!/bin/sh
# setup.sh
#
# Setup script for full stack Loco application.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate scaffolds.
#
# Tables are scaffolded in the same order as the form's sql-migrations/ 
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/generate-full-stack-with-loco.py from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding genetic-assessment (9 tables)..."

cargo loco generate scaffold assessment \
    deleted_at:ts \
    patient:references \
    status:string! \
    cancer_history_deleted_at:ts \
    family_cancer_history:string! \
    multiple_family_cancers:string! \
    early_onset_cancer:string! \
    bilateral_cancer:string! \
    rare_tumour_types:string! \
    rare_tumour_details:text! \
    known_cancer_syndrome:string! \
    cancer_syndrome_details:text! \
    cancer_risk_score:int \
    cancer_history_item_deleted_at:ts \
    cancer_history:references \
    relative_relationship:string! \
    cancer_type:string! \
    age_at_diagnosis:int \
    outcome:string! \
    sort_order:int! \
    family_pedigree_deleted_at:ts \
    total_first_degree_relatives:int \
    total_second_degree_relatives:int \
    consanguinity_in_family:string! \
    consanguinity_details:text! \
    adoption_status:string! \
    pedigree_notes:text! \
    three_generation_pedigree_drawn:string! \
    family_pedigree_member_deleted_at:ts \
    family_pedigree:references \
    relationship:string! \
    sex:string! \
    age:int \
    alive:string! \
    age_at_death:int \
    cause_of_death:string! \
    medical_conditions:text! \
    family_pedigree_member_sort_order:int! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    risk_level:string! \
    total_risk_score:int! \
    cancer_genetics_score:int! \
    cardiovascular_genetics_score:int! \
    neurogenetics_score:int! \
    reproductive_genetics_score:int! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    risk_level:string! \
    --htmx && \
cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --htmx && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx && \
cargo loco generate scaffold grade \
    deleted_at:ts \
    assessment:references \
    risk_level:string! \
    total_risk_score:int! \
    cancer_genetics_score:int! \
    cardiovascular_genetics_score:int! \
    neurogenetics_score:int! \
    reproductive_genetics_score:int! \
    graded_at:ts! \
    --htmx && \
cargo loco generate scaffold grading_fired_rule \
    deleted_at:ts \
    grade:references \
    rule_id:string! \
    category:string! \
    description:text! \
    risk_level:string! \
    --htmx && \
cargo loco generate scaffold grading_additional_flag \
    deleted_at:ts \
    grade:references \
    flag_id:string! \
    category:string! \
    message:text! \
    priority:string! \
    --htmx

echo "Done."
