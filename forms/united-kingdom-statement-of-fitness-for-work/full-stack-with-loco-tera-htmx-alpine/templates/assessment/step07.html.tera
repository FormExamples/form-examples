<div class="card">
    <h2>Step 7: Comments</h2>
    <p class="form-hint">
        Free-text advice (DWP policy 5.6) describing functional impact and
        practical recommendations for the patient and employer.
    </p>

    <div class="form-group">
        <label for="comments">Comments</label>
        <textarea id="comments" name="comments" rows="5">{{ data.comments }}</textarea>
    </div>
</div>
