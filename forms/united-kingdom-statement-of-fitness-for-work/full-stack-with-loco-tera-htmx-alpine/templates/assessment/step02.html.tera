<div class="card">
    <h2>Step 2: Patient</h2>
    <p class="form-hint">Patient identification and employment details.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_name">Full Name</label>
            <input type="text" id="patient_name" name="patient.name"
                   value="{{ data.patient.name }}">
        </div>
        <div class="form-group">
            <label for="patient_birth_date">Date of Birth</label>
            <input type="date" id="patient_birth_date" name="patient.birth_date"
                   value="{{ data.patient.birthDate }}">
        </div>
        <div class="form-group">
            <label for="patient_united_kingdom_nhs_number">NHS Number</label>
            <input type="text" id="patient_united_kingdom_nhs_number" name="patient.united_kingdom_nhs_number"
                   value="{{ data.patient.unitedKingdomNhsNumber }}">
        </div>
    </div>

    <div class="form-group">
        <label for="patient_postal_address_as_full_text">Postal Address (full)</label>
        <textarea id="patient_postal_address_as_full_text" name="patient.postal_address_as_full_text" rows="2">{{ data.patient.postalAddressAsFullText }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_postcode">Postcode</label>
            <input type="text" id="patient_postcode" name="patient.postcode"
                   value="{{ data.patient.postcode }}">
        </div>
        <div class="form-group">
            <label for="patient_employer_name">Employer Name</label>
            <input type="text" id="patient_employer_name" name="patient.employer_name"
                   value="{{ data.patient.employerName }}">
        </div>
        <div class="form-group">
            <label for="patient_occupation">Occupation</label>
            <input type="text" id="patient_occupation" name="patient.occupation"
                   value="{{ data.patient.occupation }}">
        </div>
    </div>
</div>
