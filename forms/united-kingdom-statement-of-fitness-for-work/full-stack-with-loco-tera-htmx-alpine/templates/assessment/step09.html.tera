<div class="card">
    <h2>Step 9: Follow-up</h2>
    <p class="form-hint">Will the clinician reassess at the end of this period?</p>

    <div class="form-row">
        <div class="form-group">
            <label for="will_assess_again">Will assess again?</label>
            <select id="will_assess_again" name="will_assess_again">
                <option value="" {% if data.willAssessAgain == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if data.willAssessAgain == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if data.willAssessAgain == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="planned_review_date">Planned Review Date</label>
            <input type="date" id="planned_review_date" name="planned_review_date"
                   value="{{ data.plannedReviewDate }}">
        </div>
    </div>
</div>
