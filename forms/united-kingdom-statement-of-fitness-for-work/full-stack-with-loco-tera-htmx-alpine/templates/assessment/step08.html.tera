<div class="card">
    <h2>Step 8: Period</h2>
    <p class="form-hint">
        DWP policy 3.3: initial fit-note maximum duration is 3 months in the
        first 6 months of the condition. Provide either a duration or an
        explicit from-to range.
    </p>

    <div class="form-group">
        <label>
            <input type="radio" name="period_type" value="duration"
                   {% if data.periodType == "duration" %}checked{% endif %}>
            Duration (e.g. 4 weeks)
        </label>
        <label>
            <input type="radio" name="period_type" value="from_to"
                   {% if data.periodType == "from_to" %}checked{% endif %}>
            From / to dates
        </label>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="period_duration_value">Duration Value</label>
            <input type="number" min="1" id="period_duration_value" name="period_duration_value"
                   value="{% if data.periodDurationValue %}{{ data.periodDurationValue }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="period_duration_unit">Duration Unit</label>
            <select id="period_duration_unit" name="period_duration_unit">
                <option value="" {% if data.periodDurationUnit == "" %}selected{% endif %}>&mdash;</option>
                <option value="days" {% if data.periodDurationUnit == "days" %}selected{% endif %}>Days</option>
                <option value="weeks" {% if data.periodDurationUnit == "weeks" %}selected{% endif %}>Weeks</option>
                <option value="months" {% if data.periodDurationUnit == "months" %}selected{% endif %}>Months</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="period_from">From</label>
            <input type="date" id="period_from" name="period_from"
                   value="{{ data.periodFrom }}">
        </div>
        <div class="form-group">
            <label for="period_to">To</label>
            <input type="date" id="period_to" name="period_to"
                   value="{{ data.periodTo }}">
        </div>
    </div>
</div>
