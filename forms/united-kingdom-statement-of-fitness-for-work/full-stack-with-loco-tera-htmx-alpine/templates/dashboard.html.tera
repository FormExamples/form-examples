{% extends "base.html.tera" %}

{% block title %}UK Fit Note - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>Fit Note Dashboard</h1>
    <a href="/" class="btn btn-primary">New Fit Note</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, NHS number, clinician, or diagnosis...">
    </div>
    <div class="form-group">
        <label for="fitness_category">Fitness Category</label>
        <select id="fitness_category" name="fitness_category">
            <option value="">All</option>
            <option value="not_fit" {% if fitness_category == "not_fit" %}selected{% endif %}>Not fit</option>
            <option value="may_be_fit" {% if fitness_category == "may_be_fit" %}selected{% endif %}>May be fit</option>
        </select>
    </div>
    <div class="form-group">
        <label for="period_compliance">Period Compliance</label>
        <select id="period_compliance" name="period_compliance">
            <option value="">All</option>
            <option value="self_cert_range" {% if period_compliance == "self_cert_range" %}selected{% endif %}>Self-cert range</option>
            <option value="compliant" {% if period_compliance == "compliant" %}selected{% endif %}>Compliant</option>
            <option value="exceeds_initial_max" {% if period_compliance == "exceeds_initial_max" %}selected{% endif %}>Exceeds initial max</option>
            <option value="long_term" {% if period_compliance == "long_term" %}selected{% endif %}>Long term</option>
            <option value="very_long_term" {% if period_compliance == "very_long_term" %}selected{% endif %}>Very long term</option>
        </select>
    </div>
    <div class="form-group">
        <label for="recommendation">Recommendation</label>
        <select id="recommendation" name="recommendation">
            <option value="">All</option>
            <option value="standard" {% if recommendation == "standard" %}selected{% endif %}>Standard</option>
            <option value="refer_occupational_health" {% if recommendation == "refer_occupational_health" %}selected{% endif %}>Refer Occupational Health</option>
            <option value="refer_access_to_work" {% if recommendation == "refer_access_to_work" %}selected{% endif %}>Refer Access to Work</option>
            <option value="refer_employment_advisor" {% if recommendation == "refer_employment_advisor" %}selected{% endif %}>Refer Employment Advisor</option>
            <option value="review_for_validity" {% if recommendation == "review_for_validity" %}selected{% endif %}>Review for Validity</option>
        </select>
    </div>
    <div class="form-group">
        <label for="clinician_profession">Profession</label>
        <select id="clinician_profession" name="clinician_profession">
            <option value="">All</option>
            <option value="doctor" {% if clinician_profession == "doctor" %}selected{% endif %}>Doctor</option>
            <option value="nurse" {% if clinician_profession == "nurse" %}selected{% endif %}>Nurse</option>
            <option value="occupational_therapist" {% if clinician_profession == "occupational_therapist" %}selected{% endif %}>Occupational therapist</option>
            <option value="pharmacist" {% if clinician_profession == "pharmacist" %}selected{% endif %}>Pharmacist</option>
            <option value="physiotherapist" {% if clinician_profession == "physiotherapist" %}selected{% endif %}>Physiotherapist</option>
            <option value="other" {% if clinician_profession == "other" %}selected{% endif %}>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label for="is_valid">Valid</label>
        <select id="is_valid" name="is_valid">
            <option value="">All</option>
            <option value="yes" {% if is_valid == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if is_valid == "no" %}selected{% endif %}>No</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed fit note{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Assessment Date</th>
            <th>Patient</th>
            <th>Clinician</th>
            <th>Diagnosis</th>
            <th>Fitness</th>
            <th>Period</th>
            <th>Recommendation</th>
            <th>Valid</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for f in fit_notes %}
        <tr>
            <td><a href="/assessment/{{ f.id }}/report">{{ f.assessmentDate }}</a></td>
            <td>{{ f.patientName }}<br><small>{{ f.patientNhsNumber }}</small></td>
            <td>{{ f.clinicianName }}<br><small>{{ f.clinicianProfession }}</small></td>
            <td>{{ f.diagnosisText }}<br><small>{{ f.diagnosisCategory }}</small></td>
            <td>{{ f.fitnessCategory }}{% if f.fitnessCategory == "may_be_fit" %} <small>({{ f.adaptationIntensity }})</small>{% endif %}</td>
            <td>{% if f.periodDays %}{{ f.periodDays }} d{% else %}&mdash;{% endif %}<br><small>{{ f.periodCompliance }}</small></td>
            <td>{{ f.recommendation }}</td>
            <td>
                {% if f.isValid == "yes" %}
                    <span class="badge badge-yes">Yes</span>
                {% else %}
                    <span class="badge badge-no">No</span>
                {% endif %}
            </td>
            <td>
                {% if f.highPriorityFlagCount > 0 %}
                    <span class="badge badge-no">{{ f.highPriorityFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed fit notes found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
