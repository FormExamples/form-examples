{% extends "base.html.tera" %}

{% block title %}UK Fit Note - Report{% endblock %}

{% block content %}
<div class="report-header">
    <h1>UK Statement of Fitness for Work &mdash; Report</h1>
    <div class="checklist-badge checklist-{{ grade.recommendation }}">{{ recommendation_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Fit note ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Headline grade -->
<div class="card">
    <h2>Grade</h2>
    <div class="form-row">
        <div>
            <strong>Fitness category:</strong> {{ grade.fitnessCategory | default(value="(not selected)") }}<br>
            {% if grade.fitnessCategory == "may_be_fit" %}
                <strong>Adaptation intensity:</strong> {{ grade.adaptationIntensity }} ({{ grade.adaptationCount }}/4)<br>
            {% endif %}
            <strong>Period:</strong>
                {% if grade.periodDays %}{{ grade.periodDays }} days{% else %}&mdash;{% endif %}
                ({{ grade.periodCompliance | default(value="—") }})<br>
            <strong>Within first 6 months:</strong>
                {{ grade.isWithinFirstSixMonthsOfCondition | default(value="—") }}<br>
            <strong>Valid:</strong> {{ grade.isValid }}<br>
            <strong>Recommendation:</strong> {{ grade.recommendation }}
        </div>
        <div>
            <strong>Patient:</strong> {{ data.patient.name }}<br>
            <strong>Date of Birth:</strong> {{ data.patient.birthDate }}<br>
            <strong>NHS Number:</strong> {{ data.patient.unitedKingdomNhsNumber }}<br>
            <strong>Clinician:</strong> {{ data.clinician.name }}<br>
            <strong>Profession:</strong> {{ data.clinician.profession }}<br>
            <strong>Practice:</strong> {{ data.medicalPractice.name }}
        </div>
    </div>
</div>

<!-- Fired rules -->
<div class="card">
    <h2>Fired Rules ({{ grade.firedRules | length }})</h2>
    {% if grade.firedRules | length == 0 %}
        <p>No rules fired.</p>
    {% else %}
    <table class="rules-table">
        <thead>
            <tr>
                <th>Rule ID</th>
                <th>Set</th>
                <th>Severity</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in grade.firedRules %}
            <tr>
                <td><code>{{ rule.ruleId }}</code></td>
                <td>{{ rule.ruleSet }}</td>
                <td><span class="severity-badge severity-{{ rule.severity }}">{{ rule.severity }}</span></td>
                <td>{{ rule.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>

<!-- Safety flags -->
<div class="card">
    <h2>Safety Flags ({{ grade.safetyFlags | length }})</h2>
    {% if grade.safetyFlags | length == 0 %}
        <p>No safety flags fired.</p>
    {% else %}
    <div class="flags-section">
        {% for flag in grade.safetyFlags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">[{{ flag.priority | upper }}] {{ flag.category }}</span>
            <span class="flag-message">{{ flag.description }}<br><em>&rarr; {{ flag.suggestedAction }}</em> <small>({{ flag.flagId }})</small></span>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Fit Note</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
