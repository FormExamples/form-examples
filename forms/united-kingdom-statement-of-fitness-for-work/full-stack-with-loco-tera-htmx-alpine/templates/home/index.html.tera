{% extends "base.html.tera" %}

{% block title %}UK Statement of Fitness for Work — Med 3 / Fit Note{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>UK Statement of Fitness for Work</h1>
  <p>
    A digital implementation of the UK Med 3 (fit note) issued by a
    healthcare professional to record the impact of a patient's health
    condition on their fitness for work. This implementation captures the
    fit note via a single-page, ten-step wizard, applies a rule-based
    policy-compliance grader, computes safety flags drawn from DWP policy,
    and generates a clinical report.
  </p>

  <div class="grid" style="margin:1.5rem 0;">
    <div class="fieldset">
      <h3>10 Steps</h3>
      <p>Issuer, Patient, Assessment, Diagnosis, Fitness, Adaptations, Comments, Period, Follow-up, Sign-off.</p>
    </div>
    <div class="fieldset">
      <h3>Policy compliance</h3>
      <p>Validity, adaptation, period, and safety rule sets drive a single overall recommendation.</p>
    </div>
    <div class="fieldset">
      <h3>Safety flags</h3>
      <p>Eighteen-flag catalogue covering automatic disability, mental health, safeguarding, and DWP policy 3.3 / 3.6 / 3.7.</p>
    </div>
  </div>

  <form method="POST" action="/fit-note/new">
    <button type="submit"
            style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin a new fit note
    </button>
  </form>
</div>
{% endblock %}
