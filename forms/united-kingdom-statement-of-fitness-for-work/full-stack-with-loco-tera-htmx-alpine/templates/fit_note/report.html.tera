{% extends "base.html.tera" %}

{% block title %}UK Fit Note — Report{% endblock %}

{% block content %}
<div style="max-width:920px;margin:2rem auto;padding:1rem;">
  <h1>UK Statement of Fitness for Work — Report</h1>
  <p style="color:#555;">Fit note ID: <code>{{ id }}</code></p>
  <p style="color:#555;">Generated: {{ timestamp }}</p>

  <!-- Headline grade -->
  <section class="fieldset">
    <h2>Grade</h2>
    <p>
      <strong>Fitness category:</strong> {{ result.grade.fitnessCategory | default(value="(not selected)") }}<br>
      {% if result.grade.fitnessCategory == "may_be_fit" %}
        <strong>Adaptation intensity:</strong> {{ result.grade.adaptationIntensity }} ({{ result.grade.adaptationCount }}/4)<br>
      {% endif %}
      <strong>Period:</strong>
        {% if result.grade.periodDays %}{{ result.grade.periodDays }} days{% else %}—{% endif %}
        ({{ result.grade.periodCompliance | default(value="—") }})<br>
      <strong>Within first 6 months:</strong>
        {{ result.grade.isWithinFirstSixMonthsOfCondition | default(value="—") }}<br>
      <strong>Valid:</strong> {{ result.grade.isValid }}<br>
      <strong>Recommendation:</strong> {{ result.grade.recommendation }}
    </p>
  </section>

  <!-- Fired rules -->
  <section class="fieldset">
    <h2>Fired rules</h2>
    {% if result.grade.firedRules | length == 0 %}
      <p>No rules fired.</p>
    {% else %}
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:#f5f5f5;">
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Rule ID</th>
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Set</th>
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Severity</th>
            <th style="text-align:left;padding:0.4rem;border:1px solid #ddd;">Description</th>
          </tr>
        </thead>
        <tbody>
          {% for r in result.grade.firedRules %}
            <tr>
              <td style="padding:0.4rem;border:1px solid #ddd;"><code>{{ r.ruleId }}</code></td>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ r.ruleSet }}</td>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ r.severity }}</td>
              <td style="padding:0.4rem;border:1px solid #ddd;">{{ r.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </section>

  <!-- Safety flags -->
  <section class="fieldset">
    <h2>Safety flags</h2>
    {% if result.grade.safetyFlags | length == 0 %}
      <p>No safety flags fired.</p>
    {% else %}
      <ul>
        {% for f in result.grade.safetyFlags %}
          <li style="margin-bottom:0.6rem;">
            <strong>[{{ f.priority | upper }}]</strong>
            <em>{{ f.category }}</em> — {{ f.description }}<br>
            <span style="color:#444;">→ {{ f.suggestedAction }}</span>
            <span style="color:#888;">({{ f.flagId }})</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>

  <p>
    <a href="/fit-note/{{ id }}">← Back to wizard</a>
    &nbsp;|&nbsp;
    <a href="/">Home</a>
  </p>
</div>
{% endblock %}
