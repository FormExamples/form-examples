#!/bin/sh
set -euf

form_kebab_case=wells-score-for-deep-vein-thrombosis
form_snake_case=wells_score_for_deep_vein_thrombosis

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold wells_score_for_deep_vein_thrombosis \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    status:string! \
    patient_identifier:string! \
    assessed_at:tstz \
    care_setting:string! \
    age_band:string! \
    symptomatic_leg:string! \
    active_cancer:string! \
    paralysis_or_immobilisation:string! \
    recently_bedridden_or_surgery:string! \
    localised_tenderness:string! \
    entire_leg_swollen:string! \
    calf_swelling_over_3cm:string! \
    pitting_oedema:string! \
    collateral_superficial_veins:string! \
    previously_documented_dvt:string! \
    alternative_diagnosis_as_likely:string! \
    clinical_notes:text! \
    --api

cargo loco generate scaffold wells_score_for_deep_vein_thrombosis_grade \
    deleted_at:tstz \
    wells_score_for_deep_vein_thrombosis:references \
    wells_score:int \
    two_level_band:string! \
    three_level_band:string! \
    recommended_pathway:text! \
    graded_at:tstz! \
    --api

cargo loco generate scaffold wells_score_for_deep_vein_thrombosis_grade_rule \
    deleted_at:tstz \
    wells_score_for_deep_vein_thrombosis_grade:references \
    rule_id:string! \
    instrument:string! \
    points:int! \
    band:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold wells_score_for_deep_vein_thrombosis_grade_flag \
    deleted_at:tstz \
    wells_score_for_deep_vein_thrombosis_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api
