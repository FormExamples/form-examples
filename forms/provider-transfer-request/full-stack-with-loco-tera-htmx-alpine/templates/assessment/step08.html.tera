<div class="card">
    <h2>Step 8: Transfer Logistics</h2>
    <p class="form-hint">Practical details the transport service and receiving area need.</p>

    <div class="form-group">
        <label for="transfer_logistics_transport_mode">Transport mode</label>
        <select id="transfer_logistics_transport_mode" name="transfer_logistics.transport_mode">
            <option value="" {% if transfer_logistics.transportMode == "" %}selected{% endif %}>&mdash;</option>
            <option value="self" {% if transfer_logistics.transportMode == "self" %}selected{% endif %}>Self / walking</option>
            <option value="wheelchair" {% if transfer_logistics.transportMode == "wheelchair" %}selected{% endif %}>Wheelchair</option>
            <option value="stretcher" {% if transfer_logistics.transportMode == "stretcher" %}selected{% endif %}>Stretcher</option>
            <option value="ambulance" {% if transfer_logistics.transportMode == "ambulance" %}selected{% endif %}>Ambulance</option>
            <option value="critical-care-transport" {% if transfer_logistics.transportMode == "critical-care-transport" %}selected{% endif %}>Critical care transport</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="transfer_logistics_departure_date_time">Planned departure date / time</label>
            <input type="datetime-local" id="transfer_logistics_departure_date_time" name="transfer_logistics.departure_date_time"
                   value="{{ transfer_logistics.departureDateTime }}">
        </div>
        <div class="form-group">
            <label for="transfer_logistics_estimated_arrival_date_time">Estimated arrival date / time</label>
            <input type="datetime-local" id="transfer_logistics_estimated_arrival_date_time" name="transfer_logistics.estimated_arrival_date_time"
                   value="{{ transfer_logistics.estimatedArrivalDateTime }}">
        </div>
    </div>

    <h3>Transport requirements</h3>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_escort_required" name="transfer_logistics.escort_required" value="on"
                   {% if transfer_logistics.escortRequired %}checked{% endif %}>
            <span>Clinical escort required</span>
        </label>
    </div>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_oxygen_required" name="transfer_logistics.oxygen_required" value="on"
                   {% if transfer_logistics.oxygenRequired %}checked{% endif %}>
            <span>Supplemental oxygen required</span>
        </label>
    </div>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_cardiac_monitoring_required" name="transfer_logistics.cardiac_monitoring_required" value="on"
                   {% if transfer_logistics.cardiacMonitoringRequired %}checked{% endif %}>
            <span>Cardiac monitoring required</span>
        </label>
    </div>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_infectious_precautions" name="transfer_logistics.infectious_precautions" value="on"
                   {% if transfer_logistics.infectiousPrecautions %}checked{% endif %}>
            <span>Infectious precautions required</span>
        </label>
    </div>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_falls_risk" name="transfer_logistics.falls_risk" value="on"
                   {% if transfer_logistics.fallsRisk %}checked{% endif %}>
            <span>Falls risk</span>
        </label>
    </div>
    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="transfer_logistics_mental_capacity_concerns" name="transfer_logistics.mental_capacity_concerns" value="on"
                   {% if transfer_logistics.mentalCapacityConcerns %}checked{% endif %}>
            <span>Mental Capacity Act / safeguarding concerns</span>
        </label>
    </div>

    <div class="form-group">
        <label for="transfer_logistics_escort_details">Escort details</label>
        <textarea id="transfer_logistics_escort_details" name="transfer_logistics.escort_details"
                  placeholder="Required when escort is requested. Who is escorting, qualifications, equipment.">{{ transfer_logistics.escortDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="transfer_logistics_infectious_precautions_details">Infectious-precaution details</label>
        <textarea id="transfer_logistics_infectious_precautions_details" name="transfer_logistics.infectious_precautions_details"
                  placeholder="Required when infectious precautions are flagged. e.g. droplet precautions for influenza A.">{{ transfer_logistics.infectiousPrecautionsDetails }}</textarea>
    </div>

    <div class="form-group">
        <label for="transfer_logistics_equipment_required">Equipment / lines / drains accompanying patient</label>
        <textarea id="transfer_logistics_equipment_required" name="transfer_logistics.equipment_required"
                  placeholder="e.g. peripheral IV (right ACF), urinary catheter, NG tube on free drainage.">{{ transfer_logistics.equipmentRequired }}</textarea>
    </div>
</div>
