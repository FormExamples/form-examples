<div class="card">
    <h2>Step 7: Recommendation (R) &mdash; Requested Action</h2>
    <p class="form-hint">Be specific about what you are asking the receiving provider to do.</p>

    <div class="form-group">
        <label for="recommendation_requested_action">Requested action</label>
        <textarea id="recommendation_requested_action" name="recommendation.requested_action"
                  placeholder="e.g. Accept for HDU monitoring; review by gastroenterology within 4 hours.">{{ recommendation.requestedAction }}</textarea>
    </div>

    <div class="form-group">
        <label for="recommendation_expected_outcomes">Expected outcomes / goals of transfer</label>
        <textarea id="recommendation_expected_outcomes" name="recommendation.expected_outcomes">{{ recommendation.expectedOutcomes }}</textarea>
    </div>

    <div class="form-group">
        <label for="recommendation_ongoing_care_plan">Ongoing care plan</label>
        <textarea id="recommendation_ongoing_care_plan" name="recommendation.ongoing_care_plan"
                  placeholder="Treatments to continue, reviews booked, escalation plan.">{{ recommendation.ongoingCarePlan }}</textarea>
    </div>

    <div class="form-group">
        <label for="recommendation_pending_results">Pending results / follow-up</label>
        <textarea id="recommendation_pending_results" name="recommendation.pending_results"
                  placeholder="Tests booked, samples sent, results outstanding and how to chase them.">{{ recommendation.pendingResults }}</textarea>
    </div>
</div>
