<div class="card">
    <h2>Step 2: Receiving Provider Details</h2>
    <p class="form-hint">The clinician or service being asked to take over care. Confirm acceptance before the patient leaves.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="receiving_provider_clinician_name">Clinician name</label>
            <input type="text" id="receiving_provider_clinician_name" name="receiving_provider.clinician_name"
                   value="{{ receiving_provider.clinicianName }}">
        </div>
        <div class="form-group">
            <label for="receiving_provider_clinician_role">Role / job title</label>
            <input type="text" id="receiving_provider_clinician_role" name="receiving_provider.clinician_role"
                   value="{{ receiving_provider.clinicianRole }}" placeholder="e.g. Consultant, Bed Manager">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="receiving_provider_organisation">Organisation</label>
            <input type="text" id="receiving_provider_organisation" name="receiving_provider.organisation"
                   value="{{ receiving_provider.organisation }}">
        </div>
        <div class="form-group">
            <label for="receiving_provider_ward">Ward / unit</label>
            <input type="text" id="receiving_provider_ward" name="receiving_provider.ward"
                   value="{{ receiving_provider.ward }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="receiving_provider_phone">Phone</label>
            <input type="tel" id="receiving_provider_phone" name="receiving_provider.phone"
                   value="{{ receiving_provider.phone }}">
        </div>
        <div class="form-group">
            <label for="receiving_provider_email">Email</label>
            <input type="email" id="receiving_provider_email" name="receiving_provider.email"
                   value="{{ receiving_provider.email }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="receiving_provider_registration_body">Registration body</label>
            <select id="receiving_provider_registration_body" name="receiving_provider.registration_body">
                <option value="" {% if receiving_provider.registrationBody == "" %}selected{% endif %}>&mdash;</option>
                <option value="GMC" {% if receiving_provider.registrationBody == "GMC" %}selected{% endif %}>GMC</option>
                <option value="NMC" {% if receiving_provider.registrationBody == "NMC" %}selected{% endif %}>NMC</option>
                <option value="HCPC" {% if receiving_provider.registrationBody == "HCPC" %}selected{% endif %}>HCPC</option>
                <option value="GPhC" {% if receiving_provider.registrationBody == "GPhC" %}selected{% endif %}>GPhC</option>
                <option value="other" {% if receiving_provider.registrationBody == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="receiving_provider_registration_number">Registration number</label>
            <input type="text" id="receiving_provider_registration_number" name="receiving_provider.registration_number"
                   value="{{ receiving_provider.registrationNumber }}">
        </div>
    </div>
</div>
