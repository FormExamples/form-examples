<div class="card">
    <h2>Step 9: Sign-off &amp; Acknowledgement</h2>
    <p class="form-hint">
        Requesting provider signs the handover; receiving provider acknowledges
        acceptance on arrival. The receiving-side rules only fire once any
        acknowledgement field is filled in (two-party gating).
    </p>

    <h3>Requesting provider sign-off</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="signoff_requesting_provider_signature">Signature (typed full name)</label>
            <input type="text" id="signoff_requesting_provider_signature" name="signoff_acknowledgement.requesting_provider_signature"
                   value="{{ signoff_acknowledgement.requestingProviderSignature }}">
        </div>
        <div class="form-group">
            <label for="signoff_requesting_provider_signature_date">Signature date</label>
            <input type="date" id="signoff_requesting_provider_signature_date" name="signoff_acknowledgement.requesting_provider_signature_date"
                   value="{{ signoff_acknowledgement.requestingProviderSignatureDate }}">
        </div>
    </div>

    <h3>Receiving provider acknowledgement</h3>
    <div class="form-group">
        <label for="signoff_receiving_provider_name">Receiving provider name</label>
        <input type="text" id="signoff_receiving_provider_name" name="signoff_acknowledgement.receiving_provider_name"
               value="{{ signoff_acknowledgement.receivingProviderName }}">
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="signoff_receiving_provider_signature">Receiving provider signature (typed full name)</label>
            <input type="text" id="signoff_receiving_provider_signature" name="signoff_acknowledgement.receiving_provider_signature"
                   value="{{ signoff_acknowledgement.receivingProviderSignature }}">
        </div>
        <div class="form-group">
            <label for="signoff_receiving_provider_signature_date">Signature date</label>
            <input type="date" id="signoff_receiving_provider_signature_date" name="signoff_acknowledgement.receiving_provider_signature_date"
                   value="{{ signoff_acknowledgement.receivingProviderSignatureDate }}">
        </div>
    </div>

    <div class="form-group">
        <label class="checkbox-field">
            <input type="checkbox" id="signoff_acknowledgement_received" name="signoff_acknowledgement.acknowledgement_received" value="on"
                   {% if signoff_acknowledgement.acknowledgementReceived %}checked{% endif %}>
            <span>Acknowledgement received and care accepted</span>
        </label>
    </div>

    <div class="form-group">
        <label for="signoff_acknowledgement_notes">Acknowledgement notes</label>
        <textarea id="signoff_acknowledgement_notes" name="signoff_acknowledgement.acknowledgement_notes"
                  placeholder="Any caveats noted by the receiving provider on acceptance.">{{ signoff_acknowledgement.acknowledgementNotes }}</textarea>
    </div>
</div>
