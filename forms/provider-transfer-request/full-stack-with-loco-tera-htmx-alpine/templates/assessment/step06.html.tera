<div class="card">
    <h2>Step 6: Assessment (A) &mdash; Current Clinical Status</h2>
    <p class="form-hint">Summary of how the patient is now and the latest set of vital signs.</p>

    <div class="form-group">
        <label for="assessment_current_clinical_status">Current clinical status</label>
        <textarea id="assessment_current_clinical_status" name="assessment.current_clinical_status">{{ assessment.currentClinicalStatus }}</textarea>
    </div>

    <div class="form-group">
        <label for="assessment_conscious_level">Conscious level</label>
        <select id="assessment_conscious_level" name="assessment.conscious_level">
            <option value="" {% if assessment.consciousLevel == "" %}selected{% endif %}>&mdash;</option>
            <option value="awake" {% if assessment.consciousLevel == "awake" %}selected{% endif %}>Awake / alert</option>
            <option value="drowsy" {% if assessment.consciousLevel == "drowsy" %}selected{% endif %}>Drowsy</option>
            <option value="unresponsive" {% if assessment.consciousLevel == "unresponsive" %}selected{% endif %}>Unresponsive</option>
        </select>
    </div>

    <h3>Vital signs</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="assessment_vital_signs_heart_rate">Heart rate (bpm)</label>
            <input type="number" min="0" max="300" step="1" id="assessment_vital_signs_heart_rate" name="assessment.vital_signs.heart_rate"
                   value="{{ assessment.vitalSigns.heartRate }}">
        </div>
        <div class="form-group">
            <label for="assessment_vital_signs_respiratory_rate">Respiratory rate (/min)</label>
            <input type="number" min="0" max="80" step="1" id="assessment_vital_signs_respiratory_rate" name="assessment.vital_signs.respiratory_rate"
                   value="{{ assessment.vitalSigns.respiratoryRate }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="assessment_vital_signs_systolic_blood_pressure">Systolic BP (mmHg)</label>
            <input type="number" min="0" max="300" step="1" id="assessment_vital_signs_systolic_blood_pressure" name="assessment.vital_signs.systolic_blood_pressure"
                   value="{{ assessment.vitalSigns.systolicBloodPressure }}">
        </div>
        <div class="form-group">
            <label for="assessment_vital_signs_diastolic_blood_pressure">Diastolic BP (mmHg)</label>
            <input type="number" min="0" max="200" step="1" id="assessment_vital_signs_diastolic_blood_pressure" name="assessment.vital_signs.diastolic_blood_pressure"
                   value="{{ assessment.vitalSigns.diastolicBloodPressure }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="assessment_vital_signs_temperature_celsius">Temperature (&deg;C)</label>
            <input type="number" min="25" max="45" step="0.1" id="assessment_vital_signs_temperature_celsius" name="assessment.vital_signs.temperature_celsius"
                   value="{{ assessment.vitalSigns.temperatureCelsius }}">
        </div>
        <div class="form-group">
            <label for="assessment_vital_signs_oxygen_saturation">Oxygen saturation (%)</label>
            <input type="number" min="0" max="100" step="1" id="assessment_vital_signs_oxygen_saturation" name="assessment.vital_signs.oxygen_saturation"
                   value="{{ assessment.vitalSigns.oxygenSaturation }}">
        </div>
        <div class="form-group">
            <label for="assessment_vital_signs_news_score">NEWS2 score</label>
            <input type="number" min="0" max="20" step="1" id="assessment_vital_signs_news_score" name="assessment.vital_signs.news_score"
                   value="{{ assessment.vitalSigns.newsScore }}">
        </div>
    </div>

    <div class="form-group">
        <label for="assessment_clinically_stable">Clinically stable for transfer?</label>
        <select id="assessment_clinically_stable" name="assessment.clinically_stable">
            <option value="" {% if assessment.clinicallyStable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if assessment.clinicallyStable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if assessment.clinicallyStable == "no" %}selected{% endif %}>No</option>
            <option value="unknown" {% if assessment.clinicallyStable == "unknown" %}selected{% endif %}>Unknown</option>
        </select>
    </div>

    <div class="form-group">
        <label for="assessment_stability_notes">Stability notes / concerns</label>
        <textarea id="assessment_stability_notes" name="assessment.stability_notes"
                  placeholder="Required when patient is not clinically stable. Describe instability and what is being done about it.">{{ assessment.stabilityNotes }}</textarea>
    </div>
</div>
