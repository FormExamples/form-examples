<div class="card">
    <h2>Step 5: Background (B) &mdash; Relevant History</h2>
    <p class="form-hint">Concise background needed for the receiving team to take over safely.</p>

    <div class="form-group">
        <label for="background_presenting_complaint">Presenting complaint</label>
        <textarea id="background_presenting_complaint" name="background.presenting_complaint">{{ background.presentingComplaint }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_relevant_history">Relevant history of current admission</label>
        <textarea id="background_relevant_history" name="background.relevant_history">{{ background.relevantHistory }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_past_medical_history">Past medical / surgical history</label>
        <textarea id="background_past_medical_history" name="background.past_medical_history">{{ background.pastMedicalHistory }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_current_medications">Current medications</label>
        <textarea id="background_current_medications" name="background.current_medications"
                  placeholder="List each drug, dose, route, frequency.">{{ background.currentMedications }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_allergies">Allergies / adverse reactions</label>
        <textarea id="background_allergies" name="background.allergies"
                  placeholder='Document explicitly. Record "NKDA" if no known drug allergies.'>{{ background.allergies }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_recent_investigations">Recent investigations / results</label>
        <textarea id="background_recent_investigations" name="background.recent_investigations"
                  placeholder="e.g. bloods, imaging, microbiology, ECG.">{{ background.recentInvestigations }}</textarea>
    </div>

    <div class="form-group">
        <label for="background_infection_status">Infection / colonisation status</label>
        <textarea id="background_infection_status" name="background.infection_status"
                  placeholder="e.g. MRSA negative on screening, COVID-19 swab pending, none known.">{{ background.infectionStatus }}</textarea>
    </div>
</div>
