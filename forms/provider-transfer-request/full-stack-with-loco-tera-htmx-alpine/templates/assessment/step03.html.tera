<div class="card">
    <h2>Step 3: Patient Demographics</h2>
    <p class="form-hint">Confirm the patient identity at handover. NHS number is preferred where available.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_demographics_first_name">First name</label>
            <input type="text" id="patient_demographics_first_name" name="patient_demographics.first_name"
                   value="{{ patient_demographics.firstName }}">
        </div>
        <div class="form-group">
            <label for="patient_demographics_last_name">Last name</label>
            <input type="text" id="patient_demographics_last_name" name="patient_demographics.last_name"
                   value="{{ patient_demographics.lastName }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_demographics_date_of_birth">Date of birth</label>
            <input type="date" id="patient_demographics_date_of_birth" name="patient_demographics.date_of_birth"
                   value="{{ patient_demographics.dateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="patient_demographics_sex">Sex</label>
            <select id="patient_demographics_sex" name="patient_demographics.sex">
                <option value="" {% if patient_demographics.sex == "" %}selected{% endif %}>&mdash;</option>
                <option value="male" {% if patient_demographics.sex == "male" %}selected{% endif %}>Male</option>
                <option value="female" {% if patient_demographics.sex == "female" %}selected{% endif %}>Female</option>
                <option value="other" {% if patient_demographics.sex == "other" %}selected{% endif %}>Other</option>
                <option value="unknown" {% if patient_demographics.sex == "unknown" %}selected{% endif %}>Unknown</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_demographics_nhs_number">NHS number</label>
            <input type="text" id="patient_demographics_nhs_number" name="patient_demographics.nhs_number"
                   value="{{ patient_demographics.nhsNumber }}" placeholder="10 digits, e.g. 123 456 7890">
        </div>
        <div class="form-group">
            <label for="patient_demographics_hospital_number">Hospital / local number</label>
            <input type="text" id="patient_demographics_hospital_number" name="patient_demographics.hospital_number"
                   value="{{ patient_demographics.hospitalNumber }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_demographics_address_line">Address line</label>
            <input type="text" id="patient_demographics_address_line" name="patient_demographics.address_line"
                   value="{{ patient_demographics.addressLine }}">
        </div>
        <div class="form-group">
            <label for="patient_demographics_postcode">Postcode</label>
            <input type="text" id="patient_demographics_postcode" name="patient_demographics.postcode"
                   value="{{ patient_demographics.postcode }}">
        </div>
    </div>

    <h3>Next of kin</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="patient_demographics_next_of_kin_name">Next of kin name</label>
            <input type="text" id="patient_demographics_next_of_kin_name" name="patient_demographics.next_of_kin_name"
                   value="{{ patient_demographics.nextOfKinName }}">
        </div>
        <div class="form-group">
            <label for="patient_demographics_next_of_kin_phone">Next of kin phone</label>
            <input type="tel" id="patient_demographics_next_of_kin_phone" name="patient_demographics.next_of_kin_phone"
                   value="{{ patient_demographics.nextOfKinPhone }}">
        </div>
    </div>
</div>
