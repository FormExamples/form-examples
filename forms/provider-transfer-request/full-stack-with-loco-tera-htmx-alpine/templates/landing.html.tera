{% extends "base.html.tera" %}

{% block title %}Provider Transfer Request - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Provider Transfer Request</h1>
        <p class="landing-description">
            Inter-provider handover for transferring a patient's care between
            clinicians, wards, or organisations. Structured around the
            <strong>SBAR</strong> framework
            (<strong>S</strong>ituation, <strong>B</strong>ackground,
            <strong>A</strong>ssessment, <strong>R</strong>ecommendation) plus
            the practical transfer logistics the receiving team needs at the
            bedside.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>SBAR Sections</h3>
                <p>Steps 1&ndash;8 capture the requesting and receiving providers, patient demographics, and the SBAR clinical narrative</p>
            </div>
            <div class="feature">
                <h3>Two-party Sign-off</h3>
                <p>Step 9 records the requesting provider's signature; the receiving-provider acknowledgement is gated until any acknowledgement field is touched</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Real-time alerts for clinical instability, abnormal vitals, infectious precautions, escort/oxygen requirements, and safeguarding concerns</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Transfer Request
            </button>
        </form>
    </div>
</div>
{% endblock %}
