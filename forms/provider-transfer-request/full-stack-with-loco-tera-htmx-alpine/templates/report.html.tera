{% extends "base.html.tera" %}

{% block title %}Transfer Report - {{ completeness_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>Provider Transfer Request &mdash; Submission Report</h1>
    <div class="checklist-badge checklist-{{ validation.completeness }}">{{ completeness_label }}</div>
    <div class="checklist-label">
        {{ validation.totalSatisfied }} of {{ validation.totalRequired }} fields answered;
        {{ validation.mandatorySatisfied }} of {{ validation.mandatoryRequired }} mandatory.
    </div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Case ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Patient + clinicians -->
<div class="card">
    <h2>Handover Summary</h2>
    <div class="form-row">
        <div>
            <strong>Patient:</strong> {{ data.patientDemographics.firstName }} {{ data.patientDemographics.lastName }}<br>
            <strong>Date of birth:</strong> {{ data.patientDemographics.dateOfBirth }}<br>
            <strong>NHS number:</strong> {{ data.patientDemographics.nhsNumber }}<br>
            <strong>Hospital number:</strong> {{ data.patientDemographics.hospitalNumber }}<br>
            <strong>Sex:</strong> {{ data.patientDemographics.sex }}
        </div>
        <div>
            <strong>Primary diagnosis:</strong> {{ data.situation.primaryDiagnosis }}<br>
            <strong>Urgency:</strong> {{ data.situation.urgency }}<br>
            <strong>Transfer type:</strong> {{ data.situation.transferType }}<br>
            <strong>Requested:</strong> {{ data.situation.requestedDateTime }}<br>
            <strong>Transport mode:</strong> {{ data.transferLogistics.transportMode }}
        </div>
    </div>
    <div class="form-row" style="margin-top: 1rem;">
        <div>
            <strong>Requesting:</strong> {{ data.requestingProvider.clinicianName }} ({{ data.requestingProvider.clinicianRole }})<br>
            <strong>Organisation:</strong> {{ data.requestingProvider.organisation }}<br>
            <strong>Ward:</strong> {{ data.requestingProvider.ward }}<br>
            <strong>Phone:</strong> {{ data.requestingProvider.phone }}
        </div>
        <div>
            <strong>Receiving:</strong> {{ data.receivingProvider.clinicianName }} ({{ data.receivingProvider.clinicianRole }})<br>
            <strong>Organisation:</strong> {{ data.receivingProvider.organisation }}<br>
            <strong>Ward:</strong> {{ data.receivingProvider.ward }}<br>
            <strong>Phone:</strong> {{ data.receivingProvider.phone }}
        </div>
    </div>
</div>

<!-- Per-section completeness -->
<div class="card">
    <h2>Section Completeness</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Section</th>
                <th>Answered</th>
                <th>Mandatory</th>
                <th>Missing items</th>
            </tr>
        </thead>
        <tbody>
            {% for section in validation.sections %}
            <tr>
                <td>
                    {% for pair in section_labels %}{% if pair.0 == section.section %}{{ pair.1 }}{% endif %}{% endfor %}
                </td>
                <td>{{ section.satisfied }} / {{ section.required }}</td>
                <td>{{ section.mandatorySatisfied }} / {{ section.mandatoryRequired }}</td>
                <td>
                    {% if section.missing | length == 0 %}
                        <span class="badge badge-yes">all completed</span>
                    {% else %}
                        <ul class="missing-list">
                            {% for m in section.missing %}
                            <li><code>{{ m.id }}</code> &mdash; {{ m.description }}{% if m.mandatory %} <strong>(mandatory)</strong>{% endif %}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Flagged issues -->
{% if flags | length > 0 %}
<div class="card">
    <h2>Flagged Issues ({{ flags | length }})</h2>
    <div class="flags-section">
        {% for flag in flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-priority">{{ flag.priority | upper }}</span>
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Transfer Request</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
