#!/bin/sh
set -euf

form_kebab_case=child-safeguarding-referral
form_snake_case=child_safeguarding_referral

createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_development" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_test" || :
createdb --host=localhost --port=5432 --username=loco --owner=loco "${form_snake_case}_production" || :

loco new --name "${form_snake_case}" --db postgres --bg async --assets none -a
cd "${form_snake_case}"

# Pin time to a version compatible with cookie 0.18.1 (a fresh loco
# starter otherwise resolves time 0.3.52, which fails to compile).
cargo update -p time --precise 0.3.47

cargo loco generate scaffold patient \
    deleted_at:tstz \
    name:string! \
    birth_date:date! \
    sex:string! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    hospital_mrn:string \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    allergies_summary:text! \
    --api

cargo loco generate scaffold clinician \
    deleted_at:tstz \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:string! \
    registration_body:string! \
    registration_number:text! \
    --api

cargo loco generate scaffold child_safeguarding_referral \
    deleted_at:tstz \
    patient:references \
    clinician:references \
    referrer_organisation:text! \
    referred_at:tstz \
    relationship_to_child:text! \
    child_age:double \
    child_setting:text! \
    child_reference:text! \
    child_ethnicity:text! \
    child_first_language:text! \
    child_disability:text! \
    carers:text! \
    household_members:text! \
    other_children:text! \
    professionals_involved:text! \
    concern_description:text! \
    concern_onset:text! \
    child_disclosed:string! \
    referrer_observations:text! \
    primary_category:string! \
    additional_categories:text! \
    presenting_evidence:text! \
    immediate_danger:string! \
    child_whereabouts:text! \
    who_with_child:text! \
    alleged_person_in_contact:string! \
    other_children_at_risk:string! \
    consent_sought:string! \
    consent_status:string! \
    sharing_basis_without_consent:string! \
    family_aware:string! \
    unsafe_to_inform_reason:text! \
    agencies_contacted:text! \
    strategy_discussion_held:string! \
    previous_safeguarding_history:text! \
    requested_action:text! \
    referrer_declaration:string! \
    notes:text! \
    --api

cargo loco generate scaffold child_safeguarding_referral_grade \
    deleted_at:tstz \
    child_safeguarding_referral:references \
    status:string! \
    urgency:string! \
    completeness_percent:int \
    graded_at:tstz! \
    --api

cargo loco generate scaffold child_safeguarding_referral_grade_rule \
    deleted_at:tstz \
    child_safeguarding_referral_grade:references \
    rule_id:string! \
    section:string! \
    category:string! \
    description:string! \
    --api

cargo loco generate scaffold child_safeguarding_referral_grade_flag \
    deleted_at:tstz \
    child_safeguarding_referral_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

# Convert the freshly-scaffolded nested crate into the canonical route
# layout: back-end-with-loco/src/${form_snake_case}/*.rs
cd ..
"$(git rev-parse --show-toplevel)/bin/route-loco-layout" "${form_kebab_case}"
