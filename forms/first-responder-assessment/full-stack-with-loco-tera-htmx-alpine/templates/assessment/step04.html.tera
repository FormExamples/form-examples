                <option value="not-competent" {% if clinical_skills.ivCannulation == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.ivCannulation == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.ivCannulation == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.ivCannulation == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="drug_administration">Drug Administration</label>
            <select id="drug_administration" name="clinical_skills.drug_administration">
                <option value="" {% if clinical_skills.drugAdministration == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.drugAdministration == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.drugAdministration == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.drugAdministration == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.drugAdministration == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
