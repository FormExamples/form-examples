                <option value="competent" {% if clinical_skills.triageCompetency == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.triageCompetency == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="paediatric_competency">Paediatric</label>
            <select id="paediatric_competency" name="clinical_skills.paediatric_competency">
                <option value="" {% if clinical_skills.paediatricCompetency == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.paediatricCompetency == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.paediatricCompetency == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.paediatricCompetency == "competent" %}selected{% endif %}>Competent</option>
