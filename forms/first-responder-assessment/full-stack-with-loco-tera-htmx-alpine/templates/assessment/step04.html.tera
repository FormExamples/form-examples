        </div>
        <div class="form-group">
            <label for="ecg_interpretation">ECG Interpretation</label>
            <select id="ecg_interpretation" name="clinical_skills.ecg_interpretation">
                <option value="" {% if clinical_skills.ecgInterpretation == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.ecgInterpretation == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.ecgInterpretation == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.ecgInterpretation == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.ecgInterpretation == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="patient_assessment">Patient Assessment (ABCDE)</label>
            <select id="patient_assessment" name="clinical_skills.patient_assessment">
                <option value="" {% if clinical_skills.patientAssessment == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.patientAssessment == "not-competent" %}selected{% endif %}>Not Competent</option>
