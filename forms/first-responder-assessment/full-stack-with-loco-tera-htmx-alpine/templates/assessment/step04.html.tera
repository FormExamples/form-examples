                <option value="not-competent" {% if clinical_skills.traumaAssessment == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.traumaAssessment == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.traumaAssessment == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.traumaAssessment == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
