<div class="card">
    <h2>Step 4: Clinical Skills Competency</h2>
    <p class="form-hint">Core clinical competencies including BLS, ALS, airway management, assessment, triage.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="basic_life_support">Basic Life Support</label>
            <select id="basic_life_support" name="clinical_skills.basic_life_support">
                <option value="" {% if clinical_skills.basicLifeSupport == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.basicLifeSupport == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.basicLifeSupport == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.basicLifeSupport == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.basicLifeSupport == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="advanced_life_support">Advanced Life Support</label>
            <select id="advanced_life_support" name="clinical_skills.advanced_life_support">
                <option value="" {% if clinical_skills.advancedLifeSupport == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.advancedLifeSupport == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.advancedLifeSupport == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.advancedLifeSupport == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.advancedLifeSupport == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="airway_management">Airway Management</label>
            <select id="airway_management" name="clinical_skills.airway_management">
                <option value="" {% if clinical_skills.airwayManagement == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.airwayManagement == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.airwayManagement == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.airwayManagement == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.airwayManagement == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="iv_cannulation">IV Cannulation</label>
