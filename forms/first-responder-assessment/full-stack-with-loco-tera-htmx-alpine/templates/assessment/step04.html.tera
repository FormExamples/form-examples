                <option value="competent" {% if clinical_skills.immobilisationSplinting == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if clinical_skills.immobilisationSplinting == "expert" %}selected{% endif %}>Expert</option>
