    <div class="form-group">
        <label for="clinical_skills_notes">Notes</label>
        <textarea id="clinical_skills_notes" name="clinical_skills.clinical_skills_notes">{{ clinical_skills.clinicalSkillsNotes }}</textarea>
    </div>
</div>
