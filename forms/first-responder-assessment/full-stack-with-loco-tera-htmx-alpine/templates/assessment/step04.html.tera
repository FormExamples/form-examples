        </div>
        <div class="form-group">
            <label for="obstetric_competency">Obstetric</label>
            <select id="obstetric_competency" name="clinical_skills.obstetric_competency">
                <option value="" {% if clinical_skills.obstetricCompetency == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if clinical_skills.obstetricCompetency == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if clinical_skills.obstetricCompetency == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if clinical_skills.obstetricCompetency == "competent" %}selected{% endif %}>Competent</option>
