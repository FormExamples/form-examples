<div class="card">
    <h2>Step 6: Communication Skills</h2>
    <p class="form-hint">Patient, relative, handover, documentation, teamwork, safeguarding.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_communication">Patient Communication</label>
            <select id="patient_communication" name="communication_skills.patient_communication">
                <option value="" {% if communication_skills.patientCommunication == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.patientCommunication == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.patientCommunication == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.patientCommunication == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.patientCommunication == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="relative_communication">Relative Communication</label>
            <select id="relative_communication" name="communication_skills.relative_communication">
                <option value="" {% if communication_skills.relativeCommunication == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.relativeCommunication == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.relativeCommunication == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.relativeCommunication == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.relativeCommunication == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="handover_competency">Handover</label>
            <select id="handover_competency" name="communication_skills.handover_competency">
                <option value="" {% if communication_skills.handoverCompetency == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.handoverCompetency == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.handoverCompetency == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.handoverCompetency == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.handoverCompetency == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="documentation_competency">Documentation</label>
            <select id="documentation_competency" name="communication_skills.documentation_competency">
                <option value="" {% if communication_skills.documentationCompetency == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.documentationCompetency == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.documentationCompetency == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.documentationCompetency == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.documentationCompetency == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="multidisciplinary_teamwork">Multidisciplinary Teamwork</label>
            <select id="multidisciplinary_teamwork" name="communication_skills.multidisciplinary_teamwork">
                <option value="" {% if communication_skills.multidisciplinaryTeamwork == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.multidisciplinaryTeamwork == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.multidisciplinaryTeamwork == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.multidisciplinaryTeamwork == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.multidisciplinaryTeamwork == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="conflict_resolution">Conflict Resolution</label>
            <select id="conflict_resolution" name="communication_skills.conflict_resolution">
                <option value="" {% if communication_skills.conflictResolution == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.conflictResolution == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.conflictResolution == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.conflictResolution == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.conflictResolution == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="safeguarding_awareness">Safeguarding Awareness</label>
            <select id="safeguarding_awareness" name="communication_skills.safeguarding_awareness">
                <option value="" {% if communication_skills.safeguardingAwareness == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.safeguardingAwareness == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.safeguardingAwareness == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.safeguardingAwareness == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.safeguardingAwareness == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="breaking_bad_news">Breaking Bad News</label>
            <select id="breaking_bad_news" name="communication_skills.breaking_bad_news">
                <option value="" {% if communication_skills.breakingBadNews == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if communication_skills.breakingBadNews == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if communication_skills.breakingBadNews == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if communication_skills.breakingBadNews == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if communication_skills.breakingBadNews == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="communication_notes">Notes</label>
        <textarea id="communication_notes" name="communication_skills.communication_notes">{{ communication_skills.communicationNotes }}</textarea>
    </div>
</div>
