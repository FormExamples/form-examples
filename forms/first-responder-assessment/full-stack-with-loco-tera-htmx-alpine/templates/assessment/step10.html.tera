<div class="card">
    <h2>Step 10: Overall Fitness Decision</h2>
    <p class="form-hint">Assessor sign-off and overall fitness decision.</p>

    <div class="form-group">
        <label for="overall_fitness">Overall Fitness Decision</label>
        <select id="overall_fitness" name="fitness_decision.overall_fitness">
            <option value="" {% if fitness_decision.overallFitness == "" %}selected{% endif %}>&mdash; auto-derive from rules</option>
            <option value="fit-for-duty" {% if fitness_decision.overallFitness == "fit-for-duty" %}selected{% endif %}>Fit for Duty</option>
            <option value="fit-with-restrictions" {% if fitness_decision.overallFitness == "fit-with-restrictions" %}selected{% endif %}>Fit with Restrictions</option>
            <option value="temporarily-unfit" {% if fitness_decision.overallFitness == "temporarily-unfit" %}selected{% endif %}>Temporarily Unfit</option>
            <option value="permanently-unfit" {% if fitness_decision.overallFitness == "permanently-unfit" %}selected{% endif %}>Permanently Unfit</option>
        </select>
    </div>

    <div class="form-group">
        <label for="restrictions_details">Restrictions Details</label>
        <textarea id="restrictions_details" name="fitness_decision.restrictions_details">{{ fitness_decision.restrictionsDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="reassessment_required">Reassessment Required?</label>
            <select id="reassessment_required" name="fitness_decision.reassessment_required">
                <option value="" {% if fitness_decision.reassessmentRequired == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if fitness_decision.reassessmentRequired == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if fitness_decision.reassessmentRequired == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reassessment_date">Reassessment Date</label>
            <input type="date" id="reassessment_date" name="fitness_decision.reassessment_date"
                   value="{{ fitness_decision.reassessmentDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="remedial_actions">Remedial Actions</label>
        <textarea id="remedial_actions" name="fitness_decision.remedial_actions">{{ fitness_decision.remedialActions }}</textarea>
    </div>
    <div class="form-group">
        <label for="referrals_required">Referrals Required</label>
        <textarea id="referrals_required" name="fitness_decision.referrals_required">{{ fitness_decision.referralsRequired }}</textarea>
    </div>

    <h3>Assessor Sign-off</h3>
    <div class="form-row">
        <div class="form-group">
            <label for="assessor_name">Assessor Name</label>
            <input type="text" id="assessor_name" name="fitness_decision.assessor_name"
                   value="{{ fitness_decision.assessorName }}">
        </div>
        <div class="form-group">
            <label for="assessor_role">Assessor Role</label>
            <input type="text" id="assessor_role" name="fitness_decision.assessor_role"
                   value="{{ fitness_decision.assessorRole }}">
        </div>
        <div class="form-group">
            <label for="assessor_registration">Assessor Registration</label>
            <input type="text" id="assessor_registration" name="fitness_decision.assessor_registration"
                   value="{{ fitness_decision.assessorRegistration }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="assessment_date">Assessment Date</label>
            <input type="date" id="assessment_date" name="fitness_decision.assessment_date"
                   value="{{ fitness_decision.assessmentDate }}">
        </div>
        <div class="form-group">
            <label for="countersignature_name">Countersignature Name</label>
            <input type="text" id="countersignature_name" name="fitness_decision.countersignature_name"
                   value="{{ fitness_decision.countersignatureName }}">
        </div>
        <div class="form-group">
            <label for="countersignature_date">Countersignature Date</label>
            <input type="date" id="countersignature_date" name="fitness_decision.countersignature_date"
                   value="{{ fitness_decision.countersignatureDate }}">
        </div>
    </div>

    <div class="form-group">
        <label for="fitness_decision_notes">Notes</label>
        <textarea id="fitness_decision_notes" name="fitness_decision.fitness_decision_notes">{{ fitness_decision.fitnessDecisionNotes }}</textarea>
    </div>
</div>
