<div class="card">
    <h2>Step 2: Role &amp; Qualifications</h2>
    <p class="form-hint">Current role, employer, and professional registration.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="role_type">Role Type</label>
            <select id="role_type" name="role_qualifications.role_type">
                <option value="" {% if role_qualifications.roleType == "" %}selected{% endif %}>&mdash;</option>
                <option value="paramedic" {% if role_qualifications.roleType == "paramedic" %}selected{% endif %}>Paramedic</option>
                <option value="emt" {% if role_qualifications.roleType == "emt" %}selected{% endif %}>EMT</option>
                <option value="first-aider" {% if role_qualifications.roleType == "first-aider" %}selected{% endif %}>First Aider</option>
                <option value="advanced-paramedic" {% if role_qualifications.roleType == "advanced-paramedic" %}selected{% endif %}>Advanced Paramedic</option>
                <option value="community-responder" {% if role_qualifications.roleType == "community-responder" %}selected{% endif %}>Community Responder</option>
                <option value="other" {% if role_qualifications.roleType == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="role_type_other">Other Role (if applicable)</label>
            <input type="text" id="role_type_other" name="role_qualifications.role_type_other"
                   value="{{ role_qualifications.roleTypeOther }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="employer_organisation">Employer / Organisation</label>
            <input type="text" id="employer_organisation" name="role_qualifications.employer_organisation"
                   value="{{ role_qualifications.employerOrganisation }}">
        </div>
        <div class="form-group">
            <label for="station_base">Station / Base</label>
            <input type="text" id="station_base" name="role_qualifications.station_base"
                   value="{{ role_qualifications.stationBase }}">
        </div>
        <div class="form-group">
            <label for="years_of_service">Years of Service</label>
            <input type="number" min="0" id="years_of_service" name="role_qualifications.years_of_service"
                   value="{{ role_qualifications.yearsOfService }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="registration_number">Registration Number</label>
            <input type="text" id="registration_number" name="role_qualifications.registration_number"
                   value="{{ role_qualifications.registrationNumber }}">
        </div>
        <div class="form-group">
            <label for="registration_body">Registration Body</label>
            <select id="registration_body" name="role_qualifications.registration_body">
                <option value="" {% if role_qualifications.registrationBody == "" %}selected{% endif %}>&mdash;</option>
                <option value="hcpc" {% if role_qualifications.registrationBody == "hcpc" %}selected{% endif %}>HCPC</option>
                <option value="jrcalc" {% if role_qualifications.registrationBody == "jrcalc" %}selected{% endif %}>JRCALC</option>
                <option value="other" {% if role_qualifications.registrationBody == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="registration_expiry_date">Registration Expiry</label>
            <input type="date" id="registration_expiry_date" name="role_qualifications.registration_expiry_date"
                   value="{{ role_qualifications.registrationExpiryDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="highest_qualification">Highest Qualification</label>
            <select id="highest_qualification" name="role_qualifications.highest_qualification">
                <option value="" {% if role_qualifications.highestQualification == "" %}selected{% endif %}>&mdash;</option>
                <option value="certificate" {% if role_qualifications.highestQualification == "certificate" %}selected{% endif %}>Certificate</option>
                <option value="diploma" {% if role_qualifications.highestQualification == "diploma" %}selected{% endif %}>Diploma</option>
                <option value="foundation-degree" {% if role_qualifications.highestQualification == "foundation-degree" %}selected{% endif %}>Foundation Degree</option>
                <option value="bachelors" {% if role_qualifications.highestQualification == "bachelors" %}selected{% endif %}>Bachelor's</option>
                <option value="masters" {% if role_qualifications.highestQualification == "masters" %}selected{% endif %}>Master's</option>
                <option value="doctorate" {% if role_qualifications.highestQualification == "doctorate" %}selected{% endif %}>Doctorate</option>
                <option value="other" {% if role_qualifications.highestQualification == "other" %}selected{% endif %}>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="qualification_details">Qualification Details</label>
            <input type="text" id="qualification_details" name="role_qualifications.qualification_details"
                   value="{{ role_qualifications.qualificationDetails }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="driving_licence_category">Driving Licence Category</label>
            <select id="driving_licence_category" name="role_qualifications.driving_licence_category">
                <option value="" {% if role_qualifications.drivingLicenceCategory == "" %}selected{% endif %}>&mdash;</option>
                <option value="c1" {% if role_qualifications.drivingLicenceCategory == "c1" %}selected{% endif %}>C1</option>
                <option value="c1e" {% if role_qualifications.drivingLicenceCategory == "c1e" %}selected{% endif %}>C1E</option>
                <option value="c" {% if role_qualifications.drivingLicenceCategory == "c" %}selected{% endif %}>C</option>
                <option value="ce" {% if role_qualifications.drivingLicenceCategory == "ce" %}selected{% endif %}>CE</option>
                <option value="b" {% if role_qualifications.drivingLicenceCategory == "b" %}selected{% endif %}>B</option>
                <option value="none" {% if role_qualifications.drivingLicenceCategory == "none" %}selected{% endif %}>None</option>
            </select>
        </div>
        <div class="form-group">
            <label for="blue_light_trained">Blue-light Trained?</label>
            <select id="blue_light_trained" name="role_qualifications.blue_light_trained">
                <option value="" {% if role_qualifications.blueLightTrained == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if role_qualifications.blueLightTrained == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if role_qualifications.blueLightTrained == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>
</div>
