<div class="card">
    <h2>Step 9: CPD &amp; Training Record</h2>
    <p class="form-hint">CPD hours, mandatory training, recertification dates.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="cpd_hours_last_year">CPD Hours (last year)</label>
            <input type="number" step="0.1" min="0" id="cpd_hours_last_year" name="cpd_training.cpd_hours_last_year"
                   value="{{ cpd_training.cpdHoursLastYear }}">
        </div>
        <div class="form-group">
            <label for="cpd_hours_required">CPD Hours Required</label>
            <input type="number" step="0.1" min="0" id="cpd_hours_required" name="cpd_training.cpd_hours_required"
                   value="{{ cpd_training.cpdHoursRequired }}">
        </div>
        <div class="form-group">
            <label for="mandatory_training_complete">Mandatory Training Complete?</label>
            <select id="mandatory_training_complete" name="cpd_training.mandatory_training_complete">
                <option value="" {% if cpd_training.mandatoryTrainingComplete == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if cpd_training.mandatoryTrainingComplete == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if cpd_training.mandatoryTrainingComplete == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="bls_recertification_date">BLS Recertification</label>
            <input type="date" id="bls_recertification_date" name="cpd_training.bls_recertification_date"
                   value="{{ cpd_training.blsRecertificationDate }}">
        </div>
        <div class="form-group">
            <label for="als_recertification_date">ALS Recertification</label>
            <input type="date" id="als_recertification_date" name="cpd_training.als_recertification_date"
                   value="{{ cpd_training.alsRecertificationDate }}">
        </div>
        <div class="form-group">
            <label for="manual_handling_recertification_date">Manual Handling Recertification</label>
            <input type="date" id="manual_handling_recertification_date" name="cpd_training.manual_handling_recertification_date"
                   value="{{ cpd_training.manualHandlingRecertificationDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="safeguarding_training_date">Safeguarding Training</label>
            <input type="date" id="safeguarding_training_date" name="cpd_training.safeguarding_training_date"
                   value="{{ cpd_training.safeguardingTrainingDate }}">
        </div>
        <div class="form-group">
            <label for="infection_control_training_date">Infection Control Training</label>
            <input type="date" id="infection_control_training_date" name="cpd_training.infection_control_training_date"
                   value="{{ cpd_training.infectionControlTrainingDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="major_incident_training">Major Incident Training?</label>
            <select id="major_incident_training" name="cpd_training.major_incident_training">
                <option value="" {% if cpd_training.majorIncidentTraining == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if cpd_training.majorIncidentTraining == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if cpd_training.majorIncidentTraining == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="major_incident_training_date">Major Incident Training Date</label>
            <input type="date" id="major_incident_training_date" name="cpd_training.major_incident_training_date"
                   value="{{ cpd_training.majorIncidentTrainingDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="mentoring_capability">Mentoring Capability</label>
            <select id="mentoring_capability" name="cpd_training.mentoring_capability">
                <option value="" {% if cpd_training.mentoringCapability == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if cpd_training.mentoringCapability == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if cpd_training.mentoringCapability == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if cpd_training.mentoringCapability == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if cpd_training.mentoringCapability == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="clinical_supervision_attendance">Clinical Supervision Attendance?</label>
            <select id="clinical_supervision_attendance" name="cpd_training.clinical_supervision_attendance">
                <option value="" {% if cpd_training.clinicalSupervisionAttendance == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if cpd_training.clinicalSupervisionAttendance == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if cpd_training.clinicalSupervisionAttendance == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="reflective_practice">Reflective Practice</label>
            <select id="reflective_practice" name="cpd_training.reflective_practice">
                <option value="" {% if cpd_training.reflectivePractice == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if cpd_training.reflectivePractice == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if cpd_training.reflectivePractice == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if cpd_training.reflectivePractice == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if cpd_training.reflectivePractice == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="cpd_training_notes">Notes</label>
        <textarea id="cpd_training_notes" name="cpd_training.cpd_training_notes">{{ cpd_training.cpdTrainingNotes }}</textarea>
    </div>
</div>
