<div class="card">
    <h2>Step 3: Physical Fitness Assessment</h2>
    <p class="form-hint">Cardiovascular fitness, strength, manual handling, and vital signs.</p>

    <div class="form-group">
        <label for="cardiovascular_fitness">Cardiovascular Fitness</label>
        <select id="cardiovascular_fitness" name="physical_fitness.cardiovascular_fitness">
            <option value="" {% if physical_fitness.cardiovascularFitness == "" %}selected{% endif %}>&mdash;</option>
            <option value="not-competent" {% if physical_fitness.cardiovascularFitness == "not-competent" %}selected{% endif %}>Not Competent</option>
            <option value="developing" {% if physical_fitness.cardiovascularFitness == "developing" %}selected{% endif %}>Developing</option>
            <option value="competent" {% if physical_fitness.cardiovascularFitness == "competent" %}selected{% endif %}>Competent</option>
            <option value="expert" {% if physical_fitness.cardiovascularFitness == "expert" %}selected{% endif %}>Expert</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="shuttle_run_level">Shuttle Run Level</label>
            <input type="number" step="0.1" id="shuttle_run_level" name="physical_fitness.shuttle_run_level"
                   value="{{ physical_fitness.shuttleRunLevel }}">
        </div>
        <div class="form-group">
            <label for="vo2_max">VO2 Max (ml/kg/min)</label>
            <input type="number" step="0.1" id="vo2_max" name="physical_fitness.vo2_max"
                   value="{{ physical_fitness.vo2Max }}">
        </div>
    </div>

    <div class="form-group">
        <label for="muscular_strength">Muscular Strength</label>
        <select id="muscular_strength" name="physical_fitness.muscular_strength">
            <option value="" {% if physical_fitness.muscularStrength == "" %}selected{% endif %}>&mdash;</option>
            <option value="not-competent" {% if physical_fitness.muscularStrength == "not-competent" %}selected{% endif %}>Not Competent</option>
            <option value="developing" {% if physical_fitness.muscularStrength == "developing" %}selected{% endif %}>Developing</option>
            <option value="competent" {% if physical_fitness.muscularStrength == "competent" %}selected{% endif %}>Competent</option>
            <option value="expert" {% if physical_fitness.muscularStrength == "expert" %}selected{% endif %}>Expert</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="grip_strength_kg">Grip Strength (kg)</label>
            <input type="number" step="0.1" id="grip_strength_kg" name="physical_fitness.grip_strength_kg"
                   value="{{ physical_fitness.gripStrengthKg }}">
        </div>
        <div class="form-group">
            <label for="manual_handling_competency">Manual Handling Competency</label>
            <select id="manual_handling_competency" name="physical_fitness.manual_handling_competency">
                <option value="" {% if physical_fitness.manualHandlingCompetency == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if physical_fitness.manualHandlingCompetency == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if physical_fitness.manualHandlingCompetency == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if physical_fitness.manualHandlingCompetency == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if physical_fitness.manualHandlingCompetency == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="patient_carry_ability">Able to carry patient on stretcher?</label>
            <select id="patient_carry_ability" name="physical_fitness.patient_carry_ability">
                <option value="" {% if physical_fitness.patientCarryAbility == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if physical_fitness.patientCarryAbility == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if physical_fitness.patientCarryAbility == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="flexibility_mobility">Flexibility / Mobility</label>
            <select id="flexibility_mobility" name="physical_fitness.flexibility_mobility">
                <option value="" {% if physical_fitness.flexibilityMobility == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if physical_fitness.flexibilityMobility == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if physical_fitness.flexibilityMobility == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if physical_fitness.flexibilityMobility == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if physical_fitness.flexibilityMobility == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="balance_coordination">Balance / Coordination</label>
            <select id="balance_coordination" name="physical_fitness.balance_coordination">
                <option value="" {% if physical_fitness.balanceCoordination == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if physical_fitness.balanceCoordination == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if physical_fitness.balanceCoordination == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if physical_fitness.balanceCoordination == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if physical_fitness.balanceCoordination == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="resting_heart_rate_bpm">Resting Heart Rate (bpm)</label>
            <input type="number" min="0" id="resting_heart_rate_bpm" name="physical_fitness.resting_heart_rate_bpm"
                   value="{{ physical_fitness.restingHeartRateBpm }}">
        </div>
        <div class="form-group">
            <label for="blood_pressure_systolic">Systolic BP (mmHg)</label>
            <input type="number" min="0" id="blood_pressure_systolic" name="physical_fitness.blood_pressure_systolic"
                   value="{{ physical_fitness.bloodPressureSystolic }}">
        </div>
        <div class="form-group">
            <label for="blood_pressure_diastolic">Diastolic BP (mmHg)</label>
            <input type="number" min="0" id="blood_pressure_diastolic" name="physical_fitness.blood_pressure_diastolic"
                   value="{{ physical_fitness.bloodPressureDiastolic }}">
        </div>
    </div>

    <div class="form-group">
        <label for="physical_fitness_notes">Notes</label>
        <textarea id="physical_fitness_notes" name="physical_fitness.physical_fitness_notes">{{ physical_fitness.physicalFitnessNotes }}</textarea>
    </div>
</div>
