<div class="card">
    <h2>Step 7: Psychological Readiness</h2>
    <p class="form-hint">Stress, resilience, PTSD screening, critical incident exposure, sleep, burnout.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="stress_management">Stress Management</label>
            <select id="stress_management" name="psychological_readiness.stress_management">
                <option value="" {% if psychological_readiness.stressManagement == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if psychological_readiness.stressManagement == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if psychological_readiness.stressManagement == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if psychological_readiness.stressManagement == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if psychological_readiness.stressManagement == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="resilience_level">Resilience</label>
            <select id="resilience_level" name="psychological_readiness.resilience_level">
                <option value="" {% if psychological_readiness.resilienceLevel == "" %}selected{% endif %}>&mdash;</option>
                <option value="low" {% if psychological_readiness.resilienceLevel == "low" %}selected{% endif %}>Low</option>
                <option value="moderate" {% if psychological_readiness.resilienceLevel == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="good" {% if psychological_readiness.resilienceLevel == "good" %}selected{% endif %}>Good</option>
                <option value="excellent" {% if psychological_readiness.resilienceLevel == "excellent" %}selected{% endif %}>Excellent</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="ptsd_screening">PTSD Screening?</label>
            <select id="ptsd_screening" name="psychological_readiness.ptsd_screening">
                <option value="" {% if psychological_readiness.ptsdScreening == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.ptsdScreening == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.ptsdScreening == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="ptsd_screening_result">PTSD Result</label>
            <select id="ptsd_screening_result" name="psychological_readiness.ptsd_screening_result">
                <option value="" {% if psychological_readiness.ptsdScreeningResult == "" %}selected{% endif %}>&mdash;</option>
                <option value="negative" {% if psychological_readiness.ptsdScreeningResult == "negative" %}selected{% endif %}>Negative</option>
                <option value="positive" {% if psychological_readiness.ptsdScreeningResult == "positive" %}selected{% endif %}>Positive</option>
                <option value="inconclusive" {% if psychological_readiness.ptsdScreeningResult == "inconclusive" %}selected{% endif %}>Inconclusive</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="critical_incident_exposure">Critical Incident Exposure?</label>
            <select id="critical_incident_exposure" name="psychological_readiness.critical_incident_exposure">
                <option value="" {% if psychological_readiness.criticalIncidentExposure == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.criticalIncidentExposure == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.criticalIncidentExposure == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
        <div class="form-group">
            <label for="critical_incident_debriefed">Debriefed?</label>
            <select id="critical_incident_debriefed" name="psychological_readiness.critical_incident_debriefed">
                <option value="" {% if psychological_readiness.criticalIncidentDebriefed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if psychological_readiness.criticalIncidentDebriefed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if psychological_readiness.criticalIncidentDebriefed == "no" %}selected{% endif %}>No</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="critical_incident_details">Critical Incident Details</label>
        <textarea id="critical_incident_details" name="psychological_readiness.critical_incident_details">{{ psychological_readiness.criticalIncidentDetails }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="sleep_quality">Sleep Quality</label>
            <select id="sleep_quality" name="psychological_readiness.sleep_quality">
                <option value="" {% if psychological_readiness.sleepQuality == "" %}selected{% endif %}>&mdash;</option>
                <option value="good" {% if psychological_readiness.sleepQuality == "good" %}selected{% endif %}>Good</option>
                <option value="fair" {% if psychological_readiness.sleepQuality == "fair" %}selected{% endif %}>Fair</option>
                <option value="poor" {% if psychological_readiness.sleepQuality == "poor" %}selected{% endif %}>Poor</option>
            </select>
        </div>
        <div class="form-group">
            <label for="burnout_risk">Burnout Risk</label>
            <select id="burnout_risk" name="psychological_readiness.burnout_risk">
                <option value="" {% if psychological_readiness.burnoutRisk == "" %}selected{% endif %}>&mdash;</option>
                <option value="low" {% if psychological_readiness.burnoutRisk == "low" %}selected{% endif %}>Low</option>
                <option value="moderate" {% if psychological_readiness.burnoutRisk == "moderate" %}selected{% endif %}>Moderate</option>
                <option value="high" {% if psychological_readiness.burnoutRisk == "high" %}selected{% endif %}>High</option>
            </select>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="decision_making_under_pressure">Decision Making Under Pressure</label>
            <select id="decision_making_under_pressure" name="psychological_readiness.decision_making_under_pressure">
                <option value="" {% if psychological_readiness.decisionMakingUnderPressure == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if psychological_readiness.decisionMakingUnderPressure == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if psychological_readiness.decisionMakingUnderPressure == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if psychological_readiness.decisionMakingUnderPressure == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if psychological_readiness.decisionMakingUnderPressure == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="emotional_regulation">Emotional Regulation</label>
            <select id="emotional_regulation" name="psychological_readiness.emotional_regulation">
                <option value="" {% if psychological_readiness.emotionalRegulation == "" %}selected{% endif %}>&mdash;</option>
                <option value="not-competent" {% if psychological_readiness.emotionalRegulation == "not-competent" %}selected{% endif %}>Not Competent</option>
                <option value="developing" {% if psychological_readiness.emotionalRegulation == "developing" %}selected{% endif %}>Developing</option>
                <option value="competent" {% if psychological_readiness.emotionalRegulation == "competent" %}selected{% endif %}>Competent</option>
                <option value="expert" {% if psychological_readiness.emotionalRegulation == "expert" %}selected{% endif %}>Expert</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label for="psychological_notes">Notes</label>
        <textarea id="psychological_notes" name="psychological_readiness.psychological_notes">{{ psychological_readiness.psychologicalNotes }}</textarea>
    </div>
</div>
