{% extends "base.html.tera" %}

{% block title %}First Responder Assessment Report - {{ overall_fitness_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>First Responder Assessment &mdash; Report</h1>
    <div class="fitness-badge fitness-{{ overall_fitness }}">{{ overall_fitness_label }}</div>
    <div class="risk-badge risk-{{ overall_risk }}">{{ overall_risk_label }}</div>
    <div class="competency-label">Overall competency: {{ overall_competency_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Responder Summary -->
<div class="card">
    <h2>Responder Summary</h2>
    <div class="form-row">
        <div>
            <strong>Name:</strong> {{ data.demographics.firstName }} {{ data.demographics.lastName }}<br>
            <strong>Date of Birth:</strong> {{ data.demographics.dateOfBirth }}<br>
            <strong>Sex:</strong> {{ data.demographics.sex }}<br>
            <strong>Role:</strong> {{ data.roleQualifications.roleType }}<br>
            <strong>Employer:</strong> {{ data.roleQualifications.employerOrganisation }}
        </div>
        <div>
            <strong>Station:</strong> {{ data.roleQualifications.stationBase }}<br>
            <strong>Years of Service:</strong> {{ data.roleQualifications.yearsOfService }}<br>
            <strong>Registration:</strong> {{ data.roleQualifications.registrationBody }} {{ data.roleQualifications.registrationNumber }}<br>
            <strong>Assessor:</strong> {{ data.fitnessDecision.assessorName }}<br>
            <strong>Assessment Date:</strong> {{ data.fitnessDecision.assessmentDate }}
        </div>
    </div>
</div>

<!-- Domain breakdown -->
<div class="card">
    <h2>Domain Competency Levels</h2>
    <table class="phase-table">
        <thead>
            <tr>
                <th>Domain</th>
                <th>Aggregate Level</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Physical Fitness</td><td>{{ domain_levels.physicalFitness }}</td></tr>
            <tr><td>Clinical Skills</td><td>{{ domain_levels.clinicalSkills }}</td></tr>
            <tr><td>Equipment / Vehicle</td><td>{{ domain_levels.equipmentVehicle }}</td></tr>
            <tr><td>Communication</td><td>{{ domain_levels.communication }}</td></tr>
            <tr><td>Psychological</td><td>{{ domain_levels.psychological }}</td></tr>
        </tbody>
    </table>
</div>

<!-- Safety Flags -->
{% if additional_flags | length > 0 %}
<div class="card">
    <h2>Safety Flags ({{ additional_flags | length }})</h2>
    <div class="flags-section">
        {% for flag in additional_flags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- Fired rules -->
{% if fired_rules | length > 0 %}
<div class="card">
    <h2>Fired Rules ({{ fired_rules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Domain</th>
                <th>Description</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            {% for rule in fired_rules %}
            <tr>
                <td><code>{{ rule.id }}</code></td>
                <td>{{ rule.domain }}</td>
                <td>{{ rule.description }}</td>
                <td><span class="grade-badge grade-{{ rule.grade }}">Grade {{ rule.grade }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
