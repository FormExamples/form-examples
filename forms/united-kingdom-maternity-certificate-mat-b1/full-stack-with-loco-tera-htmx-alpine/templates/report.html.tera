{% extends "base.html.tera" %}

{% block title %}MAT B1 Report - {{ complete_label }}{% endblock %}

{% block content %}
<div class="report-header">
    <h1>UK MAT B1 Maternity Certificate &mdash; Validation Report</h1>
    <div class="checklist-badge checklist-{% if result.complete %}complete{% else %}incomplete{% endif %}">{{ complete_label }}</div>
    <p style="color: var(--gray-500); font-size: 0.85rem;">
        Assessment ID: {{ id }}<br>
        Generated: {{ timestamp }}
    </p>
</div>

<!-- Branch summary -->
<div class="card">
    <h2>Branch</h2>
    <div class="form-row">
        <div>
            <strong>Certificate type:</strong> {{ certificate_type_label }}<br>
            <strong>Issuer:</strong> {{ issuer_type_label }}
        </div>
        <div>
            {% if result.weeksBeforeEwc %}
                <strong>Weeks before EWC:</strong> {{ result.weeksBeforeEwc }}
            {% endif %}
        </div>
    </div>
</div>

<!-- Patient -->
<div class="card">
    <h2>Patient</h2>
    <p>
        <strong>Name:</strong> {{ data.patientIdentification.patientName }}<br>
        <strong>Date of birth:</strong> {{ data.patientIdentification.dateOfBirth }}<br>
        <strong>NHS number:</strong> {{ data.patientIdentification.nhsNumber }}
    </p>
</div>

<!-- Certificate -->
<div class="card">
    <h2>Certificate</h2>
    <p>
        <strong>Unique certificate number:</strong> {{ data.issuer.certificateNumber }}<br>
        <strong>Issue date:</strong> {{ data.issuer.issueDate }}<br>
        <strong>Duplicate?</strong> {{ data.issuer.isDuplicate }} &middot;
        <strong>Marker applied?</strong> {{ data.issuer.duplicateMarkerApplied }} &middot;
        <strong>Completed in ink?</strong> {{ data.issuer.completedInInk }}
    </p>
</div>

<!-- Completeness -->
<div class="card">
    <h2>Completeness</h2>
    <p>
        {% if result.complete %}
            <strong style="color:#080;">Form is complete.</strong>
        {% else %}
            <strong style="color:#a00;">Form is incomplete</strong> &mdash; see fired rules below.
        {% endif %}
    </p>
</div>

<!-- Fired rules -->
{% if result.firedRules | length > 0 %}
<div class="card">
    <h2>Fired rules ({{ result.firedRules | length }})</h2>
    <table class="rules-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Description</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for r in result.firedRules %}
            <tr>
                <td><code>{{ r.id }}</code></td>
                <td>{{ r.category }}</td>
                <td><span class="severity-badge severity-{{ r.priority }}">{{ r.priority }}</span></td>
                <td>{{ r.description }}</td>
                <td>{{ r.message }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="card"><h2>Fired rules</h2><p style="color:#080;">No rules fired.</p></div>
{% endif %}

<!-- Additional flags -->
{% if result.additionalFlags | length > 0 %}
<div class="card">
    <h2>Additional flags ({{ result.additionalFlags | length }})</h2>
    <div class="flags-section">
        {% for flag in result.additionalFlags %}
        <div class="flag-item flag-{{ flag.priority }}">
            <span class="flag-category">{{ flag.category }}</span>
            <span class="flag-message">{{ flag.message }}</span>
            <small>({{ flag.id }})</small>
        </div>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="card"><h2>Additional flags</h2><p style="color:#080;">No additional clinician flags were raised.</p></div>
{% endif %}

<!-- Actions -->
<div class="card" style="text-align: center;">
    <a href="/" class="btn btn-primary">New Assessment</a>
    <a href="/dashboard" class="btn btn-secondary" style="margin-left: 1rem;">View Dashboard</a>
    <button onclick="window.print()" class="btn btn-secondary" style="margin-left: 1rem;">Print Report</button>
</div>
{% endblock %}
