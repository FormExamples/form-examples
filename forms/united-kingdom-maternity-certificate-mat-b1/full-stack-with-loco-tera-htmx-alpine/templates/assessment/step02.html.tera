<div class="card">
    <h2>Step 2: Part A &mdash; Pre-Confinement Certificate</h2>
    <p class="form-hint">
        Required when <em>certificate type = pre</em>. The MAT B1 must not be
        issued more than 20 weeks before the expected date of confinement (EWC).
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="pre_expected_date_of_confinement">Expected date of confinement (EWC)</label>
            <input type="date" id="pre_expected_date_of_confinement"
                   name="pre_confinement.expected_date_of_confinement"
                   value="{{ pre_confinement.expectedDateOfConfinement }}">
        </div>
        <div class="form-group">
            <label for="pre_examination_date">Examination date (date the certificate is issued)</label>
            <input type="date" id="pre_examination_date" name="pre_confinement.examination_date"
                   value="{{ pre_confinement.examinationDate }}">
        </div>
    </div>
</div>
