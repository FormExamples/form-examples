{% extends "base.html.tera" %}

{% block title %}MAT B1 — Report{% endblock %}

{% block content %}
<div style="max-width:820px;margin:2rem auto;padding:1rem;">
  <h1>MAT B1 — Validation Report</h1>
  <p style="color:#555;">Report generated: {{ timestamp }}</p>
  <p style="color:#555;">Assessment ID: {{ id }}</p>

  <h2>Branch</h2>
  <p>
    Certificate type:
    <strong>
      {% if result.validation.certificateType == "pre" %}Part A — Pre-confinement
      {% elif result.validation.certificateType == "post" %}Part B — Post-confinement
      {% else %}<em>not selected</em>{% endif %}
    </strong>
    &middot;
    Issuer:
    <strong>
      {% if result.validation.issuerType == "doctor" %}Doctor
      {% elif result.validation.issuerType == "midwife" %}Registered midwife
      {% else %}<em>not selected</em>{% endif %}
    </strong>
  </p>
  {% if result.validation.weeksBeforeEwc %}
  <p>Examination is <strong>{{ result.validation.weeksBeforeEwc }}</strong> weeks before the EWC.</p>
  {% endif %}

  <h2>Completeness</h2>
  <p>
    {% if result.validation.complete %}
      <strong style="color:#080;">Form is complete.</strong>
    {% else %}
      <strong style="color:#a00;">Form is incomplete</strong> — see fired rules below.
    {% endif %}
  </p>

  <h2>Fired rules</h2>
  {% if result.validation.firedRules | length == 0 %}
    <p style="color:#080;">No rules fired.</p>
  {% else %}
    <ul style="padding-left:1.2rem;">
      {% for r in result.validation.firedRules %}
        <li style="margin-bottom:0.6rem;">
          <span style="display:inline-block;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;
            {% if r.priority == 'urgent' %}background:#fee;color:#900;border:1px solid #f99;{% endif %}
            {% if r.priority == 'high' %}background:#fef0e6;color:#a35100;border:1px solid #f5b97c;{% endif %}
            {% if r.priority == 'medium' %}background:#fffbe6;color:#8a6d00;border:1px solid #f1d76b;{% endif %}
            {% if r.priority == 'low' %}background:#eef;color:#226;border:1px solid #99d;{% endif %}">
            {{ r.priority | upper }}
          </span>
          <strong>{{ r.id }}:</strong> {{ r.message }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <h2>Additional flags</h2>
  {% if result.validation.additionalFlags | length == 0 %}
    <p style="color:#080;">No additional clinician flags were raised.</p>
  {% else %}
    <ul style="padding-left:1.2rem;">
      {% for flag in result.validation.additionalFlags %}
        <li style="margin-bottom:0.6rem;">
          <span style="display:inline-block;padding:0.1rem 0.5rem;border-radius:3px;font-size:0.8rem;
            {% if flag.priority == 'urgent' %}background:#fee;color:#900;border:1px solid #f99;{% endif %}
            {% if flag.priority == 'high' %}background:#fef0e6;color:#a35100;border:1px solid #f5b97c;{% endif %}
            {% if flag.priority == 'medium' %}background:#fffbe6;color:#8a6d00;border:1px solid #f1d76b;{% endif %}
            {% if flag.priority == 'low' %}background:#eef;color:#226;border:1px solid #99d;{% endif %}">
            {{ flag.priority | upper }}
          </span>
          <strong>{{ flag.category }}:</strong> {{ flag.message }}
          <span style="color:#888;font-size:0.85rem;">({{ flag.id }})</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <div style="display:flex;gap:1rem;margin-top:1.5rem;">
    <a href="/assessment/{{ id }}" style="padding:0.5rem 1.2rem;border:1px solid #0070f3;color:#0070f3;border-radius:4px;text-decoration:none;">
      Edit Assessment
    </a>
    <a href="/" style="padding:0.5rem 1.2rem;border:1px solid #ccc;color:#333;border-radius:4px;text-decoration:none;">
      Home
    </a>
  </div>
</div>
{% endblock %}
