<div class="card">
    <h2>Step 3: Part B &mdash; Post-Confinement Certificate</h2>
    <p class="form-hint">
        Required when <em>certificate type = post</em>. Records the baby's actual
        date of birth alongside the originally expected EWC.
    </p>

    <div class="form-row">
        <div class="form-group">
            <label for="post_actual_date_of_birth">Baby's actual date of birth</label>
            <input type="date" id="post_actual_date_of_birth"
                   name="post_confinement.actual_date_of_birth"
                   value="{{ post_confinement.actualDateOfBirth }}">
        </div>
        <div class="form-group">
            <label for="post_expected_date_of_confinement">Originally expected date of confinement</label>
            <input type="date" id="post_expected_date_of_confinement"
                   name="post_confinement.expected_date_of_confinement"
                   value="{{ post_confinement.expectedDateOfConfinement }}">
        </div>
    </div>
</div>
