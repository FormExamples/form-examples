{% extends "base.html.tera" %}

{% block title %}UK MAT B1 - Dashboard{% endblock %}

{% block content %}
<div class="dashboard-header">
    <h1>MAT B1 Assessments Dashboard</h1>
    <a href="/" class="btn btn-primary">New Assessment</a>
</div>

<form method="GET" action="/dashboard" class="filter-bar">
    <div class="form-group">
        <label for="search">Search</label>
        <input type="text" id="search" name="search" value="{{ search }}"
               placeholder="Patient name, issuer, or certificate number...">
    </div>
    <div class="form-group">
        <label for="certificate_type">Certificate Type</label>
        <select id="certificate_type" name="certificate_type">
            <option value="">All</option>
            <option value="pre" {% if certificate_type == "pre" %}selected{% endif %}>Part A (Pre)</option>
            <option value="post" {% if certificate_type == "post" %}selected{% endif %}>Part B (Post)</option>
        </select>
    </div>
    <div class="form-group">
        <label for="issuer_type">Issuer</label>
        <select id="issuer_type" name="issuer_type">
            <option value="">All</option>
            <option value="doctor" {% if issuer_type == "doctor" %}selected{% endif %}>Doctor</option>
            <option value="midwife" {% if issuer_type == "midwife" %}selected{% endif %}>Midwife</option>
        </select>
    </div>
    <div class="form-group">
        <label for="complete">Completeness</label>
        <select id="complete" name="complete">
            <option value="">All</option>
            <option value="yes" {% if complete == "yes" %}selected{% endif %}>Complete</option>
            <option value="no" {% if complete == "no" %}selected{% endif %}>Incomplete</option>
        </select>
    </div>
    <div class="form-group">
        <label for="has_flags">Urgent / High Flags</label>
        <select id="has_flags" name="has_flags">
            <option value="">All</option>
            <option value="yes" {% if has_flags == "yes" %}selected{% endif %}>With flags</option>
            <option value="no" {% if has_flags == "no" %}selected{% endif %}>Without flags</option>
        </select>
    </div>
    <div class="form-group" style="display: flex; gap: 0.5rem; align-items: flex-end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/dashboard" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p class="total-count">Showing {{ total }} completed assessment{% if total != 1 %}s{% endif %}.</p>

{% if total > 0 %}
<table class="patient-table">
    <thead>
        <tr>
            <th>Issue Date</th>
            <th>Patient</th>
            <th>Certificate Type</th>
            <th>Issuer</th>
            <th>Certificate #</th>
            <th>Completeness</th>
            <th>Rules</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        {% for r in rows %}
        <tr>
            <td><a href="/assessment/{{ r.id }}/report">{{ r.issueDate }}</a></td>
            <td>{{ r.patientName }}</td>
            <td>{{ r.certificateType }}</td>
            <td>{{ r.issuerType }}<br><small>{{ r.issuerName }}</small></td>
            <td>{{ r.certificateNumber }}</td>
            <td>
                {% if r.complete %}
                    <span class="badge badge-yes">Complete</span>
                {% else %}
                    <span class="badge badge-no">Incomplete</span>
                {% endif %}
            </td>
            <td>{{ r.firedRuleCount }}</td>
            <td>
                {% if r.urgentOrHighFlagCount > 0 %}
                    <span class="badge badge-no">{{ r.urgentOrHighFlagCount }}</span>
                {% else %}
                    <span class="badge badge-yes">0</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<div class="card" style="text-align: center; color: var(--gray-500);">
    <p>No completed assessments found matching your filters.</p>
</div>
{% endif %}
{% endblock %}
