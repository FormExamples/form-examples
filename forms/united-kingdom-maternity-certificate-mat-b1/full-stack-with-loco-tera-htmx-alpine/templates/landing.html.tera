{% extends "base.html.tera" %}

{% block title %}MAT B1 — Maternity Certificate{% endblock %}

{% block content %}
<div style="max-width:760px;margin:2rem auto;padding:1rem;">
  <h1>MAT B1 — Maternity Certificate</h1>
  <p>
    UK DWP maternity certificate, issued by doctors or registered midwives to
    enable claims for Statutory Maternity Pay (SMP), Maternity Allowance (MA),
    and the Sure Start Maternity Grant (SSMG). Captures patient identification,
    Part A (pre-confinement EWC) or Part B (post-confinement DOB + EWC), and
    the issuer's credentials.
  </p>

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;">
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>4 Steps</h3>
      <p>Patient Identification, Part A, Part B, Issuer Validation.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Branching</h3>
      <p>Part A and Part B are mutually exclusive. Doctor and midwife issuers have distinct validation.</p>
    </div>
    <div style="border:1px solid #ccc;border-radius:4px;padding:1rem;flex:1;min-width:180px;">
      <h3>Flagged Issues</h3>
      <p>Missing certificate number, &gt;20 weeks before EWC, expired NMC registration, missing duplicate marker.</p>
    </div>
  </div>

  <form method="POST" action="/assessment/new">
    <button type="submit" style="padding:0.6rem 1.4rem;background:#0070f3;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:1rem;">
      Begin New Assessment
    </button>
  </form>
</div>
{% endblock %}
