{% extends "base.html.tera" %}

{% block title %}UK MAT B1 Maternity Certificate - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>UK MAT B1 Maternity Certificate</h1>
        <p class="landing-description">
            UK Department for Work and Pensions (DWP) maternity certificate, issued
            by doctors or registered midwives to enable claims for Statutory
            Maternity Pay (SMP), Maternity Allowance (MA), and the Sure Start
            Maternity Grant (SSMG). Captures patient identification, Part A
            (pre-confinement EWC) or Part B (post-confinement DOB + EWC), and the
            issuer's credentials.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Four Steps</h3>
                <p>Patient Identification, Part A (pre-confinement), Part B (post-confinement), and Issuer Validation.</p>
            </div>
            <div class="feature">
                <h3>Branching</h3>
                <p>Part A and Part B are mutually exclusive. Doctor and midwife issuers have distinct validation paths.</p>
            </div>
            <div class="feature">
                <h3>Flagged Issues</h3>
                <p>Missing certificate number, &gt;20 weeks before EWC, expired NMC registration, missing duplicate marker.</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Assessment
            </button>
        </form>
    </div>
</div>
{% endblock %}
