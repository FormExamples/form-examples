<div class="card">
    <h2>Step 10: Sign-off &amp; Action Plan</h2>
    <p class="form-hint">Auditor sign-off, summary, debrief and corrective-action items.</p>

    <div class="form-group">
        <label for="signoff_action_plan_overall_summary">Overall Summary</label>
        <textarea id="signoff_action_plan_overall_summary" name="signoff_action_plan.overall_summary"
                  placeholder="Headline narrative for site manager and senior leadership">{{ signoff_action_plan.overallSummary }}</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="signoff_action_plan_auditor_signature">Auditor Signature</label>
            <input type="text" id="signoff_action_plan_auditor_signature" name="signoff_action_plan.auditor_signature"
                   value="{{ signoff_action_plan.auditorSignature }}" placeholder="Typed name acts as signature">
        </div>
        <div class="form-group">
            <label for="signoff_action_plan_signoff_date">Sign-off Date</label>
            <input type="date" id="signoff_action_plan_signoff_date" name="signoff_action_plan.signoff_date"
                   value="{{ signoff_action_plan.signoffDate }}">
        </div>
        <div class="form-group">
            <label for="signoff_action_plan_debrief_delivered">Debrief Delivered to Site Manager?</label>
            <select id="signoff_action_plan_debrief_delivered" name="signoff_action_plan.debrief_delivered">
                <option value="" {% if signoff_action_plan.debriefDelivered == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if signoff_action_plan.debriefDelivered == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if signoff_action_plan.debriefDelivered == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if signoff_action_plan.debriefDelivered == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
    </div>

    <h3>Action Items</h3>
    <p class="form-hint">Up to four corrective action items can be recorded inline; additional items can be appended to the report after submission.</p>

    {% for i in range(end=4) %}
    <div class="form-row">
        <div class="form-group">
            <label for="action_items_{{ i }}_description">Description</label>
            <input type="text" id="action_items_{{ i }}_description" name="action_items[{{ i }}].description"
                   value="{% if signoff_action_plan.actionItems and i < signoff_action_plan.actionItems | length %}{{ signoff_action_plan.actionItems[i].description }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="action_items_{{ i }}_owner">Owner</label>
            <input type="text" id="action_items_{{ i }}_owner" name="action_items[{{ i }}].owner"
                   value="{% if signoff_action_plan.actionItems and i < signoff_action_plan.actionItems | length %}{{ signoff_action_plan.actionItems[i].owner }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="action_items_{{ i }}_due_date">Due Date</label>
            <input type="date" id="action_items_{{ i }}_due_date" name="action_items[{{ i }}].due_date"
                   value="{% if signoff_action_plan.actionItems and i < signoff_action_plan.actionItems | length %}{{ signoff_action_plan.actionItems[i].dueDate }}{% endif %}">
        </div>
        <div class="form-group">
            <label for="action_items_{{ i }}_priority">Priority</label>
            <select id="action_items_{{ i }}_priority" name="action_items[{{ i }}].priority">
                {% set selected_priority = "" %}
                {% if signoff_action_plan.actionItems and i < signoff_action_plan.actionItems | length %}{% set selected_priority = signoff_action_plan.actionItems[i].priority %}{% endif %}
                <option value="" {% if selected_priority == "" %}selected{% endif %}>&mdash;</option>
                <option value="critical" {% if selected_priority == "critical" %}selected{% endif %}>Critical</option>
                <option value="major" {% if selected_priority == "major" %}selected{% endif %}>Major</option>
                <option value="minor" {% if selected_priority == "minor" %}selected{% endif %}>Minor</option>
            </select>
        </div>
    </div>
    {% endfor %}
</div>
