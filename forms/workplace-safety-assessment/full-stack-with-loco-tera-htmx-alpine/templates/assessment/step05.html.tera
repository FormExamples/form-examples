<div class="card">
    <h2>Step 5: Fire Safety &amp; Emergency Egress</h2>
    <p class="form-hint">Fire risk assessment, extinguishers, alarm, egress, doors and assembly point.</p>

    <div class="form-group">
        <label for="fire_safety_fire_risk_assessment_current">Fire risk assessment current and on file</label>
        <select id="fire_safety_fire_risk_assessment_current" name="fire_safety.fire_risk_assessment_current">
            <option value="" {% if fire_safety.fireRiskAssessmentCurrent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.fireRiskAssessmentCurrent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.fireRiskAssessmentCurrent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.fireRiskAssessmentCurrent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_fire_extinguishers_serviced">Fire extinguishers serviced (current annual service)</label>
        <select id="fire_safety_fire_extinguishers_serviced" name="fire_safety.fire_extinguishers_serviced">
            <option value="" {% if fire_safety.fireExtinguishersServiced == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.fireExtinguishersServiced == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.fireExtinguishersServiced == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.fireExtinguishersServiced == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_fire_extinguishers_accessible">Fire extinguishers accessible and unobstructed</label>
        <select id="fire_safety_fire_extinguishers_accessible" name="fire_safety.fire_extinguishers_accessible">
            <option value="" {% if fire_safety.fireExtinguishersAccessible == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.fireExtinguishersAccessible == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.fireExtinguishersAccessible == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.fireExtinguishersAccessible == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_fire_alarm_tested_weekly">Fire alarm tested weekly with records</label>
        <select id="fire_safety_fire_alarm_tested_weekly" name="fire_safety.fire_alarm_tested_weekly">
            <option value="" {% if fire_safety.fireAlarmTestedWeekly == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.fireAlarmTestedWeekly == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.fireAlarmTestedWeekly == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.fireAlarmTestedWeekly == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_emergency_egress_clear">Emergency egress routes clear and unobstructed</label>
        <select id="fire_safety_emergency_egress_clear" name="fire_safety.emergency_egress_clear">
            <option value="" {% if fire_safety.emergencyEgressClear == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.emergencyEgressClear == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.emergencyEgressClear == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.emergencyEgressClear == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_emergency_lighting_functional">Emergency lighting functional</label>
        <select id="fire_safety_emergency_lighting_functional" name="fire_safety.emergency_lighting_functional">
            <option value="" {% if fire_safety.emergencyLightingFunctional == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.emergencyLightingFunctional == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.emergencyLightingFunctional == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.emergencyLightingFunctional == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_fire_doors_held_open_illegally">Any fire doors held open illegally (wedges etc.)?</label>
        <select id="fire_safety_fire_doors_held_open_illegally" name="fire_safety.fire_doors_held_open_illegally">
            <option value="" {% if fire_safety.fireDoorsHeldOpenIllegally == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if fire_safety.fireDoorsHeldOpenIllegally == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if fire_safety.fireDoorsHeldOpenIllegally == "yes" %}selected{% endif %}>Yes</option>
            <option value="na" {% if fire_safety.fireDoorsHeldOpenIllegally == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_assembly_point_signposted">Assembly point signposted and accessible</label>
        <select id="fire_safety_assembly_point_signposted" name="fire_safety.assembly_point_signposted">
            <option value="" {% if fire_safety.assemblyPointSignposted == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if fire_safety.assemblyPointSignposted == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if fire_safety.assemblyPointSignposted == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if fire_safety.assemblyPointSignposted == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="fire_safety_observations">Observations</label>
        <textarea id="fire_safety_observations" name="fire_safety.observations">{{ fire_safety.observations }}</textarea>
    </div>
</div>
