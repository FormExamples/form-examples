<div class="card">
    <h2>Step 7: Emergency Procedures</h2>
    <p class="form-hint">Evacuation, first aid, AED, contacts and drill exercises.</p>

    <div class="form-group">
        <label for="emergency_procedures_evacuation_procedure_posted">Evacuation procedure posted prominently</label>
        <select id="emergency_procedures_evacuation_procedure_posted" name="emergency_procedures.evacuation_procedure_posted">
            <option value="" {% if emergency_procedures.evacuationProcedurePosted == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.evacuationProcedurePosted == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.evacuationProcedurePosted == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.evacuationProcedurePosted == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_first_aid_kits_stocked">First-aid kits stocked and in date</label>
        <select id="emergency_procedures_first_aid_kits_stocked" name="emergency_procedures.first_aid_kits_stocked">
            <option value="" {% if emergency_procedures.firstAidKitsStocked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.firstAidKitsStocked == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.firstAidKitsStocked == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.firstAidKitsStocked == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_first_aider_roster_current">First-aider roster current</label>
        <select id="emergency_procedures_first_aider_roster_current" name="emergency_procedures.first_aider_roster_current">
            <option value="" {% if emergency_procedures.firstAiderRosterCurrent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.firstAiderRosterCurrent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.firstAiderRosterCurrent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.firstAiderRosterCurrent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_aed_available">AED (defibrillator) available</label>
        <select id="emergency_procedures_aed_available" name="emergency_procedures.aed_available">
            <option value="" {% if emergency_procedures.aedAvailable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.aedAvailable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.aedAvailable == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.aedAvailable == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_aed_service_in_date">AED service / battery / pad checks in date</label>
        <select id="emergency_procedures_aed_service_in_date" name="emergency_procedures.aed_service_in_date">
            <option value="" {% if emergency_procedures.aedServiceInDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.aedServiceInDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.aedServiceInDate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.aedServiceInDate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_emergency_contacts_displayed">Emergency contact numbers displayed</label>
        <select id="emergency_procedures_emergency_contacts_displayed" name="emergency_procedures.emergency_contacts_displayed">
            <option value="" {% if emergency_procedures.emergencyContactsDisplayed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.emergencyContactsDisplayed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.emergencyContactsDisplayed == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.emergencyContactsDisplayed == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_drill_conducted_last12_months">Drill / live exercise conducted in last 12 months</label>
        <select id="emergency_procedures_drill_conducted_last12_months" name="emergency_procedures.drill_conducted_last12_months">
            <option value="" {% if emergency_procedures.drillConductedLast12Months == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if emergency_procedures.drillConductedLast12Months == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if emergency_procedures.drillConductedLast12Months == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if emergency_procedures.drillConductedLast12Months == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="emergency_procedures_observations">Observations</label>
        <textarea id="emergency_procedures_observations" name="emergency_procedures.observations">{{ emergency_procedures.observations }}</textarea>
    </div>
</div>
