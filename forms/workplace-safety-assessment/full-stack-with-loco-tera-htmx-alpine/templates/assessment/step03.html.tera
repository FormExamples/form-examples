<div class="card">
    <h2>Step 3: Chemical &amp; Biological Hazards</h2>
    <p class="form-hint">COSHH register, SDS, labelling, storage, spills, sharps and waste.</p>

    <div class="form-group">
        <label for="chemical_biological_hazards_coshh_register_present">COSHH register is present and up to date</label>
        <select id="chemical_biological_hazards_coshh_register_present" name="chemical_biological_hazards.coshh_register_present">
            <option value="" {% if chemical_biological_hazards.coshhRegisterPresent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.coshhRegisterPresent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.coshhRegisterPresent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.coshhRegisterPresent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_sds_available">Safety Data Sheets (SDS) available</label>
        <select id="chemical_biological_hazards_sds_available" name="chemical_biological_hazards.sds_available">
            <option value="" {% if chemical_biological_hazards.sdsAvailable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.sdsAvailable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.sdsAvailable == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.sdsAvailable == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_chemicals_labelled_correctly">Chemicals labelled correctly per CLP</label>
        <select id="chemical_biological_hazards_chemicals_labelled_correctly" name="chemical_biological_hazards.chemicals_labelled_correctly">
            <option value="" {% if chemical_biological_hazards.chemicalsLabelledCorrectly == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.chemicalsLabelledCorrectly == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.chemicalsLabelledCorrectly == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.chemicalsLabelledCorrectly == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_chemicals_stored_securely">Chemicals stored securely (locked, segregated, ventilated)</label>
        <select id="chemical_biological_hazards_chemicals_stored_securely" name="chemical_biological_hazards.chemicals_stored_securely">
            <option value="" {% if chemical_biological_hazards.chemicalsStoredSecurely == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.chemicalsStoredSecurely == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.chemicalsStoredSecurely == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.chemicalsStoredSecurely == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_spill_kits_available">Spill kits available, accessible and stocked</label>
        <select id="chemical_biological_hazards_spill_kits_available" name="chemical_biological_hazards.spill_kits_available">
            <option value="" {% if chemical_biological_hazards.spillKitsAvailable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.spillKitsAvailable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.spillKitsAvailable == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.spillKitsAvailable == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_untreated_spills_observed">Any untreated chemical or biological spills observed?</label>
        <select id="chemical_biological_hazards_untreated_spills_observed" name="chemical_biological_hazards.untreated_spills_observed">
            <option value="" {% if chemical_biological_hazards.untreatedSpillsObserved == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if chemical_biological_hazards.untreatedSpillsObserved == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if chemical_biological_hazards.untreatedSpillsObserved == "yes" %}selected{% endif %}>Yes</option>
            <option value="na" {% if chemical_biological_hazards.untreatedSpillsObserved == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_sharps_containers_in_date">Sharps containers in date and not over-filled</label>
        <select id="chemical_biological_hazards_sharps_containers_in_date" name="chemical_biological_hazards.sharps_containers_in_date">
            <option value="" {% if chemical_biological_hazards.sharpsContainersInDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.sharpsContainersInDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.sharpsContainersInDate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.sharpsContainersInDate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_clinical_waste_segregated">Clinical waste correctly segregated</label>
        <select id="chemical_biological_hazards_clinical_waste_segregated" name="chemical_biological_hazards.clinical_waste_segregated">
            <option value="" {% if chemical_biological_hazards.clinicalWasteSegregated == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.clinicalWasteSegregated == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.clinicalWasteSegregated == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.clinicalWasteSegregated == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_biological_risk_assessment_current">Biological agent risk assessment current</label>
        <select id="chemical_biological_hazards_biological_risk_assessment_current" name="chemical_biological_hazards.biological_risk_assessment_current">
            <option value="" {% if chemical_biological_hazards.biologicalRiskAssessmentCurrent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if chemical_biological_hazards.biologicalRiskAssessmentCurrent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if chemical_biological_hazards.biologicalRiskAssessmentCurrent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if chemical_biological_hazards.biologicalRiskAssessmentCurrent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="chemical_biological_hazards_observations">Observations</label>
        <textarea id="chemical_biological_hazards_observations" name="chemical_biological_hazards.observations">{{ chemical_biological_hazards.observations }}</textarea>
    </div>
</div>
