<div class="card">
    <h2>Step 8: Training &amp; Competence</h2>
    <p class="form-hint">Mandatory training, fire marshals, manual handling, infection control and induction.</p>

    <div class="form-group">
        <label for="training_competence_mandatory_training_up_to_date">Mandatory training up to date for all staff</label>
        <select id="training_competence_mandatory_training_up_to_date" name="training_competence.mandatory_training_up_to_date">
            <option value="" {% if training_competence.mandatoryTrainingUpToDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.mandatoryTrainingUpToDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.mandatoryTrainingUpToDate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.mandatoryTrainingUpToDate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_fire_marshals_trained">Trained fire marshals appointed and on rota</label>
        <select id="training_competence_fire_marshals_trained" name="training_competence.fire_marshals_trained">
            <option value="" {% if training_competence.fireMarshalsTrained == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.fireMarshalsTrained == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.fireMarshalsTrained == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.fireMarshalsTrained == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_manual_handling_training_current">Manual handling training current</label>
        <select id="training_competence_manual_handling_training_current" name="training_competence.manual_handling_training_current">
            <option value="" {% if training_competence.manualHandlingTrainingCurrent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.manualHandlingTrainingCurrent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.manualHandlingTrainingCurrent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.manualHandlingTrainingCurrent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_infection_control_training_current">Infection control training current</label>
        <select id="training_competence_infection_control_training_current" name="training_competence.infection_control_training_current">
            <option value="" {% if training_competence.infectionControlTrainingCurrent == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.infectionControlTrainingCurrent == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.infectionControlTrainingCurrent == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.infectionControlTrainingCurrent == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_training_records_accessible">Training records accessible for audit</label>
        <select id="training_competence_training_records_accessible" name="training_competence.training_records_accessible">
            <option value="" {% if training_competence.trainingRecordsAccessible == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.trainingRecordsAccessible == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.trainingRecordsAccessible == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.trainingRecordsAccessible == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_induction_for_new_starters_completed">Induction completed for new starters</label>
        <select id="training_competence_induction_for_new_starters_completed" name="training_competence.induction_for_new_starters_completed">
            <option value="" {% if training_competence.inductionForNewStartersCompleted == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if training_competence.inductionForNewStartersCompleted == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if training_competence.inductionForNewStartersCompleted == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if training_competence.inductionForNewStartersCompleted == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="training_competence_observations">Observations</label>
        <textarea id="training_competence_observations" name="training_competence.observations">{{ training_competence.observations }}</textarea>
    </div>
</div>
