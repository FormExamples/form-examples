<div class="card">
    <h2>Step 2: PPE &amp; Hazard Controls</h2>
    <p class="form-hint">Personal protective equipment, signage, housekeeping and slip/trip hazards.</p>

    <div class="form-group">
        <label for="ppe_hazard_controls_ppe_available">Appropriate PPE is available for the task</label>
        <select id="ppe_hazard_controls_ppe_available" name="ppe_hazard_controls.ppe_available">
            <option value="" {% if ppe_hazard_controls.ppeAvailable == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.ppeAvailable == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.ppeAvailable == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.ppeAvailable == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_ppe_correctly_used">PPE is being correctly used by staff</label>
        <select id="ppe_hazard_controls_ppe_correctly_used" name="ppe_hazard_controls.ppe_correctly_used">
            <option value="" {% if ppe_hazard_controls.ppeCorrectlyUsed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.ppeCorrectlyUsed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.ppeCorrectlyUsed == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.ppeCorrectlyUsed == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_ppe_stock_maintained">PPE stock is maintained at adequate levels</label>
        <select id="ppe_hazard_controls_ppe_stock_maintained" name="ppe_hazard_controls.ppe_stock_maintained">
            <option value="" {% if ppe_hazard_controls.ppeStockMaintained == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.ppeStockMaintained == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.ppeStockMaintained == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.ppeStockMaintained == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_hazard_signage_visible">Hazard signage is visible where required</label>
        <select id="ppe_hazard_controls_hazard_signage_visible" name="ppe_hazard_controls.hazard_signage_visible">
            <option value="" {% if ppe_hazard_controls.hazardSignageVisible == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.hazardSignageVisible == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.hazardSignageVisible == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.hazardSignageVisible == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_signage_legible">Signage is legible and not faded</label>
        <select id="ppe_hazard_controls_signage_legible" name="ppe_hazard_controls.signage_legible">
            <option value="" {% if ppe_hazard_controls.signageLegible == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.signageLegible == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.signageLegible == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.signageLegible == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_housekeeping_satisfactory">General housekeeping is satisfactory</label>
        <select id="ppe_hazard_controls_housekeeping_satisfactory" name="ppe_hazard_controls.housekeeping_satisfactory">
            <option value="" {% if ppe_hazard_controls.housekeepingSatisfactory == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.housekeepingSatisfactory == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.housekeepingSatisfactory == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.housekeepingSatisfactory == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_slip_trip_hazards_controlled">Slip, trip and fall hazards are controlled</label>
        <select id="ppe_hazard_controls_slip_trip_hazards_controlled" name="ppe_hazard_controls.slip_trip_hazards_controlled">
            <option value="" {% if ppe_hazard_controls.slipTripHazardsControlled == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if ppe_hazard_controls.slipTripHazardsControlled == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if ppe_hazard_controls.slipTripHazardsControlled == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if ppe_hazard_controls.slipTripHazardsControlled == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="ppe_hazard_controls_observations">Observations</label>
        <textarea id="ppe_hazard_controls_observations" name="ppe_hazard_controls.observations"
                  placeholder="Optional notes for this section">{{ ppe_hazard_controls.observations }}</textarea>
    </div>
</div>
