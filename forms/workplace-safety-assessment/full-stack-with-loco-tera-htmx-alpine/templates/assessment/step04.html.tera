<div class="card">
    <h2>Step 4: Electrical Safety</h2>
    <p class="form-hint">PAT testing, fixed wiring, damage, sockets, leads and consumer units.</p>

    <div class="form-group">
        <label for="electrical_safety_pat_testing_in_date">Portable Appliance Testing (PAT) in date</label>
        <select id="electrical_safety_pat_testing_in_date" name="electrical_safety.pat_testing_in_date">
            <option value="" {% if electrical_safety.patTestingInDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if electrical_safety.patTestingInDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if electrical_safety.patTestingInDate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if electrical_safety.patTestingInDate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_fixed_wiring_test_in_date">Fixed wiring electrical installation test in date</label>
        <select id="electrical_safety_fixed_wiring_test_in_date" name="electrical_safety.fixed_wiring_test_in_date">
            <option value="" {% if electrical_safety.fixedWiringTestInDate == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if electrical_safety.fixedWiringTestInDate == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if electrical_safety.fixedWiringTestInDate == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if electrical_safety.fixedWiringTestInDate == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_damaged_equipment_observed">Any damaged electrical equipment observed?</label>
        <select id="electrical_safety_damaged_equipment_observed" name="electrical_safety.damaged_equipment_observed">
            <option value="" {% if electrical_safety.damagedEquipmentObserved == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if electrical_safety.damagedEquipmentObserved == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if electrical_safety.damagedEquipmentObserved == "yes" %}selected{% endif %}>Yes</option>
            <option value="na" {% if electrical_safety.damagedEquipmentObserved == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_overloaded_sockets_observed">Overloaded sockets / daisy-chained leads observed?</label>
        <select id="electrical_safety_overloaded_sockets_observed" name="electrical_safety.overloaded_sockets_observed">
            <option value="" {% if electrical_safety.overloadedSocketsObserved == "" %}selected{% endif %}>&mdash;</option>
            <option value="no" {% if electrical_safety.overloadedSocketsObserved == "no" %}selected{% endif %}>No</option>
            <option value="yes" {% if electrical_safety.overloadedSocketsObserved == "yes" %}selected{% endif %}>Yes</option>
            <option value="na" {% if electrical_safety.overloadedSocketsObserved == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_extension_leads_managed_safely">Extension leads managed safely (no trip hazards)</label>
        <select id="electrical_safety_extension_leads_managed_safely" name="electrical_safety.extension_leads_managed_safely">
            <option value="" {% if electrical_safety.extensionLeadsManagedSafely == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if electrical_safety.extensionLeadsManagedSafely == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if electrical_safety.extensionLeadsManagedSafely == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if electrical_safety.extensionLeadsManagedSafely == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_consumer_unit_accessible">Consumer unit / distribution board accessible and labelled</label>
        <select id="electrical_safety_consumer_unit_accessible" name="electrical_safety.consumer_unit_accessible">
            <option value="" {% if electrical_safety.consumerUnitAccessible == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if electrical_safety.consumerUnitAccessible == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if electrical_safety.consumerUnitAccessible == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if electrical_safety.consumerUnitAccessible == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="electrical_safety_observations">Observations</label>
        <textarea id="electrical_safety_observations" name="electrical_safety.observations">{{ electrical_safety.observations }}</textarea>
    </div>
</div>
