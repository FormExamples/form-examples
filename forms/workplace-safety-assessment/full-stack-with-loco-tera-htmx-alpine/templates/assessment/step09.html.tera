<div class="card">
    <h2>Step 9: Incident Reporting &amp; Near Misses</h2>
    <p class="form-hint">Reporting system, RIDDOR, near misses, counts and lessons learned.</p>

    <div class="form-group">
        <label for="incident_reporting_incident_reporting_system_used">Incident reporting system in active use</label>
        <select id="incident_reporting_incident_reporting_system_used" name="incident_reporting.incident_reporting_system_used">
            <option value="" {% if incident_reporting.incidentReportingSystemUsed == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if incident_reporting.incidentReportingSystemUsed == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if incident_reporting.incidentReportingSystemUsed == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if incident_reporting.incidentReportingSystemUsed == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="incident_reporting_riddor_reportable_incidents_reported">RIDDOR-reportable incidents reported to HSE</label>
        <select id="incident_reporting_riddor_reportable_incidents_reported" name="incident_reporting.riddor_reportable_incidents_reported">
            <option value="" {% if incident_reporting.riddorReportableIncidentsReported == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if incident_reporting.riddorReportableIncidentsReported == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if incident_reporting.riddorReportableIncidentsReported == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if incident_reporting.riddorReportableIncidentsReported == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="incident_reporting_near_miss_reporting_active">Near-miss reporting culture active</label>
        <select id="incident_reporting_near_miss_reporting_active" name="incident_reporting.near_miss_reporting_active">
            <option value="" {% if incident_reporting.nearMissReportingActive == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if incident_reporting.nearMissReportingActive == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if incident_reporting.nearMissReportingActive == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if incident_reporting.nearMissReportingActive == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="incident_reporting_incidents_last12_months">Incidents (last 12 months)</label>
            <input type="number" min="0" id="incident_reporting_incidents_last12_months"
                   name="incident_reporting.incidents_last12_months"
                   value="{{ incident_reporting.incidentsLast12Months }}">
        </div>
        <div class="form-group">
            <label for="incident_reporting_near_misses_last12_months">Near misses (last 12 months)</label>
            <input type="number" min="0" id="incident_reporting_near_misses_last12_months"
                   name="incident_reporting.near_misses_last12_months"
                   value="{{ incident_reporting.nearMissesLast12Months }}">
        </div>
    </div>

    <div class="form-group">
        <label for="incident_reporting_lessons_learned_shared">Lessons learned shared across the team</label>
        <select id="incident_reporting_lessons_learned_shared" name="incident_reporting.lessons_learned_shared">
            <option value="" {% if incident_reporting.lessonsLearnedShared == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if incident_reporting.lessonsLearnedShared == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if incident_reporting.lessonsLearnedShared == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if incident_reporting.lessonsLearnedShared == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="incident_reporting_actions_from_incidents_tracked">Actions arising from incidents tracked to completion</label>
        <select id="incident_reporting_actions_from_incidents_tracked" name="incident_reporting.actions_from_incidents_tracked">
            <option value="" {% if incident_reporting.actionsFromIncidentsTracked == "" %}selected{% endif %}>&mdash;</option>
            <option value="yes" {% if incident_reporting.actionsFromIncidentsTracked == "yes" %}selected{% endif %}>Yes</option>
            <option value="no" {% if incident_reporting.actionsFromIncidentsTracked == "no" %}selected{% endif %}>No</option>
            <option value="na" {% if incident_reporting.actionsFromIncidentsTracked == "na" %}selected{% endif %}>N/A</option>
        </select>
    </div>

    <div class="form-group">
        <label for="incident_reporting_observations">Observations</label>
        <textarea id="incident_reporting_observations" name="incident_reporting.observations">{{ incident_reporting.observations }}</textarea>
    </div>
</div>
