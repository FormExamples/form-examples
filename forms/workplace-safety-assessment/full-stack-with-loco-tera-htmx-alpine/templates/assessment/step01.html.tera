<div class="card">
    <h2>Step 1: Demographics &amp; Site Details</h2>
    <p class="form-hint">Identify the auditor, the site, and the scope of this audit.</p>

    <div class="form-row">
        <div class="form-group">
            <label for="site_details_auditor_name">Auditor Name</label>
            <input type="text" id="site_details_auditor_name" name="site_details.auditor_name"
                   value="{{ site_details.auditorName }}">
        </div>
        <div class="form-group">
            <label for="site_details_auditor_role">Auditor Role</label>
            <input type="text" id="site_details_auditor_role" name="site_details.auditor_role"
                   value="{{ site_details.auditorRole }}" placeholder="e.g. Safety Officer">
        </div>
        <div class="form-group">
            <label for="site_details_audit_date">Audit Date</label>
            <input type="date" id="site_details_audit_date" name="site_details.audit_date"
                   value="{{ site_details.auditDate }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="site_details_site_name">Site Name</label>
            <input type="text" id="site_details_site_name" name="site_details.site_name"
                   value="{{ site_details.siteName }}">
        </div>
        <div class="form-group">
            <label for="site_details_site_address">Site Address</label>
            <input type="text" id="site_details_site_address" name="site_details.site_address"
                   value="{{ site_details.siteAddress }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="site_details_department_area">Department / Area</label>
            <input type="text" id="site_details_department_area" name="site_details.department_area"
                   value="{{ site_details.departmentArea }}">
        </div>
        <div class="form-group">
            <label for="site_details_site_manager">Site Manager</label>
            <input type="text" id="site_details_site_manager" name="site_details.site_manager"
                   value="{{ site_details.siteManager }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="site_details_previous_audit_date">Previous Audit Date</label>
            <input type="date" id="site_details_previous_audit_date" name="site_details.previous_audit_date"
                   value="{{ site_details.previousAuditDate }}">
        </div>
        <div class="form-group">
            <label for="site_details_previous_findings_closed">Previous Findings Closed Out?</label>
            <select id="site_details_previous_findings_closed" name="site_details.previous_findings_closed">
                <option value="" {% if site_details.previousFindingsClosed == "" %}selected{% endif %}>&mdash;</option>
                <option value="yes" {% if site_details.previousFindingsClosed == "yes" %}selected{% endif %}>Yes</option>
                <option value="no" {% if site_details.previousFindingsClosed == "no" %}selected{% endif %}>No</option>
                <option value="na" {% if site_details.previousFindingsClosed == "na" %}selected{% endif %}>N/A</option>
            </select>
        </div>
    </div>
</div>
