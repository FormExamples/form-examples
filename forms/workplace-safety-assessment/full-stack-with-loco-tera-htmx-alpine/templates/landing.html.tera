{% extends "base.html.tera" %}

{% block title %}Workplace Safety Assessment - Home{% endblock %}

{% block content %}
<div class="landing">
    <div class="card landing-card">
        <h1>Workplace Safety Assessment</h1>
        <p class="landing-description">
            UK Health and Safety Executive (HSE) workplace safety audit. Covers physical,
            chemical, biological, ergonomic, and organisational risks to identify hazards
            and verify control measures across healthcare and clinical sites. The output
            is a signed, timestamped audit record with categorised findings and an
            action plan.
        </p>

        <div class="landing-features">
            <div class="feature">
                <h3>Ten Sections</h3>
                <p>Demographics, PPE, chemicals, electrical, fire, ergonomics, emergency procedures, training, incidents, and sign-off</p>
            </div>
            <div class="feature">
                <h3>HSE-Aligned Scoring</h3>
                <p>Compliant / Minor / Major / Critical findings with action timeframes (90 days, 30 days, immediate)</p>
            </div>
            <div class="feature">
                <h3>Safety Flags</h3>
                <p>RIDDOR reporting, COSHH gaps, fire-egress, damaged electrical equipment, untreated spills</p>
            </div>
        </div>

        <form method="POST" action="/assessment/new">
            <button type="submit" class="btn btn-primary btn-lg">
                Begin New Audit
            </button>
        </form>
    </div>
</div>
{% endblock %}
