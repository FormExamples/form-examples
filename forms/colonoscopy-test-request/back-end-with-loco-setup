#!/bin/sh
# setup.sh
#
# Setup script for the Loco back-end JSON API.
#
# - Create database user `loco` (if not exists).
# - Create application databases for development, test, production (if not exists).
# - Create Cargo Loco commands to generate JSON API scaffolds (--api).
#
# Tables are scaffolded in the same order as the form's sql-migrations/
# so that FK targets already exist when referencing tables are created.
#
# Generated by bin/back-end-with-loco/generate-back-end-with-loco-setup.py
# from sql-migrations/*.sql.
#
# Do not edit by hand — re-run the generator after changing the SQL migrations.

set -euf


echo "Scaffolding colonoscopy-test-request (6 tables)..."

cargo loco generate scaffold patient \
    deleted_at:ts \
    name:string! \
    birth_date:date! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    united_kingdom_nhs_number:string^ \
    waist_as_cm:double \
    height_as_cm:double \
    weight_as_kg:double \
    body_mass_index:double \
    waist_height_ratio:double \
    vo2_max:double \
    --api && \
cargo loco generate scaffold clinician \
    deleted_at:ts \
    name:text! \
    email:text \
    phone:text \
    postal_address_as_full_text:text \
    country_as_iso_3166_1_alpha_2:string \
    postcode:text \
    role:text! \
    registration_body:text! \
    registration_number:text! \
    united_kingdom_nhs_number:string^ \
    --api && \
cargo loco generate scaffold colonoscopy_test_request \
    deleted_at:ts \
    patient:references \
    clinician:references \
    status:string! \
    site_name:string! \
    setting:string! \
    referral_date:date \
    requested_by_date:date \
    procedure:string! \
    primary_indication:string! \
    clinical_question:string! \
    relevant_history:string! \
    red_flag_weight_loss:bool! \
    red_flag_anaemia:bool! \
    red_flag_abdominal_mass:bool! \
    red_flag_rectal_bleeding:bool! \
    fit_result_ug_g:double \
    haemoglobin_g_l:double \
    taking_anticoagulant:bool! \
    anticoagulant_agent:string! \
    taking_antiplatelet:bool! \
    antiplatelet_agent:string! \
    diabetes_medication:string! \
    fit_for_bowel_prep:bool! \
    bowel_prep_agent:string! \
    chronic_kidney_disease:bool! \
    egfr_ml_min:double \
    asa_grade:string! \
    urgency:string! \
    supervising_consultant:string! \
    requester_contact:string! \
    notes:string! \
    --api && \
cargo loco generate scaffold colonoscopy_test_request_grade \
    deleted_at:ts \
    colonoscopy_test_request:references \
    appropriateness_score:int \
    appropriateness_band:string! \
    triage_tier:string! \
    target_timeframe:string! \
    two_week_wait_eligible:bool! \
    two_week_wait_rationale:string! \
    completeness_percent:int \
    risk_band:string! \
    anticoagulant_action:string! \
    recommendation:string! \
    clinician_notes:text! \
    signed_at:ts \
    graded_at:ts! \
    --api && \
cargo loco generate scaffold colonoscopy_test_request_grade_rule \
    deleted_at:ts \
    colonoscopy_test_request_grade:references \
    rule_id:string! \
    axis:string! \
    category:string! \
    description:string! \
    --api && \
cargo loco generate scaffold colonoscopy_test_request_grade_flag \
    deleted_at:ts \
    colonoscopy_test_request_grade:references \
    flag_id:string! \
    category:string! \
    priority:string! \
    description:string! \
    suggested_action:string! \
    --api

echo "Done."
