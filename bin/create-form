#!/bin/sh
set -euf
top="$(git rev-parse --show-toplevel)"

form_name_as_kebab="$1"
form_name_as_snake=$(echo "$form_name_as_kebab" | snake-case)
form_dir="$top/forms/$form_name_as_kebab"

# Make a directory with AI-related files, in an idempotent manner.
# This function is only needed if there's a glitch with ./etc/skeleton.
mkdir_with_ai_idempotent() (
  # dir="$1"
  mkdir -p "$1"
  cd "$1"
  touch index.md
  ln -sfn index.md README.md
  touch AGENTS.md
  test -f CLAUDE.md || echo "@AGENTS.md" > CLAUDE.md
  touch plan.md
  touch tasks.md
)

# Create a form's directories and important files, in a idempotent manner.
# This function is only needed if there's a glitch with ./etc/skeleton.
create_idempotent() {
    mkdir_with_ai_idempotent "$dir"
    mkdir_with_ai_idempotent "$dir/doc"
    mkdir_with_ai_idempotent "$dir/fhir-r5"
    mkdir_with_ai_idempotent "$dir/front-end-dashboard-with-html"
    mkdir_with_ai_idempotent "$dir/front-end-dashboard-with-svelte"
    mkdir_with_ai_idempotent "$dir/front-end-form-with-html"
    mkdir_with_ai_idempotent "$dir/front-end-form-with-svelte"
    mkdir_with_ai_idempotent "$dir/full-stack-with-loco-tera-htmx-alpine"
    mkdir_with_ai_idempotent "$dir/full-stack-with-loco-tera-htmx-alpine-new"
    mkdir_with_ai_idempotent "$dir/protobuf"
    mkdir_with_ai_idempotent "$dir/sql-migrations"
    mkdir_with_ai_idempotent "$dir/typespec"
    mkdir_with_ai_idempotent "$dir/xml-representations"
}

create_form_loco_script() {
    # form_dir="$1"
    # form_name_as_snake="$2"
    file="$form_dir/full-stack-with-loco-tera-htmx-alpine/00-new.sh"
    cat << EOF > "$file"
#!/bin/sh
set -euf

createuser --host=localhost --port=5432 --username=postgres --login --createdb loco || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco ${form_name_as_snake}_development || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco ${form_name_as_snake}_test || :
createdb --host=localhost --port=5432 --username=postgres --owner=loco ${form_name_as_snake}_production || :
loco new --name ${form_name_as_kebab} --db postgres --bg async --assets serverside
EOF
    chmod +x "$file"
}

main() {
    rsync -av "$top/etc/skeleton/" "$form_dir/"
    create_form_loco_script "$form_dir" "$form_name_as_snake"
}

main
