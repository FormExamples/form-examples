#!/usr/bin/env python3
"""bin/axum-check-constraints — give each form's `back-end-with-axum/` the CHECK
constraints its `sql/` declares, so the database refuses what the form refuses.

The crates' migrations were generated without them, so a crate stored any
value: `"sex": "banana"` answered 200. This writes one migration per crate,
`20261107600000_check_constraints`, holding every CHECK from `sql/` whose
columns the crate's table has, each named as Postgres would name it
(`<table>_<column>_check`; a name over 63 bytes is cut and ends in a
hash of the whole, so two long names cannot collide).

Each constraint is added `NOT VALID`: new writes are checked at once, and rows
already stored are left alone, so a database holding an old bad row still
migrates and starts. `ALTER TABLE ... VALIDATE CONSTRAINT` checks those rows
once they are fixed.

It also writes `build.rs`, which tells Cargo to rebuild when `migrations/`
changes. `sqlx::migrate!` embeds the migrations at compile time, so without it
a new migration file is silently left out of the next build.

A CHECK naming a column the crate's table lacks is skipped and counted.

Usage:
  bin/axum-check-constraints <slug>...          # named forms
  bin/axum-check-constraints --all              # every form's Axum crate
  bin/axum-check-constraints --root DIR --all   # a copy of the repo at DIR
  bin/axum-check-constraints --check --all      # CI drift check (non-zero on drift)
"""

from __future__ import annotations

import argparse
import hashlib
import re
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import axum_crate as ac  # noqa: E402

STAMP = "20261107600000"
NAME = f"{STAMP}_check_constraints"
HEADER = "-- The CHECK constraints from sql/, so the database refuses what the form does.\n" \
         "-- NOT VALID: new writes are checked, and rows already stored are left alone.\n" \
         "-- Generated by bin/axum-check-constraints; do not edit.\n"
BUILD_RS = """//! Rebuild when a migration changes, because `sqlx::migrate!` embeds them.

#![forbid(unsafe_code)]

fn main() {
    println!("cargo:rerun-if-changed=migrations");
}
"""
CHECK = re.compile(r"\bCHECK\s*\(", re.I)
LIMIT = 63


def inside(text: str, start: int) -> str | None:
    """The text up to the paren that closes the one just before `start`."""
    depth, quoted = 1, False
    for index in range(start, len(text)):
        char = text[index]
        if char == "'":
            quoted = not quoted
        elif not quoted:
            depth += char == "("
            depth -= char == ")"
            if depth == 0:
                return text[start:index]
    return None


def sql_checks(form: Path) -> list[tuple[str, str | None, str]]:
    """(table, column or None, expression) for every CHECK in `sql/`."""
    found = []
    for path in sorted((form / "sql").glob("*.sql")):
        if path.name == "schema.sql":
            continue
        for table, body in ac.create_bodies(path.read_text()):
            for part in ac.split_top(body):
                head = part.split(None, 1)[0].strip('"')
                column = None if head.upper() in ac.TABLE_LEVEL else head
                for match in CHECK.finditer(part):
                    expression = inside(part, match.end())
                    if expression is not None:
                        found.append((table, column, " ".join(expression.split())))
    return found


def names_in(expression: str) -> set[str]:
    bare = re.sub(r"'(?:[^']|'')*'", "''", expression)
    return set(re.findall(r"\b([a-z_][a-z0-9_]*)\b", bare))


def migration(crate: Path) -> tuple[str, str, int, int]:
    """The up and down SQL, and how many CHECKs were kept and skipped."""
    form = crate.parent
    wanted = ac.sql_tables(form)
    migrated = ac.migration_tables(crate)
    up, down, used = [], [], Counter()
    skipped = 0
    for table, column, expression in sql_checks(form):
        target = ac.resolve(table, wanted[table], migrated) if table in wanted else None
        if target is None:
            skipped += 1
            continue
        have = {c.name for c in migrated[target].columns}
        mentioned = names_in(expression) & {c.name for c in wanted[table].columns}
        if not mentioned <= have:
            skipped += 1
            continue
        base = f"{target}_{column}_check" if column else f"{target}_check"
        used[base] += 1
        name = base if used[base] == 1 else f"{base}{used[base]}"
        if len(name) > LIMIT:
            # Cut names can collide, so a long one ends in a hash of the whole.
            name = f"{name[:LIMIT - 9]}_{hashlib.sha1(name.encode()).hexdigest()[:8]}"
        up.append(f'ALTER TABLE "{target}" ADD CONSTRAINT "{name}" CHECK ({expression}) NOT VALID;')
        down.append(f'ALTER TABLE "{target}" DROP CONSTRAINT IF EXISTS "{name}";')
    return HEADER + "\n".join(up) + "\n", "\n".join(reversed(down)) + "\n", len(up), skipped


def wanted_files(crate: Path) -> dict[Path, str]:
    """Every file this tool owns in a crate, with its content."""
    up, down, _, _ = migration(crate)
    return {
        crate / "migrations" / f"{NAME}.up.sql": up,
        crate / "migrations" / f"{NAME}.down.sql": down,
        crate / "build.rs": BUILD_RS,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("slugs", nargs="*")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--root", default=str(Path(__file__).resolve().parent.parent))
    args = parser.parse_args()
    if not args.all and not args.slugs:
        parser.error("name forms, or pass --all")
    crates = ac.crates(Path(args.root), args.slugs, args.all)
    crates = [c / "back-end-with-axum" if c.name != "back-end-with-axum" else c for c in crates]
    drift, changed, kept_total, skipped_total = [], 0, 0, 0
    for crate in crates:
        _, _, kept, skipped = migration(crate)
        kept_total += kept
        skipped_total += skipped
        for path, text in wanted_files(crate).items():
            current = path.read_text() if path.is_file() else None
            if current == text:
                continue
            if args.check:
                drift.append(f"{crate.parent.name}: {path.relative_to(crate)} is missing or stale")
            else:
                path.write_text(text)
                changed += 1
    if args.check:
        for line in drift:
            print(line)
        print(f"{len(crates)} crates, {kept_total} CHECK constraints, {skipped_total} skipped, "
              f"{len(drift)} file(s) out of step")
        return 1 if drift else 0
    print(f"axum-check-constraints: {changed} file(s) written; {kept_total} CHECK constraints "
          f"across {len(crates)} crates, {skipped_total} skipped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
