#!/usr/bin/env python3
"""bin/benchmark-gates — time the cheap, fleet-wide drift gates, several runs each.

BENCHMARKS.md claims the whole cheap set runs in about ten seconds. This measures it:
each gate is run --runs times (default 5, after one untimed warm-up), and the table
reports min, median and max wall-clock seconds plus the exit status. Run it on an
otherwise idle machine; numbers are only comparable on the same machine.

Gates that need a database, a browser or a Rust toolchain are not included (see
BENCHMARKS.md, "Gates not timed here").

Usage:
  bin/benchmark-gates [--runs N] [--markdown] [--max-total SECONDS]
--markdown prints a table ready to paste into BENCHMARKS.md. --max-total makes the
tool exit 1 if the sum of the medians exceeds SECONDS (a regression guard).
"""

from __future__ import annotations

import argparse
import os
import statistics
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GATES = [
    "bin/forms-as-kebab-case",
    "python3 bin/generate-forms-tsv.py --check",
    "bin/lily-svelte-refactor --check --all",
    "bin/lily-html-refactor --check --all",
    "python3 bin/generate-axum-deny-config.py --check",
    "python3 bin/generate-spec.py --check",
    "python3 bin/generate-tools-doc.py --check",
    "python3 bin/generate-llms-txt.py --check",
    "bin/test-security-policy",
    "bin/page-header-layout-refactor --check",
    "bin/test-examples-conformance",
    "bin/html-helpers-picker-rename --check",
    "python3 bin/generate-changelog-and-examples.py --check",
    "bin/test-engines",
    "bin/test-personas",
    "bin/test-vendored-uniformity",
    "bin/es-modules-refactor --check --all",
]


def time_gate(command: str) -> tuple[float, int]:
    start = time.perf_counter()
    result = subprocess.run(command, shell=True, cwd=REPO, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return time.perf_counter() - start, result.returncode


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--runs", type=int, default=5)
    parser.add_argument("--markdown", action="store_true")
    parser.add_argument("--max-total", type=float)
    args = parser.parse_args()
    rows, total = [], 0.0
    for command in GATES:
        time_gate(command)  # warm-up
        runs = [time_gate(command) for _ in range(args.runs)]
        seconds = [r[0] for r in runs]
        median = statistics.median(seconds)
        total += median
        rows.append((command, min(seconds), median, max(seconds), "ok" if runs[-1][1] == 0 else f"exit {runs[-1][1]}"))
    if args.markdown:
        print("| Gate | min | median | max | Outcome |\n| --- | --- | --- | --- | --- |")
        for c, lo, mid, hi, outcome in sorted(rows, key=lambda r: r[2]):
            print(f"| `{c}` | {lo:.2f} s | {mid:.2f} s | {hi:.2f} s | {outcome} |")
    else:
        for c, lo, mid, hi, outcome in sorted(rows, key=lambda r: r[2]):
            print(f"{mid:7.2f}s  (min {lo:.2f}, max {hi:.2f})  {outcome:8}  {c}")
    print(f"benchmark-gates: {len(rows)} gates, sum of medians {total:.1f} s")
    return 1 if args.max_total is not None and total > args.max_total else 0


if __name__ == "__main__":
    sys.exit(main())
