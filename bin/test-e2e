#!/bin/sh
set -eu
# bin/test-e2e — run the Playwright smoke + accessibility sweep over form
# front-ends. The HTML harness drives every form's single-page wizard from a
# static server; the Svelte harness builds and previews each app, then checks
# its welcome route.
#
# Usage:
#   bin/test-e2e [--html] [--svelte] [--all | <slug> ...]
#
#   --html      run the HTML front-end sweep (default if neither flag given)
#   --svelte    run the SvelteKit front-end sweep (build + preview per form)
#   --all       every form (default when no slugs are listed)
#   <slug> ...  restrict to the named forms
#
# Requires e2e/ deps installed (cd e2e && npm ci) and browsers
# (cd e2e && npx playwright install chromium).

top="$(git rev-parse --show-toplevel)"
cd "$top"

do_html=0
do_svelte=0
slugs=""
for arg in "$@"; do
    case "$arg" in
        --html) do_html=1 ;;
        --svelte) do_svelte=1 ;;
        --all) slugs="" ;;
        --*) echo "unknown flag: $arg" >&2; exit 2 ;;
        *) slugs="$slugs $arg" ;;
    esac
done
# Default target: HTML.
if [ "$do_html" -eq 0 ] && [ "$do_svelte" -eq 0 ]; then
    do_html=1
fi

# Resolve the slug set.
if [ -n "$slugs" ]; then
    FORMS="$(echo "$slugs" | xargs)"
else
    FORMS="$(bin/forms-as-kebab-case | xargs)"
fi
export FORMS

if [ "$do_html" -eq 1 ]; then
    echo "== HTML front-end E2E sweep (wizard a11y + dashboard export) =="
    ( cd e2e && npx playwright test html-smoke dashboard-export )
fi

if [ "$do_svelte" -eq 1 ]; then
    echo "== Svelte front-end E2E sweep =="
    # Kill whatever is actually bound to the preview port, by port rather than
    # by PID. `pnpm run preview &` interposes a pnpm process ahead of the real
    # `node .../vite.js preview`; `kill $!` only signals the pnpm wrapper, which
    # does not reliably forward the signal, so the real preview server can
    # survive as an orphan and keep serving a *previous* form's stale build to
    # every subsequent iteration (silent cross-form contamination).
    free_preview_port() {
        pids="$(lsof -tiTCP:4173 -sTCP:LISTEN 2>/dev/null || true)"
        [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true
    }
    # Track failures across the loop rather than letting `set -e` abort the
    # whole sweep on one bad form (install/build failure) or letting a
    # swallowed `|| true` mask a real test failure (a gate that can never
    # turn red is not a gate) — accumulate and report at the end instead.
    svelte_fail=0
    svelte_failed_forms=""
    for slug in $FORMS; do
        app="forms/$slug/front-end-with-svelte"
        [ -f "$app/package.json" ] || continue
        echo "-- $slug --"
        free_preview_port
        if ! ( cd "$app" && pnpm install --no-frozen-lockfile >/dev/null 2>&1 && pnpm run build >/dev/null 2>&1 ); then
            echo "::error::$slug: pnpm install/build failed" >&2
            svelte_fail=1
            svelte_failed_forms="$svelte_failed_forms $slug"
            continue
        fi
        # Preview on a fixed port; capture and kill afterward.
        ( cd "$app" && pnpm run preview --port 4173 --host 127.0.0.1 >/dev/null 2>&1 ) &
        preview_pid=$!
        # Wait for the port to accept connections.
        i=0
        while [ "$i" -lt 30 ]; do
            if curl -sf "http://127.0.0.1:4173/$slug/" >/dev/null 2>&1; then break; fi
            i=$((i + 1)); sleep 1
        done
        if ! BASE_URL="http://127.0.0.1:4173" SLUG="$slug" \
            sh -c 'cd e2e && npx playwright test svelte-smoke'; then
            echo "::error::$slug: svelte-smoke test failed" >&2
            svelte_fail=1
            svelte_failed_forms="$svelte_failed_forms $slug"
        fi
        kill "$preview_pid" 2>/dev/null || true
        wait "$preview_pid" 2>/dev/null || true
        free_preview_port
    done
    if [ "$svelte_fail" -ne 0 ]; then
        echo "Svelte E2E sweep: FAILED —$svelte_failed_forms" >&2
        exit 1
    fi
fi
