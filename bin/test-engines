#!/usr/bin/env node
/*
 * bin/test-engines — headless smoke gate for every HTML front-end scoring
 * engine.
 *
 * The HTML front-ends carry a pure scoring engine in js/ (types + rules +
 * grader + flags, sometimes under domain-specific filenames such as
 * nihss-grader.js). This gate loads each form's engine via the shared
 * bin/lib/engine-loader.js — real dynamic import() for the ES-module engines
 * (the fleet-wide state since the 2026-07 conversion), a vm sandbox for any
 * classic-script stragglers — discovers the grader and the default-state
 * factory, runs the grader over the default state, and asserts a structured
 * result. It catches engines that throw on load (a syntax or import
 * regression) or that fail to produce a well-formed grade, without a browser.
 *
 * Outcomes per form:
 *   PASS   engine loaded, grader ran over the default state, structured result
 *   SKIP   grader or default factory could not be discovered (reported, not
 *          failed — some forms compute inline in form-app.js)
 *   FAIL   an engine module threw on load/import, or the grader returned junk
 *
 * Usage:
 *   bin/test-engines                 # every form
 *   bin/test-engines <slug> ...      # only the named forms
 *   bin/test-engines --verbose       # list every form's outcome + detail
 *
 * Exit status is non-zero if any form FAILs. SKIPs never fail the gate but are
 * summarised so coverage is honest.
 */

'use strict';

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');
const { loadEngine } = require('./lib/engine-loader.js');

const REPO_ROOT = execSync('git rev-parse --show-toplevel').toString().trim();
const FORMS = path.join(REPO_ROOT, 'forms');

async function checkForm(slug) {
  const eng = await loadEngine(REPO_ROOT, slug);
  if (eng.error === 'no namespace') {
    return { slug, status: 'SKIP', detail: 'no engine namespace published' };
  }
  if (eng.error) {
    return { slug, status: 'FAIL', detail: `load error — ${eng.error}` };
  }
  const { ns, name, fns, grader, factory, loaded } = eng;

  // Discovery misses and input-shape mismatches are honestly SKIPs, not FAILs:
  // this gate only FAILs a form whose engine MODULE throws on load (a real
  // syntax/import regression, checked above). A PASS additionally proves the
  // grader runs over the default state and yields structured output.
  if (!grader) return { slug, status: 'SKIP', detail: `grader not found (${name}, ${fns.length} fns)` };
  if (!factory) return { slug, status: 'SKIP', detail: `default factory not found (grader=${grader})` };

  let state, result;
  try {
    state = ns[factory]();
  } catch (e) {
    return { slug, status: 'SKIP', detail: `factory ${factory}() needs args: ${String(e.message || e).split('\n')[0]}` };
  }
  try {
    result = ns[grader](state);
  } catch (e) {
    return { slug, status: 'SKIP', detail: `grader ${grader}() needs a fuller input: ${String(e.message || e).split('\n')[0]}` };
  }
  const ok = result !== null && result !== undefined &&
    (typeof result === 'object' || typeof result === 'number' || typeof result === 'string');
  if (!ok) {
    return { slug, status: 'SKIP', detail: `grader ${grader}() returned ${typeof result}` };
  }
  return { slug, status: 'PASS', detail: `${grader}(${factory}()) ok (${name}, ${loaded} modules)` };
}

async function main() {
  const args = process.argv.slice(2);
  const verbose = args.includes('--verbose');
  let slugs = args.filter((a) => !a.startsWith('--'));
  if (!slugs.length) {
    slugs = execSync(path.join(REPO_ROOT, 'bin', 'forms-as-kebab-case'))
      .toString().split('\n').map((s) => s.trim()).filter(Boolean)
      .filter((s) => fs.existsSync(path.join(FORMS, s, 'front-end-with-html', 'js')));
  }
  const results = [];
  for (const s of slugs) results.push(await checkForm(s));
  const by = { PASS: [], SKIP: [], FAIL: [] };
  for (const r of results) by[r.status].push(r);

  for (const r of results) {
    if (verbose || r.status === 'FAIL') {
      console.log(`${r.status}  ${r.slug}  — ${r.detail}`);
    }
  }
  console.log(`\ntest-engines: PASS ${by.PASS.length}  SKIP ${by.SKIP.length}  FAIL ${by.FAIL.length}  / ${results.length}`);
  if (by.SKIP.length && !verbose) {
    console.log('(run --verbose to see SKIP reasons — these forms compute inline or use an unrecognised entry point)');
  }
  process.exit(by.FAIL.length ? 1 : 0);
}

main();
