#!/usr/bin/env python3
"""bin/axum-axa-0-16 — move each form's `back-end-with-axum/` from axa 0.14 to 0.16.

What it changes in a crate:

  Cargo.toml                axa 0.16 and axa-test 0.7
  src/<snake>/app.rs        `cli::Command` has a `Health` variant in 0.16: `run` answers
                            it before connecting to anything, with `axa::cli::health`,
                            and the later `match` lists it beside `Check`
  Cargo.lock                axa 0.16 and axa-test 0.7, by
                            `cargo update -p axa -p axa-test`, so only axa's own crates
                            move; unless --no-lock

0.15 is skipped: axa-test 0.6 and axa 0.15 were superseded the same day. Nothing else in
the 0.15 or 0.16 upgrade guides touches these crates (no web sessions, no hand-built
`config::Server`, no MySQL queue, no `SETUP_STATEMENTS` match). The job queue's new setup
statements run at boot, as every crate uses `Queue::connect`.

Both versions were hours old when the fleet moved, inside the minimum publish age; the
lock step sets CARGO_RESOLVER_INCOMPATIBLE_PUBLISH_AGE=allow for that `cargo update`
only, so it works before and after the cooldown ends.

A crate already moved is skipped, so the tool can be rerun. A crate whose axa lines or
`run` function differ from the expected shape stops the run before anything is written.

Usage:
  bin/axum-axa-0-16 <slug>...          # named forms
  bin/axum-axa-0-16 --all              # every form's Axum crate
  bin/axum-axa-0-16 --all --no-lock    # leave Cargo.lock to `cargo update`
  bin/axum-axa-0-16 --root DIR <slug>  # a copy of forms/ at DIR
  bin/axum-axa-0-16 --check --all      # CI drift check (non-zero on drift)
"""

from __future__ import annotations

import argparse
import glob
import os
import re
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FEATURES = 'features = ["cursor-pagination", "postgres-sqlx", "queue", "ratelimit"] }'
OLD_AXA = f'axa = {{ version = "0.14", {FEATURES}'
NEW_AXA = f'axa = {{ version = "0.16", {FEATURES}'
OLD_TEST = 'axa-test = "0.5"\n'
NEW_TEST = 'axa-test = "0.7"\n'
LOCKED = (
    re.compile(r'^name = "axa"\nversion = "0\.16\.', re.M),
    re.compile(r'^name = "axa-test"\nversion = "0\.7\.', re.M),
)
CHECK_RETURN = "            return axa::cli::check(&environment, &defaults());\n        }\n"
HEALTH_RETURN = (
    "        if let Command::Health { ready, port } = cli.command {\n"
    "            return axa::cli::health(&environment, &defaults(), ready, port).await;\n"
    "        }\n"
)
CHECK_ARM = "            Command::Check => Ok(()),\n"
HEALTH_ARM = "            Command::Check | Command::Health { .. } => Ok(()),\n"


def locked(crate: str) -> bool:
    """Whether the crate's Cargo.lock has axa 0.16 and axa-test 0.7."""
    lock = open(f"{crate}/Cargo.lock").read()
    return all(pattern.search(lock) for pattern in LOCKED)


def app_path(crate: str) -> str:
    return glob.glob(f"{crate}/src/*/app.rs")[0]


def moved_app(text: str) -> bool:
    return HEALTH_RETURN in text and HEALTH_ARM in text


def rewrite_app(text: str) -> str | None:
    """`run` with the Health arms, or None if it is not the expected shape."""
    if moved_app(text):
        return text
    if text.count(CHECK_RETURN) != 1 or text.count(CHECK_ARM) != 1:
        return None
    return text.replace(CHECK_RETURN, CHECK_RETURN + HEALTH_RETURN).replace(CHECK_ARM, HEALTH_ARM)


def drift(crate: str) -> str | None:
    """Why a crate is not on axa 0.16, if it is not."""
    manifest = open(f"{crate}/Cargo.toml").read()
    if NEW_AXA not in manifest or NEW_TEST not in manifest:
        return "Cargo.toml is not on axa 0.16 and axa-test 0.7"
    if not moved_app(open(app_path(crate)).read()):
        return "app.rs does not answer Command::Health"
    if not locked(crate):
        return "Cargo.lock is not on axa 0.16 and axa-test 0.7"
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("slugs", nargs="*")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--no-lock", action="store_true")
    parser.add_argument("--root", default=f"{REPO}/forms")
    args = parser.parse_args()
    if args.all:
        crates = sorted(os.path.dirname(c) for c in glob.glob(f"{args.root}/*/back-end-with-axum/Cargo.toml"))
    elif args.slugs:
        crates = [f"{args.root}/{slug}/back-end-with-axum" for slug in args.slugs]
    else:
        parser.error("name forms, or pass --all")
    if args.check:
        bad = [(crate, why) for crate in crates if (why := drift(crate))]
        for crate, why in bad:
            print(f"{crate.split('/')[-2]}: {why}")
        print(f"{len(crates) - len(bad)}/{len(crates)} crates on axa 0.16")
        return 1 if bad else 0
    # Check every crate first, so one odd crate leaves the fleet as it was.
    manifests = {crate: open(f"{crate}/Cargo.toml").read() for crate in crates}
    apps = {crate: open(app_path(crate)).read() for crate in crates}
    odd = [c for c in crates
           if (NEW_AXA not in manifests[c] and (manifests[c].count(OLD_AXA) != 1 or manifests[c].count(OLD_TEST) != 1))
           or rewrite_app(apps[c]) is None]
    if odd:
        for crate in odd:
            print(f"stopped, nothing written: {crate}: expected the axa 0.14 lines and the 0.14 `run` once each", file=sys.stderr)
        return 1
    moved = 0
    for crate in crates:
        new = manifests[crate].replace(OLD_AXA, NEW_AXA).replace(OLD_TEST, NEW_TEST)
        app = rewrite_app(apps[crate])
        changed = new != manifests[crate] or app != apps[crate]
        if new != manifests[crate]:
            open(f"{crate}/Cargo.toml", "w").write(new)
        if app != apps[crate]:
            open(app_path(crate), "w").write(app)
        moved += changed
    failed = []
    if not args.no_lock:
        env = {**os.environ, "CARGO_RESOLVER_INCOMPATIBLE_PUBLISH_AGE": "allow"}
        for crate in crates:
            if locked(crate):
                continue
            result = subprocess.run(["cargo", "update", "-q", "-p", "axa", "-p", "axa-test"],
                                    cwd=crate, capture_output=True, text=True, env=env)
            if result.returncode or not locked(crate):
                failed.append(crate)
                print(f"{crate.split('/')[-2]}: cargo update failed: {result.stderr.strip()[-300:]}", file=sys.stderr)
    print(f"{moved} moved, {len(crates) - moved} already on axa 0.16, {len(failed)} lock failures")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
