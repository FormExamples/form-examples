#!/usr/bin/env python3
"""Check off stale per-form tasks.md/plan.md items whose artefact exists.

Every form's `forms/<slug>/tasks.md` (and `plan.md`) began life as
`bin/create-form`'s scaffold checklist. Fleet-wide tooling since then has
built almost all of that work directly (SQL migrations, generated
XML/FHIR/protobuf/OpenAPI, front-end-with-html/, front-end-with-svelte/,
back-end-with-loco/, doc/ pages, ...) without ever going back to tick the
original per-form checklist -- so ~1900 `- [ ]` lines across the fleet
describe work that is now actually done. The living, actually-maintained
backlog is the root `tasks.md`; this tool only closes the loop on these
stale per-form snapshots so they stop misleading a reader into thinking
the work is outstanding.

Deliberately conservative: a line is only ever flipped to `- [x]` when
*every* backtick-quoted token on it is a real, existing, non-empty file or
directory relative to that form's own directory (a small PATH_ALIASES map
covers two known post-scaffold reorgs -- `spec.md` -> `spec/index.md`,
`schema.sql` -> `sql/schema.sql` -- so lines written before those moves
aren't blocked by a rename that isn't a missing artefact). A line with no
backtick-quoted path token, or with any backtick span that looks like a
command invocation (contains a space, e.g. `bin/test-form <slug>` or
`cargo test`) rather than a path, is left untouched -- verifying "does
`cargo test` pass" requires a live Postgres per crate and is far too slow
to run fleet-wide here (~45s/crate observed).

A second, narrower whitelist (`PROSE_PREDICATES`) handles the highest-
frequency backtick-free scaffold phrasings (e.g. "Add Playwright
end-to-end tests", "Create SQL migration files") whose completion is
independently, mechanically verifiable against on-disk structure or
fleet-wide gates already documented in `AGENTS.md` (a form's `sql/`
directory being non-empty, a `*.test.ts` file existing in its engine
directory, `localStorage` actually appearing in its front-end source, ...).
Every other prose-only item -- anything not an exact match in that
whitelist, including real, still-outstanding work like clinical safety
case documentation, a GDPR DPIA, Zod schemas, or NHS PDS integration --
is left untouched rather than guessed at. This tool only ever adds `[x]`;
it never removes one or edits surrounding text.

Usage:
  bin/sync-form-tasks-checkboxes [--check] [--all|<slug>...]

--check reports the pending count per form (and exits 1 if any are
pending) without writing. Default applies the fix. With no slug and no
--all, defaults to every form (via bin/forms-as-kebab-case). Sweeps both
`tasks.md` and `plan.md` in each form directory.
"""
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

ITEM_RE = re.compile(r"^(\s*)- \[ \] (.*)$")
BACKTICK_RE = re.compile(r"`([^`]+)`")
# A bare relative path: word chars, dots, slashes, hyphens/underscores only.
PATH_LIKE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")

# Known post-scaffold renames: a token written before the move still names
# real, completed work -- just under the pre-reorg path.
PATH_ALIASES = {
    "spec.md": "spec/index.md",
    "schema.sql": "sql/schema.sql",
}


def all_slugs():
    out = subprocess.run(
        [os.path.join(ROOT, "bin", "forms-as-kebab-case")],
        cwd=ROOT, capture_output=True, text=True, check=True,
    )
    return [l.strip() for l in out.stdout.splitlines() if l.strip()]


def _artefact_at(form_dir: str, rel: str) -> bool:
    path = os.path.join(form_dir, rel)
    if os.path.isfile(path):
        return os.path.getsize(path) > 0
    if os.path.isdir(path):
        try:
            return any(os.scandir(path))
        except OSError:
            return False
    return False


def artefact_exists(form_dir: str, token: str) -> bool:
    rel = token.rstrip("/")
    if not rel:
        return False
    if _artefact_at(form_dir, rel):
        return True
    alias = PATH_ALIASES.get(rel)
    return alias is not None and _artefact_at(form_dir, alias)


def _any_exists(form_dir: str, *rels: str) -> bool:
    return any(artefact_exists(form_dir, r) for r in rels)


def _walk_files(form_dir: str, rel_dir: str):
    base = os.path.join(form_dir, rel_dir)
    if not os.path.isdir(base):
        return
    for root, _dirs, files in os.walk(base):
        for fn in files:
            yield root, fn


def _has_named_file(form_dir: str, rel_dir: str, names) -> bool:
    return any(fn in names for _root, fn in _walk_files(form_dir, rel_dir))


def _has_file_containing(form_dir: str, rel_dir: str, substr: str) -> bool:
    return any(substr in fn.lower() for _root, fn in _walk_files(form_dir, rel_dir))


def _grep_any(form_dir: str, rel_dir: str, needle: str, exts=(".js", ".ts")) -> bool:
    for root, fn in _walk_files(form_dir, rel_dir):
        if not fn.endswith(exts):
            continue
        try:
            with open(os.path.join(root, fn), encoding="utf-8", errors="ignore") as fh:
                if needle in fh.read():
                    return True
        except OSError:
            continue
    return False


def _front_end_exists(form_dir: str) -> bool:
    # Whichever stack exists, the root e2e suite's html-smoke/svelte-smoke
    # specs (both wired with axe-core) parameterize over every form slug
    # that has that stack, per e2e/tests/*.spec.ts + bin/test-e2e.
    return _any_exists(form_dir, "front-end-with-html/index.html", "front-end-with-svelte/package.json")


def _has_localstorage_usage(form_dir: str) -> bool:
    return _grep_any(form_dir, "front-end-with-html/js", "localStorage") or \
        _grep_any(form_dir, "front-end-with-svelte/src", "localStorage")


def _has_flagged_issues(form_dir: str) -> bool:
    return _has_named_file(form_dir, "front-end-with-svelte/src/lib/engine", {"flagged-issues.ts", "flags.ts"}) or \
        _has_named_file(form_dir, "front-end-with-html/js", {"flagged-issues.js", "flags.js"})


def _has_vitest_engine_tests(form_dir: str) -> bool:
    return any(fn.endswith(".test.ts") for _root, fn in
               _walk_files(form_dir, "front-end-with-svelte/src/lib/engine"))


def _has_pdf_generation(form_dir: str) -> bool:
    routes = os.path.join(form_dir, "front-end-with-svelte/src/routes")
    if os.path.isdir(routes):
        for root, _fn in _walk_files(form_dir, "front-end-with-svelte/src/routes"):
            if "pdf" in root.lower():
                return True
    return _has_file_containing(form_dir, "front-end-with-html/js", "pdf")


def _has_validation_engine(form_dir: str) -> bool:
    for rel_dir in ("front-end-with-svelte/src/lib/engine", "front-end-with-html/js"):
        for _root, fn in _walk_files(form_dir, rel_dir):
            low = fn.lower()
            if low.endswith(".test.ts"):
                continue
            if "validat" in low or "grader" in low or "grading" in low:
                return True
    return False


def _has_rust_backend(form_dir: str) -> bool:
    return artefact_exists(form_dir, "back-end-with-loco/Cargo.toml") and \
        artefact_exists(form_dir, "back-end-with-loco/src")


def _has_derived_artefacts(form_dir: str) -> bool:
    return _any_exists(form_dir, "xml") and _any_exists(form_dir, "fhir/r5") and \
        _any_exists(form_dir, "protobuf") and _any_exists(form_dir, "openapi") and \
        _any_exists(form_dir, "back-end-with-loco-setup")


# Exact-match, backtick-free scaffold phrasings whose completion is
# independently, mechanically verifiable -- see the module docstring.
PROSE_PREDICATES = {
    "Add Playwright end-to-end tests": _front_end_exists,
    "Playwright end-to-end tests.": _front_end_exists,
    "Add accessibility audit": _front_end_exists,
    "Axe-core accessibility audit.": _front_end_exists,
    "Create SQL migration files": lambda d: artefact_exists(d, "sql"),
    "Generate XML representations and DTDs": lambda d: artefact_exists(d, "xml"),
    "Generate FHIR R5 JSON resources": lambda d: artefact_exists(d, "fhir/r5"),
    "Add backend database migrations": lambda d: artefact_exists(d, "back-end-with-loco/migration"),
    "Implement flagged issues detection": _has_flagged_issues,
    "Add Vitest unit tests for grading logic": _has_vitest_engine_tests,
    "Add Vitest unit tests for validation logic": _has_vitest_engine_tests,
    "Add form autosave to localStorage": _has_localstorage_usage,
    "LocalStorage autosave with draft recovery.": _has_localstorage_usage,
    "Implement PDF report generation": _has_pdf_generation,
    "Implement PDF certificate generation": _has_pdf_generation,
    "Implement completeness validation engine": _has_validation_engine,
    "Implement Rust backend with Loco/Tera": _has_rust_backend,
    "Implement Rust backend with engine types": _has_rust_backend,
    "Implement dashboard with HTML/CSS/JS": lambda d: artefact_exists(d, "front-end-with-html/dashboard.html"),
    "Implement clinician dashboard with HTML/CSS/JS": lambda d: artefact_exists(d, "front-end-with-html/dashboard.html"),
    "Regenerate derived artefacts (XML, FHIR R5, protobuf, OpenAPI, Loco setup).": _has_derived_artefacts,
}


def classify_line(text: str):
    """Return ('paths', [tokens]) or ('command', None) or ('prose', None)."""
    spans = BACKTICK_RE.findall(text)
    if not spans:
        return "prose", None
    tokens = []
    for span in spans:
        if " " in span:
            # A command invocation (e.g. `bin/test-form foo`, `cargo test`),
            # not a path claim -- never mechanically verifiable here.
            return "command", None
        if PATH_LIKE_RE.match(span):
            tokens.append(span)
        # Non-path-shaped backtick spans (e.g. a bare identifier with no
        # slash/extension) are ignored rather than treated as a path claim.
    if not tokens:
        return "prose", None
    return "paths", tokens


def process_file(form_dir: str, path: str, apply: bool):
    if not os.path.isfile(path):
        return 0, 0
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()

    pending = 0
    changed = 0
    out = []
    for line in lines:
        m = ITEM_RE.match(line.rstrip("\n"))
        if not m:
            out.append(line)
            continue
        indent, rest = m.groups()
        kind, tokens = classify_line(rest)
        if kind == "paths":
            satisfied = all(artefact_exists(form_dir, t) for t in tokens)
        elif kind == "prose":
            predicate = PROSE_PREDICATES.get(rest.strip())
            satisfied = predicate(form_dir) if predicate else False
        else:
            satisfied = False
        if satisfied:
            pending += 1
            if apply:
                out.append(f"{indent}- [x] {rest}\n")
                changed += 1
            else:
                out.append(line)
        else:
            out.append(line)

    if apply and changed:
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(out)
    return pending, changed


def main():
    args = sys.argv[1:]
    check = "--check" in args
    args = [a for a in args if a != "--check"]
    if "--all" in args:
        args = [a for a in args if a != "--all"]
    slugs = args if args else all_slugs()

    total_pending = 0
    touched_forms = 0
    for slug in slugs:
        form_dir = os.path.join(ROOT, "forms", slug)
        form_pending = 0
        for filename in ("tasks.md", "plan.md"):
            pending, changed = process_file(
                form_dir, os.path.join(form_dir, filename), apply=not check
            )
            form_pending += pending
        if form_pending:
            total_pending += form_pending
            touched_forms += 1
            verb = "pending" if check else "checked off"
            print(f"{slug}: {form_pending} item(s) {verb}")

    label = "CHECK" if check else "APPLY"
    print(
        f"sync-form-tasks-checkboxes [{label}]: {total_pending} item(s) "
        f"across {touched_forms} form(s)"
    )
    if check and total_pending:
        sys.exit(1)


if __name__ == "__main__":
    main()
