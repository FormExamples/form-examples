#!/usr/bin/env python3
"""bin/loco-rs-1-migration — one-shot loco-rs 0.16 -> 1.0.1 major-version
migration for every form's `back-end-with-loco/` crate.

loco-rs 1.0.1 (2026-07-31) is the framework's first stable release, bumping
`sea-orm` 1.1 -> 2.0 along the way. Two changes hit every crate in this
monorepo mechanically:

  1. Feature-flag rename: `auth_jwt` -> `auth`, and the Postgres-only
     background-queue feature `bg_pg` -> the now-backend-agnostic `worker`
     (queue backend selection moved to the `config/*.yaml` `queue.kind:`
     value, already `Postgres` in every crate — no YAML change needed).
  2. `ColType::PkAuto` (used for every table's `id` column, and for every
     `:references` foreign-key column, across all 348 crates — this repo
     has never used `ColType::PkUuid`) now renders `BIGINT`/`BIGSERIAL`
     instead of `INTEGER`/`SERIAL` (loco-rs 1.0 changelog: "Generated
     primary/foreign keys are now 64-bit"). The generated migration SQL
     changes the moment the crate recompiles against loco-rs 1.0's
     `schema.rs`, even though no migration *source* line changed - so every
     entity's `id`/`*_id` field, and every controller Param/Path/`load_item`
     that carries one, must move `i32` -> `i64` to match.

Confirmed by hand on the reference crate
(forms/pre-operative-assessment-by-clinician/back-end-with-loco): after these
edits, `cargo build --all-targets`, `cargo test`, and `cargo clippy` are all
clean with zero migration-related errors. No other 0.16 -> 1.0 breaking change
(raw `Statement` calls, manual `AppContext` construction, `PageResponse`,
`Worker::perform_later`, `JWT::algorithm`, `Queue::None`) appears anywhere in
this monorepo's Loco crates (grepped fleet-wide before writing this tool).

What it rewrites, per crate:

  Cargo.toml
    loco-rs version 0.16 -> 1.0.1; feature list auth_jwt,bg_pg,... ->
    auth,...,worker (alphabetical, matching existing style); sea-orm version
    1.1 -> 2.0.
  migration/Cargo.toml
    sea-orm-migration version -> 2.0.
  src/**/*.rs (entities, controllers, and any hand-written module)
    Any `(id|*_id): i32` / `(id|*_id): Option<i32>` -> i64 / Option<i64>;
    any `Path<i32>` -> `Path<i64>`. Matched by identifier shape (bare `id`
    or `*_id`), not by file location, since one form
    (inpatient-clinical-note) carries a hand-written grading module with the
    same pattern outside controllers/_entities.

Cargo.lock is deliberately NOT regenerated by this tool (that needs `cargo
update`, which hits the network per crate) — run `cargo update` in each
touched crate afterwards, or see bin/loco-rs-1-migration's companion fleet
sweep in AGENTS/back-end-with-loco.md.

This is a one-shot migration tool (like bin/migrate-sql-filenames.py), not an
ongoing convention to re-enforce: once every crate is on loco-rs 1.0.1,
--check has nothing left to find and this tool has no more work to do.

Usage:
  bin/loco-rs-1-migration <slug>...        # named forms
  bin/loco-rs-1-migration --all            # every form's Loco crate
  bin/loco-rs-1-migration --dry-run --all  # show what would change
  bin/loco-rs-1-migration --check --all    # CI drift check (non-zero on drift)
"""

from __future__ import annotations

import argparse
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FORMS = ROOT / "forms"

OLD_LOCO_FEATURES = ["auth_jwt", "bg_pg", "cache_inmem", "cli", "with-db"]
NEW_LOCO_FEATURES = ["auth", "cache_inmem", "cli", "with-db", "worker"]

LOCO_RS_VERSION = re.compile(r'(loco-rs\s*=\s*\{\s*version\s*=\s*")0\.16(")')
SEA_ORM_VERSION = re.compile(r'(sea-orm\s*=\s*\{\s*version\s*=\s*")1\.1(")')
SEA_ORM_MIGRATION_VERSION = re.compile(
    r'(\[dependencies\.sea-orm-migration\]\s*\nversion\s*=\s*")1\.1(?:\.\d+)?(")'
)

# The loco-rs feature list, spanning the 5 lines between the `features = [`
# opener that follows the version pin and its closing `] }`.
LOCO_FEATURES_BLOCK = re.compile(
    r'(loco-rs\s*=\s*\{\s*version\s*=\s*"1\.0\.1",\s*default-features\s*=\s*false,\s*features\s*=\s*\[\n)'
    r"((?:\s*\"[a-z_-]+\",\n)+)(\s*\]\s*\})"
)

# `id` or `*_id` typed i32 / Option<i32>, matched by identifier shape so it
# catches struct fields and fn params alike, in generated and hand-written
# code alike.
ID_I32 = re.compile(r"\b(\w*_id|id): i32\b")
ID_OPTION_I32 = re.compile(r"\b(\w*_id|id): Option<i32>")
PATH_I32 = re.compile(r"\bPath<i32>")


def migrate_text(text: str, is_root_cargo_toml: bool) -> str:
    if is_root_cargo_toml:
        text = LOCO_RS_VERSION.sub(r"\g<1>1.0.1\g<2>", text)
        text = SEA_ORM_VERSION.sub(r"\g<1>2.0\g<2>", text)

        def replace_features(match: re.Match) -> str:
            body = "".join(f'  "{f}",\n' for f in NEW_LOCO_FEATURES)
            return match.group(1) + body + match.group(3)

        text = LOCO_FEATURES_BLOCK.sub(replace_features, text)
    text = ID_I32.sub(r"\1: i64", text)
    text = ID_OPTION_I32.sub(r"\1: Option<i64>", text)
    text = PATH_I32.sub("Path<i64>", text)
    return text


def process_crate(back_end: pathlib.Path, apply: bool) -> tuple[int, list[str]]:
    """Returns (number of files changed, notes)."""
    changed = 0
    notes: list[str] = []

    cargo_toml = back_end / "Cargo.toml"
    if cargo_toml.is_file():
        original = cargo_toml.read_text()
        if 'loco-rs = { version = "0.16"' in original:
            new = migrate_text(original, is_root_cargo_toml=True)
            if new != original:
                changed += 1
                if apply:
                    cargo_toml.write_text(new)
            if 'loco-rs = { version = "1.0.1"' not in new:
                notes.append(f"{cargo_toml}: loco-rs version substitution failed")
            if any(f'"{f}"' not in new for f in NEW_LOCO_FEATURES):
                notes.append(f"{cargo_toml}: feature-list substitution failed")

    migration_toml = back_end / "migration" / "Cargo.toml"
    if migration_toml.is_file():
        original = migration_toml.read_text()
        new = SEA_ORM_MIGRATION_VERSION.sub(r"\g<1>2.0\g<2>", original)
        if new != original:
            changed += 1
            if apply:
                migration_toml.write_text(new)

    src_dir = back_end / "src"
    if src_dir.is_dir():
        for path in sorted(src_dir.rglob("*.rs")):
            original = path.read_text()
            new = migrate_text(original, is_root_cargo_toml=False)
            if new != original:
                changed += 1
                if apply:
                    path.write_text(new)

    return changed, notes


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Migrate every form's Loco crate from loco-rs 0.16 to 1.0.1."
    )
    parser.add_argument("slugs", nargs="*", help="form slugs to process")
    parser.add_argument("--all", action="store_true", help="process every form")
    parser.add_argument(
        "--check", action="store_true", help="report drift; exit non-zero if any"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="report what would change"
    )
    args = parser.parse_args()

    if args.all:
        forms = sorted(
            p for p in FORMS.iterdir() if (p / "back-end-with-loco").is_dir()
        )
    elif args.slugs:
        forms = [FORMS / slug for slug in args.slugs]
    else:
        parser.error("give one or more slugs, or --all")

    apply = not (args.check or args.dry_run)
    drifted: list[tuple[str, int]] = []
    all_notes: list[str] = []

    for form in forms:
        back_end = form / "back-end-with-loco"
        if not back_end.is_dir():
            print(f"no such crate: {back_end}", file=sys.stderr)
            return 2
        count, notes = process_crate(back_end, apply)
        all_notes.extend(notes)
        if count:
            drifted.append((form.name, count))

    if all_notes:
        for note in all_notes:
            print(f"  note: {note}")

    total = sum(count for _, count in drifted)
    if args.check:
        if drifted:
            print(
                f"loco-rs 1.0.1 migration incomplete for {len(drifted)} form(s), "
                f"{total} file(s) (run: bin/loco-rs-1-migration --all)"
            )
            for name, count in drifted[:10]:
                print(f"  {name} ({count})")
            if len(drifted) > 10:
                print(f"  … and {len(drifted) - 10} more")
            return 1
        print(f"loco-rs 1.0.1 migration complete ({len(forms)} forms)")
        return 0

    verb = "would touch" if args.dry_run else "touched"
    print(f"{len(drifted)} form(s), {total} file(s) {verb}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
