#!/usr/bin/env python3
"""Give every SQL table an HTTP route in its form's Axum crate.

bin/axum-entity-routes [--check] [--root DIR] [--all|<slug>...]

Each table in forms/<slug>/sql/ must be reachable through the crate's API.
For a table no controller touches, this writes what is missing: the migration
(from sql/, in the fleet's type mapping, parents first), the model, a
controller under /api/<plural>, a request test, and the wiring. A table a
hand-written controller already reads or writes counts as reachable, so the
aggregate APIs of the cardiology and neurodiversity crates are left as they
are. Run bin/axum-soft-delete afterwards; it owns the delete and filter SQL.
--check lists every unreachable table and exits 1 if there is one.
"""

import argparse
import hashlib
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import axum_crate as ac  # noqa: E402

KEYWORDS = {"type", "match", "use", "ref", "move", "loop", "where", "fn", "mod", "in", "for", "self"}
STAMP = 20261107000000


def field(name):
    return f"r#{name}" if name in KEYWORDS else name


def words(name):
    return name.replace("_", " ").capitalize()


def rust_type(column):
    return f"Option<{column.rust}>" if column.nullable else column.rust


def reachable(crate):
    """Every table or model name a controller's code mentions."""
    names = set()
    for path in ac.source_dir(crate).glob("controllers/*.rs"):
        code = re.sub(r"//[^\n]*", "", path.read_text())
        names |= set(re.findall(r"\w+", code))
    return names


def sql_literal(text, indent=12):
    """A Rust string literal, wrapped with the fleet's backslash continuation."""
    pad = " " * indent
    lines, line = [], ""
    for word in text.split(" "):
        if line and len(line) + len(word) + 1 > 76:
            lines.append(line + " ")
            line = word
        else:
            line = f"{line} {word}" if line else word
    lines.append(line)
    joiner = "\\\n" + pad
    return '"' + joiner.join(lines) + '"'


def migration(table, name, resolved):
    rows = [
        "    created_at timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP,",
        "    updated_at timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP,",
        '    "id" uuid PRIMARY KEY,',
        '    "deleted_at" timestamp with time zone NULL,',
    ]
    keys = []
    for column in table.domain():
        row = f'    "{column.name}" {column.sql} {"NULL" if column.nullable else "NOT NULL"}'
        if column.default is not None:
            row += f" DEFAULT {column.default}"
        if column.unique:
            row += " UNIQUE"
        rows.append(row + ",")
        if column.references:
            parent = resolved[column.references]
            action = column.on_delete if column.on_delete != "NO ACTION" else "CASCADE"
            label = f"fk-{name}-{column.name}-to-{parent}"
            if len(label) > 63:  # Postgres would truncate it, and two could collide.
                label = "fk-" + hashlib.sha256(label.encode()).hexdigest()[:32]
            keys.append(
                f'    CONSTRAINT "{label}" FOREIGN KEY '
                f'("{column.name}") REFERENCES "{parent}" (id) '
                f"ON DELETE {action} ON UPDATE CASCADE,"
            )
    body = "\n".join(rows + keys).rstrip(",")
    text = f'CREATE TABLE IF NOT EXISTS "{name}" (\n{body}\n);\n\n'
    text += f"ALTER TABLE {name} ALTER COLUMN id SET DEFAULT gen_random_uuid();\n"
    for index, columns in enumerate(table.uniques):
        listed = ", ".join(f'"{c}"' for c in columns)
        text += f'CREATE UNIQUE INDEX IF NOT EXISTS "index_{name}_{index}_unique" ON "{name}" ({listed});\n'
    return text


def model(table, name):
    floats = any(c.rust == "f64" for c in table.domain())
    derive = "Clone, Debug, PartialEq, Serialize, Deserialize, sqlx::FromRow"
    if not floats:
        derive = derive.replace("PartialEq,", "PartialEq, Eq,")
    fields = "".join(
        f"    /// {words(c.name)}.\n    pub {field(c.name)}: {rust_type(c)},\n" for c in table.domain()
    )
    alias = "".join(part.capitalize() for part in name.split("_"))
    return f'''//! {words(name)} module.

use serde::{{Deserialize, Serialize}};

use crate::support::prelude::*;

/// Model.
#[derive({derive})]
#[serde(rename_all = "camelCase")]
pub struct Model {{
    /// Created at.
    pub created_at: DateTimeWithTimeZone,
    /// Updated at.
    pub updated_at: DateTimeWithTimeZone,
    /// ID.
    pub id: Uuid,
    /// Deleted at.
    pub deleted_at: Option<DateTimeWithTimeZone>,
{fields}}}
/// {words(name)}.
pub type {alias} = Model;

impl Model {{
    /// One page of rows in a stable order, and how many rows there are in all.
    ///
    /// # Errors
    ///
    /// Propagates the database error.
    pub async fn page(db: &PgPool, page: axa::pagination::Page) -> sqlx::Result<(Vec<Self>, i64)> {{
        let (limit, offset) = crate::support::paging::bounds(page);
        let rows = sqlx::query_as("SELECT * FROM {name} ORDER BY id LIMIT $1 OFFSET $2")
            .bind(limit)
            .bind(offset)
            .fetch_all(db)
            .await?;
        let total = sqlx::query_scalar("SELECT COUNT(*) FROM {name}")
            .fetch_one(db)
            .await?;
        Ok((rows, total))
    }}

    /// The row with this id, if there is one.
    ///
    /// # Errors
    ///
    /// Propagates the database error.
    pub async fn find_by_id(db: &PgPool, id: Uuid) -> sqlx::Result<Option<Self>> {{
        sqlx::query_as("SELECT * FROM {name} WHERE id = $1")
            .bind(id)
            .fetch_optional(db)
            .await
    }}

    /// Delete the row with this id.
    ///
    /// # Errors
    ///
    /// Propagates the database error.
    pub async fn delete(db: &PgPool, id: Uuid) -> sqlx::Result<()> {{
        sqlx::query("DELETE FROM {name} WHERE id = $1")
            .bind(id)
            .execute(db)
            .await?;
        Ok(())
    }}
}}
'''


def controller(table, name, module, model_name):
    domain = table.domain()
    params = "".join(
        f"    /// {words(c.name)}.\n    pub {field(c.name)}: {rust_type(c)},\n" for c in domain
    )
    names = ["deleted_at"] + [c.name for c in domain]
    marks = ", ".join(f"${i + 1}" for i in range(len(names)))
    insert = f"INSERT INTO {name} ({', '.join(names)}) VALUES ({marks}) RETURNING *"
    sets = ", ".join(f"{n} = ${i + 2}" for i, n in enumerate(names))
    update = f"UPDATE {name} SET {sets}, updated_at = now() WHERE id = $1 RETURNING *"

    def bind(column):
        copy = column.rust in ("bool", "i32", "f64", "Uuid", "Date", "Time", "DateTimeWithTimeZone")
        return f"        .bind({'' if copy else '&'}self.{field(column.name)})\n"

    binds = "".join(bind(c) for c in domain)
    return f'''//! {words(module)} module.

#![allow(clippy::missing_errors_doc)]
#![allow(clippy::unnecessary_struct_initialization)]
#![allow(clippy::unused_async)]
use crate::support::prelude::*;
use serde::{{Deserialize, Serialize}};

use crate::models::{model_name}::Model;

/// Params.
#[derive(Clone, Debug, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct Params {{
    /// Deleted at.
    pub deleted_at: Option<DateTimeWithTimeZone>,
{params}}}

impl Params {{
    /// Insert a row.
    async fn insert(&self, db: &PgPool) -> sqlx::Result<Model> {{
        sqlx::query_as(
            {sql_literal(insert)},
        )
        .bind(self.deleted_at)
{binds}        .fetch_one(db)
        .await
    }}

    /// Update the row with this id, if there is one.
    async fn update(&self, db: &PgPool, id: Uuid) -> sqlx::Result<Option<Model>> {{
        sqlx::query_as(
            {sql_literal(update)},
        )
        .bind(id)
        .bind(self.deleted_at)
{binds}        .fetch_optional(db)
        .await
    }}
}}

async fn load_item(ctx: &AppContext, id: Uuid) -> Result<Model> {{
    let item = Model::find_by_id(&db(ctx), id).await?;
    item.ok_or_else(|| Error::NotFound)
}}

/// List.
#[debug_handler]
pub async fn list(
    State(ctx): State<AppContext>,
    Query(params): Query<PageParams>,
) -> Result<Response> {{
    let page = paging::resolve(&params)?;
    let (rows, total) = Model::page(&db(&ctx), page).await?;
    paging::respond(page, total, rows)
}}

/// Add.
#[debug_handler]
pub async fn add(State(ctx): State<AppContext>, Json(params): Json<Params>) -> Result<Response> {{
    let item = params.insert(&db(&ctx)).await?;
    format::json(item)
}}

/// Update.
#[debug_handler]
pub async fn update(
    Path(id): Path<Uuid>,
    State(ctx): State<AppContext>,
    Json(params): Json<Params>,
) -> Result<Response> {{
    let item = params.update(&db(&ctx), id).await?.ok_or(Error::NotFound)?;
    format::json(item)
}}

/// Remove.
#[debug_handler]
pub async fn remove(Path(id): Path<Uuid>, State(ctx): State<AppContext>) -> Result<Response> {{
    load_item(&ctx, id).await?;
    Model::delete(&db(&ctx), id).await?;
    format::empty()
}}

/// Get one.
#[debug_handler]
pub async fn get_one(Path(id): Path<Uuid>, State(ctx): State<AppContext>) -> Result<Response> {{
    format::json(load_item(&ctx, id).await?)
}}

/// Routes.
pub fn routes() -> Routes {{
    Routes::new()
        .prefix("api/{name}/")
        .add("/", get(list))
        .add("/", post(add))
        .add("{{id}}", get(get_one))
        .add("{{id}}", delete(remove))
        .add("{{id}}", put(update))
        .add("{{id}}", patch(update))
}}
'''


def request_test(name, library):
    return f'''use axa::testing::prelude::*;
use {library}::app::App;
use serial_test::serial;

#[tokio::test]
#[serial]
async fn can_get_{name}() {{
    request::<App, _, _>(|request, _ctx| async move {{
        let res = request.get("/api/{name}").await;
        assert_eq!(res.status_code(), 200);
        assert!(res.json::<serde_json::Value>().is_array());
    }})
    .await;
}}
'''


def add_line(path, line):
    text = path.read_text()
    if line not in text.splitlines():
        path.write_text(text.rstrip("\n") + f"\n{line}\n")


def order(names, tables):
    """Parents before children, among the tables being created."""
    placed, result = set(), []
    pending = list(names)
    while pending:
        for name in pending:
            parents = {c.references for c in tables[name].columns if c.references}
            if not (parents & set(pending)) - {name}:
                pending.remove(name)
                placed.add(name)
                result.append(name)
                break
        else:
            raise ValueError(f"foreign key cycle among {pending}")
    return result


def plan(crate):
    form = crate.parent
    wanted = ac.sql_tables(form)
    migrated = ac.migration_tables(crate)
    names = reachable(crate)
    missing, resolved = [], {}
    for table in wanted:
        target = ac.resolve(table, wanted[table], migrated)
        resolved[table] = target or ac.plural(table)
        models = ac.source_dir(crate) / "models"
        if target and (target in names or table in names):
            continue
        missing.append((table, target, (models / f"{resolved[table]}.rs").is_file()))
    return wanted, resolved, migrated, missing


def write(crate, wanted, resolved, migrated, missing):
    source = ac.source_dir(crate)
    library = re.search(r"use (\w+)::app::App", (crate / "tests/requests/pagination.rs").read_text()
                        if (crate / "tests/requests/pagination.rs").exists()
                        else next(crate.glob("tests/*.rs")).read_text())[1]
    stamp = STAMP + 1
    for table in order([m[0] for m in missing], wanted):
        target, has_model = next((m[1], m[2]) for m in missing if m[0] == table)
        name = resolved[table]
        shape = migrated.get(name) or wanted[table]
        for column in shape.columns:
            if column.references:
                resolved.setdefault(column.references, column.references)
        if target is None:
            (crate / "migrations" / f"{stamp}_{name}.up.sql").write_text(
                migration(wanted[table], name, resolved))
            (crate / "migrations" / f"{stamp}_{name}.down.sql").write_text(f'DROP TABLE "{name}";\n')
            stamp += 1
        if not has_model:
            (source / "models" / f"{name}.rs").write_text(model(shape, name))
            add_line(source / "models" / "mod.rs", f"pub mod {name};")
        module = table if not (source / "controllers" / f"{table}.rs").exists() else name
        (source / "controllers" / f"{module}.rs").write_text(controller(shape, name, module, name))
        add_line(source / "controllers" / "mod.rs", f"pub mod {module};")
        app = source / "app.rs"
        text = app.read_text()
        marks = list(re.finditer(r"^ *\.add_route\(.*\n", text, re.M))
        end = marks[-1].end()
        app.write_text(text[:end] + f"            .add_route(crate::controllers::{module}::routes())\n" + text[end:])
        tests = crate / "tests" / "requests"
        if tests.is_dir():
            (tests / f"{name}_route.rs").write_text(request_test(name, library))
            add_line(tests / "mod.rs", f"mod {name}_route;")
        else:
            (crate / "tests" / f"{name}_route.rs").write_text("#![forbid(unsafe_code)]\n\n" + request_test(name, library))


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("slugs", nargs="*")
    args = parser.parse_args()
    bad, count = [], 0
    for path in ac.crates(args.root, args.slugs, args.all):
        crate = path if path.name == "back-end-with-axum" else path / "back-end-with-axum"
        wanted, resolved, migrated, missing = plan(crate)
        count += len(missing)
        if args.check:
            bad += [f"{crate.parent.name}: {m[0]}" for m in missing]
        elif missing:
            write(crate, wanted, resolved, migrated, missing)
            print(f"{crate.parent.name}: {', '.join(m[0] for m in missing)}")
    if args.check:
        print("\n".join(bad))
        print(f"{len(bad)} SQL tables without a route")
        return 1 if bad else 0
    print(f"{count} tables routed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
