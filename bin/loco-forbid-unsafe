#!/usr/bin/env python3
"""bin/loco-forbid-unsafe — add `#![forbid(unsafe_code)]` to every crate root
in every form's `back-end-with-loco/`.

Nothing in this monorepo's Rust needs `unsafe`: the crates are axum + Loco +
SeaORM request handlers over a relational schema, and a fleet-wide grep before
this tool was written found not one `unsafe` token in any crate source (the
sole match was the word "unsafe" inside a doc comment). `forbid` — rather than
`deny` — states that as a compiler-enforced invariant that a later inner
`#![allow(unsafe_code)]` cannot quietly reopen.

The attribute is per **crate root**, not per file, so each Cargo target needs
its own. Every form's crate has exactly four:

    src/<form_snake_case>/lib.rs           the library
    src/<form_snake_case>/bin/main.rs      the `<form_snake_case>-cli` binary
    migration/src/lib.rs                   the `migration` library
    tests/<name>.rs                        the integration-test target
                                           (`mod.rs` in 350 crates,
                                           `engine_tests.rs` in 5)

Insertion point, per file: after any leading `//!` crate-doc block and any
leading blank lines, and before everything else — so the attribute lands above
the existing `#![allow(...)]` runs (`migration/src/lib.rs` starts with two of
them) rather than between them. A file that already carries the attribute is
left alone: the twelve crates carrying hand-written rustdoc already have a
`// Always start with high quality coding conventions.` block, and eight of
those already had `#![forbid(unsafe_code)]` in `lib.rs` before this tool
existed.

This is an ongoing convention, not a one-shot migration. `cargo loco generate
scaffold` does not emit the attribute, so each form's generated
`back-end-with-loco-setup` script calls this tool as its final step, right
after `bin/route-loco-layout`; `--check` is the CI drift detector that catches
a crate which skipped it.

Usage:
  bin/loco-forbid-unsafe <slug>...        # named forms
  bin/loco-forbid-unsafe --all            # every form's Loco crate
  bin/loco-forbid-unsafe --dry-run --all  # show what would change
  bin/loco-forbid-unsafe --check --all    # CI drift check (non-zero on drift)
  bin/loco-forbid-unsafe --verbose --all  # list every file touched
"""

from __future__ import annotations

import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FORMS = ROOT / "forms"

ATTRIBUTE = "#![forbid(unsafe_code)]"


def crate_roots(back_end: pathlib.Path) -> list[pathlib.Path]:
    """Every Cargo target's root file in one form's Loco crate."""
    roots: list[pathlib.Path] = []

    src = back_end / "src"
    if src.is_dir():
        for module in sorted(p for p in src.iterdir() if p.is_dir()):
            lib = module / "lib.rs"
            if lib.is_file():
                roots.append(lib)
            for binary in sorted((module / "bin").glob("*.rs")):
                roots.append(binary)

    migration_lib = back_end / "migration" / "src" / "lib.rs"
    if migration_lib.is_file():
        roots.append(migration_lib)

    tests = back_end / "tests"
    if tests.is_dir():
        roots.extend(sorted(tests.glob("*.rs")))

    return roots


def insertion_index(lines: list[str]) -> int:
    """Index after any leading `//!` crate docs and blank lines."""
    index = 0
    while index < len(lines):
        stripped = lines[index].strip()
        if stripped == "" or stripped.startswith("//!"):
            index += 1
            continue
        break
    # Keep the attribute snug against the code: walk back over blank lines so a
    # doc block stays followed by exactly one blank line, not two.
    while index > 0 and lines[index - 1].strip() == "":
        index -= 1
    return index


def forbid_text(text: str) -> str:
    """Return `text` with the attribute inserted, or unchanged if present."""
    if ATTRIBUTE in text:
        return text

    lines = text.splitlines()
    index = insertion_index(lines)

    block = [ATTRIBUTE]
    following = lines[index] if index < len(lines) else ""
    if index > 0:
        block.insert(0, "")
    if following.strip() and not following.strip().startswith("#!["):
        block.append("")

    lines[index:index] = block
    return "\n".join(lines) + "\n"


def process_crate(back_end: pathlib.Path, apply: bool) -> list[pathlib.Path]:
    """Rewrite each crate root that lacks the attribute; return those paths."""
    touched: list[pathlib.Path] = []
    for path in crate_roots(back_end):
        original = path.read_text()
        new = forbid_text(original)
        if new != original:
            touched.append(path)
            if apply:
                path.write_text(new)
    return touched


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Add #![forbid(unsafe_code)] to every Loco crate root."
    )
    parser.add_argument("slugs", nargs="*", help="form slugs to process")
    parser.add_argument("--all", action="store_true", help="process every form")
    parser.add_argument(
        "--check", action="store_true", help="report drift; exit non-zero if any"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="report what would change"
    )
    parser.add_argument(
        "--verbose", action="store_true", help="list every file touched"
    )
    args = parser.parse_args()

    if args.all:
        forms = sorted(
            p for p in FORMS.iterdir() if (p / "back-end-with-loco").is_dir()
        )
    elif args.slugs:
        forms = [FORMS / slug for slug in args.slugs]
    else:
        parser.error("give one or more slugs, or --all")

    apply = not (args.check or args.dry_run)
    drifted: list[tuple[str, list[pathlib.Path]]] = []

    for form in forms:
        back_end = form / "back-end-with-loco"
        if not back_end.is_dir():
            print(f"no such crate: {back_end}", file=sys.stderr)
            return 2
        touched = process_crate(back_end, apply)
        if touched:
            drifted.append((form.name, touched))

    if args.verbose:
        for _, paths in drifted:
            for path in paths:
                print(f"  {path.relative_to(ROOT)}")

    total = sum(len(paths) for _, paths in drifted)
    if args.check:
        if drifted:
            print(
                f"missing {ATTRIBUTE} in {len(drifted)} form(s), "
                f"{total} crate root(s) (run: bin/loco-forbid-unsafe --all)"
            )
            for name, paths in drifted[:10]:
                print(f"  {name} ({len(paths)})")
            if len(drifted) > 10:
                print(f"  … and {len(drifted) - 10} more")
            return 1
        print(f"{ATTRIBUTE} present in every crate root ({len(forms)} forms)")
        return 0

    verb = "would gain" if args.dry_run else "gained"
    print(f"{len(drifted)} form(s), {total} crate root(s) {verb} {ATTRIBUTE}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
