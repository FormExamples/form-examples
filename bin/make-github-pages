#!/bin/sh
# bin/make-github-pages — publish formexamples.github.io/, per
# spec/monorepo-github-pages/. Delegate of `make github-pages`.
#
# This monorepo's GitHub Pages subproject (formexamples.github.io/) is
# maintained here, in-tree, like any other subproject. It is PUBLISHED by
# exporting its tree via `git subtree push` into the sibling, top-level,
# read-only repo github.com/FormExamples/formexamples.github.io — the
# GitHub-convention <org>.github.io repo, which GitHub auto-serves at the
# domain root (unlike a project repo's Pages, which nests under
# /<repo-name>/). The spec's own directive: never work directly in the
# sibling; always re-publish it from here via this tool.
#
# formexamples.github.io/.github/workflows/deploy.yml is inert in the
# monorepo (GitHub only reads .github/workflows/ at a repo's root) but
# becomes the sibling repo's real, root-level deploy workflow once
# exported — so the sibling repo builds and deploys itself on every push
# this tool makes to it, no separate setup needed there.
#
# The deploy workflow also builds every form's Svelte front-end into the site,
# served at /<slug>/ (formexamples.github.io/scripts/build-forms.mjs), from
# this monorepo's public main: push main before running this tool.
#
# Usage:
#   bin/make-github-pages              # export + push (same as `make github-pages`)
#   bin/make-github-pages --dry-run    # split only, don't push

set -euf

top="$(git rev-parse --show-toplevel)"
prefix="formexamples.github.io"
remote_name="github-pages"
remote_url="git@github.com:FormExamples/formexamples.github.io.git"
branch="pages-export"

cd "$top"

if ! git remote get-url "$remote_name" >/dev/null 2>&1; then
    git remote add "$remote_name" "$remote_url"
fi

if [ "${1:-}" = "--dry-run" ]; then
    git subtree split --prefix="$prefix" -b "$branch"
    echo "split only (--dry-run): branch '$branch' created, not pushed"
    exit 0
fi

before="$(git ls-remote "$remote_name" main | cut -f1)"
git subtree push --prefix="$prefix" "$remote_name" main
after="$(git ls-remote "$remote_name" main | cut -f1)"
echo "pushed $prefix/ -> $remote_url main"

# The site also builds every form's own Svelte front-end, fetched from this
# monorepo's main at deploy time (formexamples.github.io/scripts/build-forms.mjs).
# A change to a form alone leaves the subtree unchanged, so no push triggers
# the deploy: run the workflow directly instead.
if [ "$before" = "$after" ]; then
    if command -v gh >/dev/null 2>&1; then
        gh workflow run deploy.yml --repo FormExamples/formexamples.github.io --ref main
        echo "subtree unchanged: started the deploy workflow, to rebuild the forms"
    else
        echo "subtree unchanged; to rebuild the forms, run the deploy workflow of FormExamples/formexamples.github.io" >&2
    fi
fi
