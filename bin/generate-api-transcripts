#!/usr/bin/env python3
"""bin/generate-api-transcripts — record a real `examples/api-create.http`
transcript (POST-then-GET against the live `patient` endpoint) for every
Axum crate with the fleet's uniform `controllers/patient.rs` shape.

tasks.md's "API transcripts per form" item asks for a *recorded*
request/response against the seeded crate, not a reimplemented/faked
one — same fidelity rule this repo already applies to CSV/TSV export
samples (bin/generate-export-samples drives the real wizard rather than
reimplementing its serialiser). So this tool actually runs each crate:
drop and recreate its database, migrate it with the axa CLI (`db
migrate`), start the real server (`start`), POST a real request, GET it
back, capture both real HTTP transcripts, stop the server.

Its field parsing and value synthesis were copied from the retired
bin/loco-integration-test-rollout, so the POSTed body matches what the
crates' integration tests send and assert; this script does not re-decide
what a realistic patient record looks like.

Scoped to crates with `controllers/patient.rs` (336/360 fleet-wide,
as surveyed when the integration tests were written) -- the same
controller/`Params` shape those tests use. A crate with a
differently-shaped or absent patient controller (e.g. this repo's own
"gold reference", `cardiology-request`, whose only controller is a
hand-named `RequestParams` on its main table) is SKIPped, not guessed
at -- recording a meaningful transcript for those needs its own,
per-crate scoping pass, not a generic patient-table body.

This is SLOW: each crate needs its own migrate + a real `cargo run ...
start` (a fresh compile if not already built) + a POST/GET + shutdown
-- expect tens of seconds per crate even warm, not milliseconds. Not a
CI gate; a manual, occasional generator. `--jobs N` runs N crates at
once, each on its own port and database.

Usage:
    bin/generate-api-transcripts [--check] [<slug> ...]

--check reports which forms would change (by re-running the capture and
diffing with ids and timestamps masked, since a fresh row always gets
new ones), exits non-zero if any are pending. Default: capture and
write. The transcript always shows the crate's default port, whatever
port the run used.

Requires a Postgres where PGUSER can create databases, reached through
PGHOST, PGPORT and PGUSER (default 127.0.0.1, 5432, postgres; see
CONTRIBUTING.md's scratch-Postgres recipe). Each crate gets a fresh
database named after its `defaults()` database plus `_transcript`.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
FORMS_DIR = REPO_ROOT / "forms"

PARAMS_BLOCK_RE = re.compile(r"pub struct Params\s*\{(.*?)\n\s*\}", re.DOTALL)
FIELD_RE = re.compile(r"pub\s+(\w+)\s*:\s*([^,\n]+?)\s*,?\s*$", re.MULTILINE)
CHECK_ENUM_RE = re.compile(r"CHECK\s*\(\s*(\w+)\s+IN\s*\(([^)]+)\)\s*\)", re.IGNORECASE)
PREFIX_RE = re.compile(r'\.prefix\("api/([^"/]+)/?"\)')
PORT_RE = re.compile(r"^\s*port:\s*(\d+),", re.MULTILINE)
DATABASE_RE = re.compile(r'^\s*database:\s*"([\w-]+)",', re.MULTILINE)
VOLATILE_RE = re.compile(
    r'("(?:id|createdAt|updatedAt)": )"[^"]*"'
    r'|(GET http://localhost:\d+/api/[\w-]+/)[0-9a-f-]{36}'
)
BIN_NAME_RE = re.compile(r'name\s*=\s*"([\w-]+)"')


def to_camel_case(name: str) -> str:
    words = name.split("_")
    out = words[0]
    for w in words[1:]:
        if w:
            out += w[0].upper() + w[1:]
    return out


def parse_check_enums(sql_text: str) -> dict[str, list[str]]:
    enums = {}
    for m in CHECK_ENUM_RE.finditer(sql_text):
        values = re.findall(r"'([^']*)'", m.group(2))
        if values:
            enums[m.group(1)] = values
    return enums


def first_non_empty(values: list[str]) -> str:
    for v in values:
        if v != "":
            return v
    return values[0] if values else ""


NAME_HEURISTICS: list[tuple[re.Pattern, object]] = [
    (re.compile(r"^name$"), "Test Patient"),
    (re.compile(r"email"), "test.patient@example.com"),
    (re.compile(r"phone"), "+441234567890"),
    (re.compile(r"postal_address"), "10 Downing Street, London"),
    (re.compile(r"^postcode$"), "SW1A 2AA"),
    (re.compile(r"iso_639_1"), "en"),
    (re.compile(r"iso_3166_1_alpha_3"), "GBR"),
    (re.compile(r"iso_3166_1_alpha_2"), "GB"),
    (re.compile(r"country_as_iso"), "GB"),
    (re.compile(r"^state$"), "CA"),
    (re.compile(r"zip_code"), "90210"),
    (re.compile(r"social_security_number"), "123-45-6789"),
    # Distinct from the seed fixtures' "9434765919": the
    # seed fixture already inserted a patient row with that NHS number,
    # and this generator's own POST must not collide with it under the
    # column's unique constraint.
    (re.compile(r"nhs_number"), "9434765928"),
    (re.compile(r"hospital_mrn|^mrn$"), "MRN-000123"),
    (re.compile(r"allergies"), "No known allergies"),
    (re.compile(r"height_as_cm"), 170.2),
    (re.compile(r"weight_as_kg"), 70.4),
    (re.compile(r"body_mass_index"), 24.2),
    (re.compile(r"waist_as_cm"), 85.0),
    (re.compile(r"waist_height_ratio"), 0.5),
    (re.compile(r"vo2_max"), 35.0),
    (re.compile(r"birth_date"), "1990-01-01"),
]


def _heuristic_type_compatible(heuristic_value, inner_type: str) -> bool:
    """A name-based heuristic match is only safe to use if its value type
    fits the column's actual type -- e.g. `risk_factors_allergies: bool`
    matches the "allergies" heuristic by substring, but that heuristic's
    string value ("No known allergies") can't deserialize into a bool."""
    if isinstance(heuristic_value, bool):
        return inner_type == "bool"
    if isinstance(heuristic_value, float):
        return inner_type in ("f64", "f32", "Decimal")
    if isinstance(heuristic_value, str):
        return inner_type not in ("bool", "i64", "i32", "f64", "f32", "Decimal")
    return True


SIZED_RE = re.compile(r"^\s*(\w+)\s+(?:VARCHAR|CHAR)\s*\(\s*(\d+)\s*\)", re.IGNORECASE | re.MULTILINE)


def parse_lengths(sql_text: str) -> dict[str, int]:
    return {m.group(1): int(m.group(2)) for m in SIZED_RE.finditer(sql_text)}


def pick_value(field_name: str, rust_type: str, enums: dict[str, list[str]]):
    inner_type = rust_type[len("Option<"):-1] if rust_type.startswith("Option<") else rust_type
    if inner_type == "DateTimeWithTimeZone" and field_name == "deleted_at":
        return None
    if field_name in enums:
        return first_non_empty(enums[field_name])
    for pattern, heuristic_value in NAME_HEURISTICS:
        if pattern.search(field_name) and _heuristic_type_compatible(heuristic_value, inner_type):
            return heuristic_value
    if inner_type == "String":
        return f"Test {to_camel_case(field_name)}"
    if inner_type == "Date":
        return "1990-01-01"
    if inner_type == "DateTimeWithTimeZone":
        return "2026-01-01T00:00:00Z"
    if inner_type in ("f64", "f32"):
        return 1.0
    if inner_type == "Decimal":
        return "1.0"
    if inner_type in ("i64", "i32"):
        return 1
    if inner_type == "bool":
        return True
    return None  # unhandled -- caller SKIPs the whole crate


def build_patient_body(controller_text: str, sql_text: str) -> dict | None:
    m = PARAMS_BLOCK_RE.search(controller_text)
    if not m:
        return None
    enums = parse_check_enums(sql_text) if sql_text else {}
    lengths = parse_lengths(sql_text) if sql_text else {}
    body = {}
    for fm in FIELD_RE.finditer(m.group(1)):
        name, rust_type = fm.group(1), fm.group(2).strip()
        if name == "deleted_at":
            continue
        value = pick_value(name, rust_type, enums)
        if isinstance(value, str) and name in lengths:
            value = value[: lengths[name]]  # the crate refuses a value past its length
        if value is None and not rust_type.startswith("Option<"):
            return None
        if value is not None:
            body[to_camel_case(name)] = value
    return body if body else None


def run(cmd: list[str], cwd: Path, env: dict, timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)


def last_line(text: str) -> str:
    lines = [l for l in (text or "").strip().splitlines() if l.strip()]
    return lines[-1] if lines else "unknown"


def find_bin_name(cargo_toml: str) -> str | None:
    m = re.search(r"\[\[bin\]\]\s*\nname\s*=\s*\"([\w-]+)\"", cargo_toml)
    return m.group(1) if m else None


def pg_env() -> dict:
    return {
        "host": os.environ.get("PGHOST", "127.0.0.1"),
        "port": os.environ.get("PGPORT", "5432"),
        "user": os.environ.get("PGUSER", "postgres"),
        "password": os.environ.get("PGPASSWORD", ""),
    }


def fresh_database(name: str) -> str | None:
    """Drops and recreates database `name`, so every capture starts from
    an empty schema. Returns an error string, or None on success."""
    pg = pg_env()
    psql = ["psql", "-h", pg["host"], "-p", pg["port"], "-U", pg["user"], "-d", "postgres",
            "-v", "ON_ERROR_STOP=1", "-c"]
    for sql in (f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE);', f'CREATE DATABASE "{name}";'):
        r = subprocess.run(psql + [sql], capture_output=True, text=True)
        if r.returncode != 0:
            return f"cannot create database: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else 'psql failed'}"
    return None


def database_url(name: str) -> str:
    pg = pg_env()
    auth = pg["user"] + (f":{pg['password']}" if pg["password"] else "")
    return f"postgres://{auth}@{pg['host']}:{pg['port']}/{name}"


def fresh_database_drop(name: str) -> None:
    pg = pg_env()
    subprocess.run(["psql", "-h", pg["host"], "-p", pg["port"], "-U", pg["user"], "-d", "postgres",
                    "-c", f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE);'], capture_output=True, text=True)


def mask(text: str) -> str:
    return VOLATILE_RE.sub(lambda m: (m.group(1) + '"…"') if m.group(1) else (m.group(2) + "…"), text)


def wait_for_port(port: int, timeout: float = 20.0) -> bool:
    import socket

    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1):
                return True
        except OSError:
            time.sleep(0.5)
    return False


def http_json(method: str, url: str, body: dict | None = None) -> tuple[int, dict | str]:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read().decode()
            try:
                return resp.status, json.loads(raw)
            except json.JSONDecodeError:
                return resp.status, raw
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            return e.code, json.loads(raw)
        except json.JSONDecodeError:
            return e.code, raw


def render_transcript(slug: str, base_url: str, path: str, req_body: dict, post_status: int, post_resp, get_status: int, get_resp) -> str:
    def fmt(status, resp):
        body = json.dumps(resp, indent=2) if isinstance(resp, (dict, list)) else str(resp)
        return f"HTTP {status}\nContent-Type: application/json\n\n{body}\n"

    rid = post_resp.get("id") if isinstance(post_resp, dict) else None
    return (
        f"### Real transcript recorded against a live seeded instance of the\n"
        f"### {slug} Axum crate. Generated by bin/generate-api-transcripts --\n"
        f"### re-run it after a schema change rather than hand-editing.\n\n"
        f"POST {base_url}{path.rstrip('/')}\n"
        f"Content-Type: application/json\n\n"
        f"{json.dumps(req_body, indent=2)}\n\n"
        f"{fmt(post_status, post_resp)}\n"
        f"###\n\n"
        f"GET {base_url}{path}{rid}\n\n"
        f"{fmt(get_status, get_resp)}"
    )


def capture_crate(slug: str, write: bool, run_port: int) -> tuple[str, str]:
    crate_dir = FORMS_DIR / slug / "back-end-with-axum"
    src_dirs = [d for d in crate_dir.glob("src/*/") if (d / "controllers" / "mod.rs").is_file()]
    if not src_dirs:
        return "SKIP", "no crate src dir found"
    src_dir = src_dirs[0]
    controller = src_dir / "controllers" / "patient.rs"
    if not controller.is_file():
        return "SKIP", "no controllers/patient.rs (non-uniform crate)"

    sql_dir = FORMS_DIR / slug / "sql"
    sql_candidates = list(sql_dir.glob("*create_table_patient.sql"))
    sql_text = sql_candidates[0].read_text() if sql_candidates else ""

    controller_text = controller.read_text()
    body = build_patient_body(controller_text, sql_text)
    if body is None:
        return "SKIP", "unhandled Params field type or shape"

    m_prefix = PREFIX_RE.search(controller_text)
    if not m_prefix:
        return "SKIP", "no .prefix(\"api/...\") found in controllers/patient.rs"
    path = f"/api/{m_prefix.group(1)}/"

    app_rs = (src_dir / "app.rs").read_text()
    m_port = PORT_RE.search(app_rs)
    port = int(m_port.group(1)) if m_port else 5150
    m_db = DATABASE_RE.search(app_rs)
    if not m_db:
        return "SKIP", "no database name in app.rs defaults()"
    dbname = f"{m_db.group(1)}_transcript"

    cargo_toml = (crate_dir / "Cargo.toml").read_text()
    bin_name = find_bin_name(cargo_toml)
    if not bin_name:
        return "SKIP", "no [[bin]] in Cargo.toml"

    db_err = fresh_database(dbname)
    if db_err:
        return "SKIP", db_err
    env = {**os.environ, "APP_ENV": "development", "DATABASE_URL": database_url(dbname)}

    migrate = run(["cargo", "run", "-q", "--bin", bin_name, "--", "db", "migrate"], crate_dir, env, timeout=900)
    if migrate.returncode != 0:
        return "SKIP", f"db migrate failed: {last_line(migrate.stderr)}"

    proc = subprocess.Popen(
        ["cargo", "run", "-q", "--bin", bin_name, "--", "start",
         "--binding", "127.0.0.1", "--port", str(run_port)],
        cwd=crate_dir, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    try:
        if not wait_for_port(run_port, timeout=120):
            return "SKIP", f"server never listened on port {run_port}"
        run_url = f"http://127.0.0.1:{run_port}"
        # POST mounts at the bare prefix (no trailing slash); GET-by-id
        # keeps the prefix's own trailing slash before the id.
        post_status, post_resp = http_json("POST", f"{run_url}{path.rstrip('/')}", body)
        if post_status not in (200, 201) or not isinstance(post_resp, dict) or "id" not in post_resp:
            detail = post_resp.get("detail") if isinstance(post_resp, dict) else None
            return "SKIP", f"POST {path.rstrip('/')} did not return a created record (status {post_status}{': ' + detail if detail else ''})"
        rid = post_resp["id"]
        get_status, get_resp = http_json("GET", f"{run_url}{path}{rid}")
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
        fresh_database_drop(dbname)

    base_url = f"http://localhost:{port}"
    transcript = render_transcript(slug, base_url, path, body, post_status, post_resp, get_status, get_resp)
    out_path = FORMS_DIR / slug / "examples" / "api-create.http"
    current = out_path.read_text() if out_path.is_file() else None
    if current is not None and mask(current) == mask(transcript):
        return "unchanged", "already up to date"
    if write:
        out_path.write_text(transcript)
    return "changed", f"POST {path} -> {post_status}, GET -> {get_status}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("slugs", nargs="*", help="form slugs (default: every eligible form)")
    parser.add_argument("--check", action="store_true", help="report drift; exit 1 if any pending; don't write")
    parser.add_argument("--jobs", type=int, default=1, help="crates to capture at once (default 1)")
    args = parser.parse_args()

    if args.slugs:
        slugs = args.slugs
    else:
        out = subprocess.run(["bin/forms-as-kebab-case"], cwd=REPO_ROOT, capture_output=True, text=True)
        slugs = [s.strip() for s in out.stdout.splitlines() if s.strip()]

    import queue
    from concurrent.futures import ThreadPoolExecutor

    jobs = max(1, args.jobs)
    ports: queue.Queue[int] = queue.Queue()
    for n in range(jobs):
        ports.put(15150 + n)

    def capture(slug: str) -> tuple[str, str]:
        port = ports.get()
        try:
            return capture_crate(slug, not args.check, port)
        except Exception as e:  # one crate's failure must not stop the run
            return "SKIP", f"{type(e).__name__}: {e}"
        finally:
            ports.put(port)

    with ThreadPoolExecutor(max_workers=jobs) as pool:
        results = list(pool.map(capture, slugs))

    changed, unchanged, skipped = [], 0, {}
    for slug, (status, detail) in zip(slugs, results):
        if status == "changed":
            changed.append(slug)
            print(f"  {slug}: {detail}")
        elif status == "unchanged":
            unchanged += 1
        else:
            skipped.setdefault(detail, []).append(slug)

    total_skip = sum(len(v) for v in skipped.values())
    verb = "would change" if args.check else "changed"
    print(f"generate-api-transcripts: {len(changed)} form(s) {verb}, {unchanged} up to date, {total_skip} SKIP")
    for reason, sl in sorted(skipped.items(), key=lambda kv: -len(kv[1])):
        print(f"  SKIP ({len(sl)}): {reason}")
    return 1 if (args.check and changed) else 0


if __name__ == "__main__":
    sys.exit(main())
