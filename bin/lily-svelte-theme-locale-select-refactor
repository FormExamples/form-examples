LOCALE_SELECT_SVELTE = '<script lang="ts" module>\n\t// Lily Design System — LocaleSelect (headless button + listbox).\n\t// Mirrors lily-design-system-svelte-helpers/lily-design-system-svelte-locale-select:\n\t// the headless sibling of ThemeSelect. Manages `lang`/`dir` on the target\n\t// element and localStorage persistence; the listbox and button are\n\t// component-owned, replacing the old native <select>.\n\timport type { Snippet } from \'svelte\';\n\n\t/** Default button glyph: U+1F310 GLOBE WITH MERIDIANS + VS15 (text presentation,\n\t * so it reads monochrome like theme-select\'s ◑ rather than a colour emoji). */\n\texport const GLOBE_WITH_MERIDIANS = \'\\u{1F310}︎\';\n\n\texport type ChildArgs = {\n\t\tvalue: string;\n\t\topen: boolean;\n\t\tlabelFor: (locale: string) => string;\n\t};\n\n\texport type Props = {\n\t\tlabel: string;\n\t\tlocales: string[];\n\t\tvalue?: string;\n\t\tdefaultValue?: string;\n\t\tstorageKey?: string;\n\t\tdetectFromNavigator?: boolean;\n\t\tname?: string;\n\t\ttarget?: HTMLElement | null;\n\t\tapplyDir?: boolean;\n\t\tlocaleLabels?: Record<string, string>;\n\t\tchildren?: Snippet<[ChildArgs]>;\n\t\tonChange?: (locale: string) => void;\n\t\tclass?: string;\n\t\t[key: string]: unknown;\n\t};\n\n\t/** Base language subtags whose default writing direction is right-to-left. */\n\tconst RTL_LANGUAGE_TAGS = new Set([\n\t\t\'ar\', \'he\', \'fa\', \'ur\', \'yi\', \'ps\', \'sd\', \'ug\', \'dv\', \'ku\', \'arc\', \'ha\'\n\t]);\n\n\t/** Script subtags whose writing direction is right-to-left. */\n\tconst RTL_SCRIPT_SUBTAGS = new Set([\'arab\', \'hebr\', \'thaa\', \'nkoo\', \'syrc\']);\n\n\texport function bcp47LocaleTag(locale: string): string {\n\t\treturn locale.replace(/_/g, \'-\');\n\t}\n\n\t/** Right-to-left when the base language or any script subtag says so. */\n\texport function isRtlLocale(locale: string): boolean {\n\t\tif (!locale) return false;\n\t\tconst parts = locale.split(/[-_]/);\n\t\tfor (const part of parts) {\n\t\t\tif (