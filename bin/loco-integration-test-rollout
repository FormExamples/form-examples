#!/usr/bin/env python3
"""bin/loco-integration-test-rollout — Phase 1 of tasks.md's "Loco API
integration test rollout (per crate)": upgrades every crate's scaffold-stub
`tests/requests/patient.rs` (a bare "GET list returns 200 JSON" check) into a
real POST-then-GET-then-list round-trip integration test, mirroring the
hand-written `apgar-score` reference (`tests/requests/patients.rs`, itself
fixed for camelCase by `bin/loco-camel-case-json-refactor`).

Scoped to the `patient` table specifically (present in 336/356 crates) —
not literally "every table in every crate" — because it is the one table
every clinical form shares conceptually, and because its `Params` struct
shape is NOT byte-identical fleet-wide (a direct fleet check found 8+
distinct variants: some carry a `sex` CHECK-enum column, some don't; some
carry fitness/vitals fields like `waist_as_cm`/`vo2_max`; some carry
`deleted_at` in `Params`, most don't) — so this is a genuine per-crate
generator, not a copy-vendor tool. Extending to other domain tables (the
form's own main table, clinician, grade/grade_rule/grade_flag) is future,
separate scope — those have far more per-form-specific shapes (FK chains,
enum vocabularies) that a generic value-picker can't safely guess.

For each crate: parses `controllers/patient.rs`'s `struct Params { ... }`
field list (name + Rust type), cross-references `sql/*create_table_patient.sql`
for CHECK-constrained enum columns (picks the first non-empty allowed value,
mirroring `examples/assessment.json`'s own generator convention), converts
each field name to camelCase (serde's own `RenameRule::CamelCase` algorithm,
reimplemented here — verified against real `serde` output elsewhere this
session), and emits a JSON body via small field-name heuristics (email,
phone, postcode, NHS number, MRN, height/weight/BMI, etc.) falling back to a
generic placeholder per Rust type. `deleted_at` (`Option<DateTimeWithTimeZone>`)
is always omitted from the body — serde's derive treats a missing `Option<T>`
key as `None` without an explicit `#[serde(default)]`, and there's no
sensible "create" value for a soft-delete timestamp anyway.

Usage:
    bin/loco-integration-test-rollout [--check] [--dry-run] [--all|<slug>...]

--check reports which crates would change, and exits non-zero if any change
is pending (CI drift detector). --dry-run shows per-crate status without
writing. Default (no flags): apply. Idempotent: re-running after a full
apply makes no further changes (the generated file's own marker comment is
checked before regenerating).
"""

import argparse
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
FORMS_DIR = REPO_ROOT / "forms"

MARKER = "// Generated by bin/loco-integration-test-rollout — do not hand-edit; re-run the tool after a schema change."

PARAMS_BLOCK_RE = re.compile(r"pub struct Params\s*\{(.*?)\n\s*\}", re.DOTALL)
FIELD_RE = re.compile(r"pub\s+(\w+)\s*:\s*([^,\n]+?)\s*,?\s*$", re.MULTILINE)
CHECK_ENUM_RE = re.compile(
    r"CHECK\s*\(\s*(\w+)\s+IN\s*\(([^)]+)\)\s*\)", re.IGNORECASE
)


def to_camel_case(name: str) -> str:
    """serde's RenameRule::CamelCase: lowercase first word as-is, capitalize
    the first letter of every subsequent word, no separator."""
    words = name.split("_")
    out = words[0]
    for w in words[1:]:
        if w:
            out += w[0].upper() + w[1:]
    return out


def parse_params_fields(controller_text: str) -> list[tuple[str, str]]:
    m = PARAMS_BLOCK_RE.search(controller_text)
    if not m:
        return []
    fields = []
    for fm in FIELD_RE.finditer(m.group(1)):
        fields.append((fm.group(1), fm.group(2).strip()))
    return fields


def parse_check_enums(sql_text: str) -> dict[str, list[str]]:
    enums = {}
    for m in CHECK_ENUM_RE.finditer(sql_text):
        col = m.group(1)
        raw_values = m.group(2)
        values = re.findall(r"'([^']*)'", raw_values)
        if values:
            enums[col] = values


    return enums


def first_non_empty(values: list[str]) -> str:
    for v in values:
        if v != "":
            return v
    return values[0] if values else ""


NAME_HEURISTICS: list[tuple[re.Pattern, object]] = [
    (re.compile(r"^name$"), "Test Patient"),
    (re.compile(r"email"), "test.patient@example.com"),
    (re.compile(r"phone"), "+441234567890"),
    (re.compile(r"postal_address"), "10 Downing Street, London"),
    (re.compile(r"^postcode$"), "SW1A 2AA"),
    (re.compile(r"country_as_iso"), "GB"),
    (re.compile(r"nhs_number"), "9434765919"),
    (re.compile(r"hospital_mrn|^mrn$"), "MRN-000123"),
    (re.compile(r"allergies"), "No known allergies"),
    (re.compile(r"height_as_cm"), 170.2),
    (re.compile(r"weight_as_kg"), 70.4),
    (re.compile(r"body_mass_index"), 24.2),
    (re.compile(r"waist_as_cm"), 85.0),
    (re.compile(r"waist_height_ratio"), 0.5),
    (re.compile(r"vo2_max"), 35.0),
    (re.compile(r"birth_date"), "__DATE__1990-01-01"),
]


def pick_value(field_name: str, rust_type: str, enums: dict[str, list[str]]):
    """Returns a Python value (str/float/int/bool) to serialize as JSON, or
    None to signal the field should be omitted (Option<T> fields the
    heuristics can't handle safely, e.g. deleted_at)."""
    inner_type = rust_type
    is_option = rust_type.startswith("Option<")
    if is_option:
        inner_type = rust_type[len("Option<"):-1]

    if inner_type in ("DateTimeWithTimeZone",) and field_name == "deleted_at":
        return None

    value = _pick_raw_value(field_name, inner_type, enums)
    if value == "__UNKNOWN__":
        return value

    # rust_decimal::Decimal (sea-orm's mapping for SQL NUMERIC columns, seen
    # in inpatient-clinical-note's patient table) round-trips a JSON NUMBER
    # fine on the way IN (its Deserialize impl accepts both), but its
    # Serialize impl always emits a JSON STRING on the way OUT (verified
    # live: `"heightAsCm":"170.2"`, not a bare 170.2) — so both the request
    # body and the response assertion must treat it as a string, never
    # `.as_f64()`, or the assertion fails even though the value round-tripped
    # correctly.
    if inner_type == "Decimal" and isinstance(value, float):
        value = str(value)
    return value


def _heuristic_type_compatible(heuristic_value, inner_type: str) -> bool:
    """A name-based heuristic match is only safe to use if its value type
    fits the column's actual type -- e.g. a bool column whose name
    happens to contain "allergies" as a substring would otherwise match
    the free-text "allergies" heuristic, which can't deserialize into a
    bool. Found live (in a different table) via
    bin/generate-api-transcripts's fleet run."""
    if isinstance(heuristic_value, bool):
        return inner_type == "bool"
    if isinstance(heuristic_value, float):
        return inner_type in ("f64", "f32", "Decimal")
    if isinstance(heuristic_value, str):
        return inner_type not in ("bool", "i64", "i32", "f64", "f32", "Decimal")
    return True


def _pick_raw_value(field_name: str, inner_type: str, enums: dict[str, list[str]]):
    if field_name in enums:
        return first_non_empty(enums[field_name])

    for pattern, heuristic_value in NAME_HEURISTICS:
        if pattern.search(field_name) and _heuristic_type_compatible(heuristic_value, inner_type):
            return heuristic_value

    if inner_type == "String":
        return f"Test {to_camel_case(field_name)}"
    if inner_type == "Date":
        return "1990-01-01"
    if inner_type == "DateTimeWithTimeZone":
        return "2026-01-01T00:00:00Z"
    if inner_type in ("f64", "f32"):
        return 1.0
    if inner_type == "Decimal":
        return "1.0"
    if inner_type in ("i64", "i32"):
        return 1
    if inner_type == "bool":
        return True
    # Unknown type (e.g. a domain-specific enum-as-String already covered by
    # `enums`, or something this generator doesn't model) — signal caller to
    # skip this crate rather than guess.
    return "__UNKNOWN__"


def json_literal(value) -> str:
    if isinstance(value, str):
        if value.startswith("__DATE__"):
            return f'"{value[len("__DATE__"):]}"'
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        return f'"{escaped}"'
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    raise ValueError(f"unhandled value type: {value!r}")


def build_test_file(crate_snake: str, fields: list[tuple[str, str]], enums: dict[str, list[str]]) -> str | None:
    """Returns the new test file text, or None if a field's value could not
    be determined (caller should skip this crate)."""
    body_pairs: list[tuple[str, str]] = []  # (camelKey, jsonLiteral)
    assert_pairs: list[tuple[str, str, bool]] = []  # (camelKey, jsonLiteral, isFloat)

    for field_name, rust_type in fields:
        if field_name == "deleted_at":
            continue
        value = pick_value(field_name, rust_type, enums)
        if value is None:
            continue
        if value == "__UNKNOWN__":
            return None
        camel = to_camel_case(field_name)
        literal = json_literal(value)
        body_pairs.append((camel, literal))
        is_float = isinstance(value, float)
        assert_pairs.append((camel, literal, is_float))

    if not body_pairs:
        return None

    body_json_lines = ",\n".join(f'            "{k}": {v}' for k, v in body_pairs)

    assert_lines = []
    for camel, literal, is_float in assert_pairs:
        if is_float:
            assert_lines.append(
                f'        assert_eq!(fetched["{camel}"].as_f64(), Some({literal}));'
            )
        else:
            assert_lines.append(f'        assert_eq!(fetched["{camel}"], {literal});')
    assert_block = "\n".join(assert_lines)

    return f'''{MARKER}
use {crate_snake}::app::App;
use loco_rs::testing::prelude::*;
use serde_json::Value;
use serial_test::serial;

/// POST-then-GET round-trip against the scaffold `patient` controller.
///
/// Proves the domain controller actually functions end to end: create a
/// record over HTTP, read it back by id, and assert the fields round-trip.
/// The request body and asserted response keys are camelCase, matching
/// `#[serde(rename_all = "camelCase")]` on the `Params` and `Model` structs.
#[tokio::test]
#[serial]
async fn can_create_and_read_back_patient() {{
    request::<App, _, _>(|request, _ctx| async move {{
        let new_patient = serde_json::json!({{
{body_json_lines}
        }});

        // 1. CREATE over HTTP.
        //
        // NB: the scaffold's create handler mounts at `/api/patients` (no
        // trailing slash), whereas the list handler is at `/api/patients/`
        // (with one) on some Loco versions and 404s the other way on
        // others — the exact path matters either way.
        let create_res = request.post("/api/patients").json(&new_patient).await;
        assert_eq!(
            create_res.status_code(),
            200,
            "create should succeed, got body: {{}}",
            create_res.text()
        );

        let created: Value = create_res.json();
        let id = created
            .get("id")
            .and_then(Value::as_i64)
            .expect("create response should carry a numeric id");
        assert!(id > 0, "id should be a positive integer, got {{id}}");

        // 2. READ back by id over HTTP.
        let get_res = request.get(&format!("/api/patients/{{id}}")).await;
        assert_eq!(
            get_res.status_code(),
            200,
            "get-by-id should succeed, got body: {{}}",
            get_res.text()
        );

        let fetched: Value = get_res.json();

        // 3. Round-trip: the fetched record echoes exactly what we sent.
        assert_eq!(fetched["id"].as_i64(), Some(id));
{assert_block}

        // 4. The new record is present in the list endpoint.
        let list_res = request.get("/api/patients").await;
        assert_eq!(list_res.status_code(), 200);
        let list: Value = list_res.json();
        let items = list.as_array().expect("list should be a JSON array");
        assert!(
            items
                .iter()
                .any(|row| row.get("id").and_then(Value::as_i64) == Some(id)),
            "the created patient (id {{id}}) should appear in the list"
        );
    }})
    .await;
}}
'''


def find_crates():
    for controllers_mod in sorted(FORMS_DIR.glob("*/back-end-with-loco/src/*/controllers/mod.rs")):
        yield controllers_mod.parents[1]


def process_crate(src_dir: Path, apply: bool) -> str:
    """Returns 'changed', 'unchanged', or 'skip:<reason>'."""
    slug_snake = src_dir.name
    controller = src_dir / "controllers" / "patient.rs"
    if not controller.is_file():
        return "skip:no-patient-controller"
    test_file = src_dir.parent.parent / "tests" / "requests" / "patient.rs"
    if not test_file.is_file():
        # A handful of crates (found via a direct fleet check: 9 as of
        # 2026-09-11) have no domain request test stubs at all — only
        # auth.rs/prepare_data.rs are wired in tests/requests/mod.rs. Out of
        # scope for this tool, which upgrades an existing stub rather than
        # creating new scaffolding + mod.rs wiring from scratch.
        return "skip:no-patient-test-stub"

    sql_dir = src_dir.parent.parent.parent / "sql"
    sql_file = sql_dir / "02_create_table_patient.sql"
    if not sql_file.is_file():
        candidates = list(sql_dir.glob("*create_table_patient.sql"))
        if not candidates:
            return "skip:no-patient-sql"
        sql_file = candidates[0]

    fields = parse_params_fields(controller.read_text())
    if not fields:
        return "skip:params-not-found"
    enums = parse_check_enums(sql_file.read_text())

    new_text = build_test_file(slug_snake, fields, enums)
    if new_text is None:
        return "skip:unhandled-field-type"

    current = test_file.read_text()
    if current.strip() == new_text.strip():
        return "unchanged"

    if MARKER not in current and "async fn can_create_and_read_back_patient" in current:
        # Already hand-upgraded (e.g. apgar-score's reference) — leave alone.
        return "skip:already-hand-written"

    if apply:
        test_file.write_text(new_text)
    return "changed"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("slugs", nargs="*", help="form slugs (default: every form)")
    parser.add_argument("--all", action="store_true", help="same as no slugs: every form")
    parser.add_argument("--check", action="store_true", help="report drift; exit 1 if any pending; don't write")
    parser.add_argument("--dry-run", action="store_true", help="show status per crate; don't write")
    args = parser.parse_args()

    if args.slugs:
        src_dirs = []
        for slug in args.slugs:
            matches = sorted((FORMS_DIR / slug / "back-end-with-loco" / "src").glob("*/"))
            src_dirs.extend(d for d in matches if (d / "controllers" / "mod.rs").is_file())
    else:
        src_dirs = list(find_crates())

    dry = args.check or args.dry_run
    changed = []
    skip_reasons: dict[str, list[str]] = {}
    unchanged = 0

    for src_dir in src_dirs:
        slug = src_dir.parents[2].name
        status = process_crate(src_dir, apply=not dry)
        if status == "changed":
            changed.append(slug)
        elif status == "unchanged":
            unchanged += 1
        else:
            reason = status.split(":", 1)[1]
            skip_reasons.setdefault(reason, []).append(slug)

    total_skip = sum(len(v) for v in skip_reasons.values())

    if args.check:
        print(f"loco-integration-test-rollout [CHECK]: {len(changed)} crate(s) pending, "
              f"{unchanged} up to date, {total_skip} SKIP")
        for slug in changed:
            print(f"  would change: {slug}")
        for reason, slugs in sorted(skip_reasons.items()):
            print(f"  SKIP ({reason}): {len(slugs)}")
        return 1 if changed else 0

    verb = "would change" if dry else "changed"
    print(f"loco-integration-test-rollout: {len(changed)} crate(s) {verb}, {unchanged} up to date, "
          f"{total_skip} SKIP")
    for reason, slugs in sorted(skip_reasons.items()):
        print(f"  SKIP ({reason}): {len(slugs)}" + (f" — {', '.join(slugs[:5])}{'…' if len(slugs) > 5 else ''}" if len(slugs) <= 8 else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
